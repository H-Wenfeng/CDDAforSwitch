msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/mods/Magiclysm/monsters/golems.json
#. ~ Description of monster "iron golem"
msgid ""
"A large, humanoid golem made from iron.  Some sort of noxious gas seems to be "
"seeping from its mouth."
msgstr ""

#: data/mods/Magiclysm/monsters/golems.json
#. ~ Monster name
msgid "earthshaper's golem"
msgid_plural "earthshaper's golems"
