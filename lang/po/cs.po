#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "glowing tendril"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "glowing tendril"
msgid ""
"A willowy tendril growing from the floor, gently waving back and forth.  A "
"faint light spills from it."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#: data/json/furniture_and_terrain/terrain_nether_monster.json
#. ~ Bashing sound
#. ~ Bashing failed sound
msgid "splorch!"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "wafting anemone"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "wafting anemone"
msgid ""
"A fleshy white protuberance growing from the floor, with a cluster of "
"tendrils protruding from it.  It looks almost exactly like a sea anemone, "
"even waving gently as though underwater."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "gasping tube"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "gasping tube"
msgid ""
"A meaty green stalactite with a thickened hide like that of a starfish, "
"extending from the floor to the ceiling.  In the center is a series of ports "
"somewhat like mouths, from which pour bursts of a vile-smelling gas."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "twitching frond"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "twitching frond"
msgid ""
"A spine resembling moth antennae juts from the ground, swaying gently in the "
"air.  Every so often, a cascade of energy arcs along it and discharges into "
"the ceiling."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "scarred lump"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "scarred lump"
msgid ""
"A pile of nondescript alien flesh, twitching and belching strange gases out "
"of injured orifices."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#: data/json/furniture_and_terrain/furniture-eggs.json
#. ~ Bashing failed sound
#. ~ Bashing sound
msgid "splat!"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "slimy pod"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "slimy pod"
msgid ""
"A slick, translucent pod suspended on a thin stalk.  It is covered in a thick "
"mucus, obscuring whatever is floating in the gel-like substance inside."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "organ pod"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "organ pod"
msgid ""
"A translucent pod suspended on a thin stalk.  Inside you can see the dimly "
"outlined shape of human organs, floating in some kind of preservative goo."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "resin pod"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "resin pod"
msgid ""
"A translucent pod suspended on a thin stalk.  Inside is a clean, clear, "
"resinous-looking fluid.  You could fairly easily tear it from the stalk and "
"take it with you."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "fleshy altar"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "fleshy altar"
msgid ""
"This pulsing protuberance juts from the floor, its sides covered in scaled, "
"oozing skin.  The surface is flat, but undulates softly.  A handful of "
"unidentifiable appendages reach from the sides, suggesting a sort of "
"nightmarish living Autodoc."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "scrap antenna"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "scrap antenna"
msgid ""
"This contraption looks like some sort of cobbled-together transmitter or "
"receiver antenna.  It consists of a number of mismatched blinking lights, "
"spinning servos, and dangling wires connected to a hefty metal box."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "pictographic signpost"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "pictographic signpost"
msgid ""
"This simple scrap metal sign has a series of pictographs on it depicting what "
"seems to be a trade interaction.  There is a crude but understandable map "
"beneath it.  You should take a closer look."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Player message in effect in EoC "EOC_EXODII_SIGNPOST_FALSE" in furniture
#. "pictographic signpost"'s examine action
msgid ""
"You study the signpost.  It shows a similar set of directions to the ones you "
"already have.  You cross-reference them and don't learn anything new."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Player message in effect in EoC "EOC_EXODII_SIGNPOST" in furniture
#. "pictographic signpost"'s examine action
msgid ""
"You study the signpost.  It shows simply-drawn pictograms of a pair of hands "
"holding out an object, and another pair taking the object and offering a "
"pouch in return.  Beneath the pictures there's a crude but understandable map "
"with arrows pointing to what looks like some kind of castle.  You do your "
"best to relate those to landmarks you know about, and mark the likely "
"location on your map."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "rack of robots"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "rack of robots"
msgid ""
"A wire cage containing a number of robot parts, from chassis to limbs, firmly "
"clamped onto sturdy hanging rods.  It looks like it would be exceptionally "
"difficult to open it and get at them without damaging them, probably by "
"design."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "spinning dish"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "spinning dish"
msgid ""
"A slowly-spinning parabolic dish engraved with an unrecognizable pattern of "
"symbols that might, at a guess, be some sort of circuitry pattern - or maybe "
"a religious incantation.  It is mounted on a completely mismatched electric "
"motor that looks fairly mundane."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "scavenged utility light"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "scavenged utility light"
msgid ""
"The bulbs emit an eerie greenish glow, and some parts of it have a curved "
"appearance as though the metal were grown in a lab, but by and large this "
"isn't a particularly unusual looking area light."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "clanking fluid pump"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "clanking fluid pump"
msgid ""
"The huge, sweating pipes and large tank reveal this clanking and tortuous "
"piece of equipment to be some sort of fluid pump.  It is cobbled together "
"from several apparently ill-fitting parts that have been fitted with some "
"very strange-looking but surprisingly clever adapters."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "metalloid printer"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "metalloid printer"
msgid ""
"This huge device fairly closely resembles a 3D printer, aside from its "
"industrial size.  Huge spools of various thin metallic wires atop it feed "
"into what seems to be some sort of nozzle, and massive electrical cables "
"disappear into the wall behind it."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "circuit printer"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "circuit printer"
msgid ""
"A tall device with a lattice of pipes and nozzles.  Based on the pile of "
"products sitting in the output hopper, it looks like it's used as a printer "
"for complex electronic components."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "Mavrik 10-101 power core"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "Mavrik 10-101 power core"
msgid ""
"There is a faded metallic plaque on the side of this cylindrical device.  The "
"lettering is a strange combination of English and Cyrillic script.  It reads:\n"
"Mavrik 10-101\n"
"Stabиlиtи\n"
"Saфetи\n"
"A нyuclиar фyutuр ви bilив iн"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "spherical generator"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "spherical generator"
msgid ""
"This huge steel-plated sphere gives off a soft hum as it, presumably, "
"generates power.  A heavy lead plate bolted to the front might describe what "
"it is, but it is written in something that looks vaguely like cuneiform."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "fluidic generator"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "fluidic generator"
msgid ""
"Twisting reams of copper and steel pipes wrap around a central core that "
"thrums softly.  Although there are no labels in any language you recognize, "
"the cables connected to the base suggest that this is some sort of power "
"generator."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "rusty generator"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "rusty generator"
msgid ""
"A tall, unremarkable cylinder capped by a wide, flat saucer.  There is heavy "
"rusting at the base.  A series of connected cables suggest that it's some "
"sort of power generator."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "personal charging station"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "personal charging station"
msgid ""
"The cyborg equivalent of a bed, this is a custom-shaped near-vertical booth "
"designed to mount a heavy metal frame and connect it to a central power "
"supply and nutrient source."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "simple charging station"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "simple charging station"
msgid ""
"A simple, unadorned, corroded metal charging and feeding station, with "
"hookups for two units somewhat larger than a human to stand side by side and "
"be recharged and refueled."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "shimmering superstructure"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "shimmering superstructure"
msgid ""
"A simple metal superstructure like you might see holding up a radio tower, "
"this one seems to give off just the faintest hint of shimmer, like heat "
"waves.  The metal has a burnt, iridescent pattern.  There is a boxy, "
"unimpressive-looking device at the top of the tower."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "portal enclosure"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "portal enclosure"
msgid ""
"A heavy metal ring attached to dozens of wires, charred by residue that gives "
"off an acrid, unfamiliar smell."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "locator antenna"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "locator antenna"
msgid ""
"A tall metal pole solidly fixed to the roof.  It does not look activated but "
"there's a small set of holes near its base, maybe something could be plugged "
"in one to reboot the locator."
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Player message in effect in EoC "EOC_EXOWARE_LOCATOR_ACTIVE" in furniture
#. "locator antenna"'s examine action
msgid "The locator is already active"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Player message in effect in EoC "EOC_EXOWARE_LOCATOR_FALSE" in furniture
#. "locator antenna"'s examine action
msgid "You don't have anything that could reactivate this device"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Player message in effect in EoC "EOC_EXOWARE_LOCATOR" in furniture
#. "locator antenna"'s examine action
msgid ""
"You plug the rebooter in the locator.\n"
"<color_light_green>The locator reactivates.</color>"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Furniture name
msgid "crystalline flower"
msgstr ""

#: data/json/furniture_and_terrain/furniture-alien.json
#. ~ Description of furniture "crystalline flower"
msgid "A crystalline structure that resembles a plant."
msgstr ""

