msgstr[2] ""
msgstr[3] ""

#: data/json/monsters/defense_bot.json
#. ~ Description of monster "NR-V05-M Dispatch"
msgid ""
"The Northrop Dispatch, designed for crowd control situations, carries and "
"deploys kamikaze drones of various types.  The dark green paint job marks the "
"lethal and feared military variant, carrying extreme and deadly firepower."
msgstr ""

