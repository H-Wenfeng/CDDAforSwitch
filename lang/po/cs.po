msgstr "Uvidíme se..."

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_keycard_seller.json
#. ~ NPC dialogue line
msgid ""
"Well that'd be telling.  Suffice to say that a few friends found them, and "
"none of us are into the lab-dive business."
msgstr ""

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_keycard_seller.json
#. ~ NPC dialogue line
msgid "Not a bargain bin kid, the price's the price."
msgstr ""

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_template_seller.json
#. ~ Response to NPC dialogue
msgid "[3 HGC] It's a deal."
msgstr ""

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_template_seller.json
#. ~ Response to NPC dialogue
msgid "Offer to buy it for 2 coins."
msgstr ""

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_template_seller.json
#. ~ Response to NPC dialogue
msgid "I don't even know what that is."
msgstr ""

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_template_seller.json
#. ~ NPC dialogue line
msgid "Sure whatever, two coins and it's all yours."
msgstr ""

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_template_seller.json
#. ~ Response to NPC dialogue
msgid "[2 HGC] It's a deal then."
msgstr ""

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_template_seller.json
#. ~ NPC dialogue line
msgid ""
"A 'nanofabricator template', it seems, no idea what it's good for, but it "
"sure looks valuable.  Are you buying it or not?"
msgstr ""

#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_template_seller.json
#. ~ NPC dialogue line
msgid ""
"Well I'm sure someone who values it will come around, thanks for hearing the "
"pitch anyways."
msgstr ""

