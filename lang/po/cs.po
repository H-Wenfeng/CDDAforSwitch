#: data/json/npcs/isherwood_farm/NPCS_Isherwood_Rescue_Duplicates.json
#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Job description of "Lisa Isherwood" NPC class
msgid "Part of the Isherwood family"
msgstr ""

#: data/json/npcs/isherwood_farm/NPCS_Isherwood_Rescue_Duplicates.json
#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Unique name of a male NPC
#. ~ Part of the Isherwood family.  False copy for the Barry resue mission.
#. ~ Name of an NPC class
#. ~ Part of the Isherwood family.  Does not spawn until you get a mission
#. from Carlos to track him down.
msgid "Chris Isherwood"
msgstr ""

#: data/json/npcs/isherwood_farm/NPCS_Isherwood_Rescue_Duplicates.json
#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Job description of "Chris Isherwood" NPC class
msgid "I'm Jesse and Carlos' son, part of the Isherwood family"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Unique name of a male NPC
#. ~ A naked prisoner, from the isherwood faction trapped in a horrifying
#. cage, watching horrible things happen.
#. ~ Name of an NPC class
msgid "Barry Isherwood"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Job description of "Barry Isherwood" NPC class
msgid "Missing member of the Isherwood family."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*crouches on the bottom of his cell, shivering, then looks up as you "
"approach.  He blinks a few times, then stands up.  He's totally nude, and his "
"tanned body is covered in tiny, precise-looking scars of varying ages.  \"I "
"can't believe my eyes.  Please get me outta here…\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Are you Barry Isherwood?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'll get you out of here, just stay calm.  <lets_go>"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'm Luke Skywalker, I'm here to rescue you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "You just hold tight here for a second."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"What?\"  The naked, traumatized man stares at you blankly, as though he'd "
"never seen Star Wars, which is clearly ridiculous.  \"Rescue me?  Yes, oh "
"please yes!"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Okay then, your family's outside.  Let me go get them."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Let's go."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hang on.  I've got questions."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Just hold on a little longer, okay?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*gulps.  \"I sure as hell am.  Did my family send you?  Please, we gotta go.  "
"There are more of those things.  They're everywhere.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Yeah, they did, I'll go get them."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Yeah, Chris did, we're taking you home."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*switches, abruptly, to pure white-hot rage.  \"DOES THIS LOOK LIKE A TIME "
"FOR FUCKING QUESTIONS?\"  He stops, shaking, and returns to how he was "
"before.  \"I'm sorry.  I'm so sorry.  Oh god, I'm sorry.  I need to get out "
"of here.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Okay, me too, let's go."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "All right, we're leaving, but you better not test me again."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Okay, me too.  I'll go get your family."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"All right, we're leaving, but you better not test me again.  I'll be back "
"with your family."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Pff.  If you're gonna treat me like that, you can stay here."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid "Let's get back to the farm, as fast as possible."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What farm?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"That shouldn't take long, your family's outside waiting.  I'll be back with "
"them."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"That shouldn't take long, I brought some of your family with me.  Let's get "
"you home."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"\"Oh, so my family didn't send you then.\"  Barry looks downtrodden for a "
"brief moment.  \"Look, we just need to get out of here first, I'll tell you "
"about it later.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Okay, sounds good to me.  <lets_go>"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Sorry about the Luke Skywalker joke."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hey buddy, feel like talking about what you saw in that tower?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What farm were you going to tell me about earlier?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I've thought about it some more, and I'd like to have the directions to your "
"farm."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Maybe let's talk about you a little bit.  What's your role in this family?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Come on, let's get out of here while we still can.  I don't want to spend any "
"longer around here then we need too."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid "*lights up as you approach, but also looks wary.  \""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid "Hey, Jedi.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid "Hey, <name_g>.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid "I can't wait to get back home and see everyone.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid "*nods.  \"Of course, what'd you want to ask?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah, I think we need to talk about it, but I'm not ready yet.  Let me "
"reclaim my life for a while."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Sounds good, Barry."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*laughs.  \"It was terrible timing, but I have to admit, you don't see many "
"situations that perfect for that reference.  Sorry I didn't get it at the "
"time.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_teamster.json
#. ~ Response to NPC dialogue
msgid "Can I ask you some questions?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"It's still a bit fresh, but okay.  Yeah.  Let me sit down first.\"  Barry "
"takes a seat, his hands shaking even at the prospect of discussing the tower "
"and the things he saw.  \"What should we talk about?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What happened to you in there?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "On second thought, I think you should recover more."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*shivers, though the room is warm, and moves his mouth wordlessly for a few "
"seconds.  \"It's hard to remember details.  The air in that place messes with "
"your brain, makes it all feel like some kind of dream.  Makes it so you can't "
"fight back.  Not that I could have anyway.\"  He stares into space for a "
"moment, then swallows hard.  \"They cut into me, over and over.  I don't "
"think they took anything out.  They just opened me up, poked around.  I was "
"awake for all of it, as awake as for anything else.  Sometimes I felt pain, "
"other times they did something to me so I could feel it but it didn't hurt.  "
"There were big, pale ones that did the cutting.\"  His voice gets "
"increasingly detached as he speaks, and his shaking grows worse.  You're not "
"sure it would be wise for him to go further."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "[Let him continue.]"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "That's enough for now, Barry."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*shudders, looking like he might vomit.  \"What did they want?  Why me?  "
"Every time, they'd put me back together again, seal it up and make it look "
"almost like nothing happened.\"  He yanks up his shirt to show the scars.  "
"\"But I know what happened, it was REAL, goddammit!\"  He drops the shirt, "
"bends forward, and dry heaves for a few seconds.  Wordless, he hides his face "
"in his hands, and stops responding."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#: data/json/npcs/robofac/NPC_Cranberry_Foster.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom.json
#. ~ Response to NPC dialogue
msgid "[Leave.]"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah.  Yeah.\"  He takes a long, shaky breath.  \"Yeah, you're right.  This "
"isn't going anywhere good.  Claire's been talking about making some dandelion "
"wine,\" he says with a hollow smile.  \"Maybe I'll go see if she needs help."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "How about we change the subject instead?  What's your role in this family?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Good idea."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"&He wipes his hand across his face, tension leaving him as he runs his "
"fingers through his hair.  \"Yeah, okay.  To be honest, years ago I was the "
"black sheep.  Moved off the family farm, lived out in Bunyan.  Went to "
"college, thought I'd get a job in computers.\"  He shuffles in his chair, "
"smiling half-heartedly.  \"I did sysadmin stuff for a while, back when the "
"internet was fairly new.  Then my dad died.  Carlos and Jesse had just gotten "
"married, and at the time it looked like they might be getting some land of "
"their own, and Eddie was out finding himself.  My dad and I had never got "
"along, but Jack…\" he stops.  \"Sorry, I don't think you were looking for my "
"life story.  What did you ask, again?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "No, go on."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "You're right.  I was asking something different."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "It's okay, I'm going to head out."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Fair enough, you asked for it.\"  He stretches his arms out.  \"Jack and I "
"stayed close, even after my old man and I fell out, so when it looked like he "
"was going to be saddled with the entire farm to run, I took a good long look "
"at my life and realized I hated it.  It was never the farm I was trying to "
"get away from, you know?  I packed up my things, quit my job, and came out to "
"help Jack.  Never looked back.\"  He chuckles.  \"Damn hard finding a partner "
"for a guy like me out here though.  I was in a long-term relationship when I "
"left, but that fell apart.  I haven't been too lonely though, I've got my "
"people."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "[PER 9] Was your choice in partners part of the problem with your father?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Thanks for taking the time to talk to me.  I had some other questions."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#: data/json/npcs/random_encounters/refugee_caravans.json
#: data/json/npcs/refugee_center/surface_refugees/NPC_Mandeep_Singh.json
#. ~ Response to NPC dialogue
msgid "Thanks for the story.  <end_talking_leave>"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"&His eyebrows shoot up, briefly surprised, then he smiles.  \"You nailed it "
"in one.  Yeah, we're talking about a rural farmer in the nineties, here.  My "
"dad never understood me, even before he knew, and he did find out, although I "
"tried to keep the closet door closed.  Jack, though, he always saw me for me. "
" Never let it change our relationship.  That's real love, and that's what "
"made me come back when he needed me.  Meanwhile, the man I thought I'd marry, "
"back in Bunyan, he couldn't be assed even to come out and see the family "
"farm, let alone think about moving here.  He was dead weight, and I've never "
"doubted that decision.\"  He shrugs.  \"There's folks like me wherever you "
"go, I've had a few relationships since then.  Just nothing that stuck, and "
"I'm okay with that.  If nothing else, it proved what I already knew: aside "
"from my old man, none of my family treated me or them any different for it.  "
"They're good people.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Oh, yeah, now I remember.  That farm I was talking about is where I live, "
"almost the whole Isherwood family lives there, including me.  I just wanted "
"to get back home as fast as possible so I can see everyone again, and so "
"everyone knows that I'm okay."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Can you give me some directions to it?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "That's pretty cool.  <done_conversation_section>"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Sure, can I please see your map?\"  Barry takes your map, orients himself, "
"and points out a route to the farm.  \"Once we've done that, I'll head on "
"myself so everyone won't be surprised by you coming.  Sound good?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Sounds good to me, let's hit the road."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'd like to think about it some more."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
#. ~ Mission name
msgid "Return Barry to Isherwood's farm."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, looks like you are building a forge setup."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, Jack and Claire suggested I come talk to you about a job."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*is an older middle-aged man, well-muscled and darkly tanned, with worried "
"lines around the corners of his eyes and mouth.  He looks up as you get close"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
", and then puts his hand on the butt of the rifle slung across  his back.  "
"\"I see that badge, I think you need to keep on walking, straight off this "
"property.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ", then smiles distantly.  \"Hello Sir, what brings you here?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ", then smiles distantly.  \"Hello Ma'am, what brings you here?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Yeah, I'm a Marshal, what are you going to do about it?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "…[Leave.]"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"* glares at you, his hand moving again to his gun.  \"I see that badge, I "
"think you need to keep on walking, straight off this property.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*rolls his eyes.  \"I'm not an idiot.  You think if you don't wear your "
"badge, I won't know who you're working for?  Get out of here.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Look, I took it off to show I'm not here as a marshal.  I'm just here as a "
"traveler, someone who can maybe help you out.  I know you've got problems "
"bigger than you can handle right now."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid "*looks up warily as you approach"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ".  \"Yeah?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Oh, right… [Leave.]"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*struggles to think of a reply for a moment, then drops his hand from his "
"gun.  \"We've got that under control, but you're not wrong.  An extra pair of "
"hands wouldn't hurt, just now.  Just keep that damn badge out of my sight.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Fine.  Thanks.  Tell me more about what happened to Barry."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"It is coming together.  I want to make our own tools, repair our items and "
"even create some weapons and ammunition reloading."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I heard about Barry, can you tell me what captured him?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"It was pink and really fast, it had lots of limbs, definitely not human.\"  "
"Carlos rubs the back of his hand idly, staring into space.  \"It easily kept "
"up with us when we tried to escape, horrifying stuff.  Barry just dropped to "
"the ground, and the thing swept him away."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid "You all just gonna leave him out there to his fate?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*frowns at you.  \"Of course not.  We tracked it for a while, but lost the "
"trail.  Right now we don't have the resources to try to rescue him.  My son, "
"Chris, has been trying to pick up the trail again and figure out a rescue "
"plan.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I could help.  Where did Chris go?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*shakes his head.  \"Leave Chris be, he knows what he's doing.  Give him some "
"time.  Calling more attention to him could get both of you killed.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"The big item I need is an anvil, once I have that I can get a lot of repairs "
"done.\"  He smiles briefly.  \"Can't exactly head to town to get it done "
"anymore, but I learned a bit of old world metalwork from my granddad."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*gestures around the workspace, which looks more set up.  \"I'm figuring "
"things out, getting it worked out.  It's been a while since I did this kind "
"of metalwork."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah, it's coming along nice.\"  He slaps the surface of the anvil.  \"Thanks "
"for this, I'm still getting my skills back up, but it's going to be real "
"helpful."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Chris is hiking the perimeter of our land, planning some defense options.\"  "
"He looks you up and down.  \"Best just let him be."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*looks at you curiously.  \"Should be where you saw him last.  He's not "
"missing again, is he?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Is your forge operational?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Where can I find Chris?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Mission name
msgid "Find an anvil"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find an anvil"
msgid "I need an anvil to do advanced metal work."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find an anvil"
msgid "I could really use an anvil."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find an anvil"
msgid "You might be able to find one in a hardware store or similar."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find an anvil"
msgid "Thanks anyway, we'll find the time to make it ourselves."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find an anvil"
msgid "If you can't find one, maybe you can make one for me."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find an anvil"
msgid "Do you have the anvil?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find an anvil"
msgid ""
"I appreciate it, this will really make a difference, here's some horse armor "
"I've been working on.  Eventually I'll have the whole herd outfitted."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Mission name
msgid "Find Chris Isherwood"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find Chris Isherwood"
msgid ""
"Chris hasn't come back from his latest search for Barry, I'm getting "
"concerned."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find Chris Isherwood"
msgid "Can you go find my son and tell him to check in with us."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find Chris Isherwood"
msgid "Oh well.  I hope he turns up soon."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find Chris Isherwood"
msgid ""
"He might be on the property somewhere, maybe by that old cabin near the "
"entrance, sometimes he camps there."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find Chris Isherwood"
msgid ""
"Thanks, I was getting ready to go look myself.  Now that I have the anvil, "
"I've been working on new armor for the horses, take this prototype I made."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#. ~ Dialogue line in mission "Find Chris Isherwood"
msgid "I hope he didn't meet Barry's fate…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Hi, your dad asked me to come find you, said you've been looking for your "
"uncle."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I was talking to Luke earlier, said you had some interesting ideas about the "
"world ending.  Is it tied to Barry's abduction?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, what have you been up to lately."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Can I hear your ideas about the world ending, now that we saved Barry?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Have you had any ideas for what your family could do?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Do you think we're ready to try this again?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I've got some SWAT gear that should work for the assault."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I've got enough SWAT gear to set everyone up for the assault."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"[LIE] I tried to get the SWAT gear, but it looks like someone looted it "
"before I could get there."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I've got enough bags to set up a defensive wall."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*is a young man, perhaps in his early twenties or late teens.  He eyes you up "
"and down.  \""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I see that badge.  You need to leave our land, my relatives have no fondness "
"for Marshals.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid "Hi, what's up?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah, they are always worried about us, I prefer to survey the land and try "
"to track the changes.  I'm thinking about fixing up this cabin for some peace "
"and quiet…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Sounds like you are restless, why not leave?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What sort of changes have you seen?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I was talking to Luke earlier, said you had some interesting ideas about the "
"world ending."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I surveyed the land, and I am trying to track the changes.  I fixed up this "
"cabin for some peace and quiet… you can settle here if you want"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Do you think, monsters that kidnaped Barry are responsible for end of the "
"world?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#: data/mods/Aftershock/npcs/cyrus_whately.json
#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/Aftershock/npcs/sadie.json
#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/DinoMod/NPC/NC_Yoshimi.json
#: data/mods/aftershock_exoplanet/npcs/cyrus_whately.json
#: data/mods/aftershock_exoplanet/npcs/milly_whately_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/prepnet_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/sadie.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "Let's talk about something else."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#: data/mods/Xedra_Evolved/npc/boann.json
#. ~ Response to NPC dialogue
msgid "I'd better get going."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"My family is convinced that if we stay here, we'll be able to weather this "
"catastrophe.  Since technology has failed, they've doubled down on older "
"traditions.  I think we need to get out there and find some answers before "
"settling on a path."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"In one of my longer trips looking for Barry, I saw something out in a field.  "
"I didn't get close but I swear unbelievable monsters were coming out of it.  "
"It kinda shimmered, almost like it wasn't quite there.  I've been tracking "
"those monsters for a while…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What did you find?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid "I doubt that, other monsters and zombies attacked them way too often"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"They made their way to this weird spire like structure, I've never seen "
"anything like it, it glistened in the sun like something organic.  I think "
"they could be holding Barry there, I've seen them arrive and leave with other "
"humans."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I might be able to help you get Barry back, but we've got to plan this out."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Well, wildlife is more hostile and I've seen gigantic insects around, never "
"mind all these monsters.  I've also found mysterious dead spots and mutated "
"vegetation.  I don't think staying on a farm is sustainable forever, there "
"are big planet wide changes occurring."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid "You should leave before my family sees you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Your dad asked me to come find you, said you've been looking for your uncle."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I was talking to Luke earlier, he said you had some interesting ideas about "
"the world ending."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"&Chris looks you up and down, and nods.  \"I'm definitely not going to say no "
"to a willing body, and you look like you know what's up.\"  He sighs.  \"To "
"be honest with you, I've been a bit stuck.  I can't tackle that thing alone, "
"and I'm not willing to bring my dad or Uncle Eddie in either.  Dad's got a "
"bum knee - don't tell him I said that - and Eddie's not that great a shot.  "
"Luke's still too young for something like this… you get the idea.\"  He leans "
"forward, self-consciously running his hand through his hair.  \"I think if we "
"work together maybe we'd stand a chance.  I don't have a great plan though.  "
"That tower doesn't look like something a person could just storm up to "
"full-frontal style.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Actually, I was just planning to go in by myself.  I've handled worse."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I've got my own team here, we'll take this.  You stay back here, keep the "
"family safe."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Yeah, I think we should work together on this.  Do you mind if I take the "
"lead?  I've probably got more experience."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*looks at you with obvious doubt.  \"You sure you know what you're getting "
"into?  I can't stop you if you plan on going in solo, but it seems like a "
"terrible idea.  Those things mean business.  I won't be able to go in and "
"help you if you get trapped too.  It's probably better we pair up.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Trust me.  See you in a bit."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "If you insist, yeah, we could team up."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah, bringing your own people in is reasonable.  Still, the more the better. "
" It's my uncle in there, I'm more than willing to help out.  I know my way "
"around, I won't get in your way."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "All right.  As long as you follow my lead, we could use another pair of hands."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"It's all right.  We've got this, you get things ready for when we return with "
"Barry."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*nods.  \"I'm fine following your lead.  I'm a good scout and hunter, but "
"I've never done anything like this before.  When you set the time, I'll head "
"out and wait near the scout tower for you with the best gear I can get.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "All right.  Let's kick some alien butt."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Is there anyone else around here that could help us?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"You mentioned that Carlos, Eddie and Luke probably can't help in a firefight. "
" Is there any other way we could use them?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Like I said, I don't really think my dad or uncle should help, and I think "
"Luke's more likely to get injured than be helpful."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What about Lisa?  She seems like she could handle herself."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Well, I guess it's just us.  <lets_go>"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*blinks.  \"My… yeah, of course Lisa could come.  Damn, she'd smack me if she "
"knew I didn't think of that myself.  Mind if I go talk to her about it?  I'll "
"get her to come out with me and we'll meet you together, if she's willing.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Okay, I'll give you about an hour to talk with her about it.  I'll be back "
"soon."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Probably.  They'd want to, for sure.\"  He looks thoughtful.  \"I'm sure we "
"could use more help, but this isn't my strong suit.  Let me think about it.  "
"If you have any ideas, run them by me.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "OK.  Let's talk about it again in a bit."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah.  I think they should cover our exit.  We've got an old truck they could "
"set up as a platform, where Dad can put down covering fire without his knee "
"being an issue.  Eddie can drive, instead of shoot, and Luke or Mom can be "
"ready with some first aid supplies.  Then when we get out, we've got an easy "
"getaway set up, and there's less chance of us getting flanked while we're in "
"there looking for Barry.\"  He looks at you, suddenly nervous.  \"Is that a "
"good plan?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Seems like a good plan to me."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I think it's better we take my vehicle, and just leave them out of it."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I don't think one farmer with a hunting rifle is going to be enough to keep "
"our backs safe."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I think we need some kind of secure fallback point for the family, maybe a "
"defensive wall?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"We're going to need some way to breach the tower itself, possibly some form "
"of explosives.  Do you know anyone who could help us with that?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*looks crestfallen for a moment, then straightens up.  \"All right.  Yeah, "
"maybe better not to put them at risk I guess.  So we're back to going in "
"without them.  Maybe that's better, I don't want to lose anyone else.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Can you think of anything else we might need, or should we put this into "
"action?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Let's go get your uncle back."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I've changed my mind.  I think it's better we take my vehicle, and just leave "
"them out of it."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I'm a bit worried about defenses.  Do you folks have any armor or equipment "
"to help keep yourselves safe?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*looks thoughtful.  \"Well, we can wear our usual wrangling gear, but you're "
"right.  It's no good against those claws.\"  He sighs.  \"I don't want to "
"delay, but I don't want to lose another family member either.  If we could "
"get our hands on some riot gear, that might give us a better chance to fend "
"off the monsters.  Not too far away, our corrupt-as-hell local cops kept "
"enough of that gear on hand to easily set our family up.  As if they needed "
"it in this place.  Just used it to keep the boot on, y'know?\"  He spits on "
"the ground.  \"I can show you where their stores were, it'd feel nice to put "
"that stuff to good use.  Of course, any riot gear would do, if you happen to "
"have already looted some.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I think you're right, that would take too long.  We'll have to count on "
"offense being our best defense."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Show me where, and I'll try to get some riot gear for you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*smiles slightly.  \"Awesome, getting our team kitted out better will go a "
"long way to making this possible.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "[5 Riot Armor] I've got enough riot armor for everyone."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "[5 Riot Helmet] These crowd control helmets should help a lot."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "[5 Riot Arm Guard] I hope these armguards won't interfere with people's aim."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"[5 Riot Leg Guard] I've got these leg guards to keep people from getting "
"hobbled."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "We have enough full sets of riot control armor to cover everyone, head to toe."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*nods intently, looking at the assembled pile of equipment.  \"Like I said, "
"I'll get this distributed to everyone who's coming.  It's starting to feel "
"more real, but less impossible.  Thanks for doing this.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Before you get on to that, I wanted to talk about something else."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'll let you get on that."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Sorry.  <done_conversation_section>"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'm sorry.  I'm going to go take care of a few more things."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Good idea.  A sandbag wall would be easy enough, we've had to do those a few "
"times when we've had flooding and everyone knows the drill.  Back then we "
"just grabbed supplies from the hardware store, though.  Maybe you'd be able "
"to make a run for those?  Something like 20 canvas bags would probably do it. "
" We can fill them up in advance and toss them out of the truck to get a "
"decent barricade."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I think this is going to take too long, honestly.  Let's just stick with the "
"truck."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I know where to find those canvas bags, I'll go get them."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"All right.  I think that's everything we need.  Let me get it out to the "
"family and we'll have it all prepped by tomorrow."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Before I go, let's talk about something else."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'll let you get on that, I've got my own preparations to take care of."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"* looks thoughtful for a moment, then becomes a bit nervous.  \"Wait, won't "
"that run the risk of injuring Barry, or possibly collapsing the tower?  I "
"don't want him hurt during this, or anyone else if this bomb sends back a "
"bunch of shrapnel.  What do you think about it?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Don't worry, I know what I'm doing.  I've taken a look at these sorts of "
"towers before, and I know that the structure itself is pretty solid.  If we "
"tune it right, then the tower won't fall over."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Well, I trust you on this.  If you need a good hand with chemistry, go see "
"Luke about it.  He knows a lot, you'd be surprised.  \" He pauses for a "
"moment, and thinks as if trying to recall something.  \"Luke should be over "
"in the old outbuilding near the dairy, that's on the other end of the "
"property."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"That sounds great, I'll go talk to him about it.  Let's talk about something "
"else first, though."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Response to NPC dialogue
msgid "That sounds great, I'll go talk to him about it."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"If you think we're ready, I think we can try another go.  Even… even if it's "
"too late for Uncle Barry, I think we've got to try to take that damn tower "
"out of commission."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Mission name
msgid "Free Barry from the mysterious structure"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Dialogue line in mission "Free Barry from the mysterious structure"
msgid ""
"We need to investigate the alien encampment and try to find out what happened "
"to Barry."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Dialogue line in mission "Free Barry from the mysterious structure"
msgid "I can take you to the structure, I tracked them to it."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Dialogue line in mission "Free Barry from the mysterious structure"
msgid "Awesome, I want some answers!"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Dialogue line in mission "Free Barry from the mysterious structure"
msgid "Thanks anyway, I'll keep my eye on it, maybe I'll find a way one day."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Dialogue line in mission "Free Barry from the mysterious structure"
msgid ""
"I feel like we are underprepared if they see us, I marked the location for "
"you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Dialogue line in mission "Free Barry from the mysterious structure"
msgid "You ready?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Dialogue line in mission "Free Barry from the mysterious structure"
msgid ""
"It's taller then I remember, we should look for prisoners.  I left a note for "
"my family before we left.  If we survive, the cabin should be fixed up and "
"ready for you to move in if you want to stay."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Dialogue line in mission "Free Barry from the mysterious structure"
msgid "Well it was here…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Mission name
msgid "Retrieve 5 sets of riot armor for the Isherwoods"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Chris_Isherwood.json
#. ~ Mission name
msgid "Retrieve Canvas Bags for Chris"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Unique name of a female NPC
#. ~ Matriarch of the Isherwood family.
#. ~ Name of an NPC class
msgid "Claire Isherwood"
msgstr "Claire Isherwood"

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Job description of "Claire Isherwood" NPC class
msgid "I'm the matriarch of the Isherwood family"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid "Is that a U.S. Marshal's badge you're wearing?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid "Hi, what brings you here?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Yes, I'm a marshal."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, nice farm you have here."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, Jack suggested I stop by and say hello."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_jay_dialogue.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_merchant.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk.json
#: data/json/npcs/robofac/ROBOFAC_SURFACE_FREEMERCHANT.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom.json
#: data/mods/Magiclysm/npc/TALK_FORGE_ARDELIA.json
#: data/mods/Magiclysm/npc/TALK_FORGE_HELEN_TAVREL.json
#: data/mods/Magiclysm/npc/TALK_FORGE_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "Let's trade."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hey, when would more of this stuff be ready?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid "Around <interval>."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Alright then, bye."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid "I live here with my husband, Jack.  He is working out in his shop."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Response to NPC dialogue
msgid "You are lucky to have your family still together."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Must be nice, to have the quiet place amid so much madness."
msgstr "Musí být krásné mít tak tiché místo uprostřed tohohle šílenství."

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"You don't need as much luck if you are prepared and work together.  We've had "
"our losses, my brother in law, Barry, was our best hunter but things are so "
"different now…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What happened to Barry?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "A farm must be a pretty safe place these days."
msgstr "Farma musí být v těchto časech bezpečné místo."

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Well, nice to meet you.  I imagine Jack was boasting about my herbal "
"remedies, he's proud of what we've put together here."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Response to NPC dialogue
msgid "He did mention you make remedies, are they effective?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I have always studied and made some natural remedies, but now they are more "
"essential than ever.  Who knows the next time we'll see a trained doctor.  "
"These remedies aren't always as effective, but they can do the job in a pinch."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Some of their cows were killed before we realized what was happening, Barry "
"and Carlos went into the forest to find the predator but it was like nothing "
"they'd ever seen.  Carlos may be willing to tell you more."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"We've always tried to live a quiet life out here, I suppose we are doing "
"better than most."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Jack and I have been together for 40 years.  He's been my anchor through all "
"of this chaos."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Jesse and her family live up at the horse farm.  They may have some jobs for "
"you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Eddie's dairy is at the end of the road.  He's may have some jobs for you if "
"you are interested."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid "You should get off our land, you have no business here."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ NPC dialogue line
msgid "Ask away."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Tell me about your husband, is he around?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Your daughter lives down the road?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Where is your brother's place?"
msgstr "Kde bydlí tvůj bratr?"

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Mission name
msgid "Gather 50 dandelions"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Gather 50 dandelions"
msgid "I could use some help foraging ingredients."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Gather 50 dandelions"
msgid ""
"I could use some fresh dandelions for the next batch of wine.  Can you bring "
"me 50 dandelions?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Gather 50 dandelions"
msgid "Thank you, I'll put these to good use."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Gather 50 dandelions"
#. ~ Dialogue line in mission "Find 20 bee balm seeds"
msgid "Oh well.  Maybe some other time, thanks."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Gather 50 dandelions"
msgid "You can find them in the fields during the spring and summer months."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Gather 50 dandelions"
msgid "Thanks.  Here's a small reward to show my appreciation for your help."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Gather 50 dandelions"
msgid "I wonder if the wildlife ate all the greens…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Mission name
msgid "Find 20 bee balm seeds"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find 20 bee balm seeds"
msgid "I could use some seeds from the forest."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find 20 bee balm seeds"
msgid ""
"We could use some seeds for the next planting season.  Can you bring me 20 "
"bee balm seeds?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find 20 bee balm seeds"
msgid "Thank you.  It's important to have a good stock before the flu season hits."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find 20 bee balm seeds"
msgid ""
"You should search through the forest, make sure to check in the underbrush "
"for bee balm and then harvest its seeds."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find 20 bee balm seeds"
msgid ""
"Wow, perfect.  Here are some of my own remedies and if those don't work try "
"my other gift."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find 20 bee balm seeds"
msgid "I'll have to find someone more at home in the forest…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Mission name
msgid "Find and capture a cat"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid "I could use a barn cat to keep the mice down."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid "I saw some feral cats out by the old cabin.  Can you capture one for me?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid ""
"Thank you!  Please hurry back!  Take this cage so you have a chance of "
"capturing one."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid "I didn't want to use chemicals on these rats."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid ""
"Take this pet carrier; if you can get close to a cat, you can put it inside.  "
"If you're having problems, try befriending it with cat food."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid "Have you found a cat?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid ""
"Thank you so much, I want you to have this copy of my natural remedy journal. "
" I'll name this handsome fellow Joshua."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid "What?!  You're lying, I can tell!  Did you even bring back my cage?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Claire_Isherwood.json
#. ~ Dialogue line in mission "Find and capture a cat"
msgid "Oh no!  I guess they are too nimble for you…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Nice dairy, must be tough keeping it running."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "When will your cows produce again?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*is a sun-worn, middle-aged man with crows feet and graying hair.  He looks "
"up as you approach, "
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"then sneers as he spots the Old Guard Marshal badge gleaming on your chest.  "
"\"I already told your kind not to come around here.  You need to keep on "
"walking, straight off this property.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid "then gives you a little greeting wave.  \"Hello Sir, what brings you here?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid "then gives you a little greeting wave.  \"Hello Ma'am, what brings you here?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Luke said you guys have some issues with the Old Guard.  What's up with that?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid "*glares at your marshal badge.  \"I said, keep *walking*, G-man.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*spits on the ground, glancing at where your marshal badge would have been, "
"and shaking his head.  \"Nice try.  You can take off the badge, but I know "
"what you are, I'm not some country rube.  Get out.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"<color_green>[Social 3]</color> I swear, I'm not here to cause trouble.  I "
"just volunteer with those guys to help travelers, things like that.  I don't "
"speak for them."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>[Social <3]</color> I took it off man, what more do you want "
"from me?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Fine, I'm gone."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
", looking at your marshal badge immediately.  \"Nope.  Agreement or not, I'm "
"not talking to you while you're wearing their sign, and I don't appreciate "
"the disrespect.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
", his eyes darting to the spot where your marshal badge would be.  \"What "
"now?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What's the deal with you and the Old Guard, anyway?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*spits on the ground.  \"Didn't much care for the government and the cops "
"before everything happened, care for them quite a bit less now.  We've had a "
"run-in or two with the folks calling themselves the 'Old Guard'.  That's all "
"I care to say about it.  They'll never be welcome on my land and I don't "
"believe for a second that they didn't cause all this in the first place.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Thanks for telling me.  <end_talking_bye>"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*grimaces.  \"Fine, I'll give you a chance, but you don't mess with me or my "
"family, you understand?  This is our land, not yours.  Or theirs.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Thanks for hearing me out."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Thanks.  I'll give you space for now."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid "I feel like maybe you didn't hear me right.  Get.  Off.  My.  Land."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "You can't make me."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid "If the cows don't get anything nasty it should be around <interval>."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Cheers, bye."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I run this dairy with my son, Luke.  It's been a tough job keeping the herd "
"together, hasn't left a lot of time for other projects."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I heard about Barry, such a tragedy.  Can you tell me more about what "
"happened?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*speaks in a quiet monotone, like he's reading off a page.  \"Barry and "
"Carlos went to hunt down something that killed our livestock, they tracked it "
"into the forest.  It grabbed Barry and ran off, you might be able to get "
"Carlos to tell you the story, if he can bring himself to share what happened.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah, I could use some help getting materials.  I want to outfit that old "
"building across the road with some kilns.  We want to make our own jars and "
"pottery so we aren't dependent on scavenging."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "That is a good idea, what do you need?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'm not interested right now.  <end_talking_leave>"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Luke was going to start college this year, now everything is upside down.  He "
"is adaptable though, had an idea to begin manufacturing our own jars and "
"pottery.  He's out in the old outbuilding right now, cleaning up the place."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ NPC dialogue line
msgid "Jesse manages the horses and other livestock, she is amazing with animals."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Carlos will be in his workshop if he isn't out hunting.  He is trying to get "
"a forge set up."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Your son helps with the dairy?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "So, Jesse runs the horse farm?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Where can I find Carlos?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Mission name
msgid "Gather 120 Rocks"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 120 Rocks"
msgid "We need to build some kilns."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 120 Rocks"
msgid "I could use 120 rocks to construct some kilns."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 120 Rocks"
msgid "You can break up some larger stones, or gather them up from the fields."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 120 Rocks"
msgid "Thanks anyway, we'll find the time to get them ourselves."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
#. ~ Dialogue line in mission "Gather 120 Rocks"
#. ~ Dialogue line in mission "Gather 75 Rocks"
msgid "Mining would always be an option if you had the resources."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 120 Rocks"
msgid "Do you have the stone?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 120 Rocks"
msgid "I appreciate it, this will make Luke happy."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Mission name
msgid "Gather 2000 units of sand"
msgstr "Shromáždi 2000 jednotek písku"

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 2000 units of sand"
msgid "I do have some resource gathering I could use help with."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 2000 units of sand"
msgid ""
"Now that the forge is set up, we could use 2000 units of sand to get "
"production going."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 2000 units of sand"
#. ~ Dialogue line in mission "Gather 100 units of clay"
msgid "Oh well.  I'll try to find time to get it myself, thanks."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 2000 units of sand"
msgid ""
"You can find it along river banks, or maybe landscaping supplies and hardware "
"stores."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 2000 units of sand"
msgid "Thanks, now Luke can get started.  Here's a token of my thanks."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 2000 units of sand"
#. ~ Dialogue line in mission "Gather 100 units of clay"
msgid "I wonder where all the sand went…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Mission name
msgid "Gather 100 units of clay"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 100 units of clay"
msgid "I do have some resource gathering I could use help if you have time."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 100 units of clay"
msgid ""
"Now that the clay kiln is set up, we could use 100 units of clay to get "
"production going."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 100 units of clay"
msgid "You can find it along river banks, or maybe look for deposits in the forest."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#. ~ Dialogue line in mission "Gather 100 units of clay"
msgid ""
"Thanks, now Luke can get started making jugs, We'd like to give you a cow, "
"Here's Daisy, take good care of her and she'll provide you with milk."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/snippets/snippets.json
#. ~ Nickname for creature 'mon_cow' in an effect
#. ~ Snippet in category "<dog_name>"
msgid "Daisy"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Unique name of a male NPC
#. ~ Patriarch of the Isherwood family.
#. ~ Name of an NPC class
msgid "Jack Isherwood"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Job description of "Jack Isherwood" NPC class
msgid "I'm the patriarch of the Isherwood family"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'm here to deliver some resources."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "This is a lot of land, you been here since the collapse?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I live here with my wife, this is our family's land.  My daughter's family "
"and son live down the road."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Your whole family survived?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"We've had our losses… now we stay close to home, preparing for trouble.  "
"We've always taken disaster preparedness seriously, but we didn't expect "
"anything like this though."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Even out here we've had some attacks and seen… other things.  We have been "
"working on our defenses, but it takes time.  We've been able to keep up with "
"the crops and animals though so we won't have to risk our necks for supplies."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What sort of defenses do you want?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"We want to put up more fencing and build some look out spots, maybe lay some "
"traps for the monsters.  We could use some extra resources.  If you want to "
"bring me logs, sand, clay, wire, nails, wood planks, and metal chunks, I'll "
"give you signed chits you can use to buy goods from any of the family."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Sounds reasonable, I'll see what I can do."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Claire and I have been together for 40 years now, couldn't run this place "
"without her.  She's quite the herbalist too, been real useful lately.  She is "
"probably in the house, you should stop in."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Jesse and her family live up at the horse farm.  Her husband, Carlos, may "
"have some jobs for you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Eddie's dairy is at the end of the road.  It's just him and his son since "
"Barry was taken by that thing in the woods."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"You should get off my land, the government proved its incompetence with this "
"catastrophe."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Tell me about your wife, is she around?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_broker.json
#. ~ NPC dialogue line
msgid "Excellent.  What've you brought us?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Mission name
msgid "Find 10 3 L jars"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 10 3 L jars"
msgid "I could use some help scavenging."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 10 3 L jars"
msgid ""
"We could use some 3 liter jars to preserve our produce.  Can you bring me 10 "
"large three liter jars?  I'll give you some preserves in exchange."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 10 3 L jars"
msgid "Thank you.  It's important to preserve foods while we can."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 10 3 L jars"
msgid "Oh well.  I'll see if I can find another way, thanks."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_broker.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_missions.json
#. ~ Dialogue line in mission "Find 10 3 L jars"
#. ~ Dialogue line in mission "Find 100 wheat seeds"
#. ~ Dialogue line in mission "In a Pickle Pt. 2"
#. ~ Dialogue line in mission "In a Pickle"
msgid "Grocery stores, house kitchens, there's plenty of places to look."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 10 3 L jars"
#. ~ Dialogue line in mission "Find 100 wheat seeds"
msgid "Wow, perfect.  Thanks.  Here's your reward."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_broker.json
#. ~ Dialogue line in mission "Find 10 3 L jars"
#. ~ Dialogue line in mission "In a Pickle Pt. 2"
msgid "I wonder where all the jars went…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Mission name
msgid "Find 100 wheat seeds"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 100 wheat seeds"
msgid "I do have some more scavenging for you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 100 wheat seeds"
msgid ""
"We could use some seeds for the next planting season.  Can you bring me 100 "
"wheat seeds?  I'll give you some fresh produce."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 100 wheat seeds"
msgid "Thank you.  It's important to preserve healthy foods while we can."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_broker.json
#. ~ Dialogue line in mission "Find 100 wheat seeds"
#. ~ Dialogue line in mission "In a Pickle Pt. 2"
msgid "Oh well.  I'll see if I can find another supplier, thanks."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Dialogue line in mission "Find 100 wheat seeds"
msgid "I wonder where all the seeds went…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid "Leave our property, Marshal."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid "Hello.  We don't see many people these days."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, it looks like you are doing well here."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, Jack and Claire suggested I come down here and meet you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"It would be a lot harder without family.  Keeping the animals safe is "
"essential to our future."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Sounds like you are betting on civilization not coming back."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Do you have any animal care tips?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"We can't wait for someone else to fix things, we need to take care of "
"ourselves."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Horses make good all around companions.  They can get places that cars can't "
"and also help when all the engines fail.  They become very trusting if you "
"feed them some nice fodder."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Oh good, I'm sure Jack wanted to put you to work.  If you're interested, I "
"could use a hand clearing out the woods.  My son, Chris has his hands full "
"trying to keep the predators under control."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I'd like to speak with Carlos too about some work."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Is Chris around?  I'd like to know what he's run into out in the woods."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What needs killing?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid "He's out back in the workshop."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"He's out doing some surveying, we are planning on adding a fence line and "
"some defenses."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ NPC dialogue line
msgid "You should get off my farm, I won't deal with a government stooge."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Looks like you are doing well here."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Jack and Claire suggested I come talk to you."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Is Chris around?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Mission name
msgid "Kill wolves"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill wolves"
msgid "We could use some help killing some wolves."
msgstr "Mohl bys nám pomoct zbavit se pár vlků."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill wolves"
msgid ""
"There's been some wolves that keep scaring our chickens and horses, I'd be "
"grateful if you can kill them."
msgstr ""
"Máme tady několik vlků, co nám pořád strašej koně a slepice. Byl bych ti "
"vděčnej, kdybys je pozabíjel."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill wolves"
msgid "Wonderful, let me know when it is done."
msgstr "Bezva, dej mi vědět, až s tím budeš hotovej."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill wolves"
#. ~ Dialogue line in mission "Kill monsters"
msgid "Thanks anyway, we will try some traps."
msgstr "No ale stejně dík. Asi zkusíme nějaký pasti..."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill wolves"
#. ~ Dialogue line in mission "Kill monsters"
msgid "A gun will probably help."
msgstr "Asi se ti bude hodit bouchačka."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill wolves"
#. ~ Dialogue line in mission "Kill monsters"
msgid "Did you kill it?"
msgstr "Sejmuls je?"

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill wolves"
msgid ""
"I appreciate it, I've got this old saddle I want you to have.  I'll be happy "
"to put a horse under it if you want to do some more heroics."
msgstr ""
"Mockrát děkuju. Mám tady tohle starý sedlo, je tvoje a rád ti do něj dám i "
"pěknýho koně, pokud se by se ti teda chtělo vykonat ještě nějaký hrdinský "
"činy."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill wolves"
#. ~ Dialogue line in mission "Kill monsters"
msgid "Show me the bodies."
msgstr "Ukaž mi ty mršiny."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Mission name
msgid "Kill monsters"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill monsters"
msgid "We could use some help killing some monsters."
msgstr "Mohl bys nám pomoct zbavit se nějakejch příšer."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill monsters"
msgid ""
"We could use some help killing a pack of monsters.  I don't know what they "
"are, but they're very fast, I'm willing to outfit you with a horse if you "
"succeed."
msgstr ""
"Potřebovali bysme pomoct pozabíjet smečku příšer. Netuším, co jsou zač, ale "
"jsou zatraceně rychlý. Jestli to sfoukneš, jsem ochotnej tě vybavit koněm."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill monsters"
msgid "Be ready for anything."
msgstr "Očekávej cokoliv."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Dialogue line in mission "Kill monsters"
msgid ""
"I appreciate it, this will help keep our animals safe.  This is, Steve, he's "
"a good, steady horse.  You should talk to Carlos about some armor for him."
msgstr ""
"Mockrát děkuju, teďka budou naše zvířata v bezpečí. Tohle je Steve, je to "
"dobrej, věrnej kůň. Měl bys hodit řeč s Carlosem kvůlivá nějakýmu brnění pro "
"něj."

#: data/json/npcs/isherwood_farm/NPC_Jesse_Isherwood.json
#. ~ Nickname for creature 'mon_horse' in an effect
msgid "Steve"
msgstr "Steve"

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I see that badge, I think you need to keep on walking, straight off this "
"property."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, this is a nice farm, your family lives here?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, I'm looking for Jesse."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hi, I'm looking for Chris."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I talked to Chris about rescuing Barry.  He thinks you might be able to help."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"My family owns all the land around here, my parents are out in the barn and "
"my other family is down the road."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Ok, I'll go find them."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Mom is in her office, in the barn.  Be careful that you don't let our horses "
"out."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid "Chris is out hunting or something right now."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Oh, ok."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Or something?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Nice talking to you, bye."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Well, he's supposed to be hunting, but since you've been talking to Luke, I "
"bet he mentioned Chris wants to learn more about the end of the world.  "
"Sometimes he'll take off for a few days and I end up patching him up so my "
"parents don't know he left the property."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah, Chris talked to me a minute ago.\"  She touches the shoulder strap on "
"her rifle.  \"I can't believe he's not trying to talk me out of it, really, "
"but I'd do anything to save Uncle Barry.  I'll be ready at the tower, when "
"you need me."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Great.  I'll see you there."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"He did?\"  She touches the shoulder strap on her rifle.  \"Like, action?  "
"Yeah, I'm a pretty good shot, and I'd do anything to save Uncle Barry.  I'm "
"surprised Chris didn't try to go all protective older brother on me.  What's "
"the plan?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ Response to NPC dialogue
msgid "[Explain the plan.]"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Lisa_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"&She listens intently as you explain.  \"All right.  I'll be ready at the "
"tower when you need me.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*is a young man in his mid teens, wearing threadbare but clean work trousers "
"and a plain shirt with a few holes in it.  He looks you up and down as you "
"approach"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
", then scowls as he spots the Old Guard Marshal badge gleaming on your chest. "
" \"I see that badge.  You should leave before my father spots it.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
", and nods once when he sees you've taken off your marshal badge.  \"Tread "
"carefully around here, we don't have a lot of respect for your type of "
"lawman.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ", then raises a hand to greet you.  \"Hello.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
", then raises his hand to his forehead in an old fashioned hat-tipping sort "
"of gesture.  \"Hello.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What's wrong with me being a marshal?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Your dad said you were out here fixing up this place."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "How are those books doing for you?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Chris and I have a little project for you that we've cooked up, if you're "
"interested."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "We've got the truck, what's next?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I've got the dynamite you requested, I can't wait to see how this works out."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Hey, what are you doing out here?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I don't see how it's much of your business what our story is.  You can try "
"asking my dad, Eddie, if you really want.  Just don't start acting like some "
"little piece of tin in your pocket means you can come in like you own the "
"place."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Yeah, I work on it when I have the time.  I can't leave the farm too long, so "
"I can't find some things I need."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Maybe I can help out.  What do you need?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Must be tough having the world fall apart when you had you future to look "
"forward to."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*gestures to where they sit on a shelf.  \"I've been trying to look at them, "
"but I can't focus too much right now.\"  He smiles sadly.  \"Hope to get to "
"them soon.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Because of Barry?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*winces a little at the name.  \"Yeah.  Because of Barry.\"  You can see he'd "
"rather not pursue the topic."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*smiles.  \"Bit early to tell, but I've been doing some night time reading "
"and trying a few things out.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*smiles brightly.  \"Real great, thanks!  I've learned a lot from them "
"already.  Tried my hand at some basic stuff, it's fun to learn new things.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*gestures around at the worn down shed surrounding you.  \"I've been cleaning "
"up this old building to make it into a workshop.  I want to put up a pottery "
"kiln and forge.  My dad doesn't want me leaving the farm to find some things"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
", says it is too dangerous.  After what happened with Barry, well, I tend to "
"agree with him.\"  He smiles thinly.  \"Don't want you to have to run out "
"saving another one of us, right?\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
", says it's too dangerous.  I used to think he was being a pain in the butt, "
"but lately…\" he stops abruptly, and says nothing more."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I know all the grown-ups worry about us, but I think we can adapt better than "
"them in the long run.  Chris - my cousin - has some interesting thoughts on "
"the matter."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "What sort of ideas does Chris have?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"&His shoulders slump a little at the question.  \"Things have been tough for "
"my dad since Barry was captured.  He works till he falls asleep most nights…\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*looks around, then leans in just a little closer.  \"He's doing OK now that "
"Barry's home, but, well, things still aren't the same.  I imagine that'll "
"take time.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*goes a bit pale.  \"I shouldn't have said that.  Not my place to talk to a "
"stranger about it.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"I already know Barry got captured.  I just wanted to know a bit more about "
"it.  Maybe I can help."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I might be able to help, though."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"*frowns.  \"I don't know how much I can tell you.  Your best bet is to talk "
"to Uncle Carlos.\""
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"I really… okay.  Maybe ask my grandma, Claire.  She'll know if it's okay to "
"talk about."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Chris is a little older than me, he's up at the horse farm with his parents "
"and sister, Lisa."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"Well, he doesn't agree that what we're doing here will last.  He thinks "
"things will only get worse.\"  Luke shrugs, as if to say he doesn't have a "
"strong opinion on the matter.  \"It's tough to get the adults to listen "
"though, much less agree with his solution.  You can go talk to him more about "
"it if you want."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid "You won't find any help here."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Tell me about your dad."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid "How does this all come together?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid ""
"Well, we are going to turn this truck into a bomb that'll give us a big "
"enough opening in the tower to let out some of the heat and gas.  But small "
"enough that it won't kill Barry unless it's right next to him."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid "Are you serious?  This is your brother we are risking here!"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Exactly, and I wouldn't do anything to risk him unnecessarily."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"OK so I have an idea on how we can breach that tower.  We need a truck and "
"some dynamite.  I've heard about some bandits in a truck robbing people "
"nearby.  If you can take care of the bandits I'll pick up the truck later"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "I think I can manage two bandits."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Surely we can think of a better way in."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid ""
"So now that we've got the truck we need the boom.  See if you can find some "
"dynamite at the old mines?  Once we got the dynamite I'll rig that up to a "
"kitchen timer and we'll have a bomb on wheels.  I'll need 50lbs to light that "
"truck up like the 4th of July!"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "This is gonna rad as heck as long as it works."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Not doing it."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ NPC dialogue line
msgid "I've got everything I need to make this breaching truck for us.  Thanks!"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Response to NPC dialogue
msgid "[heck yeah]"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Mission name
msgid "Find The Art of Glassblowing book"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
msgid "I need more knowledge to get the glass blowing started."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
msgid ""
"I could really use a book on glass blowing.  With the internet gone, I don't "
"have any handy references."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
msgid "Fantastic, I'm not supposed to leave our land."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
msgid "Oh well, figured I'd have to do a lot of practice anyway."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
msgid "A library, bookstore or a glass blower's studio should have one."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
#. ~ Dialogue line in mission "Find a copy of Homebrewer's Bible"
msgid "Do you have the book?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
msgid "I appreciate it, this will make my life so much easier."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
msgid "I don't see a book…?"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find The Art of Glassblowing book"
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
msgid "At least you escaped with your life…"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Mission name
msgid "Find a copy of DIY Compendium"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
msgid "I need more knowledge to get better pottery."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
msgid ""
"I could really use the book, DIY Compendium.  With the internet gone, I don't "
"have any handy references."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Dialogue line in mission "Find a copy of DIY Compendium"
msgid "A library, bookstore should have one, schools are another good idea."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Mission name
msgid "Retrieve the Truck for Luke Isherwood"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Description of mission "Retrieve the Truck for Luke Isherwood"
msgid "Kill the two bandits for Luke Isherwood to get their truck."
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Mission name
msgid "Retrieve Some Dynamite for Luke"
msgstr ""

#: data/json/npcs/isherwood_farm/NPC_Luke_Isherwood.json
#. ~ Description of mission "Retrieve Some Dynamite for Luke"
msgid ""
"Get 50 pounds of dynamite for Luke Isherwood to make a bomb.  There's a known "
"shipment at a mine in the region."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Name suffix of an NPC
#. ~ Former prisoner with a melee or ranged weapon and prison clothing.
#. Sometimes they also have prison guards' gear.
msgid "prisoner"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Name suffix of an NPC
#. ~ Former prisoner with a melee or ranged weapon and prison clothing.
#. Sometimes they also have prison guards' gear.
msgid "gatekeeper"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Name suffix of an NPC
#. ~ Former prisoner with a melee or ranged weapon and prison clothing.
#. Sometimes they also have prison guards' gear.
msgid "leader of prisoners"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#: data/json/npcs/prisoners/mi-go_prisoners.json
#. ~ Name of an NPC class
#. ~ Skills intentionally kept low.  This character should probably have a
#. higher chance of having insanity type traits eventually.
msgid "Prisoner"
msgstr "Vězeň"

#: data/json/npcs/island_prison/prisoners.json
#. ~ Job description of "Prisoner" NPC class
msgid "I'm here to kick ass."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "Get the fuck out of here."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Ok, sorry, I'm already leaving!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Hey, fuck you, <name_b>!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "Do I need to repeat myself?  Get outta here, <name_b>."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Yeah, I got it.  <end_talking_bye>"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "I just wanted to ask if you have a job for me."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "I'm just hungry, and I thought you might give me some food for some job."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Can we just talk it over?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "Get out, loser."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"Do I have a <freaking> exclamation sign over my <freaking> head, like I'm a "
"<freaking> quest-giver from some <freaking> video game?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "No, of course not!  Sorry, I'm leaving."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "Disappear, <name_b>."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Ok, sorry, I promise I won't bother you anymore."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Gee, what's the matter with you?  Okay, okay, I'm leaving."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "It would be you who will regret talking to me like that."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"Not so fast, I think you need to pay for breaking your promise and bothering "
"me.  Give me your shit, now!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Please don't hurt me!  Take all that you want."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "What, <no>!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "I have nothing more to say to you.  Get the fuck out of here."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "So, what are you waiting for?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "You are what you eat, as they say."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "It's you again."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"Hello there.  Haven't seen you around before.  You must be from the other "
"wing.  Managed to survive, huh?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Yeah, I've been through situations far worse than that."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid ""
"It was a nightmare, lots of <zombies>, blood everywhere!  Thank god I'm among "
"living people again."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid ""
"[CANNIBAL] It's hard to die of hunger when there's so many tasty corpses "
"lying around."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid ""
"I want to get out of this <freaking> prison.  I hoped you could help me with "
"that."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "I'm on my way."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "I don't know if I'll take your advice, but thanks nevertheless."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid ""
"Wait, what?  A <freaking> can of beans?!  I went through hell to get this "
"<freaking> thing for you, and all you give me as reward is a <freaking> can "
"of beans?!  I demand something more substantial."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Nice talking to ya.  Farewell."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"Huh, even so?  I'm not saying I approve your… tastes, but I definitely "
"respect people who use all possibilities life has to offer."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Yeah, we share the same opinions on this matter."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"Well, that's a boastful statement.  Not that I don't believe it, it's just….  "
"Ah, nevermind.  Let's get to the point.  What do you want?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "Hold the horses, pal.  Nobody allowed you to stay here - yet."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid ""
"Please!  I don't want to go back there!  I'm tired and hungry!  I just need "
"time to rest!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Shit!  Looks like I'm on my own now.  Thanks for nothing.  <end_talking_bye>"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"We don't have much space, and there's not much food.  Besides, I don't know "
"you at all, and something tells me you won't survive another day."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "[STR 11] I'm tougher than it seems!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "[Survival 2] I have some survival expertise!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "I guess I need to find some other place…"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"The answer is still no.  In fact it might be better for us to kill you right "
"away - you know, the less mouths to feed, the better.  But I'm in a good mood "
"today, so I've decided to help you get out of this island."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Ok, I'm listening."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "You know, I think I'll manage without your help.  <end_talking_bye>"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "I need you to retrieve some stuff from a locked safe.  Interested?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "[Show the military ID card.] You mean this stuff?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "What's in the safe?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "What for do you need it?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#: data/json/snippets/schizophrenia.json
#. ~ Response to NPC dialogue
#. ~ Snippet in category "schizo_self_talk"
msgid "Yeah, sure."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "I have a bad feeling about this.  Sorry, I'll pass."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"As I said, that's the thing I need.  You don't need to know what's that "
"exactly.  Just grab all things you find in the safe, and call it a day."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "That's weird."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "Let's say that's none of your <freaking> business.  Other questions?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid "Hey, where did you get it?  Nevermind, just give it to me.  Right now."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Hey, no need to be hostile.  Here you go, I don't need it anyway."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid ""
"I went through incredible hardships to get it.  Please, can I keep this to "
"myself?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid ""
"I killed tons of <zombies> while I was trying to get this thing.  Do you "
"really think you and your handful of losers pose a threat to me?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"Okay.  It was convincing.  I'll still get what I want, one way or another.  "
"You better watch your back from now on."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Noted.  <end_talking_bye>"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ NPC dialogue line
msgid ""
"I'm afraid you're not in the position to demand anything from me, <name_b>.  "
"You're done here, leave."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Hey, fuck you, <name_b>!  You'll regret that!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Response to NPC dialogue
msgid "Okay, fine.  Cheapskate!"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Mission name
msgid "Get The Thing from the chief's office"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
msgid "Here's the job…"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
msgid ""
"My snitch whispered in my ear that the thing I need is located in the chief's "
"safe in his office.  You need to crack it open and bring the contents to me.  "
"Don't try to use anything you find in there!  Just bring all the stuff to me, "
"and I'll help you.  Deal?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
msgid ""
"Great!  Don't forget that I need all stuff from the safe, try not to lose a "
"thing."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
msgid "Fine, I'll get the thing in any case, sooner or later."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
msgid ""
"The chief's office is on the other side of the prison.  I think the road "
"there is full of <zombies>, so you better find a weapon.  Also you probably "
"will need some tools to crack the safe open."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
msgid "Did you get the stuff already?"
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
msgid ""
"At last!  Give me a few moments to check if it isn't damaged.  Here, take "
"this for your troubles."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#: data/json/npcs/refugee_center/surface_refugees/NPC_Jenny_Forcette.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
#. ~ Dialogue line in mission "Find reference material about air rifles for
#. Jenny."
#. ~ Dialogue line in mission "Find an electric motor"
msgid "Huh.  This isn't going to work like I thought."
msgstr ""

#: data/json/npcs/island_prison/prisoners.json
#. ~ Dialogue line in mission "Get The Thing from the chief's office"
msgid "You're useless.  I should've killed you when I met you."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid "Hiya darlin', welcome to the shop."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid "Hey, killer!  How's it going?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid "Still the apocalypse out there, huh?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid "See anything you like?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_jay_dialogue.json
#. ~ Response to NPC dialogue
msgid "About that contract…"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "What's with all the weapons and armor?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "Are you and Jay close?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "[Motion to the sketches.] What is it that you are working on?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "[Motion to the sketches.] You seem more excited about this stuff recently."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "I'd like to know more about some of your 'special' projects."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid ""
"[Show the nomad jumpsuit blueprint.] Hey - I met a group with some "
"interesting ideas for armor design.  Is any of this of use to you?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "[100 merch] I'd like to become a member of the co-op."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_jay_dialogue.json
#. ~ Response to NPC dialogue
msgid "About those contracts…"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Why do you hate merch?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Could you make me a suit of armor?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Could you make me a weapon?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "How is my armor coming?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "How is my weapon coming?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "You mentioned you'd need some special materials to make that nomad armor?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Interesting.  When would be the next batch of merchandise ready?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "I heard you might want some metal…"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid "With how the things are goin'? <interval>."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "I'll leave you to your work then.  <end_talking_bye>"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"I'm Cody, was an engineer before everything went to hell.  I guess I still "
"am, but I don't have to consult anymore, so I consider that a plus at least."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"I don't know if you've met Jay yet, but he and I split a garden out here.  We "
"both work - well, worked - in technology, and we were convinced the world was "
"ending so we both got property outside town.  We met when he moved in next "
"door.  So this is our little homestead with a few upgrades.  We aren't really "
"sweating property lines at this point."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"I make them myself!  I've always loved traditional armaments and am a proud "
"member of the SCA!  Figured now that everything has gone to hell I can make "
"it a full-time thing.  Lots of survivors in need of a big ol' hammer or some "
"armored guards to keep the biters off."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "It must take some serious equipment to make all this."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"Well, what can I say, I had lots of disposable income.  Kept me busy and all "
"that.  So yeah, I've got a pretty impressive shop in the back."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid ""
"[INT 8] Still this is a lot of equipment.  Wouldn't it have been easier to "
"buy this stuff from a manufacturer?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Can anyone use the workshop?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"Honey, I have a hard time finding a bra that fits.  Good luck finding a "
"breastplate."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid ""
"Tell me about it, finding anything that fits in this apocalypse has been a "
"nightmare."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Oh, uh.  Right, uh."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"Well, not *anyone*, but I've always been a believer in community.  The shop "
"is run as a co-op, so if you want access you'll have to buy a share.  As a "
"partial owner, you will have full access to the shop.  Shares are currently "
"100 merch; I hate the currency but it's the closest thing we've got to a "
"representation of labor."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "[100 merch] Yeah, I can do that."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"There yah go, one co-op membership with your name on it.  Shop's in the back, "
"keep it tidy and share if anyone else is around workin'.  Just as a heads-up, "
"you'll need to bring your own charcoal.  There's a kiln in there too, so if "
"you got things to burn, just throw 'em in there and light up."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid "Money is part of what got us into this mess in the first place."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "[PER 8] Is that why you don't carry any cash?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid "B-I-N-G-O.  If you bring it, I'll take it, but that's about it."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"Yeah, we've always got along great.  He comes over for supper every Friday.  "
"Have a few drinks, maybe take some guns out.  Or, well… we used to.  A little "
"while ago, we had a huge fight.  It was right after this stuff got real bad… "
"I'm fuzzy on the details or what I said, all I remember was being so angry "
"that I could kill him.  We haven't talked much since."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Have you apologized?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Is there anything I can do?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"It just seemed like it wouldn't be enough.  I know it's silly but I have to "
"do more than that."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"If you're offering.  Before everything went to hell, Jay was talking about "
"going to some gun show.  There was a guy there who had managed to sneak some "
"Russian gun into the US.  It was a massive deal for Jay, it was all he could "
"talk about.  I know it's a long shot, but maybe that guy was already at the "
"gun show?  If you find the gun you can keep it, but it would mean a lot to "
"Jay if he could take a look.  All he wanted was to pull it apart and put it "
"back together."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "I'll bring you back a souvenir."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_jay_dialogue.json
#. ~ Response to NPC dialogue
msgid "Not really interested."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid "Sure, honey!  I'm always in need of more material!  What's the price, though?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ Response to NPC dialogue
msgid "Well, how about 100 merch for every 70 pounds of metal…"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#. ~ NPC dialogue line
msgid ""
"Sorry, I don't really have the time to work on something like that.  I've got "
"lots of pieces for sale on the shelves."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#: data/json/npcs/isolated_road/isolated_road_jay_convert.json
#: data/json/npcs/snippets/talk_tags_avatar.json
#: data/json/npcs/snippets/talk_tags_line.json
#. ~ Response to NPC dialogue
#. ~ Snippet in category "<end_talking_nevermind>"
#. ~ Avatar response indicated that the conversation is over.
#. ~ Snippet in category "<no>"
#. ~ Generally emphatic negative responses to a request or command
msgid "Forget it."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid "[350 merch, 1.2mm] I'd prefer to just have chainmail."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid "[400 merch, 2mm] I like to stay light."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid "[500 merch, 4mm] A middle ground would be good."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid "[600 merch, 6mm] Never skimp on protection."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ NPC dialogue line
msgid ""
"Alright, <u_val:number_artisans_blacksmith_thickness>mm, so the next question "
"is time.  Currently, it's the classic problem: if you want quality, you gotta "
"wait.  Two processes I could offer that you would be hard-pressed to find "
"anywhere else are either really great high carbon steel, or I can go through "
"the lengthy process of tempering.  High carbon will take three weeks to "
"process and do the work, and tempering will take me four."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ NPC dialogue line
msgid ""
"  For five I could, I think, create a suit of that nomad armor.  It would "
"incorporate climate control, help you support more weight, and it'll have a "
"jumpsuit built in, but you won't be able to wear normal clothes with it."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid "[3 weeks, great protection] High steel sounds great."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid "[4 weeks, exceptional protection] I'll wait for the best you can do."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid "[5 weeks, CBM-integrated protection] I'd like nomad armor."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ NPC dialogue line
msgid ""
"Alright, so it'll be <u_val:number_artisans_blacksmith_thickness>mm armor "
"made of the best high steel a woman can scavenge.  If you're good with that, "
"I'll take the merch up front and we can start taking some very invasive "
"measurements."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ NPC dialogue line
msgid ""
"Alright, so it'll be <u_val:number_artisans_blacksmith_thickness>mm armor "
"made with some of the best fabrication techniques the world has ever seen.  "
"If you're good with that, I'll take the merch up front and we can start "
"taking some very invasive measurements."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ NPC dialogue line
msgid ""
"Alright, so it'll be <u_val:number_artisans_blacksmith_thickness>mm armor "
"made with some of the best fabrication techniques the world has ever seen, as "
"well as help from some extradimensional friends.  I'd be lying if I said I "
"wasn't excited.  If you're good with that, I'll take the merch up front and "
"we can start taking some very invasive measurements."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid ""
"[<u_val:number_artisans_blacksmith_armor_cost> merch] Sounds good.  See you "
"in <u_val:number_artisans_blacksmith_wait> weeks."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "Um… wait, I don't have that kind of money right now."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ NPC dialogue line
msgid ""
"It's all done!  Sorry for the long wait; hopefully it's worth it.  If you "
"need it refitted, let me know."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ NPC dialogue line
msgid "Still working on it."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "See you when it's done."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ NPC dialogue line
msgid ""
"Oh wow, this is really interesting, huh?  The way they balance weight for "
"travel is genius.  If you wanted a real suit of armor for a traveling "
"warrior, I think I could do it with this.  I'll need one of each of these "
"wire kits, though, for each set I make.  Bring some to me if you want me to "
"use them."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid ""
"I have some right now.  [Hand over a CBM interface wire kit and an external "
"climate control kit.]"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid "I'll try and find some."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#. ~ Response to NPC dialogue
msgid ""
"Here you go.  [Hand over a CBM interface wire kit and an external climate "
"control kit.]"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_scavenger.json
#. ~ Response to NPC dialogue
msgid "Not right now."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"Oh, these.  With the end of the world, Jay and I had been talking about some "
"new projects for the wasteland warriors.  Anyways, it doesn't matter anymore "
"since… well, it doesn't matter."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "I'm sure we'll fix things soon!"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"Yeah!  I feel a lot better now that Jay and I are talking again, and we've "
"been putting some serious work into this stuff.  If you wanted to help source "
"parts and do some testing, we could definitely get some prototypes made."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"I'm already working on something for you.  I only got two hands and 24 hours "
"in a day."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid "I'm still working on it, can't rush perfection."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid "Sure, what would you like to know more about?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "Can you work on one of these projects for me?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "[Motion to the picture of some kind of rifle.] What's the 'OBREZ'?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "Is the Obrez finished?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "[Motion to the picture of a switchblade.] What's the 'PRESSIN'?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "Is the Pressin finished?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid ""
"[Motion to the picture of a mace styled with fire on the head.] What's the "
"'LOUVERTURE'?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "Is the Louverture finished?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid ""
"[Motion to the picture of a sledge hammer with a piston jutting from one face "
"of the head.] What's the 'DISORDER'?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "Is the Disorder finished?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"The Obrez is a classic Mosin-Nagant that someone has cut down and removed the "
"stock of.  The idea was that in some parts of the world a surplus rifle was "
"easier than finding a pistol to conceal.  Way I see it, a sturdy classic gun "
"like that with a bit of reinforcement could make a great mace.  You find me a "
"functioning Mosin - any variant will do - and 50 merch for parts, and I can "
"get this one working in a week."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "[Mosin-Nagant M44, 50 merch] See you in a week."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "[Mosin-Nagant 1891/30, 50 merch] See you in a week."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_prototypes.json
#. ~ Response to NPC dialogue
msgid "What about another project?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_prototypes.json
#. ~ Response to NPC dialogue
msgid "I'll check in later."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"The gun is done, looking pretty sleek if you ask me.  All loaded and ready to "
"cave in a zombie."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"The Pressin was a self defense weapon for politicians in Spain.  It was a "
"small breach loaded handheld pistol that could fit in a glasses case and be "
"fired subtly.  I figure that we can improve on the design by adding a "
"retracting blade while keeping the surprise shots.  To get this working I'm "
"gonna need a .32 gun like a Kel-Tec P-32, or a Walther PPK.  I'll also need a "
"switchblade, 20 merch, and a week."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "[PPK, switchblade, 20 merch] See you in a week."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "[P-32, switchblade, 20 merch] See you in a week."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid "The gun's done.  Mind the safety on the side, this guy is pretty dangerous."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"Oh, that's one of my sillier ideas.  Jay is convinced it'll never work but I "
"really want to give it a shot.  A traditional mace with gas-venting ports and "
"an ignition system for mini bursts of fire.  Maybe I've just played too many "
"RPGs, but it seems worth a shot.  To get this one working I'm gonna need a "
"real deal mace -  something that can handle the pressure - as well as a "
"military grade flamethrower.  Fabrication will definitely take two weeks on "
"this one."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "[Mace, flamethrower] See you in 2 weeks."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"The mace is done.  It honestly works pretty great too.  Hope you get some "
"good use out of it."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"The Disorder is already kind of a real thing.  I got the idea from a viral "
"video I saw of a guy making something similar with a baseball bat for hitting "
"home runs.  Takes a sledge hammer with a center mounted piston that you can "
"arm with .22 caliber blanks.  When you hit a zombie with that sweet spot… "
"boom.  The blank goes off and sends the piston straight down into whatever "
"poor fucker you hit it with.  I'll need a sledge hammer, 80 merch, and at "
"least 20 .22 LR rounds.  Fabrication will definitely take two weeks on this "
"one."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ Response to NPC dialogue
msgid "[Sledge hammer, 80 merch, 20 .22 LR] See you in 2 weeks."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#. ~ NPC dialogue line
msgid ""
"The beast is done!  Really heavy-duty, but really packs a punch.  Be careful "
"with your fingers.  I'm serious, this thing could tear 'em off."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ NPC dialogue line
msgid ""
"Do you still want to order your "
"<item_name:<u_val:general_artisans_blacksmith_weapon>> or would you like to "
"choose something else?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "Yes, I want to order it."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[200 merch, 3 days] I need a mace."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[200 merch, 3 days] I need a steelshod quarterstaff."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[250 merch, 4 days] I need a battle axe."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[250 merch, 4 days] I need a longsword."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[250 merch, 4 days] I need a nodachi."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[250 merch, 4 days] I need a zweihander."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[200 merch, 3 days] I need an arming sword."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[200 merch, 3 days] I need a broadsword."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[200 merch, 3 days] I need a cavalry saber."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[200 merch, 3 days] I need a cutlass."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[200 merch, 3 days] I need a katana."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[170 merch, 3 days] I need a wakizashi."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[150 merch, 2 days] I need a kukri."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[250 merch, 4 days] I need an estoc."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[200 merch, 3 days] I need a rapier."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[70 merch, 2 days] I need a trench knife."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ NPC dialogue line
msgid ""
"Okay.  What about the steel grade?  Tempering will make your weapon much more "
"durable and a little sharper."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "No, high carbon steel is fine."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid "[+50 merch, +2 days] Yes, tempered steel would be excellent."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ NPC dialogue line
msgid ""
"Great, so I can make your "
"<item_name:<u_val:general_artisans_blacksmith_weapon>> for "
"<u_val:number_artisans_blacksmith_weapon_cost> merch and in "
"<u_val:number_artisans_blacksmith_weapon_wait> days.  Deal?"
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ Response to NPC dialogue
msgid ""
"[<u_val:number_artisans_blacksmith_weapon_cost> merch] Deal.  See you in "
"<u_val:number_artisans_blacksmith_weapon_wait> days."
msgstr ""

#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#. ~ NPC dialogue line
msgid "It's all done!  Sorry for the long wait; hopefully it's worth it."
msgstr ""

