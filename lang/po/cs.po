msgstr ""

#: data/mods/DinoMod/snippets/grave_labels.json
#. ~ Snippet in category "grave_label"
msgid "Died wrestling a mosasaurus.  It was not just a big gator."
msgstr ""

#: data/mods/DinoMod/snippets/grave_labels.json
#. ~ Snippet in category "grave_label"
msgid "Built a beautiful farm and filled it with dangerous dinosaurs."
msgstr ""

#: data/mods/DinoMod/snippets/grave_labels.json
#. ~ Snippet in category "grave_label"
msgid "Life did not find a way."
msgstr ""

#: data/mods/DinoMod/snippets/grave_labels.json
#. ~ Snippet in category "grave_label"
