#: data/mods/aftershock_exoplanet/maps/furniture.json
#. ~ Description of furniture "shuttle seat"
msgid ""
"The cushioned and upright facing seat of a short-ranged shuttle pod.  Has a "
"locking bar that fits over your shoulders."
msgstr ""

#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "sample freezer"
msgid ""
"A specialized freezer capable of maintaining temperatures of -80 Celsius, and "
"is often used only for the preservation of delicate scientific samples."
msgstr ""
"Specializovaný mrazák schopný uchovat teplotu -80 °C a je často využíván pro "
"uchování delikátních vědeckých vzorků."

#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "shaker incubator"
msgid ""
"A tool for keeping chemical broth nicely mixed, at just the right temperature "
"to grow bacteria.  Although, more bacteria is probably the last thing you "
"need, considering the circumstances."
msgstr ""

#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
