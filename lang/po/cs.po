msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/items/fluff.json
#. ~ Description of "Ludo"
msgid ""
"A strategy board game for two to four players, in which the players race "
"their four tokens from start to finish according to the rolls of a single die."
msgstr ""

#: data/json/items/fluff.json
#. ~ Item name
