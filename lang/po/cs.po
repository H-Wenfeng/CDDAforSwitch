#. ~ Clause text "buff_snake_static" of UI widget "ma_buff_indicator_template"
msgid "Snake's Sight"
msgstr ""

#: data/json/martialarts.json
#. ~ Description of buff "Snake Kung Fu" in martial art "Snake's Sight"
#, no-c-format
