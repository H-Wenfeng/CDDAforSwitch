#. ~ Name of spell "sylph_cultivate_goblin_fruit"
#. ~ Name of spell "undine_cultivate_goblin_fruit"
#. ~ Name of spell "selkie_cultivate_goblin_fruit"
#. ~ Name of spell "brownie_cultivate_goblin_fruit"
