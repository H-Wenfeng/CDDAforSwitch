#: data/json/martialarts.json data/json/ui/ma_style.json
#. ~ Buff name of martial art "Sōjutsu"
#. ~ Clause text "buff_sojutsu_onmove" of UI widget
#. "ma_buff_indicator_template"
msgid "Superior Positioning"
msgstr ""

#: data/json/martialarts.json
#. ~ Description of buff "Sōjutsu" in martial art "Superior Positioning"
#, no-c-format
msgid ""
"You have given up your defenses for a moment to increase the damage of your "
"attacks.\n"
"\n"
"+10% damage, -1 block attempt.\n"
"Lasts 1 turn."
msgstr ""

#: data/json/martialarts.json
#. ~ Name of martial art
msgid "Taekwondo"
msgstr ""

#: data/json/martialarts.json
#. ~ Description of martial art "Taekwondo"
