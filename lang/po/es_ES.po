#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "hole puncher"
msgid_plural "hole punchers"
msgstr[0] "perforadora de papel"
msgstr[1] "perforadoras de papeles"
msgstr[2] "perforadoras de papeles"

#: data/json/items/tool/stationery.json
#. ~ Description of "hole puncher"
msgid ""
"A metal tool that can punch a single hole in a piece of paper.  I mean, you "
"could do more if you wanted, but you'd have to do them one at a time.  Or, if "
"you really wanted more holes with one punch, I suppose you could fold the "
"paper….  This is a one-cylinder hole puncher."
msgstr ""
"Una herramienta de metal que puede hacer un solo agujero en un trozo de "
"papel. Podrías hacer más si quisieras, pero tendrías que hacerlos de uno en "
"uno. O, si realmente quisieras más agujeros con un solo punzón, supongo que "
"podrías doblar el papel.... Esta es una perforadora de un cilindro."

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "letter opener"
msgid_plural "letter openers"
msgstr[0] "abrecarta"
msgstr[1] "abrecartas"
msgstr[2] "abrecartas"

#: data/json/items/tool/stationery.json
#. ~ Description of "letter opener"
msgid ""
"A sterling silver letter opener resembling a small dagger, with a sharp point "
"and no cutting edge.  It's used to open mail envelopes neatly and quickly."
msgstr ""
"Un abrecartas de plata de ley parecido a una pequeña daga, con punta afilada "
"y sin filo. Se utiliza para abrir sobres de correo de forma ordenada y rápida."

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "pair of office scissors"
msgid_plural "pairs of office scissors"
msgstr[0] "tijeras de oficina"
msgstr[1] "pares de tijeras de oficina"
msgstr[2] "pares de tijeras de oficina"

#: data/json/items/tool/stationery.json
#. ~ Description of "pair of office scissors"
msgid ""
"A long pair of heavy-duty scissors.  You can use them to cut things such as "
"fabric or plastic apart."
msgstr "Unas tijeras largas y resistentes. Te servirán para cortar telas o plásticos."

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "pair of kiddie scissors"
msgid_plural "pairs of kiddie scissors"
msgstr[0] "tijeras para niños"
msgstr[1] "pares de tijeras para niños"
msgstr[2] "pares de tijeras para niños"

#: data/json/items/tool/stationery.json
#. ~ Description of "pair of kiddie scissors"
msgid ""
"A pair of short scissors designed with kids in mind.  You can use them to cut "
"things such as fabric or plastic apart, although they are probably subpar "
"compared to other alternatives."
msgstr ""
"Un par de tijeras cortas diseñadas pensando en los niños. Puedes utilizarlas "
"para cortar telas o plásticos, aunque probablemente sean inferiores a otras "
"alternativas."

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "pair of wavy scissors"
msgid_plural "pairs of wavy scissors"
msgstr[0] "tijeras onduladas"
msgstr[1] "pares de tijeras onduladas"
msgstr[2] "pares de tijeras onduladas"

#: data/json/items/tool/stationery.json
#. ~ Description of "pair of wavy scissors"
msgid ""
"A pair of wavy artistic scissors.  You can theoretically use them to cut "
"things but you should probably not get your hopes too high."
msgstr ""
"Un par de tijeras artísticas onduladas. En teoría, puedes usarlas para cortar "
"cosas, pero no te hagas demasiadas ilusiones."

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "pen"
msgid_plural "pens"
msgstr[0] "bolígrafo"
msgstr[1] "bolígrafos"
msgstr[2] "bolígrafos"

#: data/json/items/tool/stationery.json
#. ~ Description of "pen"
msgid "A fine metal pen, of much better quality than a disposable model."
msgstr "Un bolígrafo fino, de mucha mejor calidad que un modelo desechable."

#: data/json/items/tool/stationery.json
#. ~ Description of "pencil"
msgid "A sharpened HB Number 2 graphite pencil, equipped with an eraser."
msgstr "Un lápiz de grafito número HB 2 afilado, equipado con una goma."

