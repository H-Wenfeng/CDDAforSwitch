msgstr[1] "aturdidores de muñeca"
msgstr[2] "aturdidores de muñeca"

#: data/mods/Aftershock/items/gun/laser.json
#: data/mods/aftershock_exoplanet/items/gun/laser.json
#. ~ Description of gun "wrist-stunner"
#. ~ Description of "wrist-stunner"
msgid ""
"A severed robotic hand from a Wraitheon Sentinel.  The powerful electro-laser "
"stun gun embed on its wrist is still functional, and can be used when "
"connected to an UPS."
msgstr ""
"Una mano robótica cortada de un Centinela Wraitheon. La potente pistola "
"aturdidora electro-láser incrustada en su muñeca sigue funcionando, y puede "
"ser usada cuando se conecta a un SEU."

#: data/mods/Aftershock/items/gun/laser.json
#: data/mods/aftershock_exoplanet/items/gun/laser.json
#. ~ Item name
#. ~ Name of a gun
msgid "wrist-trilaser"
msgid_plural "wrist-trilasers"
msgstr[0] "trilaser de muñeca"
msgstr[1] "trilasers de muñeca"
msgstr[2] "trilasers de muñeca"

#: data/mods/Aftershock/items/gun/laser.json
#: data/mods/aftershock_exoplanet/items/gun/laser.json
#. ~ Description of gun "wrist-trilaser"
#. ~ Description of "wrist-trilaser"
msgid ""
"A powerful tri-barreled laser weapon, still mounted to the robotic hand of "
"the Wraitheon drone it originally belonged to.  Can still be fired when "
"connected to an UPS."
msgstr ""
"Una potente arma láser de tres cañones, todavía montada en la mano robótica "
"del dron Wraitheon al que pertenecía originalmente. Todavía se puede disparar "
"cuando está conectada a un SEU."

#: data/mods/Aftershock/items/gun/laser.json
#: data/mods/aftershock_exoplanet/items/gun/laser.json
