"club of bone."
msgstr ""
"Este dinosaurio acorazado de cuatro patas tiene cuernos en la cabeza y "
"grandes púas alineadas a lo largo del lomo y los costados. Su cola con púas "
"termina en una maza ósea igualmente puntiaguda."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "dyoplosaurus"
msgid_plural "dyoplosaurus"
msgstr[0] "dyoplosaurus"
msgstr[1] "dyoplosaurus"
msgstr[2] "dyoplosaurus"

