#: data/mods/Aftershock/items/comestibles/medicine.json
#: data/mods/aftershock_exoplanet/items/comestibles/medicine.json
#. ~ Item name
msgid "synthetic blood"
msgid_plural "synthetic blood"
msgstr[0] "sangre sintética"
msgstr[1] "sangres sintéticas"
msgstr[2] "sangres sintéticas"

#: data/mods/Aftershock/items/comestibles/medicine.json
#: data/mods/aftershock_exoplanet/items/comestibles/medicine.json
#. ~ Description of "synthetic blood"
msgid ""
"A chalk white blood analogue for emergency medical use.  Far more efficient "
"at oxygenation than natural blood, it can also be used as a general "
"performance enhancer.  Once injected, it will be metabolized or otherwise "
"expunged from the body in around 8 hours."
msgstr ""

#: data/mods/Aftershock/items/comestibles/medicine.json
#: data/mods/aftershock_exoplanet/items/comestibles/medicine.json
#. ~ Item name
msgid "serendipnol"
msgid_plural "serendipnols"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/mods/Aftershock/items/comestibles/medicine.json
#: data/mods/aftershock_exoplanet/items/comestibles/medicine.json
#. ~ Description of "serendipnol"
msgid ""
"A very strong, synthetic narcotic built from alien biochemistry and used to "
"treat intense pain while in the field.  You'll need to inject it, and it's "
"very addictive, so be careful."
msgstr ""
"Un narcótico sintético muy potente fabricado a partir de bioquímica "
"alienígena y utilizado para tratar dolores intensos sobre el terreno. "
"Necesitarás inyectártelo y es muy adictivo, así que ten cuidado."

#: data/mods/Aftershock/items/comestibles/medicine.json
#: data/mods/aftershock_exoplanet/items/comestibles/medicine.json
#. ~ Description of "MediGel"
msgid ""
"Mercurial brand medical gel; a thick, translucent substance that can be "
"applied to wounds to seal them and promote rapid healing.  Perhaps the most "
"useful medical invention ever devised, it's a staple of any first aid kit."
msgstr ""

#: data/mods/Aftershock/items/comestibles/medicine.json
#: data/mods/aftershock_exoplanet/items/comestibles/medicine.json
