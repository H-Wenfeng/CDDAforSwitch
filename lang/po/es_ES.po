#: data/mods/Magiclysm/Spells/attunements/Crusader.json
#. ~ "menu_text" action message of item "mace of judgement"
msgid "Transform to longsword."
msgstr ""

#: data/mods/Magiclysm/Spells/attunements/Crusader.json
#. ~ "msg" action message of item "mace of judgement"
