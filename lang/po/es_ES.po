msgstr[1] "cristales translúcidos"
msgstr[2] "cristales translúcidos"

#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
#. ~ Item name
msgid "twisted, knotted cord"
msgid_plural "twisted, knotted cords"
msgstr[0] "cuerda retorcida y anudada"
msgstr[1] "cuerdas retorcidas y anudadas"
msgstr[2] "cuerdas retorcidas y anudadas"

#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/inventor/spark_artifact_items.json
#. ~ Item name
msgid "crescent-shaped stone"
msgid_plural "crescent-shaped stones"
msgstr[0] "piedra en forma de media luna creciente"
msgstr[1] "piedras en forma de media luna creciente"
msgstr[2] "piedras en forma de media luna creciente"

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "royal robe"
msgid_plural "royal robes"
msgstr[0] "ropaje real"
msgstr[1] "ropajes reales"
msgstr[2] "ropajes reales"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "royal robe"
msgid ""
"An ornately decorated robe with an unfamiliar royal symbol on it.  The "
"humanoid figure on the seal has two pairs of eyes.  It is the only one of its "
"kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un ropaje decorado ornamentado con un símbolo real que no te es familiar. La "
"figura humanoide en el sello tiene dos pares de ojos. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "ancient burial shroud"
msgid_plural "ancient burial shrouds"
msgstr[0] "antiguo sudario funerario"
msgstr[1] "antiguos sudarios funerarios"
msgstr[2] "antiguos sudarios funerarios"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient burial shroud"
msgid ""
"A cloak of thin, faded cloth.  The faint silhouette of a long-dead humanoid "
"is barely visible on it.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Una capa de tela fina y descolorida. En ella apenas se distingue la silueta "
"de un humanoide muerto hace mucho tiempo. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "ornate fur coat"
msgid_plural "ornate fur coats"
msgstr[0] "abrigo de pelaje adornado"
msgstr[1] "abrigos de pelaje adornados"
msgstr[2] "abrigos de pelaje adornados"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ornate fur coat"
msgid ""
"A heavy, finely crafted coat made of the fur of an unidentifiable creature.  "
"It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un abrigo pesado y finamente confeccionado con el pelaje de una criatura "
"inidentificable. Objeto único.\n"
"Puede que tenga poderes; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "ancient stone mask"
msgid_plural "ancient stone masks"
msgstr[0] "antigua máscara de piedra"
msgstr[1] "antiguas máscaras de piedra"
msgstr[2] "antiguas máscaras de piedra"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient stone mask"
msgid ""
"A sinister mask made of a smooth green stone.  It is the only one of its "
"kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Una máscara siniestra hecha de una piedra verde lisa. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "ancient bronze helmet"
msgid_plural "ancient bronze helmets"
msgstr[0] "casco de bronce antiguo"
msgstr[1] "cascos de bronce antiguos"
msgstr[2] "cascos de bronce antiguos"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient bronze helmet"
msgid ""
"A helmet with an imposing face plate.  Though the corrosion has completely "
"defaced the symbols written on the sides, it seems sturdy.  It is the only "
"one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un casco con una imponente placa frontal. Aunque la corrosión ha desfigurado "
"completamente los símbolos escritos en los laterales, parece resistente. Es "
"único de su clase.\n"
"Puede tener poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "pair of ornate leather gloves"
msgid_plural "pairs of ornate leather gloves"
msgstr[0] "par de guantes de cuero adornados"
msgstr[1] "pares de guantes de cuero adornados"
msgstr[2] "pares de guantes de cuero adornados"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "pair of ornate leather gloves"
msgid ""
"A set of worn leather gloves embossed with gold.  The unidentifiable leather "
"it is made from is oddly soft.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un juego de guantes de cuero desgastado repujado en oro. El inidentificable "
"cuero del que están hechos es extrañamente suave. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "pair of ancient leather boots"
msgid_plural "pairs of ancient leather boots"
msgstr[0] "par de botas de cuero antiguas"
msgstr[1] "pares de botas de cuero antiguas"
msgstr[2] "pares de botas de cuero antiguas"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "pair of ancient leather boots"
msgid ""
"A pair of ancient leather boots.  Though the flaps of leather are crudely "
"sewn together, the red hue it is dyed with is striking.  It is the only one "
"of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un par de antiguas botas de cuero. Aunque las solapas de cuero están "
"toscamente cosidas, llama la atención el tono rojo con el que están teñidas. "
"Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "amber ring"
msgid_plural "amber rings"
msgstr[0] "anillo ámbar"
msgstr[1] "anillos ámbar"
msgstr[2] "anillos ámbar"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "amber ring"
msgid ""
"A band of gold with a smooth piece of amber set into it.  A strange worm is "
"encased in the amber, making a perfect spiral with its sealed body.  It is "
"the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Una banda de oro con una pieza lisa de ámbar engarzada en ella. Un extraño "
"gusano está encerrado en el ámbar, formando una espiral perfecta con su "
"cuerpo sellado. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
#. ~ Item name
msgid "ancient staff"
msgid_plural "ancient staffs"
msgstr[0] "vara antigua"
msgstr[1] "varas antiguas"
msgstr[2] "varas antiguas"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient staff"
msgid ""
"A well-balanced stick of treated wood with metal caps.  A red stone is "
"embedded in the handle.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un bastón bien equilibrado de madera tratada con tapas metálicas. En el mango "
"hay incrustada una piedra roja. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#: data/mods/Isolation-Protocol/unique_items.json
#. ~ Item name
msgid "ancient sword"
msgid_plural "ancient swords"
msgstr[0] "espada antigua"
msgstr[1] "espadas antiguas"
msgstr[2] "espadas antiguas"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient sword"
msgid ""
"A sword made out of a striking black metal.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Una espada hecha de un llamativo metal negro. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "ancient harp"
msgid_plural "ancient harps"
msgstr[0] "arpa antigua"
msgstr[1] "arpas antiguas"
msgstr[2] "arpas antiguas"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient harp"
msgid ""
"A harp made of black wood.  Faint hypnotic notes ring in the air each time "
"you touch it.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un arpa de madera negra. Cada vez que la tocas, suenan en el aire tenues "
"notas hipnóticas. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "ancient athame"
msgid_plural "ancient athames"
msgstr[0] "antiguo athame"
msgstr[1] "antiguos athames"
msgstr[2] "antiguos athames"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient athame"
msgid ""
"A ritual knife used by some ancient civilization.  Unreadable runes are "
"carved into the handle.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un cuchillo ritual utilizado por alguna civilización antigua. Tiene runas "
"ilegibles grabadas en el mango. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
#. ~ Item name
msgid "ancient spear"
msgid_plural "ancient spears"
msgstr[0] "lanza antigua"
msgstr[1] "lanzas antiguas"
msgstr[2] "lanzas antiguas"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient spear"
msgid ""
"A sturdy wooden pole with a sharp metal spike on the end.  The handle has the "
"symbol of a blue sun on it.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un robusto palo de madera con un afilado pincho metálico en el extremo. El "
"mango tiene el símbolo de un sol azul. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
#. ~ Item name
msgid "ancient club"
msgid_plural "ancient clubs"
msgstr[0] "porra antigua"
msgstr[1] "porras antiguas"
msgstr[2] "porras antiguas"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "ancient club"
msgid ""
"A misshapen rod of gnarled, knotted wood.  The knots in the wood exhibit a "
"strange fractal pattern.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Una varilla deforme de madera nudosa. Los nudos de la madera presentan un "
"extraño patrón fractal. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "set of oddly interlocked rings"
msgid_plural "sets of oddly interlocked rings"
msgstr[0] "conjunto de anillos extrañamente entrelazados"
msgstr[1] "conjuntos de anillos extrañamente entrelazados"
msgstr[2] "conjuntos de anillos extrañamente entrelazados"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "set of oddly interlocked rings"
msgid ""
"A set of three rings linked together.  There's something about the way the "
"rings connect to each other that gives you a headache.  It is the only one of "
"its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un conjunto de tres anillos unidos entre sí. Hay algo en la forma en que los "
"anillos se conectan entre sí que da dolor de cabeza. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "strange triangle"
msgid_plural "strange triangles"
msgstr[0] "triángulo extraño"
msgstr[1] "triángulos extraños"
msgstr[2] "triángulos extraños"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "strange triangle"
msgid ""
"A large triangle made out of three thick rectangles that connect to each "
"other in an angle.  No matter how much you turn it around, you can't seem to "
"comprehend how it links together.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un gran triángulo formado por tres rectángulos gruesos que se unen entre sí "
"formando un ángulo. Por más vueltas que le des, no logras comprender cómo se "
"unen. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "impossible trident"
msgid_plural "impossible tridents"
msgstr[0] "tridente imposible"
msgstr[1] "tridentes imposibles"
msgstr[2] "tridentes imposibles"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "impossible trident"
msgid ""
"A large trident made entirely out of an indiscernible material.  The prong in "
"the middle seems to fade away into nothingness when looked at from the top, "
"but you can clearly see the shaft connecting the tip of the weapon from the "
"bottom.  It's giving you a headache.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un gran tridente hecho enteramente de un material indiscernible. La punta del "
"centro parece desvanecerse en la nada cuando se mira desde arriba, pero desde "
"abajo se ve claramente el mango que conecta la punta del arma. Te da dolor de "
"cabeza. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "self-crossing flask"
msgid_plural "self-crossing flasks"
msgstr[0] "frasco autocruzado"
msgstr[1] "frascos autocruzados"
msgstr[2] "frascos autocruzados"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "self-crossing flask"
msgid ""
"A transparent flask with a neck that connects directly to its bottom without "
"overlapping itself, even though it clearly does.  You can put things in it, "
"but attempting to follow their path through the neck is impossible.  It is "
"the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un frasco transparente con un cuello que conecta directamente con su fondo "
"sin superponerse, aunque claramente lo hace. Se pueden introducir objetos, "
"pero es imposible seguir su trayectoria a través del cuello. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "four-dimensional cube"
msgid_plural "four-dimensional cubes"
msgstr[0] "cubo de 4 dimensiones"
msgstr[1] "cubos de 4 dimensiones"
msgstr[2] "cubos de 4 dimensiones"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "four-dimensional cube"
msgid ""
"It's a cube that constantly shrinks and grows in size.  It's two cubes linked "
"by the vertices, with ever-shifting sides folding onto each other, over and "
"over.  It's four cubes in the exact same position.  It's a cube fading to ash "
"then reverting to pristine form repeatedly.  It's all of these at once, and "
"none of them at all.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Es un cubo que se encoge y crece constantemente. Son dos cubos unidos por los "
"vértices, con caras en constante movimiento que se pliegan una sobre otra, "
"una y otra vez. Son cuatro cubos en la misma posición. Es un cubo que se "
"convierte en ceniza y vuelve a su forma original una y otra vez. Es todo eso "
"a la vez, y nada de eso. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "irrational cube"
msgid_plural "irrational cubes"
msgstr[0] "cubo irracional"
msgstr[1] "cubos irracionales"
msgstr[2] "cubos irracionales"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "irrational cube"
msgid ""
"A large wire-frame cube.  The interior wires somehow appear to be over the "
"exterior wires, no matter which angle you look at the cube from.  Trying to "
"trace the lines with your finger is probably not a good idea.  It is the only "
"one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un gran cubo de alambre. Los cables interiores parecen estar por encima de "
"los exteriores, independientemente del ángulo desde el que se mire el cubo. "
"Intentar trazar las líneas con el dedo probablemente no sea una buena idea. "
"Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/artifact_item_types.json
#. ~ Item name
msgid "wobbly ring"
msgid_plural "wobbly rings"
msgstr[0] "anillo oscilante"
msgstr[1] "anillos oscilantes"
msgstr[2] "anillos oscilantes"

#: data/json/artifact/artifact_item_types.json
#. ~ Description of "wobbly ring"
msgid ""
"A chunky ring that folds onto itself continuously, preventing its use as an "
"esoteric piece of jewelry.  It is the only one of its kind.\n"
"It may have unknown powers; try activating them."
msgstr ""
"Un anillo grueso que se pliega sobre sí mismo continuamente, lo que impide su "
"uso como joya esotérica. Objeto único.\n"
"Puede que tenga poderes desconocidos; intenta activarlos."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_ADRENALINE"
msgid "Artifact Adrenaline"
msgstr "Artefacto Adrenalina"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_ADRENALINE ( Artifact Adrenaline )"
msgid "Causes a surge of adrenaline to flow throughout your body."
msgstr "Causa que una oleada de adrenalina fluya por todo tu cuerpo."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_ADRENALINE ( Artifact Adrenaline )"
msgid "You're filled with a roaring energy!"
msgstr "¡Estás lleno de energía rugiente!"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_BLOOD"
msgid "Artifact Blood"
msgstr "Artefacto Sangre"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_BLOOD ( Artifact Blood )"
msgid "Causes blood to leak from nearby terrain."
msgstr "Hace que la sangre se filtre desde el terreno cercano."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_BLOOD ( Artifact Blood )"
msgid "Blood soaks out of the ground and walls."
msgstr "Hay sangre saliendo del suelo y de los muros/paredes."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_HEAL"
msgid "Artifact Heal"
msgstr "Artefacto Curación"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_HEAL ( Artifact Heal )"
msgid "Will heal injuries all over your body."
msgstr "Curará las heridas de todo el cuerpo."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_HEAL ( Artifact Heal )"
msgid "You feel healed."
msgstr "Te sientes curado."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_CONFUSED"
msgid "Artifact Confused"
msgstr "Artefacto Confusión"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_CONFUSED ( Artifact Confused )"
msgid "Causes nearby enemies to become confused."
msgstr "Hace que los enemigos cercanos se confundan."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_PAIN"
msgid "Artifact Pain"
msgstr "Artefacto Dolor"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_PAIN ( Artifact Pain )"
msgid "Owchie, that hurts."
msgstr "Auch, eso duele."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_PAIN ( Artifact Pain )"
msgid "You're wracked with pain!"
msgstr "¡Te está destrozando el dolor!"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_TELEPORT"
msgid "Artifact Teleport"
msgstr "Artefacto Teletransporte"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_TELEPORT ( Artifact Teleport )"
msgid "Randomly teleports you a short distance."
msgstr "Te teletransporta aleatoriamente a una distancia corta."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_TELEPORT ( Artifact Teleport )"
msgid "You teleport!"
msgstr "¡Te teletransportás!"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_ATTENTION"
msgid "Artifact Attention"
msgstr "Artefacto Atención"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_ATTENTION ( Artifact Attention )"
msgid "You're not quite sure what you did, but something is watching you for it."
msgstr "No estás muy seguro de lo que hiciste, pero algo te está observando por ello."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_ATTENTION ( Artifact Attention )"
msgid "You feel like your action has attracted attention."
msgstr "Sientes como si tu acción haya atraído atención."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_TELEGLOW"
msgid "Artifact Teleglow"
msgstr "Artefacto Telebrillo"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_TELEGLOW ( Artifact Teleglow )"
msgid "DO YOU HEAR THE VOICES TOO?"
msgstr "¿TAMBIÉN OYES LAS VOCES?"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_TELEGLOW ( Artifact Teleglow )"
msgid "You feel unhinged."
msgstr "Te sientes trastornado."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_VOMIT"
msgid "Artifact Vomit"
msgstr "Artefacto Vómito"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_VOMIT ( Artifact Vomit )"
msgid "Causes the caster to vomit."
msgstr "Causa que el lanzador vomite."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_VOMIT ( Artifact Vomit )"
msgid "A wave of nausea passes through you!"
msgstr "¡Una ola de náusea pasa a través tuyo!"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_SHADOWS"
msgid "Artifact Shadows"
msgstr "Artefacto Sombras"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_SHADOWS ( Artifact Shadows )"
msgid "Summons shadows."
msgstr "Invoca sombras."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_SHADOWS ( Artifact Shadows )"
msgid "Shadows form around you."
msgstr "Se forman sombras a tu alrededor."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_STAMINA_EMPTY"
msgid "Artifact Stamina Empty"
msgstr "Artefacto Vigor Agotado"

#: data/json/artifact/legacy_artifact_active.json
#. ~ Description of spell "AEA_STAMINA_EMPTY ( Artifact Stamina Empty )"
msgid "Does a variable amount of stamina damage."
msgstr "Hace una cantidad variable de daño al vigor."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Message of spell "AEA_STAMINA_EMPTY ( Artifact Stamina Empty )"
msgid "Your body feels like jelly."
msgstr "Tu cuerpo se siente como gelatina."

#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AEA_RADIATION"
