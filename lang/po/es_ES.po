msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/undine_mutations.json
#. ~ Mutation name
msgid "Resist Acid"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/undine_mutations.json
#. ~ Description of mutation "Resist Acid"
msgid "You've gained a resistance to acid."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/undine_mutations.json
#. ~ Mutation name
msgid "The Sea Bears Me Up"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/undine_mutations.json
#. ~ Description of mutation "The Sea Bears Me Up"
