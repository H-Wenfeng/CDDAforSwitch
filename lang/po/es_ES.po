msgid_plural "pairs of heelys (off)"
msgstr[0] "par de heelys (plegadas)"
msgstr[1] "pares de heelys (plegadas)"
msgstr[2] "pares de heelys (plegadas)"

#: data/json/items/armor/boots.json
#. ~ Description of "pair of heelys (off)"
msgid ""
"A pair of sneakers with integrated wheels.  Currently the wheels are "
"retracted, making these essentially normal lace-up athletic shoes."
msgstr ""
"Un par de zapatos con ruedas integradas. Actualmente las ruedas están "
"retraídas, lo que las convierte en unas zapatos de deporte normales con "
"cordones."

#: data/json/items/armor/boots.json
#. ~ "menu_text" action message of item "pair of heelys (off)"
msgid "Extend wheels"
msgstr "Ruedas extendidas"

#: data/json/items/armor/boots.json
#. ~ "msg" action message of item "pair of heelys (off)"
msgid "You pop the wheels out."
msgstr "Despliegas las ruedas."

#: data/json/items/armor/boots.json
#. ~ Item name
msgid "pair of heelys (on)"
msgid_plural "pairs of heelys (on)"
msgstr[0] "par de heelys (desplegadas)"
msgstr[1] "pares de heelys (desplegadas)"
msgstr[2] "pares de heelys (desplegadas)"

#: data/json/items/armor/boots.json
#. ~ Description of "pair of heelys (on)"
msgid ""
"A pair of sneakers with integrated wheels, currently the wheels are out, "
"allowing you to swiftly roll around on flat terrain.  You should probably pop "
"them back in before you try fighting or going off-road."
msgstr ""
"Un par de zapatos con ruedas integradas, actualmente las ruedas están fuera, "
"lo que te permite rodar rápidamente por terreno llano. Probablemente deberías "
"volver a retraerlas antes de intentar luchar o salir de la carretera."

#: data/json/items/armor/boots.json
#. ~ "menu_text" action message of item "pair of heelys (on)"
msgid "Retract wheels"
msgstr "Ruedas retraídas"

#: data/json/items/armor/boots.json
#. ~ "msg" action message of item "pair of heelys (on)"
msgid "You pop the wheels back in."
msgstr "Pliegas las ruedas."

