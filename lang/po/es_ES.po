msgstr "pum."

#: data/json/furniture_and_terrain/furniture-decorative.json
#: data/json/items/generic/toys_and_sports.json data/json/monsters/misc.json
#. ~ Furniture name
#. ~ Item name
#. ~ Monster name
msgid "mannequin"
msgid_plural "mannequins"
msgstr[0] "maniquí"
msgstr[1] "maniquíes"
msgstr[2] "maniquíes"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "mannequin"
msgid ""
"A life-size wooden figure of a person, most commonly used to display clothing "
"in stores, or for tailors to design outfits on.  Considering all that's "
"happened, something about it is somewhat unnerving."
msgstr ""
"Una figura de madera de tamaño natural de una persona, más comúnmente "
"utilizada para mostrar la ropa en las tiendas, o para que los sastres diseñen "
"trajes. Teniendo en cuenta todo lo que ha sucedido, hay algo que me "
"desconcierta."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "birdbath"
msgstr "baño de aves"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "birdbath"
msgid ""
"A wide stone bowl mounted to a pedestal, usually filled with rainwater, meant "
"for birds to play or bathe in."
msgstr ""
"Recipiente ancho de piedra montado en un pedestal, generalmente lleno de agua "
"de lluvia, destinado a que los pájaros jueguen o se bañen en él."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "gazing ball"
msgstr "bola de observación"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "gazing ball"
msgid ""
"A mirrored glass globe mounted on a cement pedestal.  It warps your "
"reflection when you look into it."
msgstr ""
"Un globo de cristal espejado montado sobre un pedestal de cemento. Deforma tu "
"reflejo cuando te miras en él."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "rotary clothes dryer line"
msgstr "línea de secadora de ropa rotativa"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "rotary clothes dryer line"
msgid ""
"A central metal pole holding up a wide rotating frame, this would be used to "
"hang up clothes to dry in the sunlight."
msgstr ""
"Un poste metálico central que sostiene una amplia estructura giratoria, que "
"serviría para colgar la ropa para que se secara a la luz del sol."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "standing lamp"
msgid ""
"A light mounted on the top of a metal pole, this would be plugged into a wall "
"socket to illuminate a room."
msgstr ""
"Una luz montada en la parte superior de un poste metálico, que se conecta a "
"una toma de corriente para iluminar una habitación."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Bashing failed sound
msgid "bonk!"
msgstr "¡Bonk!"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "lighthouse light"
msgstr "luz de faro"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "lighthouse light"
msgid "Very high power, modern lighthouse LED light source with attached heatsinks."
msgstr ""
"Fuente de luz LED de faro moderna y de muy alta potencia con disipadores "
"térmicos incorporados."

#: data/json/furniture_and_terrain/furniture-decorative.json
#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Bashing failed sound
msgid "ting."
msgstr "ting."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "pine wreath"
msgstr "corona de pino"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "pine wreath"
msgid "A decorative wreath for the winter holidays."
msgstr "Una corona decorativa para las vacaciones de invierno."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "sand castle"
msgstr "castillo de arena"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "sand castle"
msgid ""
"A glorious castle made of sand.  This mighty fortress will stand tall for the "
"ages to come, a true testament to the skills of its builder."
msgstr ""
"Un glorioso castillo hecho de arena. Esta poderosa fortaleza se mantendrá en "
"pie durante los siglos venideros, un verdadero testimonio de las habilidades "
"de su constructor."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "decorative tree"
msgstr "árbol decorativo"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "decorative tree"
msgid "A decorative pine tree littered with ornaments for the winter holidays."
msgstr "Un pino decorativo repleto de adornos para las vacaciones de invierno."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "styling station"
msgstr "estación de estilista"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "styling station"
msgid ""
"A styling station, is a countertop with a mirror mounted above it and just "
"enough room and cubbies to store a stylist's equipment on it."
msgstr ""
"Una estación de estilista es una encimera con un espejo encima y espacio y "
"cubículos suficientes para guardar el equipo del estilista."

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Furniture name
msgid "indoor flagpole"
msgstr "mástil de bandera de interior"

#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Description of furniture "indoor flagpole"
msgid ""
"A 2.5-meter tall flagpole on a weighted stand.  You could hoist up a flag "
"here."
msgstr ""
"Un mástil de 2.5 metros de altura sobre un soporte con peso. Aquí se puede "
"izar una bandera."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "indoor plant"
msgstr "planta de interior"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "indoor plant"
msgid ""
"A small potted plant, used for decoration indoors.  It appears to have dried "
"up and died a while ago."
msgstr ""
"Una pequeña planta en maceta, utilizada como decoración en el interior. "
"Parece que se ha secado y ha muerto hace tiempo."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "yellow indoor plant"
msgstr "planta amarilla de interior"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "yellow indoor plant"
msgid ""
"A decorative potted plant with a yellow flower, it looks to have wilted and "
"died some time ago."
msgstr ""
"Una planta decorativa en maceta con una flor amarilla, parece haberse "
"marchitado y muerto hace tiempo."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "overgrown plant"
msgstr "plantación descuidada"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "overgrown plant"
msgid ""
"This patch of green used to be a cultivated field or some sort of monocrop "
"agriculture.  Neglected for too long, it has been overtaken by nature."
msgstr ""
"Esta zona verde solía ser un campo cultivado o una especie de monocultivo. "
"Descuidado durante demasiado tiempo, la naturaleza se ha apoderado de él."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "harvestable plant"
msgstr "planta cosechable"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "harvestable plant"
msgid ""
"This plant is fully grown and ready to be harvested.  Identifying how to "
"harvest it requires closer examination."
msgstr ""
"Esta planta está completamente desarrollada y lista para ser cosechada. "
"Identificar cómo cosecharla requiere un examen más detallado."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "mature plant"
msgstr "planta madura"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "mature plant"
msgid "This plant has matured, and will be ready to harvest before long."
msgstr "Esta planta ha madurado y estará lista para cosechar en poco tiempo."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "seed"
msgstr "semilla"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "seed"
msgid ""
"A freshly planted seed.  If properly tended to, it could grow into a healthy "
"plant."
msgstr ""
"Una semilla recién plantada. Si se cuida adecuadamente, puede convertirse en "
"una planta sana."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "seedling"
msgstr "brote"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "seedling"
msgid "A seed that has just begun to sprout its first roots."
msgstr "Una semilla que acaba de empezar a echar sus primeras raíces."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "planter"
msgstr "sembradora"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "planter"
msgid ""
"A garden planter full of soil and slatted to allow adequate drainage.  Can be "
"used for planting crops."
msgstr ""
"Una jardinera llena de tierra y listones para permitir un drenaje adecuado. "
"Puede utilizarse para plantar cultivos."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "planter with dead plants"
msgstr "jardinera con plantas muertas"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "planter with dead plants"
msgid ""
"Somewhere beneath this heap of dying plants you can see the shape of wooden "
"furniture.  Left without care, the plants it used to nurture have shriveled "
"and died."
msgstr ""
"En algún lugar bajo este montón de plantas moribundas se puede ver la forma "
"de un mueble de madera. Sin cuidados, las plantas que alimentaba se han "
"marchitado y han muerto."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Bashing sound
msgid "rrrrip!"
msgstr "¡rrrrip!"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_groundxeno.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_alien_meadow.json
#: data/mods/TropiCataclysm/furniture_and_terrain/tropical_terrain_flora.json
#: data/mods/TropiCataclysm/furniture_and_terrain/tropical_terrain_nether.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/terrain-flora.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_groundxeno.json
#: data/mods/desert_region/furniture-and-terrain/desert_terrain.json
#. ~ Bashing failed sound
msgid "brush."
msgstr "cepillo."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "planter with harvestable plant"
msgstr "plantador con planta cosechable"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "planter with harvestable plant"
msgid ""
"A garden planter full of soil and slatted to allow adequate drainage.  This "
"one has a fully grown plant, and will need closer examination to harvest."
msgstr ""
"Una jardinera llena de tierra y con listones para permitir un drenaje "
"adecuado. Esta tiene una planta completamente crecida, y necesitará un examen "
"más detallado para cosechar."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "planter with mature plant"
msgstr "maceta con planta madura"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "planter with mature plant"
msgid ""
"A garden planter full of soil and slatted to allow adequate drainage.  This "
"one has a matured plant that should be ready for harvest before long."
msgstr ""
"Una jardinera llena de tierra y con listones para permitir un drenaje "
"adecuado. Esta tiene una planta madura que debería estar lista para la "
"cosecha en poco tiempo."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "planter with seed"
msgstr "maceta con semilla"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "planter with seed"
msgid ""
"A garden planter full of soil and slatted to allow adequate drainage.  This "
"one contains a planted seed, and will need attention to grow fully."
msgstr ""
"Una jardinera llena de tierra y con listones para permitir un drenaje "
"adecuado. Esta contiene una semilla plantada, y necesitará atención para "
"crecer plenamente."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "planter with seedling"
msgstr "maceta con planta de semillero"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "planter with seedling"
msgid ""
"A garden planter full of soil and slatted to allow adequate drainage.  This "
"one has a seed that has just begun to sprout its first roots."
msgstr ""
"Una jardinera llena de tierra y con listones para permitir un drenaje "
"adecuado. Esta tiene una semilla que acaba de empezar a echar sus primeras "
"raíces."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "grain stook"
msgstr "garbera de grano"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "grain stook"
msgid ""
"Sheaves of cut grain have been stood upright in a self-supporting A-frame to "
"dry, keeping the seeds off the ground and out of reach of vermin."
msgstr ""
"Los granos cortados se han colocado en posición vertical en un armazón en "
"forma de A para que se sequen, manteniendo las semillas alejadas del suelo y "
"fuera del alcance de las alimañas."

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Furniture name
msgid "stooking spot"
msgstr "lugar de secado"

#: data/json/furniture_and_terrain/furniture-domestic_plants.json
#. ~ Description of furniture "stooking spot"
msgid ""
"A space has been cleared out here for grain drying.  Place fresh stalks of "
"grain in this spot and examine to set up a stook."
msgstr ""
"Se ha despejado un espacio aquí para secar el grano. Coloca tallos frescos de "
"grano en este lugar y examina para comenzar el secado."

#: data/json/furniture_and_terrain/furniture-eggs.json
#. ~ Furniture name
msgid "spider egg sac"
msgstr "saco de huevos de araña"

#: data/json/furniture_and_terrain/furniture-eggs.json
#. ~ Description of furniture "spider egg sac"
msgid ""
"A sizable, off-white sac of large eggs.  Upon watching closer, you can see "
"them moving slightly.  Gross."
msgstr ""
"Un saco considerable, blanquecino, de huevos grandes. Al observar más de "
"cerca, se puede ver que se mueven ligeramente. Asqueroso."

#: data/json/furniture_and_terrain/furniture-eggs.json
#. ~ Description of furniture "spider egg sac"
msgid ""
"A bulbous mass of off-white spider eggs.  Upon watching closer, you can see "
"them moving a bit.  Really gross."
msgstr ""
"Una masa bulbosa de huevos de araña de color blanquecino. Al observar más de "
"cerca, se puede ver que se mueven un poco. Realmente asqueroso."

#: data/json/furniture_and_terrain/furniture-eggs.json
#. ~ Description of furniture "spider egg sac"
msgid ""
"A gigantic sac of spider eggs, each one larger than your fist.  They're "
"definitely moving around.  Really gross, just seeing it makes your skin crawl."
msgstr ""
"Un gigantesco saco de huevos de araña, cada uno más grande que tu puño. "
"Definitivamente se están moviendo. Realmente asqueroso, sólo con verlo se te "
"eriza la piel."

#: data/json/furniture_and_terrain/furniture-eggs.json
#. ~ Furniture name
msgid "ruptured egg sac"
msgstr "saco roto de huevo"

#: data/json/furniture_and_terrain/furniture-eggs.json
#. ~ Description of furniture "ruptured egg sac"
msgid ""
"A disgusting, ruptured sac of giant spider eggs.  The thought of all those "
"massive baby spiders pouring out of it is almost terrifying on its own."
msgstr ""
"Un asqueroso saco roto de huevos de araña gigantes. La idea de todas esas "
"enormes crías de araña saliendo de él es casi aterradora por sí misma."

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "swamp gas"
msgid "A pool of murky water that occasionally bubbles, releasing a mildly toxic gas."
msgstr ""
"Una piscina de agua turbia, que ocasionalmente burbujea, liberando un gas "
"ligeramente tóxico."

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "fog"
msgid "A misty cloud of fog."
msgstr "Una brumosa nube de niebla."

#: data/json/furniture_and_terrain/furniture-emitters.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Furniture name
#. ~ Terrain name
msgid "metal grate"
msgstr "reja de metal"

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "metal grate"
msgid "A metal vent.  You can feel cool air seeping out of it."
msgstr "Una rejilla de ventilación de metal.  Puedes sentir que sale aire fresco."

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "f_vent_cold_air2_blast"
msgid "A metal vent.  You can feel cold air blasting out of it."
msgstr ""
"Una rejilla de ventilación de metal. Puedes sentir una fuerte corriente de "
"aire frio saliendo."

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "f_vent_hot_air2_stream"
#. ~ Description of furniture "f_vent_hot_air2_blast"
msgid "A metal vent.  You can feel hot air seeping out of it."
msgstr "Una rejilla de ventilación de metal. Puedes sentir que sale aire caliente."

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "f_vent_toxic_leak"
msgid "A metal vent.  Toxic-looking clouds seep from it."
msgstr "Una rejilla de ventilación de metal. Nubes tóxicas se filtran de ella."

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "f_vent_toxic_belch"
msgid "A metal vent.  Toxic-looking clouds stream from it."
msgstr "Una rejilla de ventilación de metal. Nubes tóxicas fluyen a través de ella."

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "f_vent_rad_leak"
msgid "A metal vent."
msgstr "Un rejilla de ventilación de metal."

#: data/json/furniture_and_terrain/furniture-emitters.json
#. ~ Description of furniture "f_fog_breather"
msgid "A misty cloud of water vapor."
msgstr "Una bruma de vapor de agua."

#: data/json/furniture_and_terrain/furniture-fakes.json
#. ~ Furniture name
msgid "ground crafting spot"
msgstr "lugar de fabricación en la piso"

#: data/json/furniture_and_terrain/furniture-fakes.json
#. ~ Description of furniture "ground crafting spot"
msgid ""
"A cleared spot on the ground for crafting.  Slower than using a workbench or "
"holding a project in your hands, but readily available."
msgstr ""
"Un lugar despejado en el suelo para fabricar. Más lento que usar una mesa de "
"trabajo o tener un proyecto en las manos, pero fácilmente disponible."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Furniture name
msgid "fireplace"
msgstr "chimenea"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "fireplace"
#. ~ Description of furniture "stone fireplace"
msgid ""
"A common fixture for safely hosting a fire indoors, with a chimney to vent "
"the smoke to the outside."
msgstr ""
"Un accesorio común para albergar con seguridad un fuego en el interior, con "
"una chimenea para ventilar el humo al exterior."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Furniture name
msgid "stone fireplace"
msgstr "chimenea de piedra"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Furniture name
msgid "wood stove"
msgstr "cocina de leña"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "wood stove"
msgid ""
"A simple metal stove for hosting wood-fueled fires.  Good for cooking or "
"heating food, and safe to use indoors."
msgstr ""
"Una sencilla cocina de metal para hacer fuego con leña. Buena para cocinar o "
"calentar alimentos, y seguro de usar en interiores."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "brazier"
msgid_plural "braziers"
msgstr[0] "brasero"
msgstr[1] "braseros"
msgstr[2] "braseros"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "brazier"
msgid "A raised metal dish in which to safely burn things."
msgstr "Un plato de metal elevado en el que quemar cosas de forma segura."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "makeshift brazier"
msgid_plural "makeshift braziers"
msgstr[0] "brasero improvisado"
msgstr[1] "braseros improvisados"
msgstr[2] "braseros improvisados"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "makeshift brazier"
msgid ""
"A metal bucket with holes, in which you can safely start a fire.  It's too "
"small to fit any fuel item larger than some splintered wood."
msgstr ""
"Un cubo metálico con agujeros, en el que se puede encender fuego con "
"seguridad. Es demasiado pequeño para que quepa cualquier objeto como "
"combustible mayor que un poco de madera astillada."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "hobo stove"
msgid_plural "hobo stoves"
msgstr[0] "cocina de vagabundo"
msgstr[1] "cocinas de vagabundo"
msgstr[2] "cocinas de vagabundo"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "hobo stove"
msgid ""
"A small improvised wood stove, made from a metal can.  It's too small to fit "
"any fuel much larger than splintered wood."
msgstr ""
"Una pequeña cocina de leña improvisada, hecha con una lata de metal. "
"Demasiado pequeña para que quepa algo mucho más grande que madera astillada."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "portable stove"
msgid_plural "portable stoves"
msgstr[0] "cocina portátil"
msgstr[1] "cocinas portátiles"
msgstr[2] "cocinas portátiles"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "portable stove"
msgid ""
"A foldable metal stove for hosting wood-fueled fires.  Good for cooking or "
"heating food, and safe to use indoors."
msgstr ""
"Una sencilla cocina de metal plegable para hacer fuego con leña. Bueno para "
"cocinar o calentar alimentos, y seguro de usar en interiores."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "fire barrel (200 L)"
msgid_plural "fire barrels (200 L)"
msgstr[0] "barril de fuego (200L)"
msgstr[1] "barriles de fuego (200L)"
msgstr[2] "barriles de fuego (200L)"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "fire barrel (200 L)"
msgid ""
"A huge metal barrel used to safely contain a fire.  It has multiple holes "
"punched in the sides for air supply."
msgstr ""
"Un enorme barril de metal utilizado para contener de forma segura un fuego. "
"Tiene múltiples agujeros perforados en los lados para el suministro de aire."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "fire barrel (100 L)"
msgid_plural "fire barrels (100 L)"
msgstr[0] "barril de fuego (100L)"
msgstr[1] "barriles de fuego (100L)"
msgstr[2] "barriles de fuego (100L)"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "fire barrel (100 L)"
msgid ""
"A large metal barrel used to safely contain a fire.  It has multiple holes "
"punched in the sides for air supply."
msgstr ""
"Un gran barril de metal utilizado para contener de forma segura un fuego. "
"Tiene múltiples agujeros perforados en los lados para el suministro de aire."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Furniture name
msgid "fire ring"
msgstr "anillo de fuego"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "fire ring"
msgid "A ring of stones to safely contain a fire."
msgstr "Un anillo de piedras para contener el fuego de forma segura."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Furniture name
msgid "clay oven"
msgstr "cocina de barro"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#. ~ Description of furniture "clay oven"
msgid ""
"A simple clay oven with a chimney, with a firebrick alcove in the middle that "
"can be used to cook food or just to contain a fire."
msgstr ""
"Una simple cocina de barroa con chimenea, con una alcoba de ladrillos en el "
"centro que puede utilizarse para cocinar alimentos o simplemente para "
"contener el fuego."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "mutated poppy flower"
msgstr "flor de amapola mutada"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "mutated poppy flower"
msgid ""
"These strange flowers have appeared in the wake of the Cataclysm, and their "
"buds can be used for medicinal purposes, like the buds of the mundane poppy "
"they're named after.  The dirt around it gently churns as its roots writhe "
"beneath the soil, and it's surrounded by an overwhelming floral smell that "
"makes you feel sleepy."
msgstr ""
"Estas extrañas flores han aparecido tras el Cataclismo, y sus capullos pueden "
"usarse con fines medicinales, como los capullos de la amapola mundana que les "
"da nombre. La tierra a su alrededor se agita suavemente mientras sus raíces "
"se retuercen bajo el suelo, y está rodeada de un abrumador olor floral que te "
"hace sentir somnoliento."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/raw_veggy.json
#. ~ Furniture name
#. ~ Item name
msgid "dandelion"
msgid_plural "dandelion"
msgstr[0] "dientes de león"
msgstr[1] "dientes de león"
msgstr[2] "dientes de león"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "dandelion"
msgid ""
"A common weed with a yellow flower.  Produces seeds that get carried on the "
"wind by thin, gray filaments."
msgstr ""
"Una hierba común con una flor amarilla. Produce semillas que son "
"transportadas por el viento por finos filamentos grises."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/raw_veggy.json
#. ~ Furniture name
#. ~ Item name
msgid "burdock"
msgid_plural "burdock"
msgstr[0] "bardana"
msgstr[1] "bardanas"
msgstr[2] "bardanas"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "burdock"
msgid ""
"A common weed with a purple thistle-like flower.  Its seeds tend to stick to "
"clothing and fur."
msgstr ""
"Una hierba común con una flor púrpura parecida al cardo. Sus semillas tienden "
"a pegarse a la ropa y al pelaje."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "wild carrot"
msgstr "zanahoria silvestre"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "wild carrot"
msgid "A common white wildflower which could be harvested for its root."
msgstr "Una flor silvestre blanca común que puede ser cosechada por su raíz."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "starry false Solomon's seal"
msgstr "falso sello estrellado de Salomón"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "starry false Solomon's seal"
msgid ""
"The blossoms of this flower look like stars in the night sky.  Its crimson "
"berries are edible."
msgstr ""
"Los brotes de esta flor parecen estrellas en el cielo nocturno. Sus bayas "
"carmesí son comestibles."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "salsify"
msgstr "salsifí"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "salsify"
msgid "Tragopogon porrifolius, a ragged-looking purple flower with a nutritious root."
msgstr ""
"Tragopogon porrifolius, una flor púrpura de aspecto desgarrado que posee una "
"raíz nutritiva."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "chamomile"
msgstr "manzanilla"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "chamomile"
msgid "A cute white flower with a yellow center, used to brew a soothing tea."
msgstr ""
"Una bonita planta blanca con el centro de color amarillo, usada para hacer té "
"relajante."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "tulip"
msgstr "tulipán"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "tulip"
msgid ""
"A bright, colorful flower with petals forming a small cup at its top.  It can "
"be poisonous to livestock."
msgstr ""
"Una flor brillante y colorida con pétalos que forman una pequeña copa en su "
"parte superior. Puede ser venenosa para el ganado."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "spurge flower"
msgstr "flor de euforbia"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "spurge flower"
msgid "A yellow-green flower that grows in densely-packed bushes."
msgstr "Una flor verde-amarillenta que crece en arbustos densamente poblados."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "cattails"
msgstr "juncos"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "cattails"
msgid ""
"This useful plant is available all year round.  Many parts of the plant are "
"edible."
msgstr ""
"Esta útil planta está disponible durante todo el año. Muchas partes de la "
"planta son comestibles."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "black eyed Susan"
msgstr "rudbeckia bicolor"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "black eyed Susan"
msgid ""
"A mildly poisonous yellow flower with a dark ball in the middle.  Sometimes "
"known as an ox-eye daisy."
msgstr ""
"Una flor amarilla ligeramente venenosa con una bola oscura en el centro. A "
"veces se conoce como margarita ojo de buey."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "lily"
msgstr "lirio"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "lily"
msgid "A pretty flower that comes in a variety of colors."
msgstr "Una bonita flor que viene en una variedad de colores."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "lotus"
msgstr "loto"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "lotus"
msgid ""
"A lovely flower that grows on the surface of bodies of fresh water.  A "
"traditional symbol of many Eastern cultures."
msgstr ""
"Una hermosa flor que crece en la superficie de los cuerpos de agua dulce. "
"Tradicionalmente conectada con muchas culturas orientales."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "sunflower"
msgid_plural "sunflowers"
msgstr[0] "girasol"
msgstr[1] "girasoles"
msgstr[2] "girasoles"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "sunflower"
msgid ""
"A tall, wide-headed flower with a large dark center.  Produces many "
"nutritious seeds."
msgstr ""
"Una flor alta, de cabeza ancha, con un gran centro oscuro. Produce muchas "
"semillas nutritivas."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "Jerusalem artichoke plant"
msgstr "planta de alcachofa de Jerusalén"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "Jerusalem artichoke plant"
msgid "Looking similar to a sunflower, this tall plant has a nutritious tuber."
msgstr "De aspecto similar al girasol, esta planta alta tiene un tubérculo nutritivo ."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "lilypad"
msgstr "nenúfar"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "lilypad"
msgid ""
"This lilypad doesn't look like it would support the weight of the things "
"you've heard croaking in the swamp."
msgstr ""
"Estos nenúfares no parece que vayan a poder soportar el peso de las cosas que "
"escuchaste croando en el pantano."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "bluebell"
msgstr "jacinto"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "bluebell"
msgid "A common bluebell flower.  Pretty."
msgstr "Una flor de campanilla común. Bonita."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "dahlia"
msgstr "dahlia"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "dahlia"
msgid "A puffy flower with many tightly-layered petals."
msgstr "Una flor hinchada con muchos pétalos de capas apretadas."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "chicory"
msgstr "achicoria"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "chicory"
msgid "A blue flower imported from Europe, also known as a cornflower."
msgstr "Una flor azul importada de Europa, también conocida como aciano."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "datura"
msgstr "datura"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "datura"
msgid "A pretty moonflower."
msgstr "Una bonita flor de luna."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "pile of leaves"
msgstr "pila de hojas"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "pile of leaves"
msgid ""
"A sizable pile of leaves.  You could sleep on it if you don't care about "
"comfort or warmth."
msgstr ""
"Una gran pila de hojas. Podrías dormir en ella si no te importa la comodidad "
"o el calor."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "mustard"
msgstr "mostaza"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "mustard"
msgid ""
"A yellow flower known as Brassica Nigra.  Known for its seeds that can be "
"used for making table mustard."
msgstr ""
"Flor amarilla conocida como Brassica Nigra. Conocida por sus semillas que se "
"pueden utilizar para hacer mostaza de mesa."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "wild sarsaparilla"
msgstr "zarzaparrilla silvestre"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "wild sarsaparilla"
msgid ""
"A small, flowering plant known as 'Aralia nudicaulis'.  It is colored in "
"vibrant shades of orange and red in autumn, making it easy to spot."
msgstr ""
"Una pequeña planta con flores conocida como 'Aralia nudicaulis'. Se tiñe de "
"vibrantes tonos naranja y rojo en otoño, por lo que es fácil de detectar."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "wintergreen"
msgstr "gaulteria"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "wintergreen"
msgid ""
"A small shrub native to North America.  The leaves, which remain green even "
"in winter, are valued for medicinal purposes.  It produces edible and sweet "
"berries, too!"
msgstr ""
"Pequeño arbusto originario de América del Norte. Las hojas, que permanecen "
"verdes incluso en invierno, se valoran con fines medicinales. También produce "
"bayas comestibles y dulces."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "Japanese knotweed"
msgstr "Centidonia japonesa"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "Japanese knotweed"
msgid ""
"An invasive species originating from Japan.  The stem looks like it might "
"contain some water."
msgstr ""
"Una especie invasora originaria de Japón. El tallo parece contener algo de "
"agua."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "fireweed"
msgstr "epilobio (hierba de fuego)"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "fireweed"
msgid ""
"Vibrant purple, it tends to be the first to appear after fires, hence its "
"name."
msgstr ""
"De color púrpura vibrante, suele ser la primera en aparecer tras los "
"incendios, de ahí su nombre."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "common selfheal"
msgstr "consuelda menor (autosanador común)"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "common selfheal"
msgid ""
"A small purple flower.  It got its name due to its usage in traditional "
"medicine."
msgstr "Una pequeña flor púrpura. Debe su nombre a su uso en la medicina tradicional."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "spreading dogbane"
msgstr "apocino extendido"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "spreading dogbane"
msgid ""
"It is not only toxic to dogs when eaten by them.  Humans and many other "
"animals are affected, too.  Its fibers sure are worth salvaging though.  "
"Despite its name, it is not actually spreading fast."
msgstr ""
"No sólo es tóxica para los perros cuando la ingieren. También afecta a los "
"humanos y a muchos otros animales. Sin embargo, merece la pena rescatar sus "
"fibras. A pesar de su nombre, no se propaga con rapidez."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "thistle"
msgstr "cardo"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "thistle"
msgid "A prickly and invasive small plant."
msgstr "Una planta pequeña espinosa e invasora."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "purple loosestrife"
msgstr "arroyuela"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "purple loosestrife"
msgid ""
"A pretty violet flower that likes water.  Unfortunately it is invasive and "
"does not benefit the environment."
msgstr ""
"Una bonita flor violeta a la que le gusta el agua. Por desgracia es invasora "
"y no beneficia al medio ambiente."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/raw_grain.json
#. ~ Furniture name
#. ~ Item name
msgid "wild rice"
msgid_plural "wild rice"
msgstr[0] "arroz salvaje"
msgstr[1] "arroces salvajes"
msgstr[2] "arroces salvajes"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "wild rice"
msgid ""
"Also called Indian rice, Northern wild rice, or manoomin in Ojibwe, is a "
"species of rice that has been harvested and used by Native American tribes of "
"the northeast for hundreds of years.  It's similar to other types of wild "
"rice, offering a fiber-rich and healthy basis of a meal."
msgstr ""
"También llamado arroz indio, el arroz salvaje del norte, o manoomin en "
"ojibwe, es una especie de arroz que han cosechado y utilizado las tribus "
"nativas americanas del noreste durante cientos de años. Es similar a otros "
"tipos de arroz salvaje y ofrece una base rica en fibra y saludable para una "
"comida."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "short hedge"
msgstr "seto corto"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "short hedge"
msgid "A shrub with small green leaves, trimmed into a squared shape."
msgstr "Arbusto de pequeñas hojas verdes, recortadas en forma de cuadrado."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "tall hedge"
msgstr "seto alto"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "tall hedge"
msgid ""
"A tall shrub with small green leaves, trimmed into a squared shape.  You "
"can't see past this thick hedgerow."
msgstr ""
"Un arbusto alto con pequeñas hojas verdes, recortado en forma de cuadrado. No "
"se puede ver más allá de este espeso seto."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "abstract topiary"
msgstr "topiario abstracto"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "abstract topiary"
msgid "A tall shrub with small green leaves, trimmed into a fanciful abstract shape."
msgstr ""
"Un arbusto alto con pequeñas hojas verdes, recortadas en una fantasiosa forma "
"abstracta."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "animal topiary"
msgstr "topiario animal"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "animal topiary"
msgid "A tall shrub with small green leaves, trimmed into an animal shape."
msgstr "Un arbusto alto con pequeñas hojas verdes, recortadas en forma de animal."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "animal topiary"
msgid "A tall shrub with small green leaves, trimmed into a dragon shape."
msgstr "Un arbusto alto con pequeñas hojas verdes, recortadas en forma de drogón."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/mods/innawood/furniture_and_terrain/misc.json
#. ~ Furniture name
msgid "dam"
msgstr "presa"

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/mods/innawood/furniture_and_terrain/misc.json
#. ~ Description of furniture "dam"
msgid ""
"A house that beavers built.  The entrance is underwater making it harder for "
"predators to access."
msgstr ""
"Una casa que construyeron los castores. La entrada está bajo el agua, lo que "
"dificulta el acceso de los depredadores."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/mods/innawood/furniture_and_terrain/misc.json
#. ~ Bashing failed sound
msgid "bonk."
msgstr "pong."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Furniture name
msgid "red algae"
msgstr "alga roja"

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "red algae"
msgid ""
"One of the thousands of species of grassy reddish marine plants that inhabit "
"intertidal zones the world over.  Its rubbery little fronds don't look "
"particularly edible."
msgstr ""
"Una de las miles de especies de plantas marinas herbáceas de color rojizo que "
"habitan las zonas intermareales de todo el mundo. Sus frondas gomosas no "
"parecen especialmente comestibles."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Bashing sound
msgid "splat."
msgstr "splash."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Bashing failed sound
msgid "squelch."
msgstr "silenciador"

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Furniture name
msgid "green algae"
msgstr "alga verde"

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "green algae"
msgid "A short patch of grassy green seaweed, wholly unremarkable."
msgstr "Un corto pedazo de alga verde hierba, totalmente anodina."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#: data/json/items/comestibles/raw_veggy.json
#. ~ Furniture name
#. ~ Item name
msgid "sugar kelp"
msgid_plural "sugar kelp"
msgstr[0] "alga azucarera"
msgstr[1] "algas azucareras"
msgstr[2] "algas azucareras"

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "sugar kelp"
msgid ""
"Also known as kombu, this brown algae grows in a single leaflike blade that "
"can reach more than twice the height of a man.  Young fronds make for "
"excellent soup stock and can even be eaten raw."
msgstr ""
"También conocida como kombu, esta alga parda crecer en una sola hoja que "
"puede alcanzar más del doble de la altura de un hombre. Las frondas jóvenes "
"son un excelente caldo para sopa e incluso pueden comerse crudas."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#: data/json/items/comestibles/raw_veggy.json
#. ~ Furniture name
#. ~ Item name
msgid "sea lettuce"
msgid_plural "sea lettuce"
msgstr[0] "lechuga de mar"
msgstr[1] "lechugas de mar"
msgstr[2] "lechugas de mar"

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "sea lettuce"
msgid ""
"Sometimes known as green laver, this leafy algae from the Ulva genus grows in "
"leafy little patches around shallows and tide pools.  Though small, it makes "
"a tasty snack."
msgstr ""
"Esta alga frondosa del género Ulva, a veces conocida como lavanda verde, "
"crece en pequeños parches frondosos en bajíos y pozas mareales. Aunque es "
"pequeña, constituye un sabroso tentempié."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#: data/json/items/comestibles/raw_veggy.json
#. ~ Furniture name
#. ~ Item name
msgid "bladderwrack"
msgid_plural "bladderwrack"
msgstr[0] "sargazo vejigoso"
msgstr[1] "sargazos vejigosos"
msgstr[2] "sargazos vejigosos"

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "bladderwrack"
msgid ""
"Named for the air bladders that grow all over its leafy fronds, this leafy "
"seaweed is technically edible and has a long history of use in folk medicine."
msgstr ""
"Llamada así por las vejigas de aire que crecen por todas sus frondas, esta "
"alga frondosa es técnicamente comestible y tiene una larga historia de uso en "
"la medicina popular."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Furniture name
msgid "sea anemone"
msgstr "anémona de mar"

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "sea anemone"
msgid ""
"This sessile polyp waves its stinging tentacles with the motion of the tides, "
"hoping to capture a tiny fish or crab.  It's wholly inedible and poses no "
"danger to anything bigger than a shrimp."
msgstr ""
"Este pólipo sésil agita sus tentáculos urticantes con el movimiento de las "
"mareas, con la esperanza de capturar un pequeño pez o cangrejo. No es "
"comestible y no supone ningún peligro para nada más grande que una gamba."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Furniture name
msgid "sea sponge"
msgstr "esponja de mar"

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "sea sponge"
msgid ""
"An immobile, lumpy little creature that looks nothing like a square kitchen "
"sponge.  Anchored to the sea floor, its porous body passively filters "
"plankton from the water that freely passes through it."
msgstr ""
"Una pequeña criatura inmóvil y grumosa que no se parece en nada a una esponja "
"cuadrada de cocina. Anclado al fondo marino, su cuerpo poroso filtra "
"pasivamente el plancton del agua que pasa libremente a través de él."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "Marloss flower"
msgstr "flor de Marloss"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "Marloss flower"
msgid ""
"This flower looks mostly like the other flowers taken by the mushrooms, but "
"its bulb is a brilliant cyan color.  It emits an aroma that is both "
"overwhelming and strangely alluring."
msgstr ""
"Esta flor es como las otras flores tomadas por los hongos, pero su bulbo es "
"de un color cian brillante. Emite un aroma a la vez abrumador y extrañamente "
"seductor."

#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Bashing sound
#. ~ Bashing failed sound
msgid "poof."
msgstr "puf."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "fungal flower"
msgstr "flor fúngica"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "fungal flower"
msgid ""
"This flower has been overgrown by gray, sinewy tendrils of fungus, and the "
"color has been leached from its petals and stem.  It gently sways of its own "
"volition, maintaining an unsettling rhythm."
msgstr ""
"Esta flor ha sido cubierta por tentáculos grises y fibrosos de hongos, y el "
"color se ha desprendido de sus pétalos y su tallo. Se balancea suavemente por "
"voluntad propia, manteniendo un ritmo inquietante."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "fungal mass"
msgstr "masa fúngica"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "fungal mass"
msgid ""
"Thick ropes of Mycal matter have covered the ground here completely.  It's "
"soft to the touch, but not firm enough to hold any weight."
msgstr ""
"Gruesas cuerdas de materia Mycal han cubierto el suelo de aquí completamente. "
"Es suave al tacto, pero no lo suficientemente firme como para sostener "
"cualquier peso."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "fungal clump"
msgstr "mata fúngica"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "fungal clump"
msgid ""
"Alien mold and stems mingle tightly here, swaying around and weaving "
"together, creating a sort of fungal bush."
msgstr ""
"El moho y los tallos alienígenas se mezclan con fuerza aquí, balanceándose y "
"entrelazándose, creando una especie de arbusto fúngico."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "fungal tangle"
msgstr "enredo fúngico"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "fungal tangle"
msgid ""
"Thick, ropy tendrils of fungus have risen from the ground and gathered into "
"an impenetrable clump."
msgstr ""
"Gruesos tentáculos de hongos se han levantado del suelo y se han reunido en "
"un grupo impenetrable."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "stone slab"
msgstr "escalón de piedra"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "stone slab"
msgid "A slab of heavy stone, with a reasonably flat surface."
msgstr "Una losa de piedra pesada, con una superficie razonablemente plana."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "headstone"
msgstr "lápida"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "headstone"
msgid ""
"A large slab of stone, engraved with information on the deceased individual "
"buried beneath.  While only a solemn reminder of the uncountable losses of "
"the Cataclysm, a proper final resting place grants an odd sense of peace."
msgstr ""
"Una gran losa de piedra, grabada con información sobre el individuo fallecido "
"enterrado debajo. Aunque sólo es un solemne recordatorio de las incontables "
"pérdidas del Cataclismo, un lugar de descanso final adecuado otorga una "
"extraña sensación de paz."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "gravestone"
msgstr "tumba"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "gravestone"
msgid ""
"An upright slab of stone with information engraved on the face about whoever "
"lies beneath.  While only a solemn reminder of the countless casualties of "
"the Cataclysm, a proper final resting place grants an odd sense of peace."
msgstr ""
"Una losa vertical de piedra con información grabada en la cara sobre quien "
"yace debajo. Aunque sólo es un solemne recordatorio de las innumerables "
"víctimas del Cataclismo, un lugar de descanso final adecuado otorga una "
"extraña sensación de paz."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "worn gravestone"
msgstr "tumba desgastada"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "worn gravestone"
msgid ""
"An aged and eroded gravestone, damaged to the point of rendering the "
"inscription illegible.  Whoever's buried here was probably lucky enough to "
"pass before all this chaos began."
msgstr ""
"Una lápida envejecida y erosionada, dañada hasta el punto de hacer ilegible "
"la inscripción. Quienquiera que esté enterrado aquí probablemente tuvo la "
"suerte de pasar antes de que empezara todo este caos."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "obelisk"
msgstr "obelisco"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "obelisk"
msgid ""
"A magnificent carved statue with an engraved plaque fixed to the base.  It "
"serves to honor the passing of somebody significant, something one wishes was "
"still a practical goal."
msgstr ""
"Una magnífica estatua tallada con una placa grabada fijada en la base. Sirve "
"para honrar el fallecimiento de alguien significativo, algo que uno desearía "
"que siguiera siendo un objetivo práctico."

#: data/json/furniture_and_terrain/furniture-graves.json
#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Bashing failed sound
msgid "thunk!"
msgstr "thunk!"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "battlefield cross"
msgstr "cruz de batalla"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "battlefield cross"
msgid ""
"A makeshift memorial marker, made of a service rifle - buried in the dirt, or "
"nestled in a pair of boots - with a helmet perched on the stock.  A small way "
"to honor the dead."
msgstr ""
"Una placa conmemorativa improvisada, hecha con un fusil de servicio "
"-enterrado en la tierra, o encajado en un par de botas-, con un casco "
"encaramado a la culata. Una pequeña forma de honrar a los muertos."

#: data/json/furniture_and_terrain/furniture-graves.json
#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture_treesung.json
#. ~ Bashing failed sound
msgid "whack."
msgstr "porrazo."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "chemical mixer"
msgstr "mezclador químico"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "chemical mixer"
msgid ""
"A large vat with a motorized mixing device for combining large quantities of "
"chemicals."
msgstr ""
"Una gran cuba con un dispositivo de mezcla motorizado para combinar grandes "
"cantidades de productos químicos."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "broken generator"
msgstr "generador roto"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "broken generator"
msgid "This generator is broken and will not help you produce usable electricity."
msgstr "Este generador está roto y no te ayudará a producir electricidad útil."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "Compact Advanced Sterling Radioisotope Generator"
msgstr "Generadores compactos y avanzados de radioisótopos Sterling"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "Compact Advanced Sterling Radioisotope
#. Generator"
msgid ""
"This hefty lump of steel and lead is the housing unit for a Stirling "
"generator powered by plutonium-238, originally designed by NASA and "
"repurposed by the military.  It is plastered with warning signs.  It's really "
"heavy owing to the thick armor plating, but you could take this down and use "
"it for your own purposes if you wanted."
msgstr ""
"Este enorme bulto de acero y plomo es la carcasa de un generador Stirling "
"alimentado con plutonio-238, diseñado originalmente por la NASA y reutilizado "
"por el ejército. Está cubierto de señales de advertencia. Es muy pesado "
"debido a su grueso blindaje, pero podrías desmontarlo y utilizarlo para tus "
"propios fines si quisieras."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "mobile antenna"
msgstr "antena móvil"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "mobile antenna"
msgid ""
"A stark black directional antenna, seemingly part of a monitoring setup.  An "
"LED mounted on its back lights up with a lazy and irregular rhythm."
msgstr ""
"Una antena direccional de un fuerte negro, que parece formar parte de un "
"sistema de vigilancia. Un led montado en su parte trasera se ilumina con un "
"ritmo perezoso e irregular."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "light machinery"
msgstr "maquinaria ligera"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "light machinery"
msgid "Assorted light machinery.  You could scavenge it for parts."
msgstr "Maquinaria ligera variada. Podrías rebuscar en ello por partes."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "heavy machinery"
msgstr "maquinaria pesada"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "heavy machinery"
msgid "Assorted heavy machinery.  You could scavenge it for parts."
msgstr "Maquinaria pesada variada. Podrías rebuscar en ello por partes."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "old machinery"
msgstr "maquinaria antigua"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "old machinery"
msgid "Assorted old, rusty machinery.  You could scavenge it for parts."
msgstr "Maquinaría oxidada, vieja y variada. Podrías rebuscar en ello por partes."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "electronic machinery"
msgstr "maquinaria eléctrica"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "electronic machinery"
msgid "Assorted electronic machinery.  You could scavenge it for parts."
msgstr "Maquinaria electrónica variada. Podrías rebuscar en ello por partes."

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
#. ~ Furniture name
msgid "robotic arm"
msgstr "brazo robótico"

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
#. ~ Description of furniture "robotic arm"
msgid ""
"An automated robotic arm used in assembly lines, which appears to be more "
"general-purpose than specially designed assemblers.  Despite being "
"functionless now, the parts could be useful."
msgstr ""
"Un brazo robótico automatizado utilizado en las cadenas de montaje, que "
"parece ser más de uso general que los ensambladores especialmente diseñados. "
"A pesar de no ser funcional ahora, las piezas podrían ser útiles."

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
#. ~ Bashing failed sound
msgid "thunk."
msgstr "tonk,"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "ground cable"
msgstr "cable de tierra"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "ground cable"
msgid "A bunch of loose cables snake along the floor."
msgstr "Un montón de cables sueltos serpentean por el suelo."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Bashing sound
msgid "shred!"
msgstr "¡triturado!"

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/json/furniture_and_terrain/furniture-pallet.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Bashing failed sound
msgid "thud!"
msgstr "¡golpes secos!"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "electrical conduit"
msgstr "conducto eléctrico"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "electrical conduit"
msgid "A thick bundle of electrical wiring protected by a metal conduit."
msgstr "Un grueso grupo de cableado eléctrico protegido por un conducto de metal."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "capacitor bank"
msgstr "banco condensador"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "capacitor bank"
msgid "A bank of heavy metal cylinders connected by large wires."
msgstr "Un banco de pesados cilindros metálicos conectados por grandes cables."

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/Aftershock/vehicles/part_items.json
#: data/mods/Aftershock/vehicles/vehicle_parts.json
#: data/mods/aftershock_exoplanet/vehicles/part_items.json
#: data/mods/aftershock_exoplanet/vehicles/vehicle_parts.json
#. ~ Furniture name
#. ~ Item name
#. ~ Vehicle part name
msgid "control station"
msgid_plural "control stations"
msgstr[0] "estación de control"
msgstr[1] "estaciones de control"
msgstr[2] "estaciones de control"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "control station"
msgid "Assorted electronic interfaces and screens.  You could scavenge it for parts."
msgstr ""
"Pantalla e interfaces electrónicas variadas. Podrías rebuscar en ello por "
"partes."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "nuclear fuel cell"
msgstr "celda de combustible nuclear"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "nuclear fuel cell"
msgid ""
"This fuel assembly consists of cylindrical rods put into bundles.  A uranium "
"oxide ceramic is formed into pellets and inserted into Zircaloy tubes that "
"are bundled together.  The Zircaloy tubes are pressurized with helium to "
"minimize pellet-cladding interaction which can lead to fuel rod failure over "
"long periods.  This fuel cell is used in nuclear power stations to produce "
"heat to power turbines."
msgstr ""
"Este elemento combustible está formado por varillas cilíndricas colocadas en "
"haces. Una cerámica de óxido de uranio se forma en pastillas y se introduce "
"en tubos de Zircaloy que se agrupan en haces. Los tubos de Zircaloy se "
"presurizan con helio para minimizar la interacción entre las pastillas y el "
"revestimiento, que puede provocar el fallo de la varilla de combustible "
"durante largos periodos. Esta pila de combustible se utiliza en centrales "
"nucleares para producir calor y alimentar turbinas."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "Autodoc Mk. XI"
msgstr "Autodoc Mk. XI"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "Autodoc Mk. XI"
msgid ""
"A surgical apparatus used for the installation and removal of bionics.  The "
"term name 'Autodoc' is something of a misnomer, as it can only operate if "
"programmed beforehand, something that a plethora of labels warn against doing "
"without expertise."
msgstr ""
"Un aparato quirúrgico utilizado para la instalación y retirada de implantes "
"biónicos. El nombre de \"Autodoc\" es un poco erróneo, ya que sólo puede "
"funcionar si se programa de antemano, algo que una plétora de etiquetas "
"advierten que no se debe hacer sin experiencia."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "Autodoc operation couch"
msgstr "Camilla de operación autodoc"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "Autodoc operation couch"
msgid ""
"A plush red sofa made less comfortable by the medical machinery directly "
"above it.  It has a single leather strap on the right armrest."
msgstr ""
"Es un sofá rojo de felpa que se ha vuelto menos cómodo por las máquinas "
"médicas que tiene arriba. Tiene una correa de cuero en el apoyabrazos derecho."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/json/vehicleparts/vehicle_parts.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "autoclave"
msgstr "autoclave"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "autoclave"
#. ~ Description of furniture "filled autoclave"
msgid ""
"A device that can steam its contents at high enough temperatures to "
"completely sterilize them, killing any possible contaminants."
msgstr ""
"Un dispositivo que puede vaporizar su contenido a temperaturas lo "
"suficientemente altas como para esterilizarlo completamente, matando "
"cualquier posible contaminante."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "filled autoclave"
msgstr "autoclave lleno"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "sample freezer"
msgstr "congelador de muestras"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "sample freezer"
msgid ""
"A specialized freezer capable of maintaining temperatures of -80 Celsius, "
"best used for the preservation of delicate scientific samples."
msgstr ""
"Un congelador especializado capaz de mantener temperaturas de -80 grados "
"centígrados y que suele utilizarse únicamente para la conservación de "
"muestras científicas delicadas."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "lab workbench"
msgstr "mesa de trabajo de laboratorio"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "lab workbench"
msgid ""
"A metal storage cabinet topped with a durable resin countertop resistant to "
"most chemical spills and burns.  It has wired-in electrical and gas fittings."
msgstr ""
"Un gabinete de almacenamiento metálico rematado con una encimera de resina "
"duradera resistente a la mayoría de derrames químicos y quemaduras. Dispone "
"de conexiones eléctricas y de gas cableadas."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "fume hood"
msgstr "campana extractora"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "fume hood"
msgid ""
"A metal hood atop a lab workspace, with durable glass shutters.  A fan in the "
"hood draws fumes and smoke from dangerous chemicals up into a ventilation "
"duct."
msgstr ""
"Una campana metálica sobre un espacio de trabajo de laboratorio, con "
"persianas de cristal duradero. Un ventilador en la campana extrae los gases y "
"el humo de los productos químicos peligrosos hacia un conducto de ventilación."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "shaker incubator"
msgstr "incubadora vibratoria"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "shaker incubator"
msgid ""
"A tool for keeping chemical broth nicely mixed and at just the right "
"temperature to grow bacteria.  Although more bacteria is probably the last "
"thing you need, considering the circumstances."
msgstr ""
"Una herramienta para mantener el caldo químico bien mezclado, a la "
"temperatura justa para cultivar bacterias. Aunque, probablemente, más "
"bacterias es lo último que necesitas, teniendo en cuenta las circunstancias."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "emergency wash station"
msgstr "estación de lavado de emergencia"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "emergency wash station"
msgid ""
"A standing sink with a pair of nozzles, along with a large, brightly-colored "
"handle.  It is specially designed to quickly remove contaminants from the "
"eyes, and is easily usable without being able to see very well.  A sizable "
"notice warns against drinking the water it uses."
msgstr ""
"Un lavabo de pie con un par de boquillas, junto con un mango grande y de "
"color brillante. Está especialmente diseñado para eliminar rápidamente los "
"contaminantes de los ojos, y es fácilmente utilizable sin poder ver muy bien. "
"Un aviso de tamaño considerable advierte que no se debe beber el agua que "
"utiliza."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "IV pole"
msgstr "Polo IV"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "IV pole"
msgid ""
"A tall wire frame on a set of small wheels used for holding an IV bag, useful "
"for unattended administration."
msgstr ""
"Un marco de alambre alto sobre un conjunto de ruedas pequeñas utilizado para "
"sostener una bolsa intravenosa, útil para la administración desatendida."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "high performance liquid chromatographer"
msgstr "cromatógrafo de líquidos de alto rendimiento"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "high performance liquid chromatographer"
#. ~ Description of furniture "high-performance liquid chromatographer"
msgid ""
"This high-tech tool would, with electricity and an experienced user, be a "
"very useful way to separate chemicals in a liquid or aqueous phase, based on "
"their affinity, to the stationary phase in a tube.  At least, that's what the "
"label says."
msgstr ""
"Esta herramienta de alta tecnología sería, con electricidad y un usuario "
"experimentado, una forma muy útil de separar sustancias químicas en una fase "
"líquida o acuosa, en función de su afinidad, a la fase estacionaria en un "
"tubo. Al menos, eso es lo que dice la etiqueta."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "gas chromatographer"
msgstr "cromatógrafo de gases"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "gas chromatographer"
msgid ""
"This high-tech tool would, with electricity and an experienced user, be a "
"very useful way to separate chemicals in a gaseous phase, based on their "
"affinity, to a stationary phase in a tube.  At least, that's what the label "
"says."
msgstr ""
"Esta herramienta de alta tecnología sería, con electricidad y un usuario "
"experimentado, una forma muy útil de separar los productos químicos en una "
"fase gaseosa, en función de su afinidad, a una fase estacionaria en un tubo. "
"Al menos, eso es lo que dice la etiqueta."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "mass spectrometer"
msgstr "espectrómetro de masas"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "mass spectrometer"
msgid ""
"Inside this large white box is a carefully balanced set of electric field "
"generators that can precisely separate ionized particles based on their "
"charge-to-mass ratio, firing them into a detector that measures the exact "
"mass of the particle hitting it.  Invaluable for chemical analysis and other "
"advanced sciences, it's not as useful anymore."
msgstr ""
"Dentro de esta gran caja blanca hay un conjunto cuidadosamente equilibrado de "
"generadores de campo eléctrico que pueden separar con precisión las "
"partículas ionizadas en función de su relación carga-masa, disparándolas a un "
"detector que mide la masa exacta de la partícula que choca con él. "
"Inestimable para el análisis químico y otras ciencias avanzadas, ya no es tan "
"útil."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "nuclear magnetic resonance spectrometer"
msgstr "espectrómetro de resonancia magnética nuclear"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "nuclear magnetic resonance spectrometer"
msgid ""
"A giant electromagnet with carefully tuned measurement equipment used to "
"observe how magnetic fields affect nuclear spins.  It is a common workhorse "
"for the discovery and study of chemical structures."
msgstr ""
"Un electroimán gigante con un equipo de medición cuidadosamente ajustado que "
"se utiliza para observar cómo afectan los campos magnéticos a los espines "
"nucleares. Es un instrumento muy utilizado para descubrir y estudiar "
"estructuras químicas."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "electron microscope"
msgstr "microscopio electrónico"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "electron microscope"
msgid ""
"An enormous observational tool for studying the details of samples on an "
"immensely small scale."
msgstr ""
"Una enorme herramienta de observación para estudiar los detalles de las "
"muestras a una escala inmensamente pequeña."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "CT scanner"
msgstr "Escáner CT"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "CT scanner"
msgid ""
"A massive piece of machinery used to take hundreds of X-ray images from 360 "
"degrees, often used for medical examinations."
msgstr ""
"Una enorme maquina utilizada para tomar cientos de imágenes de rayos X de 360 "
"grados, a menudo utilizada para los exámenes médicos de los pacientes."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "MRI machine"
msgstr "Máquina de resonancia magnética"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "MRI machine"
msgid ""
"A massive tool used to take NMR images of a patient placed inside, providing "
"invaluable medical insight."
msgstr ""
"Una herramienta masiva utilizada para tomar imágenes de Resonancia Magnética "
"de un paciente colocado en su interior, proporcionando una visión médica "
"inestimable."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "scanner bed"
msgstr "cama de escáner"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "scanner bed"
msgid ""
"A narrow, flat, and frankly uncomfortable bed for putting someone into an "
"imaging machine for medical observations."
msgstr ""
"Una cama estrecha, plana y francamente incómoda para meter a alguien en una "
"máquina de imágenes para realizar consultas médicas."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "anesthetic machine"
msgstr "máquina anestésica"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "anesthetic machine"
msgid ""
"A large machine with various tanks, tubes, and monitoring devices used to "
"maintain precise levels of anesthesia in a patient to ensure they, at least "
"ideally, remain asleep, unfeeling, but alive."
msgstr ""
"Una gran máquina con varios depósitos, tubos y dispositivos de monitorización "
"utilizados para mantener niveles precisos de anestesia en un paciente para "
"asegurar que, al menos idealmente, permanezca dormido, sin sentir, pero vivo."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "dialysis machine"
msgstr "máquina de diálisis"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "dialysis machine"
msgid ""
"A large machine for pumping and filtering the blood of somebody without the "
"function of their kidneys."
msgstr ""
"Un gran aparato para bombear y filtrar la sangre de alguien sin la función de "
"sus riñones."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "medical ventilator"
msgstr "ventilador médico"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "medical ventilator"
msgid ""
"A sizable box on a set of wheels that will pump air in and out of a patient's "
"lungs when they are incapable of breathing, though often only needed "
"temporarily."
msgstr ""
"Una caja de tamaño considerable sobre un conjunto de ruedas que bombea aire "
"dentro y fuera de los pulmones de un paciente cuando éste es incapaz de "
"respirar, aunque a menudo sólo se necesita temporalmente."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "privacy curtain"
msgstr "cortina de privacidad"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "privacy curtain"
msgid "No peeking!"
msgstr "¡No mires!"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Bashing sound
msgid "swish!"
msgstr "¡Swish!"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Bashing failed sound
msgid "clattering metal!"
msgstr "¡Un metal que hace ruido!"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "open privacy curtain"
msgstr "abrir la cortina de privacidad"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "open privacy curtain"
msgid "Stop peeking!"
msgstr "¡Deja de mirar!"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "centrifuge"
msgstr "centrifugadora"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "centrifuge"
msgid ""
"A centrifuge, a liquid separating device with an automated analyzer unit.  "
"For some reason, this one has an attached battery pack.  It could be used to "
"analyze a medical fluid sample, such as blood, if a test tube was placed in "
"it."
msgstr ""
"Una centrifugadora, un dispositivo separador de líquidos con una unidad "
"analizadora automatizada. Por alguna razón, éste tiene una batería conectada. "
"Podría utilizarse para analizar una muestra de fluido médico, como sangre, si "
"se colocara en ella un tubo de ensayo."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "X-ray scanner"
msgstr "escaner de rayos X"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "X-ray scanner"
msgid "A table with a movable head, often used for medical examinations."
msgstr "Una mesa con un cabezal móvil, a menudo utilizada para exámenes médicos."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "dental X-ray machine"
msgstr "máquina dental de rayos X"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "dental X-ray machine"
msgid "A device for creating radiographic images of the teeth."
msgstr "Un dispositivo para crear imágenes radiográficas de los dientes."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "exam chair"
msgstr "silla de examen médico"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "exam chair"
msgid "A medical exam chair with an overhead light, bolted to the floor."
msgstr "Una silla de examen médico con una luz superior, atornillada al suelo."

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Furniture name
msgid "pallet of bricks"
msgstr "palet de ladrillos"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Description of furniture "pallet of bricks"
msgid ""
"A massive, packed-together block of bricks wrapped with plastic packaging.  "
"It makes for easy storage of building materials for masonry constructions."
msgstr ""
"Un enorme paquete de ladrillos envuelto en un embalaje plástico. Facilita el "
"almacenamiento de materiales de construcción para obras de albañilería."

#: data/json/furniture_and_terrain/furniture-pallet.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-embrasures.json
#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Bashing failed sound
#. ~ Bashing sound
msgid "bash!"
msgstr "¡golpear!"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Furniture name
msgid "pallet of adobe bricks"
msgstr "palet de ladrillos de adobe"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Description of furniture "pallet of adobe bricks"
msgid ""
"A massive, packed-together block of adobe bricks wrapped with plastic "
"packaging.  It makes for easy storage of building materials for masonry "
"constructions."
msgstr ""
"Un enorme paquete de ladrillos de adobe envuelto en un embalaje plástico. "
"Facilita el almacenamiento de materiales de construcción para obras de "
"albañilería."

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Furniture name
msgid "pallet of cement bags"
msgstr "palet de bolsas de cemento"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Description of furniture "pallet of cement bags"
msgid ""
"A massive, packed-together block of cement bags wrapped with plastic "
"packaging.  It makes for easy storage of building materials for masonry "
"constructions."
msgstr ""
"Un enorme paquete de bolsas de cemento envuelto en un embalaje plástico. "
"Facilita el almacenamiento de materiales de construcción para obras de "
"albañilería."

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Furniture name
msgid "stack of wooden planks"
msgstr "pila de tablones de madera"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Description of furniture "stack of wooden planks"
msgid ""
"Dozens of construction planks tied together for easier transport.  "
"Deconstruct to untie them."
msgstr ""
"Decenas de tablones de construcción atados para facilitar su transporte. "
"Desmontalo para desatarlos."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "bathtub"
msgstr "bañera"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "bathtub"
msgid ""
"An ordinary ceramic tub, with a now-functionless steel faucet and a plug "
"fixed over the drain.  Watertight and relatively clean, it would make for a "
"good water trough."
msgstr ""
"Una bañera de cerámica ordinaria, con un grifo de acero que ya no funciona y "
"un tapón fijado sobre el desagüe. Hermética y relativamente limpia, sería un "
"buen abrevadero."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/mods/Magiclysm/furniture_and_terrain/furniture_druid.json
#. ~ Bashing sound
msgid "porcelain breaking!"
msgstr "¡porcelana rompiéndose!"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_habitat_floor.json
#: data/mods/Backrooms/furniture_terrain.json
#: data/mods/Magiclysm/furniture_and_terrain/furniture_druid.json
#: data/mods/Magiclysm/furniture_and_terrain/terrain.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_habitat_floor.json
#. ~ Bashing failed sound
msgid "whunk!"
msgstr "¡whunk!"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "shower"
msgstr "ducha"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "shower"
msgid ""
"A small enclosed ceramic room with a glass door and plumbing fixtures for "
"cleaning oneself.  Before it was a commonplace amenity, but now it's hard to "
"imagine wasting that much water."
msgstr ""
"Un pequeño cuarto de cerámica cerrado con una puerta de cristal y con "
"instalaciones de fontanería para limpiarse. Antes era una comodidad habitual, "
"pero ahora es difícil imaginar que se desperdicie tanta agua."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "sink"
msgstr "lavabo"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "sink"
msgid ""
"A porcelain water basin with a water tap and drain, designed to be fitted "
"into an opening on a countertop."
msgstr ""
"Lavabo de porcelana con grifo y desagüe, diseñado para encajar en un hueco de "
"la encimera."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "sink with gravity-feed tank"
msgstr "fregadero con tanque de alimentación por gravedad"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "sink with gravity-feed tank"
msgid ""
"A water basin with flowing water, fed by a tank suspended above.  A luxury "
"when the water main is unavailable.  This one has a hand pump to refill from "
"groundwater."
msgstr ""
"Una pila con agua corriente, alimentada por un depósito suspendido por "
"encima. Un lujo cuando no hay agua corriente. Éste tiene una bomba manual "
"para rellenarse con agua subterránea."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "toilet"
msgstr "inodoro"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "toilet"
msgid ""
"An invaluable fixture in any home, it would be a miracle to have one that "
"works.  The standing tank may hold a moderate amount of water, but while "
"better than anything that would be in the bowl, it would not be the cleanest."
msgstr ""
"Un accesorio invaluable en cualquier hogar, sería un milagro tener uno que "
"funcione. El depósito horizontal puede contener una cantidad moderada de "
"agua, pero aunque es mejor que todo lo que habría en la taza, no sería lo más "
"limpio."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "water heater"
msgstr "calentador de agua"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "water heater"
#. ~ Description of furniture "family–sized water heater"
msgid ""
"An insulated metal tank with a small fire used to maintain near-boiling "
"temperatures.  There's no longer any way to power it, but any water left in "
"the large tank from before the power went out should be pretty clean, and it "
"could be used to store large quantities of other liquids too."
msgstr ""
"Un depósito metálico aislado con un pequeño fuego utilizado para mantener "
"temperaturas cercanas a la ebullición. Ya no hay forma de alimentarlo, pero "
"el agua que quede en el gran depósito antes de que se fuera la luz debería "
"estar bastante limpia, y también podría utilizarse para almacenar grandes "
"cantidades de otros líquidos."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "family–sized water heater"
msgstr "calentador de agua tamaño familiar"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/json/items/tool/cooking.json data/json/vehicleparts/vehicle_parts.json
#. ~ Furniture name
#. ~ Item name
#. ~ Vehicle part name
msgid "water purifier"
msgid_plural "water purifiers"
msgstr[0] "potabilizador de agua"
msgstr[1] "potabilizadores de agua"
msgstr[2] "potabilizadores de agua"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "water purifier"
msgid ""
"This device effectively sterilizes water.  You can plug it into a power grid "
"to use it."
msgstr ""
"Este aparato esteriliza eficazmente el agua. Podrías conectarlo a tu propia "
"red eléctrica para utilizarlo."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "exercise machine"
msgid_plural "exercise machines"
msgstr[0] "máquina de ejercicio"
msgstr[1] "máquinas de ejercicio"
msgstr[2] "máquinas de ejercicio"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "exercise machine"
msgid ""
"A heavy set of weightlifting equipment for strength training, with a pair of "
"heavy weights affixed to opposite ends of a sturdy pipe.  You can adjust the "
"set by hand-picking the weights you wish to use."
msgstr ""
"Un conjunto pesado de equipos de levantamiento de pesas para el entrenamiento "
"de fuerza, con un par de pesas pesadas fijadas en los extremos opuestos de un "
"tubo resistente. Puedes ajustar el conjunto eligiendo a mano las pesas que "
"desees utilizar."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "ball machine"
msgstr "máquina lanzapelotas"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "ball machine"
msgid ""
"A simple machine for launching sports balls of various types, with a pair of "
"motorized wheels that, if spun up, would fling the ball at moderate speeds.  "
"Probably not the most effective ranged weapon against the undead."
msgstr ""
"Una sencilla máquina para lanzar pelotas deportivas de varios tipos, con un "
"par de ruedas motorizadas que, si se hacen girar, lanzan la pelota a "
"velocidades moderadas. Probablemente no sea el arma a distancia más eficaz "
"contra los muertos vivientes."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "parkour bars"
msgstr "barras de parkour"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "parkour bars"
msgid "A complicated set of monkey bars, to be used by adults to train parkour."
msgstr ""
"Un complicado conjunto de barras de mono, para ser utilizado por los adultos "
"para entrenar haciendo parkour."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-recreational.json
#. ~ Bashing sound
msgid "crack!"
msgstr "¡crack!"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "pool table"
msgstr "mesa de billar"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "pool table"
msgid ""
"A large wooden table with green felt carpeting on top, and a set of "
"symmetrical holes that carry billiard balls to an opening on one side.  While "
"not a good substitute for a normal table, you could take it apart for a "
"substantial amount of wood."
msgstr ""
"Una gran mesa de madera con un tapiz de fieltro verde en la parte superior y "
"un conjunto de agujeros simétricos que llevan las bolas de billar a una "
"abertura en uno de los lados. Aunque no es un buen sustituto de una mesa "
"normal, podrías desmontarla para obtener una cantidad considerable de madera."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "diving block"
msgstr "podio de salida de natación"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "diving block"
msgid ""
"A chunky plastic stool bolted onto the ground, intended as a safe way of "
"diving forward into a body of water."
msgstr ""
"Un grueso taburete de plástico atornillado al suelo, pensado como una forma "
"segura de sumergirse en una masa de agua."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "target"
msgstr "diana"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "target"
msgid ""
"A long sheet of metal, cut into a roughly human shape and held upright by a "
"pipe frame.  There are two bullseye targets painted onto it, a large one on "
"the torso, and a smaller one on the head.  It is peppered with small dents "
"and holes, and a large amount of the paint has flaked or chipped off."
msgstr ""
"Una larga plancha de metal, cortada en forma humana y sostenida por un "
"armazón de tubos. Tiene pintadas dos dianas, una grande en el torso y otra "
"más pequeña en la cabeza. Está salpicada de pequeñas abolladuras y agujeros, "
"y gran parte de la pintura está descascarillada o desconchada."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "arcade machine"
msgid ""
"A bulky upright arcade cabinet, brightly painted and slightly worn with age.  "
"Useless for its intended purpose without power, it's bound to have valuable "
"parts."
msgstr ""
"Un voluminoso armario arcade vertical, brillantemente pintado y ligeramente "
"desgastado por el tiempo. Inútil para su propósito sin energía, seguro que "
"tiene piezas valiosas."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "pinball machine"
msgstr "pinball"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "pinball machine"
msgid ""
"An iconic game, this machine has a brightly decorated background on its "
"intricate obstacle course, which is covered by a long sheet of glass.  While "
"inoperable without power, it's still impressive to look at, though probably "
"more useful if disassembled."
msgstr ""
"Esta máquina, un juego icónico, tiene un fondo brillantemente decorado en su "
"intrincada pista de obstáculos, que está cubierta por una larga hoja de "
"cristal. Aunque es inoperable sin energía, sigue siendo impresionante de ver, "
"aunque probablemente sea más útil si se desmonta."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "ergometer"
msgstr "ergómetro"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "ergometer"
msgid ""
"An exercise machine with a set of handles and plates meant to emulate rowing "
"a boat.  Without power it can't be operated, but it might have useful parts "
"to be scavenged."
msgstr ""
"Una máquina de ejercicios con un conjunto de asas y placas que pretende "
"emular el remo de un barco. Sin energía no puede funcionar, pero puede ser "
"rebuscado por partes útiles."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "mechanical ergometer"
msgid_plural "mechanical ergometers"
msgstr[0] "ergómetro mecánico"
msgstr[1] "ergómetros mecánicos"
msgstr[2] "ergómetros mecánicos"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "mechanical ergometer"
msgid ""
"An exercise machine with a set of handles and plates meant to emulate rowing "
"a boat.  This an older model with mechanical resistance adjustments, so it "
"works without power."
msgstr ""
"Una máquina de ejercicios con un conjunto de asas y placas para emular el "
"remar de un barco. Este es un modelo antiguo con ajustes de resistencia "
"mecánica, por lo que funciona sin energía."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "treadmill"
msgstr "cinta para correr"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "treadmill"
msgid ""
"A motorized conveyor belt with a control panel for running in place.  Without "
"power, it's an immense challenge to move the belt.  Regardless, you're "
"probably getting enough cardio on your own."
msgstr ""
"Una cinta transportadora motorizada con un panel de control para su "
"funcionamiento en el lugar. Sin energía, es un reto inmenso mover la cinta. A "
"pesar de ello, es probable que estés haciendo suficiente cardio por tu cuenta."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "gravity treadmill"
msgid_plural "gravity treadmills"
msgstr[0] "cinta de correr inclinada"
msgstr[1] "cintas de correr inclinadas"
msgstr[2] "cintas de correr inclinadas"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "gravity treadmill"
msgid ""
"A gravity-driven conveyor belt with a mechanical control panel for running in "
"place.  The belt is positioned on an adjustable incline, so it slides back "
"under your weight without needing to be powered."
msgstr ""
"Una cinta transportadora impulsada por gravedad con un panel de control "
"mecánico para correr en el lugar. La cinta se coloca en una inclinación "
"ajustable, por lo que se desliza hacia atrás bajo tu peso sin necesidad de "
"ser accionada."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "heavy punching bag"
msgid_plural "heavy punching bags"
msgstr[0] "bolsa de boxeo pesada"
msgstr[1] "bolsas de boxeo pesadas"
msgstr[2] "bolsas de boxeo pesadas"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "heavy punching bag"
msgid ""
"A hefty, oblong leather bag, suspended from a ceiling mount with a steel "
"chain.  It can be used for exercise and combat training, with the notable "
"advantage that it doesn't fight back."
msgstr ""
"Una bolsa de cuero de forma oblonga, suspendida en un soporte de techo con "
"una cadena de acero. Puede utilizarse para hacer ejercicio y entrenar el "
"combate, con la notable ventaja de que no se defiende."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Bashing failed sound
msgid "whud."
msgstr "whud."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/furniture/decorative.json
#. ~ Furniture name
#. ~ Item name
msgid "piano"
msgid_plural "piano"
msgstr[0] "piano"
msgstr[1] "pianos"
msgstr[2] "pianos"

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/furniture/decorative.json
#. ~ Description of furniture "piano"
#. ~ Description of "piano"
msgid ""
"An elegant piano, capable of producing beautiful music if used by a skilled "
"player.  A set of off-white and black keys are linked to a set of hammers, "
"which strike their corresponding tightly-coiled wire to produce sound."
msgstr ""
"Un piano elegante, capaz de producir bella música si lo utiliza un intérprete "
"hábil. Un conjunto de teclas blancas y negras están unidas a un juego de "
"martillos, que golpean su correspondiente cable tensado para producir un "
"sonido."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Bashing sound
msgid "a suffering piano!"
msgstr "un piano sufrido"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Bashing failed sound
msgid "kerchang."
msgstr "kerchang."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "speaker cabinet"
msgstr "gabinete de altavoz"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "speaker cabinet"
msgid ""
"An upright wood-panel case of large speakers, built to produce a potentially "
"deafening volume level.  While it would be a terrible idea to use this now, "
"it could hold useful parts."
msgstr ""
"Una caja vertical de paneles de madera con grandes altavoces, construida para "
"producir un nivel de volumen potencialmente ensordecedor. Aunque sería una "
"pésima idea utilizarlo ahora, podría contener piezas útiles."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "dancing pole"
msgstr "Barra de baile"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "dancing pole"
msgid ""
"A tall steel pipe mounted vertically, securely fastened to the ceiling and "
"floor.  Usually used for various forms of dancing, often in adult-oriented "
"venues."
msgstr ""
"Una barra de acero alta montada verticalmente, fijado de forma segura al "
"techo y al suelo. Suele utilizarse para diversas formas de baile, a menudo en "
"locales orientados a los adultos."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "roulette table"
msgstr "mesa de ruleta"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "roulette table"
msgid ""
"A huge table specially made for a specific form of gambling, with a grid "
"painted onto the felt top, and a concave spinning wheel intended to give a "
"random selection of the inscribed possibilities."
msgstr ""
"Una enorme mesa hecha especialmente para una forma específica de juego, con "
"una cuadrícula pintada en el tablero de fieltro, y una rueda giratoria "
"cóncava destinada a dar una selección aleatoria de las posibilidades "
"inscritas."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "pipe organ"
msgstr "órgano tubular"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "pipe organ"
msgid ""
"A majestic pipe organ.  Dubbed \"the king of instruments\", it is capable of "
"producing powerful sound harmonies if used by a skilled player.  Rows of "
"off-white and black keys are linked to a set of iron pipes, which resonate at "
"a specific pitch when pressurized air is driven through them."
msgstr ""
"Un majestuoso órgano tubular. Apodado \"el rey de los instrumentos\", es "
"capaz de producir potentes armonías sonoras si lo utiliza un intérprete "
"hábil. Filas de teclas blancas y negras unidas a un conjunto de tubos de "
"hierro, que resuenan en un tono específico cuando se impulsa aire a presión a "
"través de ellos."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Bashing sound
msgid "a dramatic pipe organ!"
msgstr "¡un dramático órgano tubular!"

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "training dummy"
msgid_plural "training dummies"
msgstr[0] "maniquí de entrenamiento"
msgstr[1] "maniquíes de entrenamiento"
msgstr[2] "maniquíes de entrenamiento"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "training dummy"
msgid ""
"A hand-made humanoid figure, useful for training in close quarters combat.  "
"This one is made from wood and has some duct tape to mark the striking "
"points.  It has been erected in the ground on its post."
msgstr ""
"Figura humanoide hecha a mano, útil para entrenar el combate cuerpo a cuerpo. "
"Está hecha de madera y tiene cinta adhesiva para marcar los puntos de ataque. "
"Se ha instalado en el suelo sobre su poste."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "armored training dummy"
msgid_plural "armored training dummies"
msgstr[0] "maniquí de entrenamiento blindados"
msgstr[1] "maniquíes de entrenamiento blindados"
msgstr[2] "maniquíes de entrenamiento blindados"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "armored training dummy"
msgid ""
"A hand-made humanoid figure, useful for training in close quarters combat.  "
"This one is covered in scrap armor and looks on guard.  It has been erected "
"in the ground on its post."
msgstr ""
"Figura humanoide hecha a mano, útil para el entrenamiento en combate cuerpo a "
"cuerpo. Está cubierta con una armadura de chatarra y parece estar de guardia. "
"Se ha instalado en el suelo sobre su poste."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "box archery target"
msgid_plural "box archery targets"
msgstr[0] "caja objetivo para tiro con arco"
msgstr[1] "caja objetivos para tiro con arco"
msgstr[2] "caja objetivos para tiro con arco"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "box archery target"
msgid ""
"A soft target for archery consisting of tightly-packed cloth stuffed into a "
"cardboard box, with a bullseye marked on the front."
msgstr ""
"Una diana blanda para el tiro con arco. Consiste en una tela prensada metida "
"en una caja de cartón, con una diana marcada en la parte delantera."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Bashing sound
msgid "whish!"
msgstr "\"¡thunk!\""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "bale archery target"
msgid_plural "bale archery targets"
msgstr[0] "paca objetivo de tiro con arco"
msgstr[1] "pacas objetivo de tiro con arco"
msgstr[2] "pacas objetivo de tiro con arco"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "bale archery target"
msgid ""
"A soft target for archery consisting of a bale of hay with a bullseye marked "
"on the front."
msgstr ""
"Una diana blanda para el tiro con arco que consiste en un fardo de heno con "
"una diana marcada en la parte delantera."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "cell phone signal booster"
msgstr "un potenciador de la señal de los teléfonos celulares"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "cell phone signal booster"
msgid ""
"A specialized piece of equipment that receives phone signals and amplifies "
"them to reach further destinations with more clarity.  Now that there's no "
"longer signals for them to boost, they're only good for parts."
msgstr ""
"Son equipos especializados que reciben las señales telefónicas y las "
"amplifican para llegar a lugares más lejanos con mayor claridad. Ahora que ya "
"no hay señales que puedan amplificar, solo sirven para piezas."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Bashing failed sound
msgid "womp!"
msgstr "¡womp!"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "satellite dish"
msgstr "antena parabólica"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "satellite dish"
msgid ""
"A small sheet metal disc designed to receive radio waves from orbital "
"satellites.  Satellites that will assuredly continue to orbit, with nothing "
"to broadcast."
msgstr ""
"Un pequeño disco de chapa diseñado para recibir las ondas de radio de los "
"satélites orbitales. Satélites que seguramente seguirán en órbita, sin nada "
"que emitir."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "chimney crown"
msgstr "corona de chimenea"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "chimney crown"
msgid ""
"The top of a brick chimney, the opening is stained black with soot.  "
"Definitely too narrow to fit in."
msgstr ""
"La parte superior de una chimenea de ladrillo, la apertura está manchada de "
"negro con hollín. Definitivamente es demasiado estrecho para entrar."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "TV antenna"
msgstr "Antena de TV"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "TV antenna"
msgid ""
"A simple metal antenna to increase the reception of non-cable television "
"broadcasts.  Almost wholly obsolete for years, only being good for parts "
"isn't new for this item."
msgstr ""
"Una simple antena metálica para aumentar la recepción de las emisiones de "
"televisión no por cable. Casi totalmente obsoleta desde hace años, sólo sirve "
"para piezas nada nuevo para este objeto."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "vent pipe"
msgstr "conducto de ventilación"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "vent pipe"
msgid ""
"A sort of chimney spout for a building's internal ventilation system, this "
"can be used for circulation, venting fumes, and other such functions."
msgstr ""
"Una especie de chimenea para el sistema de ventilación interna de un "
"edificio, que puede utilizarse por la circulación, la salida de humos y otras "
"funciones similares."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "wind vane"
msgstr "veleta"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "wind vane"
msgid ""
"A metal fin that swivels around a central pivot, indicating the direction of "
"prevailing wind."
msgstr ""
"Una aleta metálica que gira alrededor de un pivote central y que indica la "
"dirección del viento predominante."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "roof turbine vent"
msgstr "ventilador de turbina de tejado"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "roof turbine vent"
msgid ""
"A rotary wind turbine that will catch the wind and pull out air from inside.  "
"It is most commonly used for improving air circulation, particularly in "
"poorly-ventilated areas like attics."
msgstr ""
"Una turbina eólica rotativa que capta el viento y extrae el aire de su "
"interior. Se utiliza sobre todo para mejorar la circulación del aire, "
"especialmente en zonas poco ventiladas como los áticos."

#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Furniture name
msgid "bale of hay"
msgstr "fardo de heno"

#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Description of furniture "bale of hay"
msgid ""
"A massive packed-together block of hay, it makes for easy storage of straw "
"for livestock.  If your only other option is the floor, it makes a tolerable "
"bed."
msgstr ""
"Un enorme bloque de heno empaquetado, facilita el almacenamiento de paja para "
"el ganado. Si tu única opción es el suelo, constituye una cama tolerable."

#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Furniture name
msgid "pile of woodchips"
msgstr "pila de astillas de madera"

#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Description of furniture "pile of woodchips"
msgid ""
"A large mound of piled wood chips.  Unpleasant to lay on, hard to walk "
"through, and a large fire hazard, it's probably best to shovel it out of the "
"way."
msgstr ""
"Un gran montículo de astillas apiladas. Desagradable de pisar, difícil de "
"atravesar y un gran peligro de incendio, probablemente sea mejor quitarla con "
"una pala."

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "bench"
msgstr "banco"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "bench"
msgid ""
"A simple bench with wood slats nailed to a frame.  While uncomfortably flat "
"and just as cold as the ground, it could serve as a bed if needed."
msgstr ""
"Un simple banco con listones de madera clavados en un marco. Aunque es "
"incómodo y tan frío como el suelo, puede servir de cama si es necesario."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "armchair"
msgid_plural "armchairs"
msgstr[0] "sillón"
msgstr[1] "sillones"
msgstr[2] "sillones"

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Description of furniture "armchair"
#. ~ Description of "armchair"
msgid ""
"A simple upholstered chair with armrests.  Soft and fairly warm, it "
"definitely beats the ground for sleeping on, though not by much."
msgstr ""
"Una simple silla tapizada con reposabrazos. Suave y bastante cálida, "
"definitivamente es mejor que el suelo para dormir, aunque no por mucho."

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "airplane seat"
msgstr "asiento del avión"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "airplane seat"
msgid ""
"A cheaply-upholstered folding airplane seat, it has a simple across-the-lap "
"seatbelt.  You likely wouldn't be the first to sleep in this."
msgstr ""
"Un asiento de avión plegable de tapicería barata, con un simple cinturón de "
"seguridad cruzado. Probablemente no serías el primero en dormir en él."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "wooden chair"
msgid_plural "wooden chairs"
msgstr[0] "silla de madera"
msgstr[1] "sillas de madera"
msgstr[2] "sillas de madera"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "wooden chair"
msgid ""
"A simple wooden chair with four legs, a seat, and a back.  It's nice to rest "
"your feet for once, and if coupled with a suitable table, you could eat a "
"meal properly and almost pretend that things were normal again."
msgstr ""
"Una simple silla de madera con cuatro patas, asiento y respaldo. Es agradable "
"descansar los pies por una vez y, si se combina con una mesa adecuada, "
"podrias comer como es debido y casi fingir que las cosas vuelven a ser "
"normales."

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "sofa"
msgstr "sofá"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "sofa"
msgid ""
"A wide upholstered bench, large enough for two people to comfortably sit "
"alongside one another, or for one person to lay down on.  It's not quite a "
"bed, but it's a hell of a lot more comfortable than the floor."
msgstr ""
"Un amplio respaldo tapizado, lo bastante grande para que dos personas se "
"sienten cómodamente una al lado de la otra, o para que una sola se tumbe en "
"él. No es una cama, pero es mucho más cómodo que el suelo."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "wooden stool"
msgid_plural "wooden stools"
msgstr[0] "taburete de madera"
msgstr[1] "taburetes de madera"
msgstr[2] "taburetes de madera"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "wooden stool"
msgid ""
"A simple stool with four legs and a seat.  While it's a touch more "
"maneuverable to sit on, the lack of back support means it's significantly "
"less comfortable than a normal chair."
msgstr ""
"Un simple taburete con cuatro patas y un asiento. Aunque es un poco más "
"manejable para sentarse, la falta de respaldo hace que sea bastante menos "
"cómodo que una silla normal."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "camp chair"
msgid_plural "camp chairs"
msgstr[0] "silla de campamento"
msgstr[1] "sillas de campamento"
msgstr[2] "sillas de campamento"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "camp chair"
msgid ""
"A somewhat uncomfortable folding chair, with fabric strung across a metal "
"frame.  Not the best, but better than nothing, and very easy to pack up for "
"transport."
msgstr ""
"Una silla plegable algo incómoda, con tela tendida sobre un armazón de metal. "
"No es lo mejor, pero es mejor que nada, y es muy fácil de transportar."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "log stool"
msgid_plural "log stools"
msgstr[0] "taburete de troncos"
msgstr[1] "taburetes de troncos"
msgstr[2] "taburetes de troncos"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "log stool"
msgid ""
"A short section of a tree trunk with one of the flat ends smoothed down.  "
"Makes for a decent place to sit, but not quite a real chair."
msgstr ""
"Una sección corta de un tronco de árbol con uno de los extremos planos "
"alisados. Es un lugar decente para sentarse, pero no es una verdadera silla."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "deck chair"
msgid_plural "deck chairs"
msgstr[0] "tumbona"
msgstr[1] "tumbonas"
msgstr[2] "tumbonas"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "deck chair"
msgid ""
"A folding deck chair with fabric sheets mounted to a wooden frame.  While "
"it's built to handle outdoor conditions and is an improvement over the "
"ground, it's not particularly comfortable."
msgstr ""
"Una tumbona plegable con láminas de tela montadas sobre un armazón de madera. "
"Aunque está hecha para soportar condiciones al aire libre y es una mejora "
"respecto al suelo, no es especialmente cómoda."

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "metal bench"
msgstr "banco de metal"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "metal bench"
msgid "A bench made of metal.  Not the most comfortable furniture you've ever sat on."
msgstr "Un banco hecho de metal. No es el mueble más cómodo en el que te has sentado."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/vehicleparts/vehicle_parts.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "wooden bench"
msgstr "banco de madera"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "wooden bench"
msgid ""
"A simple wooden bench made of two thick, makeshift legs and a flat piece of "
"wood on top.  Certainly nowhere near as good as a bed, but sitting on it "
"makes you feel like you're out camping."
msgstr ""
"Un sencillo banco de madera formado por dos gruesas patas improvisadas y un "
"trozo de madera plano encima. Desde luego, no es ni de lejos tan bueno como "
"una cama, pero sentarse en él te hace sentir como si estuvieras de acampada."

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "park bench"
msgstr "banco de parque"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "park bench"
msgid ""
"A wooden bench with a metal frame and a back support.  Cold and uncomfortable "
"to sleep on, but sitting on it is not terrible."
msgstr ""
"Un banco de madera con un marco de metal y un soporte para la espalda. Sigue "
"siendo frío e incómodo para dormir, pero sentarse en él no es terrible."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "bar stool"
msgid_plural "bar stools"
msgstr[0] "taburete de bar"
msgstr[1] "taburetes de bar"
msgstr[2] "taburetes de bar"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "bar stool"
msgid ""
"A bar stool with a leather seat on a steel support.  Not practical for "
"sleeping at all, but it does feel nicer than sitting on the ground."
msgstr ""
"Un taburete de bar con un asiento de cuero sobre un soporte de acero. No es "
"nada práctico para dormir, pero resulta más agradable que sentarse en el "
"suelo."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "folding chair"
msgid_plural "folding chairs"
msgstr[0] "silla plegable"
msgstr[1] "sillas plegables"
msgstr[2] "sillas plegables"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "folding chair"
msgid ""
"A black foldable plastic chair on a steel frame.  Not particularly "
"comfortable, but at least you have something to sit on."
msgstr ""
"Una silla negra de plástico plegable sobre una estructura de acero. No es "
"especialmente cómoda, pero al menos tienes algo en lo que sentarte."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "plywood chair"
msgid_plural "plywood chairs"
msgstr[0] "silla de madera contrachapada"
msgstr[1] "sillas de madera contrachapada"
msgstr[2] "sillas de madera contrachapada"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "plywood chair"
msgid ""
"A simple chair made of plywood on a steel frame.  Quite uncomfortable, but it "
"works for sleeping if it's the only option available."
msgstr ""
"Una sencilla silla hecha de madera contrachapada sobre una estructura de "
"acero. Bastante incómoda, pero sirve para dormir si es la única opción "
"disponible."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "black wooden chair"
msgid_plural "black wooden chairs"
msgstr[0] "silla de madera negra"
msgstr[1] "sillas de madera negras"
msgstr[2] "sillas de madera negras"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "black wooden chair"
msgid ""
"A simple wooden chair with four legs, a seat, and a back.  It's nice to rest "
"your feet for once, and if coupled with a suitable table, you could eat a "
"meal properly and almost pretend that things were normal again.  This "
"particular chair is painted black."
msgstr ""
"Una simple silla de madera con cuatro patas, asiento y respaldo. Es agradable "
"descansar los pies por una vez y, si se combina con una mesa adecuada, "
"podrias comer como es debido y casi fingir que las cosas vuelven a ser "
"normales.Esta silla en concreto está pintada de negro."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "white wooden chair"
msgid_plural "white wooden chairs"
msgstr[0] "silla de madera blanca"
msgstr[1] "sillas de madera blancas"
msgstr[2] "sillas de madera blancas"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "white wooden chair"
msgid ""
"A simple wooden chair with four legs, a seat, and a back.  It's nice to rest "
"your feet for once, and if coupled with a suitable table, you could eat a "
"meal properly and almost pretend that things were normal again.  This "
"particular chair is painted white."
msgstr ""
"Una simple silla de madera con cuatro patas, asiento y respaldo. Es agradable "
"descansar los pies por una vez y, si se combina con una mesa adecuada, "
"podrias comer como es debido y casi fingir que las cosas vuelven a ser "
"normales.Esta silla en concreto está pintada de blanco."

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "barber chair"
msgstr "silla de barbero"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "barber chair"
msgid ""
"a stationary chair made of cloth and steel.  With adjustable height and the "
"ability to swing."
msgstr ""
"Una silla fija de tela y acero. Con altura regulable y posibilidad de "
"balancearse."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "bean bag"
msgid_plural "bean bags"
msgstr[0] "puf"
msgstr[1] "pufs"
msgstr[2] "pufs"

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Description of furniture "bean bag"
#. ~ Description of "bean bag"
msgid "A large cushion filled with beads often used as a seat."
msgstr "Un gran cojín relleno de cuentas que suele utilizarse como asiento."

#: data/json/furniture_and_terrain/furniture-signs.json
#: data/mods/innawood/furniture_and_terrain/furniture-tools.json
#. ~ Furniture name
msgid "bulletin board"
msgstr "tablero de avisos"

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "bulletin board"
msgid ""
"A wide wooden frame with a sheet of corkboard inside.  Good for pinning "
"various notices for other survivors to read."
msgstr ""
"Una estructura ancha de madera con una hoja de corcho en su interior. Sirve "
"para fijar varios avisos para que otros supervivientes los lean."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Furniture name
msgid "sign"
msgstr "cartel"

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "sign"
msgid ""
"A simple signpost made of wood.  Basically two planks alongside each other "
"nailed to another plank that holds them up."
msgstr ""
"Un simple poste de señalización hecho de madera. Básicamente son dos tablones "
"uno al lado del otro clavados a otro tablón que los sostiene."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Furniture name
msgid "warning sign"
msgstr "señal de advertencia"

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "warning sign"
msgid ""
"A triangular signpost painted white with a red border.  Designed to easily "
"catch the eye, signs of this nature seldom display anything but bad news."
msgstr ""
"Un poste indicador triangular pintado de blanco con un borde rojo. Diseñados "
"para captar fácilmente la atención, los carteles de esta naturaleza rara vez "
"muestran algo que no sean malas noticias."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Furniture name
msgid "evac shelter info board"
msgstr "tablón de información del refugio de evacuación"

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "evac shelter info board"
msgid ""
"A wide wooden frame surrounding a sheet of cork, on to which a number of "
"full-page notices have been neatly tacked.  Most seem to provide emergency "
"information, or instructions now woefully outdated considering the state of "
"things, but a map pointing to the nearest refugee center catches your eye.  "
"You should take a closer look."
msgstr ""
"Un amplio marco de madera rodea una plancha de corcho en la que se han pegado "
"con chinchetas varios anuncios a toda página. La mayoría parecen proporcionar "
"información de emergencia, o instrucciones ahora lamentablemente anticuadas "
"teniendo en cuenta el estado de las cosas, pero un mapa que señala el centro "
"de refugiados más cercano llama tu atención. Deberías echarle un vistazo."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Player message in effect in EoC "EOC_EVAC_BOARD_FALSE" in furniture "evac
#. shelter info board"'s examine action
msgid ""
"You study the board.  It shows a similar set of directions to the ones you "
"already have.  You cross-reference them and don't learn anything new."
msgstr ""
"Examinas el tablón de información. Muestra un conjunto de direcciones similar "
"a las que ya tienes. Comparas las referencias y no aprendes nada nuevo."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Player message in effect in EoC "EOC_EVAC_BOARD" in furniture "evac
#. shelter info board"'s examine action
msgid ""
"You study the board.  One of the pages has a map and address for a nearby "
"refugee center alongside minutia you no longer need trouble yourself with now "
"that society has collapsed, like 'operating hours' and 'acceptable forms of "
"ID'.  You take careful note of the map on the board and mark down the "
"coordinates."
msgstr ""
"Estudias el tablón de información. En una de las páginas hay un mapa y la "
"dirección de un centro de refugiados cercano, además de detalles que ya no "
"necesitas saber ahora que la sociedad se ha derrumbado, como el \"horario de "
"funcionamiento y los \"documentos de identidad que aceptan\". Tomas buena "
"nota del mapa del tablón y apuntas las coordenadas."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Furniture name
msgid "stop sign"
msgstr "señal de stop"

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "stop sign"
msgid "An octagonal red sign on a long metal pole, marked with the word STOP."
msgstr ""
"Una señal roja octogonal sobre un largo poste metálico, marcada con la "
"palabra STOP."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/vehicleparts/vehicle_parts.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture_treesung.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "bed"
msgstr "cama"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "bed"
msgid ""
"A standard mattress on a sturdy wooden frame.  Even without blankets or "
"pillows, and despite being a completely ordinary mattress, it's a sight for "
"sore, tired eyes."
msgstr ""
"Un colchón normal sobre un robusto armazón de madera. Incluso sin mantas ni "
"almohadas, y a pesar de ser un colchón completamente normal, es un regalo "
"para los ojos cansados y doloridos."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/recipes/basecamps/base/fbmc_outpost/recipe_modular_outpost_normal.json
#. ~ Furniture name
#. ~ Blueprint name of recipe crafting "faction_base_outpost_normal_bed_0"
msgid "bunk bed"
msgstr "litera"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "bunk bed"
msgid ""
"A bunk bed with a sturdy wooden frame built to hold two single-person "
"mattresses above one another.  While these usually mean sleeping closer than "
"you'd like to somebody you wouldn't normally want to share a mattress with, a "
"bed's a bed."
msgstr ""
"Una litera con una robusta estructura de madera construida para sostener dos "
"colchones de una persona encima de otro. Aunque suelen suponer dormir más "
"cerca de lo que te gustaría de alguien con quien normalmente no querrías "
"compartir colchón, una cama es una cama."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture_treesung.json
#. ~ Furniture name
msgid "down bed"
msgstr "cama de plumón"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "down bed"
msgid ""
"A down mattress on a sturdy wooden frame.  Even without blankets or pillows, "
"and despite being a completely ordinary mattress, it's a sight for sore, "
"tired eyes."
msgstr ""
"Un colchón de plumón sobre un robusto armazón de madera. Incluso sin mantas "
"ni almohadas, y a pesar de ser un colchón completamente normal, es un "
"espectáculo para los ojos doloridos y cansados."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "down bunkbed"
msgstr "literas de plumón"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "down bunkbed"
msgid ""
"A bunk bed with a sturdy wooden frame built to hold two single-person "
"mattresses above one another.  While these usually mean sleeping closer than "
"you'd like to somebody you wouldn't normally want to share a mattress with, a "
"bed's a bed.  This one has two down mattresses."
msgstr ""
"Una litera con un robusto armazón de madera construido para sostener dos "
"colchones de una persona uno encima del otro. Aunque suelen implicar dormir "
"más cerca de lo que te gustaría de alguien con quien normalmente no querrías "
"compartir colchón, una cama es una cama. Esta tiene dos colchones de plumón."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "triple berth"
msgstr "litera triple"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "triple berth"
msgid ""
"This bunk bed can hold three people at once - a perfect sleeping solution for "
"places where empty space is at a premium."
msgstr ""
"Esta litera tiene una capacidad de tres personas, una solución perfecta para "
"dormir en lugares donde el espacio vacío es un lujo."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "bed frame"
msgstr "estructura de cama"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "bed frame"
msgid ""
"A sturdy wooden bed frame built to hold most standard mattresses.  Despite "
"being one half of a bed, it's just about impossible to lay on by itself."
msgstr ""
"Una robusta estructura de cama de madera construido para sostener la mayoría "
"de los colchones estándar. A pesar de ser una mitad de la cama, es casi "
"imposible acostarse en ella sola."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "mattress"
msgid ""
"An ordinary mattress lying on the floor.  While it's not as comfortable as a "
"proper bed with a frame, it's pretty close.  If it's somewhere actually safe "
"to sleep, this is practically a luxury in and of itself."
msgstr ""
"Un colchón normal tirado en el suelo. Aunque no es tan cómodo como una cama "
"con armazón, se le acerca bastante. Si es en un lugar realmente seguro, es "
"prácticamente un lujo en sí mismo."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "down mattress"
msgid ""
"A squishy, feather-stuffed mattress lying on the floor.  While it's not as "
"comfortable as a proper bed with a frame, it's pretty close.  If it's "
"somewhere actually safe to sleep, this is practically a luxury in and of "
"itself."
msgstr ""
"Un colchón mullido, relleno de plumas y tirado en el suelo. Aunque no es tan "
"cómodo como una cama con armazón, se le acerca bastante. Si es un lugar "
"realmente seguro para dormir, es prácticamente un lujo en sí mismo."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/items/generic/bedding.json
#. ~ Furniture name
#. ~ Item name
msgid "hammock"
msgid_plural "hammocks"
msgstr[0] "hamaca"
msgstr[1] "hamaca"
msgstr[2] "hamacas"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "hammock"
msgid ""
"A large sheet of cloth with ropes on two sides tied to nearby objects.  It's "
"quite comfortable to sleep in, but provides no warmth."
msgstr ""
"Una gran sábana de tela con cuerdas en dos lados atadas a objetos cercanos. "
"Es bastante cómoda para dormir, pero no proporciona calor."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Bashing failed sound
msgid "slap!"
msgstr "¡slap!"

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/items/generic/bedding.json
#. ~ Furniture name
#. ~ Item name
msgid "net hammock"
msgid_plural "net hammocks"
msgstr[0] "hamacas de red"
msgstr[1] "hamacas de red"
msgstr[2] "hamacas de red"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "net hammock"
msgid ""
"A large net with ropes on two sides tied to nearby objects.  It's quite "
"comfortable to sleep in, but provides no warmth."
msgstr ""
"Una gran red con cuerdas en dos lados atadas a objetos cercanos. Es bastante "
"cómoda para dormir, pero no proporciona calor."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "makeshift bed"
msgstr "cama improvisada"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "makeshift bed"
msgid ""
"An improvised mattress on a flimsy wooden frame.  Almost as good as a normal "
"bed, albeit with a slightly lumpy mattress.  Considering the circumstances, "
"it's not too bad at all."
msgstr ""
"Un colchón improvisado sobre una endeble estructura de madera. Casi tan bueno "
"como una cama normal, aunque con un colchón ligeramente abultado. Teniendo en "
"cuenta las circunstancias, no está nada mal."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "straw bed"
msgstr "cama de paja"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "straw bed"
msgid ""
"An improvised bedding pile made of hay.  Better than nothing, but not "
"particularly comfortable, and quite itchy."
msgstr ""
"Una pila de cama improvisada hecha de heno. Mejor que nada, pero no es "
"especialmente cómodo y pica bastante."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "bookcase"
msgstr "estantería de libros"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "bookcase"
msgid ""
"A simple wooden shelf for storing dozens of books.  While designed for books, "
"it does a decent job of storing anything else that'll fit."
msgstr ""
"Una simple estantería de madera para almacenar decenas de libros. Aunque está "
"diseñada para libros, sirve para guardar cualquier otra cosa que quepa."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "entertainment center"
msgstr "centro de entretenimiento"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "entertainment center"
msgid ""
"While not quite as cool by itself as the name might imply, this large wooden "
"cabinet can store a variety of things, like a TV and media systems, with "
"shelving space and cupboards for anything that'll fit."
msgstr ""
"Aunque no es tan genial por sí mismo como el nombre podría implicar, este "
"gran armario de madera puede almacenar una variedad de cosas, como un "
"televisor y sistemas multimedia, con espacio de estanterías y armarios para "
"cualquier cosa que quepa."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "coffin"
msgstr "ataúd"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "coffin"
msgid ""
"A humble wooden casket for the respectful burial of the dead.  While a "
"standard practice before this all happened, it is now a rare honor for one to "
"be given a proper final resting place.  An honor that countless many will "
"likely never receive."
msgstr ""
"Un humilde ataúd de madera para el respetuoso entierro de los muertos. Si "
"bien era una práctica habitual antes de que ocurriera todo esto, ahora es un "
"raro honor que uno reciba un lugar de descanso final adecuado. Un honor que "
"muchos probablemente nunca recibirán."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/furniture_and_terrain/terrain-windows.json
#: data/mods/desert_region/furniture-and-terrain/desert_terrain.json
#. ~ Bashing failed sound
#. ~ Bashing sound
msgid "wham!"
msgstr "¡catapum!"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying action message of furniture "coffin"
msgid "You wedge open the coffin."
msgstr "Abres forzando el ataúd."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying failure message of furniture "coffin"
msgid "You pry, but the coffin remains closed."
msgstr "Haces palanca, pero el ataúd permanece cerrado."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open coffin"
msgstr "ataúd abierto"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open coffin"
msgid ""
"A humble wooden casket for the respectful burial of the dead.  While a "
"standard practice before this all happened, it is now a rare honor for one to "
"be given a proper final resting place.  This one is open and unoccupied, and "
"gazing inside fills you with a sense of melancholic weariness."
msgstr ""
"Un humilde ataúd de madera para el respetuoso entierro de los muertos. Si "
"bien era una práctica habitual antes de que ocurriera todo esto, ahora es un "
"raro honor que uno reciba un lugar de descanso final adecuado. Éste está "
"abierto y desocupado, y mirar dentro te llena de una sensación de fatiga "
"melancólica."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "crate"
msgstr "caja"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "crate"
msgid ""
"A sealed wooden storage container.  Lacking any labels, it could hold just "
"about anything inside.  If you don't have a proper tool to pry it open, "
"smashing it is an option, albeit one that risks destroying the contents."
msgstr ""
"Un contenedor de madera sellado. Al carecer de etiquetas, podría contener "
"casi cualquier cosa. Si no tienes una herramienta adecuada para abrirlo, "
"romperlo es una opción, aunque se corre el riesgo de destruir el contenido."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying action message of furniture "crate"
msgid "You pop open the crate."
msgstr "Abres la caja."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying failure message of furniture "crate"
msgid "You pry, but can't pop open the crate."
msgstr "Haces palanca, pero no puedes abrir la caja."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open crate"
msgstr "caja abierta"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open crate"
msgid ""
"An open wooden storage box, capable of holding any number of things.  The lid "
"has been pried off and is leaned adjacent to it, and with a fresh set of "
"nails, could be sealed back shut."
msgstr ""
"Una caja de madera abierta, capaz de albergar cualquier cosa. La tapa ha sido "
"arrancada y está apoyada junto a ella, y con un nuevo juego de clavos, podría "
"volver a cerrarse."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers/containers.json
#. ~ Furniture name
#. ~ Item name
msgid "large cardboard box"
msgid_plural "large cardboard boxes"
msgstr[0] "caja de cartón grande"
msgstr[1] "cajas de cartón grandes"
msgstr[2] "cajas de cartón grandes"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "large cardboard box"
msgid ""
"A large box made of brown corrugated paper.  Could contain a number of "
"things, and you could even hide inside.  Considering it only has two small "
"flaps for carrying, it's very hard to see out of, and won't do anything to "
"protect you if you're found."
msgstr ""
"Una caja grande hecha de papel corrugado marrón. Podría contener varias "
"cosas, e incluso podrías esconderte dentro. Teniendo en cuenta que sólo tiene "
"dos pequeñas solapas para llevarla, es muy difícil ver fuera de ella, y no "
"hará nada para protegerte si te encuentran."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Bashing sound
msgid "crumple!"
msgstr "¡se desmoronan!"

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers/containers.json
#. ~ Furniture name
#. ~ Item name
msgid "reinforced large cardboard box"
msgid_plural "reinforced large cardboard boxes"
msgstr[0] "caja de cartón grande reforzada"
msgstr[1] "cajas de cartón grandes reforzadas"
msgstr[2] "cajas de cartón grandes reforzadas"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "reinforced large cardboard box"
msgid ""
"A large box made of brown corrugated paper that was doubled up for extra "
"strength.  Could contain a number of things, and you could even hide inside.  "
"Considering it only has two small flaps for carrying, it's very hard to see "
"out of, and won't do anything to protect you if you're found."
msgstr ""
"Una caja grande hecha de papel corrugado marrón que se dobló para darle más "
"resistencia. Podría contener varias cosas, e incluso podrías esconderte "
"dentro. Teniendo en cuenta que sólo tiene dos pequeñas solapas para su "
"transporte, es muy difícil ver fuera de ella, y no hará nada para protegerte "
"si te encuentran."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "dresser"
msgstr "cómoda"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "dresser"
msgid ""
"A simple wooden cabinet with a column of short drawers.  While intended for "
"storing clothes, there's nothing stopping you from storing whatever fits."
msgstr ""
"Un sencillo armario de madera con una columna de cajones cortos. Aunque está "
"pensado para guardar la ropa, nada te impide guardar lo que quepa."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "glass front cabinet"
msgstr "gabinete de cristal"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "glass front cabinet"
msgid ""
"A tall metal cabinet with a sheet of glass across the front for viewing the "
"contents.  Often used for displaying rare, visually pleasing, or otherwise "
"valuable goods, it's odd that it doesn't have a lock."
msgstr ""
"Un armario metálico alto con una hoja de cristal en la parte delantera para "
"ver el contenido. A menudo se utiliza para exponer bienes raros, visualmente "
"agradables o de otro tipo de valor, es extraño que no tenga cerradura."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open gun safe"
msgstr "caja fuerte de armas abierta"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open gun safe"
msgid ""
"A large, heavy container with thick metal walls, designed to securely store "
"firearms, weapon mods, and ammunition.  This one is wide open."
msgstr ""
"Un gran y pesado contenedor con gruesas paredes metálicas, diseñada para "
"guardar de manera segura armas de fuego, modificaciones de armas y munición. "
"Esta esta abierta de par en par."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_habitat.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Bashing sound
msgid "screeching metal!"
msgstr "¡chirrido de metal!"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "closed gun safe"
msgstr "caja fuerte de armas cerrada"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "closed gun safe"
msgid ""
"A large, heavy container with thick metal walls and a rotary combination "
"lock, designed to securely store firearms, weapon mods, and ammunition.  This "
"one is closed, but not locked."
msgstr ""
"Un gran y pesado contenedor con gruesas paredes metálicas, diseñada para "
"guardar de manera segura armas de fuego, modificaciones de armas y munición. "
"Esta esta cerrada, pero no con llave."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "locked gun safe"
msgstr "caja fuerte de armas cerrada con llave"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "locked gun safe"
msgid ""
"A large, heavy container with thick metal walls and a rotary combination "
"lock, designed to securely store firearms, weapon mods, and ammunition.  If "
"you had something to pick its lock with, you could probably open it."
msgstr ""
"Un contenedor grande y pesado con gruesas paredes metálicas y una cerradura "
"de combinación giratoria, diseñada para almacenar de forma segura armas de "
"fuego, modificaciones de armas y munición. Si tuvieras algo con lo que forzar "
"su cerradura, probablemente podrías abrirlo."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "locked gun safe"
msgid "With a satisfying click, the lock on the gun safe door opens."
msgstr "Con un satisfactorio click, la cerradura de la caja fuerte de armas se abre."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "jammed gun safe"
msgstr "caja fuerte trabada de armas"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "jammed gun safe"
msgid ""
"A large, heavy container with thick metal walls and a rotary combination "
"lock, designed to securely store firearms, weapon mods, and ammunition.  "
"Unfortunately, the lock is completely broken, and short of some pretty "
"serious machinery, you have no possible way of opening it."
msgstr ""
"Un contenedor grande y pesado con gruesas paredes metálicas y una cerradura "
"de combinación giratoria, diseñada para almacenar de forma segura armas de "
"fuego, modificaciones de armas y munición. Por desgracia la cerradura esta "
"rota, y aparte de con maquinaria seria, no tienes posibilidad de abrirla."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "electronic gun safe"
msgstr "caja fuerte electrónica de armas"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "electronic gun safe"
msgid ""
"A large, heavy container with thick metal walls and an electronic locking "
"system, designed to securely store firearms, weapon mods, and ammunition.  If "
"you had some way of hacking into it, you could probably crack it open."
msgstr ""
"Un contenedor grande y pesado con gruesas paredes de metal y un sistema de "
"cierre electrónico, diseñada para almacenar de forma segura armas de fuego, "
"modificaciones de armas y munición. Si tuvieras alguna forma de piratearlo, "
"probablemente podrías abrirlo."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "locker"
msgstr "armario"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "locker"
msgid ""
"A tall sheet metal cabinet, useful for storing just about anything that'll "
"fit."
msgstr "Un armario alto de chapa, útil para guardar casi cualquier cosa que quepa."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "mailbox"
msgstr "buzón"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "mailbox"
msgid ""
"A small metal box on top of a wooden post, designed to receive mail "
"deliveries.  Although considering the circumstances, it will likely never see "
"proper use again."
msgstr ""
"Una pequeña caja de metal en la parte superior de un poste de madera, "
"diseñada para recibir las entregas de correo. Aunque, dadas las "
"circunstancias, es probable que nunca vuelva a tener un uso adecuado."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "clothing rail"
msgstr "baranda para ropa"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "clothing rail"
msgid ""
"A metal frame on a set of wheels used for hanging large amounts of clothes.  "
"Usually used in theater or retail environments, it's easy to use and quick to "
"access."
msgstr ""
"Una estructura metálica sobre un conjunto de ruedas utilizado para colgar "
"grandes cantidades de ropa. Suele utilizarse en teatros o comercios, es fácil "
"de usar y de rápido acceso."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "display rack"
msgstr "expositor"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "display rack"
msgid ""
"A sheet metal shelving unit, with the storage surfaces angled in such a way "
"as to show off the items stored."
msgstr ""
"Una estantería de chapa, con las superficies de almacenamiento inclinadas de "
"forma que se vean los artículos almacenados."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "locked display rack"
msgstr "expositor cerrado"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "locked display rack"
msgid ""
"A sheet metal shelving unit, with the storage surfaces angled in such a way "
"as to show off the items stored.  Metal fasteners with a lock hold the items "
"securely to the rack."
msgstr ""
"Una estantería de chapa, con las superficies de almacenamiento inclinadas de "
"forma que se vean los artículos almacenados. Los cierres metálicos con "
"cerradura sujetan los artículos de forma segura a la estantería."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "locked display rack"
msgid "With a satisfying click, the lock opens."
msgstr "Con un satisfactorio clic, la cerradura se abre."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "wooden rack"
msgstr "El estante de madera"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "wooden rack"
msgid ""
"A wooden shelving unit with angled storage surfaces designed to show off "
"whatever is stored on it."
msgstr ""
"Una estantería de madera con superficies de almacenamiento en ángulo "
"diseñadas para mostrar lo que se almacena en ella."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "coat rack"
msgstr "perchero"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "coat rack"
msgid ""
"A tall wooden pole with a set of hooks used to store outdoor jackets and hats "
"to allow easy access."
msgstr ""
"Un poste alto de madera con un conjunto de ganchos que se utiliza para "
"guardar las chaquetas y los sombreros de exterior para facilitar el acceso."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "recycle bin"
msgstr "papelera de reciclaje"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "recycle bin"
msgid ""
"A large plastic bin painted green with a 'recycle' symbol emblazoned on it.  "
"While intended to store discarded things to be processed back into a factory, "
"the drastic change in priorities as of late means that these may hold "
"valuable materials."
msgstr ""
"Un gran contenedor de plástico pintado de verde con el símbolo de "
"\"reciclaje\". Aunque su finalidad es almacenar los desechos que se van a "
"procesar en una fábrica, el cambio drástico de prioridades de los últimos "
"tiempos significa que pueden contener materiales valiosos."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_habitat.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Furniture name
msgid "safe"
msgstr "caja fuerte"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "safe"
msgid ""
"A small, heavy, and near-unbreachable metal box with a rotary combination "
"lock.  This one isn't actually locked, just closed."
msgstr ""
"Una caja metálica pequeña, pesada y casi infranqueable con una cerradura de "
"combinación giratoria. Aunque, en realidad, esta no está bloqueada, sólo "
"cerrada."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "safe"
msgid ""
"A small, heavy, and near-unbreachable metal box with a rotary combination "
"lock.  With something to listen really closely and a hell of a lot of time, "
"you might be able to crack it."
msgstr ""
"Una caja metálica pequeña, pesada y casi infranqueable con una cerradura de "
"combinación giratoria. Con algo para escuchar muy de cerca y un montón de "
"tiempo, podrías ser capaz de descifrarla."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_habitat.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Furniture name
msgid "open safe"
msgstr "caja fuerte abierta"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open safe"
msgid ""
"A small, heavy, and near-unbreachable metal box with a rotary combination "
"lock, albeit significantly less secure with the door open."
msgstr ""
"Una caja metálica pequeña, pesada y casi infranqueable con una cerradura de "
"combinación giratoria, aunque bastante menos segura con la puerta abierta."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "trash can"
msgid_plural "trash cans"
msgstr[0] "cubo para basura"
msgstr[1] "cubos para basura"
msgstr[2] "cubos para basura"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "trash can"
msgid ""
"A plastic bin for storing discarded waste as to be disposed of later.  "
"Although, considering the circumstances, it might be worth seeing what's "
"inside."
msgstr ""
"Un contenedor de plástico para almacenar los residuos que se desechan "
"después. Aunque, teniendo en cuenta las circunstancias, podría valer la pena "
"ver lo que hay dentro."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "metal trash can"
msgstr "cubo de basura de metal"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "metal trash can"
msgid "A crude metal bin typically used to dispose of waste."
msgstr "Un contenedor metálico tosco que suele utilizarse para eliminar los residuos."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "wardrobe"
msgstr "armario"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "wardrobe"
msgid ""
"A very large wooden cabinet for storing clothes, effectively an upright "
"closet.  Could technically be used to store anything else that would fit, "
"though."
msgstr ""
"Un armario de madera muy grande para guardar la ropa, efectivamente un "
"armario vertical. Aunque técnicamente podría utilizarse para guardar "
"cualquier otra cosa que cupiera."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "Torah Ark"
msgstr "Arca Torah"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "Torah Ark"
msgid ""
"An ornately-carved cabinet designed to hold a Torah scroll.  This one is "
"decorated with a tree motif, referencing Proverbs 3:18."
msgstr ""
"Mueble decorado para guardar un rollo de la Torá. Este está decorado con un "
"árbol, en referencia a Proverbios 3:18."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "filing cabinet"
msgstr "fichero"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "filing cabinet"
msgid ""
"A rack of metal drawers designed to hold various files and paperwork.  "
"Paperwork that has more than likely lost all relevance and value by now."
msgstr ""
"Una estantería de cajones metálicos diseñada para guardar varios archivos y "
"papeleo. Papeleo que probablemente ya haya perdido toda su relevancia y valor."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "utility shelf"
msgstr "estante de utilería"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "utility shelf"
msgid ""
"A simple heavy-duty plastic and metal shelving unit, intended to store tools "
"and materials for easy access to workers."
msgstr ""
"Una sencilla estantería de plástico y metal de alta resistencia, destinada a "
"almacenar herramientas y materiales para facilitar el acceso de los "
"trabajadores."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "warehouse shelf"
msgstr "estantería del almacén"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "warehouse shelf"
msgid "A huge, sturdy steel shelf for storing pallets of crates in warehouses."
msgstr ""
"Una enorme y robusta estantería de acero para almacenar palets de cajas en "
"los almacenes."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "wooden keg"
msgstr "barril de madera"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "wooden keg"
msgid ""
"A large standing wooden barrel, completely watertight.  Good for storing "
"liquids of all kinds."
msgstr ""
"Un gran barril de madera de pie, completamente hermético. Sirve para "
"almacenar líquidos de todo tipo."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "display case"
msgstr "vitrina"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "display case"
msgid ""
"A secure wooden case at about waist-height, with glass paneling on top.  "
"Useful for storing valuable things while still showing them off.  Not "
"actually as secure as it looks, as the display windows are easily broken."
msgstr ""
"Una caja de madera segura a la altura de la cintura, con paneles de cristal "
"en la parte superior. Resulta útil para guardar objetos de valor sin dejar de "
"mostrarlos. En realidad no es tan segura como parece, ya que los cristales se "
"rompen con facilidad."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "display case"
msgid "With a satisfying click, the lock and the display case opens."
msgstr "Con un satisfactorio clic, la cerradura y la vitrina se abren."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open display case"
msgstr "expositor abierto"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open display case"
msgid ""
"A secure wooden case at about waist-height, with glass paneling on top.  "
"Useful for storing valuable things while still showing them off.  Not "
"actually as secure as it looks, as the display windows are easily broken.  "
"This one has had its lock picked and is open."
msgstr ""
"Una caja de madera segura a la altura de la cintura, con paneles de cristal "
"en la parte superior. Resulta útil para guardar objetos de valor sin dejar de "
"mostrarlos. En realidad no es tan segura como parece, ya que los cristales se "
"rompen con facilidad. A éste le han forzado la cerradura y está abierto."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_habitat.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Furniture name
msgid "broken display case"
msgstr "vitrina rota"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "broken display case"
msgid ""
"A secure wooden case at about waist-height, with glass paneling on top.  "
"Would be useful for storing valuable things while still showing them off, if "
"the glass hadn't been shattered.  Careful not to cut yourself when looting."
msgstr ""
"Una caja de madera segura a la altura de la cintura, con paneles de cristal "
"en la parte superior. Sería útil para guardar cosas valiosas y a la vez "
"mostrarlas, si no se hubiera roto el cristal. Ten cuidado de no cortarte al "
"saquear."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "map board"
msgstr "tablero de mapa"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "map board"
msgid "A secure metal board with a locked glass panel used to display a map."
msgstr ""
"Un tablero metálico seguro con un panel de cristal cerrado que se utiliza "
"para mostrar un mapa."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "map board"
msgid "With a satisfying click, the locked glass panel opens."
msgstr "Con un clic satisfactorio, el panel de cristal cerrado se abre."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open map board"
msgstr "tablero de mapa abierto"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open map board"
msgid ""
"A successfully picked metal board with an open glass panel used to display a "
"map."
msgstr ""
"Un tablero metálico con un panel de cristal abierto utilizado para mostrar un "
"mapa."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "broken map board"
msgstr "tablero de mapa roto"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "broken map board"
msgid "A metal board with a smashed glass panel used to display a map."
msgstr ""
"Un tablero metálico con un panel de cristal roto utilizado para mostrar un "
"mapa."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "fireman's cabinet"
msgstr "armario de bombero"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "fireman's cabinet"
msgid ""
"A metallic cabinet painted to stand out, visibly holding tools behind a thin "
"panel of tempered glass."
msgstr ""
"Un armario metálico pintado para destacar, que guarda visiblemente las "
"herramientas tras un fino panel de cristal templado."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "fireman's cabinet"
msgid "With a satisfying click, the lock on the cabinet opens."
msgstr "Con un satisfactorio clic, se abre la cerradura del armario."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "unlocked fireman's cabinet"
msgstr "armario de bombero sin cerrar"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "unlocked fireman's cabinet"
msgid ""
"A metallic cabinet painted to stand out.  Its glass panel door was left "
"unlocked and slightly ajar."
msgstr ""
"Un armario metálico pintado para destacar. Su puerta de panel de cristal se "
"dejó sin cerrar y ligeramente entreabierta."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open fireman's cabinet"
msgstr "armario de bombero abierto"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open fireman's cabinet"
msgid ""
"A metallic cabinet painted to stand out.  Its protective glass panel lies "
"broken from some past emergency or looting attempt."
msgstr ""
"Un armario metálico pintado para destacar. Su panel de cristal protector yace "
"roto por alguna emergencia o intento de saqueo del pasado."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "standing tank"
msgstr "depósito horizontal"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "standing tank"
msgid "A huge metal tank that can be used to safely store large amounts of liquid."
msgstr ""
"Un enorme depósito de metal que puede utilizarse para almacenar de forma "
"segura grandes cantidades de líquido."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "bulk storage tank"
msgstr "depósito de almacenamiento a granel"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "bulk storage tank"
msgid ""
"A 2 meters high tank that can store up to 1500 liters of liquid.  That's a "
"lot."
msgstr ""
"Un depósito de 2 metros de altura que puede almacenar hasta 1500 litros de "
"líquido. Eso es mucho."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "fuel tank"
msgstr "depósito de gasolina"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "fuel tank"
msgid "A tank filled with gasoline."
msgstr "Un depósito lleno de gasolina."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "broken fuel tank"
msgstr "depósito de combustible roto"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "broken fuel tank"
msgid "A broken tank which was filled with gasoline."
msgstr "Un depósito roto que estaba lleno de gasolina."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "fuel tank"
msgid "A tank filled with diesel."
msgstr "Un depósito lleno de diesel."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "broken fuel tank"
msgid "A broken tank which was filled with diesel."
msgstr "Un depósito roto que estaba lleno de diesel."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "dumpster"
msgstr "contenedor"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "dumpster"
msgid ""
"A large metal dumpster that will likely not be getting picked up by the "
"city's waste management any time soon.  Despite the unpleasant nature of "
"climbing inside, it could make for a viable hiding spot."
msgstr ""
"Un gran contenedor de metal que probablemente no será recogido por la "
"administración de residuos de la ciudad en un futuro próximo. A pesar de lo "
"desagradable que resulta trepar por su interior, podría ser un buen escondite."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "butter churn"
msgstr "mantequera"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "butter churn"
msgid ""
"A metal tube with a built-in mixer for making butter.  Rather than needing "
"electricity, it is pedal-driven, allowing use without power."
msgstr ""
"Un tubo de metal con un mezclador incorporado para hacer mantequilla. En "
"lugar de necesitar electricidad, se acciona con un pedal, lo que permite su "
"uso sin energía."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "riveted metal crate"
msgstr "caja metálica remachada"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "riveted metal crate"
msgid ""
"This huge box is made of a dull metal, riveted together.  There is no obvious "
"opening mechanism, and the rivets don't match any of your tools.  The only "
"way in would be to smash it."
msgstr ""
"Esta enorme caja está hecha de un metal opaco, remachado. No hay ningún "
"mecanismo de apertura evidente, y los remaches no coinciden con ninguna de "
"sus herramientas. La única forma de entrar sería rompiéndola."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "sealed metal crate"
msgstr "caja metálica sellada"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "sealed metal crate"
msgid ""
"A huge, tightly sealed storage crate made from welded and riveted sheet "
"metal.  The sealing mechanism is too tight to open bare-handed and would need "
"some kind of prying instrument to release."
msgstr ""
"Una enorme caja de almacenamiento herméticamente cerrada, fabricada con "
"chapas soldadas y remachadas. El mecanismo de sellado es demasiado hermético "
"para abrirlo con las manos y se necesitaría algún tipo de instrumento de "
"palanca para liberarlo."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying action message of furniture "sealed metal crate"
msgid "You wrench open the metal crate."
msgstr "Abres con una llave la caja de metal."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying failure message of furniture "sealed metal crate"
msgid "The lid is sealed more tightly than you thought."
msgstr "La tapa está más sellada de lo que pensabas."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open metal crate"
msgstr "caja metálica abierta"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open metal crate"
msgid ""
"This large metal crate's lid is unsealed, and hinges open easily to reveal a "
"number of storage shelves inside.  Once open, the side panels also swing "
"wider for easy access."
msgstr ""
"La tapa de este gran cajón metálico no está sellada y se abre fácilmente con "
"bisagras para revelar una serie de estantes de almacenamiento en el interior. "
"Una vez abierta, los paneles laterales también se abren para facilitar el "
"acceso."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "wooden chest"
msgstr "cofre de madera"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "wooden chest"
msgid ""
"A sealed wooden storage container.  Lacking any labels, it could hold just "
"about anything inside.  It has a simple metal latch."
msgstr ""
"Un contenedor de madera sellado. Sin etiquetas, podría contener casi "
"cualquier cosa en su interior. Tiene un simple cierre de metal."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/furniture/storage.json
#. ~ Furniture name
#. ~ Item name
msgid "steel foot locker"
msgid_plural "steel foot lockers"
msgstr[0] "arcón de acero"
msgstr[1] "arcones de acero"
msgstr[2] "arcones de acero"

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/furniture/storage.json
#. ~ Description of furniture "steel foot locker"
#. ~ Description of "steel foot locker"
msgid ""
"A steel storage box, capable of holding any number of things.  The lid has a "
"small lock."
msgstr ""
"Una caja de acero de almacenamiento, capaz de contener cualquier cosa. La "
"tapa tiene una pequeña cerradura."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/furniture/storage.json
#. ~ Furniture name
#. ~ Item name
msgid "aluminum foot locker"
msgid_plural "aluminum foot lockers"
msgstr[0] "arcón de aluminio"
msgstr[1] "arcones de aluminio"
msgstr[2] "arcones de aluminio"

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/furniture/storage.json
#. ~ Description of furniture "aluminum foot locker"
#. ~ Description of "aluminum foot locker"
msgid ""
"An aluminum storage box, capable of holding any number of things.  The lid "
"has a small lock."
msgstr ""
"Una caja de aluminio de almacenamiento, capaz de contener cualquier cosa. La "
"tapa tiene una pequeña cerradura."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers/military.json
#. ~ Furniture name
#. ~ Item name
msgid "big collapsible drum"
msgid_plural "big collapsible drums"
msgstr[0] "bidón grande plegable"
msgstr[1] "bidones grandes plegables"
msgstr[2] "bidones grandes plegables"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "big collapsible drum"
msgid ""
"A black collapsible drum with a valve and D-Rings.  Yellow text on its top "
"clearly says \"FLAMMABLE\"."
msgstr ""
"Un bidón negro plegable con válvula y anillas en D. El texto amarillo de su "
"parte superior dice claramente \"INFLAMABLE\"."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "packed pallet"
msgstr "palet embalado"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "packed pallet"
msgid ""
"A wooden pallet loaded with cargo, wrapped with a watertight cover, and "
"belted to secure the contents."
msgstr ""
"Un palet de madera cargado con mercancía, envuelto con una cubierta estanca y "
"sujeto con un cinturón para asegurar el contenido."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Bashing sound
msgid "rip!"
msgstr "¡sak!"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "damaged pallet"
msgstr "palet dañado"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "damaged pallet"
msgid ""
"A wooden pallet, containing cargo and possessing a torn cover.  You can reach "
"the contents, but it's awfully hard due to the belts still being in place."
msgstr ""
"Un palet de madera, que contiene mercancia y posee una cubierta dañada. "
"Puedes alcanzar el contenido, pero es muy difícil debido a que las correas "
"siguen en su sitio."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/tool/workshop.json
#. ~ Furniture name
#. ~ Item name
msgid "Exodii kiln"
msgid_plural "Exodii kilns"
msgstr[0] "horno Exodii"
msgstr[1] "hornos Exodii"
msgstr[2] "hornos Exodii"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "Exodii kiln"
msgid "An imposing kiln produced by the Exodii, used to produce their ceramic armor"
msgstr ""
"Un imponente horno fabricado por los Exodii, utilizado para producir sus "
"armaduras cerámicas."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "counter"
msgstr "mostrador"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "counter"
msgid ""
"A plain wooden countertop, either free-standing or affixed to a wall.  Makes "
"a decent surface for storage or crafting."
msgstr ""
"Un mostrador de madera liso, independiente o fijado a la pared. Una "
"superficie decente para guardar cosas o fabricar."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "cupboard"
msgstr "alacena"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "cupboard"
msgid "Store your cups.  Or other things, if you're feeling wild."
msgstr "Para guardar tus vasos. O cualquier otra cosa, si te sientes salvaje."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "closed counter gate"
msgstr "puerta del mostrador cerrada"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "closed counter gate"
msgid ""
"A commercial-quality swinging door made of wood that allows passage behind "
"counters.  It's currently closed."
msgstr ""
"Una puerta giratoria de calidad comercial hecha de madera que permite el paso "
"detrás de los mostradores. Ahora esta cerrada."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "open counter gate"
msgstr "abrir la puerta del mostrador"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "open counter gate"
msgid ""
"A commercial-quality swinging door made of wood that allows passage behind "
"counters.  It's open, allowing passage."
msgstr ""
"Una puerta giratoria de calidad comercial hecha de madera que permite el paso "
"detrás de los mostradores. Esta abierta, permitiendo el paso."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "desk"
msgstr "escritorio"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "desk"
msgid ""
"A wooden desk with drawers.  You could decorate it with trinkets, eat a meal "
"off it, use it as a workbench, read a book, write in a journal, put a laptop "
"on it, put your feet up, rest your head for a nap if you're sitting down… who "
"knew desks were so useful?"
msgstr ""
"Un escritorio de madera con cajones. Podrías decorarlo con cacharros, comer "
"en el, usarlo como mesa de trabajo, leer un libro, escribir un diario, poner "
"un portátil, poner tus pies en alto, echar una siestas con tu cabeza encima "
"si estas sentado... ¿quien iba a decir que los escritorios eran tan útiles?"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/vehicleparts/vehicle_parts.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "workbench"
msgstr "mesa de trabajo"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "workbench"
msgid ""
"A sturdy workbench built out of metal.  It is perfect for crafting large and "
"heavy things."
msgstr ""
"Una robusta mesa de trabajo construido de metal. Es perfecta para hacer cosas "
"grandes y pesadas."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "leather tarp"
msgid_plural "leather tarps"
msgstr[0] "lona de cuero"
msgstr[1] "lonas de cuero"
msgstr[2] "lonas de cuero"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "leather tarp"
msgid ""
"A large sheet of leather lying on the ground.  You could use it as a picnic "
"blanket, but it's more valuable as a surface for butchering as it does not "
"soak up blood."
msgstr ""
"Una gran hoja de cuero tirada en el suelo. Puedes usarla como manta de "
"picnic, pero es más valiosa como superficie de carnicería, ya que no se "
"empapa de sangre."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "plastic groundsheet"
msgstr "hoja de tierra de plástico"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "plastic groundsheet"
msgid ""
"A large sheet of thick plastic lying on the ground.  It could be a useful "
"surface for butchering, perhaps."
msgstr ""
"Una gran lámina de plástico grueso tirada en el suelo. Puede servir para "
"descuartizar, tal vez."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Bashing sound
msgid "whuff!"
msgstr "¡whuff!"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Bashing failed sound
msgid "crinkle."
msgstr "arruga."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "fiber mat"
msgid_plural "fiber mats"
msgstr[0] "alfombra de fibra"
msgstr[1] "alfombras de fibra"
msgstr[2] "alfombras de fibra"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "fiber mat"
msgid ""
"A large mat woven from fibrous material.  You could use it as a picnic "
"blanket, but it's more valuable as a surface for butchering.  Too thin to be "
"used as a comfortable sleeping mat."
msgstr ""
"Una gran esterilla tejida con material fibroso. Podría usarse como manta de "
"picnic, pero es más valiosa como superficie para descuartizar. Demasiado fina "
"para utilizarla como una cómoda esterilla para dormir."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "folding table"
msgid_plural "folding tables"
msgstr[0] "mesa plegable"
msgstr[1] "mesas plegables"
msgstr[2] "mesas plegables"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "folding table"
msgid ""
"A small metal folding table, ideal for off-road trips.  Can be used as a "
"workbench in a pinch."
msgstr ""
"Una pequeña mesa plegable de metal, ideal para viajes fuera de la carretera "
"en la naturaleza. Puede ser usada como mesa de trabajo en caso de necesidad."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/vehicleparts/vehicle_parts.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "table"
msgstr "mesa"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "table"
msgid ""
"A standard wooden table.  You could sit down at it to eat like a civilized "
"person."
msgstr ""
"Una mesa de madera estándar. Podrías sentarte a comer como una persona "
"civilizada."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/vehicle/tables.json
#. ~ Furniture name
#. ~ Item name
msgid "fancy table"
msgid_plural "fancy tables"
msgstr[0] "mesa elegante"
msgstr[1] "mesas elegantes"
msgstr[2] "mesas elegantes"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "fancy table"
msgid ""
"A fancy table for a fancy person.  Functions as both a table and status "
"symbol."
msgstr ""
"Una mesa elegante para una persona elegante. Sirve tanto de mesa como de "
"símbolo de estatus."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "coffee table"
msgstr "mesa de café"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "coffee table"
msgid ""
"A low table usually found in living rooms, it makes an ideal surface for "
"playing games, showing off some tasteful books, or presumably for putting "
"coffee cups on.  No one cares if you use a coaster anymore."
msgstr ""
"Una mesa baja que suele encontrarse en los salones y que constituye una "
"superficie ideal para jugar, mostrar algunos libros de buen gusto o, "
"presumiblemente, para colocar tazas de café. A nadie le importa ahora que no "
"uses posavasos."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Furniture name
msgid "metal table"
msgstr "mesa de metal"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "metal table"
msgid "A serviceable but simple table made of scrap metal."
msgstr "Una mesa útil pero sencilla hecha de restos de metal.."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "tatami mat"
msgstr "tatami"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "tatami mat"
msgid "A type of mat used as a flooring material in traditional Japanese-style rooms."
msgstr ""
"Un tipo de estera utilizada como material de suelo en las habitaciones "
"tradicionales de estilo japonés."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "pillow fort"
msgstr "fortaleza de la almohada"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "pillow fort"
msgid "A comfy place to hide from the world.  Not very defensible, though."
msgstr "Un lugar cómodo para esconderse del mundo. Aunque no es muy defendible."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Bashing sound
msgid "paf!"
msgstr "¡paf!"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "cardboard fort"
msgstr "fuerte de cartón"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "cardboard fort"
msgid ""
"A fort built by tipping a cardboard box on its side, lining it with blankets, "
"and partly weather-sealing it with a plastic sheet."
msgstr ""
"Un fuerte construido volcando una caja de cartón, forrándola con mantas y "
"sellándola parcialmente contra la intemperie con una lámina de plástico."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "cardboard wall"
msgstr "muro/pared de cartón"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "cardboard wall"
msgid ""
"A pile of cardboard boxes that have been filled with rags and junk and "
"stacked together like bricks to form a wall."
msgstr ""
"Un montón de cajas de cartón llenas de trapos y chatarra apiladas como "
"ladrillos para formar un muro/pared."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "cardboard floor"
msgstr "piso de cartón"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "cardboard floor"
msgid ""
"A flat floor made of sheets of cardboard duct-taped together, covering a "
"plastic sheet on the ground."
msgstr ""
"Un suelo plano hecho de láminas de cartón unidas con cinta adhesiva, que "
"cubren una lámina de plástico en el suelo."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "cardboard roof"
msgstr "techo/tejado de cartón"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "cardboard roof"
msgid ""
"A sloped roof made of cardboard boxes, stuffed with scrap cardboard and paper "
"and layered atop each other.  Sheets of plastic are carefully arranged on top "
"to shed water.  It looks like it could last a season or two at least before "
"crumbling."
msgstr ""
"Un techo/tejado inclinado hecho de cajas de cartón, rellenas de restos de "
"cartón y papel y superpuestas unas encima de otras. Encima hay láminas de "
"plástico cuidadosamente colocadas para que el agua se escurra. Parece que "
"podría durar una o dos temporadas antes de desmoronarse."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "cardboard door"
msgstr "puerta de cartón"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "cardboard door"
msgid ""
"A pile of cardboard boxes that have been filled with rags and junk and "
"stacked together like bricks to form a wall.  The largest box has been cut "
"open and folded to form a makeshift door, which is open."
msgstr ""
"Un montón de cajas de cartón llenas de trapos y chatarra, apiladas como "
"ladrillos para formar un muro/pared. La caja más grande ha sido cortada y "
"doblada para formar una puerta improvisada, que está abierta."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "cardboard door"
msgid ""
"A pile of cardboard boxes that have been filled with rags and junk and "
"stacked together like bricks to form a wall.  The largest box has been cut "
"open and folded to form a makeshift door, which is closed."
msgstr ""
"Un montón de cajas de cartón llenas de trapos y chatarra, apiladas como "
"ladrillos para formar un muro/pared. La caja más grande se ha abierto y "
"doblado para formar una puerta improvisada, que está cerrada."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "beaded curtain"
msgstr "cortina de cuentas"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "beaded curtain"
msgid ""
"A curtain of wooden beads, thick enough that you can't see through them.  "
"They could be pulled aside effortlessly."
msgstr ""
"Una cortina de cuentas de madera, lo bastante gruesas como para que no se "
"pueda ver a través de ellas. Se podían apartar sin esfuerzo."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Bashing sound
msgid "clickity clack… clack… clack"
msgstr "clickity clack… clack… clack"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Bashing failed sound
msgid "clickity clack… clack"
msgstr "clickity clack… clack"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "open beaded curtain"
msgstr "cortina de cuentas abierta"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "open beaded curtain"
msgid "A curtain of wooden beads that has been pulled aside."
msgstr "Una cortina de cuentas de madera que se ha hecho a un lado."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Bashing sound
msgid "clickity clack… clack… clack!"
msgstr "¡clickity clack… clack… clack!"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "canvas floor"
msgstr "piso de tela"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "canvas floor"
msgid ""
"Flooring made out of stretched, waterproof cloth.  Helps keep dirt out of the "
"tent."
msgstr ""
"Suelos hechos de tela estirada e impermeable. Ayuda a mantener la suciedad "
"fuera de la tienda."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "canvas wall"
msgstr "muro de tela"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "canvas wall"
msgid "A tent wall made of stretched, waterproof cloth."
msgstr "Una pared de tienda hecha de tela estirada e impermeable."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "canvas wall"
msgid "A tent wall made of stretched, heavy-duty, waterproof cloth."
msgstr "Una pared de tienda hecha de tela tensada, resistente e impermeable."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "large skin wall"
msgstr "muro/pared de piel grande"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "large skin wall"
msgid ""
"A large tent wall made out of stretched animal skin.  It'll keep the rain "
"out, but anything trying to get in could rip through it fairly easily."
msgstr ""
"Una gran pared de tienda hecha de piel de animal estirada. Mantendrá la "
"lluvia fuera, pero cualquier cosa que intente entrar podría rasgarla con "
"bastante facilidad."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "large skin groundsheet"
msgstr "lona de piel grande"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "large skin groundsheet"
msgid "A large animal-skin groundsheet to keep your feet dry inside the shelter."
msgstr ""
"Una sábana grande de piel de animal para mantener los pies secos dentro del "
"refugio."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "large animalskin flap"
msgstr "solapa grande de piel de animal"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "large animalskin flap"
msgid "A large animal-skin flap that can be pulled aside."
msgstr "Una gran solapa de piel de animal que se puede apartar."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "open animalskin flap"
msgstr "solapa abierta de piel de animal"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "open animalskin flap"
msgid "A large animal-skin flap that has been pulled aside."
msgstr "Una gran solapa de piel de animal que ha sido apartada."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "canvas flap"
msgstr "solapa de tela"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "canvas flap"
msgid "A canvas flap door that can be pulled aside."
msgstr "Una solapa de lona que se puede apartar."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "open canvas flap"
msgstr "solapa abierta de tela"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "open canvas flap"
msgid "A canvas flap door that has been pulled aside."
msgstr "Una solapa de lona que ha sido apartada."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "canvas flap"
msgid "A heavy canvas flap door that can be pulled aside."
msgstr "Una pesada solapa de lona que puede ser apartada."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "open canvas flap"
msgid "A heavy canvas flap door that has been pulled aside."
msgstr "Una pesada solapa de lona que ha sido apartada."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "groundsheet"
msgstr "lona impermeable"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "groundsheet"
msgid "A plastic groundsheet to keep your feet dry inside the tent."
msgstr ""
"Una lámina de suelo de plástico para mantener tus pies secos dentro de la "
"tienda."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "groundsheet"
msgid "A large plastic groundsheet to keep your feet dry inside the tent."
msgstr ""
"Un gran lámina de suelo de plástico para mantener tus pies secos dentro de la "
"tienda."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "groundsheet"
msgid ""
"A government-issue plastic groundsheet to keep your feet dry, it was clearly "
"made by the lowest bidder."
msgstr ""
"Una lamina de suelo de plástico distribuida por el gobierno para mantener los "
"pies secos, claramente fabricada por el menor precio posible."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "animalskin wall"
msgstr "muro de piel de animal"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "animalskin wall"
msgid ""
"A tent wall made out of stretched animal skin.  It'll keep the rain out, but "
"anything trying to get in could rip through it fairly easily."
msgstr ""
"Una pared de tienda hecha de piel de animal estirada. Mantendrá la lluvia "
"fuera, pero cualquier cosa que intente entrar podría romperla fácilmente."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "animalskin flap"
msgstr "solapa de piel de animal"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "animalskin flap"
msgid "An animal-skin flap that can be pulled aside."
msgstr "Una solapa de piel de animal que puede ser apartada."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "open animalskin flap"
msgid "An animal-skin flap that has been pulled aside."
msgstr "Una solapa de piel de animal que ha sido apartado."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "animalskin floor"
msgstr "piso de piel de animal"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "animalskin floor"
msgid "An animal-skin groundsheet to keep your feet dry inside the shelter."
msgstr ""
"Una lámina de suelo de piel animal para mantener tus pies secos dentro del "
"refugio."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "pile of rubble"
msgstr "pila de escombros"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "pile of rubble"
msgid ""
"A pile of various metals, bricks, and other building materials.  You could "
"clear it with a shovel."
msgstr ""
"Un montículo de varios metales, ladrillos y otros materiales de construcción. "
"Podrías limpiarlo con una pala."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "pile of rocky rubble"
msgstr "pila de escombros de piedra"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "pile of rocky rubble"
msgid "A loose pile of rocks.  Useless?"
msgstr "Un montículo mezclado de piedras. ¿Sin valor?"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "pile of trashy rubble"
msgstr "pila de escombros de basura"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "pile of trashy rubble"
msgid ""
"A pile of trash topped with dirt and grass.  It smells gross, but one man's "
"trash…"
msgstr ""
"Un montículo de basura coronado con suciedad y hierba. Huele fatal, pero la "
"basura de un hombre..."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "metal wreckage"
msgstr "restos de metal"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "metal wreckage"
#. ~ Description of furniture "metal wreckage from a plane"
msgid ""
"A pile of various bent and twisted metals.  Some of it looks pretty rusty, "
"you wouldn't want to cut yourself on this."
msgstr ""
"Un montículo de varios metales doblados y torcidos. Algunos parecen bastante "
"oxidados, no querrías cortarte con esto."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "metal wreckage from a plane"
msgstr "restos metálicos de avión"

#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_spaceship_machinery.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_spaceship_machinery.json
#. ~ Furniture name
msgid "radioactive slag"
msgstr "desecho radioactivo"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "radioactive slag"
msgid ""
"A pile of melted slag from a destroyed nuclear reactor.  What are you doing "
"looking at it?  Get the hell out of here, you nutcase!"
msgstr ""
"Un montón de escoria fundida de un reactor nuclear destruido. ¿Qué haces "
"mirándolo? ¡Lárgate de aquí, demente!"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "pile of ash"
msgstr "pila de ceniza"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "pile of ash"
msgid "A pile of ash, from wood or possibly corpses."
msgstr "Un montículo de ceniza, de madera o de cadáveres."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "small boulder"
msgstr "roca pequeña"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "small boulder"
msgid ""
"A big rock.  Should be easy to roll around, but too heavy to carry with you.  "
"It can be used as a primitive anvil, or broken into a bunch of smaller rocks."
msgstr ""
"Una gran roca. Debería ser fácil hacerla rodar, pero demasiado pesada para "
"llevarla contigo. Puede ser usada como un yunque primitivo, o rota en rocas "
"mas pequeñas."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "medium boulder"
msgstr "roca mediana"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "medium boulder"
msgid ""
"A pretty big boulder, but still small enough to see and climb over.  It would "
"be a struggle to move it.  It can be used as a primitive anvil, or broken "
"into a bunch of smaller rocks."
msgstr ""
"Un peñasco bastante grande, pero lo bastante pequeño como para ver y trepar "
"por él. Sería difícil moverlo. Puede usarse como yunque primitivo o partirse "
"en un montón de rocas más pequeñas."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "large boulder"
msgstr "roca grande"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "large boulder"
msgid "A boulder that's taller than you.  Now how are you going to move this?"
msgstr "Una roca que es más alta que tú.  ¿Cómo vas a mover esto?"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "street light"
msgstr "luz de la calle"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "street light"
msgid ""
"A raised light source which used to illuminate streets and their surrounding "
"area, but it's useless without electricity."
msgstr ""
"Una fuente de luz elevada que solía iluminar las calles y sus alrededores, "
"pero es inútil sin electricidad."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "traffic light"
msgstr "luz de tráfico"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "traffic light"
msgid ""
"A signaling device positioned at road intersections and pedestrian crossings "
"to control the flow of traffic, but it's useless without electricity."
msgstr ""
"Un dispositivo de señalización ubicado en las intersecciones de carreteras y "
"cruces peatonales para controlar los flujos de tráfico, inútil sin "
"electricidad."

#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/items/vehicle/cargo.json data/json/vehicleparts/cargo.json
#. ~ Furniture name
#. ~ Item name
#. ~ Vehicle part name
msgid "bike rack"
msgid_plural "bike racks"
msgstr[0] "portabicicleta"
msgstr[1] "portabicicletas"
msgstr[2] "portabicicletas"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "bike rack"
msgid "A loop of metal in the shape of an upside down U used to securely park bikes."
msgstr ""
"Un bucle de metal en forma de U invertida que se utiliza para aparcar "
"bicicletas de forma segura."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "flagpole"
msgstr "mástil"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "flagpole"
msgid "A 6-meter tall metal flagpole.  You could hoist up a flag here."
msgstr "Un mástil de metal de 6 metros de altura. Podrías izar una bandera con esto."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "flagpole"
msgid "A 5-meter tall wooden flagpole.  You could hoist up a flag here."
msgstr "Un mástil de madera de 5 metros de altura. Podrías izar una bandera con esto."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "utility pole"
msgstr "poste de utilidades"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "utility pole"
msgid ""
"A long wooden post which used to support overhead power lines and other "
"public utilities, but it doesn't work anymore."
msgstr ""
"Un largo poste de madera que solía soportar las líneas eléctricas aéreas y "
"otros servicios públicos, pero ya no funciona."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "scrap metal bridge"
msgstr "puente de restos de metal"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "scrap metal bridge"
msgid "A simple bridge made of riveted sheet metal."
msgstr "Un simple puente de chapas remachadas."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "room divider"
msgstr "divisor de habitación"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "room divider"
msgid "A tall piece of furniture used to divide rooms into separate areas."
msgstr "Un pieza alta de mueble usado para dividir habitaciones en áreas separadas."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "short mound of dirt"
msgstr "pequeño montículo de tierra"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "short mound of dirt"
msgid ""
"An area of heaped dirt, not easily traversable.  If examined more closely, "
"it's quite favorable for planting seeds and the like."
msgstr ""
"Un área de suciedad amontonada, no fácilmente transitable. Si se examina más "
"de cerca, es bastante propicia para plantar semillas y similares."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "short mound of dirt with seed"
msgstr "pequeño montículo de tierra con semilla"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "short mound of dirt with seed"
msgid ""
"An area of heaped dirt, not easily traversable.  Someone has planted a seed "
"here."
msgstr ""
"Una zona de tierra amontonada, difícilmente transitable. Alguien ha plantado "
"una semilla aquí."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "short mound of dirt with seedling"
msgstr "pequeño montículo de tierra con planta de semillero"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "short mound of dirt with seedling"
msgid ""
"An area of heaped dirt, not easily traversable.  There is a seed here, that "
"has just begun to sprout its first roots."
msgstr ""
"Una zona de tierra amontonada, difícilmente transitable. Aquí hay una semilla "
"que acaba de echar sus primeras raíces."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "short mound of dirt with mature plant"
msgstr "montículo pequeño de tierra con planta madura"

#: data/json/furniture_and_terrain/furniture-terrains.json
