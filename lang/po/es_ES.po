#: data/json/items/tool/stationery.json data/mods/innawood/items/misc.json
#. ~ Item name
msgid "leather journal"
msgid_plural "leather journals"
msgstr[0] "diario de cuero"
msgstr[1] "diarios de cuero"
msgstr[2] "diarios de cuero"

#: data/json/items/tool/stationery.json
#. ~ Description of "leather journal"
msgid ""
"A leather-back journal for preserving notes and maps, has a strap to keep "
"loose pages contained."
msgstr ""
"Un diario con lomo de cuero para conservar notas y mapas, tiene una correa "
"para mantener las páginas sueltas contenidas."

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "bone billet"
msgid_plural "bone billets"
msgstr[0] "varilla de hueso"
msgstr[1] "varillas de hueso"
msgstr[2] "varillas de hueso"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "bone billet"
msgid "A thick, short bone, usually used in flintknapping for soft-hammer percussion."
msgstr ""
"Un hueso grueso y corto, generalmente utilizado en la talla lítica del "
"pedernal para la percusión con martillo blando."

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "wooden billet"
msgid_plural "wooden billets"
msgstr[0] "varilla de madera"
msgstr[1] "varillas de madera"
msgstr[2] "varillas de madera"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "wooden billet"
msgid ""
"A thick, short wooden stick, usually used in flintknapping for soft-hammer "
"percussion."
msgstr ""
"Un palo de madera grueso y corto, generalmente utilizado en la talla lítica "
"de pedernal para la percusión con martillo blando."

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "primitive rock drill"
msgid_plural "primitive rock drills"
msgstr[0] "taladro de rocas primitivas"
msgstr[1] "taladros de rocas primitivas"
msgstr[2] "taladros de rocas primitivas"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "primitive rock drill"
msgid ""
"A thick, blunted wooden stick.  Can be used to drill rough holes in rock, if "
"water and sand are available, but the process is lengthy."
msgstr ""
"Un palo de madera grueso y corto, generalmente utilizado en la fabricación de "
"pedernal para la percusión con martillo blando."

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "bone punch"
msgid_plural "bone punches"
msgstr[0] "puño de hueso"
msgstr[1] "puños de hueso"
msgstr[2] "puños de hueso"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "bone punch"
msgid ""
"A thick, short bone with a small, pointy tip, usually used in flintknapping "
"for indirect percussion and pressure flaking."
msgstr ""
"Un hueso grueso y corto, con una punta pequeña y puntiaguda, que suele "
"utilizarse en la talla lítica del pedernal para la percusión indirecta y el "
"descascarillado a presión."

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "nail punch"
msgid_plural "nail punches"
msgstr[0] "puño de clavo"
msgstr[1] "puños de clavo"
msgstr[2] "puños de clavo"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "nail punch"
msgid ""
"Two pieces of wood with a steel nail secured between them with some cordage.  "
"Usually used in flintknapping for indirect percussion and pressure flaking."
msgstr ""
"Dos piezas de madera con un clavo de acero sujeto entre ellas con algún "
"cordaje. Suelen utilizarse en la talla lítica de pedernal para la percusión "
"indirecta y el descascarillado a presión."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "bone sewing awl"
msgid_plural "bone sewing awls"
msgstr[0] "punzón para coser huesos"
msgstr[1] "punzones para coser huesos"
msgstr[2] "punzones para coser huesos"

#: data/json/items/tool/tailoring.json
#. ~ Description of "bone sewing awl"
msgid ""
"A crude, sharpened bone awl, used for leatherworking before metal was "
"discovered.  It can also serve as an improvised stabbing weapon, but will "
"break quickly."
msgstr ""
"Un punzón de hueso tosco y afilado, utilizado para trabajar el cuero antes de "
"que se descubriera el metal. También puede servir como arma punzante "
"improvisada, pero se romperá rápidamente."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "steel sewing awl"
msgid_plural "steel sewing awls"
msgstr[0] "punzón de acero para coser"
msgstr[1] "punzones de acero para coser"
msgstr[2] "punzones de acero para coser"

#: data/json/items/tool/tailoring.json
#. ~ Description of "steel sewing awl"
msgid ""
"A steel awl with a wooden grip, usually used for leatherworking.  It can also "
"serve as an improvised stabbing weapon, but will break quickly."
msgstr ""
"Un punzón de acero con empuñadura de madera, que suele utilizarse para "
"trabajar el cuero. También puede servir como arma punzante improvisada, pero "
"se romperá rápidamente."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "pair of knitting needles"
msgid_plural "pairs of knitting needles"
msgstr[0] "par de agujas de tejer"
msgstr[1] "pares de agujas de tejer"
msgstr[2] "pares de agujas de tejer"

#: data/json/items/tool/tailoring.json
#. ~ Description of "pair of knitting needles"
msgid ""
"A pair of stout wooden needles with round ends, used to turn thread and yarn "
"into cloth."
msgstr ""
"Un par de robustas agujas de madera con extremos redondeados, utilizadas para "
"convertir hilo e hilado en tela."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "frame loom"
msgid_plural "frame looms"
msgstr[0] "telar de bastidor"
msgstr[1] "telares de bastidor"
msgstr[2] "telares de bastidor"

#: data/json/items/tool/tailoring.json
#. ~ Description of "frame loom"
msgid ""
"A rather bulky and primitive wooden frame which can be used to weave cloth "
"sheets.  The process is very slow, though."
msgstr ""
"Un armazón de madera bastante voluminoso y primitivo que puede utilizarse "
"para tejer sábanas de tela. Sin embargo, el proceso es muy lento."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "bone needle"
msgid_plural "bone needles"
msgstr[0] "aguja de hueso"
msgstr[1] "agujas de hueso"
msgstr[2] "agujas de hueso"

#: data/json/items/tool/tailoring.json
#. ~ Description of "bone needle"
msgid ""
"A sharp needle made from a bone.  Useful for making rough clothing and items. "
" Its low quality makes it rather unsuitable for anything requiring speed or "
"precision."
msgstr ""
"Una aguja afilada hecha de hueso. Útil para confeccionar prendas y objetos "
"toscos. Su baja calidad la hace poco adecuada para cualquier cosa que "
"requiera velocidad o precisión."

#: data/json/items/tool/tailoring.json
#. ~ Description of "curved needle"
msgid ""
"A curved, sharp needle made of steel.  Its rounded shape allows it to make "
"stitches that only pierce one side of the material.  While unsuitable for "
"most tailoring projects, it's a necessity for stitching neoprene."
msgstr ""
"Una aguja curva y afilada hecha de acero. Su forma redondeada permite hacer "
"puntos que solo perforan un lado del material. Aunque no es adecuada para "
"muchas tareas de confección, es necesaria para coser neopreno."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "wooden needle"
msgid_plural "wooden needles"
msgstr[0] "aguja de madera"
msgstr[1] "agujas de madera"
msgstr[2] "agujas de madera"

#: data/json/items/tool/tailoring.json
#. ~ Description of "wooden needle"
msgid ""
"A wooden needle whittled down to a sharp point.  It has a narrow hole carved "
"into the head for threading.  Its low quality makes it rather unsuitable for "
"anything requiring speed or precision, or involving tougher materials like "
"Kevlar."
msgstr ""
"Una aguja de madera reducida a una punta afilada. Tiene un estrecho orificio "
"tallado en la cabeza para enhebrarla. Su baja calidad la hace poco adecuada "
"para todo lo que requiera velocidad o precisión, o para materiales más duros "
"como el kevlar."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "needle"
msgid_plural "needles"
msgstr[0] "aguja"
msgstr[1] "agujas"
msgstr[2] "agujas"

#: data/json/items/tool/tailoring.json
#. ~ Description of "needle"
msgid "A stainless steel needle.  It would be useful for making clothing and items."
msgstr "Una aguja de acero inoxidable. Sería útil para confeccionar prendas y objetos."

#: data/json/items/tool/tailoring.json data/mods/Magiclysm/items/tools.json
#: data/mods/innawood/items/tool_tailoring.json
#. ~ Item name
msgid "sewing kit"
msgid_plural "sewing kits"
msgstr[0] "costurero"
msgstr[1] "costureros"
msgstr[2] "costureros"

#: data/json/items/tool/tailoring.json
#. ~ Description of "sewing kit"
msgid ""
"A plastic kit with a variety of needles, some plastic spools for thread, "
"small scissors, and a few other useful textile tools.  Use a sewing kit on an "
"article of clothing to attempt to repair or refit if applicable.  This uses "
"your tailoring skill."
msgstr ""
"Un equipo de plástico con diversas agujas, algunas bobinas de plástico para "
"el hilo, pequeñas tijeras y algunas herramientas textiles útiles. Utiliza un "
"costurero en una prenda de vestir para intentar reparar o reforzar dicha "
"prenda. Y al hacerlo estarás usando tu habilidad de confección."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "wooden shed stick"
msgid_plural "wooden shed sticks"
msgstr[0] "palos de madera de tejer"
msgstr[1] "palos de madera de tejer"
msgstr[2] "palos de madera de tejer"

#: data/json/items/tool/tailoring.json
#. ~ Description of "wooden shed stick"
msgid ""
"A short, thin, flat wooden stick, used as a tool while weaving cloth with a "
"frame loom."
msgstr ""
"Este es un palo corto y plano de madera, usado como herramienta mientras se "
"teje la tela con un telar de bastidor."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "tanning leather hide"
msgid_plural "tanning leather hides"
msgstr[0] "pellejo de cuero curtiéndose"
msgstr[1] "pellejos de cuero curtiéndose"
msgstr[2] "pellejos de cuero curtiéndose"

#: data/json/items/tool/tailoring.json
#. ~ Description of "tanning leather hide"
msgid ""
"A treated animal hide that is undergoing the chemical processes required to "
"become leather.  You will be able to activate it to unroll and make use of it "
"when it is done."
msgstr ""
"Un pellejo de animal tratado que está siendo sometida a los procesos químicos "
"necesarios para convertirse en cuero. Cuando termine, podrás activarla para "
"desenrollarla y hacer uso de ella."

#: data/json/items/tool/tailoring.json
#. ~ "msg" action message of item "tanning leather hide"
msgid "You carefully unfold the tanning leather hide and shake it clean."
msgstr ""
"Cuidadosamente, desdoblas el pellejo que está curtiéndose y lo sacudes para "
"limpiarlo."

#: data/json/items/tool/tailoring.json
#. ~ "not_ready_msg" action message of item "tanning leather hide"
msgid "The tanning leather hide isn't done yet."
msgstr "El pellejo todavía no terminó el proceso de curtido."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "tanning fur pelt"
msgid_plural "tanning fur pelts"
msgstr[0] "pelaje curándose"
msgstr[1] "pelajes curándose"
msgstr[2] "pelajes curándose"

#: data/json/items/tool/tailoring.json
#. ~ Description of "tanning fur pelt"
msgid ""
"A treated animal pelt that is undergoing the chemical processes required to "
"become fur.  You will be able to activate it to unroll and make use of it "
"when it is done."
msgstr ""
"Un pellejo de animal tratado que está siendo sometido a los procesos químicos "
"necesarios para convertirse en piel. Podrás activarla para desenrollarla y "
"hacer uso de ella cuando esté terminada."

#: data/json/items/tool/tailoring.json
#. ~ "msg" action message of item "tanning fur pelt"
msgid "You carefully unfold the tanning fur pelt and shake it clean."
msgstr ""
"Cuidadosamente, desdoblas el pelaje que está curándose y lo sacudes para "
"limpiarlo."

#: data/json/items/tool/tailoring.json
#. ~ "not_ready_msg" action message of item "tanning fur pelt"
msgid "The tanning fur pelt isn't done yet."
msgstr "El pelaje todavía no terminó el proceso de curado."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "tailoring pattern set"
msgid_plural "tailoring pattern sets"
msgstr[0] "conjunto de patrones de confección"
msgstr[1] "conjuntos de patrones de confección"
msgstr[2] "conjuntos de patrones de confección"

#: data/json/items/tool/tailoring.json
#. ~ Description of "tailoring pattern set"
msgid ""
"A large set of tailoring patterns made from paper.  They're useful for making "
"any kind of cloth or leather items from scratch, but are necessary for more "
"advanced projects."
msgstr ""
"Un amplio conjunto de patrones de sastrería hechos de papel. Son útiles para "
"confeccionar cualquier tipo de prenda de tela o objetos de cuero desde cero, "
"pero son imprescindibles para proyectos más avanzados."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "pair of Kevlar shears"
msgid_plural "pairs of Kevlar shears"
msgstr[0] "tijeras para Kevlar"
msgstr[1] "pares de tijeras para Kevlar"
msgstr[2] "pares de tijeras para Kevlar"

#: data/json/items/tool/tailoring.json
#. ~ Description of "pair of Kevlar shears"
msgid ""
"A pair of heavy-duty shears suitable for cutting particularly tough "
"materials, from polyaramid fabrics to tough plastics and thin metals.  The "
"blades feature flat shearing edges and fine serrations."
msgstr ""
"Un par de cizallas de alta resistencia adecuadas para cortar materiales "
"especialmente resistentes, desde tejidos de poliaramida hasta plásticos duros "
"y metales finos. Las hojas presentan bordes de corte planos y finos dentados."

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "electric spinwheel"
msgid_plural "electric spinwheels"
msgstr[0] "hiladora eléctrica"
msgstr[1] "hiladoras eléctricas"
msgstr[2] "hiladoras eléctricas"

#: data/json/items/tool/tailoring.json
#. ~ Description of "electric spinwheel"
msgid ""
"A device for spinning thread or yarn from fibers.  This particular model is "
"electrically-powered and easily portable."
msgstr ""
"Un aparato para hilar hilo a partir de fibras. Este modelo en concreto "
"funciona con electricidad y es fácilmente transportable."

#: data/json/items/tool/tailoring.json data/mods/Magiclysm/items/tools.json
#: data/mods/Xedra_Evolved/items/tools.json
#: data/mods/innawood/items/tool_tailoring.json
#. ~ Item name
msgid "tailor's kit"
msgid_plural "tailor's kits"
msgstr[0] "equipo de sastre"
msgstr[1] "equipos de sastre"
msgstr[2] "equipos de sastre"

#: data/json/items/tool/tailoring.json
#. ~ Description of "tailor's kit"
msgid ""
"A high-quality kit consisting of a variety of needles, some plastic spools "
"for thread, scissors and shears, and an awl.  Use a tailor's kit on an "
"article of clothing to attempt to repair or refit if applicable.  This uses "
"your tailoring skill."
msgstr ""
"Un equipo de alta calidad con una variedad de agujas, carretes plásticos de "
"hilo, tijeras, tijeras para esquilar y un punzón. Puedes usar el equipo de "
"sastre para reparar un articulo de ropa o reajustar si se puede. Esto utiliza "
"tu habilidad de confección."

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "bathroom scale"
msgid_plural "bathroom scales"
msgstr[0] "báscula de baño"
msgstr[1] "básculas de baño"
msgstr[2] "básculas de baño"

#: data/json/items/tool/toiletries.json
#. ~ Description of "bathroom scale"
msgid "A small bathroom scale, meant to weigh a person while naked."
msgstr "Una pequeña báscula de baño, pensada para pesar a una persona desnuda."

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "scrub brush"
msgid_plural "scrub brushes"
msgstr[0] "cepillo de fregar"
msgstr[1] "cepillos de fregar"
msgstr[2] "cepillos de fregar"

#: data/json/items/tool/toiletries.json
#. ~ Description of "scrub brush"
msgid "A simple scrub brush for cleaning hard objects."
msgstr "Un simple cepillo de fregar para limpiar objetos duros."

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "dish towel"
msgid_plural "dish towels"
msgstr[0] "paño de cocina"
msgstr[1] "paños de cocina"
msgstr[2] "paños de cocina"

#: data/json/items/tool/toiletries.json
#. ~ Description of "dish towel"
msgid "A dish towel, useful for cleaning hard surfaces."
msgstr "Un paño de cocina, útil para limpiar superficies duras."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "An elegant, monogrammed dish towel.  Unfortunately, they aren't your initials."
msgstr ""
