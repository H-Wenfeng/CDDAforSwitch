#. ~ Response to NPC dialogue
msgid "New Assignments [1]"
msgstr "Nuevas Tareas [1]"

#: data/json/npcs/computers/TALK_NURSING_HOME.json
#. ~ Response to NPC dialogue
msgid "Pending Assignments"
msgstr "Tareas Pendientes"

#: data/json/npcs/computers/TALK_NURSING_HOME.json
