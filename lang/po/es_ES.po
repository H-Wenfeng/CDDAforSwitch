#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Your Followers"
msgstr "Tus Seguidores"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Your Followers"
msgid ""
"The survivors who have entrusted you with their well-being.  If morale drops, "
"poor performance and mutiny may become issues."
msgstr ""
"Los supervivientes que han confiado en ti para mantener su bienestar. Si la "
"moral cae, el bajo rendimiento y el amotinamiento pueden llegar a ser "
"problemas."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "AMF"
msgstr "AMF"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "AMF"
msgid ""
"The survivors who formerly entrusted you with their well-being, but have now "
"mutinied because of your abuse and incompetence.  They will kill you if they "
"can."
msgstr ""
"Los supervivientes que antes te confiaban su bienestar, pero que ahora se han "
"amotinado por tu abuso e incompetencia. Te matarán si pueden."

#: data/json/npcs/factions.json
#: data/json/overmap/overmap_special/specials.json
#. ~ NPC faction name
#. ~ Name of NPC faction camp
msgid "Hub 01"
msgstr "Hub 01"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Hub 01"
msgid ""
"The surviving staff of Hub 01, a pre-Cataclysm research lab.  They rarely "
"leave their lab, if at all, and rely on their robots and advanced technology "
"to survive."
msgstr ""
"El personal superviviente de Hub 01, un laboratorio de investigación de antes "
"del Cataclismo. Raramente dejan su laboratorio, si es que lo hacen, y "
"dependen de sus robots y tecnología avanzada para sobrevivir."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Hub 01 Ancilla"
msgstr "Auxiliares Hub 01"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Hub 01 Ancilla"
msgid ""
"A loose association of skilled wastelanders, traders, mercenaries and scouts. "
" All working on behalf of Hub 01, for their own reasons."
msgstr ""
"Una asociación informal de expertos errantes del yermo, comerciantes, "
"mercenarios y exploradores. Todos trabajan para el Hub 01 por sus propios "
"motivos."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "The Old Guard"
msgstr "La Vieja Guardia"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "The Old Guard"
msgid ""
"The remains of the federal government.  The extent of their strength is "
"unknown but squads of patrolling soldiers have been seen under their banner."
msgstr ""
"Lo que queda del gobierno federal. El alcance de su fuerza es desconocido, "
"pero escuadrones de soldados patrullando han sido vistos con su bandera."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "The Free Merchants"
msgstr "Los Mercaderes Libres"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "The Free Merchants"
msgid ""
"A conglomeration of entrepreneurs and businessmen that stand together to "
"hammer-out an existence through trade and industry."
msgstr ""
"Una conglomeración de empresarios y emprendedores que se mantienen juntos "
"para poder continuar su existencia a través del comercio y la industria."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "The Beggars in the Lobby"
msgstr "Los Indigentes del Vestíbulo"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "The Beggars in the Lobby"
msgid ""
"A collection of mentally and physically disadvantaged survivors who beg for "
"food in the Evac Center lobby."
msgstr ""
"Una colección de supervivientes con desventajas físicas y mentales que piden "
"comida en el vestíbulo del Centro de Evacuación."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "The Tacoma Commune"
msgstr "La Comuna Tacoma"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "The Tacoma Commune"
msgid ""
"An outpost started by the Free Merchants to provide a source of food and raw "
"materials."
msgstr ""
"Un puesto fundado por los Mercaderes Libres para proveer una fuente de comida "
"y materias primas."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Isolated Artisans"
msgstr "Artesanos Aislados"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Isolated Artisans"
msgid "A couple of talented artisans in the country."
msgstr "Un par de artesanos con talento en el país."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Marloss Evangelists"
msgstr "Evangelistas de Marloss"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Marloss Evangelists"
msgid ""
"Diverse bands, congregations and organizations with the common goal of "
"preaching human survival through symbiosis with fungaloids."
msgstr ""
"Diversas bandas, congregaciones y organizaciones con el objetivo común de "
"predicar la supervivencia humana a través de la simbiosis con los fungaloides."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "No Faction"
msgstr "No hay facción."

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "No Faction"
msgid "A lone wolf, not aligned with any faction."
msgstr "Un lobo solitario, no alineado con ninguna facción."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "The Wasteland Scavengers"
msgstr "Los Rebuscadores del Páramo"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "The Wasteland Scavengers"
msgid ""
"Autonomous bands or individuals who make their living raiding the ruins of "
"the old-world for gear and provisions."
msgstr ""
"Bandas autónomas o individuos que se dedican a saquear las ruinas del  mundo "
"antiguo para conseguir equipo y provisiones."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Hell's Raiders"
msgstr "Saqueadores del Infierno"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Hell's Raiders"
msgid ""
"The largest gang of hooligans and bandits that preys upon other survivors.  "
"Even if you have no gear, there is always a need for slaves and fresh meat."
msgstr ""
"La banda más grande de hooligans y bandidos que abusan de los otros "
"supervivientes. Y aunque no tengas equipo, siempre existe la necesidad de "
"esclavos y carne fresca."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Enslaved individuals"
msgstr "Individuos esclavizados"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Enslaved individuals"
msgid ""
"Individuals who have been enslaved or held prisoner for a long period of "
"time, for various reasons."
msgstr ""
"Personas que han sido sometidas a esclavitud o retenidas como prisioneras "
"durante un largo periodo de tiempo, por diversos motivos."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Mutants Bees"
msgstr "Abejas Mutantes"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Mutants Bees"
msgid "Mutant bees who hate everyone."
msgstr "Abejas mutantes que odian a todo el mundo."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Isherwood family"
msgstr "La familia Isherwood"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Isherwood family"
msgid "A small family surviving on their generational land."
msgstr "Una pequeña familia que sobrevive en su tierra por generaciones."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "New England Church Community"
msgstr "Comunidad Eclesiástica de Nueva Inglaterra"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "New England Church Community"
msgid ""
"A small group of churchgoers that formed a community in the woods.  They "
"welcome anyone in their faction, but hate the unnatural."
msgstr ""
"Un pequeño grupo de feligreses que formaron una comunidad en el bosque. Ellos "
"dan la bienvenida a cualquiera de su facción, pero odian lo antinatural."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Rabbit Enthusiasts"
msgstr "Entusiasta de los conejos"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Rabbit Enthusiasts"
msgid "Mr. Lapin and any acolytes he may have gathered in the apocalypse."
msgstr "El Sr. Lapin y los acólitos que pueda haber reunido en el apocalipsis."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Fisherman Family"
msgstr "Familia Fisherman"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Fisherman Family"
msgid "A small family trying to survive in this new world."
msgstr "Una pequeña familia que intenta sobrevivir en este nuevo mundo."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Prisoners"
msgstr "Prisioneros"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Prisoners"
msgid "Former prisoners who got their freedom during the apocalypse."
msgstr "Antiguos prisioneros que obtuvieron su libertad durante el apocalipsis."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "The Exodii"
msgstr "Los Exodii"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "The Exodii"
msgid ""
"A tribe of scavengers and survivors that have been through this before, and "
"sacrificed what they must to make it through."
msgstr ""
"Una tribu de rebuscadores y supervivientes que ya han pasado por esto y han "
"sacrificado lo que debían para salir adelante."

#: data/json/npcs/factions.json data/json/overmap/overmap_special/campus.json
#. ~ NPC faction name
#. ~ Name of NPC faction camp
msgid "The Great Library"
msgstr "La Gran Librería"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "The Great Library"
msgid ""
"A group of academics and other survivors that stand together to preserve and "
"spread knowledge of the world."
msgstr ""
"Un grupo de académicos y otros supervivientes que se unen para preservar y "
"difundir el conocimiento del mundo."

#: data/json/npcs/factions.json
#. ~ NPC faction name
msgid "Grey Moose Militia Community"
msgstr "Comunidad de la Milicia Alce Gris"

#: data/json/npcs/factions.json
#. ~ Description of NPC faction "Grey Moose Militia Community"
msgid "A small community of survivors who retreated to a remote lodge."
msgstr "Una pequeña comunidad de supervivientes que se retiró a una cabaña remota."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Squirrels are pretty yummy, but if you shoot them with a high-powered gun "
"you'll probably be left with no meat!  Use a BB gun or maybe a .22 rifle."
msgstr ""
"Las ardillas son bastante sabrosas, pero si les disparas con un arma de alta "
"potencia, ¡probablemente no le dejes nada de carne! Usa una pistola de "
"balines o tal vez un rifle calibre .22."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Squirrels really ain't such a bad snack if you don't blast them all to hell."
msgstr "Las ardillas no son un bocadillo tan malo si no las mandas al infierno."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Ever run into those big worm things?  If you see trails of churned-up dirt, "
"you can be sure they're around."
msgstr ""
"¿Alguna vez te cruzaste con esos gusanos gigantes? Si ves rastros de tierra "
"revuelta, puedes estar seguro de que andan cerca."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Try to stay on the roads as much as you can.  Giant worms can't cross them!"
msgstr ""
"Intenta andar por las calles todo lo que puedas. ¡Los gusanos gigantes no "
"pueden cruzarlas!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Don't relax after killing a giant worm.  Little bits of them can break off "
"and still attack!"
msgstr ""
"No te relajes después de matar a un gusano gigante. ¡Trocitos del gusano "
"pueden desprenderse y continuar atacándote!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you see a big mob of zombies coming, RUN!  Trying to fight them all is "
"impossible unless you have a big tactical advantage."
msgstr ""
"Si ves una gran multitud de zombis viniendo, ¡corre! Tratar de luchar contra "
"todos ellos es imposible a menos que tengas una gran ventaja táctica."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you see a big mob of zombies coming, you better run.  Trying to fight them "
"all is suicide!"
msgstr ""
"Si ves una gran multitud de zombis viniendo, es mejor que corras. ¡Intentar "
"luchar contra todos ellos es un suicidio!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "When you see a swarm of zombies coming it's time to run!"
msgstr "¡Cuando veas un enjambre de zombis viniendo es hora de correr!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're getting chased by a horde of zombies, try ducking into the subways "
"and traveling a block or two before coming back up."
msgstr ""
"Si te está persiguiendo una horda de zombis, intenta esconderte en los "
"túneles de metro y viaja un bloque o dos, antes de volver a salir."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Watch out for those zombies that shriek; they'll let other zombies know where "
"you are, and will attract them from all over."
msgstr ""
"Cuidado con los zombis que aúllan; les avisan a los demás zombis dónde estás, "
"y los atraen hacia ti."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Those acid-spitting zombies are pretty nasty, but if you're smart, you can "
"get other zombies to wade through the acid."
msgstr ""
"Esos zombis que escupen ácido son bastante peligrosos, pero si eres "
"inteligente, puedes hacer que los otros zombis tengan que pasar por el ácido."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If there's a pool of acid blocking your way, trying tossing a junk item into "
"it.  Eating up items will help neutralize the acid faster."
msgstr ""
"Si hay un charco de ácido bloqueándote el camino, prueba tirándole arriba un "
"objeto que no te sirva. Los objetos que consuma el ácido ayudan a que se "
"neutralice más rápido."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Rubber boots aren't as tough as combat boots and you don't run very fast in "
"them.  But I've seen zombies vomiting puddles of acid, and I'd hate to have "
"my feet melt off, so I'd consider having a pair of those."
msgstr ""
"Las botas de goma no son tan duras como las de combate y no se corre muy "
"rápido con ellas. Pero he visto zombis vomitando charcos de ácido, y odiaría "
"que se me derritieran los pies, así que consideraría tener un par de esas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"There's this type of zombie that can shoot bolts of lightning!  Stay away "
"from walls and stuff when they do… the electricity can travel along solid "
"surfaces."
msgstr ""
"Hay un tipo de zombi que puede disparar rayos. Aléjate de los muros/paredes y "
"cosas cuando lo hacen... la electricidad puede viajar a lo largo de "
"superficies sólidas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Zombie hulks are NASTY, but they're easy to outsmart.  If there's other "
"monsters between you and them, they'll kill the monster for you!"
msgstr ""
"Las moles zombis son PELIGROSOS, pero son fáciles de engañar. Si hay otros "
"monstruos entre tú y ellos, ¡matarán a los monstruos por ti!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you run into a zombie hulk, it's probably a good idea to run.  They're "
"fast as hell, but pretty dumb; they'll try to smash through obstacles rather "
"than going around, and that slows them down a lot."
msgstr ""
"Si te encuentras con un mole zombi, la mejor idea es que salgas corriendo. "
"Son muy rápidos pero bastante tontos. Van a intentar romper todos los "
"obstáculos que se atraviesen en lugar de esquivarlos, lo que te da ventaja "
"para huir."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Zombie brutes and hulks have really tough hide, but skeletal juggernauts with "
"their bone plates are the worst.  Don't bother shooting at them with "
"lower-caliber guns, the bullet will bounce right off!"
msgstr ""
"Las bestias y las moles zombis tienen de verdad un pellejo muy duro, pero los "
"gigantes esqueléticos con sus placas óseas son los peor. No te molestes en "
"dispararles con armas de pequeño calibre, ¡la bala rebotará enseguida!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Try not to kill a boomer if it's standing right next to you.  They tend to "
"explode when they die, and that pink goop will get all over you."
msgstr ""
"Tratá de no matar a un boomer si estás parado al lado de él. Suelen explotar "
"cuando se mueren, y vas a quedar cubierto con ese pringue rosa."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Skeletons are a tough target for a gun.  They're so skinny and full of holes "
"that it's hard to make a good hit.  And those big ones are hard as nails too."
msgstr ""
"Los esqueletos son un blanco difícil para un arma. Son tan delgados y llenos "
"de agujeros que es difícil dar un buen golpe. Y esos grandes son duros como "
"clavos también."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Small skeletons are too delicate to smash through doors or windows.  Big ones "
"can walk in through a wall.  At least they can't smell you, unlike zombies, "
"so if you turn your light off at night you can sneak right past."
msgstr ""
"Los pequeños esqueletos son demasiado delicados para atravesar puertas o "
"ventanas. Los grandes pueden pasar a través de un muro/pared. Al menos no "
"pueden olerte, a diferencia de los zombis, así que si apagas la luz por la "
"noche puedes pasar de largo."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Don't try to take on a skeleton with a bladed weapon… you'll just leave "
"scratch marks.  You've got to shatter those bones with a hammer or something."
msgstr ""
"No intentes enfrentarte a un esqueleto con un arma de fuego... sólo dejarás "
"marcas de arañazos. Tienes que destrozar esos huesos con un martillo o algo "
"así."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"It's a good idea to butcher corpses if you have the time.  I've seen these "
"weird zombies bring their friends back from the dead!"
msgstr ""
"Es una buena idea matar cadáveres si tienes tiempo. ¡He visto a estos "
"extraños zombis traer a sus amigos de vuelta de la muerte!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I have a buddy who was sleeping in this cabin way out in the woods, when he "
"suddenly woke up to trees and vines growing right up through the floor and "
"walls!  He said it was some kind of huge tree beast…"
msgstr ""
"Tengo un amigo que estaba durmiendo en esta cabaña en el bosque, cuando de "
"repente se despertó con los árboles y las vides creciendo a través del suelo "
"y las paredes! Dijo que era una especie de enorme bestia de los árboles..."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Oh man, have you gone down into the old subway systems?  I'd be careful… "
"there's these things down there that are like zombies, but tougher."
msgstr ""
"Oh, tío, ¿has bajado a los viejos sistemas de metro? Yo tendría cuidado... "
"hay estas cosas ahí abajo que son como zombis, pero más fuertes."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"There's snakes down in most of the old sewer systems.  They're slow on land, "
"but boy, those suckers can swim fast!"
msgstr ""
"En la mayoría de los sistemas viejos de cloacas hay serpientes. Son lentas en "
"el suelo, ¡pero pueden nadar muy rápido!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're planning on wandering around the sewers--not that you'd have a "
"reason too--watch out for those fish.  Those suckers are fast, and vicious "
"too!"
msgstr ""
"Si estás pensando en dar un paseo por las cloacas -como si tuvieras alguna "
"razón para hacerlo- ten cuidado con esos peces. ¡Esos bichos son rápidos y "
"feroces!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Ever go toe-to-toe with a manhack?  Tiny little helicopters covered in "
"knives.  Best be packing a shotgun!"
msgstr ""
"¿Alguna vez estuviste cara a cara con un manhack? Son como pequeños "
"helicópteros recubiertos con cuchillos. ¡Te recomiendo tener una escopeta!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"They're rare, but demining bots are nasty things.  They bore through the "
"ground, then pop up to stab ya.  Still, you're safe from them if you stay on "
"pavement…"
msgstr ""
"Son raros, pero los robots de desminado son cosas desagradables. Perforan el "
"suelo y luego aparecen para apuñalarte. Aún así, estás a salvo de ellos si te "
"mantienes en el pavimento..."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Don't fire your gun if you can help it - the noise attracts monsters.  If you "
"could get a silencer, or make one, it would give you some advantage."
msgstr ""
"No dispares tu arma si puedes evitarlo, el ruido atrae a los monstruos. Si "
"pudieras conseguir un silenciador, o hacer uno, te daría alguna ventaja."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Standing behind a window is a good tactic.  It takes zombies a long time to "
"crawl through, giving you lots of opportunities to hit them."
msgstr ""
"Colocarse detrás de una ventana es una buena táctica. Los zombis tardan mucho "
"en reptar a través de ella, lo que te da muchas oportunidades de golpearlos."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Zombies are pretty dumb… heck, most monsters are!  If you can get a fire "
"going between you and them, they'll just run straight through it."
msgstr ""
"Los zombis son bastante tontos... ¡Diablos, la mayoría de los monstruos lo "
"son! Si puedes hacer que un fuego se interponga entre tú y ellos, ellos lo "
"atravesarán."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I know it's tempting to just go full-auto and unload as many bullets as "
"possible, but don't except as a last resort.  It's inaccurate and wastes ammo."
msgstr ""
"Sé que es tentador usar armas automáticas y vaciarles todo el cargador "
"encima, pero no lo hagas salvo que sea el último recurso. Es poco preciso y "
"gastas munición."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If there's a bunch of zombies in a straight line, try unloading a burst from "
"your gun.  Be sure to aim at the zombie furthest away; you'll hit more of "
"them that way."
msgstr ""
"Si hay un grupo de zombis parados en fila, intenta dispararles en ráfaga. "
"Apuntale al zombi que esté más lejos, porque así le vas a pegar a más zombis."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you shoot a zombie, but don't quite kill it, try to finish it off with a "
"punch or something instead of wasting a bullet."
msgstr ""
"Si le disparas a un zombi pero no lo matas, tratá de rematarlo a piñas o con "
"otra cosas para no gastar una bala más."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're in a corridor or something, and there's a bunch of zombies chasing "
"you down it, try to wound the guy in front badly.  He'll start moving slow "
"and cause a serious traffic jam!"
msgstr ""
"Si estás en un pasillo o algo similar, y hay un montón de zombis "
"persiguiéndote, intenta herir al que esté adelante. ¡Se va a empezar a mover "
"más lento y causará un embotellamiento!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Here's a trick for taking care of a huge swarm of zombies chasing you: head "
"into a liquor store, shoot out as many bottles as you can, then light the "
"alcohol on fire.  Then duck out the back door, and watch the zombies run into "
"a burning building!"
msgstr ""
"Te dejo un truco para ocuparte de grandes grupos de zombis que te persiguen: "
"entra en una licorería, dispárale a todas las botellas que puedas, y prende "
"fuego al alcohol. Después, escapa por la puerta de atrás y mira cómo los "
"zombis se meten en el medio del fuego."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Sledge hammers may seem like a great weapon, but swinging them is really "
"slow, and you won't do much damage unless you're really strong."
msgstr ""
"Las almádenas pueden parecer como un buen arma, pero son muy lentas de usar, "
"y no vas a causar mucho daño si no tienes mucha fuerza."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"For a good melee weapon, you can't beat a machete.  I've seen a guy take down "
"a zombie brute with one!  Of course, if you can find a katana, that might be "
"even better…"
msgstr ""
"Una buena arma de combate c. a c. no puedes vencer a un machete. ¡He visto a "
"un tipo derribar a un zombi bestia con uno! Por supuesto, si puedes encontrar "
"una katana, eso podría ser aún mejor..."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"A spike on a stick makes a good weapon in a pinch, but a spike strapped to a "
"stick isn't the sturdiest construction.  At least you can strap the spike "
"back on when it comes off."
msgstr ""
"Una púa en un palo es una buen arma en caso de necesidad, pero una púa atada "
"a un palo no es lo más resistente del mundo. Por lo menos, puedes volver a "
"atar la púa cuando se caiga."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"You know, a glass bottle can make a good weapon in a pinch.  If you break it "
"over someone's head, the shattering glass will hurt them extra.  Of course, "
"it might hurt your hands, too…"
msgstr ""
"Sabes, una botella de vidrio puede ser una buena arma en caso de necesidad. "
"Si la rompes sobre la cabeza de alguien, el vidrio que se rompe le hará más "
"daño. Por supuesto, también puede lastimar sus manos..."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"You know what makes a nice weapon?  Take a plank, or a baseball bat or "
"something, and stick a bunch of nails through the end!"
msgstr ""
"¿Sabes qué es un buen arma? Coger un tablón, o un bate de béisbol o algo "
"parecido, y clavar un montón de clavos en el extremo."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"BB guns may seem like a joke, but they've got their uses.  They're good for "
"hunting small game, or getting to know the basics of rifles."
msgstr ""
"Los rifles de balines parecen una joda, pero pueden ser útiles. Sirven para "
"cazar animales pequeños, o para aprender el uso básico de los rifles."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Crossbows are a great weapon for long term use.  Most of the time, you can "
"retrieve the bolt after shooting it, so running out of ammo is less of a "
"concern."
msgstr ""
"Las ballestas son muy buenas armas para usos prolongados. La mayoría del "
"tiempo, puedes recuperar los pernos que disparaste, así que quedarse sin "
"munición no es una preocupación primordial."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Consider going Robin Hood, if you have the strength to pull the string of a "
"bow.  Those larger ones need significant muscle power, but they hit hard, and "
"are silent."
msgstr ""
"Considere convertirte en Robin Hood, si tienes la fuerza para tirar de la "
"cuerda de un arco. Los más grandes necesitan mucha fuerza muscular, pero "
"golpean fuerte y son silenciosos."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I hid in a dumpster once or twice.  I may smell bad, but I'm not dead, as "
"they say."
msgstr ""
"Me escondí en un basurero una o dos veces. Puedo oler mal, pero no estoy "
"muerto, como dicen."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"It's good to keep a pistol handy, in case your main gun runs out of ammo or "
"something.  They're also better than most guns at short range."
msgstr ""
"Es bueno tener una pistola a mano, por si tus armas principales se quedan sin "
"munición o les pasa algo. Las pistolas son mejores que las otras armas a "
"corto alcance."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Shotguns are nice; you can take out lots of baddies with a single shot.  Just "
"remember that they're noisy as hell, and you might end up attracting more "
"than you kill."
msgstr ""
"Las escopetas son buenas; puedes encargarte de varios villanos de un solo "
"disparo. Pero acuérdate de que hacen mucho ruido, y termines atrayendo a más "
"de los que matas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"A good submachine gun can't be beat.  Most of them use common ammo, they're "
"good at short and long range, and you can burst-fire if you need to!"
msgstr ""
"No hay nada mejor que un buen subfusil. La mayoría utilizan munición normal, "
"son buenos para el combate a corta y larga distancia, y también puedes "
"disparar en ráfaga si quieres."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Hunting rifles are great at long range, but suck close up.  Plus, most of "
"them don't carry many rounds.  Keep a pistol as a sidearm if you use a rifle."
msgstr ""
"Los rifles de caza son muy buenos para grandes distancias, pero son una "
"porquería para el combate cercano. Además, la mayoría no tiene mucha "
"capacidad para la munición. Llevá una pistola como arma secundaria si vas a "
"usar un rifle."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"You know, you don't have to go full auto with an assault rifle.  Firing "
"single shots is more accurate and efficient!"
msgstr ""
"Mira, no es necesario disparar todo en automático cuando usas un rifle de "
"asalto. ¡Disparar de a una bala es más preciso y eficiente!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I wish we had laser guns like in those sci-fi stories.  They'd be the perfect "
"weapon: quiet, accurate, and deadly."
msgstr ""
"Ojalá tuviéramos pistolas láser como en esas historias de ciencia ficción. "
"Serían el arma perfecta: silenciosas, precisas y mortíferas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"When it comes to footwear, you've got two basic choices as far as I see it; "
"sneakers, for running extra fast, or boots for durability.  Depends on your "
"style, I guess."
msgstr ""
"Si hablamos de calzado, tienes dos opciones básicas hasta donde yo sé. "
"Zapatillas, para correr más rápido, o botas porque son duraderas. Supongo que "
"depende de tu estilo."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"You don't really need to wear gloves most of the time, but once in a while "
"they'll really come in handy."
msgstr ""
"No necesitas tener guantes puestos todo el tiempo, pero de vez en cuando son "
"útiles."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I wish I could still use those rollerblades.  I would be so fast.  But I took "
"an arrow to the knee, and all that."
msgstr ""
"Me gustaría poder seguir usando esos patines. Sería muy rápido. Pero me llevé "
"una flecha a la rodilla, y todo eso."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"It's good to keep a filter mask or gas mask handy.  You never know when "
"you'll have to go into a smoke-filled room or something."
msgstr ""
"Es bueno tener un máscara con filtro o una máscara de gas a mano. Nunca sabes "
"cuándo vas a tener que entrar en una habitación llena de humo o algo similar."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"There's basically no reason not to wear safety glasses… nothing is worse than "
"taking a hit to the eyes and getting blinded for a few seconds."
msgstr ""
"Básicamente no hay razón para no usar gafas de seguridad... nada es peor que "
"recibir un golpe en los ojos y quedarse ciego por unos segundos."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Ski goggles are a great choice if you're worried about getting stuff in your "
"eyes.  Perfect for dealing with boomers!"
msgstr ""
"Las gafas de esquí son muy buena opción si estás preocupado por que se te "
"meta algo en los ojos. ¡Y perfectos para combatir boomers!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you get a pair of night vision goggles, hold on to them!  A flashlight "
"will give you away, but with goggles you can be sneaky.  Beware that some "
"types of zombies are camouflaged against it, and require proper light to be "
"visible."
msgstr ""
"Si consigues un par de gafas de visión nocturna, ¡guardátelas! Una linterna "
"puede delatar tu ubicación, pero con esas gafas puedes pasar desapercibido. "
"Pero cuidado con algunas clases de zombis que pueden camuflarse aunque tengas "
"los anteojos, y necesitas luz para poder verlos."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I know they look dumb, but wearing a fanny pack gives you that extra bit of "
"storage without encumbering you."
msgstr ""
"Ya sé que son horribles, pero si usas una riñonera vas a tener un poco más de "
"capacidad de almacenamiento sin provocarte incomodidad."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Backpacks let you carry lots of stuff, but they limit your movement a lot.  "
"If you have to fight a zombie at close range, don't wear one, or at least "
"drop it on the ground before the fight."
msgstr ""
"Las mochilas te permiten llevar muchas cosas, pero limitan mucho tus "
"movimientos. Si tienes que luchar contra un zombi a corta distancia, no te "
"pongas uno, o al menos déjalo caer al suelo antes de la pelea."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Don't underestimate a good book.  Not only will it keep you company on lonely "
"nights, but you can learn a hell of a lot from some of them."
msgstr ""
"No subestimes un buen libro. Te mantendrá acompañado en las noches "
"solitarias, y también puedes aprender un montón de cosas de algunos libros."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"It's a good idea to carry around a couple of empty bottles.  You can fill "
"them up with water, gasoline, or whatever!"
msgstr ""
"Es una buena idea llevar un par de botellas vacías. Las puedes llenar con "
"agua, gasolina ¡o lo que sea!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"First aid 101 for you.  Always bandage your wounds, they will heal faster "
"that way.  Bandages are plenty and you can make makeshift ones easily, so "
"there is no reason not to."
msgstr ""
"Primeros auxilios 101 para ti. Siempre venda sus heridas, así sanarán más "
"rápido. Hay muchas vendas y puedes hacer unas improvisadas fácilmente, así "
"que no hay razón para no hacerlo."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I can bandage you if you are wounded, so give me some spare bandages, if you "
"have any."
msgstr ""
"Puedo vendarte si estás herido, así que dame algunas vendas de repuesto, si "
"tienes alguna."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you have extra antiseptic, use it to disinfect your wounds, even if they "
"aren't infected.  They will recover faster that way."
msgstr ""
"Si tienes un antiséptico extra, úsalo para desinfectar tus heridas, incluso "
"si no están infectadas. Se recuperarán más rápido de esa manera."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Treat your infected wounds as soon as possible.  If the infection spreads "
"only antibiotics may help you, but it will take time, and you may still die "
"from it if it's too serious."
msgstr ""
"Trata tus heridas infectadas lo antes posible. Si la infección se propaga, "
"sólo los antibióticos podrán ayudarte, pero llevará un tiempo, y es posible "
"que mueras de ella si es muy grave."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you need a bunch of rags for making Molotov cocktails, take a pair of "
"scissors to an old t-shirt or something."
msgstr ""
"Si necesitas trapos para hacer un cóctel molotov, coge un par de tijeras y "
"úsalas en una camiseta vieja y otra ropa."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Carrying a lighter is something all veterans do.  It takes up almost no "
"space, and can easily save your life."
msgstr ""
"Llevar un mechero es algo básico de cualquier veterano. Casi no te ocupa "
"lugar y puede salvarte fácilmente la vida."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you can spare the space, you might want to carry a fire extinguisher "
"along.  Nothing is worse than being trapped in a burning building!"
msgstr ""
"Si tienes lugar, tal vez quieras llevar un extintor encima. ¡No hay nada peor "
"que quedarse atrapado en una casa en llamas!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Crowbars not only make a pretty good weapon, they're also useful for opening "
"locked doors and lifting manhole covers."
msgstr ""
"Las palancas son un arma bastante buena, pero también son útiles para abrir "
"puertas cerradas con llave y para levantar las tapas de las alcantarillas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're spending the night in an area you're not sure is safe, laying traps "
"at the entrance(s) to the area you choose to sleep in could save your life by "
"injuring and alerting you to any stragglers that find their way in."
msgstr ""
"Si vas a pasar la noche en una zona que no estás seguro de que sea segura, "
"colocar trampas en la(s) entrada(s) de las zonas que elijas para dormir, esto "
"podría salvarte la vida al herir y alertarte de cualquier intruso rezagado "
"que encuentre la forma de entrar."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"A chainsaw may seem like a great weapon, but remember that they're slow, "
"unwieldy, and very noisy."
msgstr ""
"Una motosierra puede parecer un buen arma, pero acordate que son lentas, "
"incómodas de usar, y muy ruidosas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Bubble wrap is pretty harmless, but setting it up around you before going to "
"sleep will keep you from waking up to a zombie punching you."
msgstr ""
"El plástico de burbujas es bastante inofensivo, pero colocarlo a tu alrededor "
"antes de irte a dormir evitará que te despiertes con un zombi zurrándote."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Bear traps are a nice way to cover an escape.  If you place one in a doorway, "
"the first zombie through will get stuck, and the rest won't be able to get "
"past!"
msgstr ""
"Las trampas para oso son una buena manera de cubrir tu huida. Si colocas una "
"adelante de una puerta, el primer zombi que pase va a quedar atrapado, ¡y el "
"resto no va a poder pasar!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Smoke grenades aren't really offensive weapons, but they'll cover up your "
"scent and hide you from view--perfect for making a quick escape."
msgstr ""
"Las granadas de humo en realidad no son armas ofensivas, pero pueden tapar tu "
"olor y ocultarte a la vista. Perfectas para hacer una huida rápida."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Don't use Molotovs indoors.  Especially in a liquor store."
msgstr ""
"No uses cócteles molotov adentro de los lugares, especialmente, en las "
"licorerías."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're going to be playing with Molotov cocktails around a gas station, "
"just make sure you're a long way from those pumps."
msgstr ""
"Si vas a andar jugando con cócteles molotov cerca de una estación de "
"servicio, asegurate que estás bien lejos de los surtidores."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I once knew a guy who figured he'd survive a night in the subway by setting "
"fires blocking off the tunnel in both directions and sleeping between them.  "
"He wound up asphyxiating on the smoke."
msgstr ""
"Una vez conocí a un tipo que pensó que podía pasar la noche en el subte, "
"encendiendo un fuego para cerrar el túnel en ambas direcciones, y dormir en "
"el medio. Terminó asfixiándose con el humo."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Don't light a Molotov until you're ready to throw it.  Not only can they go "
"out, but if you accidentally drop it or something, you're in trouble."
msgstr ""
"No enciendas un cóctel molotov hasta que estés listo para tirarlo. No solo "
"porque pueden explotar, si no porque si se te cae sin querer, vas a tener "
"problemas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're weak or clumsy, it might be a good idea not to mess with Molotovs "
"or grenades.  Accidentally dropping them when you meant to throw them could "
"be deadly."
msgstr ""
"Si eres medio débil o torpe, lo mejor es no meterse con los cócteles molotov "
"o las granadas. Si se te caen accidentalmente cuando lo querías tirar, te "
"puede llegar a matar."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're not particularly agile it might be good not to mess with Molotovs "
"or grenades.  Accidents involving these sort of items tend to be grievous."
msgstr ""
"Si no eres particularmente ágil, sería bueno no meterte con molotovs o "
"granadas. Los accidentes que involucran este tipo de artículos tienden a ser "
"graves."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're wandering in the wilderness, or following a road, keep an eye out "
"for wild strawberries, blueberries and other gifts of nature."
msgstr ""
"Si estás vagando en el desierto, o siguiendo un camino, ten cuidado con las "
"fresas silvestres, los arándanos y otros regalos de la naturaleza."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Be careful eating wild mushrooms.  Some are poisonous, and others can make "
"you hallucinate."
msgstr ""
"Ten cuidado si quieres comerte hongos silvestres. Algunos son venenosos, y "
"otros te pueden hacer alucinar."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Try to go around swamps, if you can.  Some of them have sinkholes that can "
"pull you right underground."
msgstr ""
"Tratá de rodear los pantanos, si puedes. Algunos tienen sumideros que pueden "
"chuparte bajo tierra."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I heard about this group that raided a bee hive a while ago.  Everyone got "
"massacred but one, and he came home with this weird, magic honey stuff."
msgstr ""
"Escuché acerca de un grupo que atacó una colmena hace un tiempo. Todos fueron "
"masacrados excepto uno, que volvió a su hogar con una extraña miel mágica."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you need to, you can swim across a river to escape; some monsters can't "
"swim.  Just make sure you drop as much stuff as possible first, and maybe "
"strip naked, or you'll sink like a rock."
msgstr ""
"Si es necesario, puedes cruzar un río a nado para escapar; algunos monstruos "
"no pueden nadar. Sólo asegúrate de dejar caer todo lo que puedas primero, y "
"tal vez desnudarte, o te hundirás como una roca."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Houses can be a surprisingly good resource for all kinds of stuff; clothing, "
"medication, food, books, and more.  People kept all the odd things around, "
"especially in basements."
msgstr ""
"Las casas pueden ser un recurso sorprendentemente bueno para todo tipo de "
"cosas; ropa, medicamentos, comida, libros y más. La gente guardaba todas las "
"cosas raras alrededor, especialmente en los sótanos."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"While there's not much to loot, gas stations are a good source for gasoline, "
"to power tools or to make Molotov cocktails."
msgstr ""
"Aunque no tengan mucho de utilidad, las estaciones de servicio son una buena "
"fuente de gasolina, para alimentar herramientas o para hacer cócteles molotov."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"It's not like in the movies; shooting a gas pump won't make it explode.  But "
"it WILL make it leak all over the place, which is a definite fire hazard."
msgstr ""
"No es como en las películas; disparar a una bomba de gasolina no la hará "
"explotar. Pero sí hará que se filtre por todas partes, lo que es un claro "
"peligro de incendio."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I know grocery stores and stuff are full of fruit, but be careful, it's "
"probably rotten."
msgstr ""
"Ya sé que los almacenes y eso están llenos de fruta, pero ten cuidado, "
"probablemente estén podridas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Next time you visit a grocery store, load up on canned goods.  They never go "
"bad!"
msgstr ""
"La próxima vez que vayas a un almacén, coge todos los alimentos enlatados. "
"¡Esos no se echan a perder nunca!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Load up on canned goods if you ever find a grocery store.  Cans never go bad!"
msgstr ""
"Cárguese de comida enlatada si alguna vez encuentra una tienda de "
"comestibles. ¡Las latas nunca se estropean!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I've found more good weapons in hardware stores than anywhere else.  Except "
"gun stores, of course."
msgstr ""
"Encontré mejores armas en las ferreterías que en cualquier otro lado. Excepto "
"las armerías, claro."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Liquor stores are a great place to pick up non-alcoholic beverages, too.  Not "
"that I mind alcohol!"
msgstr ""
"Las licorería son un excelente lugar para conseguir bebidas sin alcohol "
"también. ¡Pero no es que me moleste el alcohol!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Most gun stores follow pretty similar layouts.  The restricted stuff - SMGs, "
"assault rifles, and most importantly ammo - are always behind the counter."
msgstr ""
"La mayoría de las tiendas de armas siguen esquemas muy similares. Las cosas "
"restringidas - SMGs, rifles de asalto, y lo más importante municiones - están "
"siempre detrás del mostrador."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I've spent many nights in the changing rooms at the back of clothing stores.  "
"Walls on four sides, far from the store's entrance, a corridor for easy "
"defense… it's perfect!"
msgstr ""
"He pasado muchas noches en los vestuarios de la parte trasera de las tiendas "
"de ropa. Paredes en los cuatro lados, lejos de la entrada de la tienda, un "
"pasillo para la defensa fácil... ¡es perfecto!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Have you seen those weird science labs out in the middle of nowhere?  I think "
"you need some kind of special ID card to get in."
msgstr ""
"¿Viste esos extraños laboratorios científicos en medio de la nada? Me parece "
"que necesitas una especie de tarjeta de identidad para poder entrar."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I have a dream of raiding a military bunker, but zombies and armor are a "
"scary mix.  And the sheer thought of being sprayed with bullets by a turret "
"is giving me the shivers."
msgstr ""
"Sueño con asaltar un búnker militar, pero los zombis y las armaduras son una "
"mezcla aterradora. Y la sola idea de ser pulverizado con balas por una "
"torreta me da escalofríos."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I've thought about raiding an ant hill before, but I realized it wasn't worth "
"the risk.  I doubt they have any loot beyond some scraps of food, you know?"
msgstr ""
"Alguna vez pensé en saquear un hormiguero, pero me di cuenta que el riesgo no "
"valía la pena. Dudo que haya algo más que restos de comida."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"This guy I know was walking through the subway when he came across a giant "
"rift in the earth, with lava far below.  Weird, huh?"
msgstr ""
"Un tipo que conocí estaba caminando por un túnel del subte y se encontró con "
"una grieta gigante en la tierra, y con lava abajo. ¿Raro, no?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"In a lot of places, there's little hallways connecting the subways with the "
"sewers, with heavy metal doors on both ends.  It's a perfect place to sleep!"
msgstr ""
"En muchos lugares, hay pequeños pasadizos que conectan el subte con las "
"cloacas, con puertas pesadas de metal en los dos extremos. ¡Es un lugar "
"perfecto para dormir!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Be careful of drinking water from rivers and stuff, it's a good way to get "
"sick.  But if you have a water purifier, it'll make it safe."
msgstr ""
"Ten cuidado con beber agua de los ríos y lugares así, porque es una buena "
"manera de enfermarse. Pero si tienes un purificador de agua, la puedes "
"convertir en una bebida segura."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Autodocs are probably your best bet to install bionics - if you can find one! "
" However, I heard they won't work if you don't bring anesthetics to put you "
"in a sleep."
msgstr ""
"Los autodocs son probablemente tu mejor apuesta para instalar biónica, ¡si es "
"que puedes encontrar una! Sin embargo, he oído que no funcionarán si no traes "
"anestésicos para dormir."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Be wary of anything deeper than your average basement.  Some folks heard "
"scary screams from the ventilation shafts of mines and labs.  Very unsettling "
"screams."
msgstr ""
"Desconfíe de cualquier cosa más profunda que su sótano promedio. Algunas "
"personas escucharon gritos aterradores desde los pozos de ventilación de las "
"minas y laboratorios. Gritos muy inquietantes."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "A screwdriver a day keeps the scurvy away!"
msgstr "¡Un destornillador por día mantendrá el escorbuto en la lejanía!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Hungrier than usual?  Natural oils can help.  Not tasty at all, but who cares "
"when eating your leg is the second option?"
msgstr ""
"¿Más hambriento que de costumbre? Los aceites naturales pueden ayudar. No son "
"nada sabrosos, pero ¿a quién le importa cuando tu segunda opcion es comerte "
"tu pierna?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Terrain can turn the tide of a battle.  Make sure you use it against your "
"enemies, lest it be used against you."
msgstr ""
"El terreno puede cambiar el curso de una batalla. Asegúrate de usarlo contra "
"tus enemigos, no sea que se use contra ti."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Folks that passed by the mine said something about foul smell.  If you plan a "
"visit there consider taking a gas mask with you."
msgstr ""
"La gente que pasó por la mina dijo algo sobre el mal olor. Si planeas una "
"visita allí considera llevar una máscara de gas contigo."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Knowledge is power.  Seriously, just pick up a book."
msgstr "El conocimiento es poder. En serio, sólo coge un libro."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Knowledge is power.  And books are power you can read."
msgstr "El conocimiento es poder. Y los libros son el poder que puedes leer."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Knowledge is power.  But not every book you find contains true knowledge."
msgstr ""
"El conocimiento es poder. Pero no todos los libros que encuentras contienen "
"verdadero conocimiento."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Some days are full of sadness.  Reading can help, if you have the right book."
msgstr ""
"Algunos días están llenos de tristeza. La lectura puede ayudar, si tienes el "
"libro correcto."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Nothing can kill you if everything is already dead.  Well, except cold, "
"hunger, and… never mind."
msgstr ""
"Nada puede matarte si todo está ya muerto. Bueno, excepto el frío, el hambre "
"y... no importa."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I met a girl that insisted that she saw a land shark boring through rock, "
"walls, and dirt alike.  I'd consider it a fable, but I've seen things, and "
"can't just say it's a lie."
msgstr ""
"Conocí a una chica que insistía en que veía a un tiburón de tierra perforando "
"a través de la roca, los muros/paredes y la suciedad por igual. Lo "
"consideraría una fábula, pero he visto cosas, y no puedo decir que sea una "
"mentira."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Boil first, then drink.  Ten men caravan once drank from a spring, and they "
"are now known as a three man caravan."
msgstr ""
"Primero hierve, luego bebe. Una vez una caravana de diez hombres bebió de un "
"manantial, y ahora se les conoce como una caravana de tres hombres."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I've once seen a full duffel bag pass hands five times in a week.  Having a "
"lot of stuff is a moot point if you can't run from zombies."
msgstr ""
"Una vez vi una bolsa de lona llena pasar de manos cinco veces en una semana. "
"Tener un montón de cosas es un punto discutible si no puedes huir de los "
"zombis."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Tim says you can drive a car through a horde of zombies.  Tim is now a "
"zombie.  Any questions?"
msgstr ""
"Tim dice que puedes conducir un coche a través de una horda de zombis. Tim es "
"ahora un zombi. ¿Alguna pregunta?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"They said: go solar, save the environment and yourself.  Well… there is no "
"environment to save now, but one can still save thyself I guess."
msgstr ""
"Dijeron: ve al solar, salva el medio ambiente y a ti mismo. Bueno... no hay "
"ambiente que salvar ahora, pero uno puede salvarse a sí mismo, supongo."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"What's the difference between a good and a bad choke point?  The good one has "
"another back door behind you."
msgstr ""
"¿Cuál es la diferencia entre un buen y un mal punto de obstrucción? El bueno "
"tiene otra puerta trasera detrás de ti."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"You'd be surprised how many items can be disassembled into their components.  "
"A guy around here, McSomething whatever his name is, is a master at this."
msgstr ""
"Te sorprendería saber cuántos artículos pueden ser desmontados en sus "
"componentes. Un tipo de por aquí, McAlgo como se llame, es un maestro en esto."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "A soldering iron can be an aspiring mechanic's best friend."
msgstr "Un soldador de mano es el aspirante a mejor amigo de un mecánico."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I'm fed up with smoked meat, but it lasts so long.  Well… if I had more heart "
"for learning cooking I guess I'd be able to diversify my food without "
"sacrificing its shelf life."
msgstr ""
"Estoy harto de la carne ahumada, pero dura mucho tiempo. Bueno... si tuviera "
"más ganas de aprender a cocinar supongo que podría diversificar mi comida sin "
"sacrificar su vida útil."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Tricky Joe was hanged for his inventive ways of killing zombies.  Yeah, "
"burning down a building to smoke few hordes is ok, but burning a whole town "
"with all the loot certainly is not."
msgstr ""
"Tricky Joe fue colgado por sus formas ingeniosas de matar zombis. Sí, quemar "
"un edificio para ahuyentar a unas pocas hordas está bien, pero quemar un "
"pueblo entero con todo el botín ciertamente no lo está."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Mr. Tombstone always said: take nothing with you for the raids, save the "
"space for loot.  He was known as Joe then and he rightfully earned his "
"nickname as the first tombstone 'owner' around this place."
msgstr ""
"El Sr. Tombstone siempre decía: no lleves nada contigo para las incursiones, "
"guarda el espacio para el saqueo. Se le conocía entonces como Joe y se ganó "
"el apodo de ser el primer \"dueño\" de una lápida en este lugar."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"A friend is a second mouth to fill, but when it comes to work four hands are "
"always better than two."
msgstr ""
"Un amigo es una segunda boca que alimentar, pero al momento de trabajar, "
"cuatro manos son mejor que dos."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I was against drugs until I was almost killed by a zombie.  I was hauling my "
"sorry ass away from the horde, with nothing more but some white powder I got "
"from that zombie.  Saved me that time."
msgstr ""
"Estaba en contra de las drogas hasta que casi me mata un zombi. Estaba "
"arrastrando mi lamentable trasero lejos de la horda, con nada más que un "
"polvo blanco que obtuve de ese zombi. Me salvó esa vez."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I knew an elementary school teacher who had to fight his way out of school.  "
"He had to kill a dozen crazed children.  I can't imagine what that does to a "
"person."
msgstr ""
"Conocí a un profesor de primaria que tuvo que luchar para salir de la "
"escuela. Tuvo que matar a una docena de niños enloquecidos. No puedo imaginar "
"lo que eso hace a una persona."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"A thought about explosives: If you can still run, and the explosive hasn't "
"detonated yet, run some more.  No amount of caution is excessive when "
"handling a grenade."
msgstr ""
"Una idea sobre los explosivos: Si todavía puedes correr y el explosivo no ha "
"detonado aún, corre un poco más. Ninguna precaución es excesiva cuando se "
"maneja una granada."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Avoid using launchers in narrow hallways, you might miss."
msgstr "Evita usar lanzadores en pasillos estrechos, podrías fallar."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid "Met a mad chemist once.  She made a battery from a potato… or was it lemon?"
msgstr ""
"Una vez conocí a un químico loco. Hizo una batería con una patata... ¿o era "
"de limón?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Met a mad chemist once.  She made a battery from a potato, and then nobody "
"was willing to eat the potato."
msgstr ""
"Una vez conocí a un químico loco. Hizo una batería con una patata, y entonces "
"nadie estaba dispuesto a comer la patata.Una vez conocí a un químico loco. "
"Hizo una batería con una patata, y entonces nadie estaba dispuesto a comer la "
"patata."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Is it dead yet?  How can you tell if it was dead before and it's dead now?  I "
"prefer asking: are?  *smash*  you?  *smash*  dead?  *smash*  yet?  *smash "
"smash smash*"
msgstr ""
"¿Ya está muerto? ¿Cómo puedes saber si estaba muerto antes y está muerto "
"ahora? Prefiero preguntar: estas *pum* tu *pum* muerto *pum* ya? *pum , pum, "
"pum*"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I hear there's strange big berries around, but why don't I hear first hand if "
"they are filling for their size or not?"
msgstr ""
"He oído que hay extrañas bayas grandes alrededor, pero ¿por qué no escucho de "
"primera mano si llenan su tamaño o no?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I've heard of a gang called The Doctors.  You know, bank robbers wearing "
"stethoscopes.  What are they trying to achieve?  I use paper money to start "
"fires now."
msgstr ""
"He oído hablar de una banda llamada Los Doctores. Ya sabes, ladrones de "
"bancos que usan estetoscopios. ¿Qué están tratando de lograr? Ahora uso papel "
"moneda para hacer fuego."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"You can hole up on a roof if you need to.  Yeah, the rain will fall on your "
"head, but it's harder for the dead to get you there.  Get a tent, a rollmat, "
"a sleeping bag and you're set."
msgstr ""
"Puedes esconderte en un tejado si lo necesitas. Sí, la lluvia caerá sobre tu "
"cabeza, pero es más difícil para los muertos llegar allí. Consigue una tienda "
"de campaña, un tapete, un saco de dormir y listo."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I thought about putting a bag on my dog to carry some of my stuff.  It didn't "
"work, because it was a chihuahua, and it was eaten by a rottweiler.  Should "
"have put some Kevlar on it like those Z9.  Oh well…"
msgstr ""
"Pensé en ponerle una bolsa a mi perro para llevar algunas de mis cosas. No "
"funcionó, porque era un chihuahua, y se lo comió un rottweiler. Debí ponerle "
"un poco de Kevlar encima como esos Z9. Pero bueno..."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Stuff from zombies is filthy but perfectly fine otherwise.  Using soap or "
"other detergents won't hurt you.  Quick wash and you're equipped for days."
msgstr ""
"Las cosas de los zombis son asquerosas, pero por lo demás están perfectamente "
"bien. Usar jabón u otros detergentes no te hará daño. Un lavado rápido y "
"estarás equipado para días."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Civilization has made a step back in time, so let's learn from the past.  No "
"fridges?  Build a root cellar or keep food cool in the basement.  No guns?  "
"Make a pointy stick or a cudgel, and work from there.  The end of the world "
"is not the end, it seems."
msgstr ""
"La civilización ha dado un paso atrás en el tiempo, así que aprendamos del "
"pasado. ¿No hay neveras? Construye una bodega de raices o mantén la comida "
"fría en el sótano. ¿No hay armas? Haz un palo puntiagudo o una porra, y "
"trabaja a partir de ahí. Parece que el fin del mundo no es el fin."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Hey, if you happen to find a set of two two-way radios, give one to me and we "
"will be able to talk while being away from each other."
msgstr ""
"Oye, si por casualidad encuentras un juego de radios bidireccionales, dame "
"una y podremos hablar mientras estamos lejos el uno del otro."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If I had the skill to do it, I'd build a boat and sail down the river.  Maybe "
"even towards the ocean.  Or make an amphibious vehicle that could drive on "
"land too.  That would be useful."
msgstr ""
"Si tuviera la habilidad de hacerlo, construiría un barco y navegaría por el "
"río. Tal vez incluso hacia el océano. O haría un vehículo anfibio que también "
"podría conducir en tierra. Eso sería útil."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I sink like a rock in water, but I once used a scuba tank to cross a river "
"that had no bridge nearby."
msgstr ""
"Me hundo como una roca en el agua, pero una vez usé un tanque de buceo para "
"cruzar un río que no tenía un puente cerca."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Can you imagine?  I've heard of people digging graves for loot.  Whole cities "
"lay dead for the taking and they dig graves!  Madness!"
msgstr ""
"¿Te imaginas? He oído hablar de gente que cava tumbas para saquear. ¡Ciudades "
"enteras yacen muertas por el botín y cavan tumbas! ¡Locos!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"When I broke a leg few years ago they had this great machine at the hospital "
"that set the bones in place.  I'd hate to break a limb in this apocalypse, "
"but it's something to remember.  You never know."
msgstr ""
"Cuando me rompí una pierna hace unos años, tenían una gran máquina en el "
"hospital que colocaba los huesos en su lugar. Odiaría romperme un miembro en "
"este apocalipsis, pero es algo para recordar. Nunca se sabe."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"You, me, and another pair of hands and we might even think of settling down.  "
"Making a base of our own.  A bastion of hope in the apocalypse.  Think of it."
msgstr ""
"Tú, yo y otro par de manos y podríamos incluso pensar en sentar cabeza. Hacer "
"una base propia. Un bastión de esperanza en el apocalipsis. Piensa en ello."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Hey if you are leading, just tell me what to do.  You want me to shoot, go "
"melee, use grenades?  I can adjust to your style of fighting."
msgstr ""
"Oye, si estás dirigiendo, sólo dime qué hacer. ¿Quieres que dispare,  vaya c. "
"a c., que use granadas? Puedo adaptarme a tu estilo de lucha."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Everything seems to mutate nowadays.  Even survivors.  I wonder if I would "
"look good with bunny ears?  Would I hear better?"
msgstr ""
"Todo parece mutar hoy en día. Incluso los supervivientes. Me pregunto si me "
"vería bien con orejas de conejo. ¿Oiría mejor?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Everything seems to mutate nowadays.  Even survivors.  Do you think I'd still "
"look good if I had piranha teeth?"
msgstr ""
"Todo parece mutar hoy en día. Incluso los supervivientes. ¿Crees que todavía "
"me vería bien si tuviera dientes de piraña?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Everything seems to mutate nowadays.  Even survivors.  You think I'd look "
"good with thorns growing from my face?"
msgstr ""
"Todo parece mutar hoy en día. Incluso los supervivientes. ¿Crees que me vería "
"bien con espinas creciendo en mi cara?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Everything seems to mutate nowadays.  Even survivors.  If my eyeballs began "
"shooting lasers do you think I would still be able see?"
msgstr ""
"Todo parece mutar hoy en día. Incluso los supervivientes. Si mis ojos "
"empezaran a disparar láseres, ¿crees que todavía sería capaz de ver?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Everything seems to mutate nowadays.  Even survivors.  I wonder how I would "
"look with antlers?  Hats would be out of the question…"
msgstr ""
"Todo parece mutar hoy en día. Incluso los supervivientes. Me pregunto cómo me "
"vería con la cornamenta. Los sombreros estarían fuera de discusión..."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Winter is a harsh lady.  You need fire to survive, to heat yourself and your "
"water and food.  Keep a cooking device to melt what is frozen, and a thermos "
"for the liquids."
msgstr ""
"El invierno es una dama dura. Necesitas fuego para sobrevivir, para "
"calentarte a ti mismo y a agua y comida. Mantengo un aparato de cocina para "
"derretir lo que está congelado, y un termo para los líquidos."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"There is not much gas left for the vehicles.  If I'd plan for the long run, "
"I'd consider learning about steam engines, or maybe making biodiesel."
msgstr ""
"No queda mucha gasolina para los vehículos. Si planeara a largo plazo, "
"consideraría aprender sobre motores de vapor, o tal vez hacer biodiesel."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Heard a rumor that few cities were evacuated to a place that's not on the "
"maps.  Tough luck finding them now.  But perhaps they don't want to be found. "
" Or worse - perhaps you don't know that you don't want to find them either, "
"if you catch my drift."
msgstr ""
"Escuché un rumor de que pocas ciudades fueron evacuadas a un lugar que no "
"está en los mapas. Mala suerte para encontrarlas ahora. Pero tal vez no "
"quieran ser encontradas. O peor, tal vez no sepas que tampoco quieres "
"encontrarlas, si me entiendes."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Heard a rumor about a lady on rollerblades with a fire extinguisher strapped "
"to her back.  Zipping around, hardly wearing no clothes, smashing cannibals "
"in the face with a baseball bat.  Don't that beat all?"
msgstr ""
"Escuché un rumor sobre una señora en patines con un extintor de incendios "
"atado a su espalda. Andando por ahí, sin apenas ropa, golpeando a los "
"caníbales en la cara con un bate de béisbol. ¿No es eso lo mejor de todo?"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Ok, some weird shit now.  Before we met I saw a knight.  No, I'm fine under "
"the hood.  A guy in a full medieval armor was cornered by some zombies.  Much "
"to be said, but half an hour later, he was still alive.  Guess you can take a "
"punch being a walking tin can."
msgstr ""
"Ok, un cosa rara ahora. Antes de conocernos vi a un caballero. No, no estoy "
"como una cabra. Un tipo con una armadura medieval completa fue acorralado por "
"unos zombis. No hay mucho que decir, pero media hora después, todavía estaba "
"vivo. Supongo que puedes soportar un golpe siendo una lata andante."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"If you're into electronics, you may try to make a noise emitter from a "
"talking doll, or something that has a speaker.  Why?  To distract the "
"zombies, of course."
msgstr ""
"Si te gusta la electrónica, puedes intentar hacer un emisor de ruido de un "
"muñeco que habla, o algo que tenga un altavoz. ¿Por qué? Para distraer a los "
"zombis, por supuesto."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"A friend of mine was a hunter and showed me once how to butcher properly.  "
"You need a flat clean surface to place the products, a rack to hang the "
"carcass in the air, and a good knife.  If you're in a forest you may use a "
"tree and a rope.  Big game might require a saw too."
msgstr ""
"Un amigo mío era cazador y me enseñó una vez cómo hacer una cortar carne "
"correctamente. Se necesita una superficie plana y limpia para colocar los "
"productos, un estante para colgar el cadáver en el aire, y un buen cuchillo. "
"Si estás en un bosque puedes usar un árbol y una soga. La caza mayor también "
"puede requerir una sierra."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"A friend of mine was a hunter and told me, that if you field dress a corpse, "
"it will stay fresh a bit longer."
msgstr ""
"Un amigo mío era cazador y me dijo que si se viste un cadáver en el campo, se "
"mantendrá fresco un poco más."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Look at the sky before you go for adventure.  You will know what weather to "
"expect.  It's nothing compared to the old meteorology and satellite pictures, "
"but at least you may know if you need the umbrella."
msgstr ""
"Mira al cielo antes de ir a la aventura. Sabrás qué tiempo esperar. No es "
"nada comparado con la vieja meteorología y las imágenes de satélite, pero al "
"menos sabrás si necesitas el paraguas."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"Be extra careful on roads.  They are easy to travel on, but occasional "
"minefields or a road block can make you feel sorry in an instant.  I've even "
"seen a tank once.  I ran away like never before."
msgstr ""
"Extreme las precauciones en las carreteras. Es fácil circular por ellas, pero "
"los campos de minas ocasionales o un bloqueo de carretera pueden hacer que te "
"arrepientas en un instante. Una vez incluso vi un tanque. Salí corriendo como "
"nunca."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"I know it's not best of times, but try to sleep well.  You're not yourself if "
"you're sleep deprived.  Grab a pillow and a blanket.  If you can't, even a "
"teddy bear under your head and a pile of clothes to keep you warm can make a "
"difference.  And pick a spot well, even a chair or a bench is better than a "
"cold ground."
msgstr ""
"Sé que no es el mejor momento, pero trata de dormir bien. No eres tú mismo si "
"estás privado de sueño. Coge una almohada y una manta. Si no puedes, incluso "
"un osito de peluche bajo tu cabeza y un montón de ropa para mantenerte "
"caliente puede marcar la diferencia. Y escoge bien un lugar, incluso una "
"silla o un banco es mejor que un suelo frío."

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"There's no rule against wearing more than one set of pants.  Well, I mean, "
"there probably is, but nothing stopping you from breaking it!"
msgstr ""
"No hay ninguna regla que prohíba usar más de un juego de pantalones. Bueno, "
"quiero decir, probablemente la haya, ¡pero nada te impide romperla!"

#: data/json/npcs/hints.json
#. ~ Snippet in category "hint"
msgid ""
"There are two ways of throwing grenades.  The smart one is throwing from "
"behind a corner.  The less smart one involves getting shot while throwing in "
"the open and being torn apart by the resulting explosion."
msgstr ""
"Hay dos formas de lanzar granadas. La inteligente consiste en arrojarlas "
"desde detrás de una esquina. La menos inteligente consiste en recibir un "
"disparo mientras se arroja al aire libre y ser destrozado por la explosión "
"resultante."

#: data/json/npcs/missiondef.json
#. ~ Mission name
msgid "Follow Sarcophagus Team"
msgstr "Seguir Equipo de Sarcófago"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid "You wouldn't believe what I found…"
msgstr "No creerías lo que encontré..."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid ""
"Holy hell, the crash you recovered the black box from wasn't as old as I "
"thought.  Check this out, it was on its approach to pick up a team sent to "
"secure and destroy something called a 'Hazardous Waste Sarcophagus' in the "
"middle of nowhere.  If the bird never picked up the team then we may still "
"have a chance to meet up with them.  It includes an access code for the "
"elevator and an encoded message for the team leader, I guess.  If we want to "
"join up with what remains of the government then now may be our only chance."
msgstr ""
"¡Demonios! El accidente del que recuperaste la caja negra no es tan antiguo "
"como pensaba. Mira esto, estaba de camino a recoger un equipo enviado a "
"asegurar y destruir algo llamado \"Sarcófago de Residuos Peligrosos\", en "
"mitad de la nada. Si la aeronave no los recogió quizá todavía tengamos la "
"oportunidad de encontrarlos. Contiene un código de acceso para el ascensor, y "
"un mensaje encripado para el líder del equipo, creo. Si queremos reunirnos "
"con lo que queda del gobierno puede que sea nuestra única oportunidad."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid "Fuck ya, America!"
msgstr "¡Joder, América!"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid "Are you going to forfeit your duty when the country needs you the most?"
msgstr "¿Vas a renunciar tu deber cuando el país más te necesita?"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid ""
"If there is a military team down there then we better go in prepared if we "
"want to impress them.  Carry as much ammo as you can and prepare to ditch "
"this place if they have a second bird coming to pick them up."
msgstr ""
"Si hay un equipo militar allí abajo entonces mejor vamos preparados si "
"queremos impresionarlos. Llévate tanta munición como puedas y prepara una "
"zanja en este lugar si tienen un segundo pájaro que venga a recogerlos."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid "Having any trouble following the map?  Remember to search underground."
msgstr "¿Tienes problemas para seguir el mapa? Recuerda buscar bajo tierra."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid "Maybe these things are what remains of the team we were searching for…"
msgstr "Tal vez estas cosas son lo que queda del equipo que estábamos buscando..."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid "What?!  I out'ta whip your ass."
msgstr "¿Qué? Te voy a dar una paliza."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Follow Sarcophagus Team"
msgid "Damn, we were so close."
msgstr "Mierda, hemos estado cerca."

#: data/json/npcs/missiondef.json
#. ~ Mission name
msgid "Find Inhaler"
msgstr "Encontrar inhalador"

#: data/json/npcs/missiondef.json data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
#. ~ Dialogue line in mission "Find Spurge Tea"
msgid "I'm… short… of breath…"
msgstr "Me falta... el aliento..."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
msgid "I'm asthmatic.  I need you to get an inhaler for me…"
msgstr "Soy asmático. Necesito que me consigas un inhalador..."

#: data/json/npcs/missiondef.json data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
#. ~ Dialogue line in mission "Find Antibiotics"
#. ~ Dialogue line in mission "Find Spurge Tea"
msgid ""
"Oh, thank god, thank you so much!  I won't last more than a couple of days, "
"so hurry…"
msgstr ""
"Oh, gracias a Dios, ¡muchas gracias! No duraré más de un par de días, así que "
"apúrate..."

#: data/json/npcs/missiondef.json data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
#. ~ Dialogue line in mission "Find Antibiotics"
#. ~ Dialogue line in mission "Find Spurge Tea"
#. ~ Dialogue line in mission "Find Cattail Jelly"
msgid "What?!  Please, I'll be dead soon without your help!"
msgstr "¡¿Qué?! ¡Por favor, moriré pronto sin tu ayuda!"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
msgid ""
"There's a town nearby.  Check pharmacies; it'll be in the back with the good "
"stuff."
msgstr ""
"Hay un pueblo cerca. Comprueba las farmacias; estará en la parte de atrás con "
"las cosas buenas."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
msgid "Find any inhaler yet?"
msgstr "¿Encontraste algún inhalador?"

#: data/json/npcs/missiondef.json data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
#. ~ Dialogue line in mission "Find Antibiotics"
#. ~ Dialogue line in mission "Find Spurge Tea"
#. ~ Dialogue line in mission "Find Cattail Jelly"
msgid "Oh thank god!  I'll be right as rain in no time."
msgstr "¡Oh, gracias a Dios! Estaré bien como la lluvia en poco tiempo."

#: data/json/npcs/missiondef.json data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
#. ~ Dialogue line in mission "Find Antibiotics"
#. ~ Dialogue line in mission "Kill Zombie Mom"
#. ~ Dialogue line in mission "Find Lost Dog"
#. ~ Dialogue line in mission "Find Spurge Tea"
#. ~ Dialogue line in mission "Find Cattail Jelly"
#. ~ Dialogue line in mission "Kill Zombie Bear"
msgid "What?!  You're lying, I can tell!  Ugh, forget it!"
msgstr "¡¿Qué?! ¡Estás mintiendo, me doy cuenta! ¡Ah, olvidate!"

#: data/json/npcs/missiondef.json data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Inhaler"
#. ~ Dialogue line in mission "Find Antibiotics"
#. ~ Dialogue line in mission "Find Spurge Tea"
#. ~ Dialogue line in mission "Find Cattail Jelly"
msgid "How am I not dead already?!"
msgstr "¡¿Cómo no estoy muerto todavía?!"

#: data/json/npcs/missiondef.json
#. ~ Mission name
msgid "Find Antibiotics"
msgstr "Encontrar Antibióticos"

#: data/json/npcs/missiondef.json data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Antibiotics"
#. ~ Dialogue line in mission "Find Cattail Jelly"
msgid "This infection is bad, totally bad…"
msgstr "Esta infección es grave, absolutamente grave..."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Antibiotics"
msgid "I'm infected.  Badly.  I need you to get some good antibiotics for me…"
msgstr "Estoy infectado. Gravemente. Necesito que me consigas algunos antibióticos..."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Antibiotics"
msgid ""
"There's a town nearby.  Check pharmacies; it'll be in the back, either "
"antibiotics or broad-spectrum antibiotics will do."
msgstr ""
"Hay un pueblo cerca. Mira en las farmacias; estará en la parte de atrás, con "
"antibióticos o antibióticos de amplio espectro bastará."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Antibiotics"
msgid "Find any antibiotics yet?"
msgstr "¿Has encontrado algún antibiótico?"

#: data/json/npcs/missiondef.json
#. ~ Mission name
msgid "Retrieve Military Black Box"
msgstr "Recuperar Caja Negra Militar"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
msgid "We've got the flag, now we need to locate US forces."
msgstr "Tenemos la bandera, ahora tenemos que localizar a las fuerzas de EE.UU."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
msgid ""
"We have the flag but now we need to locate US troops to see what we can do to "
"help.  I haven't seen any but I'm figurin' one of those choppers that were "
"flyin' round during th' outbreak would have a good idea.  If you can get me a "
"black box from one of the wrecks I'll look into where we might open 'er at."
msgstr ""
"Tenemos la bandera, pero ahora necesitamos localizar tropas estadounidenses "
"para ver qué podemos hacer para ayudar. No he visto ninguna, pero me imagino "
"que uno de esos helicópteros que volaban por ahí durante el estallido tendría "
"una buena idea. Si puedes conseguirme una caja negra de uno de los restos, "
"miraré dónde podríamos abrirla."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid "Fuck yeah, America!"
msgstr "¡Sí, joder, Estados Unidos!"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid "Do you have any better ideas?"
msgstr "¿Tienes alguna idea mejor?"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
msgid ""
"Survivors were talkin' 'bout seeing 'em falling out of the sky but I don't "
"know where.  If I were a pilot I'd avoid crash landing in a city or forest "
"though.  Black boxes are housed in the tail to survive the crash so check "
"there when you do find one.  Now get to it!"
msgstr ""
"Los supervivientes hablaban de verlos caer del cielo, pero no sé dónde. Si yo "
"fuera piloto, evitaría aterrizar en una ciudad o en un bosque. Las cajas "
"negras se alojan en la cola para sobrevivir al accidente, así que compruébalo "
"cuando encuentres una. ¡Ahora, manos a la obra!"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid "How 'bout that black box?"
msgstr "¿Qué hay de esa caja negra?"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
msgid "America, fuck yeah!"
msgstr "¡Estados Unidos, joder si!"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid "What?!  I oughta whip your ass."
msgstr "¡¿Qué?! Debería partirte la cara."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Military Black Box"
msgid "Damn, I'll have to find 'er myself."
msgstr "Maldita sea, tendré que encontrarla yo mismo."

#: data/json/npcs/missiondef.json
#. ~ Mission name
msgid "Retrieve Black Box Transcript"
msgstr "Recuperar Transcr. de Caja Negra"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid "With the black box in hand, we need to find a lab."
msgstr "Con la caja negra, tenemos que encontrar un laboratorio."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid ""
"Thanks to your searching we've got the black box but now we need to have a "
"look inside her.  Now, most buildings don't have power anymore but there are "
"a few that might be of use.  Have you ever seen one of those science labs "
"that have popped up in the middle of nowhere?  Them suckers have a glowing "
"terminal out front so I know they have power somewhere inside 'em.  If you "
"can get inside and find a computer lab that still works you ought to be able "
"to find out what's in the black box."
msgstr ""
"Gracias a tu búsqueda hemos conseguido la caja negra pero ahora necesitamos "
"echar un vistazo dentro de ella. La mayoría de los edificios ya no tienen "
"electricidad, pero hay algunos que podrían ser de utilidad. ¿Alguna vez has "
"visto uno de esos laboratorios científicos que han aparecido en mitad de la "
"nada? Esos mamones tienen un terminal encendido en el frente, así que sé que "
"tienen electricidad en algún lugar de su interior. Si puedes entrar y "
"encontrar un laboratorio informático que todavía funcione, deberías poder "
"averiguar qué hay en la caja negra."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid ""
"When I was playin' with the terminal for the one I ran into it kept asking "
"for an ID card.  Finding one would be the first order of business."
msgstr ""
"Cuando estaba jugando con el terminal este no paraba de pedirme la tarjeta de "
"identidad. Encontrar una sería la primera tarea a realizar."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid ""
"America, fuck yeah!  I was in the guard a few years back so I'm confident I "
"can make heads-or-tails of these transmissions."
msgstr ""
"América, ¡joder sí! Estuve en la reserva hace unos años, así que estoy seguro "
"de que puedo entender estas transmisiones."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Retrieve Black Box Transcript"
msgid "Damn, I maybe we can find an egg-head to crack the terminal."
msgstr "Mierda, puede que encontremos algún nerd que hackee la terminal."

#: data/json/npcs/missiondef.json
#. ~ Mission name
msgid "Find Deputy Badge"
msgstr "Encontrar Placa de Ayudante"

#: data/json/npcs/missiondef.json data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Deputy Badge"
#. ~ Dialogue line in mission "Find Corporate Accounts"
#. ~ Dialogue line in mission "Retrieve Deposit Box"
#. ~ Dialogue line in mission "Find Secrets in Leather Journal"
msgid "Those twisted snakes…"
msgstr "Esas serpientes retorcidas..."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Deputy Badge"
msgid ""
"I hope you will find use from what you got out of the deposit box but I also "
"have another job for you that might lead you to an opportunity to deal out "
"justice for those who cannot.  First things first, we can't just look like "
"ruffians.  Find us a deputy badge, easy enough?"
msgstr ""
"Espero que encuentre uso a lo que sacastes de la caja de depósito, pero "
"también tengo otro trabajo para ti que te podría llevar a una oportunidad de "
"hacer justicia para los que no pueden. Lo primero es lo primero, no podemos "
"parecer rufianes. Encuéntranos una placa de ayundante de sheriff, "
"¿suficientemente fácil?"

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Deputy Badge"
msgid "I'd check the police station."
msgstr "Yo me fijaría en la comisaría."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Deputy Badge"
msgid ""
"We're also official… just hang in there and I'll show you what we can really "
"do."
msgstr ""
"También somos oficiales... sólo aguanta y te mostraré lo que realmente "
"podemos hacer."

#: data/json/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Deputy Badge"
msgid "They shouldn't be that hard to find… should they?"
msgstr "No deberían ser tan difíciles de encontrar... ¿verdad?"

#: data/json/npcs/godco/godco_missions.json data/json/npcs/missiondef.json
#: data/mods/innawood/npcs/missiondef.json
#. ~ Dialogue line in mission "Find Deputy Badge"
#. ~ Dialogue line in mission "Find Corporate Accounts"
#. ~ Dialogue line in mission "Find Patient Records"
#. ~ Dialogue line in mission "Find Weather Log"
