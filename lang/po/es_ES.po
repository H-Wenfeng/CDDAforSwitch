msgid_plural "bronze spears"
msgstr[0] "lanza de bronce"
msgstr[1] "lanzas de bronce"
msgstr[2] "lanzas de bronce"

#: data/json/items/melee/spears_and_polearms.json
#. ~ Description of "bronze spear"
msgid "A forged spear with a bronze head."
msgstr "Una lanza forjada con la punta de bronce."

#: data/json/items/melee/spears_and_polearms.json
#. ~ Item name
msgid "poleaxe"
msgid_plural "poleaxes"
msgstr[0] "alabarda"
msgstr[1] "alabardas"
msgstr[2] "alabardas"

#: data/json/items/melee/spears_and_polearms.json
#. ~ Description of "poleaxe"
msgid ""
"A polearm with an axe head, a small hammer on the back, and a short "
"dagger-like spike on top.  It's less heavy than most polearms and has a "
"smaller head, making it slightly quicker."
msgstr ""
"Un arma de asta con cabeza de hacha, un pequeño martillo en la parte trasera "
"y una pequeña daga en la parte superior. Es menos pesada que la mayoría de "
"las armas de asta y tiene una cabeza más pequeña, lo que la hace ligeramente "
"más rápida."

#: data/json/items/melee/spears_and_polearms.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
#. ~ Item name
msgid "ji"
msgid_plural "ji"
