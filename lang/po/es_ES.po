msgstr ""
"Un dinosaurio parecido a un rinoceronte con una cresta ósea y un pico afilado "
"capaz de caminar sobre dos patas y cuatro."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "zuniceratops"
msgid_plural "zuniceratops"
msgstr[0] "zuniceratops"
msgstr[1] "zuniceratops"
msgstr[2] "zuniceratops"

