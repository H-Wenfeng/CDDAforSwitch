msgstr "Lugar para piezas de repuesto."

#: data/json/loot_zones.json
#. ~ Name of loot zone
msgid "Loot: Tool Magazines"
msgstr "Cargadores de Herramientas"

#: data/json/loot_zones.json
#. ~ Description of loot zone "Loot: Tool Magazines"
