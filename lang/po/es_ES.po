#: data/mods/Xedra_Evolved/snippets/dreams.json
#. ~ Snippet in category "XE_BAD_DREAMS"
msgid "A giant spider weaves a web around you, and you can't move as it draws closer."
msgstr ""

#: data/mods/Xedra_Evolved/snippets/dreams.json
#. ~ Snippet in category "XE_BAD_DREAMS"
