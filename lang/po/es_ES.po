msgstr[0] "cepillo eléctrico de diente"
msgstr[1] "cepillos de dientes eléctricos"
msgstr[2] "cepillos de dientes eléctricos"

#: data/json/items/generic/bathroom_house.json
#. ~ Description of "electric toothbrush"
msgid "A plastic electric toothbrush."
msgstr "Un cepillo de dientes eléctrico de plástico."

#: data/json/items/generic/bathroom_house.json
