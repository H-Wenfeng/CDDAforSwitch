msgid_plural "solar backpacks (unfolded)"
msgstr[0] "mochila solar (desplegada)"
msgstr[1] "mochilas solares (desplegadas)"
msgstr[2] "mochilas solares (desplegadas)"

#: data/json/items/tool_armor.json
#. ~ Description of "solar backpack (unfolded)"
msgid ""
"An unfolded array of portable solar panels, ready to push some power into an "
"active cable charger system CBM."
msgstr ""
"Un conjunto desplegado de paneles solares portátiles, listos para suministrar "
"energía a un sistema de carga por cable activo MBC."

