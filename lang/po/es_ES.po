msgid_plural "Mosin-Nagant M44-EBR carbines"
msgstr[0] "carabina Mosin-Nagant M44-EBR"
msgstr[1] "carabinas Mosin-Nagant M44-EBR"
msgstr[2] "carabinas Mosin-Nagant M44-EBR"

#: data/json/items/gun/762R.json
