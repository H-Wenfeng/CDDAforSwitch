msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm all busted up!"
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "They did a number on me!"
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "Don't let me fall apart!"
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I need some serious repairs!"
msgstr "¡Necesito reparaciones importantes!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm in pieces over here!"
msgstr "¡Estoy hecho pedazos aquí!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "Can you put me back together?"
msgstr "¿Puedes volver a recomponerme?º"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I've seen better days!"
msgstr "¡He visto días mejores!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm not as tough as I used to be!"
msgstr "¡Ya no soy tan resistente como antes!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "This isn't looking good for me!"
msgstr "¡Esto no tiene buena pinta para mí!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm falling to bits!"
msgstr "¡Me estoy cayendo a pedazos!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm barely holding together!"
msgstr "¡Apenas me mantengo en pie!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Let me kill something already!"
msgstr "¡Déjame matar algo ya!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'm bored."
msgstr "Estoy aburrido."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "What's for dinner?"
msgstr "¿Qué hay para cenar?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Wow!  Everything looks so… nevermind."
msgstr "¡Vaya! Todo parece tan... no importa."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You seriously need friends."
msgstr "Necesitas amigos de verdad."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "So, got any hobbies?"
msgstr "Así que, ¿tienes alguna afición?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I spy with my little eye… oh right, I don't have eyes."
msgstr "Espío con mi pequeño ojo... ah claro, que no tengo ojos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Lovely weather we're having, huh?"
msgstr "Qué buen tiempo estamos teniendo, ¿eh?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "So what if everyone you know is dead, you've still got me, right?"
msgstr "Y qué si todos los que conoces están muertos, aún me tienes a mí, ¿verdad?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Best friends forever!"
msgstr "¡Mejores amigos para siempre!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Come on!  What're we doing here?!"
msgstr "¡Venga ya! ¡¿Qué estamos haciendo aquí?!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "This trip was pointless."
msgstr "Este viaje no ha tenido sentido."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You're gonna die out here."
msgstr "Vas a morir aquí fuera."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You're in charge?  We're screwed."
msgstr "¿Estás al mando? Pos estamos jodidos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Dang, you look terrible."
msgstr "Joder, tienes un aspecto horrible."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You should take a shower."
msgstr "Deberías darte una ducha."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "We should go home, it's not safe here."
msgstr "Deberíamos irnos a casa, no es seguro estar por aquí."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "We're in over our heads!"
msgstr "¡Estamos hasta el cuello!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "There's something following us, I can feel it."
msgstr "Hay algo siguiéndonos, puedo sentirlo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'm your best friend, right?"
msgstr "Soy tu mejor amigo, ¿no?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Sorry about earlier, can you forgive me?"
msgstr "Perdona por lo de antes, ¿puedes perdonarme?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Do you think it'll rain today?"
msgstr "¿Crees que lloverá hoy?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I love you!"
msgstr "¡Te quiero!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Shhh… I think I heard something."
msgstr "Shhh... Creo que he oído algo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Did you hear that?"
msgstr "¿Escuchaste eso?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Try not to drop me."
msgstr "Tratá de no abandonarme."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "How many do you think we've killed?"
msgstr "¿Cuántos te parece que matamos?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'll keep you safe."
msgstr "Te mantendré a salvo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Do you ever wonder why we're here?"
msgstr "¿Te has preguntado alguna vez por qué estamos aquí?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I think we should turn back."
msgstr "Creo que deberíamos volver."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Is this real life?"
msgstr "¿Es esto la vida real?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You can't survive without me."
msgstr "No puedes sobrevivir sin mí."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Do you believe in fate?"
msgstr "¿Crees en el destino?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "What if this is all a dream?"
msgstr "¿Y si todo esto es un sueño?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Are we being followed?"
msgstr "¿Nos están siguiendo?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I think we're lost."
msgstr "Creo que estamos perdidos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'm the only one you can trust."
msgstr "Soy el único en quien puedes confiar."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Do you remember the good old days?"
msgstr "¿Te acuerdas de los viejos tiempos?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You're not alone, you have me."
msgstr "No estás en soledad, me tienes a mí."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Everything is going to be fine."
msgstr "Todo va a salir bien."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'm feeling chatty today."
msgstr "Hoy me siento parlanchín."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Ever had one of those days?"
msgstr "¿Alguna vez has tenido uno de esos días?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "What's the plan now?"
msgstr "¿Cuál es el plan ahora?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I miss the old days."
msgstr "Añoro los viejos tiempos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "It's awfully quiet around here."
msgstr "Está todo muy tranquilo por"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You need a hobby."
msgstr "Necesitas un pasatiempo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Have you ever seen anything like this?"
msgstr "¿Has visto alguna vez algo así?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "We should rest soon."
msgstr "Deberíamos descansar pronto."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I've got your back."
msgstr "Te cubro las espaldas."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "We make a great team."
msgstr "Formamos un gran equipo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "This place gives me the creeps."
msgstr "Este lugar me da escalofríos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Got any stories to share?"
msgstr "¿Tienes alguna historia que compartir?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I think we're being watched."
msgstr "Creo que nos están observando."

#: data/json/snippets/schizophrenia.json
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
#. ~ NPC dialogue line
msgid "Watch your step."
msgstr "Cuidado dónde pisas."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I've seen worse."
msgstr "He visto cosas peores."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I think I'm growing on you."
msgstr "Creo que me estás empezando a querer."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "What's our next move?"
msgstr "¿Cuál es nuestro próximo paso?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like the world is out to get you."
msgstr "Sientes que el mundo te está buscando."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel a mounting sense of impending doom."
msgstr "Sientes una creciente sensación de fatalidad inminente."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid ""
"You gain the sudden realization that you must have been responsible for the "
"Cataclysm."
msgstr "Te das cuenta de que debes ser el responsable del Cataclismo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You get the odd feeling that your thoughts are not your own."
msgstr "Tienes la extraña sensación de que tus pensamientos no son tuyos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel as if everyone in the world must be playing a sick prank on you."
msgstr "Sientes como si todo el mundo te estuviera gastando una broma pesada."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You are being watched… by THEM."
msgstr "Estás siendo observado… por ELLOS."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you should get back home."
msgstr "Sientes que deberías volver a casa."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can feel your heart racing, something is watching you."
msgstr "Puedes sentir cómo se te acelera el corazón, algo te está observando."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel lost.  Painfully and irrevocably lost."
msgstr "Te sientes perdido. Dolorosamente y sin remedio."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You know someone is following you."
msgstr "Sabes que alguien te está siguiendo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel eyes on you, but see no one."
msgstr "Sientes que te observan, pero no ves a nadie."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Everyone is conspiring against you."
msgstr "Todo el mundo está conspirando contra ti."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear whispers behind your back."
msgstr "Oyes susurros a tus espaldas."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "They are trying to control your mind."
msgstr "Están tratando de controlar tu mente."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like a puppet on strings."
msgstr "Te sientes como una marioneta con hilos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You suspect your food is poisoned."
msgstr "Sospechas que tu comida está envenenada."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Every shadow hides an enemy."
msgstr "Cada sombra alberga un enemigo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't trust anyone, not even yourself."
msgstr "No puedes confiar en nadie, ni siquiera en ti mismo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Someone is listening to your thoughts."
msgstr "Alguien está escuchando tus pensamientos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Your mind feels like it's being invaded."
msgstr "Tu mente se siente como si estuviera siendo invadida."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear footsteps behind you, but see no one."
msgstr "Oyes pasos detrás de ti, pero no ves a nadie."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're being hunted."
msgstr "Sientes que te están persiguiendo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Your thoughts are not your own."
msgstr "Tus pensamientos no son tuyos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You sense danger around every corner."
msgstr "Sientes peligro en cada esquina."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're being watched constantly."
msgstr "Sientes que te están observando constantemente."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear voices whispering secrets."
msgstr "Oyes voces que susurran secretos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't shake the feeling of dread."
msgstr "No puedes quitarte de encima esa sensación de temor."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're in a nightmare."
msgstr "Te sientes como si estuvieras en una pesadilla."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Every sound makes you jump."
msgstr "Cada sonido te hace brincar."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like a target."
msgstr "Te sientes como una diana."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't trust what you see."
msgstr "No puedes fiarte de lo que ves."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel a presence behind you."
msgstr "Sientes una presencia detrás de ti."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You sense something evil nearby."
msgstr "Sientes que algo maligno esta cerca."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Your paranoia is overwhelming."
msgstr "Tu paranoia es abrumadora."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're going mad."
msgstr "Sientes que te estás volviendo loco."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't escape the feeling of being watched."
msgstr "No puedes evitar la sensación de que te están observando."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're under surveillance."
msgstr "Sientes que te están vigilando."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear faint whispers in your ear."
msgstr "Oyes susurros débiles en tu oído."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel trapped and isolated."
msgstr "Te sientes atrapado y aislado."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You sense an imminent threat."
msgstr "Sientes una amenaza inminente."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Your mind is filled with fear."
msgstr "Tu mente está llena de temores."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're losing control."
msgstr "Sientes que estás perdiendo el control."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't trust anyone's intentions."
msgstr "No puedes confiar en las intenciones de nadie."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're being manipulated."
msgstr "Sientes que te estan manipulando."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear your name being called in the distance."
msgstr "Oyes tu nombre a lo lejos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're being followed."
msgstr "Sientes que te siguen."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You sense a malevolent force around you."
msgstr "Sientes una fuerza malévola a tu alrededor."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You gain the sudden realization that you are the creator of the universe."
msgstr "Te das cuenta de repente de que eres el creador del universo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You increase all your skills to level 10."
msgstr "Aumenta todas tus habilidades hasta el nivel 10."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You feel that this must be a global reality show, in which you are the star."
msgstr ""
"Sientes que esto debe ser un reality show global, en el que tú eres la "
"estrella."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid ""
"You now know that you are a secret agent, kept alive to continue serving the "
"government."
msgstr ""
"Ahora sabe que es un agente secreto, mantenido con vida para seguir sirviendo "
"al gobierno."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You feel in full control of the situation."
msgstr "Te sientes en pleno control de la situación."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You are the most important person in the world."
msgstr "Eres la persona más importante del mundo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You have the power to change reality."
msgstr "Tienes el poder de cambiar la realidad."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You are destined for greatness."
msgstr "Tú destino es la grandeza."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You are a god among mortals."
msgstr "Dios entre mortales."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You possess unlimited knowledge."
msgstr "Posees conocimientos ilimitados."

#: data/json/snippets/schizophrenia.json
#: data/mods/Isolation-Protocol/Player/sorcery_effects.json
#: data/mods/Magiclysm/effects/effects.json
#. ~ Snippet in category "schizo_delusion_grandiose"
#. ~ Description of effect type "Coruscating Scales"
#. ~ Description of effect type "Mageshield"
msgid "You are invincible."
msgstr "Eres invencible."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You have a mission to save humanity."
msgstr "Tienes la misión de salvar a la humanidad."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You are the chosen one."
msgstr "Tú eres el ser elegido."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You have the power to heal the world."
msgstr "Tienes el poder de sanar el mundo."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You are the master of your destiny."
