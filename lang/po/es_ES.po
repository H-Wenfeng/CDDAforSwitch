msgid_plural "meat cleavers"
msgstr[0] "cuchillo de carnicería"
msgstr[1] "cuchillos de carnicería"
msgstr[2] "cuchillos de carnicería"

#: data/json/items/tool/knives.json
#. ~ Description of variant "meat cleaver" of item "cleaver"
msgid ""
"A menacing-looking knife with a broad, square-shaped blade.  Its heft and "
"sharpness would make it a very effective melee weapon and an excellent "
"butchering tool."
msgstr ""
"Un cuchillo de aspecto amenazador con una hoja ancha y cuadrada. Su peso y "
"filo lo convierten en un arma c. a c. muy eficaz y en una excelente "
"herramienta para descuartizar."

#: data/json/items/tool/knives.json
#. ~ Variant name of item "cleaver"
msgid "vegetable cleaver"
msgid_plural "vegetable cleavers"
msgstr[0] "cuchillo de verduras"
msgstr[1] "cuchillos de verduras"
msgstr[2] "cuchillos de verduras"

#: data/json/items/tool/knives.json
#. ~ Description of variant "vegetable cleaver" of item "cleaver"
msgid ""
"A menacing-looking knife with a broad, square shaped blade, curved for fast "
"vegetable chopping.  Its heft and sharpness make it a decent weapon as well, "
"although not as good as a meat cleaver."
msgstr ""
"Un cuchillo de aspecto amenazador con una hoja ancha y cuadrada, curvada para "
"cortar verduras rápidamente. Su peso y filo lo convierten en un arma decente, "
"aunque no tan buena como un cuchillo de carnicero."

#: data/json/items/tool/knives.json
#. ~ Item name
msgid "copper knife"
msgid_plural "copper knives"
msgstr[0] "cuchillo de cobre"
msgstr[1] "cuchillos de cobre"
msgstr[2] "cuchillos de cobre"

