msgid_plural "huge radiators"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/mods/Xedra_Evolved/items/inventor/gunmods.json
#. ~ Description of gun mod "huge radiator"
#. ~ Description of "huge radiator"
msgid ""
"Replace the entire radiator in the platform into this hefty and bulky piece "
"of metal, trading a portability of a gun for a massive overheat buffer."
msgstr ""
"Reemplaza el radiador de toda la plataforma por esta pesada y voluminosa "
"pieza de metal, cambiando la portabilidad de un arma por un enorme "
"amortiguador del sobrecalentamiento."

#: data/mods/Xedra_Evolved/items/inventor/gunmods.json
