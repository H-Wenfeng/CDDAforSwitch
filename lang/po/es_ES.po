msgid_plural "baselards"
msgstr[0] "baselardo"
msgstr[1] "baselardos"
msgstr[2] "baselardos"

#: data/json/items/melee/swords_and_blades.json
#. ~ Description of "baselard"
msgid ""
"A medieval dagger forged from rough iron.  It is not the sharpest tool in the "
"shed, but it is certainly one of the largest."
msgstr ""
"Una daga medieval forjada con hierro en bruto. No es la herramienta más "
"afilada del almacén, pero sin duda es una de las más grandes."

#: data/json/items/melee/swords_and_blades.json
#. ~ Item name
msgid "makeshift machete"
msgid_plural "makeshift machetes"
msgstr[0] "machete improvisado"
msgstr[1] "machetes improvisados"
msgstr[2] "machetes improvisados"

#: data/json/items/melee/swords_and_blades.json
#. ~ Description of "makeshift machete"
msgid ""
"A large blade with one end wrapped in duct tape to make a crude handle, "
"making it easier to wield as a rough machete."
msgstr ""
"Una hoja grande con un extremo envuelto en cinta aislante para hacer un mango "
"tosco, lo que facilita su manejo como un machete tosco."

#: data/json/items/melee/swords_and_blades.json
#. ~ Item name
msgid "machete"
msgid_plural "machetes"
msgstr[0] "machete"
msgstr[1] "machetes"
msgstr[2] "machetes"

#: data/json/items/melee/swords_and_blades.json
#. ~ Description of "machete"
msgid ""
"This huge steel knife makes an excellent tool for cutting down large "
"vegetation or other 'obstacles.'"
msgstr ""
"Este enorme cuchillo de acero sirve como una excelente herramienta para "
"cortar grandes vegetaciones y otros 'obstáculos'."

