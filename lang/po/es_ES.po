msgstr[1] "tarjetas de memoria (XEDRA)"
msgstr[2] "tarjetas de memoria (XEDRA)"

#: data/json/items/tool/electronics.json
#. ~ Description of "memory card (XEDRA)"
msgid ""
"A memory card, can be used to store data.  This one has a label on which is "
"written 'XEDRA' followed by a long string of numbers."
msgstr ""
"Una tarjeta de memoria, que se puede usar para almacenar datos. Esta tiene "
"una etiqueta que pone 'XEDRA' seguida de una larga ristra de números."

#: data/json/items/tool/electronics.json
#. ~ Item name
msgid "electrohack"
msgid_plural "electrohacks"
msgstr[0] "electrohackeador"
msgstr[1] "electrohackeadores"
msgstr[2] "electrohackeadores"

#: data/json/items/tool/electronics.json
#. ~ Description of "electrohack"
msgid ""
"This device has many ports attached, allowing it to connect to almost any "
"control panel or other electronic machine (but not computers).  With a little "
"skill, it can be used to crack passwords and more."
msgstr ""
"Este dispositivo tiene acoplados muchos puertos, lo que le permite conectarse "
"a casi cualquier panel de control u otra máquina electrónica (pero no "
"ordenadores). Con un poco de habilidad, se puede utilizar para descifrar "
"contraseñas y mucho más."

#: data/json/items/tool/electronics.json
#. ~ Item name
msgid "Geiger counter (off)"
