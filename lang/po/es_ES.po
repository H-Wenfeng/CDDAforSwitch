msgid_plural "radiation biomonitors"
msgstr[0] "biomonitor dosimétrico"
msgstr[1] "biomonitores dosimétricos"
msgstr[2] "biomonitores dosimétricos"

#: data/json/items/tool_armor.json
#. ~ Description of "radiation biomonitor"
msgid ""
"A small, battery-powered biometric safety device worn on the wrist.  Activate "
"to check your current level of radiation exposure."
msgstr ""
"Un pequeño dispositivo biométrico de seguridad alimentado con batería que se "
"pone en la muñeca. Activar para controlar tu nivel actual de exposición a la "
"radiación."

