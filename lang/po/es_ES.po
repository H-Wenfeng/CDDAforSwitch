#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
msgid "atomic smartphone"
msgid_plural "atomic smartphones"
msgstr[0] "smartphone atómico"
msgstr[1] "smartphones atómicos"
msgstr[2] "smartphones atómicos"

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Description of "atomic smartphone"
msgid ""
"Never charge your phone again with the Rivtech atomic smartphone.  Rated for "
"10 million years of use, this cutting-edge gadget had been on public markets "
"for less than a week when the Cataclysm hit, and their eye-watering price "
"made them a rarity.  It includes an alarm clock, a high-resolution camera, "
"and a bright flashlight."
msgstr ""
"No vuelvas a cargar tu teléfono con el smartphone atómico Rivtech. "
"Clasificado para 10 millones de años de uso, este artilugio de vanguardia "
"había estado en los mercados públicos durante menos de una semana cuando el "
"Cataclismo golpeó, y su alto preco lo hizo una rareza. Incluye un reloj "
"despertador, una cámara de alta resolución y una brillante linterna."

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
msgid "structural imager"
msgid_plural "structural imagers"
msgstr[0] "visualizador estructural"
msgstr[1] "visualizadores estructurales"
msgstr[2] "visualizadores estructurales"

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Description of "structural imager"
msgid ""
"A compact imaging tool, capable of scanning and visualizing objects hiding "
"behind walls, maintenance panels and all other sort of visual barriers.  "
"While normally used to diagnostic potential faults within the internal "
"systems of spaceships, the ability to peer between obstacles grant it obvious "
"surveillance applications.  It can be activated to reveal a small conical "
"area around you."
msgstr ""
"Una herramienta de imagen compacta, capaz de escanear y visualizar los "
"objetos que se esconden detrás de los muros/paredes, los paneles de "
"mantenimiento y todo tipo de barreras visuales. Aunque normalmente se utiliza "
"para diagnosticar posibles fallos en los sistemas internos de las naves "
"espaciales, la capacidad de mirar entre los obstáculos le otorga evidentes "
"aplicaciones de vigilancia. Puede activarse para revelar una pequeña área "
"cónica a tu alrededor."

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
msgid "motion scanner"
msgid_plural "motion scanners"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Description of "motion scanner"
msgid ""
"A handheld motion scanner normally used for pest control within spaceships.  "
"This model features an integrated screen to highlight the location of "
"detected motion.  It must be activated to function."
msgstr ""
"Un escáner de movimiento portátil utilizado normalmente para el control de "
"plagas en naves espaciales. Este modelo cuenta con una pantalla integrada "
"para resaltar la ubicación del movimiento detectado. Debe ser activado para "
"funcionar."

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ "msg" action message of item "motion scanner"
#, c-format
msgid "The %s screen flashes on."
msgstr "La pantalla %s parpadea al encenderse."

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
msgid "motion scanner (on)"
msgid_plural "motion scanners (on)"
msgstr[0] "detector de movimiento (enc.)"
msgstr[1] "detectores de movimiento (enc.)"
msgstr[2] "detectores de movimiento (enc.)"

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Description of "motion scanner (on)"
msgid ""
"This active motion scanner will survey your surroundings every ten seconds "
"and audibly alert you when movement is detected.  Wielding it will accurately "
"reveal the location of motion sources."
msgstr ""

