#: data/mods/MindOverMatter/items/books.json
#. ~ Description of variant "How to Meditate: A Practical Guide to Making
#. Friends with Your Mind" of item "Meditation and You"
msgid ""
"A book on meditation written for a general audience, containing simple "
"techniques on breathing and mindfulness."
msgstr ""

#: data/mods/MindOverMatter/items/books.json
#. ~ Variant name of item "Meditation and You"
msgid "The Wandering Mind: What Medieval Monks Tell Us about Distraction"
msgid_plural "copies of The Wandering Mind: What Medieval Monks Tell Us about Distraction"
