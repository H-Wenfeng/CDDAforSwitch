#: data/mods/Xedra_Evolved/snippets/dreams.json
#. ~ Snippet in category "XE_BAD_DREAMS"
msgid "In a forest in your dream, the trees have eyes that watch your every move."
msgstr ""

#: data/mods/Xedra_Evolved/snippets/dreams.json
#. ~ Snippet in category "XE_BAD_DREAMS"
