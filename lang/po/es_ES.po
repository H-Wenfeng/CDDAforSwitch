msgstr "\"No hagas eso.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_surgeon
msgid "\"You hear that?\""
msgstr "\"¿Escuchaste eso?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Be quiet.\""
msgstr "\"No hagas ruido.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Look out!\""
msgstr "\"¡Cuidado!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Run!\""
msgstr "\"¡Corre!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Hurry!\""
msgstr "\"¡Rápido!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"No!\""
msgstr "\"¡No!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"I'll never forget you.\""
msgstr "\"Nunca te voy a olvidar.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Take his gun, we're going to need it.\""
msgstr "\"Coge su arma, la vamos a necesitar.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"How do we get out of here?\""
msgstr "\"¿Cómo salimos de aquí?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"This place is like a maze.\""
msgstr "\"Este lugar parece un laberinto.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Oh God, I'm the only one left.\""
msgstr "\"Oh dios, soy el último que queda.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Please, I don't want to die.\""
msgstr "\"Por favor, no me quiero morir.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Mom.\""
msgstr "\"Mamá.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Mom, I miss you.\""
msgstr "\"Mamá, te echo de menos.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Me go, you stay.\""
msgstr "\"Yo voy, tú te quedas.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Please, God.\""
msgstr "\"Por favor, dios.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon,
#. mon_vocal_bigfrog
#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_slaver,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
msgid "a gurgling sound."
msgstr "un gorgoteo."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon,
#. mon_vocal_bigfrog
#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_slaver,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
msgid "a choking sound."
msgstr "un sonido de ahogo."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a snapping sound."
msgstr "un chasquido."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "BEEP!"
msgstr "¡BIIP!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a loud hiss."
msgstr "un siseo fuerte."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a loud crackling noise."
msgstr "un chisporroteo fuerte."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a klaxon blaring!"
msgstr "¡un bocinazo!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"EMERGENCY, EMERGENCY!\""
msgstr "\"¡EMERGENCIA, EMERGENCIA!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a static hissing sound."
msgstr "un siseo de estática."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"That creepy abandoned post-apocalyptic lab complex looks safe…\""
msgstr ""
"\"Ese espeluznante complejo de laboratorio post-apocalíptico abandonado "
"parece seguro...\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid ""
"\"Don't worry, it isn't like anything could teleport out of the containment "
"cells.\""
msgstr ""
"\"No te preocupes, no es como si algo pudiera teletransportarse fuera de las "
"celdas de contención.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Hold on, I want to pulp that zombie corpse.\""
msgstr "\"Espera, quiero destrozar ese cadáver de zombi\"."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"What did that thing just hit me with?\""
msgstr "\"¿Con qué me acaba de golpear esa cosa?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"I can barely move.  Run!  Save yourself!\""
msgstr "\"Apenas puedo moverme. ¡Corre! ¡Sálvate!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr "\"Oh,  molusco hijo de puta, vas a caer.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"I… I feel weak…\""
msgstr "\"Yo... me siento débil...\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi-go_surgeon
msgid "\"Oi, dingus, you can't keep me in 'ere.\""
msgstr "\"Oye, zoquete, no puedes mantenerme aquí.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We got a treaty w'yer people, don'we?\""
msgstr "\"Tenemos un tratado con tu gente, ¿no?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"This'll get back t'my bosses, right and so!\""
msgstr "\"¡Se lo contaré a mis jefes, de una vez por todas!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Lemme outta here!\""
msgstr "\"¡Déjame salir de aquí!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We're both scavs, in't we?\""
msgstr "\"Ambos somos carroñeros, ¿no?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Hey look, that one's carrying something.  Let's crack it open and steal it.\""
msgstr "\"Oye, mira, ese lleva algo. Vamos a abrirlo y a robarlo\"."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"G… geddoff me you… you bastard…\""
msgstr "\"S... uelta me... bastardo...\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"GET WELL SOON!\""
msgstr "\"¡PONTE BIEN PRONTO!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
msgid "\"Did-a-chuk?\""
msgstr "\"¿Did-a-chuk?\"  Sonido de un mostruo langosta."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
msgid "\"Dad-a-chak?\""
msgstr "\"Dad-a-chak?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
msgid "\"Dad-a-cham?\""
msgstr "\"¿Dad-a-cham?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
msgid "\"Did-a-chak?\""
msgstr "¿\"Did-a-chak?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
msgid "\"Did-a-chum?\""
msgstr "\"¿Did-a-chum?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
msgid "\"Dad-a-chuk?\""
msgstr "\"¿Dad-a-chuk?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi-go_surgeon
msgid "\"What are you doing?  No!  NO!\""
msgstr "\"¿Qué estás haciendo? No! ¡NO!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi-go_surgeon
msgid "\"Did you see what they did to him?\""
msgstr "\"¿Vistes lo que le hicieron?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi-go_surgeon
msgid "\"Yeah.  I can't believe he stayed alive that long.\""
msgstr "\"Sí. No puedo creer que haya permanecido vivo tanto tiempo.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi-go_surgeon
msgid "\"I think there's something in the air that's keeping us alive.\""
msgstr "\"Creo que hay algo en el aire que nos mantiene vivos.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"Burning… from the inside…\""
msgstr "\" Ardiendo... desde el interior... \""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"This smell… Don't know…\""
msgstr "\"Este olor... No sé...\""

