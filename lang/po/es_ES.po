msgid_plural "mild ESBI plates"
msgstr[0] "placa acero dulce ESBI"
msgstr[1] "placas acero dulce ESBI"
msgstr[2] "placas acero dulce ESBI"

#: data/json/items/armor/ballistic_armor.json
#. ~ Description of "mild ESBI plate"
msgid ""
"A hexagonal piece of mild steel forged into a side plate and padded with "
"synthetic fabric.  While it is more professionally done than scrap plates, it "
"still has a fair amount of jerry-rigging."
msgstr ""
"Una pieza hexagonal de acero dulce forjada en una placa lateral y acolchada "
"con tela sintética. Aunque es más profesional que las placas de chatarra, "
"tiene bastantes apaños."

