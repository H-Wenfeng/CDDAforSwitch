msgstr[1] "smartphones atómicos - Linterna"
msgstr[2] "smartphones atómicos - Linterna"

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
msgid "Wraitheon executive's smartphone"
msgid_plural "Wraitheon executive's smartphones"
msgstr[0] "smartphone de ejecutivo Wraitheon"
msgstr[1] "smartphones de ejecutivos Wraitheon"
msgstr[2] "smartphones de ejecutivos Wraitheon"

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Description of "Wraitheon executive's smartphone"
msgid ""
"Your custom crafted atomic smartphone.  Most notably a confidential "
"executive-level override program allows you to remotely control most robots."
msgstr ""
"Tu smartphone atómico hecho a medida. Lo más notable es que un programa "
"confidencial de sobreescritura a nivel ejecutivo le permite controlar "
"remotamente la mayoría de los robots."

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
