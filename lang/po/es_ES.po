#. ~ Description of monster "lambeosaurus"
msgid ""
"A huge scaly dinosaur with a long stiff tail and hooves.  Has a narrow beak "
"and a tall head crest that looks like a mitten with the thumb pointed up."
msgstr ""
"Un enorme dinosaurio escamoso con una larga cola rígida y pezuñas. Tiene un "
"pico fino y una cresta alta en la cabeza que parece un guante con el pulgar "
"apuntando hacia arriba."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "corythosaurus"
msgid_plural "corythosaurus"
msgstr[0] "corythosaurus"
msgstr[1] "corythosaurus"
msgstr[2] "corythosaurus"

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Description of monster "corythosaurus"
msgid ""
"A huge scaly dinosaur with a thick neck and tail and hooves.  Has a short "
"beak and a tall rounded head crest."
msgstr ""
"Un enorme dinosaurio escamoso con un cuello, una cola gruesa y pezuñas. Tiene "
"un pico corto y una cresta alta y redondeada en la cabeza."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "hypacrosaurus"
msgid_plural "hypacrosaurus"
msgstr[0] "hypacrosaurus"
msgstr[1] "hypacrosaurus"
msgstr[2] "hypacrosaurus"

