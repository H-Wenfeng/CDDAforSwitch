msgstr "Bujías defectuosas"

#: data/json/faults/faults_vehicles.json
#. ~ Description of fault "Faulty glow plugs"
msgid "Help when starting an engine in low ambient temperatures."
msgstr "Ayuda a arrancar un motor con bajas temperaturas ambientales."

#: data/json/faults/faults_vehicles.json
#. ~ Name of a fault
msgid "Active immobilizer"
msgstr "Inmovilizador activo"

#: data/json/faults/faults_vehicles.json
#. ~ Description of fault "Active immobilizer"
msgid ""
"An immobilizer device prevents starting of the vehicle without the "
"appropriate key."
msgstr ""
"Un dispositivo inmovilizador impide el arranque del vehículo sin la llave "
"correspondiente."

#: data/json/faults/faults_vehicles.json
#. ~ Name of a fault
msgid "Faulty diesel pump"
msgstr "Bomba de diesel defectuosa"

#: data/json/faults/faults_vehicles.json
#. ~ Description of fault "Faulty diesel pump"
msgid "Required to pump and pressurize diesel from a vehicle's tank."
msgstr "Necesario para bombear y presurizar el gasóleo del depósito de un vehículo."

#: data/json/faults/faults_vehicles.json
#. ~ Name of a fault
msgid "Expired air filter"
msgstr "Filtro de aire expirado"

#: data/json/faults/faults_vehicles.json
#. ~ Description of fault "Expired air filter"
msgid "An expired filter reduces fuel efficiency and increases smoke production."
msgstr ""
"Un filtro gastado reduce la eficiencia de combustible y aumenta la generación "
