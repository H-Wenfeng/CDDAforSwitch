msgid_plural "hairbrushes"
msgstr[0] "cepillo para el cabello"
msgstr[1] "cepillos para el cabello"
msgstr[2] "cepillos para el cabello"

#: data/json/items/generic/bathroom_house.json
#. ~ Description of "hairbrush"
