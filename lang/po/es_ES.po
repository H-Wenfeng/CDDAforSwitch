msgstr "Practica los conceptos básicos del uso de un dispositivo informático."

#: data/json/recipes/practice/computers.json
#. ~ Practice name
msgid "computer (intermediate)"
msgstr "ordenador (intermedio)"

#: data/json/recipes/practice/computers.json
#. ~ Description of practice "computer (intermediate)"
msgid ""
"Practice using the command line, writing and running scripts making use of "
"common algorithms and data structures."
msgstr ""
"Practical el uso de la linea de comandos, escribir y ejecutar scripts para "
"usar algoritmos comunes y estructuras de datos."

#: data/json/recipes/practice/computers.json
