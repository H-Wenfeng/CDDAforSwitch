msgstr "Tinte Rubio"

#: data/json/effects_on_condition/npc_eocs/appearance_eocs.json
#. ~ EOC option name in effect in EoC "use_hair_dye_kit"
msgid "Blue Dye"
msgstr "Tinte Azul"

#: data/json/effects_on_condition/npc_eocs/appearance_eocs.json
#. ~ EOC option name in effect in EoC "use_hair_dye_kit"
msgid "Brown Dye"
msgstr "Tinte Marrón"

#: data/json/effects_on_condition/npc_eocs/appearance_eocs.json
#. ~ EOC option name in effect in EoC "use_hair_dye_kit"
msgid "Gray Dye"
msgstr "Tinte Gris"

#: data/json/effects_on_condition/npc_eocs/appearance_eocs.json
#. ~ EOC option name in effect in EoC "use_hair_dye_kit"
msgid "Green Dye"
msgstr "Tinte Verde"

#: data/json/effects_on_condition/npc_eocs/appearance_eocs.json
#. ~ EOC option name in effect in EoC "use_hair_dye_kit"
msgid "Red Dye"
msgstr "Tinte Rojo"

#: data/json/effects_on_condition/npc_eocs/appearance_eocs.json
#. ~ EOC option name in effect in EoC "use_hair_dye_kit"
msgid "Pink Dye"
msgstr "Tinte Rosa"

#: data/json/effects_on_condition/npc_eocs/appearance_eocs.json
#. ~ EOC option name in effect in EoC "use_hair_dye_kit"
msgid "White Dye"
msgstr "Tinte Blanco"

#: data/json/effects_on_condition/npc_eocs/appearance_eocs.json
