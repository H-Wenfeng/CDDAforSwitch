msgstr[1] "estetoscopios"
msgstr[2] "estetoscopios"

#: data/json/items/tool_armor.json
#. ~ Description of "stethoscope"
msgid "A medical listening tool.  Use it to listen to things.  Closely."
msgstr "Una herramienta de escucha médica. Usar para escuchar cosas. De cerca."

#: data/json/items/tool_armor.json
#. ~ Item name
