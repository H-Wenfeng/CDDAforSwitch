msgid "Ouch, the cuffs shock you!"
msgstr "¡Ay, las esposas te dan una descarga eléctrica!"

#: src/iuse.cpp:6985
#, c-format
msgid "The %s are clamped tightly on your wrists.  You can't take them off."
msgstr "El %s está cerrado fuertemente en tus muñecas. No te lo puedes sacar."

#: src/iuse.cpp:6988
#, c-format
msgid "The %s have discharged and can be taken off."
msgstr "El %s se descargó y puede ser quitado."

#: src/iuse.cpp:7000
msgid "Create buoy where?"
msgstr "¿Crear boya dónde?"

#: src/iuse.cpp:7012
#, c-format
msgid "The %s, emits a short angry beep."
msgstr "%s, emite un corto y amargo pitido."

#: src/iuse.cpp:7016
#, c-format
msgid "Space warps momentarily as the %s is created."
msgstr "El espacio se retuerce por un momento como si el %s se crease."

#: src/iuse.cpp:7042
