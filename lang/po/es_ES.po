#: data/json/starting_missions.json
#. ~ Mission name
msgid "Finish your mission"
msgstr "Terminar tu misión"

#: data/json/starting_missions.json
#. ~ Description of mission "Finish your mission"
msgid ""
"Your mission required you to eliminate a certain high-ranking individual in "
"hiding.  Your mark seems to have turned feral while escaping and the world "
"appears to be ending, but not even that can stop you from finishing your "
"mission."
msgstr ""
"Tu misión requiere que elimines a cierto individuo de alto rango que está "
"escondido. Tu objetivo parece haberse vuelto salvaje durante la huida y el "
"mundo parece acabarse, pero ni siquiera eso puede impedirte terminar tu "
"misión."

#: data/json/starting_missions.json
#. ~ Name of the monster "mon_feral_scientist_scalpel" placed on map update on
#. start of mission "Finish your mission"
#. ~ Name of the monster "mon_zombie_prisoner_brute" placed on map update on
#. start of mission "Kill your mark"
msgid "The Target"
msgstr "El Objetivo"

#: data/json/starting_missions.json
