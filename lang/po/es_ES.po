#: data/json/loot_zones.json
#. ~ Name of loot zone
msgid "Loot: Mutagens"
msgstr "Mutágenos"

#: data/json/loot_zones.json
#. ~ Description of loot zone "Loot: Mutagens"
msgid "Destination for mutagens, serums, and purifiers."
msgstr "Lugar para mutágenos, sueros y purificantes."

#: data/json/loot_zones.json
#. ~ Name of loot zone
msgid "Loot: Other"
msgstr "Otros"

#: data/json/loot_zones.json
#. ~ Description of loot zone "Loot: Other"
msgid "Destination for other miscellaneous items."
msgstr "Lugar para otros objetos variados."

#: data/json/loot_zones.json
#. ~ Name of loot zone
msgid "Loot: Perishable Drink"
msgstr "Bebida Caducable"

#: data/json/loot_zones.json
#. ~ Description of loot zone "Loot: Perishable Drink"
msgid "Destination for perishable drinks."
msgstr "Lugar para bebidas perecederas."

#: data/json/loot_zones.json
#. ~ Name of loot zone
