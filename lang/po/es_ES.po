msgstr[0] "bolsillo de munición (pecho)"
msgstr[1] "bolsillos de munición (pecho)"
msgstr[2] "bolsillos de munición (pecho)"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "chest ammo pouch"
msgid ""
"A fabric ammo pouch that can be strapped to your chest and hold a single "
"magazine close at hand."
msgstr ""
"Una bolsa de tejido para munición que puede ser atada a tu pecho y permite "
"tener un cargador a mano."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
#. ~ Variant name of item "chest rig"
msgid "chest rig"
msgid_plural "chest rigs"
msgstr[0] "arnés táctico"
msgstr[1] "arnés tácticos"
msgstr[2] "arnes tácticos"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "chest rig"
#. ~ Description of variant "chest rig" of item "chest rig"
msgid ""
"Popularized during the Vietnam War, chest rigs like these are typically "
"plain, barebones affairs consisting of three or more pouches in a row, with "
"straps to secure them on your chest.  This one can hold four magazines in its "
"pouches."
msgstr ""
"Popularizados durante la guerra de Vietnam, los chalecos de munición como "
"estos son tipicamente simples objetos compactos que consisten en tres o más "
"bolsillos en una fila, con correas para asegurarlos a tu pecho. Este puede "
"almacenar cuatro cargadores en sus bolsillos."

#: data/json/items/armor/ammo_pouch.json
#. ~ Variant name of item "chest rig"
msgid "patriot's chest rig"
msgid_plural "patriot's chest rigs"
msgstr[0] "arnés táctico de patriota"
msgstr[1] "arnés tácticos de patriota"
msgstr[2] "arnés tácticos de patriota"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of variant "patriot's chest rig" of item "chest rig"
msgid ""
"An American flag is proudly embroidered across the front of each pouch, with "
"a tiny, eagle-winged .50-caliber bullet crowning each banner."
msgstr ""
"En la parte delantera de cada bolsa hay bordada con orgullo una bandera "
"estadounidense, con una pequeña bala de calibre 50 con alas de águila "
"coronando cada estandarte."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "javelin bag"
msgid_plural "javelin bags"
msgstr[0] "bolsa para jabalinas"
msgstr[1] "bolsas para jabalinas"
msgstr[2] "bolsas para jabalinas"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "javelin bag"
msgid "An open medieval-looking bag, designed to store javelins within easy reach."
msgstr ""
"Una bolsa abierta de aspecto medieval, diseñada para guardar jabalinas con un "
"fácil acceso."

#: data/json/items/armor/ammo_pouch.json
#. ~ "holster_prompt" action message of item "javelin bag"
msgid "Stash javelins"
msgstr "Almacenar jabalinas"

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "ankle ammo pouch"
msgid_plural "ankle ammo pouches"
msgstr[0] "bolsillo de munición (tobillo)"
msgstr[1] "bolsillos de munición (tobillo)"
msgstr[2] "bolsillos de munición (tobillo)"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "ankle ammo pouch"
msgid ""
"A small fabric ammo pouch that can be strapped to your ankle and hold a "
"single small magazine close at hand."
msgstr ""
"Una pequeña bolsa de tejido para munición que puede ser atada al tobillo y "
"permite tener un cargador pequeño a mano."

#: data/json/items/armor/ammo_pouch.json data/mods/Aftershock/items/armor.json
#: data/mods/aftershock_exoplanet/items/armor.json
#. ~ Item name
msgid "leg ammo pouch"
msgid_plural "leg ammo pouches"
msgstr[0] "bolsillo de munición (pierna)"
msgstr[1] "bolsillos de munición (pierna)"
msgstr[2] "bolsillos de munición (pierna)"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "leg ammo pouch"
msgid ""
"A fabric ammo pouch that can be strapped to your leg and hold two magazines "
"close at hand."
msgstr ""
"Una bolsa de tejido para munición que puede ser atada a tu pierna y permite "
"tener dos cargadores a mano."

#: data/json/items/armor/ammo_pouch.json data/mods/Magiclysm/items/armor.json
#. ~ Item name
msgid "quiver"
msgid_plural "quivers"
msgstr[0] "carcaj"
msgstr[1] "carcajs"
msgstr[2] "carcajs"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "quiver"
msgid ""
"A leather quiver worn at the waist that can hold 20 arrows or bolts.  Use "
"insert to store arrows or bolts."
msgstr ""
"Un carcaj de cuero que se lleva a la cintura y puede almacenar hasta 20 "
"flechas o saetas. Usar para almacenar flechas o saetas."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "nylon quiver"
msgid_plural "nylon quivers"
msgstr[0] "carcaj de nylon"
msgstr[1] "carcajs de nylon"
msgstr[2] "carcajs de nylon"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "nylon quiver"
msgid ""
"A lighter and more durable quiver made of nylon, with straps to attach to a "
"MOLLE system."
msgstr ""
"Un carcaj más ligero y duradero hecho de nylon, con correas para sujetar a un "
"sistema MOLLE."

#: data/json/items/armor/ammo_pouch.json data/mods/Magiclysm/items/armor.json
#. ~ Item name
msgid "birchbark quiver"
msgid_plural "birchbark quivers"
msgstr[0] "carcaj de abedul"
msgstr[1] "carcajs de abedul"
msgstr[2] "carcajs de abedul"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "birchbark quiver"
msgid ""
"A quiver woven from strips of birch bark, worn at the waist, that can hold 20 "
"arrows or bolts.  Use insert to store arrows or bolts."
msgstr ""
"Un carcaj tejido de tiras de corteza de abedul, llevado en la cintura, que "
"puede contener 20 flechas o saetas. Usar para almacenar flechas o saetas."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "pipe quiver"
msgid_plural "pipe quivers"
msgstr[0] "carcaj de tubo"
msgstr[1] "carcajs de tubo"
msgstr[2] "carcajs de tubo"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "pipe quiver"
msgid ""
"A makeshift quiver fashioned from a pipe, worn at the waist.  Heavier and "
"thinner than a typical quiver, it can only hold 10 arrows or bolts.  Use "
"insert to store arrows or bolts."
msgstr ""
"Un carcaj improvisado con una tubería para la cintura. Más pesada y más "
"delgada que un carcaj típico con capacidad de hasta 10 flechas/saetas. "
"Insertar para almacenar flechas o saetas"

#: data/json/items/armor/ammo_pouch.json data/mods/Magiclysm/items/armor.json
#. ~ Item name
msgid "large quiver"
msgid_plural "large quivers"
msgstr[0] "carcaj grande"
msgstr[1] "carcajs grandes"
msgstr[2] "carcajs grandes"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "large quiver"
msgid ""
"A large leather quiver trimmed with metal, worn on the back, that can hold 60 "
"arrows or bolts.  Historically used by horse archers, rather than foot "
"archers, but neither of THEM had to fight zombies.  Use insert to store "
"arrows or bolts."
msgstr ""
"Una carcaj grande de cuero adornado con metal, se usa en la espalda y puede "
"almacenar hasta 60 flechas o saetas. Históricamente fue utilizada por los "
"arqueros a caballo, más que por los que iban a pie, pero ninguno de ELLOS "
"tuvo que pelearse contra zombis. Usar para almacenar flechas o saetas."

#: data/json/items/armor/ammo_pouch.json data/mods/Magiclysm/items/armor.json
#. ~ Item name
msgid "large birchbark quiver"
msgid_plural "large birchbark quivers"
msgstr[0] "carcaj de abedul grande"
msgstr[1] "carcajs de abedul grandes"
msgstr[2] "carcajs de abedul grandes"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "large birchbark quiver"
msgid ""
"A large quiver woven from strips of birchbark, worn on the back, that can "
"hold 60 arrows or bolts.  Use insert to store arrows or bolts."
msgstr ""
"Un carcaj tejido de tiras de corteza de abedul, llevado en la espalda, que "
"puede contener 20 flechas o saetas. Usa insertar para almacenar flechas o "
"saetas."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "large pipe quiver"
msgid_plural "large pipe quivers"
msgstr[0] "carcaj de tubo largo"
msgstr[1] "carcajs de tubo largo"
msgstr[2] "carcajs de tubo largo"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "large pipe quiver"
msgid ""
"A large makeshift quiver fashioned from 3 pipes, worn on the back.  Heavier "
"and thinner than a typical large quiver, it can only hold 30 arrows or bolts. "
" Use insert to store arrows or bolts."
msgstr ""
"Un carcaj improvisado grande hecho con 3 tuberías para la espalda. Más pesado "
"y delgado que un carcaj largo típico, solo puede contener 30 flechas o "
"saetas. Insertar para guardar flechas o saetas."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "simple cloth quiver"
msgid_plural "simple cloth quivers"
msgstr[0] "carcaj de tela simple"
msgstr[1] "carcajs de tela simple"
msgstr[2] "carcajs de tela simple"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "simple cloth quiver"
msgid ""
"A simple quiver made out of cloth that can be adjusted to hold various types "
"of arrows, bolts, and spears of different lengths.  Takes slightly longer to "
"pull ammunition from than a regular quiver.  Use insert to store arrows, "
"bolts, fishing spears, or atlatl spears."
msgstr ""
"Un carcaj sencillo hecho de tela que puede ajustarse para contener varios "
"tipos de flechas, virotes y lanzas de distintas longitudes. Se tarda un poco "
"más en extraer la munición que con un carcaj normal. Se utiliza para guardar "
"flechas, virotes, lanzas de pesca o lanzas de átlatl."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "multi-function quiver"
msgid_plural "multi-function quivers"
msgstr[0] "carcaj multifunción"
msgstr[1] "carcajs multifunción"
msgstr[2] "carcajs multifunción"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "multi-function quiver"
msgid ""
"A large cotton quiver capable of easily storing 16 arrows.  It includes a bag "
"and straps to store a takedown bow, as well as a small pouch for archery "
"accessories.  Use insert to store arrows or bolts and activate to "
"holster/draw your bow."
msgstr ""
"Un gran carcaj de algodón capaz de almacenar fácilmente 16 flechas. Incluye "
"una bolsa y correas para guardar un arco desmontable, así como una pequeña "
"bolsa para accesorios de tiro con arco. Utiliza 'insertar' para almacenar "
"flechas o saetas y actívalo para enfundar/desenfundar tu arco."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "tac vest"
msgid_plural "tac vests"
msgstr[0] "chaleco táctico"
msgstr[1] "chalecos tácticos"
msgstr[2] "chalecos tácticos"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "tac vest"
msgid ""
"This light vest is meant to carry your magazines, shells and pistols.  They "
"are popular among law enforcement, but less so than combination tactical "
"vests incorporating Kevlar."
msgstr ""
"Este chaleco ligero está pensado para llevar tus cargadores, cartuchos y "
"pistolas. Son populares entre las fuerzas del orden, pero menos que los "
"chalecos tácticos combinados que incorporan Kevlar."

#: data/json/items/armor/ammo_pouch.json
#. ~ "holster_prompt" action message of item "tac vest"
msgid "Stash item"
msgstr "Almacenar objecto"

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "light load bearing vest"
msgid_plural "light load bearing vests"
msgstr[0] "chaleco de carga ligera"
msgstr[1] "chalecos de carga ligera"
msgstr[2] "chalecos de carga ligera"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "light load bearing vest"
msgid ""
"This lightweight harness covered in MOLLE webbing is designed to attach a few "
"pouches, holsters and other PALS compatible accessories.  Preferred by some "
"soldiers over directly attaching accessories to a ballistic vest as they can "
"then be easily separated."
msgstr ""
"Este ligero arnés recubierto de correas en malla MOLLE está diseñada para "
"fijar unos pocos bolsillos, fundas y otros accesorios compatibles con PALS. "
"Algunos soldados lo prefieren en lugar de fijar directamente los accesorios "
"al chaleco antibalas, ya que así pueden separarse fácilmente."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "load bearing vest"
msgid_plural "load bearing vests"
msgstr[0] "chaleco de carga"
msgstr[1] "chalecos de carga"
msgstr[2] "chalecos de carga"

#: data/json/items/armor/ammo_pouch.json
#. ~ Description of "load bearing vest"
msgid ""
"This vest covered in MOLLE webbing is designed to attach pouches, holsters "
"and other PALS compatible accessories.  Preferred by some soldiers over "
"directly attaching accessories to a ballistic vest as they can then be easily "
"separated."
msgstr ""
"Este arnés recubierto de correas en malla MOLLE está diseñada para fijar "
"bolsillos, fundas y otros accesorios compatibles con PALS. Algunos soldados "
"lo prefieren en lugar de fijar directamente los accesorios al chaleco "
"antibalas, ya que así pueden separarse fácilmente."

#: data/json/items/armor/ammo_pouch.json
#. ~ Item name
msgid "load bearing vest with sling"
msgid_plural "load bearing vests with slings"
msgstr[0] "chaleco de carga con correas"
