msgid "Winchester Model 70 Safari rifle"
msgid_plural "Winchester Model 70 Safari rifles"
msgstr[0] "rifle de safari Winchester Model 70"
msgstr[1] "rifles de safari Winchester Model 70"
msgstr[2] "rifles de safari Winchester Model 70"

