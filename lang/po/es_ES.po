msgstr[0] "bayas de gaulteria"
msgstr[1] "bayas de gaulteria"
msgstr[2] "bayas de gaulteria"

#: data/json/items/comestibles/raw_fruit.json
#. ~ Description of "wintergreen berries"
msgid "A handful of sweet, brilliant red berries of the wintergreen shrub."
msgstr "Un puñado de frutos dulces de un rojo brillante del arbusto llamado gaulteria."

#: data/json/items/comestibles/raw_fruit.json
