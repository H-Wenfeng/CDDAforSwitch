#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"WHY THE FUCK are you doing this to me?\""
msgstr "\"¿Por qué coño me estas haciendo esto?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"LEAVE!  NOW!\""
msgstr "\"¡VETE! ¡AHORA!\"\"¡VETE! ¡AHORA!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"I TOLD YOU TO GET OUT OF HERE!\""
msgstr "\"¡TE DIJE QUE TE FUERAS DE AQUÍ!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"WHAT THE FUCK DO YOU WANT FROM ME?!\""
msgstr "\"¡¿QUÉ COJONES QUIERES DE MÍ?!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"STOP!\""
msgstr "\"¡DETENTE!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "indistinct shouting."
msgstr "gritando indistintamente."

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "screaming."
msgstr "gritando."

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"MEAT!\""
msgstr "\"¡CARNE!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_slaver,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
msgid "\"TEKELI-LI!\""
msgstr "\"¡TEKELI-LI!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_slaver,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
msgid "\"TEKELI-LI!  TEKELI-LI!  TEKELI-LI!\""
msgstr "\"¡TEKELI-LI! ¡TEKELI-LI! ¡TEKELI-LI!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_slaver,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
msgid "\"Tekeli-li.\""
msgstr "\"Tekeli-li.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_slaver,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
msgid "a slurping sound."
msgstr "un sorbido."

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"WHY!  WHY, WHYYY!\""
msgstr "\"¡POR QUÉ! ¡POR QUÉ, POR QUÉÉÉ!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "an electronic voice saying \"CONNECTION FAILED.  Abort, Retry, Fail?\""
msgstr ""
"una voz eléctrica diciendo \"FALLO EN LA CONEXIÓN. ¿Abortar, Reintentar, "
"Fallo?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"I was once a man.  A MAN!\""
msgstr "\"Antes era hombre. ¡HOMBRE!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"What have I become?\""
msgstr "\"¿En qué me convertí?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "an electronic voice saying \"KILL ALL HUMANS!\""
msgstr "una voz eléctrica diciendo \"¡MATAR TODOS LOS HUMANOS!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"Have you seen my children?\""
msgstr "\"¿Has visto a mis hijos?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"What have I become?  Why can't I die?\""
msgstr "\"¿En qué me convertí? ¿Por qué no me muero?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid ""
"\"Please, kill me!\", followed by an electronic voice saying \"SELF "
"PRESERVATION PROTOCOLS ACTIVATED\""
msgstr ""
"\"¡Por favor, mátenme!\", seguido por una voz eléctrica diciendo \"PROTOCOLOS "
"DE AUTOCONSERVACIÓN ACTIVADOS\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"Please, take me with you.\""
msgstr "\"Por favor, llevame contigo.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"Not that way!  Go left!\""
msgstr "\"¡Para ese lado no! ¡Para la izquierda!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"I told you to let me die.\""
msgstr "\"Te dije que me dejaras morir.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"W-where am I?  Why does it hur-REBOOTING IN 59 SECONDS.\""
msgstr "\"¿Dónde estoy? ¿Por qué due ..REINICIANDO EN 59 SEGUNDOS?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"THIS UNIT IS BROKEN.  PLEASE CALL AN ATTENDANT.\""
msgstr "\"ESTA UNIDAD ESTÁ ROTA. POR FAVOR LLAME A UN ASISTENTE.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_slaver
msgid "\"Can't… breathe…\""
msgstr "\"No puedo... respirar...\""

#: data/json/speech.json
