#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "Enable portal storms."
msgstr "Habilitar tormentas de portales."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "Disable random events."
msgstr "Desactivar eventos aleatorios."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "Enable random events."
msgstr "Habilitar eventos aleatorios."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ NPC dialogue line
msgid "How hard do you want your game to be?"
msgstr "¿Qué nivel de dificultad quieres que tenga tu juego?"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Easy</color>: No additional enemies spawn per wave, and you get "
"a second chance when you die the first time.  Good for newcomers or those not "
"familiar with isometric horde fighters."
msgstr ""
"<color_yellow>Fácil</color>: No aparecen enemigos adicionales por oleada, y "
"tienes una segunda oportunidad al morir la primera vez. Ideal para "
"principiantes o aquellos que no están familiarizados con los juegos de lucha "
"isométricos contra hordas."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Normal</color>: The basic way to play, no additional enemies, "
"with no safety nets.  This is considered the default."
msgstr ""
"<color_yellow>Normal</color>: La forma básica de jugar, sin enemigos "
"adicionales y sin redes de seguridad. Se considera la opción predeterminada."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Difficult</color>: More enemies spawn per wave, but nothing too "
"extreme.  You'll have to fight harder to live, but more loot comes with it "
"too."
msgstr ""
"<color_yellow>Díficil</color>: Aparecen más enemigos por oleada, pero nada "
"demasiado extremo. Tendrás que luchar más para sobrevivir, pero también "
"obtendrás más botín."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Hard</color>: Twice the number of enemies will spawn per wave.  "
"A true challenge to test your metal."
msgstr ""
"<color_yellow>Duro</color>: Aparecerá el doble de enemigos por oleada. Un "
"verdadero desafío para poner a prueba tu temple."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
