msgid_plural "crude heating elements"
msgstr[0] "elemento térmico crudo"
msgstr[1] "elementos térmicos crudos"
msgstr[2] "elementos térmicos crudos"

#: data/json/items/generic.json
#. ~ Description of "crude heating element"
msgid ""
"A primitive heating element made from thin coiled steel wire.  It will "
"degrade much quicker with use than normal heating elements, but it'll do for "
"some applications."
msgstr ""
"Un elemento calefactor primitivo hecho de un fino alambre de acero enrollado. "
