#. ~ NPC dialogue line
msgid ""
"We have a grand variety of preselected game modes for you to choose from!  "
"Pick one and play now!"
msgstr ""
"¡Tenemos una gran variedad de modos de juego preseleccionados entre los que "
"puedes elegir! ¡Elige uno y juega ahora!"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Shaun of The Dead</color>: (Defend a bar against classic "
"zombies with your five friends.  Easy and fun.)"
msgstr ""
"<color_yellow>Shaun of The Dead</color>: (Defiende un bar contra zombis "
"clásicos con tus cinco amigos. Fácil y divertido)."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Dawn of The Dead</color>: (Classic zombies only, slower and "
"more realistic.)"
msgstr ""
"<color_yellow>Amanecer de Los Muertos</color>: (Solo zombis clásicos, más "
"lentos y realistas)."

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Eight-Legged Freaks</color>: (Hordes of spiders!  Not "
"arachnophobia friendly!)"
msgstr ""
"<color_yellow>Friki de las Ocho Patas</color>: (¡Hordas de arañas! ¡No apto "
"para aracnofóbicos!)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Day of The Triffids</color>: (Protect your mansion against the "
"triffids.)"
msgstr ""
"<color_yellow>Día de los Trífidos</color>: (Protege tu mansión contra los "
"trífidos.)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "<color_yellow>Skynet</color>: (Robots have decided that humans are the enemy!)"
msgstr ""
"<color_yellow>Skynet</color>: (¡Los robots han decidido que los humanos son "
"el enemigo!)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>The Call of Cthulhu</color>: (Fend off hordes of eldritch "
"horrors.)"
msgstr ""
"<color_yellow>La Llamada de Cthulhu</color>: (Defiéndete de hordas de "
"horrores sobrenaturales.)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ NPC dialogue line
msgid ""
"Please alter these game options as you wish, make the experience just like "
"you want it."
msgstr ""
"Modifica estas opciones del juego como desees, para que la experiencia sea "
"tal y como tú quieras."

