msgid_plural "Mosin-Nagant 1891/30 rifles"
msgstr[0] "rifle Mosin-Nagant 1891/30"
msgstr[1] "rifles Mosin-Nagant 1891/30"
msgstr[2] "rifles Mosin-Nagant 1891/30"

#: data/json/items/gun/762R.json
