msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/undine_mutation_spells.json
#. ~ Description of spell "summon_kraken ( Summon Kraken )"
msgid "A friendly kraken arrives from somewhere.  It may not be that useful on land."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/undine_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/undine_mutations.json
