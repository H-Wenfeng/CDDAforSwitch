msgid_plural "exosuit power supply units"
msgstr[0] "unidad de suministro de energía del exotraje"
msgstr[1] "unidades de suministro de energía del exotraje"
msgstr[2] "unidades de suministro de energía del exotraje"

#: data/mods/Aftershock/items/armor/exosuit/exosuit_modules.json
#: data/mods/aftershock_exoplanet/items/armor/exosuit/exosuit_modules.json
#. ~ Description of "exosuit power supply unit"
msgid ""
"Designed to attach to an exosuit's back, this is a large rechargeable battery "
"with an integrated UPS."
msgstr ""
"Diseñada para engancharse a la espalda de un exotraje, esta es una gran "
"batería recargable con un SEU integrado."

#: data/mods/Aftershock/items/armor/exosuit/exosuit_modules.json
#: data/mods/aftershock_exoplanet/items/armor/exosuit/exosuit_modules.json
#. ~ Item name
