#: data/mods/Xedra_Evolved/snippets/dreams.json
#. ~ Snippet in category "XE_BAD_DREAMS"
msgid "In your dream, terrifying creatures surround you."
msgstr ""

#: data/mods/Xedra_Evolved/snippets/dreams.json
#. ~ Snippet in category "XE_BAD_DREAMS"
