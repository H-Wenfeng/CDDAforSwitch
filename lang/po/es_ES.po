#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "kitchen station"
msgstr "estación de cocina"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "workshop station"
msgstr "estación de mesa de trabajo"

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-appliances.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "oven"
msgstr "horno"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "oven"
msgid ""
"A standard electric convection-based oven, commonly used for heating and "
"cooking food.  It's plugged in and ready to go."
msgstr ""
"Un horno eléctrico estándar basado en convección, utilizado habitualmente "
"para calentar y cocinar alimentos. Se enchufa y está listo para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "stationary water purifier"
msgstr "potabilizador de agua estacionario"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "stationary water purifier"
msgid ""
"This device effectively sterilizes water.  Activate it to clean all water in "
"a connected tank, at the cost of some electricity."
msgstr ""
"Este dispositivo esteriliza eficazmente el agua. Actívalo para limpiar toda "
"el agua de un depósito conectado, a costa de algo de electricidad."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "arcade machine"
msgstr "máquina de juego"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "arcade machine"
msgid ""
"A bulky upright arcade cabinet, brightly painted and slightly worn with age.  "
"Ready to be played."
msgstr ""
"Es un mueble voluminoso vertical, pintado de colores brillantes y un poco "
"desgastado por el paso del tiempo. Preparado para jugar en él."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "arc furnace"
msgid_plural "arc furnaces"
msgstr[0] "horno de arco"
msgstr[1] "hornos de arco"
msgstr[2] "hornos de arco"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "arc furnace"
msgid ""
"An arc furnace designed to burn a powdery mix of coke and limestone to create "
"calcium carbide.  Plugged in and ready to go."
msgstr ""
"Un horno de arco diseñado para quemar una mezcla en polvo de coque y piedra "
"caliza para crear carburo de calcio. Conectado y listo para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/metalworking.json
#. ~ Vehicle part name
#. ~ Item name
msgid "electric forge"
msgid_plural "electric forges"
msgstr[0] "forja eléctrica"
msgstr[1] "forjas eléctricas"
msgstr[2] "forjas eléctricas"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "electric forge"
msgid ""
"An electric forge, plugged in and ready to be used for metalworking.  If you "
"attempt to craft an item that needs a forge, you will be given the option of "
"selecting it as a tool."
msgstr ""
"Una forja eléctrica, enchufada y lista para trabajar el metal. Si intentas "
"fabricar un objeto que necesite una forja, se te dará la opción de "
"seleccionarla como herramienta."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_kiln"
msgid ""
"An electric kiln for baking brick or clay.  When plugged in and powered you "
"could use this to harden bricks or clay.  If you attempt to craft an item "
"that needs a kiln, you will be given the option of selecting it as a tool."
msgstr ""
"Un horno eléctrico para cocer ladrillos o arcilla. Cuando está enchufado y "
"alimentado, puedes utilizarlo para endurecer ladrillos o arcilla. Si intentas "
"fabricar un objeto que necesite un horno, se te dará la opción de "
"seleccionarlo como herramienta."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "drill press"
msgid_plural "drill presses"
msgstr[0] "taladro de banco"
msgstr[1] "taladros de banco"
msgstr[2] "taladros de banco"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "drill press"
msgid ""
"A powerful drill mounted on a slide that lets it drop precisely down.  Useful "
"in all kinds of projects, from industrial fabrication to home woodworking.  "
"Plugged in and ready to go."
msgstr ""
"Un potente taladro montado sobre una corredera que le permite descender con "
"precisión. Útil en todo tipo de proyectos, desde la fabricación industrial "
"hasta la carpintería doméstica. Conectado y listo para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "table saw"
msgid_plural "table saws"
msgstr[0] "sierra de mesa"
msgstr[1] "sierras de mesa"
msgstr[2] "sierras de mesa"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "table saw"
msgid ""
"A rotating sawblade set into a large, flat table.  Used for making straight, "
"measured cuts, it's a key tool in any carpenter's arsenal.  Plugged in and "
"ready to go."
msgstr ""
"Una hoja de sierra giratoria colocada en una mesa grande y plana. Utilizada "
"para realizar cortes rectos y medidos, es una herramienta clave en el arsenal "
"de cualquier carpintero. Enchufada y lista para usar."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "mitre saw"
msgid_plural "mitre saws"
msgstr[0] "sierra de inglete"
msgstr[1] "sierras de inglete"
msgstr[2] "sierras de inglete"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "mitre saw"
msgid ""
"A circular sawblade on an arm that can slide and rotate in several "
"directions, this is a staple tool for nearly any carpentry.  Plugged in and "
"ready to go."
msgstr ""
"Una hoja de sierra circular en un brazo que puede deslizarse y girar en "
"varias direcciones, esta es una herramienta básica para casi cualquier "
"carpintería. Enchufada y lista para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "band saw"
msgid_plural "band saws"
msgstr[0] "sierra de cinta"
msgstr[1] "sierras de cinta"
msgstr[2] "sierras de cinta"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "band saw"
msgid ""
"A ribbonlike sawblade runs in a single direction in this tool, allowing "
"precise cuts at almost any angle.  Plugged in and ready to go."
msgstr ""
"Una hoja de sierra en forma de cinta se desplaza en una sola dirección en "
"esta herramienta, permitiendo cortes precisos en casi cualquier ángulo. "
"Conectada y lista para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "router table"
msgstr "mesa de fresadora"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "router table"
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves.  Plugged in and ready to go."
msgstr ""
"Esta mesa dispone de una fresadora, un motor giratorio con un cabezal con una "
"cuchilla intercambiable para cortar perfiles y ranuras específicos. Conectada "
"y lista para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "planer"
msgid_plural "planers"
msgstr[0] "garlopa"
msgstr[1] "garlopas"
msgstr[2] "garlopas"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "planer"
msgid ""
"A hefty tool that will take in a board and cut it smooth and flat to a "
"specific width, particularly great if working with raw lumber stock, but also "
"good just for shaving wood down to size.  Plugged in and ready to go."
msgstr ""
"Una herramienta robusta que toma una tabla y la corta lisa y plana a una "
"anchura específica, especialmente útil si se trabaja con madera en bruto, "
"pero también para cortar madera a medida. Conectada y lista para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "jointer"
msgid_plural "jointers"
msgstr[0] "ensambladora"
msgstr[1] "ensambladoras"
msgstr[2] "ensambladoras"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "jointer"
msgid ""
"A table-shaped tool with a rotating blade that will cut down, smooth out, and "
"square off a board to make it nice and smooth.  Plugged in and ready to go."
msgstr ""
"Una herramienta en forma de mesa con una cuchilla giratoria que cortará, "
"alisará y escuadrará una tabla para dejarla bonita y lisa. Enchufada y lista "
"para usar."

#: data/json/furniture_and_terrain/appliances.json data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Item name
msgid "catalytic cracking reactor"
msgid_plural "catalytic cracking reactors"
msgstr[0] "reactor de craqueo catalítico"
msgstr[1] "reactor de craqueo catalítico"
msgstr[2] "reactor de craqueo catalítico"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "catalytic cracking reactor"
msgid ""
"A makeshift extraction system, or as makeshift as you can consider something "
"that was purpose-built in a laboratory by a group of experts."
msgstr ""
"Un sistema de extracción improvisado, o todo lo improvisado que se puede "
"considerar algo construido a propósito en un laboratorio por un grupo de "
"expertos."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "hydraulic press"
msgid_plural "hydraulic presses"
msgstr[0] "prensa hidráulica"
msgstr[1] "prensas hidráulicas"
msgstr[2] "prensas hidráulicas"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "hydraulic press"
msgid ""
"If you really want to squash something a lot, this is exactly the right "
"industrial tool for you.  Plugged in and ready to go."
msgstr ""
"Si realmente quieres aplastar algo mucho, esta es exactamente la herramienta "
"industrial adecuada para ti. Enchufada y lista para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "air compressor"
msgid_plural "air compressors"
msgstr[0] "compresor de aire"
msgstr[1] "compresores de aire"
msgstr[2] "compresores de aire"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "air compressor"
msgid ""
"This durable tank is topped with a motor that will cram as much air into the "
"tank as possible.  Plugged in and ready to go."
msgstr ""
"Este depósito resistente está rematado con un motor que introducirá la mayor "
"cantidad de aire posible en el depósito. Enchufado y listo para funcionar."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "large heater"
msgstr "calentador grande"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "small heater"
msgstr "calentador pequeño"

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift water electrolyzer"
msgid_plural "makeshift water electrolyzers"
msgstr[0] "electrolizadores de agua improvisados"
msgstr[1] "electrolizadores de agua improvisados"
msgstr[2] "electrolizadores de agua improvisados"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift water electrolyzer"
msgid ""
"A makeshift appliance which decomposes water into oxygen and hydrogen via "
"electrolysis of sodium hydroxide solution, with a power cord to connect it to "
"an electric grid."
msgstr ""
"Aparato improvisado que descompone el agua en oxígeno e hidrógeno mediante la "
"electrólisis de una solución de hidróxido de sodio, con un cable de "
"alimentación para conectarlo a una red eléctrica."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift ammonia machine reactor"
msgid_plural "makeshift ammonia machine reactors"
msgstr[0] "reactores de amoníaco improvisados"
msgstr[1] "reactores de amoníaco improvisados"
msgstr[2] "reactores de amoníaco improvisados"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift ammonia machine reactor"
msgid ""
"A huge appliance built from salvaged industrial equipment, which produces "
"ammonia via the Haber-Bosch process from hydrogen and nitrogen.  It has a "
"power cord to connect it to an electric grid."
msgstr ""
"Un enorme aparato construido a partir de equipos industriales recuperados, "
"que produce amoníaco mediante el proceso Haber-Bosch a partir de hidrógeno y "
"nitrógeno. Dispone de un cable de alimentación para conectarlo a la red "
"eléctrica."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift ammonia machine pipework"
msgid_plural "makeshift ammonia machine pipeworks"
msgstr[0] "máquina improvisada de tubo amoniaco"
msgstr[1] "máquinas improvisadas de tubo amoniaco"
msgstr[2] "máquinas improvisadas de tubo amoniaco"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift ammonia machine pipework"
msgid ""
"A rather complicated system of thick-walled pipes, powerful compressors, and "
"wiring, meant to interface with a reactor producing ammonia from nitrogen and "
"hydrogen via the Haber-Bosch process, with a power cord to connect it to an "
"electric grid."
msgstr ""
"Un sistema bastante complicado de tuberías de paredes gruesas, compresores "
"potentes y cableado, destinado a interconectarse con un reactor que produce "
"amoníaco a partir de nitrógeno e hidrógeno mediante el proceso Haber-Bosch, "
"con un cable de alimentación para conectarlo a una red eléctrica."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift nitrogen generator"
msgid_plural "makeshift nitrogen generators"
msgstr[0] "generadores de nitrógeno improvisados"
msgstr[1] "generadores de nitrógeno improvisados"
msgstr[2] "generadores de nitrógeno improvisados"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift nitrogen generator"
msgid ""
"A large makeshift appliance which captures nitrogen from the air for use in "
"chemistry projects, with a power cord to connect it to an electric grid."
msgstr ""
"Un gran aparato improvisado que capta el nitrógeno del aire para utilizarlo "
"en proyectos de química, con un cable de alimentación para conectarlo a una "
"red eléctrica."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/cables.json
#. ~ Vehicle part name
#. ~ Item name
msgid "power cord"
msgid_plural "power cords"
msgstr[0] "cable de alimentación"
msgstr[1] "cables de alimentación"
msgstr[2] "cables de alimentación"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "power cord"
msgid ""
"A power cord sticking out of an appliance.  You need to plug it into a "
"powered grid for the appliance to work properly."
msgstr ""
"Un cable de alimentación que sobresale de un electrodoméstico. Es necesario "
"enchufarlo a una red eléctrica para que el aparato funcione correctamente."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "wall light"
msgstr "lampara de pared"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "wall light"
msgid "A wall-mounted lamp that provides illumination when turned on."
msgstr "Una lámpara de muro/pared que ilumina cuando está encendida."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "standing lamp"
msgstr "lámpara de pie"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "standing lamp"
msgid "A tall floor lamp that provides illumination when turned on."
msgstr "Una lampara de pie alta que provee iluminación cuando se enciende."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "standing floodlight"
msgstr "reflector de pie"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "standing floodlight"
msgid "A large, heavy light that illuminates a wide area around it when switched on."
msgstr ""
"Una luz grande y pesada que ilumina una amplia zona a su alrededor cuando se "
"enciende."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "standing directed floodlight"
msgstr "reflector de pie direccional"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "standing directed floodlight"
msgid ""
"A large, heavy light that illuminates a wide semicircle around it when "
"switched on."
msgstr ""
"Una luz grande y pesada que ilumina un amplio semicírculo a su alrededor "
"cuando está encendida."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "wall wirings"
msgstr "cableado de pared"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "wall wirings"
msgid "Electric wires embedded in the wall."
msgstr "Cables eléctricos empotrados en la pared."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/vehicle/solar.json
#. ~ Vehicle part name
#. ~ Item name
#. ~ Magazine name
msgid "deployed folding solar panel"
msgid_plural "deployed folding solar panels"
msgstr[0] "panel solar plegable desplegado"
msgstr[1] "paneles solares plegables desplegados"
msgstr[2] "paneles solares plegables desplegados"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "deployed folding solar panel"
msgid ""
"This folding solar panel has been unfolded, and it is ready to charge "
"connected devices, if the sun is out."
msgstr ""
"Este panel solar plegable se despliega y está listo para cargar los "
"dispositivos conectados, si sale el sol."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/vehicle/solar.json
#. ~ Vehicle part name
#. ~ Item name
#. ~ Magazine name
msgid "deployed solar suitcase"
msgid_plural "deployed solar suitcases"
msgstr[0] "maletín solar desplegado"
msgstr[1] "maletines solares desplegados"
msgstr[2] "maletines solares desplegados"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "deployed solar suitcase"
msgid "This solar suitcase has been unpacked and is ready to supply power."
msgstr ""
"Este maletín solar ha sido desplegado y esta listo para suministrar "
"electricidad."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "small solar panel"
msgstr "panel solar pequeño"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "small solar panel"
msgid "A small solar panel, mounted on a frame and ready to power other appliances."
msgstr ""
"Un panel solar pequeño montado en una estructura y preparado para alimentar "
"otros electrodomésticos."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_ground_solar_panel"
msgid "A solar panel, mounted on a frame and ready to power other appliances."
msgstr ""
"Un panel solar montado en una estructura y preparado para alimentar otros "
"electrodomésticos."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_reinforced_solar_panel"
msgid ""
"A reinforced solar panel, mounted on a frame and ready to power other "
"appliances."
msgstr ""
"Un panel solar reforzado montado en una estructura y listo para alimentar "
"otros electrodomésticos."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "small advanced solar panel"
msgstr "panel solar avanzado pequeño"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "small advanced solar panel"
msgid ""
"A  small, high-performance solar panel, mounted on a frame and ready to power "
"other appliances."
msgstr ""
"Un panel solar pequeño de alta eficacia montado en una estructura y listo "
"para alimentar a otros electrodomésticos."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_reinforced_solar_panel_v2"
msgid ""
"A high-performance reinforced solar panel, mounted on a frame and ready to "
"power other appliances."
msgstr ""
"Un panel solar reforzado de alta eficacia montado en una estructura y listo "
"para dar corriente a otros electrodomésticos."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_wind_turbine"
msgid "A mounted wind turbine, ready to power other appliances."
msgstr "Una turbina eólica armada, lista para alimentar otros aparatos."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_xl_wind_turbine"
msgid "A large mounted wind turbine, ready to power other appliances."
msgstr "Una gran turbina eólica montada, lista para alimentar otros aparatos."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_water_wheel"
msgid "A mounted water wheel, ready to power other appliances."
msgstr "Una rueda de agua montada, lista para alimentar otros electrodomésticos."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_xl_water_wheel"
msgid "A mounted large water wheel, ready to power other appliances."
msgstr ""
"Una rueda de agua grande montada, lista para alimentar otros "
"electrodomésticos."

