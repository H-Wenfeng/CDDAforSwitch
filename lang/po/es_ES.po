msgstr[1] "alternadores de moto"
msgstr[2] "alternadores de moto"

#: data/json/items/vehicle/alternator.json
#. ~ Description of "motorbike alternator"
msgid ""
"A compact, lightweight alternator used to power small vehicle electrical "
"systems."
msgstr ""
"Un alternador compacto y ligero utilizado para alimentar sistemas eléctricos "
"de vehículos pequeños."

#: data/json/items/vehicle/alternator.json
#: data/json/vehicleparts/alternator.json
#. ~ Item name
#. ~ Vehicle part name
msgid "bicycle alternator"
msgid_plural "bicycle alternators"
msgstr[0] "alternador de bicicleta"
msgstr[1] "alternadores de bicicleta"
msgstr[2] "alternadores de bicicleta"

#: data/json/items/vehicle/alternator.json
#. ~ Description of "bicycle alternator"
msgid "A very lightweight alternator used to power a bicycle's headlights."
msgstr ""
"Es un alternador muy liviano que se usa para alimentar las luces de una "
"bicicleta."

#: data/json/items/vehicle/alternator.json
#: data/json/vehicleparts/alternator.json
#. ~ Item name
#. ~ Vehicle part name
msgid "truck alternator"
msgid_plural "truck alternators"
msgstr[0] "alternador de camión"
msgstr[1] "alternadores de camión"
msgstr[2] "alternadores de camión"

#: data/json/items/vehicle/alternator.json
#. ~ Description of "truck alternator"
msgid ""
"A larger and more powerful alternator used to power vehicle electrical "
"systems."
msgstr ""
"Es un alternador más grande y potente que se usa para alimentar sistemas "
"eléctricos del vehículo."

#: data/json/items/vehicle/animals.json
#: data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "yoke and harness"
msgid_plural "yokes and harnesses"
msgstr[0] "yugo y arnés"
msgstr[1] "yugos y arneses"
msgstr[2] "yugos y arneses"

#: data/json/items/vehicle/animals.json
#. ~ Description of "yoke and harness"
msgid ""
"A bar and harness to attach a sufficiently large creature to a wheeled "
"vehicle, allowing them to pull it along."
msgstr ""
"Una barra y un arnés para sujetar a una criatura suficientemente grande a un "
"vehículo con ruedas, lo que permite arrastrarlo.."

