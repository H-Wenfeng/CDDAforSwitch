#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "saurolophus"
msgid_plural "saurolophus"
msgstr[0] "saurolophus"
msgstr[1] "saurolophus"
msgstr[2] "saurolophus"

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Description of monster "saurolophus"
msgid ""
"A huge scaly dinosaur with hooves and a broad beak filled with hundreds of "
"small teeth with a spiky head crest at the top of the skull reaching behind."
msgstr ""
"Un enorme dinosaurio escamoso con pezuñas y un pico ancho lleno de cientos de "
"pequeños dientes con una cresta puntiaguda en la parte superior del cráneo "
"que se extiende hacia atrás."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "edmontosaurus"
msgid_plural "edmontosaurus"
msgstr[0] "edmontosaurus"
msgstr[1] "edmontosaurus"
msgstr[2] "edmontosaurus"

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Description of monster "edmontosaurus"
msgid ""
"A huge scaly dinosaur with hooves and a broad toothless beak.  There are "
"teeth deeper in the mouth."
msgstr ""
"Un enorme dinosaurio escamoso con pezuñas y un pico ancho desdentado. Tiene "
"dientes en la profundidad de la boca."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "parasaurolophus"
msgid_plural "parasaurolophus"
msgstr[0] "parasaurolophus"
msgstr[1] "parasaurolophus"
msgstr[2] "parasaurolophus"

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Description of monster "parasaurolophus"
msgid ""
"A huge mottled dinosaur with four legs, a narrow beak, and a curved head "
"crest."
msgstr ""
"Un enorme dinosaurio moteado con cuatro patas, un pico fino y una cresta "
"curvada en la cabeza."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "lambeosaurus"
msgid_plural "lambeosaurus"
msgstr[0] "lambeosaurus"
msgstr[1] "lambeosaurus"
msgstr[2] "lambeosaurus"

