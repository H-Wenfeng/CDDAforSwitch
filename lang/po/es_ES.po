msgstr[1] "varas"
msgstr[2] "varas"

#: data/json/items/melee/bludgeons.json
#. ~ Description of "quarterstaff"
msgid ""
"A sturdy staff carved out of wood.  Lightweight and long, it is surprisingly "
"easy to handle."
msgstr ""
"Una robusta vara tallada en madera. Ligera y larga, es sorprendentemente "
"fácil de manejar."

#: data/json/items/melee/bludgeons.json
