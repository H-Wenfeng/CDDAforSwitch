msgstr[1] "hojas de guadaña"
msgstr[2] "hojas de guadaña"

#: data/json/items/generic.json
#. ~ Description of "scythe blade"
msgid ""
"A large, curved blade.  Could be used to assemble a scythe, or make an "
"improvised polearm."
msgstr ""
"Una gran hoja curva. Podría ser usada para ensamblar una guadaña, o hacer un "
"arma de asta improvisada."

#: data/json/items/generic.json
#. ~ Item name
msgid "circular sawblade"
msgid_plural "circular sawblades"
msgstr[0] "hoja de sierra circular"
msgstr[1] "hojas de sierra circular"
msgstr[2] "hojas de sierra circular"

#: data/json/items/generic.json
#. ~ Description of "circular sawblade"
msgid ""
"An 8\" circular sawblade.  You could make a saw with it, or throw it.  "
"Wielding it without sturdy gloves is a bad idea."
msgstr ""
"Una hoja de sierra circular de 8 pulgadas. Puedes hacer una sierra con ella, "
"o lanzarla. Empuñarla sin guantes resistentes es una mala idea."

#: data/json/items/generic.json
#. ~ Item name
msgid "tree spile"
msgid_plural "tree spiles"
msgstr[0] "grifo para árbol"
msgstr[1] "grifos para árboles"
msgstr[2] "grifos para árboles"

#: data/json/items/generic.json
#. ~ Description of "tree spile"
msgid ""
"A hollow metal cylinder which is inserted in a tree crust in order to slowly "
"harvest its sap.  Can be used on a maple tree between late winter and early "
"spring to harvest maple sap."
msgstr ""
"Un cilindro hueco de metal que se inserta en la corteza de un árbol para "
"cosechar lentamente su savia. Puede utilizarse en un arce entre finales del "
"invierno y principios de la primavera para cosechar savia de arce."

#: data/json/items/generic.json
#. ~ Item name
msgid "makeshift tree spile"
msgid_plural "makeshift tree spiles"
msgstr[0] "grifo de árbol improvisado"
msgstr[1] "grifos de árbol improvisados"
msgstr[2] "grifos de árbol improvisados"

#: data/json/items/generic.json
#. ~ Description of "makeshift tree spile"
msgid ""
"A carved piece of wood which is inserted in a tree crust in order to slowly "
"harvest its sap.  Can be used on a maple tree in between late winter and "
"early spring to harvest maple sap."
msgstr ""
"Una pieza de madera tallada que se inserta en la corteza de un árbol para "
"cosechar lentamente su savia. Puede utilizarse en un arce entre finales de "
"invierno y principios de primavera para cosechar savia de arce."

#: data/json/items/generic.json
#. ~ Item name
msgid "luminescent bead"
msgid_plural "luminescent beads"
msgstr[0] "cuenta luminiscente"
msgstr[1] "cuentas luminiscentes"
msgstr[2] "cuentas luminiscentes"

#: data/json/items/generic.json
#. ~ Description of "luminescent bead"
