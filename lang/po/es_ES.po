msgstr[1] "juegos de Buscaminos"
msgstr[2] "juegos Buscaminos"

#: data/json/items/fluff.json
#. ~ Description of "Wayfinder"
msgid ""
"A roleplaying game set in the a fantasy medieval world with goblins and orcs. "
" You can be a mage, a warrior, or a barbarian and go on epic adventures."
msgstr ""
"Un juego de rol ambientado en un mundo de fantasía medieval con duendes y "
"orcos. Puedes ser un mago, un guerrero o un bárbaro y vivir aventuras épicas."

#: data/json/items/fluff.json
#. ~ Item name
msgid "Dawn of Man"
msgid_plural "sets of Dawn of Man"
msgstr[0] "Amanecer del Hombre"
msgstr[1] "juegos de Amanecer del Hombre"
msgstr[2] "juegos de Amanecer del Hombre"

#: data/json/items/fluff.json
#. ~ Description of "Dawn of Man"
msgid ""
