msgid_plural "pumpkins"
msgstr[0] "calabaza"
msgstr[1] "calabazas"
msgstr[2] "calabazas"

#: data/json/items/comestibles/raw_veggy.json
#. ~ Description of "pumpkin"
msgid ""
"A large gourd, about the size of a person's head.  It'll require some "
"disassembly before use."
msgstr ""
"Una calabaza grande, del tamaño de la cabeza de una persona. Requerirá algo "
"de desensamblaje antes de usarla."

#: data/json/items/comestibles/raw_veggy.json
#. ~ Item name
msgid "cut pumpkin"
msgid_plural "cut pumpkin"
msgstr[0] "calabaza cortada"
msgstr[1] "calabazas cortadas"
msgstr[2] "calabazas cortadas"

