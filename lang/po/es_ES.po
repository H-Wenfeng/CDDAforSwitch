"instruments."
msgstr ""
"Un alambre de acero flexible y duradero, fabricado con acero templado para "
"muelles. Suele utilizarse en resortes industriales y de automoción, y como "
"alambre en instrumentos musicales."

#: data/json/items/generic.json
#. ~ Item name
msgid "barbed wire"
msgid_plural "barbed wires"
msgstr[0] "alambre de púas"
msgstr[1] "alambres de púas"
msgstr[2] "alambres de púas"

