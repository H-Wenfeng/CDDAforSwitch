"back and a long spiked tail ending in a club of bone."
msgstr ""
"Este dinosaurio de cuatro patas fuertemente blindado tiene varias púas largas "
"a lo largo de la espalda y una larga cola con púas que termina en una maza "
"ósea."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "tenontosaurus"
msgid_plural "tenontosaurus"
