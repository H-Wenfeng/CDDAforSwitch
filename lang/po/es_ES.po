msgid_plural "piano wires"
msgstr[0] "cuerda de piano"
msgstr[1] "cuerdas de piano"
msgstr[2] "cuerdas de piano"

#: data/json/items/generic.json
#. ~ Description of "piano wire"
msgid ""
"A length of thin, relatively stretchy coiled steel wire.  Used to produce "
"musical notes in instruments."
msgstr ""
"Una longitud de alambre de acero en espiral, fino y relativamente elástico. "
"Se utiliza para producir notas musicales en instrumentos."

#: data/json/items/generic.json
#. ~ Item name
