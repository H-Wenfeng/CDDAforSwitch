msgstr[0] "rulo"
msgstr[1] "rulos"
msgstr[2] "rulos"

#: data/json/items/generic/bathroom_house.json
#. ~ Description of "hair curler"
msgid "A soft plastic cylinder you can wrap a lock of your hair around to curl it."
msgstr ""
"Un cilindro de plástico suave con el que puedes envolver un mechón de tu pelo "
"para rizarlo."

#: data/json/items/generic/bathroom_house.json
#. ~ Item name
msgid "dental floss"
msgid_plural "rolls of dental floss"
msgstr[0] "rollo de hilo dental"
msgstr[1] "rollos de hilo dental"
msgstr[2] "rollos de hilo dental"

#: data/json/items/generic/bathroom_house.json
#. ~ Description of "dental floss"
msgid ""
"Twenty-five yards of finely waxed thread wound up inside a plastic container. "
" Perfect for picking bits of smoked meat out of your teeth.  Disassemble to "
"use the thread for something else."
msgstr ""
"25 yardas de hilo finamente encerado enrollado dentro de un contenedor de "
"plástico. Perfecto para sacar trozos de carne ahumada de tus dientes. "
"Desmóntalo para usar el hilo para otra cosa."

