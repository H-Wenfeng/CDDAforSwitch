#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#. ~ Terrain name
msgid "folded wall"
msgstr "muro/pared plegada"

#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#. ~ Description of terrain "folded wall"
msgid ""
"When looked at out of the side of the eye, this wall seems to bend and curve "
"in on itself and when looked at head on it seems to be a repeating pattern of "
"solid concrete hexagons."
msgstr ""
"Cuando se mira de reojo, este muro/pared parece doblarse y curvarse sobre sí "
"mismo, y cuando se mira de frente parece un patrón repetitivo de hexágonos de "
"hormigón macizo."

#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#. ~ Terrain name
msgid "unfolded wall"
msgstr "muro/pared sin plegar"

#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#. ~ Description of terrain "unfolded wall"
msgid "This wall tessellates as you view it."
msgstr "Este muro/pared se tesela según la veas."

#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#. ~ Terrain name
msgid "laser chamber"
msgstr "cámara láser"

#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#. ~ Description of terrain "laser chamber"
msgid ""
"A large section of metal tubing, balanced on spring supports to prevent any "
"vibration from affecting the laser inside."
msgstr ""
"Una gran sección de tubo metálico, equilibrada sobre soportes elásticos para "
"evitar que cualquier vibración afecte al láser en su interior."

