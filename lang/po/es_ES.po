#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built brick wall"
msgstr "muro/pared de ladrillos a medio construir"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built brick wall"
msgid ""
"Half of a brick wall.  It requires some more resources and effort before it'd "
"be considered a suitable wall."
msgstr ""
"La mitad de una pared de ladrillos. Se necesitan más recursos y esfuerzo "
"antes de ser considerado una pared adecuada."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "brick wall"
msgstr "muro/pared de ladrillos"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "brick wall"
msgid ""
"A solid brick wall, sturdy enough to support a roof with enough walls and to "
"keep out any unwanted visitors."
msgstr ""
"Un sólido muro/pared de ladrillos, lo suficientemente resistente como para "
"aguantar un techo/tejado con más paredes y mantener fuera a los visitantes "
"indeseables."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "stone wall"
msgstr "muro/pared de piedra"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "stone wall"
msgid "A sturdy stone wall."
msgstr "Un robusto muro/pared de piedra."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "whitewashed stone masonry wall"
msgstr "muro/pared de mampostería de piedra encalada"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "whitewashed stone masonry wall"
msgid ""
"A wall of carefully cut and laid stones, joined with mortar.  The exterior "
"has been finished with plaster and whitewashed."
msgstr ""
"Un muro/pared de piedras cuidadosamente cortadas y colocadas, unidas con "
"mortero. El exterior se ha acabado con yeso y se ha encalado."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built stone wall"
msgstr "muro/pared de piedra a medio construir"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built stone wall"
msgid ""
"Half of a sturdy stone wall.  Some work still needs to be done before it can "
"be considered a suitable wall."
msgstr ""
"La mitad de una robusta pared de piedra. Aún quedan algunas obras por hacer "
"antes de que pueda considerarse un muro/pared adecuado."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "smoothed rock"
msgstr "roca suavizada"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "smoothed rock"
msgid ""
"A block of stone that's been smoothed and shaped, commonly granite or marble "
"for funerary chapels and mausoleums."
msgstr ""
"Es un bloque de piedra que ha sido alisada, usualmente de granito o mármol "
"para usar en capillas y mausoleos."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built adobe wall"
msgstr "muro/pared de adobe a medio construir"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built adobe wall"
msgid ""
"Half of an adobe brick wall.  It requires some more resources and effort "
"before it'd be considered a suitable wall."
msgstr ""
"La mitad de una pared de ladrillos de adobe. Se necesitan más recursos y "
"esfuerzo antes de ser considerado una pared adecuada."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "adobe wall"
msgstr "muro de adobe"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "adobe wall"
msgid ""
"A solid adobe brick wall that's both sturdy enough to support a roof and keep "
"out any unwanted visitors."
msgstr ""
"Un sólido muro/pared de ladrillo de adobe lo suficientemente resistente como "
"para soportar un techo/tejado y mantener alejados a los visitantes no "
"deseados."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "concrete wall with ropes"
msgstr "muro/pared de hormigón con sogas"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "concrete wall with ropes"
msgid "A boxlike wall of concrete with ropes attached to the exterior edges."
msgstr ""
"Un muro/pared de hormigón en forma de caja con sogas sujetas a los bordes "
"exteriores."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "corrugated metal wall"
msgstr "muro/pared de metal corrugado"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "corrugated metal wall"
msgid ""
"A wall made from a thin sheet of corrugated steel held in a frame, weather- "
"and windproof but not very insulating or durable."
msgstr ""
"Una muro/pared hecha de una fina lámina de acero corrugado sujeta a un marco, "
"resistente a la intemperie y al viento, pero no muy aislante ni duradera."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "bulkhead"
msgid ""
"An industrially fabricated thick sheet carefully positioned, this wall is "
"capable of resisting extreme elements as well as hostile forces."
msgstr ""
"Una lámina gruesa fabricada industrialmente y cuidadosamente colocada, este "
"muro/pared es capaz de resistir los climas extremos, así como las fuerzas "
"hostiles."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built simple concrete wall"
msgstr "muro/pared de hormigón común a medio construir"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built simple concrete wall"
msgid ""
"A partially-poured concrete wall that could probably keep anything behind it "
"quite safe if it were finished."
msgstr ""
"Un muro de hormigón parcialmente vertido que probablemente podría mantener a "
"salvo todo lo que hubiera detrás si estuviera terminado."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built reinforced concrete wall"
msgstr "muro/pared de hormigón armado a medio construir"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built reinforced concrete wall"
msgid ""
"Poured concrete with methodically placed rebar sticking out, which isn't "
"practical for supporting roofs or shelter.  It needs more resources before it "
"could be considered complete."
msgstr ""
"Hormigón vertido con barras de refuerzo metódicamente colocadas que "
"sobresalen, lo que no resulta práctico para sostener techo/tejado o refugios. "
"Se necesitan más recursos antes de poder considerarla completa."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "rebar cage"
msgstr "jaula de barras corrugadas"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "rebar cage"
msgid ""
"A structural support system made of rebar that appears to be the early stages "
"of a reinforced concrete wall, just missing the poured concrete."
msgstr ""
"Un sistema de apoyo estructural hecho de barras corrugadas que parecen ser "
"las primeras etapas de un muro/pared de hormigón armado, al que sólo le falta "
"el hormigón vertido."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "simple metal wall"
msgstr "muro/pared simple de metal"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "simple metal wall"
msgid ""
"A relatively simple wall made of cobbled-together scrap metal.  It's still "
"capable of blocking intruders and supporting a roof with adjacent walls."
msgstr ""
"Un muro/pared relativamente simple hecha de restos de metal unidos. Es capaz "
"de bloquear a los intrusos y soportar un techo/tejado con muros/paredes "
"adyacentes."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built simple metal wall"
msgstr "muro/pared simple de metal a medio construir"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built simple metal wall"
msgid ""
"A partially-built makeshift metal wall that could potentially support a roof "
"if it were completed."
msgstr ""
"Un muro/pared improvisado de metal a medio construir, que podría soportar un "
"techo/tejado si estuviera terminada."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "chipped wood wall"
msgstr "muro/pared astillado de madera"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "chipped wood wall"
msgid ""
"A wall of aligned planks that's starting to crack and break open.  Some "
"replacement wood and a number of nails could patch this up quick."
msgstr ""
"Una pared de tablones alineados que está empezando a agrietarse y romperse. "
"Un poco de madera cortada y varios clavos podrían parchear esto rápidamente."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "broken wood wall"
msgstr "muro/pared roto de madera"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "broken wood wall"
msgid ""
"A number of planks are missing and the structure is beginning to sag and fall "
"apart.  It's going to need quite a bit of work to repair."
msgstr ""
"Unos cuantos tablones han desaparecido y la estructura empieza a hundirse y "
"desmoronarse. Va a necesitar bastante trabajo para ser reparada."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "burnt wall"
msgstr "muro/pared quemada"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "burnt wall"
msgid ""
"Whatever this wall used to be made of, it's little more than charred remains "
"now."
msgstr ""
"Sea lo que sea de lo que estaba hecho este muro/pared, ahora es poco más que "
"restos carbonizados."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built log wall"
msgstr "muro/pared de leños a medio construir"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built log wall"
msgid ""
"A half-constructed wall of notched logs that interlock to provide stability.  "
"Needs a few more logs to hold up a roof.  Looks flammable."
msgstr ""
"Un muro/pared a medio construir hecha de leños dentados que se interconectan "
"para crear estabilidad. Necesita algunos leños más para poder soportar un "
"techo/tejado. Parece inflamable."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "log wall"
msgstr "muro/pared de leños"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "log wall"
msgid ""
"A tall wall of timber suitable for housing and insulating from the weather.  "
"Quite flammable."
msgstr ""
"Un muro/pared alta de madera, ideal para una casa y para aislarte del clima. "
"Bastante inflamable, eso sí."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "chipped log wall"
msgstr "muro/pared quebrado de leños"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "chipped log wall"
msgid ""
"A moderately damaged log wall, it could probably be patched up with some "
"planks and nails."
msgstr ""
"Una pared de leños moderadamente dañada, probablemente podría ser remendada "
"con algunos tablones y clavos."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "broken log wall"
msgstr "muro roto de leños"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "broken log wall"
msgid ""
"A destroyed log wall, with only a supporting log left, ready to collapse.  "
"Looks repairable if the damage was replaced and patched together with nails "
"and planks."
msgstr ""
"Un muro/pared de leños destruido, del que sólo queda un leño de apoyo, a "
"punto de derrumbarse. Parece reparable si se sustituyeran los daños y se "
"remendara con clavos y tablones."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "palisade wall"
msgstr "empalizada"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "palisade wall"
msgid ""
"An age-old type of fortification consisting of hefty lumber staked into the "
"ground and cabled together."
msgstr ""
"Un tipo de fortificación antigua que consiste en madera pesada clavada en el "
"suelo y cableada."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "wattle-and-daub wall"
msgstr "muro/pared de bareque"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "wattle-and-daub wall"
msgid ""
"A relatively primitive wall made by daubing together a lattice of wooden "
"strips using some combination of wet soil, clay, sand, animal dung, and straw."
msgstr ""
"Una pared relativamente primitiva hecha con una red de listones de madera "
"utilizando una combinación de tierra húmeda, arcilla, arena, estiércol y paja."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "broken wattle-and-daub wall"
msgstr "muro/pared de bareque roto"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "broken wattle-and-daub wall"
msgid ""
"A wattle-and-daub wall section that has been destroyed, leaving mostly just "
"the frame, and even that is barely held together."
msgstr ""
"Una sección de la pared de bareque que ha sido destruida, dejando en su mayor "
"parte sólo el marco, e incluso eso apenas se mantiene unido."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built wattle-and-daub wall"
msgstr "medio muro/pared de bareque"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built wattle-and-daub wall"
msgid ""
"A partially-complete wattle-and-daub wall with some of the wooden strip "
"lattice in place.  It still requires the rest of the lattice and supporting "
"wet compound to be filled in."
msgstr ""
"Un muro/pared de bareque parcialmente terminado con parte de la rejilla de "
"listones de madera colocada. Aún hay que rellenar el resto de la rejilla y el "
"compuesto húmedo de soporte."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "junk metal wall"
msgstr "muro/pared de chatarra metálica"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "junk metal wall"
msgid ""
"A wall of rusty scrap metal bolted and wire-tied to a sturdy frame.  Very "
"fashionable in post-apocalyptic shantytowns.  Can support a roof."
msgstr ""
"Un muro/pared de restos de metal oxidados, atornillados y atados con alambre "
"a un marco robusto. Muy de moda en los barrios de chabolas "
"post-apocalípticos. Puede soportar un techo/tejado."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "rammed earth wall"
msgstr "muro de tierra compactada"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "rammed earth wall"
msgid ""
"A solid wall of compressed dirt, sturdy enough to support a roof with enough "
"walls and to keep out some unwanted visitors."
msgstr ""
"Una pared sólida de tierra comprimida, lo suficientemente robusta como para "
"soportar un techo/tejado con suficientes paredes y mantener fuera a algunos "
"visitantes indeseables."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Bashing sound
msgid "heavy rumbling!"
msgstr "¡Un fuerte estruendo!"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "smooth dirt wall"
msgstr "muro de tierra lisa"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "smooth dirt wall"
msgid ""
"A solid wall of compressed dirt, mixed with… something to keep it stable.  "
"Its surface glistens slightly, and it smells like rotten milk."
msgstr ""
"Un sólido de tierra compactada, mezclada con... algo que la mantiene estable. "
"Su superficie brilla ligeramente y huele a leche podrida."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "warped wall"
msgstr "muro deformado"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "warped wall"
msgid ""
"At first glance, this looks like a simple stone wall.  But the angles don't "
"add up, and the shadows are wrong.  Whatever this is, it doesn't belong here."
msgstr ""
"A simple vista, es casi una pared de piedra común y corriente pero los "
"ángulos no tienen sentido, las sombras están mal, sea lo que sea esto, no "
"pertenece a este lugar."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "junk metal barrier"
msgstr "barrera de chatarra metálica"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "junk metal barrier"
msgid ""
"A simple wall of rusty scrap metal bolted and wire-tied to a makeshift frame. "
" Very fashionable in post-apocalyptic shantytowns.  This one isn't quite "
"strong enough to support a roof, but could be reinforced."
msgstr ""
"Un simple muro/pared de restos de metal atornillados y atados con alambre a "
"una estructura improvisada. Muy elegante para las chabolas "
"post-apocalípticos. Este no es tan fuerte como para sostener un techo/tejado, "
"pero puede ser reforzado."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "glass wall"
msgstr "muro de cristal"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "glass wall"
msgid ""
"A barrier made of glass, it's nothing complicated, and looks extremely "
"fragile.  Some contain glass break sensors or window sensors that trigger an "
"alarm if the glass is damaged."
msgstr ""
"Una barrera hecha de vidrio, nada complicado, y parece extremadamente frágil. "
"Algunos contienen sensores de rotura de cristal o sensores de ventanas que se "
"activan si se manipula el cristal."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "laminated glass"
msgstr "cristal laminado"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "laminated glass"
msgid ""
"A laminated glass barrier, composed of layers of glass and plastic held "
"together by an interlayer."
msgstr ""
"Una puerta cerrada de cristal laminado, compuesta por capas de cristal y "
"plástico unidas por una capa intermedia."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "ballistic glass"
msgstr "cristal antibalas"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "ballistic glass"
msgid "A ballistic glass barrier, consisting of layers of laminated glass."
msgstr "Un cristal antibalas, que consiste en capas de cristal laminado."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "reinforced glass"
msgstr "cristal reforzado"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "reinforced glass"
msgid ""
"A thicker pane of glass with thin metal wires embedded throughout, "
"strengthening the structural properties.  Still weaker than other types of "
"walls, and not made to support a roof either."
msgstr ""
"Un panel grueso de cristal con delgados cables metálicos entretejidos, lo que "
"hacen la estructura más fuerte. Igual es más débil que otro tipo de muro, y "
"no puede soportar un techo/tejado."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "reinforced glass with closed shutters"
msgstr "cristal reforzado con persiana cerrada"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "reinforced glass with closed shutters"
msgid ""
"A secondary layer of protection over reinforced glass, these metal shutters "
"are typically used to ward off criminals or protect against damage from "
"extreme weather.  Looks like it can only be opened from the inside.  Even "
"with the installed shutters, it isn't feasible in supporting a roof."
msgstr ""
"Una capa secundaria de protección sobre el cristal reforzado, estas persianas "
"metálicas se utilizan típicamente para proteger a los delincuentes o para "
"protegerse de los daños causados por el clima extremo. Parece que sólo se "
"puede abrir desde el interior. Incluso con las persianas instaladas, no es "
"factible soportar un techo/tejado."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "reinforced glass with open shutters"
msgstr "cristal reforzado con persiana abierta"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "reinforced glass with open shutters"
msgid ""
"Hanging metal shutters that haven't been deployed, exposing the reinforced "
"glass.  It appears as though the metal shutters can only be activated from "
"the inside."
msgstr ""
"Tiene unas cortinas de metal colgando que no han sido desplegadas, dejando "
"expuesto el cristal reforzado. Parece que esas cortinas solo pueden ser "
"activadas desde el interior."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "lighthouse lens"
msgstr "lentes de faro"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "lighthouse lens"
msgid ""
"An intricate arrangement of glass, designed to focus light from within to be "
"visible over long distances."
msgstr ""
"Una intrincada disposición de cristales, diseñada para enfocar la luz desde "
"el interior y ser visible a larga distancia."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "metal bars"
msgstr "barras de metal"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "metal bars"
msgid ""
"Thick, heavy bars from the floor to the ceiling, interlaced wall to wall.  "
"Not made to support roofs, but great for blocking paths."
msgstr ""
"Barras gruesas y pesadas desde el suelo hasta el techo, entrelazadas de "
"muro/pared a muro/pared. No sirven para sostener techos/tejados, pero son "
"ideales para bloquear caminos."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "paper wall"
msgstr "muro de papel"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "paper wall"
msgid ""
"A huge wall of ambiguous pulpy matter, covered in sticky wasp saliva.  You "
"could smash it down effortlessly."
msgstr ""
"Una enorme pared de imprecisa materia pulposa, cubierta de pegajosa saliva de "
"avispa. Puedes aplastarla sin esfuerzo."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "layered paper wall"
msgstr "muro de papel estratificado"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "layered paper wall"
msgid ""
"A thick wall of layered tree pulp and wasp saliva, hardened to withstand the "
"elements.  You could break through this, but it won't be easy."
msgstr ""
"Un grueso muro de capas de pulpa de árbol y saliva de avispa, endurecido para "
"soportar los elementos. Podrías atravesar esto, pero no será fácil."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "root wall"
msgstr "muro de raíces"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "root wall"
msgid "A dirt wall covered with roots."
msgstr "Una muro de tierra cubierta de raíces."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "wax wall"
msgstr "muro de cera"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "wax wall"
msgid "A wall made entirely out of wax."
msgstr "Un muro hecho completamente de cera."

#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_mall.json
#: data/json/overmap/overmap_terrain/overmap_terrain_special.json
#: data/mods/Magiclysm/worldgen/overmap_terrain.json
#: data/mods/No_Hope/overmap/overmap_terrain_necropolis.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "solid earth"
msgstr "tierra sólida"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "solid earth"
msgid "A wall of solid earth."
msgstr "Un muro de tierra sólida."

#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/overmap/overmap_terrain/overmap_terrain_hardcoded.json
#: data/json/overmap/overmap_terrain/overmap_terrain_netherum_labyrinth.json
#: data/json/overmap/overmap_terrain/overmap_terrain_special.json
#: data/mods/Magiclysm/worldgen/overmap_terrain.json
#: data/mods/No_Hope/overmap/overmap_terrain_necropolis.json
#: data/mods/innawood/mining/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "solid rock"
msgstr "piedra sólida"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "solid rock"
msgid ""
"A wall of solid rock, could be full of all kinds of interesting things.  Best "
"grab your pickaxe or equivalent digging implement, and strike the earth!"
msgstr ""
"Una pared de roca sólida, podría estar llena de todo tipo de cosas "
"interesantes. ¡Mejor coge tu pico o un instrumento de excavación equivalente "
"y golpea la tierra!"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "red stone"
msgstr "piedra roja"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "red stone"
msgid "A wall of red stone."
msgstr "Una pared de piedra roja."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "green stone"
msgstr "piedra verde"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "green stone"
msgid "A wall of green stone."
msgstr "Una pared de piedra verde."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "blue stone"
msgstr "piedra azul"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "blue stone"
msgid "A wall of blue stone."
msgstr "Una pared de piedra azul."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "little column"
msgstr "columna pequeña"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "little column"
msgid "A small support column."
msgstr "Una pequeña columna de soporte."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built column"
msgstr "columna a medio construir"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built column"
msgid ""
"An empty wooden frame in the shape of a column, built around a concrete and "
"rebar foundation.  It isn't capable of supporting roofs or shelter, and needs "
"more resources before it could be considered complete."
msgstr ""
"Un marco de madera vacío en forma de columna, construido alrededor de una "
"base de hormigón y barras corrugadas. No es capaz de soportar techos/tejados "
"o refugios, y parece que necesita más recursos antes de ser considerada "
"completa."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "column"
msgstr "columna"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "column"
msgid "A concrete column."
msgstr "Una columna de hormigón."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "bollard"
msgstr "bolardo"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "bollard"
msgid ""
"A set of concrete and steel bollards sticking out of the ground, designed to "
"protect areas against vehicle ram attacks.  It requires a few more steps for "
"you to walk between the bollards."
msgstr ""
"Un conjunto de bolardos de hormigón y acero que sobresalen del suelo, "
"diseñados para proteger áreas contra ataques de vehículos. Requieres más "
"movimientos el atravesarlos."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "large metal support"
msgstr "soporte grande de metal"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "large metal support"
msgid "A heavy-duty metal support beam."
msgstr "Una viga de soporte de metal resistente."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "small metal support"
msgstr "soporte chico de metal"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "small metal support"
msgid "A metal support beam."
msgstr "Una viga de soporte de metal."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "field stone wall"
msgstr "muro de piedra en el campo"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "field stone wall"
msgid "A sturdy, dry stone wall.  Just rocks fitted together without mortar."
msgstr "Un robusta pared de piedra seca. Sólo rocas encajadas sin mortero."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "field stone half-wall"
msgstr "medio muro de piedra en el campo"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "field stone half-wall"
msgid ""
"A sturdy, half-height, dry stone wall.  Just rocks fitted together without "
"mortar."
msgstr ""
"Un robusto muro de piedra seca de media altura. Sólo rocas encajadas sin "
"mortero."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "pillar"
msgstr "pilar"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "pillar"
msgid ""
"A concrete column that helps keep the mine's ceiling and walls from "
"collapsing."
msgstr ""
"Una columna de hormigón que ayuda a evitar que el techo y las paredes de la "
"mina se derrumben."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "hardened resin mass"
msgstr "masa de resina endurecida"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "hardened resin mass"
msgid ""
"A mass of expansive foam that has hardened like a rock, tough enough to stop "
"most zombies from breaking through.  It's big enough to walk ontop of."
msgstr ""
"Una masa de espuma expansiva que se ha endurecido como una roca, lo "
"suficientemente dura como para impedir que la mayoría de los zombis la "
"atraviesen. Es suficientemente grande como para caminar sobre ella."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window"
msgstr "ventana"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window"
msgid ""
"A giant sheet of glass inserted into a window, typically found on the side of "
"shops to showcase goods."
msgstr ""
"Una hoja de cristal gigante insertada en una ventana, típicamente encontrada "
"en el costado de las tiendas para exhibir mercancías."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "taped window"
msgstr "ventana encintada"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped window"
msgid ""
"Duct tape covers this window, blocking sunlight and visibility.  You could "
"remove the duct tape by cutting it off."
msgstr ""
"Esta ventana esta tapada con cinta americana, lo que bloquea la visibilidad y "
"la luz solar. Podrías sacar la cinta americana cortándola."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with curtains"
msgstr "ventana con cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with curtains"
msgid ""
"A closed window with fancy curtains on the inside that can be drawn closed to "
"block visibility and shut out any light."
msgstr ""
"Una ventana cerrada con elegantes cortinas en el interior que pueden cerrarse "
"para bloquear la visibilidad y dejar fuera la luz."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying message of terrain "window with curtains"
#. ~ Prying message of terrain "window without curtains"
#. ~ Prying message of terrain "window with closed curtains"
msgid "You pry open the window."
msgstr "Abres la ventana a la fuerza."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying failure of terrain "window with curtains"
#. ~ Prying failure of terrain "window without curtains"
#. ~ Prying failure of terrain "window with closed curtains"
msgid "You pry, but can't pry open the window."
msgstr "Haces palanca, pero no puedes abrir la ventana."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window without curtains"
msgstr "ventana sin cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window without curtains"
msgid ""
"A closed smaller window typically found in residential homes.  You could "
"install a curtain rod and drapes to block visibility and shut out any light "
"if you had the supplies and skill."
msgstr ""
"Una ventana cerrada más pequeña que suele encontrarse en las casas "
"residenciales. Podrías instalar una barra de cortina y cortinas para bloquear "
"la visibilidad y bloquear cualquier luz si tuvieras los suministros y la "
"habilidad."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open window without curtains"
msgstr "ventana abierta sin cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open window without curtains"
msgid ""
"A smaller window typically found in residential homes.  It's open and can be "
"crawled through."
msgstr ""
"Ventana más pequeña que suele haber en las viviendas. Está abierta y se puede "
"reptar a través de ella."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped window"
msgid ""
"A smaller window typically found in residential homes.  This one has been "
"blocked out with duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Una ventana más pequeña que se encuentra típicamente en las casas "
"residenciales. Esta ha sido bloqueada con cinta americana. Podrías quitar la "
"cinta americana cortándola."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped window"
msgid ""
"A window with fancy curtains on the inside.  This one has been blocked out "
"with duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Una ventana con elegantes cortinas en la parte interior. Ha sido tapada con "
"cinta americana. Podrías cortar la cinta americana para sacarla."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open window with curtains"
msgstr "ventana abierta con cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open window with curtains"
msgid ""
"A window with fancy curtains on the inside that can be drawn closed to block "
"visibility and shut out any light.  It's open and you can crawl through."
msgstr ""
"Una ventana con cortinas de fantasía en el interior que se puede cerrar para "
"bloquear la visibilidad y apagar cualquier luz. Está abierta y puedes reptar "
"a través de ella."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with closed curtains"
msgstr "cortinas cerradas de ventana"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with closed curtains"
msgid ""
"A closed window with fancy curtains that have been drawn shut, blocking "
"sunlight and visibility.  The curtains can only be opened from the inside.  "
"If you examined the curtains more closely, you could peek through the drapes "
"or tear down everything.  Or you could just smash the window open."
msgstr ""
"Una ventana cerrada con cortinas elegantes que se encuentran cerradas, "
"bloqueando la luz del sol y la visibilidad. Las cortinas sólo se pueden abrir "
"desde dentro. Si examinas las cortinas más de cerca, podrías asomarte a "
"través de las cortinas o romperlas. O podrías reventar la ventana de un golpe."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped window"
msgid ""
"Duct tape covers this window, blocking out any sunlight and visibility.  You "
"could remove the duct tape by cutting it off."
msgstr ""
"La cinta americana cubre esta ventana, bloqueando la luz del sol y la "
"visibilidad. Podrías quitar la cinta americana cortándola."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "empty window"
msgstr "ventana vacía"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "empty window"
msgid ""
"An empty window frame made of planks and nails.  You could install a sheet of "
"glass, or board it up for protection.  You could also convert it into a solid "
"wall if you took the time to construct it."
msgstr ""
"Un marco de ventana vacío hecho de tablones y clavos. Podrías instalar una "
"hoja de cristal o tapiarla para protegerla. También podrías convertirlo en "
"una pared sólida si te tomas el tiempo de construirla."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "empty window with curtains"
msgstr "ventana vacía con cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "empty window with curtains"
msgid ""
"An empty window frame consisting of planks and nails, with open curtains.  "
"You could install a sheet of glass, or even board it up for protection.  You "
"could also convert it into a wall if you took the time to construct it."
msgstr ""
"Un marco de ventana vacío formado por tablones y clavos, con cortinas "
"abiertas. Podrías instalar una hoja de cristal, o incluso tapiarla para "
"protegerla. También podrías convertirlo en una pared si te tomaras el tiempo "
"de construirla."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "empty window with closed curtains"
msgstr "ventana vacía con cortinas cerradas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "empty window with closed curtains"
msgid ""
"An empty window frame consisting of planks and nails, with closed curtains.  "
"If you examined the curtains more closely, you could peek through the drapes "
"or tear down everything.  You could install a sheet of glass, or even board "
"it up for protection.  You could also convert it into a wall if you took the "
"time to construct it."
msgstr ""
"Un marco de ventana vacío formado por tablones y clavos, con las cortinas "
"cerradas. Si examinas las cortinas más de cerca, podrías asomarte a través de "
"ellas o derribarlo todo. Podrías instalar una hoja de cristal, o incluso "
"tapiarla para protegerla. También podrías convertirla en una pared si te "
"tomaras el tiempo de construirla."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window frame"
msgstr "marco de ventana"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window frame"
msgid ""
"A wooden window frame filled with shattered glass.  You'll probably get hurt "
"if you crawl through the sharp and jagged shards.  You could smash out the "
"remaining pieces, or take your time and quietly remove them."
msgstr ""
"Un marco de ventana de madera que tiene cristales rotos a su alrededor. "
"Probablemente te lastimarás si reptas a través de los fragmentos afilados y "
"dentados. Podrías romper los restos que quedan, o tomarte tu tiempo y "
"limpiarlos silenciosamente."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "boarded up window"
msgstr "ventana cubierta con tablas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "boarded up window"
msgid ""
"A glass window that has been covered with nailed-down planks, blocking "
"sunlight and visibility.  It's not much stronger, but it could be further "
"reinforced with strategically placed planks."
msgstr ""
"Una ventana de cristal que ha sido cubierta con tablones clavados, bloqueando "
"la luz solar y la visibilidad. Podría reforzarse más con tablones "
"estratégicamente colocados."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying message of terrain "boarded up window"
msgid "You pry the boards from the window."
msgstr "Sacas las tablas de la ventana."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "boarded up window"
msgid ""
"An empty window frame that has been covered with nailed-down planks, blocking "
"sunlight and visibility.  It's not a very strong barrier, but it could be "
"further reinforced with strategically placed planks."
msgstr ""
"Un marco de ventana vacío que ha sido cubierto con tablones clavados, "
"bloqueando la luz solar y la visibilidad. Podría reforzarse más con tablones "
"estratégicamente colocados."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying message of terrain "boarded up window"
msgid "You pry the boards from the window frame."
msgstr "Sacas la tablas del marco de la ventana."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with makeshift shutters"
msgstr "ventana con contraventanas improvisadas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with makeshift shutters"
msgid ""
"A glass window with a heavy makeshift shutter bolted into the window frame, "
"with a wooden bar to close it from the inside.  It's fairly sturdy when "
"closed."
msgstr ""
"Una ventana de cristal con una pesada contraventana improvisada atornillada "
"al marco de la ventana, con una barra de madera para cerrarla desde dentro. "
"Es bastante resistente cuando está cerrada."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with open makeshift shutters"
msgstr "ventana con contraventanas improvisadas abiertas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with open makeshift shutters"
msgid ""
"A glass window with a heavy makeshift shutter bolted into the window frame, "
"with a wooden bar to close it from the inside.  The shutters are currently "
"open, and offer no more defense than any glass window."
msgstr ""
"Una ventana de cristal con una pesada contraventana improvisada atornillada "
"al marco de la ventana, con una barra de madera para cerrarla desde dentro. "
"Las contraventanas están abiertas y no ofrecen más defensa que cualquier "
"ventana de cristal."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying message of terrain "window with open makeshift shutters"
msgid "You pry the window open"
msgstr ""

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with open makeshift shutters"
msgid ""
"A glass window with a heavy makeshift shutter bolted into the window frame, "
"with a wooden bar to close it from the inside.  Both the shutters and the "
"window glass are wide open, offering no defense."
msgstr ""
"Una ventana de cristal con una pesada contraventana improvisada atornillada "
"al marco de la ventana, con una barra de madera para cerrarla desde dentro. "
"Tanto la contraventana como el cristal de la ventana están abiertos de par en "
"par y no ofrecen ninguna defensa."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "reinforced boarded up window"
msgstr "ventana reforzada cubierta con tablas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced boarded up window"
msgid ""
"A heavily fortified glass window with planks carefully placed across the "
"glass to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Una ventana con cristal muy fortificada, con tablones de madera colocados "
"cuidadosamente en el marco para bloquear la visibilidad. Si le agregas unas "
"púas y unas placas de metal podrías incrementar su durabilidad."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced boarded up window"
msgid ""
"A heavily fortified window with planks carefully placed across the open frame "
"to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Una ventana muy fortificada, con tablones de madera colocados cuidadosamente "
"en el marco para bloquear la visibilidad. Si le agregas unas púas y unas "
"placas de metal podrías incrementar su durabilidad."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "armored boarded up window"
msgstr "ventana blindada cubierta con tablas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "armored boarded up window"
msgid ""
"This once-normal glass window now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Esta ventana de cristal, que una vez fue normal, ahora amenaza con tener púas "
"a lo largo de los bordes, con láminas metálicas laboriosamente colocadas para "
"fortalecer aún más los refuerzos de madera debajo de ella."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "armored boarded up window"
msgid ""
"This once-normal window frame now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Este marco de ventana que una vez fue normal ahora amenaza con púas a lo "
"largo de los bordes, con láminas metálicas laboriosamente colocadas para "
"fortalecer aún más los refuerzos de madera debajo de ella."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with metal bars"
msgstr "ventana con barras de metal"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal bars"
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed in high-value "
"stores, or ones in bad neighborhoods."
msgstr ""
"Una hoja gigante de cristal insertada en una ventana con gruesas rejillas de "
"seguridad, que hace imposible atravesarla. Suele instalarse en tiendas de "
"gran valor o en barrios conflictivos."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window frame with metal bars"
msgstr "marco de ventana con barras de metal"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window frame with metal bars"
msgid ""
"A window frame blocked with thick security grilles, making it impossible to "
"crawl through.  Typically installed in high-value stores, or ones in bad "
"neighborhoods."
msgstr ""
"Un marco de ventana bloqueado con gruesas rejillas de seguridad, que hace "
"imposible atravesarlo. Suele instalarse en tiendas de gran valor o en barrios "
"conflictivos."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal bars"
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed in high-value "
"stores, or ones in bad neighborhoods.  It has a small sticker in one corner, "
"reading 'Protected by SecuriCorp.  Keeping you safe since 1993.'"
msgstr ""
"Una lámina gigante de cristal insertada en una ventana con gruesas rejillas "
"de seguridad, lo que hace imposible atravesarla. Suele instalarse en tiendas "
"de alto valor o en barrios conflictivos. Tiene una pequeña pegatina en una "
"esquina que dice: \"Protegido por SecuriCorp. Manteniéndole a salvo desde "
"1993\"."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with metal bars and curtains"
msgstr "ventana con barras de metal y cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal bars and curtains"
msgid ""
"A barred window with fancy curtains that have been drawn shut, blocking "
"sunlight and visibility.  The curtains can only be opened from the inside.  "
"If you examined the curtains more closely, you could peek through the drapes "
"or tear down everything."
msgstr ""
"Una ventana enrejada con cortinas elegantes que han sido cerradas, bloqueando "
"la luz del sol y la visibilidad. Las cortinas sólo pueden abrirse desde "
"dentro. Si se examinan las cortinas más de cerca, se puede mirar a través de "
"las cortinas o romperlas."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal bars and curtains"
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed in high-value "
"stores, or ones in bad neighborhoods.  This one has been retrofitted with "
"curtains, which are currently open."
msgstr ""
"Una lámina de cristal gigante insertada en una ventana con gruesas rejas de "
"seguridad, haciendo imposible atravesarla. Típicamente instalada para tiendas "
"de gran valor, o al menos tiendas en barrios conflictivos. Esta ha sido "
"actualizada con cortinas que se encuentran abiertas."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "stone wall with high stained glass window"
msgstr "muro de piedra con vidriera alta de colores"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "stone wall with high stained glass window"
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an elegant emerald landscape."
msgstr ""
"Un muro de piedra con una ventana alta que contiene una impresionante "
"vidriera artesanal con un elegante paisaje esmeralda."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Bashing sound
msgid "a crash and glass breaking!"
msgstr "¡un impacto y cristales rompiédose!"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "stone wall with high stained glass window"
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an otherworldly radiant ruby flower blooming."
msgstr ""
"Un muro de piedra con una alta ventana que contiene una vidriera artesanal "
"impresionante con una flor de rubí radiante de otro mundo floreciendo."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "high stained glass window"
msgstr "vidriera alta"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "high stained glass window"
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an alluring azure oceanic abyss."
msgstr ""
"Un muro de piedra con una alta ventana que contiene una vidriera artesanal "
"impresionante con un atractivo abismo oceánico de color azul."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with metal grate"
msgstr "ventana con rejilla metálica"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate"
msgid ""
"Metal bars made into a grate for a glass window.  Highly durable and will "
"stand against any foe."
msgstr ""
"Barras de metal convertidas en reja para una ventana de cristal. Muy "
"duraderas y resistentes contra cualquier enemigo."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with metal grate and curtains"
msgstr "ventana con barras de metal y cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate and curtains"
msgid ""
"Metal bars made into a grate for a glass window with a closed curtain.  "
"Highly durable and will stand against any foe."
msgstr ""
"Barras de metal en forma de reja para una ventana de cristal con una cortina "
"cerrada. Muy duraderas y resistentes contra cualquier enemigo."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate and curtains"
msgid ""
"Metal bars made into a grate for a glass window with an opened curtain.  "
"Highly durable and will stand against any foe."
msgstr ""
"Barras de metal en forma de reja para una ventana de cristal con una cortina "
"abierta. Muy duraderas y resistentes contra cualquier enemigo."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate"
msgid ""
"Metal bars made into a grate for an empty window.  Highly durable and will "
"stand against any foe."
msgstr ""
"Barras de metal convertidas en reja para una ventana vacía. Muy duraderas y "
"resistentes contra cualquier enemigo."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate and curtains"
msgid ""
"Metal bars made into a grate for an empty window frame with a closed curtain. "
" Highly durable and will stand against any foe."
msgstr ""
"Barras de metal en forma de rejilla para un marco de ventana vacío con una "
"cortina cerrada. Muy duraderas y resistentes contra cualquier enemigo."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate and curtains"
msgid ""
"Metal bars made into a grate for an empty window frame with an opened "
"curtain.  Highly durable and will stand against any foe."
msgstr ""
"Barras de metal hechas reja para un marco de ventana vacío con una cortina "
"abierta. Muy duraderas y resistentes contra cualquier enemigo."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "single glazed window"
msgstr "ventana de un solo cristal"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "single glazed window"
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's currently closed."
msgstr ""
"Una ventana de un solo cristal. Consiste en una lámina de cristal gigante "
"insertada en un marco de ventana. Actualmente está cerrada."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open single glazed window"
msgstr "ventana abierta de un solo cristal"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open single glazed window"
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's open and can be crawled through."
msgstr ""
"Una ventana de un solo cristal. Consiste en una lámina gigante de cristal "
"insertada en un marco de ventana. Está abierta y se puede reptar por ahí."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "single glazed window with closed curtains"
msgstr "ventana de un solo cristal con cortinas cerradas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "single glazed window with closed curtains"
msgid ""
"A closed single glazed window with a fancy curtain on the inside that is "
"closed to block visibility and shut out any light."
msgstr ""
"Una ventana cerrada de un solo cristal con una cortina elegante en el "
"interior que se cierra para bloquear la visibilidad y dejar fuera la luz."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "single glazed window with curtains"
msgstr "ventana de cristal simple con cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "single glazed window with curtains"
msgid ""
"A closed single glazed window with a fancy curtain on the inside that can be "
"drawn closed to block visibility and shut out any light."
msgstr ""
"Una ventana cerrada de un solo cristal con una elegante cortina en el "
"interior que puede cerrarse para bloquear la visibilidad y dejar fuera la luz."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open single glazed window with curtains"
msgstr "ventana abierta de un solo cristal con cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open single glazed window with curtains"
msgid ""
"A single glazed window with a fancy curtain on the inside that can be drawn "
"closed to block visibility and shut out any light.  It's open and can be "
"crawled through."
msgstr ""
"Una ventana de un solo cristal con una elegante cortina en el interior que "
"puede cerrarse para bloquear la visibilidad y dejar fuera la luz. Está "
"abierta y se puede reptar por ahí."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "taped single glazed window"
msgstr "ventana de cristal simple encintada"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped single glazed window"
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's currently closed.  This one has been blocked out with "
"duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Una ventana de un solo cristal. Consiste en una lámina gigante de cristal "
"insertada en un marco de ventana. Actualmente está cerrada. Esta ha sido "
"bloqueada con cinta adhesiva. Se puede quitar la cinta adhesiva cortándola."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "reinforced single glazed window"
msgstr "ventana reforzada de cristal simple"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced single glazed window"
msgid ""
"A reinforced single glazed window.  Consists of a giant sheet of reinforced "
"glass inserted into a window frame.  It's currently closed."
msgstr ""
"Una ventana reforzada de cristal simple. Consiste en una lámina gigante de "
"cristal reforzado insertada en un marco de ventana. Actualmente está cerrada."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open reinforced single glazed window"
msgstr "ventana abierta reforzada de un solo cristal"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open reinforced single glazed window"
msgid ""
"A reinforced single glazed window.  Consists of a giant sheet of reinforced "
"glass inserted into a window frame.  It's open and can be crawled through."
msgstr ""
"Una ventana reforzada de cristal simple. Consiste en lámina gigante de "
"cristal reforzado insertada en un marco de ventana. Está abierta y se puede "
"reptar por ahí."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "reinforced single glazed window with closed curtains"
msgstr "ventana reforzada de un solo cristal con cortinas cerradas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced single glazed window with closed
#. curtains"
msgid ""
"A closed reinforced single glazed window with a fancy curtain on the inside "
"that is drawn closed to block visibility and shut out any light."
msgstr ""
"Una ventana cerrada reforzada de un solo cristal con una cortina de fantasía "
"en el interior que se cierra para bloquear la visibilidad y dejar fuera la "
"luz."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "reinforced single glazed window with curtains"
msgstr "ventana reforzada de un solo cristal con cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced single glazed window with curtains"
msgid ""
"A closed reinforced window with a fancy curtain on the inside that can be "
"drawn closed to block visibility and shut out any light."
msgstr ""
"Una ventana reforzada cerrada con una elegante cortina en el interior que "
"puede cerrarse para bloquear la visibilidad y dejar fuera la luz."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open reinforced single glazed window with curtains"
msgstr "ventana abierta reforzada de un solo cristal con cortinas"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open reinforced single glazed window with
#. curtains"
msgid ""
"A reinforced window with a fancy curtain on the inside that can be drawn "
"closed to block visibility and shut out any light.  It's open and can be "
"crawled through."
msgstr ""
"Una ventana reforzada con una elegante cortina en el interior que se puede "
"cerrar para bloquear la visibilidad y dejar fuera cualquier luz. Está abierta "
"y se puede reptar por ahí."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "taped reinforced single glazed window"
msgstr "ventana de cristal simple reforzada con cinta adhesiva"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped reinforced single glazed window"
msgid ""
"A reinforced single glazed window.  Consists of a giant sheet of reinforced "
"glass inserted into a window frame.  It's currently closed.  This one has "
"been blocked out with duct tape.  You could remove the duct tape by cutting "
"it off."
msgstr ""
"Una ventana de cristal simple reforzado. Consiste en una hoja gigante de "
"cristal reforzado insertada en un marco de ventana. Actualmente está cerrada. "
"Esta ha sido bloqueada con cinta aislante. Podrías quitar la cinta americana "
"cortándola."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "double glazed window"
msgstr "ventana de doble acristalamiento"

