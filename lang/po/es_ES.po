msgstr[1] "puñados de arándanos agrios"
msgstr[2] "puñados de arándanos agrios"

#: data/json/items/comestibles/raw_fruit.json
#. ~ Description of "handful of huckleberries"
msgid "A handful of huckleberries, often times confused for blueberries."
msgstr "Un puñado de arándanos agrios, a menudo confundidos con las arandanos azules."

#: data/json/items/comestibles/raw_fruit.json
#. ~ Item name
msgid "starry false Solomon's seal berries"
msgid_plural "starry false Solomon's seal berries"
msgstr[0] "bayas de sello de Solomon falso estrellado"
msgstr[1] "bayas de sello de Solomon falso estrellado"
msgstr[2] "bayas de sello de Solomon falso estrellado"

#: data/json/items/comestibles/raw_fruit.json
#. ~ Description of "starry false Solomon's seal berries"
msgid ""
"A bunch of deep red berries with a pleasant bittersweet flavor.  Can have a "
"laxative effect if eaten in large quantities."
msgstr ""
"Un racimo de bayas de color rojo intenso con un agradable sabor agridulce. "
"Puede tener un efecto laxante si se consume en grandes cantidades."

#: data/json/items/comestibles/raw_fruit.json
#. ~ Item name
msgid "mayapple"
msgid_plural "mayapples"
msgstr[0] "podofilo"
msgstr[1] "podofilos"
msgstr[2] "podofilos"

#: data/json/items/comestibles/raw_fruit.json
#. ~ Description of "mayapple"
msgid ""
"A small, edible fruit of an otherwise toxic plant.  You should not eat too "
"many of them."
msgstr ""
"Un fruto pequeño comestible de una planta tóxica. No deberías consumir muchos "
"de estos frutos."

#: data/json/items/comestibles/raw_fruit.json
