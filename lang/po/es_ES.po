msgid_plural "cured pelts"
msgstr[0] "pelaje curado"
msgstr[1] "pelajes curados"
msgstr[2] "pelajes curados"

#: data/json/items/resources/tailoring.json
#. ~ Description of "cured pelt"
msgid ""
"A rolled-up animal hide which has been scraped of extraneous hair and flesh "
"and treated to prevent decay.  It still requires tanning to become usable fur."
msgstr ""
"Una piel de animal enrollada a la que se le ha quitado el pelo y la carne y "
"se ha tratado para evitar que se pudra. Todavía necesita curtirse para "
"convertirse en piel utilizable."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "tanned pelt"
msgid_plural "tanned pelts"
msgstr[0] "pelaje curtido"
msgstr[1] "pelajes curtidos"
msgstr[2] "pelajes curtidos"

#: data/json/items/resources/tailoring.json
#. ~ Description of "tanned pelt"
msgid ""
"A folded sheet of fur made from carefully tanned animal pelt.  Can be cut up "
"or used as is."
msgstr ""
"Una lámina de pelaje doblada hecha con piel de animal cuidadosamente curtida. "
"Se puede cortar o utilizar tal cual."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork fur sheet"
msgid_plural "patchwork fur sheets"
msgstr[0] "lámina de retazos de piel"
msgstr[1] "láminas de retazos de piel"
msgstr[2] "láminas de retazos de piel"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork fur sheet"
msgid ""
"A 12-inch by 24-inch sheet of fur sewn together from patches.  Can be cut up "
"or used as is."
msgstr ""
"Una hoja de 30cm (12 pulgadas) por 60cm (24 pulgadas) de piel cosida a partir "
"de parches. Se puede cortar o utilizar tal cual. Puede ser cortada o usada en "
"su estado actual."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "cotton sheet"
msgid_plural "cotton sheets"
msgstr[0] "sabana de algodón"
msgstr[1] "sabanas de algodón"
msgstr[2] "sabanas de algodón"

#: data/json/items/resources/tailoring.json
#. ~ Description of "cotton sheet"
msgid ""
"A 12-inch by 24-inch sheet of cotton fabric, suitable for making clothing.  "
"You can use it to stop bleeding, but it is very wasteful."
msgstr ""
"Una hoja de tela de algodón de 30cm (12 pulgadas) por 60cm (24 pulgadas), "
"adecuada para confeccionar ropa. Se puede utilizar para detener hemorragias, "
"pero sería malgastarla."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork cotton sheet"
msgid_plural "patchwork cotton sheets"
msgstr[0] "sábana de parches de algodón"
msgstr[1] "sábanas de parches de algodón"
msgstr[2] "sábanas de parches de algodón"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork cotton sheet"
msgid ""
"A 12-inch by 24-inch sheet of cotton sewn together from patches of various "
"clothing parts.  Suitable for making clothing if you lack proper material "
"sheets."
msgstr ""
"Una hoja de tela de algodón de 30cm (12 pulgadas) por 60cm (24 pulgadas), "
"ideal para hacer tipos de ropa. Ideal para hacer ropa si no tienes las hojas "
"de materiales apropiadas."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "faux fur sheet"
msgid_plural "faux fur sheets"
msgstr[0] "sábana de piel falsa"
msgstr[1] "sábanas de piel falsa"
msgstr[2] "sábanas de piel falsa"

#: data/json/items/resources/tailoring.json
#. ~ Description of "faux fur sheet"
msgid "A 12-inch by 24-inch sheet of colorful faux fur, suitable for making clothing."
msgstr ""
"Una hoja de tela de piel de imitación colorida de 30cm (12 pulgadas) por 60cm "
"(24 pulgadas) ideal para hacer ropa."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork faux fur sheet"
msgid_plural "patchwork faux fur sheets"
msgstr[0] "lámina de retazos de piel de imitación"
msgstr[1] "láminas de retazos de piel de imitación"
msgstr[2] "láminas de retazos de piel de imitación"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork faux fur sheet"
msgid ""
"A 12-inch by 24-inch sheet of faux fur sewn together from mismatched patches. "
" Suitable for making clothing if you lack proper material sheets, but the "
"bright, clashing colors might end up making you look like a diseased Muppet."
msgstr ""
"Una hoja de tela de piel de imitación de 30cm (12 pulgadas) por 60cm (24 "
"pulgadas) cosida con parches irregulares. Ideal para hacer ropa si no tienes "
"las hojas de material apropiadas, pero con brillantes colores mezclados que "
"podrían hacer que parezcas una marioneta enferma."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "felt sheet"
msgid_plural "felt sheets"
msgstr[0] "sábana de fieltro"
msgstr[1] "sábanas de fieltro"
msgstr[2] "sábanas de fieltro"

#: data/json/items/resources/tailoring.json
#. ~ Description of "felt sheet"
msgid "A 12-inch by 24-inch sheet of felt, suitable for making clothing."
msgstr ""
"Una hoja de tela de fieltro de 30cm (12 pulgadas) por 60cm (24 pulgadas), "
"ideal para hacer ropa."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork felt sheet"
msgid_plural "patchwork felt sheets"
msgstr[0] "lámina de retazos de fieltro"
msgstr[1] "láminas de retazos de fieltro"
msgstr[2] "láminas de retazos de fieltro"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork felt sheet"
msgid ""
"A 12-inch by 24-inch sheet of felt sewn together from patches.  Suitable for "
"making clothing if you lack proper material sheets."
msgstr ""
"Una hoja de tela de fieltro de 30cm (12 pulgadas) por 60cm (24 pulgadas) "
"cosidos juntos usando parches. Ideal para hacer ropa si no tienes las hojas "
"de material apropiadas."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "Kevlar sheet"
msgid_plural "Kevlar sheets"
msgstr[0] "lámina de kevlar"
msgstr[1] "láminas de kevlar"
msgstr[2] "láminas de kevlar"

#: data/json/items/resources/tailoring.json
#. ~ Description of "Kevlar sheet"
msgid ""
"A 12-inch by 24-inch sheet of loose-woven Kevlar synthetic fabric, suitable "
"for making durable cut and stab resistant clothing.  While protective, this "
"kind of Kevlar is not suitable for making ballistic gear due to the "
"difference in weave tightness."
msgstr ""
"Una hoja de 30cm (12 pulgadas) por 60cm (24 pulgadas) de tejido suelto "
"sintético de kevlar, útil para hacer ropa resistente a cortes y puñaladas. "
"Aunque protege bastante, este tipo de kevlar no es aconsejable para fabricar "
"equipamiento antibalas debido a la diferencia de la rigidez del cosido."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork Kevlar sheet"
msgid_plural "patchwork Kevlar sheets"
msgstr[0] "lámina de retazos de Kevlar"
msgstr[1] "láminas de retazos de Kevlar"
msgstr[2] "láminas de retazos de Kevlar"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork Kevlar sheet"
msgid ""
"A 12-inch by 24-inch sheet of fabric sewn together from Kevlar patches, "
"suitable for making durable cut and stab resistant clothing.  This would be "
"out of the question for ballistic Kevlar but the simpler, looser weave of "
"this variety means it is fine to use if you lack proper material sheets."
msgstr ""
"Una hoja de 30cm (12 pulgadas) por 60cm (24 pulgadas) de tejido cosido con "
"parches de kevlar, útil para hacer ropa resistente a cortes y puñaladas. Este "
"tipo de Kevlar no es aconsejable para fabricar equipamiento antibalas, pero "
"el simple cosido de esta variedad significa que esta bien usarlo si no tienes "
"las hojas del material adecuado."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "Kevlar patch"
msgid_plural "Kevlar patches"
msgstr[0] "parche de Kevlar"
msgstr[1] "parches de Kevlar"
msgstr[2] "parches de Kevlar"

#: data/json/items/resources/tailoring.json
#. ~ Description of "Kevlar patch"
msgid ""
"A 6-inch square patch of loose-woven Kevlar, suitable for repairing cut and "
"stab resistant clothing or reassembling into a patchwork sheet for sewing."
msgstr ""
"Un parche cuadrado de tejido suelto de 15cm² (6 pulgadas) de kevlar, adecuado "
"para reparar prendas resistentes a cortes y puñaladas o volver a montarlo en "
"una hoja de parches para coser."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "Lycra sheet"
msgid_plural "Lycra sheets"
msgstr[0] "sábana de elastano"
msgstr[1] "sábanas de elastano"
msgstr[2] "sábanas de elastano"

#: data/json/items/resources/tailoring.json
#. ~ Description of "Lycra sheet"
msgid ""
"A sheet of synthetic fabric blended with stretchy Lycra fibers, suitable for "
"making flexible, yet strong clothing."
msgstr ""
"Una hoja de tejido sintético mezclada con fibras de licra estrecha, adecuada "
"para hacer ropa flexible pero fuerte."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "ballistic Kevlar panel"
msgid_plural "ballistic Kevlar panels"
msgstr[0] "panel antibalas de Kevlar"
msgstr[1] "paneles antibalas de Kevlar"
msgstr[2] "paneles antibalas de Kevlar"

#: data/json/items/resources/tailoring.json
#. ~ Description of "ballistic Kevlar panel"
msgid ""
"A small, 16-layer thick ballistic Kevlar panel.  This kind of Kevlar is "
"precision-made by machine and features an extremely tight weave which cannot "
"be replicated by hand.  Due to this, any damage incurred to your ballistic "
"armor will necessitate complete replacement with a new panel.  It is not as "
"effective as loose-woven Kevlar at stopping stab wounds, but it has no equal "
"against the threat posed by firearms."
msgstr ""
"Un pequeño panel de Kevlar antibalas grueso de 16 capas. Este tipo de kevlar "
"esta hecho a maquina con precisión y tiene un cosido extremadamente apretado "
"que no puede ser replicado a mano. Debido a esto, cualquier daño en tu "
"armadura antibalas necesitara reemplazarse con un nuevo panel. No es tan "
"efectivo como el kevlar cosido suelto al parar heridas punzantes, pero no "
"tiene rival contra la amenaza que suponen las armas de fuego."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "rigid Kevlar plate"
msgid_plural "rigid Kevlar plates"
msgstr[0] "placa de Kevlar rígida"
msgstr[1] "placas de Kevlar rígidas"
msgstr[2] "placas de Kevlar rígidas"

#: data/json/items/resources/tailoring.json
#. ~ Description of "rigid Kevlar plate"
msgid ""
"A compressed panel of Kevlar treated with epoxy or other adhesive.  It could "
"be used to repair items made of rigid Kevlar, and makes a decent substitute "
"for damaged carbon fiber and the like even if it isn't exactly the same."
msgstr ""
"Un panel comprimido de Kevlar tratado con epoxi u otro adhesivo. Se puede "
"utilizar para reparar objetos de Kevlar rígido y es un buen sustituto de la "
"fibra de carbono dañada, aunque no sea exactamente igual."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork Lycra sheet"
msgid_plural "patchwork Lycra sheets"
msgstr[0] "lámina de retazos de Licra"
msgstr[1] "láminas de retazos de Licra"
msgstr[2] "láminas de retazos de Licra"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork Lycra sheet"
msgid ""
"A 12-inch by 24-inch sheet of fabric sewn together from Lycra patches.  "
"Suitable for making flexible, yet strong clothing if you lack proper material "
"sheets."
msgstr ""
"Una hoja de tela de licra de 30cm (12 pulgadas) por 60cm (24 pulgadas) "
"cosidos juntos usando parches. Ideal para hacer ropa flexible pero fuerte si "
"no tienes las hojas de material apropiadas."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "neoprene sheet"
msgid_plural "neoprene sheets"
msgstr[0] "sábana de neopreno"
msgstr[1] "sábanas de neopreno"
msgstr[2] "sábanas de neopreno"

#: data/json/items/resources/tailoring.json
#. ~ Description of "neoprene sheet"
msgid "A sheet of neoprene, a synthetic rubber, suitable for making underwater gear."
msgstr ""
"Una sábana de neopreno, una goma sintética, adecuada para fabricar equipo "
"subacuático."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork neoprene sheet"
msgid_plural "patchwork neoprene sheets"
msgstr[0] "lámina de retazos de neopreno"
msgstr[1] "láminas de retazos de neopreno"
msgstr[2] "láminas de retazos de neopreno"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork neoprene sheet"
msgid ""
"A sheet of neoprene sewn together from patches, with waterproofed seams.  "
"Suitable for making underwater gear if you lack proper material sheets."
msgstr ""
"Una hoja de neopreno cosida a partir de parches, con costuras "
"impermeabilizadas. Adecuada para fabricar equipos subacuáticos si careces de "
"hojas de material adecuado."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "Nomex sheet"
msgid_plural "Nomex sheets"
msgstr[0] "sábana de Nomex"
msgstr[1] "sábanas de Nomex"
msgstr[2] "sábanas de Nomex"

#: data/json/items/resources/tailoring.json
#. ~ Description of "Nomex sheet"
msgid ""
"A sheet of Nomex synthetic fabric, suitable for making heat-resistant "
"clothing."
msgstr ""
"Una sábana de tejido sintético Nomex, adecuada para hacer ropa resistente al "
"calor."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork Nomex sheet"
msgid_plural "patchwork Nomex sheets"
msgstr[0] "lámina de retazos de Nomex"
msgstr[1] "láminas de retazos de Nomex"
msgstr[2] "láminas de retazos de Nomex"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork Nomex sheet"
msgid ""
"A sheet of Nomex synthetic fabric, sewn together from patches using Nomex "
"thread.  Suitable for making heat-resistant clothing if you lack proper "
"material sheets."
msgstr ""
"Una hoja de tejido sintético Nomex, cosida a partir de parches con hilo "
"Nomex. Adecuada para confeccionar prendas resistentes al calor si careces de "
"hojas de material adecuado."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "synthetic fabric sheet"
msgid_plural "synthetic fabric sheets"
msgstr[0] "sábana de tejido sintético"
msgstr[1] "sábanas de tejido sintético"
msgstr[2] "sábanas de tejido sintético"

#: data/json/items/resources/tailoring.json
#. ~ Description of "synthetic fabric sheet"
msgid "A sheet of synthetic fabric, suitable for making clothing."
msgstr "Una sábana de tela sintética, adecuada para hacer ropa."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork synthetic fabric sheet"
msgid_plural "patchwork synthetic fabric sheet"
msgstr[0] "lámina de retazos de tela sintética"
msgstr[1] "láminas de retazos de tela sintética"
msgstr[2] "láminas de retazos de tela sintética"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork synthetic fabric sheet"
msgid ""
"A sheet of fabric, sewn together from synthetic fabric patches in a patchwork "
"fashion.  Suitable for making most clothing, though it's much less "
"time-efficient than if using proper material sheets."
msgstr ""
"Una hoja de tela, cosida con parches de tela sintética a modo de retazos. "
"Sirve para confeccionar la mayoría de las prendas, aunque es mucho menos "
"eficiente en cuanto a tiempo que si se utilizan hojas de material adecuado."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "gambeson batting"
msgid_plural "clumps of gambeson batting"
msgstr[0] "relleno de gambesón"
msgstr[1] "mechones de relleno de gambesón"
msgstr[2] "mechones de relleno de gambesón"

#: data/json/items/resources/tailoring.json
#. ~ Description of "gambeson batting"
msgid ""
"A pile of shredded fabric, dry grass, hair or other cheap materials which "
"could be used to stuff the fabric layers of a gambeson to create armor more "
"cheaply and easily than properly layering and quilting the entire product."
msgstr ""
"Un montón de tela triturada, hierba seca, pelo u otros materiales baratos que "
"podrían utilizarse para rellenar las capas de tela de un gambesón y crear una "
"armadura de forma más barata y sencilla que superponiendo y acolchando "
"adecuadamente todo el producto."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "Kevlar thread"
msgid_plural "Kevlar thread"
msgstr[0] "hilo de Kevlar"
msgstr[1] "hilos de Kevlar"
msgstr[2] "hilos de Kevlar"

#: data/json/items/resources/tailoring.json
#. ~ Description of "Kevlar thread"
msgid ""
"Very durable Kevlar thread that would be particularly useful for making "
"ballistic armor, though it's fine to use in place of normal thread too, in "
"most cases.  Making armor-grade Kevlar sheets from this would need a "
"particularly tight weave, and so would require some specialized machinery."
msgstr ""
"Hilo de kevlar muy duradero que sería especialmente útil para fabricar "
"blindajes antibalas, aunque en la mayoría de los casos también se puede "
"utilizar en lugar de hilo normal. Para fabricar hojas de kevlar blindado se "
"necesita un tejido muy apretado, por lo que se requiere maquinaria "
"especializada."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "Nomex thread"
msgid_plural "Nomex thread"
msgstr[0] "hilo Nomex"
msgstr[1] "hilos Nomex"
msgstr[2] "hilos Nomex"

#: data/json/items/resources/tailoring.json
#. ~ Description of "Nomex thread"
msgid ""
"Heat-resistant Nomex thread that would be particularly useful for making heat "
"protection gear, though it's fine to use in place of normal thread too, in "
"most cases."
msgstr ""
"Hilo Nomex resistente al calor que resultaría especialmente útil para "
"fabricar equipos de protección contra el calor, aunque también se puede "
"utilizar en lugar de hilo normal, en la mayoría de los casos."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "denim sheet"
msgid_plural "denim sheets"
msgstr[0] "lámina de tela vaquera"
msgstr[1] "láminas de tela vaquera"
msgstr[2] "láminas de tela vaquera"

#: data/json/items/resources/tailoring.json
#. ~ Description of "denim sheet"
msgid ""
"A 12 inch by 24 inch sheet of durable blue denim, suitable for making jeans, "
"jorts, or jirts."
msgstr ""
"Una hoja de 30cm (12 pulgadas) por 60cm (24 pulgadas) de tela vaquera "
"durable, perfecto para hacer pantalones vaqueros largos y cortos."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "denim scraps"
msgid_plural "denim scraps"
msgstr[0] "resto de tela vaquera"
msgstr[1] "restos de tela vaquera"
msgstr[2] "restos de tela vaquera"

#: data/json/items/resources/tailoring.json
#. ~ Description of "denim scraps"
msgid "Oddly-shaped smallish denim patches, waste material from tailoring projects."
msgstr ""
"Pequeños parches de tela vaquera con forma irregular, material de desecho de "
"proyectos de confección."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "denim patch"
msgid_plural "denim patches"
msgstr[0] "parche de tela vaquera"
msgstr[1] "parches de tela vaquera"
msgstr[2] "parches de tela vaquera"

#: data/json/items/resources/tailoring.json
#. ~ Description of "denim patch"
msgid ""
"A small, 6 inch square patch of blue denim.  It could be used to repair items "
"made of denim or stitched into patchwork sheets for tailoring projects."
msgstr ""
"Un pequeño parche de tela vaquera de 15cm² (6 pulgadas²). Puede utilizarse "
"para reparar objetos de tela vaquera o coserse en hojas de retazos para "
"proyectos de confección."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork denim sheet"
msgid_plural "patchwork denim sheets"
msgstr[0] "lámina de retazos de tela vaquera"
msgstr[1] "láminas de retazos de tela vaquera"
msgstr[2] "láminas de retazos de tela vaquera"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork denim sheet"
msgid ""
"A selection of various sections of denim, sewn together in a patchwork "
"fashion.  Suitable for tailoring, though it's much less time-efficient than "
"if using proper material sheets."
msgstr ""
"Un conjunto de diversos pedazos de tela vaquera, cosidos para formar una tela "
"de retazos. Útil para trabajos de confección aunque es mucho menos eficiente "
"que utilizar hojas de materiales apropiados."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "canvas sheet"
msgid_plural "canvas sheets"
msgstr[0] "tela de lona"
msgstr[1] "telas de lona"
msgstr[2] "telas de lona"

#: data/json/items/resources/tailoring.json
#. ~ Description of "canvas sheet"
msgid ""
"A 12 inch by 24 inch sheet of durable and waterproof waxed canvas fabric, "
"suitable for making tough bags and clothing."
msgstr ""
"Una tela de lona de 30cm (12 pulgadas) por 60cm (24 pulgadas) fuerte e "
"impermeable ideal para hacer ropa y bolsos resistentes."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "heavy duty thread"
msgid_plural "heavy duty thread"
msgstr[0] "hilo reforzado"
msgstr[1] "hilos reforzados"
msgstr[2] "hilos reforzados"

#: data/json/items/resources/tailoring.json
#. ~ Description of "heavy duty thread"
msgid ""
"Some tough canvas-weight thread, sturdier than ordinary thread.  You could "
"meticulously weave this into a sheet of canvas cloth.  It would also be "
"useful for stitching such sheets together, though it's fine to use for normal "
"tailoring projects too."
msgstr ""
"Un poco de hilo reforzado de lona, más fuerte que el hilo común. Podrías "
"tejerlo meticulosamente y hacer una tela de lona. También sería útil para "
"coser esas telas aunque se puede usar para los trabajos de confección "
"normales."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "canvas scraps"
msgid_plural "canvas scraps"
msgstr[0] "restos de lona"
msgstr[1] "restos de lona"
msgstr[2] "restos de lona"

#: data/json/items/resources/tailoring.json
#. ~ Description of "canvas scraps"
msgid ""
"Oddly-shaped smallish bits of canvas, waste material from tailoring projects. "
" Not useful for much and usually disposed of, but can be recycled into some "
"tough thread."
msgstr ""
"Pequeños pedazos irregulares de lona, desperdicio de algún trabajo de "
"confección. No son muy útiles pero pueden ser reciclados para hacer hilo "
"resistente."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "canvas patch"
msgid_plural "canvas patches"
msgstr[0] "parche de lona"
msgstr[1] "parches de lona"
msgstr[2] "parches de lona"

#: data/json/items/resources/tailoring.json
#. ~ Description of "canvas patch"
msgid ""
"A small, 6 inch square patch of tough canvas.  It could be used to repair "
"items made of canvas or stitched into patchwork sheets for tailoring projects."
msgstr ""
"Un pequeño parche cuadrado de 15cm² (6 pulgadas²) de lona resistente. Se "
"puede usar para reparar objetos hechos de tela o coser con otros para armar "
"una lona de retazos para algún trabajo de confección."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "patchwork canvas sheet"
msgid_plural "patchwork canvas sheets"
msgstr[0] "hoja de retazos de lona"
msgstr[1] "hojas de retazos de lona"
msgstr[2] "hojas de retazos de lona"

#: data/json/items/resources/tailoring.json
#. ~ Description of "patchwork canvas sheet"
msgid ""
"A selection of various sections of canvas, sewn together in a patchwork "
"fashion.  Suitable for tailoring, though it's much less time-efficient than "
"if using proper material sheets."
msgstr ""
"Un conjunto de diversos pedazos de lona, cosidos para formar una tela de "
"retazos. Adecuado para confección, aunque es mucho menos eficiente en tiempo "
"que si se utilizan hojas de materiales adecuados."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "fabric strap"
msgid_plural "fabric straps"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/tailoring.json
#. ~ Description of "fabric strap"
msgid ""
"A strip of broad, flat cotton, 42 inches in length, with a metal adjustment "
"buckle threaded in the center.  Normally used as a shoulder strap for bags, "
"its ends are usually sown about a corresponding container's D-rings."
msgstr ""

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "log"
msgid_plural "logs"
msgstr[0] "leño"
msgstr[1] "leños"
msgstr[2] "leños"

#: data/json/items/resources/wood.json
#. ~ Description of "log"
msgid ""
"A large log of wood, cut from a tree.  (a)ctivate a wood axe or wood saw to "
"cut it into planks."
msgstr ""
"Un gran leño de madera, cortado de un árbol. (a)ctivar un hacha o una sierra "
"de madera para cortarlo en tablones."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "splintered wood"
msgid_plural "splintered wood"
msgstr[0] "madera astillada"
msgstr[1] "maderas astilladas"
msgstr[2] "maderas astilladas"

#: data/json/items/resources/wood.json
#. ~ Description of "splintered wood"
msgid "A splintered piece of wood, could be used as a skewer or for kindling."
msgstr "Una trozo de madera astillada que puede ser usada como un pincho o leña."

#: data/json/items/resources/wood.json data/mods/MMA/bludgeons.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
#. ~ Item name
msgid "stick"
msgid_plural "sticks"
msgstr[0] "palo"
msgstr[1] "palos"
msgstr[2] "palos"

#: data/json/items/resources/wood.json
#. ~ Description of "stick"
msgid ""
"A respectable length of wood, just big enough to wrap your hand around.  "
"Makes a decent melee weapon."
msgstr ""
"Una longitud respetable de madera, lo suficientemente grande como para "
"envolver tu mano. Un arma de combate c. a c. decente."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "long stick"
msgid_plural "long sticks"
msgstr[0] "palo largo"
msgstr[1] "palos largos"
msgstr[2] "palos largos"

#: data/json/items/resources/wood.json
#. ~ Description of "long stick"
msgid ""
"A straight section of wood, about eight feet long and a couple of inches in "
"diameter.  Makes a decent melee weapon, and can be broken into shorter pieces "
"for crafting."
msgstr ""
"Una sección recta de madera, de unos dos metros de largo y un par de "
"centímetros de diámetro. Constituye un arma de c. a c. decente, y puede "
"romperse en trozos más cortos para la fabricación."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "soaking long pole"
msgid_plural "soaking long poles"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/wood.json
#. ~ Description of "soaking long pole"
msgid ""
"A stout, ten-foot pole.  Could be used similarly to a spear.  It's currently "
"soaked with oil and quite slippery.  Once the oil penetrates the wood it can "
"be wiped down and used for further projects."
msgstr ""

#: data/json/items/resources/wood.json
#. ~ "msg" action message of item "soaking long pole"
msgid "You wipe down the long pole."
msgstr ""

#: data/json/items/resources/wood.json
#. ~ "not_ready_msg" action message of item "soaking long pole"
msgid "The long pole is still soaking."
msgstr ""

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "long pole"
msgid_plural "long poles"
msgstr[0] "poste largo"
msgstr[1] "postes largos"
msgstr[2] "postes largos"

#: data/json/items/resources/wood.json
#. ~ Description of "long pole"
msgid ""
"A stout, ten-foot pole.  Could be used similarly to a spear.  The Cataclysm "
"gives fresh meaning to walking softly and carrying a big stick."
msgstr ""
"Un palo robusto de tres metros. Podría usarse de forma similar a una lanza. "
"El Cataclismo le da un nuevo significado a caminar suavemente y llevar un "
"gran palo."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "soaking spear shaft"
msgid_plural "soaking spear shafts"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/wood.json
#. ~ Description of "soaking spear shaft"
msgid ""
"A long stick carved and sanded into a smooth staff with a slight taper, for "
"use in making spears.  It's currently soaked with oil and quite slippery.  "
"Once the oil penetrates the wood it can be wiped down and used for further "
"projects."
msgstr ""

#: data/json/items/resources/wood.json
#. ~ "msg" action message of item "soaking spear shaft"
msgid "You wipe down the spear shaft."
msgstr "Limpia el asta de la lanza."

#: data/json/items/resources/wood.json
#. ~ "not_ready_msg" action message of item "soaking spear shaft"
msgid "The spear shaft is still soaking."
msgstr "El asta de la lanza todavía está empapada."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "spear shaft"
msgid_plural "spear shafts"
msgstr[0] "asta de lanza"
msgstr[1] "astas de lanza"
msgstr[2] "astas de lanza"

#: data/json/items/resources/wood.json
#. ~ Description of "spear shaft"
msgid ""
"A long stick, sanded and treated with oil for integrity and carved into a "
"smooth staff with a slight taper, for use in making spears.  It can also be "
"used as a makeshift quarterstaff as-is, but is too thin to be very effective "
"for just hitting people."
msgstr ""
"Un palo largo lijado, tratado con aceite para mayor solidez y tallado para "
"hacerlo suave y estrecho, utilizado para hacer lanzas. También puede usarse "
"para hacer una vara larga improvisada pero es demasiado fina para ser "
"efectiva para golpear."

#: data/json/items/resources/wood.json
#. ~ Description of "plank"
msgid ""
"A flat, thick plank of wood, like a 2 by 4 or similar piece of dimensional "
"lumber.  Makes a decent melee weapon if you're desperate, and can be used for "
"all kinds of construction projects."
msgstr ""
"Un tablón de madera estrecha y gruesa, como una pieza de madera de 2 por 4 "
"(61cm por 122cm) o similar. Es un arma c. a c. si estas desesperado, y se "
"puede utilizar para todo tipo de proyectos de construcción."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "tonewood"
msgid_plural "blocks of tonewood"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/wood.json
#. ~ Description of "tonewood"
msgid ""
"A block of tonally appropriate wood that has been air dried for a year in "
"preparation for being turned into a musical instrument."
msgstr ""

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "tuning peg"
msgid_plural "tuning pegs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/wood.json
#. ~ Description of "tuning peg"
msgid ""
"Tuning pegs go on stringed instruments to both provide an anchor for the "
"strings and to control the tightness of the wire which in turn controls the "
"tune of the notes produced."
msgstr ""
"Las clavijas de afinación se colocan en los instrumentos de cuerda para "
"proporcionar un anclaje a las cuerdas y controlar la tensión del alambre, que "
"a su vez controla la afinación de las notas producidas."

#: data/json/items/resources/wood.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
#. ~ Item name
msgid "short plank"
msgid_plural "short planks"
msgstr[0] "tablón corto"
msgstr[1] "tablones cortos"
msgstr[2] "tablones cortos"

#: data/json/items/resources/wood.json
#. ~ Description of "short plank"
msgid ""
"A short 2 by 4 plank of wood.  While less common and smaller than its 4 foot "
"cousin it can still be very useful in carpentry."
msgstr ""
"Un tablón corto de madera de 2 por 4 (61cm por 122cm). Aunque es menos común "
"y más pequeño que su primo de 4 pies (122cm), puede ser muy útil en "
"carpintería."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "long plank"
msgid_plural "long planks"
msgstr[0] "tablón largo"
msgstr[1] "tablones largos"
msgstr[2] "tablones largos"

#: data/json/items/resources/wood.json
#. ~ Description of "long plank"
msgid ""
"A long 2 by 4 plank of wood.  While not as common as the 4 foot variant, "
"still makes a decent melee weapon, and can be used for all kinds construction."
msgstr ""
"Un tablón largo de madera de 2 por 4 (61cm por 122cm). Aunque no es tan común "
"como su variante de de 4 (122cm), todavía es un arma de c. a c. decente, y se "
"puede utilizar para todo tipo de construcciones."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "heavy wooden beam"
msgid_plural "heavy wooden beams"
msgstr[0] "viga de madera pesada"
msgstr[1] "vigas de madera pesadas"
msgstr[2] "vigas de madera pesadas"

#: data/json/items/resources/wood.json
#. ~ Description of "heavy wooden beam"
msgid ""
"An enormous beam of solid wood, very heavy and hard to lug around, but also "
"very sturdy for construction.  You could saw or chop it into smaller pieces, "
"like planks or panels."
msgstr ""
"Una enorme viga de madera maciza, muy pesada y difícil de arrastrar, pero "
"también muy resistente para la construcción. Podrías serrarla o cortarla en "
"trozos más pequeños, como tablones o paneles."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "wooden post"
msgid_plural "wooden posts"
msgstr[0] "poste de madera"
msgstr[1] "postes de madera"
msgstr[2] "postes de madera"

#: data/json/items/resources/wood.json
#. ~ Description of "wooden post"
msgid ""
"A wooden post with a 4 by 4 square base.  Posts with a length similar to this "
"are commonly used in mailboxes or as table legs."
msgstr ""
"Un poste de madera de 10cm por 10cm (4 pulgadas x 4 pulgadas) con base "
"cuadrada. Postes con una longitud similar a este son usados comúnmente en "
"buzones y patas de mesas."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "short wooden post"
msgid_plural "short wooden posts"
msgstr[0] "poste de madera corto"
msgstr[1] "postes de madera cortos"
msgstr[2] "postes de madera cortos"

#: data/json/items/resources/wood.json
#. ~ Description of "short wooden post"
msgid ""
"A wooden post with a 4 by 4 square base.  Posts with a length similar to this "
"are commonly used as chair legs."
msgstr ""
"Un poste de madera de 10cm por 10cm (4 pulgadas x 4 pulgadas) con base "
"cuadrada. Postes con una longitud similar a este son usados comúnmente en "
"patas de sillas."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "long wooden post"
msgid_plural "long wooden posts"
msgstr[0] "poste de madera largo"
msgstr[1] "postes de madera largos"
msgstr[2] "postes de madera largos"

#: data/json/items/resources/wood.json
#. ~ Description of "long wooden post"
msgid ""
"A wooden post with a 4 by 4 square base.  Posts with a length similar to this "
"are commonly used in the construction of walls and floors."
msgstr ""
"Un poste de madera de 10cm por 10cm (4 pulgadas x 4 pulgadas)  con base "
"cuadrada. Postes con una longitud similar a este son usados comúnmente en la "
"construcción de muros/paredes y suelos."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "small wood block"
msgid_plural "small wood blocks"
msgstr[0] "bloque de madera pequeño"
msgstr[1] "bloques de madera pequeños"
msgstr[2] "bloques de madera pequeños"

#: data/json/items/resources/wood.json
#. ~ Description of "small wood block"
msgid ""
"A small 2x2x5 inches block of wood, primarily used for carving out small "
"wooden objects."
msgstr ""
"Un pequeño bloque de madera de 5x5x12cm (2x2x5 pulgadas), principalmente "
"usado para tallar objetos pequeños."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "wooden panel"
msgid_plural "wooden panels"
msgstr[0] "panel de madera"
msgstr[1] "paneles de madera"
msgstr[2] "paneles de madera"

#: data/json/items/resources/wood.json
#. ~ Description of "wooden panel"
msgid ""
"A wide, thin wooden board - plywood, OSB, MDF, tongue-in-groove boards, or "
"similar, already cut to shape.  Good for all kinds of construction, but for "
"really big projects you'd need a proper sheet of uncut plywood or the like."
msgstr ""
"Un tablero de madera ancho y fino (contrachapado, OSB, MDF, tableros "
"machihembrados o similares) ya cortado. Sirve para todo tipo de "
"construcciones, pero para proyectos realmente grandes necesitarás una plancha "
"de contrachapado sin cortar o similar."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "large wooden sheet"
msgid_plural "large wooden sheets"
msgstr[0] "lamina de madera grande"
msgstr[1] "laminas de madera grandes"
msgstr[2] "laminas de madera grandes"

#: data/json/items/resources/wood.json
#. ~ Description of "large wooden sheet"
msgid ""
"A standard 4 by 8 sheet of flat wood - usually plywood, OSB, or MDF.  Heavy "
"and bulky, it is extremely useful for all manner of construction, but you "
"might have to cut it to size before doing smaller projects."
msgstr ""
"Una plancha estándar de madera plana de 1.22m por 2.44m (4 por 8 pies), "
"normalmente contrachapada, OSB o MDF. Pesada y voluminosa, es muy útil para "
"todo tipo de construcciones, pero puede que tengas que cortarla a medida "
"antes de hacer proyectos más pequeños."

#: data/json/items/resources/wood.json
#. ~ Item name
msgid "giant wooden screw"
msgid_plural "giant wooden screws"
msgstr[0] "tornillo gigante de madera"
msgstr[1] "tornillos gigantes de madera"
msgstr[2] "tornillos gigantes de madera"

#: data/json/items/resources/wood.json
#. ~ Description of "giant wooden screw"
msgid ""
"A giant screw carved out of solid wood, a simple component used to convert "
"rotational energy into a downward movement of greater force."
msgstr ""
"Un tornillo gigante tallado en madera maciza, un simple componente utilizado "
"para convertir la energía de rotación en un movimiento descendente dotado de "
"mayor fuerza."

#: data/json/items/tool/cables.json
#. ~ Description of "power cord"
msgid ""
"A power cord, like you've seen many times before: it's a short multi-stranded "
"copper cord with a power outlet at the end."
msgstr ""
"Un cable de alimentación, como los que has visto muchas veces: es un cable "
"corto de cobre multitrenzado con una toma de corriente en el extremo."

#: data/json/items/tool/cables.json
#. ~ "menu_text" action message of item "power cord"
#. ~ "menu_text" action message of item "extension cord"
msgid "Plug in / Manage connections"
msgstr "Enchufar / Manejar conexiones"

#: data/json/items/tool/cables.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "jumper cable"
msgid_plural "jumper cables"
msgstr[0] "cable de arranque"
msgstr[1] "cables de arranque"
msgstr[2] "cables de arranque"

#: data/json/items/tool/cables.json
#. ~ Description of "jumper cable"
msgid ""
"A 3-foot (or about 1 m) jumper cable: a short multi-stranded copper cable "
"with power leads on either end, whose main purpose is to share power between "
"vehicles, but can also link other electrical systems."
msgstr ""
"Un cable de arranque de 1m (3 pies): un cable corto de cobre multifilar con "
"cables de alimentación en ambos extremos, cuya función principal es compartir "
"la alimentación entre vehículos, pero que también puede conectar otros "
"sistemas eléctricos."

#: data/json/items/tool/cables.json
#. ~ "menu_text" action message of item "jumper cable"
#. ~ "menu_text" action message of item "heavy-duty tow cable"
#. ~ "menu_text" action message of item "shiny debug cable"
msgid "Attach / Manage connections"
msgstr "Unir / Gestionar conexiones"

#: data/json/items/tool/cables.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "heavy-duty jumper cable"
msgid_plural "heavy-duty jumper cables"
msgstr[0] "cable de arranque reforzado"
msgstr[1] "cables de arranque reforzados"
msgstr[2] "cables de arranque reforzados"

#: data/json/items/tool/cables.json
#. ~ Description of "heavy-duty jumper cable"
msgid ""
"A long, thick, heavy-duty jumper cable with power leads on either end.  It "
"looks like you could use it to hook up two vehicles to each other, though you "
"expect the power loss would be noticeable.  Can also link other electrical "
"systems."
msgstr ""
"Un cable de arranque largo, grueso y resistente con cables de alimentación en "
"ambos extremos. Parece que podría usarse para conectar dos vehículos entre "
"sí, aunque es de suponer que la pérdida de potencia sería notable. También "
"puede conectar otros sistemas eléctricos."

#: data/json/items/tool/cables.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "extension cord"
msgid_plural "extension cords"
msgstr[0] "alargador"
msgstr[1] "alargador"
msgstr[2] "alargadores"

#: data/json/items/tool/cables.json
#. ~ Description of "extension cord"
msgid ""
"A long 30-foot (or about 10 m) orange extension cord for extending cables or "
"connecting appliances.  Could be used on any appliance or other household "
"electrical system."
msgstr ""
"Un alargador de 10m (unos 30 pies) de color naranja para alargar cables o "
"conectar electrodomésticos. Se puede utilizar en cualquier electrodoméstico u "
"otro sistema eléctrico doméstico."

#: data/json/items/tool/cables.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "outdoor extension cord"
msgid_plural "outdoor extension cords"
msgstr[0] "alargador de exterior"
msgstr[1] "alargadores de exterior"
msgstr[2] "alargadores de exterior"

#: data/json/items/tool/cables.json
#. ~ Description of "outdoor extension cord"
msgid ""
"An extra-long 100-foot (or about 30 m) orange extension cord for extending "
"cables or connecting outdoor appliances.  Could be used on any appliance or "
"other household electrical system."
msgstr ""
"Un alargador naranja extralargo de 30m (unos 100 pies) para alargar cables o "
"conectar aparatos de exterior. Puede utilizarse en cualquier electrodoméstico "
"u otro sistema eléctrico doméstico."

#: data/json/items/tool/cables.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "heavy-duty tow cable"
msgid_plural "heavy-duty tow cables"
msgstr[0] "cable reforzado para remolcar"
msgstr[1] "cables reforzados para remolcar"
msgstr[2] "cables reforzados para remolcar"

#: data/json/items/tool/cables.json
#. ~ Description of "heavy-duty tow cable"
msgid ""
"An extremely heavy-duty 30-foot (or about 9 m) tow cable made from thick "
"steel wire coated in plastic.  If attached to a vehicle, it could be used to "
"pull another vehicle of any weight."
msgstr ""
"Un cable de remolque de 9m (unos 30 pies), muy resistente, fabricado con un "
"grueso alambre de acero recubierto de plástico. Si se fija a un vehículo, "
"puede utilizarse para arrastrar otro vehículo de cualquier peso."

#: data/json/items/tool/cables.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "shiny debug cable"
msgid_plural "shiny debug cables"
msgstr[0] "cable brillante de depuración"
msgstr[1] "cables brillantes de depuración"
msgstr[2] "cables brillantes de depuración"

#: data/json/items/tool/cables.json
#. ~ Description of "shiny debug cable"
msgid ""
"This is the cable of the gods: 100 meters long, no power loss, light as a "
"feather, and fits in a matchbook.  You're sure this wasn't supposed to exist, "
"and the way it shimmers makes you uneasy."
msgstr ""
"Este es el cable de los dioses: 100 metros de largo, sin pérdida de potencia, "
"ligero como una pluma y cabe en una caja de cerillas. Estás seguro de que no "
"debiera existir, y la forma en que brilla te inquieta."

#: data/json/items/tool/container.json
#. ~ Item name
msgid "steel bottle"
msgid_plural "steel bottles"
msgstr[0] "botella de acero"
msgstr[1] "botellas de acero"
msgstr[2] "botellas de acero"

#: data/json/items/tool/container.json
#. ~ Description of "steel bottle"
msgid "A stainless steel water bottle, holds 750 mL of liquid."
msgstr "Una botella de agua de acero inoxidable con capacidad para 750ml de líquido."

#: data/json/items/tool/container.json
#. ~ Item name
msgid "foldable plastic bottle"
msgid_plural "foldable plastic bottles"
msgstr[0] "botella plegable de plástico"
msgstr[1] "botellas plegables de plástico"
msgstr[2] "botellas plegables de plástico"

#: data/json/items/tool/container.json
#. ~ Description of "foldable plastic bottle"
msgid "A non-rigid plastic bottle for easy storage, holds 500 mL of liquid."
msgstr ""

#: data/json/items/tool/cooking.json data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
msgid "atomic coffeemaker"
msgid_plural "atomic coffeemakers"
msgstr[0] "cafetera atómica"
msgstr[1] "cafeteras atómicas"
msgstr[2] "cafeteras atómicas"

#: data/json/items/tool/cooking.json
#. ~ Description of "atomic coffeemaker"
msgid ""
"This is a Curie-G coffeemaker, by CuppaTech.  It famously uses a radioactive "
"generator to heat water for coffee, reducing the amount of total electricity "
"it consumes.  Consumer safety concerns led to it being banned in the EU as "
"well as many other countries, but don't let that stop you from brewing your "
"morning Joe with the power of the atom™!"
msgstr ""
"Ésta es una cafetera Curie-G, de CuppaTech. Es famosa por utilizar un "
"generador radiactivo para calentar el agua para el café, reduciendo la "
"cantidad total de electricidad que consume. La preocupación por la seguridad "
"de los consumidores hizo que se prohibiera en la UE y en muchos otros países, "
"¡pero que eso no te impida preparar tu café matutino con el poder del átomo™!"

#: data/json/items/tool/cooking.json
#. ~ Item name
msgid "butchering kit"
msgid_plural "butchering kits"
msgstr[0] "kit de descuartizamiento"
msgstr[1] "kits de descuartizamiento"
msgstr[2] "kits de descuartizamiento"

#: data/json/items/tool/cooking.json
#. ~ Description of "butchering kit"
msgid ""
"A kit containing all the specialized knives you need to debone, skin, and "
"prepare cuts of meat from an animal."
msgstr ""
"Un equipo que contiene todos los cuchillos especializados que necesitas para "
"deshuesar, pelar y preparar cortes de carne de un animal."

#: data/json/items/tool/cooking.json
#. ~ Item name
msgid "can sealer"
msgid_plural "can sealers"
msgstr[0] "enlatadora"
msgstr[1] "enlatadoras"
msgstr[2] "enlatadoras"

#: data/json/items/tool/cooking.json
#. ~ Description of "can sealer"
msgid ""
"A hand-crank-powered cast steel machine designed to automatically seal tin "
"cans."
msgstr ""
"Una máquina de acero fundido con manivela diseñada para sellar "
"automáticamente latas de conserva."

#: data/json/items/tool/cooking.json
#. ~ Item name
msgid "electric carver (off)"
msgid_plural "electric carvers (off)"
msgstr[0] "cuchillo eléctrico (off)"
msgstr[1] "cuchillos eléctricos (off)"
msgstr[2] "cuchillos eléctricos (off)"

#: data/json/items/tool/cooking.json
#. ~ Description of "electric carver (off)"
msgid ""
"An electric meat carver powered by cord.  It has two serrated blades that "
"vibrate together to slice just about anything from turkey to ham… even "
"zombies!"
msgstr ""

#: data/json/items/tool/cooking.json
#. ~ value of variable 'success_message' in effect in EoC
