#: data/mods/Aftershock/npcs/cyborg_npcs/npc_classes_cyborg.json
#: data/mods/aftershock_exoplanet/npcs/cyborg_npcs/npc_classes_cyborg.json
#. ~ Name of an NPC class
msgid "Hive Ganger"
msgstr "Pandillero de Colmena"

#: data/mods/Aftershock/npcs/cyborg_npcs/npc_classes_cyborg.json
#: data/mods/aftershock_exoplanet/npcs/cyborg_npcs/npc_classes_cyborg.json
#. ~ Job description of "Hive Ganger" NPC class
msgid ""
"I've survived all my life with the whole world against me, how is this any "
"different."
msgstr ""
"He sobrevivido toda mi vida con todo el mundo en contra, ¿cómo es esto "
"diferente?"

#: data/mods/Aftershock/npcs/cyborg_npcs/npc_classes_cyborg.json
#: data/mods/aftershock_exoplanet/npcs/cyborg_npcs/npc_classes_cyborg.json
#. ~ Name of an NPC class
msgid "Corporate Wetworks Operative"
msgstr "Operativo de Empresa Wetworks"

#: data/mods/Aftershock/npcs/cyborg_npcs/npc_classes_cyborg.json
#: data/mods/aftershock_exoplanet/npcs/cyborg_npcs/npc_classes_cyborg.json
#. ~ Job description of "Corporate Wetworks Operative" NPC class
msgid ""
"I made a good living working in the shadows of the old world.  I can survive "
"it's twilight."
msgstr ""
"Me gané bien la vida trabajando en las sombras del viejo mundo. Puedo "
"sobrevivir a su crepúsculo."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Solar Panels"
msgstr "Paneles Solares"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Solar Panels"
msgid ""
"Installed on your back is a set of retractable, reinforced solar panels "
"resembling angular butterfly wings.  When in direct sunlight, they will "
"automatically deploy and slowly recharge your power level."
msgstr ""
"Instalado en tu espalda hay un conjunto de paneles solares retráctiles y "
"reforzados que parecen alas de mariposa angulares. Cuando estén en la luz "
"solar directa, se desplegarán automáticamente y recargarás lentamente tu "
"nivel de energía."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Microfusion Generator"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Microfusion Generator"
msgid ""
"An implanted fusion reactor with its own internal nuclear fuel reservoir.  It "
"will last over a century without servicing."
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Archeotech Grav Chute"
msgstr "Paracaídas Gravitacional Arqueotech"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Archeotech Grav Chute"
msgid ""
"Pre-Discontinuity bionic module that was implanted into elite drop troops who "
"could jump from their insertion vehicle during the radar disruption of "
"reentry.  Clenching your fist allows you to activate what scientists call a "
"grav chute that allows a safe fall; while active, the field will prevent "
"damage to your body from severe impacts, at the cost of impaired movement.  "
"It's best not to think about how many bodies this has been in before yours."
msgstr ""
"Módulo biónico anterior a la discontinuidad que se implantó en tropas de "
"descenso de élite que podían saltar desde su vehículo de inserción durante la "
"interrupción por radar de la reentrada. Al apretar el puño se activa lo que "
"los científicos denominan un paracaídas gravitatorio que permite una caída "
"segura; mientras está activo, el campo evitará que el cuerpo sufra daños por "
"impactos graves, a costa de afectar al movimiento. Es mejor no pensar en "
"cuántos cuerpos habrá tenido esto antes que el tuyo."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Deployable Grenade Launcher"
msgstr "Lanzador de granadas desplegable"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Deployable Grenade Launcher"
msgid ""
"Your right hand can fold inward to reveal a mechanism capable of igniting and "
"firing 40mm grenades across medium distances."
msgstr ""
"Su mano derecha puede doblarse hacia adentro para revelar un mecanismo capaz "
"de encender y disparar granadas de 40 mm a través de distancias medias."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Monofilament Whip"
msgstr "Látigo de Monofilamento"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Linguistic Coprocessor"
msgstr "Coprocesador Lingüístico"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Linguistic Coprocessor"
#, no-c-format
msgid ""
"The left hemisphere of your brain has been augmented with a microcomputer "
"that moderately increases the speed that language and written words are "
"processed, granting a 15% increase to reading speed."
msgstr ""
"El hemisferio izquierdo de su cerebro ha sido aumentado con una "
"microcomputadora que aumenta moderadamente la velocidad con la que se "
"procesan el lenguaje y las palabras escritas, otorgando un aumento del 15% a "
"la velocidad de lectura."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Dopamine Stimulators"
msgstr "Estimuladores de la Dopamina"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Dopamine Stimulators"
msgid ""
"Tiny cybernetic stimulators have been installed throughout your ventral "
"tegmental area, and trigger at set intervals using bionic power.  This slowly "
"releases a stream of reward chemicals and hormones into your brain, inducing "
"a state of euphoria that notably elevates mood."
msgstr ""
"Se han instalado pequeños estimuladores cibernéticos en toda su área "
"tegmental ventral, y se activan a intervalos establecidos usando la energía "
"biónica. Esto libera lentamente un flujo de químicos y hormonas de recompensa "
"en tu cerebro, induciendo un estado de euforia que eleva notablemente el "
"estado de ánimo."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Counteractive Reflexes"
msgstr "Reflejos Contractivos"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Synthetic Marrow"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Synthetic Marrow"
msgid ""
"The interior of your femurs have been scrapped clean, the marrow replaced "
"with a Mercurial brand bio-factory that produces high efficiency blood "
"analogues.  The blood substitutes are fine-tuned for combat, increasing "
"stamina, disease resistance and clotting speed."
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Military Infolink"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "High-Voltage Battery System"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Blood Neurology"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Blood Neurology"
msgid ""
"Your blood is laced with neuron-analogue nanites, allowing your entire "
"circulatory system to function as a secondary brain.  This radical "
"modification increases your intelligence, reflexes and perception by 4, "
"increases your pain tolerance and allows you to survive brain damage that "
"would otherwise prove fatal."
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Melee Optimization Unit"
msgstr "Unidad de Optimización C. a C."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Melee Optimization Unit"
msgid ""
"An implanted AI module calculates the optimal followup to each of your melee "
"strikes, allowing you to chain them with unnatural speed and grace.  This "
"bionic must be active to function."
msgstr ""
"Un módulo IA implantada calcula el seguimiento óptimo para cada uno de tus "
"movimientos c. a c. permitiéndote encadenarlos con una velocidad y gracia "
"antinatural. Este biónico debe ser activado para funcionar."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Chemical Enhancement Rig and computer"
msgstr "Plataforma de Mejora Química Informática"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Chemical Enhancement Rig and computer"
msgid ""
"An implanted AI module and medication dispenser calculates the optimal "
"chemical mix to keep you on your toes and ready for combat.  This bionic must "
"be active to function and while it functions your body is at a heightened "
"performance but if it turns off it will take you several days to get back to "
"normal.  There are a significant number of baseline bonuses granted by this "
"setup but people around will notice your junkie behavior."
msgstr ""
"Un módulo de IA implantado y un dispensador de medicación calculan la mezcla "
"química óptima para mantenerte alerta y listo para el combate. Este biónico "
"debe estar activo para funcionar y, mientras lo esté, tu cuerpo rendirá al "
"máximo, pero si se apaga, tardarás varios días en volver a la normalidad. "
"Esta configuración te otorga un gran número de bonificaciones básicas, pero "
"la gente de tu alrededor se dará cuenta de tu comportamiento de yonqui."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Speed Injection System"
msgstr "Sistema Inyector de Velocidad"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Speed Injection System"
#. ~ Description of bionic "Strength Injection System"
msgid ""
"The chemical injection system and microcomputer that when activated greatly "
"enhances your reaction times and overall speed.  Upon deactivation, the user "
"may experience dizziness, heart palpitations and ravenous appetites."
msgstr ""
"El sistema inyector de químicos y microordenador que cuando se activan "
"mejoran enormemente tus tiempos de reacción y tu velocidad general. Al "
"desactivarlo, el usuario puede experimentar mareos, palpitaciones y un "
"apetito voraz."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Pain Suppression Injection System"
msgstr "Sistema Inyector Supresor del Dolor"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Pain Suppression Injection System"
msgid ""
"The chemical injection system and microcomputer that when activated gives a "
"burst of chemicals that allows your blood to work a little harder at "
"stabilizing the body and then flushes your system with a powerful anesthetic "
"that allows you to continue operating at high capacity.  Upon deactivation, "
"the user may experience extreme lethargy, sudden loss of consciousness, among "
"other symptoms that may prove potentially fatal if not in a safe location."
msgstr ""
"El sistema de inyección química y microordenador que al activarse administra "
"una ráfaga de sustancias químicas que permite que la sangre trabaje un poco "
"más para estabilizar el cuerpo y luego purga el sistema con un potente "
"anestésico que permite seguir funcionando a alta capacidad. Al desactivarse, "
"el usuario puede experimentar un letargo extremo, pérdida repentina de "
"conciencia, entre otros síntomas que pueden resultar potencialmente mortales "
"si no se encuentra en un lugar seguro."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Strength Injection System"
msgstr "Sistema Inyector de Fuerza"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Power Storage, salvaged"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Power Storage, salvaged"
msgid ""
"A battered and used Compact Bionics Module that increases your power capacity "
"by 50 kJ.  Having at least one of these is a prerequisite to using powered "
"bionics.  You will also need a power supply, found in various CBMs."
msgstr ""
"Un Módulo Biónico Compacto maltrecho y usado que aumenta tu capacidad de "
"energía en 50 kJ. Tener al menos uno de estos módulos es un requisito previo "
"para usar biónica con energía. También necesitarás una fuente de "
"alimentación, que se encuentra en varios MBCs."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "HawkingCorps Mark I Shield"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "HawkingCorps Mark I Shield"
msgid ""
"Imagine a computer inside your body playing pong against the universe.  The "
"paddles are made of -color glass condensate- and any and all of their "
"specific functions are the intellectual property of the Hawking Corporation "
"and/or its local subsidiaries.\n"
"-From the owners manual of HawkingCorps Mark I Shield.\n"
"\n"
"Activating the shield will create an energy shield capable of negating a "
"modest amount of damage from weak or improvised weapons."
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "HawkingCorps Mark V Shield"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Kinetic Annulment System"
msgstr "Sistema de Anulación Cinética"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Kinetic Annulment System"
msgid ""
"A powerful shielding system salvaged from a pre-Discontinuity robotic "
"warframe, crudely adapted for compatibility with biological hosts.  Powerful "
"enough to withstand prolonged assault from anti-vehicle weaponry."
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Neurosoft: Aeronautics"
msgstr "Neurosoft: Aeronauticos"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Implanted Translocator"
msgstr "Translocalizador implantado"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Implanted Translocator"
msgid ""
"An experimental teleportation system carefully weaved into bone marrow and "
"alongside your skeletal system.  Allows you to safely and readily teleport "
"toward previously activated telepads."
msgstr ""
"Un sistema experimental de teletransporte cuidadosamente entrelazado en la "
"médula ósea y junto al sistema esquelético. Te permite teletransportarte con "
"seguridad y facilidad hacia telepuertos previamente activados."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Cranium Bomb"
msgstr "Bomba Craneal"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Cranium Bomb"
msgid ""
"You've worked for some nasty people.  People who installed a bomb at the top "
"of your spine.  They are all dead now but there is unfortunately a dead man "
"switch if you don't check in roughly every thirty days.  Those thirty days "
"are almost up but you can't remember exactly how many are left.  You need "
"this out and fast."
msgstr ""
"Has trabajado para algunas personas desagradables. Personas que instalaron "
"una bomba en la cumbre de tu espina. Ellos ya están muertos ahora pero "
"desafortunadamente hay un interruptor de hombre muerto si no se controla en "
"aproximadamente treinta días. Estos treinta días están casi terminando pero "
"no recuerdas exactamente cuantos faltan. Necesitas esto fuera y rápido."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Emergency Insulation"
msgstr "Aislamiento de Emergencia"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Emergency Insulation"
msgid ""
"Described in design documents as emergency insulation to protect against "
"exposure to hard vacuum, this CBM is also useful in any encounter that causes "
"instant frostbite."
msgstr ""
"Descrito en los documentos de diseño como aislamiento de emergencia para "
"protejer contra la exposición al vacío, este MBC también es útil en cualquier "
"encuentro que provoque una congelación instantanea."

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a enchantment
msgid "Super Heated Bionic Weapon"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of enchantment "Super Heated Bionic Weapon"
msgid "The superheated bionic weapon cuts and burns with ease."
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a enchantment
msgid "Charged Bionic Weapon"
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of enchantment "Charged Bionic Weapon"
msgid "Your bionic weapon sparks under constant electrical charge."
msgstr ""

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Name of a bionic
msgid "Skullgun"
msgstr "pistola craneal"

#: data/mods/Aftershock/player/bionics.json
#: data/mods/aftershock_exoplanet/player/bionics.json
#. ~ Description of bionic "Skullgun"
msgid ""
"Concealed in your head is a single shot 10mm pistol.  Activate the bionic to "
"fire and reload the skullgun."
msgstr ""
"Oculto en tu cabeza hay una pistola de un solo tiro calibre 10mm. Activa el "
"biónico para disparar y recargar la pistola del cráneo."

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Proficiency category name
msgid "Social Standing"
msgstr ""

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Description of proficiency category "Social Standing"
msgid ""
"Proficiencies related to your status within spacefaring culture in all its "
"forms."
msgstr ""
"Competencias relacionadas con tu estatus dentro de la cultura espacial en "
"todas sus formas."

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Proficiency name
msgid "Armament License"
msgstr ""

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Description of proficiency "Armament License"
msgid ""
"You have a license to own and operate military grade weaponry and can legally "
"purchase such items without any difficulty."
msgstr ""

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/MindOverMatter/recipes/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Proficiency category name
msgid "Concentration"
msgstr ""

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/MindOverMatter/recipes/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Description of proficiency category "Concentration"
msgid ""
"Proficiencies that help with maintaining concentration even in the face of "
"distractions."
msgstr ""
"Competencias que ayudan a mantener la concentración incluso frente a "
"distracciones."

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/MindOverMatter/recipes/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Proficiency name
msgid "Concentration (Beginner)"
msgstr ""

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/MindOverMatter/recipes/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Description of proficiency "Concentration (Beginner)"
msgid ""
"You are capable of holding the same thing in mind even when sitting in an "
"uncomfortable position or after skipping a meal."
msgstr ""

#: data/mods/Aftershock/player/proficiencies.json
#: data/mods/MindOverMatter/recipes/proficiencies.json
#: data/mods/aftershock_exoplanet/player/proficiencies.json
#. ~ Proficiency name
