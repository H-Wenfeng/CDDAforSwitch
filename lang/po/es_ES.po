#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "maiasaura"
msgid_plural "maiasaura"
msgstr[0] "maiasaura"
msgstr[1] "maiasaura"
msgstr[2] "maiasaura"

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Description of monster "maiasaura"
msgid ""
"A huge scaly dinosaur with hooves and long heavy tail.  Has a flat beak, "
"thick nose, and small spiky head crest."
msgstr ""
"Un enorme dinosaurio con cascos y una larga y pesada cola. Tiene un pico "
"plano, una nariz gruesa y una pequeña cresta puntiaguda en la cabeza."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "gryposaurus"
msgid_plural "gryposaurus"
msgstr[0] "gryposaurus"
msgstr[1] "gryposaurus"
msgstr[2] "gryposaurus"

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Description of monster "gryposaurus"
msgid ""
"A huge scaly dinosaur with hooves and a broad toothless beak with a narrow "
"arching nasal hump."
msgstr ""
"Un enorme dinosaurio escamoso con pezuñas y un pico ancho desdentado con una "
"protuberancia nasal estrecha y arqueada."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "prosaurolophus"
msgid_plural "prosaurolophus"
msgstr[0] "prosaurolophus"
msgstr[1] "prosaurolophus"
msgstr[2] "prosaurolophus"

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Description of monster "prosaurolophus"
