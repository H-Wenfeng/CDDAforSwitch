#: data/json/items/melee/spears_and_polearms.json
#. ~ Description of "makeshift tepoztopili"
msgid ""
"This is a long polearm with an oar-like oval head covered with razors.  Its "
"shape make it suitable for both thrusting and slashing.  It resembles the "
"Mesoamerican Tepoztopili, though the shaft is not very sturdy."
msgstr ""
"Esta es un arma de asta larga con una cabeza ovalada en forma de remo "
"cubierta de cuchillas. Su forma la hace adecuada tanto para asestar estocadas "
"como para dar tajos. Se parece al Tepoztopili mesoamericano, aunque el asta "
"no es muy robusta."

#: data/json/items/melee/spears_and_polearms.json
#. ~ Item name
msgid "glass bladed tepoztopili"
msgid_plural "glass bladed tepoztopilis"
msgstr[0] "tepoztopili con hojas de cristal"
msgstr[1] "tepoztopilis con hojas de cristal"
msgstr[2] "tepoztopilis con hojas de cristal"

#: data/json/items/melee/spears_and_polearms.json
#. ~ Description of "glass bladed tepoztopili"
msgid ""
"This is a long polearm with an oar-like oval head covered with glass.  Its "
"shape make it suitable for both thrusting and slashing.  It resembles the "
"Mesoamerican Tepoztopili, though the shaft is not very sturdy."
msgstr ""
"Esta arma de asta larga tiene una cabeza ovalada en forma de remo recubierta "
"de cristal. Su forma la hace adecuada tanto para asestar estocadas como para "
"dar tajos. Se parece al Tepoztopili mesoamericano, aunque el asta no es muy "
"robusta."

#: data/json/items/melee/spears_and_polearms.json
