#: data/json/zones.json
#. ~ Name of loot zone
msgid "Auto Drink"
msgstr "Auto Bebida"

#: data/json/zones.json
#. ~ Description of loot zone "Auto Drink"
msgid ""
"Items in this zone will be automatically consumed during a long activity if "
"you get thirsty."
msgstr ""
"Los objetos de esta zona se beberál automáticamente durante una actividad "
"larga si se tiene sed."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Auto Eat"
msgstr "Auto Comida"

#: data/json/zones.json
#. ~ Description of loot zone "Auto Eat"
msgid ""
"Items in this zone will be automatically eaten during a long activity if you "
"get hungry."
msgstr ""
"Los objetos de esta zona se comerán automáticamente durante una actividad "
"larga si se tiene hambre."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Basecamp: Food"
msgstr "Comida: C.B."

#: data/json/zones.json
#. ~ Description of loot zone "Basecamp: Food"
msgid ""
"Items in this zone will be added to a basecamp's food supply in the "
"Distribute Food mission."
msgstr ""
"Los objetos en esta zona se añaden al suministro de comida de la misión "
"Distribuir alimentos."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Basecamp: Storage"
msgstr "Almacenamiento: C. B."

#: data/json/zones.json
#. ~ Description of loot zone "Basecamp: Storage"
msgid ""
"Items in this zone will be added to a basecamp's inventory for use by its "
"workers."
msgstr ""
"Los objetos de esta zona se añadirán al inventario de un campamento base para "
"que los utilicen sus trabajadores."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Chop Trees"
msgstr "Cortar Árboles"

#: data/json/zones.json
#. ~ Description of loot zone "Chop Trees"
msgid "Designate an area to chop down trees."
msgstr "Designar un área para cortar árboles."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Construction: Blueprint"
msgstr "Construcción: Planos"

#: data/json/zones.json
#. ~ Description of loot zone "Construction: Blueprint"
msgid "Designate a blueprint zone for construction."
msgstr "Designar una zona de planos para la construcción."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Disassembly Work"
msgstr "Trabajos de Desmontaje"

#: data/json/zones.json
#. ~ Description of loot zone "Disassembly Work"
msgid "Items in this zone are marked for disassembly."
msgstr "Los objetos de esta zona están marcados para su desmontaje."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Farm: Plot"
msgstr "Granja: Terreno"

#: data/json/zones.json
#. ~ Description of loot zone "Farm: Plot"
msgid "Designate a farm plot for tilling and planting."
msgstr "Designar una parcela para arar y plantar."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Fishing Spot"
msgstr "Lugar de Pesca"

#: data/json/zones.json
#. ~ Description of loot zone "Fishing Spot"
msgid "Designate an area to fish from."
msgstr "Designa un área para pescar."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Mine Terrain"
msgstr "Terreno de Mina"

#: data/json/zones.json
#. ~ Description of loot zone "Mine Terrain"
msgid "Designate an area to mine."
msgstr "Designar un  a minar."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Mop Tile"
msgstr "Espacio de Fregar"

#: data/json/zones.json
#. ~ Description of loot zone "Mop Tile"
msgid "Designate an area to mop clean."
msgstr "Designa un área para fregar."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "No Auto Pickup"
msgstr "Sin Autorecogida"

#: data/json/zones.json
#. ~ Description of loot zone "No Auto Pickup"
msgid "You won't auto-pickup items inside the zone."
msgstr "No autorecogerás objetos dentro de la zona."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "No NPC Pickup"
msgstr "PNJ No Recogida"

#: data/json/zones.json
#. ~ Description of loot zone "No NPC Pickup"
msgid "Friendly NPCs don't pickup items inside the zone."
msgstr "Los PNJ amigos no cogerán objetos dentro de la zona."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "NPC Ignore Sounds"
msgstr "PNJ Ignorar Sonidos"

#: data/json/zones.json
#. ~ Description of loot zone "NPC Ignore Sounds"
msgid "Friendly NPCs won't investigate unseen sounds coming from this zone."
msgstr "Los PNJ amigos no investigarán sonidos no visibles que provengan de esta zona."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "NPC Investigation Area"
msgstr "PNJ Área de Investigación"

#: data/json/zones.json
#. ~ Description of loot zone "NPC Investigation Area"
msgid ""
"Friendly NPCs will investigate unseen sounds only if they come from inside "
"this area."
msgstr ""
"Los PNJ amigos investigarán los sonidos invisibles solo si provienen del "
"interior de esta área."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "NPC Retreat"
msgstr "PNJ Retirada"

#: data/json/zones.json
#. ~ Description of loot zone "NPC Retreat"
msgid ""
"When fleeing, friendly NPCs will attempt to retreat toward this zone if it is "
"within 60 tiles."
msgstr ""
"Al huir, los PNJ amigos intentarán retirarse hacia esta zona si está dentro "
"de 60 espacios."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Start Point"
msgstr "Punto de Inicio"

#: data/json/zones.json
#. ~ Description of loot zone "Start Point"
msgid "A prioritized spawn point."
msgstr "Un punto prioritario de spawn"

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Source: Firewood"
msgstr "Fuente: leña"

#: data/json/zones.json
#. ~ Description of loot zone "Source: Firewood"
msgid ""
"Source for firewood or other flammable materials in this zone may be used to "
"automatically refuel fires.  This will be done to maintain light during "
"long-running tasks such as crafting, reading or waiting."
msgstr ""
"La fuente de leña u otros materiales inflamables en esta zona puede usarse "
"para reabastecer fuego automáticamente. Esto se hará para mantener la luz "
"durante las tareas de larga duración, como la fabricación, la lectura o la "
"espera."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Vehicle Deconstruct Zone"
msgstr "Zona de Desmontaje de Vehículos"

#: data/json/zones.json
#. ~ Description of loot zone "Vehicle Deconstruct Zone"
msgid "Any vehicles in this area are marked for deconstruction."
msgstr "Todos los vehículos de esta zona están marcados para su desmontaje."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Vehicle Patrol Zone"
msgstr "Zona Patrulla Vehículos"

#: data/json/zones.json
#. ~ Description of loot zone "Vehicle Patrol Zone"
msgid "Vehicles with an autopilot will patrol in this zone."
msgstr "Los vehículos con piloto automático patrullarán en esta zona."

#: data/json/zones.json
#. ~ Name of loot zone
msgid "Vehicle Repair Zone"
msgstr "Zona de reparación de vehículos"

#: data/json/zones.json
#. ~ Description of loot zone "Vehicle Repair Zone"
msgid "Any vehicles in this area are marked for repair work."
msgstr "Todos los vehículos en esta área están marcados para trabajos de reparación."

#: data/json/artifact/altered_object_active.json
#. ~ Name of spell "AO_FRIENDLY_VORTEX"
msgid "Artifact Vortex"
msgstr "Artefacto Vórtice"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_FRIENDLY_VORTEX ( Artifact Vortex )"
msgid "Summon vortexes."
msgstr "Invocar vórtices."

#: data/json/artifact/altered_object_active.json
#. ~ Message of spell "AO_FRIENDLY_VORTEX ( Artifact Vortex )"
msgid "Space twists and deforms around you."
msgstr "El espacio gira y se deforma alrededor tuyo."

#: data/json/artifact/altered_object_active.json
#. ~ Name of spell "AO_CALL_OF_TINDALOS"
msgid "Artifact Call of Tindalos"
msgstr "Artefacto Llamada de Tindalos"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_CALL_OF_TINDALOS ( Artifact Call of Tindalos )"
msgid "Summon hostile hounds of Tindalos."
msgstr "Invocar perros Tindalos hostiles."

#: data/json/artifact/altered_object_active.json
#. ~ Message of spell "AO_CALL_OF_TINDALOS ( Artifact Call of Tindalos )"
msgid ""
"The world unravels into geometric shapes, and between the chaos you spot a "
"horrid prowling beast."
msgstr ""
"El mundo se deshace en formas geométricas y, entre el caos, se divisa una "
"horrible bestia merodeando."

#: data/json/artifact/altered_object_active.json
#. ~ Name of spell "AO_FORCE_PULL"
msgid "Artifact Force Pull"
msgstr "Artefacto Empuje de Fuerza"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_FORCE_PULL ( Artifact Force Pull )"
msgid "Pull objects."
msgstr "Empuja objetos."

#: data/json/artifact/altered_object_active.json
#. ~ Message of spell "AO_FORCE_PULL ( Artifact Force Pull )"
msgid "An unnatural implosion sends objects flying."
msgstr "Una implosión antinatural envia objetos por los aires"

#: data/json/artifact/altered_object_active.json
#. ~ Name of spell "AO_TELEPORTITIS"
msgid "Artifact Teleportitis"
msgstr "Artefacto Teleporte"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_TELEPORTITIS ( Artifact Teleportitis )"
msgid "Causes you to teleport uncontrollably."
msgstr "Hace que te teletransportes sin control."

#: data/json/artifact/altered_object_active.json
#. ~ Message of spell "AO_TELEPORTITIS ( Artifact Teleportitis )"
msgid ""
"The world loses coherence, with images of nearby places forming and "
"disappearing around you."
msgstr ""
"El mundo pierde coherencia, con imágenes de lugares cercanos que se forman y "
"desaparecen a su alrededor."

#: data/json/artifact/altered_object_active.json
#. ~ Name of spell "AO_SLOW"
msgid "Artifact Slow"
msgstr "Artefacto Lento"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_SLOW ( Artifact Slow )"
msgid "Slows you for a few turns."
msgstr "Te vuelve lento durante unos pocos turnos."

#: data/json/artifact/altered_object_active.json
#. ~ Message of spell "AO_SLOW ( Artifact Slow )"
msgid "The world shifts blue, and reality accelerates around you."
msgstr "El mundo se vuelve azul y la realidad se acelera a tu alrededor."

#: data/json/artifact/altered_object_active.json
#. ~ Name of spell "AO_TIME_STOP"
msgid "Artifact Time Stop"
msgstr "Artefacto Tiempo Detenido"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_TIME_STOP ( Artifact Time Stop )"
msgid "Grants you a few turns of super speed."
msgstr "Te concede unos cuantos turnos de supervelocidad."

#: data/json/artifact/altered_object_active.json
#. ~ Message of spell "AO_TIME_STOP ( Artifact Time Stop )"
msgid "Stale golden light floods the world, and reality stands still."
msgstr "La luz dorada y apagada inunda el mundo y la realidad se detiene."

#: data/json/artifact/altered_object_active.json
#. ~ Name of spell "AO_DARKNESS_EFFECT"
msgid "Artifact Darkness"
msgstr "Artefacto Oscuridad"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_DARKNESS_EFFECT ( Artifact Darkness )"
msgid "Grants you the Darkness effect."
msgstr "Te otorga los efectos de la Oscuridad."

#: data/json/artifact/altered_object_active.json
#. ~ Message of spell "AO_DARKNESS_EFFECT ( Artifact Darkness )"
msgid "Persistent shadows invade your field of view."
msgstr "Las sombras persistentes invaden tu campo de visión."

#: data/json/artifact/altered_object_active.json
#: data/json/artifact/legacy_artifact_active.json
#. ~ Name of spell "AO_LIFE_DRAIN"
#. ~ Name of spell "AEA_HURTALL"
msgid "Artifact Hurtall"
msgstr "Artefacto Herida"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_LIFE_DRAIN ( Artifact Hurtall )"
msgid "Hurts you for random damage."
msgstr "Te hace un daño aleatorio."

#: data/json/artifact/altered_object_active.json
#. ~ Message of spell "AO_LIFE_DRAIN ( Artifact Hurtall )"
msgid "You feel hollow inside."
msgstr "Te sientes hueco por dentro."

#: data/json/artifact/altered_object_active.json
#. ~ Name of spell "AO_CLOSE_TEAR"
msgid "Artifact Close Tear"
msgstr "Artefacto Cerrador de Grietas"

#: data/json/artifact/altered_object_active.json
#. ~ Description of spell "AO_CLOSE_TEAR ( Artifact Close Tear )"
msgid "Closes a tear in reality and transfers strange energy to the artifact user."
msgstr ""
"Cierra una grieta en la realidad y transfiere esa extraña energía hacia el "
"usuario del artefacto."

