#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "conj_throwing_blade3 ( Conjure Throwing Blade I )"
msgid "You activate your ring and three throwing knives appear, ready to throw!"
msgstr "Activas tu anillo y aparecen tres cuchillos lanzadores, ¡listos para lanzar!"

#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "conj_mag_throw_blade_1 ( Conjure Magical Throwing Blade
#. I )"
msgid "You activate your bag and a throwing knife appears, ready to throw!"
msgstr "Activas tu bolsa y aparece un cuchillo arrojadizo, ¡listo para lanzar!"

#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "conj_mag_throw_blade_fire ( Conjure Magical Throwing
#. Blade Fire )"
msgid ""
"You activate your bag and a throwing knife wrapped in ethereal flames "
"appears, ready to throw!"
msgstr ""
"Activas tu bolsa y aparece un cuchillo arrojadizo envuelto en llamas etéreas, "
"¡listo para lanzar!"

#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "conj_mag_throw_blade_cold ( Conjure Magical Throwing
#. Blade Cold )"
msgid ""
"You activate your bag and a throwing knife emanating cold appears, ready to "
"throw!"
msgstr ""
"Activas tu bolsa y aparece un cuchillo arrojadizo que emana frío, ¡listo para "
"lanzar!"

#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "conj_mag_throw_blade_cut ( Conjure Magical Throwing
#. Blade Cut )"
msgid ""
"You activate your bag and a throwing knife with unnaturally sharp edges "
"appears, ready to throw!"
msgstr ""
"Activas tu bolsa y aparece un cuchillo arrojadizo con bordes anormalmente "
"afilados, ¡listo para lanzar!"

#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "conj_mag_throw_blade_biological ( Conjure Magical
#. Throwing Blade Biological )"
msgid ""
"You activate your bag and a throwing knife covered in dark ooze appears, "
"ready to throw!"
msgstr ""
"Activas tu bolsa y aparece un cuchillo arrojadizo cubierto de un líquido "
"oscuro, ¡listo para lanzar!"

#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "magical_throwing_knife_pure_special ( Conjure Magical
#. Throwing Blade Pure )"
msgid ""
"You activate your bag and with a flash magical energies coalescence in your "
"hand into a shape of knife.  It seems vastly more powerful than other knives "
"that appear from the bag!"
msgstr ""
"Activas tu bolsa y con un destello las energías mágicas se fusionan en tu "
"mano en forma de cuchillo. ¡Parece mucho más poderoso que otros cuchillos que "
"aparecen en la bolsa!"

#: data/mods/Magiclysm/Spells/item_only.json
#: data/mods/Xedra_Evolved/spells/item_spells.json
#. ~ Message of spell "potion_recover_mana ( Recover Mana )"
#. ~ Message of spell "potion_recover_mana_xe ( Recover Mana )"
msgid "You start regenerating mana!"
msgstr "¡Empiezas a regenerar maná!"

#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "mana_doping ( Pain )"
msgid ""
"Your veins feel like they are on fire!\n"
"You start regenerating mana!"
msgstr ""
"¡Sientes que tus venas arden!\n"
"¡Comienzas a regenerar maná!"

#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Message of spell "flask_regeneration_effect ( Renovamen Healing Effect )"
msgid "You start regenerating!"
msgstr ""

#: data/mods/Magiclysm/Spells/attunements/Fire_Elemental.json
#: data/mods/Magiclysm/Spells/item_only.json
#. ~ Sound description of spell "alchemist_mine_pull ( Mana explosion )"
#. ~ Sound description of spell "flarewhip ( Flarewhip )"
