msgid_plural "sets of Battlehammer"
msgstr[0] "Battlehammer"
msgstr[1] "juegos de Battlehammer"
msgstr[2] "juegos de Battlehammer"

#: data/json/items/fluff.json
#. ~ Description of "Battlehammer"
msgid "A strategy game featuring a set of tiny figurines of fantasy creatures."
msgstr ""
"Un juego de estrategia con un conjunto de pequeñas figuritas de criaturas "
"fantásticas."

#: data/json/items/fluff.json
#. ~ Item name
