"in a spiked club of bone."
msgstr ""
"Este dinosaurio de cuatro patas fuertemente blindado tiene un pico y una cola "
"larga terminando en una maza con púas de hueso."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "ankylosaurus"
msgid_plural "ankylosaurus"
msgstr[0] "ankylosaurus"
msgstr[1] "ankylosaurus"
msgstr[2] "ankylosaurus"

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Description of monster "ankylosaurus"
