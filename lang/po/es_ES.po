msgid "heavy breathing."
msgstr "respiración pesada."

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"No… stop the burning!\""
msgstr "\"No... ¡Para el fuego!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"Hrgm… blood… hungry…\""
msgstr "\"Hrgm... sangre... hambre...\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"Hunger… must eat…\""
msgstr "\"Hambre... debo comer...\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"Run… chase… eat…\""
msgstr "\"Correr... perseguir... comer...\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "hysterical laughing."
