#: src/activity_actor.cpp:358
#, c-format
msgid "Your %s is little more than an awkward club now."
msgstr "Tu %s es poco más que un garrote incómodo ahora."

#: src/activity_actor.cpp:372
#, c-format
msgid ""
"Your %s has some mechanical malfunction.  You tried to quickly fix it, and it "
"works now!"
msgstr ""
"Tu %s tiene algun tipo de avería mecánica. Has intentado arreglarlo "
"rápidamente, ¡y ya funciona!"

#: src/activity_actor.cpp:378
#, c-format
msgid ""
"Your %s has some mechanical malfunction.  You tried to quickly fix it, but "
"failed!"
msgstr ""
"Tu %s tiene algun tipo de avería mecánica. Has intentado arreglarlo "
"rápidamente, ¡pero has fallado!"

#: src/activity_actor.cpp:386
#, c-format
