msgstr[1] "alambres de acero"
msgstr[2] "alambres de acero"

#: data/json/items/generic.json
#. ~ Description of "steel wire"
msgid ""
"A length of thin, relatively stiff wire made of mild steel.  Ubiquitously "
"found in everyday applications such as chain link fences."
msgstr ""
"Un alambre fino y relativamente rígido de acero dulce. Habitualmente se "
"utiliza en aplicaciones cotidianas, como las vallas metálicas."

#: data/json/items/generic.json
#. ~ Item name
msgid "medium steel wire"
msgid_plural "medium steel wires"
msgstr[0] "alambre de acero medio"
msgstr[1] "alambres de acero medio"
msgstr[2] "alambres de acero medio"

#: data/json/items/generic.json
#. ~ Description of "medium steel wire"
