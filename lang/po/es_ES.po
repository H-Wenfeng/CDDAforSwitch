#: data/json/furniture_and_terrain/netherum/terrain_labyrinth_cybernetic.json
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "broken metal floor"
msgstr "suelo de metal roto"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "broken metal floor"
msgid ""
"Something has cratered this metal flooring.  It will be difficult to move "
"things across."
msgstr ""
"Algo ha hecho cráteres en este suelo metálico. Será difícil mover cosas a "
"través de él."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "floor"
msgstr "suelo"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "floor"
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with wooden posts and beams that can support a roof."
msgstr ""
"Tejas de madera entrelazadas que están más que probablemente tratadas contra "
"el fuego, con postes y vigas de madera que pueden sostener un techo/tejado."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "primitive floor"
msgstr "piso primitivo"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "primitive floor"
msgid "A timber floor and supports that can support a roof."
msgstr "Un suelo de madera y soportes que pueden sostener un techo/tejado."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "simple metal floor"
msgstr "suelo simple de metal"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "simple metal floor"
msgid ""
"A crudely welded-together metal floor with steel trusses and supporting "
"girders.  Can support a roof."
msgstr ""
"Un suelo metálico toscamente soldado con entramados de acero y vigas de "
"soporte. Puede soportar un techo/tejado."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "waxed floor"
msgstr "suelo encerado"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "waxed floor"
msgid ""
"Hardwood flooring that has been treated with chemicals to improve slip "
"resistance and sliding, commonly for recreational sports.  It can support a "
"roof."
msgstr ""
"Suelo de madera dura que ha sido tratado con productos químicos para mejorar "
"la resistencia al deslizamiento y al resbalamiento, comúnmente para deportes "
"recreativos. Puede soportar un techo/tejado."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "dirt floor"
msgstr "suelo de tierra"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "dirt floor"
msgid ""
"A floor consisting of finely mixed earth that has been tamped down.  It can "
"support a roof."
msgstr ""
"Un suelo que consiste en tierra finamente mezclada que ha sido apisonada. "
"Puede soportar un techo/tejado."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "utility light"
msgstr "luz de utilidad"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "utility light"
msgid ""
"An industrial floodlight set up to illuminate the surroundings.  Smashing it "
"doesn't seem like it'd produce any worthwhile salvage."
msgstr ""
"Un foco industrial instalado para iluminar los alrededores. Romperlo no "
"parece que vaya a producir ningún material que valga la pena."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "wax floor"
msgstr "piso de cera"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "wax floor"
msgid "A floor section made entirely out of wax."
msgstr ""
"Una secciónUna sección del piso hecha completamente de cera. del piso hecha "
"completamente de cera."

