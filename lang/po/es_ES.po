msgstr "<LIXA_personal_snip_3>"

#: data/json/npcs/LIXA_talk.json
#. ~ NPC dialogue line
msgid "<LIXA_personal_snip_4>"
msgstr "<LIXA_personal_snip_4>"

#: data/json/npcs/LIXA_talk.json
#. ~ NPC dialogue line
msgid ""
"\"ERROR: file path corrupted.  Please contact your sysadmin.\"  The computer "
"then freezes, and reboots."
msgstr ""
"«ERROR: ruta de archivo corrupta. Póngase en contacto con el administrador "
"del sistema\". El ordenador se congela y se reinicia."

#: data/json/npcs/LIXA_talk.json
#. ~ NPC dialogue line
msgid "WARNING:  multiple system faults detected!  SHUT DOWN IMMEDIATELY."
msgstr ""
"ADVERTENCIA: ¡se han detectado varios fallos en el sistema! APAGUE EL SISTEMA "
"INMEDIATAMENTE."

#: data/json/npcs/LIXA_talk.json
#. ~ Response to NPC dialogue
msgid "ERROR: Flux Limiters"
msgstr "ERROR: Limitadores de Flujo"

#: data/json/npcs/LIXA_talk.json
#. ~ Response to NPC dialogue
msgid "ERROR: Power Draw"
msgstr "ERROR: Consumo de Energía"

#: data/json/npcs/LIXA_talk.json
#. ~ Response to NPC dialogue
msgid "SYSTEM SHUTDOWN"
