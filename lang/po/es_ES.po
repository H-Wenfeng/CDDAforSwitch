msgid_plural "white chicks"
msgstr[0] "pollito blanco"
msgstr[1] "pollitos blancos"
msgstr[2] "pollitos blancos"

#: data/mods/Megafauna/monsters/mf_wild.json
#. ~ Description of monster "white chick"
msgid "A tiny grey-colored chick, it could be from a number of different species."
msgstr ""
"Es un pequeño pollito de color gris que puede ser de cualquiera de las "
"especies que hay."

#: data/mods/Megafauna/monsters/mf_wild.json
#. ~ Monster name
msgid "glyptotherium"
msgid_plural "glyptotherii"
msgstr[0] "gliptoterio"
msgstr[1] "gliptoterios"
msgstr[2] "gliptoterios"

#: data/mods/Megafauna/monsters/mf_wild.json
#. ~ Description of monster "glyptotherium"
msgid ""
"A huge herbivore that almost resembles a giant tortoise due to its hard outer "
"shell, although it is a close relative to armadillos.  Normally, this species "
"prefers much warmer climates.  This individual probably lost its way at some "
"point."
msgstr ""
"Es un herbívoro gigante que casi se asemeja a un galápago gigante debido a su "
"caparazón exterior dura, aunque es un pariente cercano de los quirquinchos. "
"Normalmente, esta especie prefiere climas mucho más cálidos. Este individuo "
"probablemente se haya perdido en algún momento."

#: data/mods/Megafauna/monsters/mf_wild.json
#. ~ Monster name
