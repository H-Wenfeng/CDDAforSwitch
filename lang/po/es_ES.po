"hooked beak."
msgstr ""
"Un pequeño dinosaurio parecido a un rinoceronte con una cresta ósea salpicada "
"de pequeños cuernos y un pico ganchudo."

#: data/mods/DinoMod/monsters/dinosaur.json
#. ~ Monster name
msgid "leptoceratops"
msgid_plural "leptoceratops"
