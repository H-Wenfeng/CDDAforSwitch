#: data/json/items/armor/boots.json
#. ~ Description of "pair of jika-tabi"
msgid "A pair of thin traditional Japanese split toed boots sewn out of leather."
msgstr ""
"Un par de finas botas tradicionales japonesas de puntera partida cosidas en "
"cuero."

