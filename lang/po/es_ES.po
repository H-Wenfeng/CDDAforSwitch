msgid_plural "Subcutaneous Protective Mesh - Legs CBMs"
msgstr[0] "MBC Pierna - Malla Protectora Subcutánea"
msgstr[1] "MBCs Pierna - Malla Protectora Subcutánea"
msgstr[2] "MBCs Pierna - Malla Protectora Subcutánea"

#: data/json/items/bionics.json
