#: data/mods/Sky_Island/items.json
#. ~ "description" action message of item "flotation stone"
msgid "Cross the waters."
msgstr ""

#: data/mods/Sky_Island/items.json
#. ~ Item name
msgid "warp shards"
msgid_plural "warp shards"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/mods/Sky_Island/items.json
#. ~ Description of "warp shards"
msgid ""
"A small quantity of airy-thin material that resembles flaked obsidian.  It "
"glints with a purplish shimmer that seems to stretch off the bounds of itself "
"and into the air itself.  Offered to the powers that be, one could exchange "
"it for valuable artifacts."
msgstr ""

#: data/mods/Sky_Island/items.json
#. ~ Item name
msgid "material token"
msgid_plural "material token"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/mods/Sky_Island/items.json
