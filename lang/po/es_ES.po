msgid_plural "exosuit gasoline ICE power supplies"
msgstr[0] "suministrador de energía a gasolina ICE de exotraje"
msgstr[1] "suministradores de energía a gasolina ICE de exotraje"
msgstr[2] "suministradores de energía a gasolina ICE de exotraje"

