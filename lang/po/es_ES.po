#: data/json/npcs/LIXA_talk.json
#. ~ Response to NPC dialogue
msgid "Copy research archives to external device."
msgstr "Copiar archivos de investigación en un dispositivo externo."

#: data/json/npcs/LIXA_talk.json
#. ~ NPC dialogue line
msgid "ERROR:  access denied!  Reason: insufficient clearance level."
msgstr "ERROR: ¡acceso denegado! Motivo: nivel de autorización insuficiente."

#: data/json/npcs/LIXA_talk.json
