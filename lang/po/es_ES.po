#: data/mods/MindOverMatter/effectoncondition/eoc_items.json
#. ~ EOC option description in effect in EoC
#. "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT"
msgid "Activate the remote and transport yourself to your destination."
msgstr ""

#: data/mods/MindOverMatter/effectoncondition/eoc_items.json
#. ~ EOC option description in effect in EoC
#. "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT"
msgid "Turn the remote off for now."
msgstr ""

#: data/mods/MindOverMatter/effectoncondition/eoc_items.json
#. ~ Player message in effect in EoC
#. "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT_YES_2" in nested EOCs in
#. effect in EoC "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT_YES"
msgid ""
"There is a long moment of darkness and terrible cold that seems like it will "
"freeze your heart, all the while filled with the sensation of watchful eyes, "
"and then you are somewhere else.  When you arrive, you can't help but glance "
"over your shoulder."
msgstr ""

#: data/mods/MindOverMatter/effectoncondition/eoc_items.json
#. ~ Player message in effect in EoC
#. "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT_YES_3" in nested EOCs in
#. effect in EoC "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT_YES_2" in
#. nested EOCs in effect in EoC
#. "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT_YES"
msgid ""
"And as you look around, you notice you're not the only one who stepped out of "
"the Nether."
msgstr ""

#: data/mods/MindOverMatter/effectoncondition/eoc_items.json
#: data/mods/MindOverMatter/obsolete/powers.json
#: data/mods/MindOverMatter/powers/teleportation_eoc.json
#. ~ Player message in false effect in EoC
#. "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT_YES_2" in nested EOCs in
#. effect in EoC "EOC_PSI_TRANSPORTER_REMOTE_TELEPORT_TRANSPORT_YES"
#. ~ Message of spell "teleport_gateway_legacy ( [Ψ]Gateway (Obsolete) )"
#. ~ Player message in effect in EoC "EOC_TELEPORTER_GATEWAY_MESSAGE"
msgid ""
"There is a long moment of darkness and terrible cold that seems like it will "
"freeze your heart, and then you are somewhere else."
msgstr ""

#: data/mods/MindOverMatter/effectoncondition/eoc_items.json
#. ~ Player message in effect in EoC
