msgid "Turn off"
msgstr "Apagar"

#: src/iuse.cpp:7143
msgid "You turned off your RC car."
msgstr "Apagas tu coche radiocontrol"

#: src/iuse.cpp:7156 src/iuse.cpp:7177
msgid "beep"
msgstr "¡bip!"

#: src/iuse.cpp:7214
msgid "Take control of RC car"
msgstr "Controlar coche radiocontrol"

#: src/iuse.cpp:7216
msgid "Stop controlling RC car"
msgstr "Dejar de controlar coche radiocontrol"

#: src/iuse.cpp:7219
msgid "What to do with the radio control?"
msgstr "¿Qué quieres hacer con el radiocontrol?"

#: src/iuse.cpp:7221
msgid "Press blue button"
msgstr "Apretar botón azul"

#: src/iuse.cpp:7221
msgid "Press green button"
msgstr "Apretar botón verde"

#: src/iuse.cpp:7221
msgid "Press red button"
msgstr "Apretar botón rojo"

#: src/iuse.cpp:7242
msgid "No active RC cars on ground and in range."
msgstr "No hay coches radiocontrol en el suelo y cerca."

#: src/iuse.cpp:7245
msgid "You take control of the RC car."
msgstr "Tomas el control del coche radiocontrol."

#: src/iuse.cpp:7258
#, c-format
msgid ""
"The %s in your inventory would explode on this signal.  Place it down before "
"sending the signal."
msgstr ""
"%s en tu inventario explotará con esta señal. Colócalo en algún lugar antes "
"de enviar la señal."

#: src/iuse.cpp:7273
#, c-format
msgid ""
"The %1$s in your %2$s would explode on this signal.  Place it down before "
"sending the signal."
msgstr ""
" %1$s en tu %2$s explotará al recibir esta señal. Colócalo en algún lugar "
"antes de enviar la señal."

#: src/iuse.cpp:7299
msgid "This vehicle's security system has locked you out!"
msgstr "¡El sistema de seguridad de este vehículo te ha encerrado afuera!"

#: src/iuse.cpp:7312
msgid "You trigger the alarm!"
msgstr "¡Hiciste sonar la alarma!"

#: src/iuse.cpp:7316
msgid "You quickly bypass the security system!"
msgstr "¡Rápidamente, puenteas el sistema de seguridad!"

#: src/iuse.cpp:7320
msgid "Try to hack this car's security system?"
msgstr "¿Quieres intentar hackear el sistema de seguridad del coche?"

#: src/iuse.cpp:7330
msgid "You waste some time, but fail to affect the security system."
msgstr ""
"Pierdes un poco de tiempo, pero no puedes hacer nada con el sistema de "
"seguridad."

#: src/iuse.cpp:7333
msgid "You fail to affect the security system."
msgstr "No pudiste hacer nada con el sistema de seguridad."

#: src/iuse.cpp:7337
msgid "You take some time, but manage to bypass the security system!"
msgstr "¡Tardas un tiempo, pero logras puentear el sistema de seguridad!"

#: src/iuse.cpp:7355
msgid "Select vehicle to access"
msgstr "Selecciona vehículo para acceder"

#: src/iuse.cpp:7375
msgid "No vehicle available."
msgstr "No hay vehículo disponible."

#: src/iuse.cpp:7400
msgid "The remote control's battery goes dead."
msgstr "El control remoto se quedó sin baterías."

#: src/iuse.cpp:7403
msgid "Lost contact with the vehicle."
msgstr "Perdiste contacto con el vehículo."

#: src/iuse.cpp:7406
msgid "The vehicle's battery died."
msgstr "El vehículo se quedó sin baterías."

#: src/iuse.cpp:7424
msgid "What to do with the remote vehicle control:"
msgstr "Qué hacer con el control remoto del vehículo:"

#: src/iuse.cpp:7425
msgid "Stop controlling the vehicle."
msgstr "Dejar de controlar el vehículo."

#: src/iuse.cpp:7425
msgid "Take control of a vehicle."
msgstr "Controlar un vehículo."

#: src/iuse.cpp:7426
msgid "Execute one vehicle action"
msgstr "Realizar una acción con el vehículo"

#: src/iuse.cpp:7455
msgid "Despite using a controller, you still refuse to take control of this vehicle."
msgstr ""
"A pesar de usar un mando, todavía te niegas a tomar el control de este "
"vehículo."

#: src/iuse.cpp:7459
msgid "You take control of the vehicle."
msgstr "Tomas el control del vehículo."

#: src/iuse.cpp:7486
msgid "And when you gaze long into a screen, the screen also gazes into you."
msgstr ""
"Y cuando te quedas mirando fijamente la pantalla, la pantalla también te mira "
"fijamente a ti."

#: src/iuse.cpp:7490
msgid "The multi-cooker boiled your head!"
msgstr "¡La multicocina te hierve la cabeza!"

#: src/iuse.cpp:7494
msgid "The characters on the screen display an obscene joke.  Strange humor."
msgstr "Los caracteres en la pantalla muestran un chiste obsceno. Un humor extraño."

#: src/iuse.cpp:7499
#. ~ Single-spaced & lowercase are intentional, conveying hurried speech-KA101
msgid "Are you sure?!  the multi-cooker wants to poison your food!"
msgstr "¡¿Estás seguro?! ¡La multicocina quiere envenenar tu comida!"

#: src/iuse.cpp:7504
msgid ""
"The multi-cooker argues with you about the taste preferences.  You don't want "
"to deal with it."
msgstr ""
"La multicocina te discute las preferencias de sabores. No tienes ganas de "
"aguantar eso."

#: src/iuse.cpp:7509
msgid "The multi-cooker runs away!"
msgstr "¡La multicocina sale corriendo!"

#: src/iuse.cpp:7515
msgid "You're surrounded by aggressive multi-cookers!"
msgstr "¡Estás rodeado por multicocinas agresivas!"

#: src/iuse.cpp:7548
msgid "You can't read, and don't understand the screen or the buttons!"
msgstr "¡No puedes leer, y no entiendes la pantalla o los botones!"

#: src/iuse.cpp:7566
msgid "Welcome to the RobotChef3000.  Choose option:"
msgstr "Bienvenido al RobotChef3000. Elegir opción:"

#: src/iuse.cpp:7574
msgid "Stop cooking"
msgstr "Dejar de cocinar"

#: src/iuse.cpp:7578
msgid "Batteries are low."
msgstr "Poca batería."

#: src/iuse.cpp:7581
msgid "Start cooking"
msgstr "Empezar a cocinar"

#: src/iuse.cpp:7589
msgid "Upgrade multi-cooker"
msgstr "Mejorar multicocina"

#: src/iuse.cpp:7592
msgid "Multi-cooker already upgraded"
msgstr "La multicocina ya está mejorada"

#: src/iuse.cpp:7594
msgid "Multi-cooker unable to upgrade"
msgstr "No se puede mejorar la multicocina"

#: src/iuse.cpp:7601
msgid "Take out dish"
msgstr "Sacar plato"

#: src/iuse.cpp:7604 src/iuse.cpp:7871
msgid "Obstruction detected.  Please remove any items lodged in the multi-cooker."
msgstr ""
"Obstrucción detectada. Por favor, retire cualquier objeto alojado en la "
"multicocina."

#: src/iuse.cpp:7617
msgid "Really stop cooking?"
msgstr "¿Seguro que quieres dejar de cocinar?"

#: src/iuse.cpp:7636
#, c-format
msgid "You don't have a suitable container to store your %s."
msgstr "No tienes un contenedor adecuado para almacenar tu %s."

#: src/iuse.cpp:7650
#, c-format
msgid "You got the dish from the multi-cooker.  The %s smells delicious."
msgstr "Coges el plato de la multicocina. El %s huele delicioso."

#: src/iuse.cpp:7653
#, c-format
msgid "You got the %s from the multi-cooker."
msgstr "Coges %s de la multicocina."

#: src/iuse.cpp:7667
msgid "Choose desired meal:"
msgstr "Elegir comida deseada:"

#: src/iuse.cpp:7718
#, c-format
msgid "The multi-cooker needs %d charges to cook this dish."
msgstr "La multicocina necesita %d cargas para cocinar este plato."

#: src/iuse.cpp:7740
msgid ""
"The screen flashes blue symbols and scales as the multi-cooker begins to "
"shake."
msgstr ""
"La pantalla muestra símbolos azules y pesa mientras la multicocina empieza a "
"agitar."

#: src/iuse.cpp:7754
msgid "Your morale is too low to craft…"
msgstr "Tu moral está demasiado baja para fabricar..."

#: src/iuse.cpp:7763
#, c-format
msgid "You need a %s."
msgstr "Necesitas un %s."

#: src/iuse.cpp:7769
#, c-format
msgid "You need an item with %s of 1 or more to upgrade this."
msgstr "Necesitas un objeto con %s de 1 o más para mejorar esto."

#: src/iuse.cpp:7795
msgid ""
"You've successfully upgraded the multi-cooker, master tinkerer!  Now it cooks "
"faster!"
msgstr ""
"¡Haz mejorado exitosamente la multicocina, manitas maestro! ¡Ahora cocinará "
"más rápido!"

#: src/iuse.cpp:7805
msgid ""
"You sagely examine and analyze the multi-cooker, but don't manage to "
"accomplish anything."
msgstr ""
"Examinas y analizás concienzudamente la multicocina, pero no logras conseguir "
"nada."

#: src/iuse.cpp:7808
msgid ""
"Your tinkering nearly breaks the multi-cooker!  Fortunately, it still works, "
"but best to stop messing with it."
msgstr ""
"¡Por estar traqueteando con la multicocina casi la rompes! Por suerte, "
"todavía funciona, pero mejor dejala como esta."

#: src/iuse.cpp:7835
msgid ""
"Batteries low, entering standby mode.  With a low buzzing sound the "
"multi-cooker shuts down."
msgstr ""
"Baterías bajas, entrando en modo de espera. Con un zumbido bajo, la "
"multicocina se apaga."

#: src/iuse.cpp:7850
msgid "The multi-cooker should be finishing shortly…"
msgstr "La multicocina debería estar terminando ya…"

#: src/iuse.cpp:7876
#. ~ sound of a multi-cooker finishing its cycle!
msgid "ding!"
msgstr "ding!"

#: src/iuse.cpp:7898
#, c-format
msgid "The %s's monitor slowly outputs the data…"
msgstr "El monitor de %s produce lentamente los datos..."

#: src/iuse.cpp:7909 src/iuse.cpp:7915 src/iuse.cpp:7928
#, c-format
msgid "The %1$s reads %2$s."
msgstr "El %1$s lee %2$s."

#: src/iuse.cpp:7968
msgid "You can't see the Sun from here."
msgstr "No puedes ver el sol desde aquí."

#: src/iuse.cpp:7970
#, c-format
msgid "The Sun is at an altitude of %.1f°."
msgstr "El sol está a una altitud de %.1f°."

#: src/iuse.cpp:7972
msgid "The Sun is below the horizon."
msgstr "El sol está por debajo del horizonte."

#: src/iuse.cpp:7980
#, c-format
msgid "The illumination is %.1f."
msgstr "La iluminación esta a %.1f."

#: src/iuse.cpp:7997
#, c-format
msgid ""
"Incident light: %.1f\n"
"Natural light: %.1f\n"
"Sunlight: %.1f\n"
"Sun irradiance: %.1f\n"
"Incident irradiance %.1f"
msgstr ""
"Incidencia de luz: %.1f\n"
"Luz natural: %.1f\n"
"Luz solar: %.1f\n"
"Radiación solar: %.1f\n"
"Incidencia de radiación %.1f"

#: src/iuse.cpp:8011
#, c-format
msgid "You check your registered calories intake on your %s."
msgstr "Comprueba tu consumo de calorías registrado en tu %s."

#: src/iuse.cpp:8027 src/iuse_actor.cpp:431 src/iuse_actor.cpp:2859
#: src/iuse_actor.cpp:6123
#, c-format
msgid "You need to wear the %1$s before activating it."
msgstr "Tienes que ponerte el %1$santes de activarlo."

#: src/iuse.cpp:8032
msgid "Choose hologram direction."
msgstr "Elige la dirección del holograma."

#: src/iuse.cpp:8040
msgid "Can't create a hologram there."
msgstr "No se puede crear un holograma ahí."

#: src/iuse.cpp:8059
#, c-format
msgid "The %s must be installed in a vehicle before being loaded."
msgstr "El %s tiene que estar instalado en un vehículo antes de ser cargado."

#: src/iuse.cpp:8073
#, c-format
