#: data/json/items/armor/ballistic_armor.json
#. ~ Item name
#. ~ Variant name of item "US ballistic vest"
msgid "US ballistic vest"
msgid_plural "US ballistic vests"
msgstr[0] "chaleco antibalas EE. UU."
msgstr[1] "chalecos antibalas EE. UU."
msgstr[2] "chalecos antibalas EE. UU."

#: data/json/items/armor/ballistic_armor.json
#. ~ Description of "US ballistic vest"
msgid ""
"A ballistic vest with specialized pockets on the front, back, and sides to "
"hold armor plates.  While this plate carrier is still protective even without "
"inserts, it's too soft to effectively stop high-energy projectiles on its own."
msgstr ""
"Un chaleco antibalas con compartimentos especializados en la parte delantera, "
"la espalda y los laterales para alojar placas de blindaje. Aunque este "
"portaplacas sigue siendo protector incluso sin inserciones, por si solo es "
"demasiado blando para detener eficazmente los proyectiles de alta energía."

#: data/json/items/armor/ballistic_armor.json
#. ~ Description of variant "US ballistic vest" of item "US ballistic vest"
msgid ""
"This version is patterned in multi-environment camouflage, and was "
"standard-issue for the US Army."
msgstr ""
"Esta versión tiene un patrón de camuflaje multiambiental, y era el estándar "
"para el Ejército de los Estados Unidos."

#: data/json/items/armor/ballistic_armor.json
#. ~ Variant name of item "US ballistic vest"
msgid "SWAT ballistic vest"
msgid_plural "SWAT ballistic vests"
msgstr[0] "chaleco antibalas SWAT"
msgstr[1] "chalecos antibalas SWAT"
msgstr[2] "chalecos antibalas SWAT"

#: data/json/items/armor/ballistic_armor.json
#. ~ Description of variant "SWAT ballistic vest" of item "US ballistic vest"
msgid ""
"This version is colored black, and was once used by specialized police "
"forces.  \"SWAT\" is emblazoned on the back."
msgstr ""
"Esta versión es de color negro, y en su día fue utilizada por las fuerzas "
"policiales especializadas. \"SWAT\" está estampado en la espalda."

