#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "This is a cartoon rendition of a zombie."
msgstr "Esta es una interpretación de dibujos animados de un zombi."

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "This is a crudely spraypainted tag adorned with skulls."
msgstr "Esta es una etiqueta crudamente pintada con spray y adornada con cráneos."

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid ""
"I have a secure and loving relationship with your mom and you're going to "
"need to come to terms with that.\n"
"\n"
"Do you want to talk about it?  You know where to find me.  Love you sweety."
msgstr ""
"Tengo una relación segura y cariñosa con tu madre y vas a tener que "
"aceptarlo.\n"
"\n"
"¿Quieres hablar de ello? Ya sabes dónde encontrarme. Te quiero, cariño."

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "<given_name> you fuckin gave me ADES you SHIT."
msgstr "<given_name>me has pasado SIDA, eres MIERDA."

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "I <lt>3 <full_name>."
msgstr "I <lt>3 <full_name>."

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "<given_name> fucked <full_name>."
msgstr "<given_name> jodido <full_name>."

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "This is a spraypainted drawing of an angel with wings made of vines."
msgstr "Este es un dibujo pintado con spray de un ángel con alas de enredaderas."

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "Mr. <family_name> is a vampire!"
msgstr "¡El Sr. <family_name> es un vampiro!"

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "Their hiding the truth"
msgstr "Estan ocultando la verdad"

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "FOLLOW THE CHEMTRAILS"
msgstr "SIGUE LOS CHEMTRAILS"

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
#. ~ This graffiti is generally assumed to come from before the Cataclysm
msgid "This is a curious drawing of a roll of toilet paper dissolving into a rainbow."
msgstr ""
"Este es un curioso dibujo de un rollo de papel higiénico disolviéndose en un "
"arco iris."

#: data/json/snippets/graffiti.json
#. ~ Snippet in category "general_graffiti_snippets"
