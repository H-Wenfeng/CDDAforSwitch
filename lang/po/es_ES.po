#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Picky Meals"
msgstr "Comidas Exigentes"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Picky Meals"
msgid "Find 15 pounds (2000 units) of salt."
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Picky Meals"
msgid "I need a supply of salt."
msgstr "Necesito un suministro de sal."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Picky Meals"
msgid ""
"I know this doesn't sound important, but I am running low on salt.  We don't "
"just need it as a seasoning, it's also vital for food preservation.  Could "
"you find about 15 pounds of salt for me?"
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/holdouts/Mr_Lapin.json
#: data/mods/Aftershock/npcs/cyrus_whately.json
#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/cyrus_whately.json
#: data/mods/aftershock_exoplanet/npcs/milly_whately_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/prepnet_dialogue.json
#. ~ Dialogue line in mission "Picky Meals"
#. ~ Dialogue line in mission "Timber!"
#. ~ Dialogue line in mission "In the absence of life"
#. ~ Dialogue line in mission "Mi-go biology"
#. ~ Dialogue line in mission "Big Game Hunting"
msgid "Don't forget to tell me when you have them."
msgstr "No te olvides de avisarme cuando los tengas."

#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/holdouts/Mr_Lapin.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/prepnet_dialogue.json
#. ~ Dialogue line in mission "Picky Meals"
#. ~ Dialogue line in mission "Timber!"
#. ~ Dialogue line in mission "Big Game Hunting"
msgid "It's okay, I can do without them.  Just let me know if you reconsider."
msgstr "Está bien, puedo prescindir de ellos. Sólo avísame si lo reconsideras."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Picky Meals"
msgid ""
"There's a lot of places to look.  They are common in house kitchens, "
"restaurants or grocery stores."
msgstr ""
"Hay muchos lugares para buscar. Son comunes en las cocinas de las casas, "
"restaurantes o tiendas de comestibles."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Picky Meals"
msgid "How is the search going?  Have you found 'em?"
msgstr "¿Cómo va la búsqueda? ¿Los has encontrado?"

#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/holdouts/Mr_Lapin.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/prepnet_dialogue.json
#. ~ Dialogue line in mission "Picky Meals"
#. ~ Dialogue line in mission "Timber!"
#. ~ Dialogue line in mission "Big Game Hunting"
msgid "I really appreciate your help.  Don't worry, you won't leave empty-handed."
msgstr ""
"De verdad que aprecio tu ayuda. No te preocupes, no te irás con las manos "
"vacías."

#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/holdouts/Mr_Lapin.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/prepnet_dialogue.json
#. ~ Dialogue line in mission "Picky Meals"
#. ~ Dialogue line in mission "Prickled Meals"
#. ~ Dialogue line in mission "Timber!"
#. ~ Dialogue line in mission "Big Game Hunting"
#. ~ Dialogue line in mission "Gallon Jugs"
#. ~ Dialogue line in mission "Burnt Out CBMs"
msgid "Don't worry about it, it's not that important."
msgstr "No te preocupes por eso, no es tan importante."

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Pickled Meals"
msgstr "Comidas Encurtidas"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Pickled Meals"
msgid "Find 40 glass jars (3 L)."
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Pickled Meals"
msgid "I need several glass jars."
msgstr "Necesito varios tarros de cristal."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Pickled Meals"
msgid ""
"This task is bit more serious.  I don't have enough jars to preserve "
"perishables for the future, and we can't just store everything in salt.  We "
"could do our own canning if we had some more glass jars.  I think 40 jars "
"should be enough."
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Pickled Meals"
msgid ""
"Thanks for accepting this task.  It'll take a load off my shoulders.  I "
"finally won't have to worry about this problem anymore."
msgstr ""
"Gracias por aceptar esta tarea. Me quitará un peso de encima. Finalmente no "
"tendré que preocuparme más por este problema."

#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/holdouts/Mr_Lapin.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/prepnet_dialogue.json
#. ~ Dialogue line in mission "Pickled Meals"
#. ~ Dialogue line in mission "Sweets"
#. ~ Dialogue line in mission "Bread"
msgid "Just let me know if you change your mind."
msgstr "Sólo avísame si cambias de opinión."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Pickled Meals"
msgid "Glass jars are not that hard to find.  I'd look for them in residential areas."
msgstr ""
"Los tarros de cristal no son tan difíciles de encontrar. Yo los buscaría en "
"las zonas residenciales."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Pickled Meals"
msgid "Have you found the jars?"
msgstr "¿Has encontrado los tarros?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Pickled Meals"
msgid "Thank you for your help.  Here's your reward.  I have one more task to do."
msgstr "Gracias por tu ayuda. Aquí está tu recompensa. Tengo una tarea más que hacer."

#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/holdouts/Mr_Lapin.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/prepnet_dialogue.json
#. ~ Dialogue line in mission "Pickled Meals"
#. ~ Dialogue line in mission "Sweets"
#. ~ Dialogue line in mission "Bread"
msgid "It's not a big deal, it isn't that urgent."
msgstr "No es gran cosa, no es tan urgente."

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Prickled Meals"
msgstr "Comidas Picantes"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Prickled Meals"
msgid "Find a butcher knife."
msgstr "Encuentra un cuchillo de carnicero."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Prickled Meals"
msgid "I need something sharper."
msgstr "Necesito algo más afilado."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Prickled Meals"
msgid ""
"I don't have any butcher knives in here.  It's difficult to cut anything hard "
"without it.  It's good to have one, even though I won't use it that often.  "
"Could you get me one, or anything similarly suitable?"
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Prickled Meals"
msgid "Thank you for accepting.  I can't cut anything with this dull knife."
msgstr "Gracias por aceptar. No puedo cortar nada con este cuchillo sin filo."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Prickled Meals"
msgid "I guess I have to cut them with my steak knife."
msgstr " Supongo que tengo que cortarlos con mi cuchillo para carne."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Prickled Meals"
msgid ""
"Butcher knives are not that rare to find.  They are commonly found in "
"kitchens."
msgstr ""
"Los cuchillos de carnicero no son tan raros de encontrar. Se encuentran "
"comúnmente en las cocinas."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Prickled Meals"
msgid "Do you have that knife now?"
msgstr "¿Tienes ese cuchillo ahora?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Prickled Meals"
msgid "I am grateful for the help you've done."
msgstr "Estoy agradecido por la ayuda que me has prestado."

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Busy While Working"
msgstr "Ocupado en el Trabajo"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Busy While Working"
msgid "Find 3 mystery novels."
msgstr "Encuentra 3 novelas de misterio."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
msgid "I'd like to read some mystery novels."
msgstr "Me gustaría leer algunas novelas de misterio."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
msgid ""
"Sometimes it gets a little bit boring up here, and I like to read something "
"to take my mind off of things.  Problem is, I've run out of books.  I've been "
"wanting to read some mystery novels as of late, so could you get me three of "
"them?"
msgstr ""
"A veces me aburro un poco aquí arriba y me gusta leer algo para distraerme. "
"El problema es que me he quedado sin libros. Últimamente me apetece leer "
"novelas de misterio, ¿podrías conseguirme tres novelas?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
msgid "Just bring them to me when you have it."
msgstr "Tráemelas cuando las tengas."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
#. ~ Dialogue line in mission "Canning Startup"
msgid "Nevermind then.  I hope you'll change your mind."
msgstr "No pasa nada. Espero que cambies de opinión."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
msgid "I'd loot libraries and bookstores."
msgstr "Yo saquearé bibliotecas y librerías."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
msgid "So, have you found the books?"
msgstr "Entonces, ¿has encontrado los libros?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
msgid ""
"Thank you.  This will keep me busy for a while.  Please take this as a token "
"of my gratitude."
msgstr ""
"Gracias. Esto me mantendrá ocupado por un tiempo. Por favor, toma esto como "
"muestra de mi gratitud."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
#. ~ Dialogue line in mission "Canning Startup"
msgid "Could you give them to me?"
msgstr "¿Podrías dármelas?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Busy While Working"
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
msgid "Fine.  I can read something else."
msgstr "Bien. Puedo leer algo más."

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Canning Startup"
msgstr "Inicio al Enlatado"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Canning Startup"
msgid "Find 100 medium tin cans to can with."
msgstr "Consigue 100 latas medianas para enlatar."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Canning Startup"
msgid "I'd like to have some cans to store food in."
msgstr "Me gustaría disponer de algunas latas para almacenar comida."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Canning Startup"
msgid ""
"Now that we have some canning pots from Helena, we can start storing "
"foodstuffs more easily around here.  Recycling our old tin cans is great and "
"all, but if we get a big influx of new foods, then we can't properly store it "
"all.  As such, if you could find about 100 more empty medium tin cans for me, "
"I'd really appreciate it."
msgstr ""
"Ahora que Helena dispone de algunas ollas para conservas, podemos empezar a "
"almacenar alimentos más fácilmente por aquí. Reciclar nuestras viejas latas "
"está muy bien, pero si tenemos una gran afluencia de nuevos alimentos, no "
"podremos almacenarlo todo adecuadamente. Por eso, si pudieras encontrarme "
"otras 100 latas medianas vacías, te lo agradecería mucho."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Canning Startup"
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid "Just bring it to me when you have it."
msgstr "Tráemelo en cuanto lo tengas."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Canning Startup"
msgid ""
"I'd look anywhere there's food waste or scrap piles.  We can wash out the "
"cans when we get them."
msgstr ""
"Yo buscaría en cualquier sitio donde haya restos de comida o montones de "
"chatarra. Cuando tengamos latas, podemos lavarlas."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Canning Startup"
msgid "So, have you found the cans?"
msgstr "Entonces, ¿has encontrado las latas?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Canning Startup"
msgid "Thank you, now we won't have to worry about running out of food in the winter."
msgstr ""
"Gracias, ahora no tendremos que preocuparnos por quedarnos sin comida en el "
"invierno."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Canning Startup"
msgid "Fine.  I'll get them myself."
msgstr "De acuerdo. Las conseguiré yo mismo."

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Find a copy of The Modern Trapper"
msgstr "Consigue una copia de El Trampero Moderno"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Find a copy of The Modern Trapper"
msgid "Find a copy of The Modern Trapper so Eddie can learn how to lay traps."
msgstr ""
"Consigue una copia de El Trampero Moderno para que Eddie aprenda a colocar "
"trampas."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
msgid "I'd like to read some trapping guides."
msgstr "Me gustaría leer algunos manuales de trampas."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
msgid ""
"Since we've got all the stuff to store away food, I figure that it's time we "
"get some more.  I've been talking it over with Russell, and I think setting "
"out animal traps is a good way to go.  The problem is, nobody here knows how "
"to do it.  I've heard that The Modern Trapper is a good place to start, so if "
"you could get me a copy, I'd really appreciate it."
msgstr ""
"Ya que tenemos todo lo necesario para almacenar comida, creo que es hora de "
"conseguir más. Lo he hablado con Russell y creo que poner trampas para "
"animales es una buena idea. El problema es que aquí nadie sabe cómo hacerlo. "
"He oído que El Trampero Moderno es un buen libro para empezar, si pudieras "
"conseguirme un ejemplar, te lo agradecería mucho."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
msgid "Too trivial for you?"
msgstr "¿Demasiado fácil para ti?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
msgid "So, have you found it?"
msgstr "Entonces, ¿has encontrado el libro?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
msgid "Thank you, me and Russell will start studying it soon."
msgstr "Gracias, Russell y yo empezaremos a estudiarlo pronto."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Find a copy of The Modern Trapper"
msgid "Where is it?"
msgstr "¿Dónde es eso?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Store Up Your Grain"
msgstr "Almacena Tu Grano"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Store Up Your Grain"
msgid "Find 5,398 pounds of sheet metal (408 units) to help Eddie build a warehouse."
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid "I'd like to have better food storage."
msgstr "Me gustaría tener un mejor almacén para la comida."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid ""
"I've been drawing up some plans to expand our food storage around here.  Now "
"that we won't starve to death anytime soon, our old crates just aren't "
"cutting it, so we're going to build a small warehouse to store everything, "
"and I've gathered a crew to build it.  We've got most of the materials "
"covered, but we don't have enough sheet metal to make the shelves.  If you "
"could get us about 5,000 pounds of the stuff, I'll pay you handsomely with "
"what we have.  How does that sound?"
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid "Alright, I'll find someone else."
msgstr "De acuerdo, encontraré a alguien más."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid "If you can find a steel mill, I'd look there."
msgstr "Si puedes encontrar una fábrica de acero, yo miraría allí."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid "Do you have the sheet metal?"
msgstr "¿Tienes las chapas?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid ""
"I can't thank you enough, here's the pay for it.  Here in a while, we'll have "
"a spot to put all of our food."
msgstr ""
"No puedo darte las gracias lo suficiente, aquí esta el pago por ello. Dentro "
"de un rato, tendremos un lugar para poner toda nuestra comida."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid "Alright, where's it all at?"
msgstr "Muy bien, ¿dónde está todo?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Store Up Your Grain"
msgid "Sorry, I had to find someone else since you didn't come through."
msgstr "Lo siento, tuve que encontrar a otra persona, ya que tú no apareciste."

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Obtain a guitar string"
msgstr "Obtén una cuerda de guitarra"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Obtain a guitar string"
msgid "Find a length of tempered steel wire to be used as a guitar string."
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Obtain a guitar string"
msgid "I need a new guitar string."
msgstr "Necesito una cuerda nueva de guitarra."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Obtain a guitar string"
msgid ""
"One of my guitar strings busted from where I smacked a zombie.  If you could "
"get me a new string, I can fix my guitar."
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Obtain a guitar string"
msgid "Thanks.  I'll give you a performance when you get back with it."
msgstr "Gracias. Te haré una actuación cuando vuelvas con ella."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Obtain a guitar string"
msgid "I guess I'll just skip that note."
msgstr "Creo que me saltaré esa nota."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Obtain a guitar string"
msgid ""
"I read that musical wire is made of tempered steel.  Music shops should have "
"some, or you could take apart a piano."
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Obtain a guitar string"
msgid "Thank you so much!  This should last for a while."
msgstr "¡Muchas gracias! Esto debería durar un tiempo."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Obtain a guitar string"
msgid "Don't worry about it, I'll do it myself."
msgstr "No te preocupes, lo haré yo mismo."

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Well Construction"
msgstr "Construcción de Pozo"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Well Construction"
msgid "Find eight pipes for Darryl Johnson."
msgstr "Consigue ocho tubos para Darryl Johnson."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Well Construction"
msgid "I need eight pipes to start construction."
msgstr "Necesito ocho tubos para empezar la construcción."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Well Construction"
msgid ""
"Now that's some enthusiasm, pal.  Ever since our water supply shut off, we've "
"been using the nearby river for most of our water needs.  Who knows how many "
"bloated corpses have decayed in that.  I want to construct a well, but I'm "
"missing some building materials - eight pipes to be exact."
msgstr ""
"Eso sí que es entusiasmo, amigo. Desde que nos cortaron el suministro de "
"agua, hemos estado usando el río cercano para la mayoría de nuestras demandas "
"de agua. Quién sabe cuántos cadáveres hinchados se han descompuesto ahí. "
"Quiero construir un pozo, pero me faltan algunos materiales de construcción: "
"ocho tuberías para ser exactos."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Well Construction"
msgid "I wish you the best, pal.  I appreciate it."
msgstr "Te deseo lo mejor, amigo. Te lo agradezco."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Well Construction"
msgid "Come back when you get a chance."
msgstr "Vuelve cuando tengas una oportunidad."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Well Construction"
msgid ""
"Try disassembling some lockers.  Just don't destroy our furniture, we'll be "
"needing it."
msgstr ""
"Intenta desmontar algunas taquillas. Pero no destruyas nuestros muebles, los "
"necesitamos."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Well Construction"
msgid "Well, do you have them?"
msgstr "Bueno, ¿ya los tienes?"

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Well Construction"
msgid "Great, I can finally start constructing this thing."
msgstr "Estupendo, por fin puedo empezar a construir esta cosa."

#: data/json/npcs/godco/godco_missions.json
#. ~ Mission name
msgid "Water Pump Construction"
msgstr "Construcción de Bomba de Agua"

#: data/json/npcs/godco/godco_missions.json
#. ~ Description of mission "Water Pump Construction"
msgid "Find a mechanical pump for Darryl Johnson."
msgstr "Encuentra una bomba mecánica para Darryl Johnson."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Water Pump Construction"
msgid "I need a mechanical pump to finish construction."
msgstr "Necesito una bomba mecánica para terminar la construcción."

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Water Pump Construction"
msgid ""
"It's less like a well, and more like a covered pit currently.  I'll need you "
"to find a mechanical pump, one that will make this <freaking> thing work."
msgstr ""

#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Water Pump Construction"
#. ~ Dialogue line in mission "Chicken Coop Construction"
msgid "Take care of yourself out there."
msgstr "Cuídate ahí fuera."

