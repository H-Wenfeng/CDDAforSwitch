msgstr[2] ""
msgstr[3] ""
msgstr[4] ""

#. ~ Description of monster "changeling bannerman"
#: data/mods/Xedra_Evolved/monsters/changeling.json
msgid ""
"A tall lithe humanoid of indeterminate gender, clad in silvery scale mail "
"and wielding archaic weapons.  Their sea-green eyes promise violence."
msgstr ""

