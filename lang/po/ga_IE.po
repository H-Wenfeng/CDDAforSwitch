#: data/mods/Xedra_Evolved/npc/talk_computers.json
msgid ""
"&You swipe the id and are rewarded with a fresh login screen and a picture "
"of someone that you're pretty sure you had to put down to get here.  There's"
" no hint about the password, though."
msgstr ""

#. ~ Response to NPC dialogue
#: data/mods/Xedra_Evolved/npc/talk_computers.json
msgid "Try hacking the computer"
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/talk_computers.json
msgid "&With a satisfying flash of the screen, you manage to log in."
msgstr ""

