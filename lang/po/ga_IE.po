"Your target's protective charm means the beguilement fails to take effect!"
msgstr ""

#. ~ Player message in false effect in EoC "EOC_LILIN_AOE_DAZE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to let out the night-cry!"
msgstr ""

#. ~ NPC message in nested effect in then statement in effect in EoC
#. "EOC_LILIN_AOE_LINE_DISEASE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You summon a wind filled with pestilence."
msgstr ""

#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_LILIN_AOE_LINE_DISEASE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to summon the miasma!"
msgstr ""

#. ~ NPC message in effect in EoC "EOC_LILIN_DISEASE_ENHANCEMENT_DAMAGE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You infuse your ruach into the plague-infected <u_name>."
msgstr ""

#. ~ NPC message in false effect in EoC "EOC_LILIN_DISEASE_ENHANCEMENT_DAMAGE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to enhance the miasma around <u_name>!"
msgstr ""

#. ~ Player message in effect in EoC "EOC_LILIN_AVOID_SLEEP"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "As a cool breeze touches your skin, you feel much more awake."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_LILIN_AVOID_SLEEP"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to spare any to alleviate your tiredness."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_LILIN_CHANGE_WEATHER_DENSE_FOG_2" in nested EOCs in effect in EoC
#. "EOC_LILIN_CHANGE_WEATHER_DENSE_FOG"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to call a fog."
msgstr ""

#. ~ Player message in effect in EoC "EOC_LILIN_SPEED_BOOST"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "The world around you slows down immensely."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_LILIN_SPEED_BOOST"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to reap the whirlwind."
msgstr ""

#. ~ NPC message in effect in EoC "EOC_LILIN_INSTANT_HEAL_2" in nested EOCs in
#. effect in EoC "EOC_LILIN_INSTANT_HEAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "Your wounded flesh knits together in moments."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_LILIN_INSTANT_HEAL_2" in
#. nested EOCs in effect in EoC "EOC_LILIN_INSTANT_HEAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to heal yourself!"
msgstr ""

#. ~ Player message in nested effect in then statement in false effect in EoC
#. "EOC_LILIN_INSTANT_HEAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You cannot heal yourself during the new moon!"
msgstr ""

