#: data/json/npcs/snippets/talk_tags.json
msgid "right on top of us!"
msgstr ""

#. ~ Snippet in category "<danger_close_distance>"
#. ~ A threat is very close: '[It's a zombie east,] right on top of us!'
#: data/json/npcs/snippets/talk_tags.json
msgid "right there!"
msgstr ""

#. ~ Snippet in category "<danger_close_distance>"
#. ~ A threat is very close: '[It's a zombie east,] right on top of us!'
#: data/json/npcs/snippets/talk_tags.json
msgid "danger close!"
msgstr ""

#. ~ Snippet in category "<danger_close_distance>"
#. ~ A threat is very close: '[It's a zombie east,] right on top of us!'
#: data/json/npcs/snippets/talk_tags.json
msgid "almost in melee range!"
msgstr ""

#. ~ Snippet in category "<danger_close_distance>"
#. ~ A threat is very close: '[It's a zombie east,] right on top of us!'
#: data/json/npcs/snippets/talk_tags.json
msgid "too close for comfort!"
