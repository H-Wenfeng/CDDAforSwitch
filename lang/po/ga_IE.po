#. ~ Description of spell "ethereal_grasp_monster ( Ethereal Grasp )"
#. ~ Description of "Scroll of Ethereal Grasp"
#: data/mods/Magiclysm/Spells/monsterspells.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"A mass of spectral hands emerge from the ground, slowing everything in "
"range.  Higher levels allow a bigger AoE, and longer effect."
msgstr ""

#. ~ Description of spell "druid_veggrasp_monster ( Vegetative Grasp Monster
#. )"
#. ~ Description of "Scroll of Vegetative Grasp"
#: data/mods/Magiclysm/Spells/monsterspells.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"This spell causes roots and vines to burst forth from the ground and grab "
"your foes, slowing them and doing a small amount of damage as they dig in."
msgstr ""

#. ~ Name of spell "spell_ravenfolk_leap"
#: data/mods/Magiclysm/Spells/mutation_spells.json
msgid "Wing Leap"
msgstr ""

#. ~ Description of spell "spell_ravenfolk_leap ( Wing Leap )"
#. ~ value of variable 'message_success' in effect in EoC "EOC_RAVENFOLK_LEAP"
#: data/mods/Magiclysm/Spells/mutation_spells.json
#: data/mods/Magiclysm/effect_on_conditions/mutation_eocs.json
