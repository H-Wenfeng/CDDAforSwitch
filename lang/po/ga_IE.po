#. ~ NPC dialogue line
#: data/json/npcs/robofac/NPC_Cranberry_Foster.json
msgid "*looks at you expectantly."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/robofac/NPC_Cranberry_Foster.json
msgid "Better be careful around here."
