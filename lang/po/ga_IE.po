msgstr ""

#. ~ Description of spell "shocking_lash ( Shocking Lash )"
#. ~ Description of "Scroll of Shocking Lash"
#: data/mods/Magiclysm/Spells/stormshaper.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"A quick burst of electricity strikes a target and possibly one other nearby."
msgstr ""

#. ~ Name of spell "lightning_bolt"
#. ~ Name of spell "sylph_call_lightning"
#: data/mods/Magiclysm/Spells/stormshaper.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
msgid "Lightning Bolt"
msgstr ""

#. ~ Description of spell "lightning_bolt ( Lightning Bolt )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid ""
"The go-to spell for many Stormshapers, this iconic spell does just what you "
"expect: shoot lightning from your fingertips.  However, this lightning is "
"more directed than most lightning, and travels in a line through most non-"
"solid targets."
msgstr ""

#. ~ Name of spell "windstrike"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Windstrike"
msgstr ""

#. ~ Description of spell "windstrike ( Windstrike )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "A powerful blast of wind slams into anything in front of your body."
msgstr ""

#. ~ Name of spell "windrun"
#. ~ Name of effect type id "enchant_windrun"
#. ~ Name of effect type id "enchant_windrun_monster"
#: data/mods/Magiclysm/Spells/stormshaper.json
#: data/mods/Magiclysm/effects/effects.json
msgid "Windrunning"
msgstr ""

#. ~ Description of spell "windrun ( Windrunning )"
#. ~ Description of "Scroll of Windrunning"
#: data/mods/Magiclysm/Spells/stormshaper.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"A magical wind pushes you forward as you move, easing your movements and "
"increasing speed."
msgstr ""

#. ~ Name of spell "storm_hammer"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Call Stormhammer"
msgstr ""

#. ~ Description of spell "storm_hammer ( Call Stormhammer )"
#. ~ Description of "Scroll of Call Stormhammer"
#: data/mods/Magiclysm/Spells/stormshaper.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Creates a crackling magical warhammer full of lightning to smite your foes "
"with, and of course, smash things to bits!"
msgstr ""

#. ~ Name of spell "storm_hammer_plus"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Enhanced Call Stormhammer"
msgstr ""

#. ~ Description of spell "storm_hammer_plus ( Enhanced Call Stormhammer )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid ""
"Creates a crackling magical warhammer full of lightning to smite your foes "
"with, and of course, smash things to bits!  Now you know this spell like the"
" back of your hand, and start to design your own version."
msgstr ""

#. ~ Name of spell "create_rune_stormshaper"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Stormshaper Rune"
msgstr ""

#. ~ Description of spell "create_rune_stormshaper ( Stormshaper Rune )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid ""
"This ritual creates a rune attuned to Stormshapers, which looks similar to "
"what you'd expect lightning in a glass pebble to look like.  You can use the"
" rune as a catalyst for recipes."
msgstr ""

#. ~ Name of spell "lightning_blast"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Lightning Blast"
msgstr ""

#. ~ Description of spell "lightning_blast ( Lightning Blast )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid ""
"You fire a small concentrated ball of lightning at the target.  The "
"electricity diffuses rapidly, so it doesn't do much damage, but you're able "
"to fire off several ones quickly."
msgstr ""

#. ~ Name of spell "lightning_storm"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgctxt "spell"
msgid "Lightning Storm"
msgstr ""

#. ~ Description of spell "lightning_storm ( Lightning Storm )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid ""
"You call the power of the sky to strike the earth.  Several lightning blasts"
" fire from your finger tips to strike the target."
msgstr ""

#. ~ Name of spell "stormshaper_ionization"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Ionization"
msgstr ""

#. ~ Description of spell "stormshaper_ionization ( Ionization )"
#. ~ Description of "Scroll of Ionization"
#: data/mods/Magiclysm/Spells/stormshaper.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"By manipulating the charge in the air, you can conjure a sharp snap of "
"lightning over a wide area.  While its destructive potential is a far cry "
"from natural lightning, the light and thunderclap produced will leave your "
"foes reeling."
msgstr ""

#. ~ Name of spell "stormshaper_wall_of_fog"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Wall of Fog"
msgstr ""

#. ~ Description of spell "stormshaper_wall_of_fog ( Wall of Fog )"
#. ~ Description of "Scroll of Wall of Fog"
#: data/mods/Magiclysm/Spells/stormshaper.json
#: data/mods/Magiclysm/items/spell_scrolls.json
msgid ""
"Draws forth a broad wall of thick fog.  While the sudden force of air "
"pressure will floor any enemies caught in it, the conjuration is otherwise "
"harmless."
msgstr ""

#. ~ Sound description of spell "thorns_zap ( Repelling Arc Aura )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "arcing electricity!"
msgstr ""

#. ~ Name of spell "stormshaper_repelling_arc"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Repelling Arc"
msgstr ""

#. ~ Description of spell "stormshaper_repelling_arc ( Repelling Arc )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid ""
"Manifests an aura of crackling electricity around you to strike attackers "
"with baleful lightning."
msgstr ""

#. ~ Name of spell "stormshaper_repelling_arc_plus"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid "Enhanced Repelling Arc"
msgstr ""

#. ~ Description of spell "stormshaper_repelling_arc_plus ( Enhanced Repelling
#. Arc )"
#: data/mods/Magiclysm/Spells/stormshaper.json
msgid ""
"Manifests an aura of crackling electricity around you to strike attackers "
"with baleful lightning.  Now you know this spell like the back of your hand,"
" and start to design your own version."
msgstr ""

#. ~ Name of spell "stormfist"
#. ~ Item name
#: data/mods/Magiclysm/Spells/stormshaper.json
#: data/mods/Magiclysm/items/ethereal_items.json
msgid "Stormfist"
msgid_plural "Stormfists"
msgstr[0] ""
msgstr[1] ""
