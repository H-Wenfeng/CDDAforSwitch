msgstr[0] "生化護目鏡"

#: data/json/items/fake.json
#. ~ Item name
msgid "autonomous surgical scalpels"
msgid_plural "autonomous surgical scalpels"
msgstr[0] "自動外科手術刀"

#: data/json/items/fake.json
#. ~ Description of "autonomous surgical scalpels"
msgid ""
"A system of surgical-grade scalpels.  They allow you to make precise cuts on "
"corpses."
msgstr "一组外科手术刀。这让你能够对尸体进行精细的解剖。"

#: data/json/items/fake.json
#. ~ Item name
msgid "bionic razor"
msgid_plural "bionic razors"
msgstr[0] "生化刀刃"

#: data/json/items/fake.json
#. ~ Item name
