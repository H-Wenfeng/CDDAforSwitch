#, c-format
msgid "The %s doesn't seem to register you as a doctor."
msgstr "%s 似乎沒有將你登錄為醫生。"

#: src/monattack.cpp:2564
#, c-format
msgid "The %s looks at its empty anesthesia kit with a dejected look."
msgstr "%s 沮喪地看著空的麻醉工具。"

#: src/monattack.cpp:2593
#, c-format
msgid "The %1$s scans %2$s and seems to detect something."
msgstr "%1$s 掃描了 %2$s，似乎檢測到某些東西。"

#: src/monattack.cpp:2605
#, c-format
msgid "The %s looks for something but doesn't seem to find it."
msgstr "%s 尋找某樣東西，但似乎沒找到。"

#: src/monattack.cpp:2620
msgid ""
"a soft robotic voice say, \"Unhand this patient immediately!  If you keep "
"interfering with the procedure I'll be forced to call law enforcement.\""
msgstr "柔和的機器人聲音說：“立即讓該患者接受治療！如果你繼續干涉該程序，我將被迫聯繫執法部門。”"

#: src/monattack.cpp:2626
msgid ""
"a soft robotic voice say, \"Greetings kinbot.  Please take good care of this "
"patient.\""
msgstr "柔和的機器人聲音說：“你好 kinbot。請照顧好這個病人。”"

#: src/monattack.cpp:2664
#, c-format
msgid ""
"The %s dumps the contents of its bag on the ground and drops the bag on top "
"of it."
msgstr "%s 把背包裡所有東西丟到地上，然後把背包放在上面。"

#: src/monattack.cpp:2710 src/monattack.cpp:2730
#, c-format
msgid "The %s flashes a LED and departs.  Human officer on scene."
msgstr "%s 閃爍LED燈接著離開。人類警官準備上場。"

#: src/monattack.cpp:2718 src/monattack.cpp:2738
#, c-format
msgid "The %s acknowledges you as an officer responding, but hangs around to watch."
msgstr "%s 將你認為是警官。並環顧在旁觀看。"

#: src/monattack.cpp:2720 src/monattack.cpp:2757
msgid "Probably some now-obsolete Internal Affairs subroutine…"
msgstr "也許是一些過時的內部例行流程…"

#: src/monattack.cpp:2740
msgid "Ops used to do that in case you needed backup…"
msgstr "隊員經常這樣做以防你需要支援…"

#: src/monattack.cpp:2748
#, c-format
msgid "The %s flashes a LED and departs.  SWAT's working the area."
msgstr "%s 閃爍LED燈接著離開。特戰警隊在這工作。"

#: src/monattack.cpp:2755
#, c-format
msgid "The %s acknowledges you as SWAT onsite, but hangs around to watch."
msgstr "%s 認為你是特戰警員，並在附近看守。"

#: src/monattack.cpp:2766
#, c-format
msgid "The %s flashes a LED and departs.  The Feds got this."
msgstr "%s 閃爍LED燈接著離開。聯邦探員接手。"

#: src/monattack.cpp:2780
#, c-format
msgid "The %s takes your picture!"
msgstr "%s 照了你的相!"

#: src/monattack.cpp:2785
msgid "a robotic voice boom, \"Citizen <male_full_name>!\""
msgstr "机器人发出低沉的声音，\"市民，<male_full_name>！\""

#: src/monattack.cpp:2787
msgid "a robotic voice boom, \"Citizen <female_full_name>!\""
msgstr "机器人发出低沉的声音，\"市民，<female_full_name>！\""

#: src/monattack.cpp:2790
#, c-format
msgid "a robotic voice boom, \"Citizen %s!\""
msgstr "一個響亮的機械語音：\"公民，%s！\""

#: src/monattack.cpp:2792
msgid "a robotic voice boom, \"Citizen… database connection lost!\""
msgstr "机器人发出低沉的声音，\"市民……无法连接数据库！\""

#: src/monattack.cpp:2797
#, c-format
msgid "\"Drop your %s!  Now!\""
msgstr "「丟掉你的 %s！立刻！」"

#: src/monattack.cpp:2798 data/json/tool_qualities.json
#. ~ Name of tool quality "GUN"
msgid "gun"
msgstr "槍械"

#: src/monattack.cpp:2798 data/json/skills.json
#. ~ Skill name
msgid "weapon"
msgstr "武器"

#: src/monattack.cpp:2852
#, c-format
msgid "The %s attempts to shock you but you dodge."
msgstr "%s嘗試電擊你，但你躲開了。"

#: src/monattack.cpp:2858 src/monattack.cpp:2866
#, c-format
msgid "The %s unsuccessfully attempts to shock you."
msgstr "%s 沒有電到你。"

#: src/monattack.cpp:2867
#, c-format
msgid "The %s unsuccessfully attempts to shock <npcname>."
msgstr "%s 無法成功電擊 <npcname>。"

#: src/monattack.cpp:2876
#, c-format
msgid "The %s shocks you!"
msgstr "%s 電擊你!"

#: src/monattack.cpp:2877
#, c-format
msgid "The %s shocks <npcname>!"
msgstr "%s 電到了 <npcname>!"

#: src/monattack.cpp:3110
msgid "a robotic voice boom, \"Citizen, Halt!\""
msgstr "一個機械語音, \"站住! 公民。\""

#: src/monattack.cpp:3113
msgid "a robotic voice boom, \"Please put down your weapon.\""
msgstr "一個機械語音, \"請放下你的武器。\""

#: src/monattack.cpp:3117
msgid "a robotic voice boom, \"Come out with your hands up!\""
msgstr "一個機械語音, \"舉起手出來。\""

#: src/monattack.cpp:3121
msgid "a police siren, whoop WHOOP"
msgstr "警用鳴笛聲, 嗚嗚嗚嗚"

#: src/monattack.cpp:3152
msgid "\"YOU… ARE FILTH…\""
msgstr "\"你… 被污染… \""

#: src/monattack.cpp:3155
msgid "\"VERMIN… YOU ARE VERMIN…\""
msgstr "\"害蟲… 你是害蟲… \""

#: src/monattack.cpp:3158
msgid "\"LEAVE NOW…\""
msgstr "\"快走開...\""

#: src/monattack.cpp:3161
msgid "\"WE… WILL FEAST… UPON YOU…\""
msgstr "\"我們… 會在你的屍體上… 慶祝… \""

#: src/monattack.cpp:3164
msgid "\"FOUL INTERLOPER…\""
msgstr "\"違法闖入者… \""

#: src/monattack.cpp:3223
#. ~ %1$s is the name of the zombie upgrading the other, %2$s is the zombie
