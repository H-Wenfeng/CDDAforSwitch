#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of chainmail sleeves"
msgid_plural "pairs of chainmail sleeves"
msgstr[0] "鏈甲袖套"

#: data/json/items/armor/arms_armor.json
#. ~ Description of "pair of chainmail sleeves"
msgid ""
"Customized chainmail arm protection.  The metal shows signs of rust and "
"corrosion.  Both sleeves have straps to connect them with each other.  They "
"don't cover the hands, making them less cumbersome and allowing them to be "
"worn with gloves."
msgstr "一对自制的锁环甲护臂，金属有生锈和腐蚀的迹象。套筒间有带子连接，无指的设计使它们不那么笨重，并留下了戴手套的空间。"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of mild steel chainmail sleeves"
msgid_plural "pairs of mild steel chainmail sleeves"
msgstr[0] "鏈甲護臂（低碳鋼）"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of medium steel chainmail sleeves"
msgid_plural "pairs of medium steel chainmail sleeves"
msgstr[0] "鏈甲護臂（中碳鋼）"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of high steel chainmail sleeves"
msgid_plural "pairs of high steel chainmail sleeves"
msgstr[0] "鏈甲護臂（高碳鋼）"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of hardened steel chainmail sleeves"
msgid_plural "pairs of hardened steel chainmail sleeves"
msgstr[0] "鏈甲護臂（表面硬化鋼）"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of tempered steel chainmail sleeves"
msgid_plural "pairs of tempered steel chainmail sleeves"
msgstr[0] "鏈甲護臂（回火鋼）"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of elbow pads"
msgid_plural "pairs of elbow pads"
msgstr[0] "護肘"

#: data/json/items/armor/arms_armor.json
#. ~ Description of "pair of elbow pads"
msgid "A pair of elbow pads made of stout plastic and cloth."
msgstr "一對由堅硬的塑膠和布製成的護肘。"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of bronze vambraces"
msgid_plural "pairs of bronze vambraces"
msgstr[0] "青銅護臂"

#: data/json/items/armor/arms_armor.json
#. ~ Description of "pair of bronze vambraces"
msgid "A pair of bronze arm guards with a simple leather lining."
msgstr "一对有着简易皮内衬的青铜护臂。"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of leather vambraces"
msgid_plural "pairs of leather vambraces"
msgstr[0] "皮革射箭護臂"

#: data/json/items/armor/arms_armor.json
#. ~ Description of "pair of leather vambraces"
msgid "A pair of light leather arm guards, made for archery."
msgstr "一對輕巧的皮革護臂，供弓箭手使用。"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of cut-resistant arm sleeves"
msgid_plural "pairs of cut-resistant arm sleeves"
msgstr[0] "防割護臂"

#: data/json/items/armor/arms_armor.json
#. ~ Description of "pair of cut-resistant arm sleeves"
msgid ""
"A long pair of cut-resistant Kevlar sleeves with thumbholes.  Useful for "
"chainsaw protection."
msgstr "一对长长的凯夫拉材质防切割护臂，袖口开了个能露出拇指的洞。用于使用链锯时的防护。"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "mild steel light arm guard"
msgid_plural "mild steel light arm guards"
msgstr[0] "輕型鋼護臂（低碳鋼）"

#: data/json/items/armor/arms_armor.json
#. ~ Description of "mild steel light arm guard"
msgid ""
"A light armguard, 1.25 mm at the thickest.  This one has been made with mild "
"steel."
msgstr "一件厚1.25毫米的轻型护臂。这件是用低碳钢做的。"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "medium steel light arm guard"
msgid_plural "medium steel light arm guards"
msgstr[0] "輕型鋼護臂（中碳鋼）"

#: data/json/items/armor/arms_armor.json
#. ~ Description of "medium steel light arm guard"
msgid ""
"A light armguard, 1.25 mm at the thickest.  Made with tougher medium steel, "
"this offers solid protection."
msgstr "一件厚1.25毫米的轻型护臂。这件是用更坚硬的中碳钢制成，提供坚固的保护。"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "high steel light arm guard"
msgid_plural "high steel light arm guards"
msgstr[0] "輕型鋼護臂（高碳鋼）"

#: data/json/items/armor/arms_armor.json
#. ~ Description of "high steel light arm guard"
