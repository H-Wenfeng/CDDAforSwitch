msgid "Fortress secure"
msgstr "堡垒安全"

#: data/mods/DinoMod/achievements/achievements.json
#. ~ Description of requirement of achievement "Fortress secure"
msgid "crossed stego mutation threshold"
msgstr "跨過劍龍突變臨界"

#: data/mods/DinoMod/achievements/achievements.json
#. ~ Name of achievement
msgid "Too dangerous to mess with"
msgstr "危险，莫惹我"

#: data/mods/DinoMod/achievements/achievements.json
#. ~ Description of requirement of achievement "Too dangerous to mess with"
msgid "crossed horns mutation threshold"
msgstr "跨過角龍突變臨界"

#: data/mods/DinoMod/achievements/statistics.json
#. ~ Description of event statistic "num_avatar_dino_kills"
msgid "dino killed"
msgid_plural "dinos killed"
msgstr[0] "杀恐龙数"

#: data/mods/DinoMod/items/biosignatures.json
#. ~ Item name
msgid "dinosaur droppings"
msgid_plural "dinosaur droppings"
msgstr[0] "恐龍屎"

#: data/mods/DinoMod/items/biosignatures.json
#. ~ Description of "dinosaur droppings"
msgid ""
"Dinosaur fecal matter; this could probably be used to make some great "
"fertilizer."
msgstr "一滩恐龙粪便，可以用来制造不错的肥料。"

#: data/mods/DinoMod/items/books.json
#. ~ Item name
msgid "Kiernan's notes"
msgid_plural "copies of Kiernan's notes"
msgstr[0] "《Kiernan 的筆記》"

#: data/mods/DinoMod/items/books.json
#. ~ Description of "Kiernan's notes"
msgid ""
"The voluminous notes of an obviously talented paleontologist, dedicated "
"biologist, and amateur author.  These notes jump from such topics as fossil "
"digs, science fiction stories, also strangely enough notes on dinosaur "
"biology and potential hybridization efforts."
msgstr "这是一本很厚的笔记，其作者是一名极具才华的古生物学者、专业的生物学家和业余作家。笔记的主题不定，包括化石发掘、科幻故事，甚至包括恐龙生物学和可能的杂交方法。"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Item name
msgid "sauropod stomach"
msgid_plural "sauropod stomachs"
msgstr[0] "蜥腳龍胃袋"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Description of "sauropod stomach"
msgid ""
"The stomach of an enormous sauropod dinosaur.  It is surprisingly durable and "
"very roomy."
msgstr "巨型蜥脚类恐龙的胃。令人意外的耐磨，而且非常宽敞。"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Item name
msgid "boiled sauropod stomach"
msgid_plural "boiled sauropod stomachs"
msgstr[0] "煮熟的蜥腳龍胃"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Description of "boiled sauropod stomach"
msgid "A boiled stomach from a sauropod, nothing else.  It looks all but appetizing."
msgstr "一个煮熟的蜥脚恐龙胃囊，看起来丝毫不能引起食欲。"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Item name
msgid "smaller dinosaur skull"
msgid_plural "smaller dinosaur skulls"
msgstr[0] "小型恐龙头骨"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Description of "smaller dinosaur skull"
msgid "The skull of a smaller plant eating dinosaur."
msgstr "一个小型食草恐龙的头骨。"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Item name
msgid "dinosaur skull"
msgid_plural "dinosaur skulls"
msgstr[0] "恐龙头骨"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Description of "dinosaur skull"
msgid "The skull of a plant eating dinosaur."
msgstr "一个食草恐龙的头骨。"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Item name
msgid "larger dinosaur skull"
msgid_plural "larger dinosaur skulls"
msgstr[0] "大型恐龙头骨"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Description of "larger dinosaur skull"
msgid "The skull of a larger plant eating dinosaur."
msgstr "一个大型食草恐龙的头骨。"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Item name
msgid "smaller dinosaur predator skull"
msgid_plural "smaller dinosaur predator skulls"
msgstr[0] "小型食肉恐龙头骨"

#: data/mods/DinoMod/items/carnivore.json
#. ~ Description of "smaller dinosaur predator skull"
msgid "A smaller dinosaur skull with sharp teeth."
msgstr "一只长着锋利的牙齿的小型食肉恐龙头骨。"

