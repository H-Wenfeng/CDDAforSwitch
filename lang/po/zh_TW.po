msgstr "他揮舞著刀!"

#: src/monattack.cpp:3289
msgid "Quiet, quiet"
msgstr "安靜, 安靜"

#: src/monattack.cpp:3317
msgid "a terrifying roar!"
msgstr "一聲可怕的吼叫!"

#: src/monattack.cpp:3328
#, c-format
msgid "The %1$s swings a massive claw at %2$s!"
msgstr "%1$s 朝著 %2$s 揮動巨大的爪子!"

#: src/monattack.cpp:3351
#. ~ 1$s is bodypart name, 2$d is damage value.
#, c-format
