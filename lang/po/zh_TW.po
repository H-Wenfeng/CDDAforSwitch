#. ~ Response to NPC dialogue
msgid "Allow robots."
msgstr "启用机器人。"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "Disable robots."
msgstr "禁用机器人。"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "Allow eldritch horrors."
msgstr "启用异界恐怖。"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "Disable eldritch horrors."
msgstr "禁用异界恐怖。"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "Allow dinosaurs."
msgstr "启用恐龙。"

