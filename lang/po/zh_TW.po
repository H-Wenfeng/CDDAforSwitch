msgstr "一对由厚重绗缝织物制成的袖子。"

#: data/json/items/armor/arms_armor.json
#. ~ Item name
msgid "pair of Kevlar gambeson sleeves"
msgid_plural "pairs of Kevlar gambeson sleeves"
msgstr[0] "克維拉軟甲袖套"

