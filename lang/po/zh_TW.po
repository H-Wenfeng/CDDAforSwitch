#. ~ Item name
msgid "oat pulp"
msgid_plural "oat pulp"
msgstr[0] "燕麦渣"

#: data/json/items/comestibles/wheat.json
#. ~ Description of "oat pulp"
msgid "Pulp left over after making oat milk.  It's gritty and incredibly bland."
msgstr "制造燕麦乳剩下的残渣。口感像沙子，而且味同嚼蜡。"

#: data/json/items/comestibles/wheat.json
#. ~ Item name
msgid "cheese grits"
msgid_plural "cheese grits"
msgstr[0] "起司玉米粥"

#: data/json/items/comestibles/wheat.json
#. ~ Description of "cheese grits"
