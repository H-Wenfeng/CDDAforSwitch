msgstr "煎過的野生蒲公英花。非常營養可口。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "cooked burdock greens"
msgid_plural "cooked burdock greens"
msgstr[0] "煮熟的牛蒡葉"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Description of "cooked burdock greens"
msgid "Cooked burdock leaves.  Tasty and nutritious."
msgstr "煮熟的牛蒡葉。美味又營養。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "fried burdocks"
msgid_plural "fried burdocks"
msgstr[0] "炸牛蒡"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Description of "fried burdocks"
msgid ""
"Wild burdocks that have been battered and deep-fried.  Very tasty and "
"nutritious."
msgstr "裹粉後油炸的野生牛蒡。非常營養可口。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "fried dandelions and burdocks"
msgid_plural "fried dandelions and burdocks"
msgstr[0] "油炸蒲公英和牛蒡"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Description of "fried dandelions and burdocks"
msgid ""
"Wild dandelions and burdocks that have been battered and deep-fried.  Very "
"tasty and nutritious."
msgstr "裹粉後油炸的野生蒲公英和牛蒡。非常營養可口。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "cooked bamboo shoots"
msgid_plural "cooked bamboo shoots"
msgstr[0] "熟竹筍"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Description of "cooked bamboo shoots"
msgid "Peeled and cooked bamboo shoots.  Tasty and nutritious."
msgstr "去皮煮熟的竹筍。美味又營養。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "fried bamboo shoots"
msgid_plural "fried bamboo shoots"
msgstr[0] "炸竹筍"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Description of "fried bamboo shoots"
msgid ""
"Raw bamboo shoots that have been peeled, battered and deep-fried.  Very tasty "
"and nutritious."
msgstr "裹粉後油炸的生竹筍。非常營養可口。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "cooked plant marrow"
msgid_plural "cooked plant marrow"
msgstr[0] "煮熟的植物組織"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Description of "cooked plant marrow"
msgid "A freshly-cooked chunk of plant matter, tasty and nutritious."
msgstr "剛煮好的植物組織，美味且營養。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "cooked wild vegetables"
msgid_plural "cooked wild vegetables"
msgstr[0] "煮熟的野菜"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Description of "cooked wild vegetables"
msgid "Cooked wild edible plants.  An interesting mix of flavors."
msgstr "由可食野菜燉煮， 具有特殊風味。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "vegetable aspic"
msgid_plural "vegetable aspic"
msgstr[0] "蔬菜凍"

