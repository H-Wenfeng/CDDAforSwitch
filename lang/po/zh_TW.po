msgstr "\"Quem é Você?（葡萄牙语：你是谁？）\""

#: data/mods/Aftershock/speech.json data/mods/aftershock_exoplanet/speech.json
#. ~ Speech from speaker afs_mon_migoturret
msgid "\"Eu vou te matar!\""
msgstr "\"Eu vou te matar!（葡萄牙语：我他妈的要杀了你！）\""

#: data/mods/Aftershock/speech.json data/mods/aftershock_exoplanet/speech.json
#. ~ Speech from speaker afs_mon_migoturret
