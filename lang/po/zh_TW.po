msgstr "這樣爬下去看起來是<color_green>完全安全</color>的。"

#: src/game.cpp:14058
msgid "It <color_green>seems safe</color> to climb down like this."
msgstr "這樣爬下去看起來是<color_green>安全</color>的。"

#: src/game.cpp:14060
msgid "It <color_yellow>seems a bit tricky</color> to climb down like this."
msgstr "這樣爬下去看起來是<color_yellow>有點難度</color>的。"

#: src/game.cpp:14062
msgid "It <color_yellow>seems somewhat risky</color> to climb down like this."
msgstr "這樣爬下去看起來是<color_yellow>有點危險</color>的。"

#: src/game.cpp:14064
msgid "It <color_red>seems very risky</color> to climb down like this."
msgstr "這樣爬下去看起來是<color_red>非常危險</color>的。"

