#. ~ Response to NPC dialogue
msgid ""
"I'm trying to put a cleanup crew together to tidy up the back room.  Can you "
"help?"
msgstr "我正在嘗試組成一個清掃隊伍一起去處理後房的問題。你能幫忙嗎？"

#: data/json/npcs/refugee_center/surface_refugees/NPC_Aleesha_Seward.json
#. ~ Response to NPC dialogue
msgid "Nice to meet you, kid.  What's up?"
msgstr "很高興認識你，孩子。怎麼了？"

#: data/json/npcs/refugee_center/surface_refugees/NPC_Aleesha_Seward.json
#. ~ Response to NPC dialogue
msgid "Hi Aleesha, nice to meet you.  <end_talking_leave>"
msgstr "嗨，阿莱莎，很高兴见到你。<end_talking_leave>"

#: data/json/npcs/refugee_center/surface_refugees/NPC_Aleesha_Seward.json
#. ~ NPC dialogue line
msgid "*doesn't quite meet your gaze as you approach.  \""
msgstr "*当你走近时，她的眼神并没有完全和你对视。\""

#: data/json/npcs/refugee_center/surface_refugees/NPC_Aleesha_Seward.json
#. ~ NPC dialogue line
msgid "Aw hey, look who's back."
msgstr "阿，嘿，看看誰回來了。"

#: data/json/npcs/refugee_center/surface_refugees/NPC_Aleesha_Seward.json
#: data/json/npcs/refugee_center/surface_refugees/NPC_Alonso_Lautrec.json
#: data/json/npcs/refugee_center/surface_refugees/NPC_Boris_Borichenko.json
