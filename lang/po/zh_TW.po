msgid "Can't learn"
msgstr "無法學習"

#: src/proficiency_ui.cpp:194
msgid "Time to learn"
msgstr "學習時間"

#: src/proficiency_ui.cpp:197
msgid "Progress"
msgstr "進度"

#: src/proficiency_ui.cpp:200 src/proficiency_ui.cpp:253
#: src/safemode_ui.cpp:207
msgid "Category"
msgstr "分類"

#: src/proficiency_ui.cpp:204
msgid "Pre-requisites"
msgstr "前置"

#: src/proficiency_ui.cpp:215
msgid "Leads to"
msgstr "解鎖"

#: src/proficiency_ui.cpp:250
msgid "FILTERED"
msgstr "已篩選"

#: src/proficiency_ui.cpp:261
msgid "filter"
msgstr "篩選"

#: src/proficiency_ui.cpp:262
msgid "help"
msgstr "幫助"

#: src/proficiency_ui.cpp:271
msgid "Proficiencies"
msgstr "專精熟練度"

#: src/proficiency_ui.cpp:376
#. ~ Refers to single-character search prefixes, like p: or s:
msgid "Available prefixes:"
