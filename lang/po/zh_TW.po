msgstr "堅固的金屬輪胎。有著適合在軌道上運行的輪緣，但一旦脫離軌道就表現不佳。"

#: data/json/vehicleparts/wheel.json
#. ~ Vehicle part name
msgid "rail wheel (steerable)"
msgstr "軌道輪（轉向輪）"

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "pair of small rail wheels"
msgid ""
