#: data/mods/Aftershock/npcs/UICA/spaceport_portmaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/spaceport_portmaster.json
#. ~ NPC dialogue line
msgid "Do you want to book passage back to the station?"
msgstr "你需要预定返回空间站的穿梭机吗？"

#: data/mods/Aftershock/npcs/UICA/spaceport_portmaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/spaceport_portmaster.json
#. ~ NPC dialogue line
msgid ""
"Excellent, the current price for a trip up is 12500 USD.  Do you wish to book "
"passage?"
msgstr "太棒了，目前返程的价格是12500美元。你想订一段吗？"

#: data/mods/Aftershock/npcs/UICA/spaceport_portmaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/spaceport_portmaster.json
#. ~ Response to NPC dialogue
msgid "I'm ready, book me in the next ship."
msgstr "我准备好了，给我订下一班穿梭机。"

#: data/mods/Aftershock/npcs/UICA/GENERIC/nc_ground_engineer.json
#: data/mods/Aftershock/npcs/UICA/GENERIC/nc_ground_soldier.json
#: data/mods/Aftershock/npcs/UICA/GENERIC/nc_naval_police.json
