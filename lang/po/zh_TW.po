#: data/json/items/armor/suits_protection.json
#. ~ Item name
msgid "hardened steel chainmail hauberk"
msgid_plural "hardened steel chainmail hauberks"
msgstr[0] "鏈甲長衣（硬化鋼）"

#: data/json/items/armor/suits_protection.json
#. ~ Item name
