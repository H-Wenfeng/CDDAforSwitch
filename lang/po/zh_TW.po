#: data/json/snippets/harvest_drop_msgs.json
#. ~ Snippet in category "harvest_drop_mutagen_field_dress"
msgid "You notice some strange organs, perhaps harvestable via careful dissection."
msgstr "你注意到一些可疑的器官，仔細的解剖可能會有收穫。"

#: data/json/snippets/harvest_drop_msgs.json
#. ~ Snippet in category "harvest_drop_bionic_field_dress"
