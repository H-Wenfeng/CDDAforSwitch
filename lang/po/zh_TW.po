msgstr "加上蔬菜的燉豆。好吃又有飽足感。"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Item name
msgid "dried rice"
msgid_plural "dried rice"
msgstr[0] "生米"

#: data/json/items/comestibles/veggy_dishes.json
#. ~ Description of "dried rice"
