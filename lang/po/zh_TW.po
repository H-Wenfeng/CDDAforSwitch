msgid "This pair has square lenses."
msgstr "这副眼镜采用方式镜框。"

#: data/json/items/armor/eyewear.json
#. ~ Variant name of item "pair of bifocal glasses"
msgid "pair of aviator bifocal glasses"
msgid_plural "pairs of aviator bifocal glasses"
msgstr[0] "飞行员双光眼镜"

#: data/json/items/armor/eyewear.json
#. ~ Description of variant "pair of aviator bifocal glasses" of item "pair of
