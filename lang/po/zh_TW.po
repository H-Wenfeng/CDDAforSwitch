#: src/options.cpp:2391
msgid "Map font size"
msgstr "地圖字體大小"

#: src/options.cpp:2392
msgid "Set the map font size.  Requires restart."
msgstr "設定地圖字體大小。需要重啟遊戲。"

#: src/options.cpp:2396
