#. ~ "msg" action message of item "fedora"
#. ~ "msg" action message of item "straw fedora"
#, c-format
msgid "You tip your %s."
msgstr "你輕拍 %s。"

#: data/json/items/tool_armor.json
#. ~ Item name
msgid "pair of thermal electric socks"
msgid_plural "pairs of thermal electric socks"
msgstr[0] "電熱襪"

#: data/json/items/tool_armor.json
#. ~ Description of "pair of thermal electric socks"
msgid ""
"A pair of socks with internal battery-powered heating elements.  Use it to "
"turn it on."
msgstr "一雙配備內部電池供電加熱元件的襪子。使用它來啟動加熱元件。"

