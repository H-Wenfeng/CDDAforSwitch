#. ~ Description of variant "pair of round reading sunglasses" of item "pair
#. of reading sunglasses"
msgid "This pair has rounded lenses."
msgstr "这副眼镜采用圆式镜框。"

#: data/json/items/armor/eyewear.json
#. ~ Variant name of item "pair of bifocal glasses"
msgid "pair of square bifocal glasses"
msgid_plural "pairs of square bifocal glasses"
msgstr[0] "方框双光眼镜"

#: data/json/items/armor/eyewear.json
#. ~ Description of variant "pair of square bifocal glasses" of item "pair of
