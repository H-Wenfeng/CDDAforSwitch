#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Item name
msgid "Scroll of Weighting"
msgid_plural "Scrolls of Weighting"
msgstr[0] "沉重打击卷轴"

#: data/mods/Magiclysm/items/spell_scrolls.json
