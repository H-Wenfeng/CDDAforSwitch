#: data/json/items/classes/magazine.json
#: data/mods/Generic_Guns/magazines/rifle.json
#. ~ Item name
#. ~ Magazine name
msgid "ammo belt"
msgid_plural "ammo belts"
msgstr[0] "彈鏈"

#: data/json/items/classes/magazine.json
#. ~ Description of magazine "ammo belt"
#. ~ Description of "ammo belt"
msgid "An ammo belt consisting of metal linkages which disintegrate upon firing."
msgstr "一條彈鏈。子彈間有著金屬鏈結， 會在發射後解體。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Mycus wine"
msgid_plural "Mycus wine"
msgstr[0] "馬庫斯酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Mycus wine"
msgid "Goopy white wine, made of the Mycus fruit."
msgstr "滑膩的白酒，用馬庫斯果製成。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Marloss wine"
msgid_plural "Marloss wine"
msgstr[0] "馬洛斯酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Marloss wine"
msgid "A viscous, soft pink wine, made from the fruit of the Marloss."
msgstr "黏稠的粉紅色酒，用馬洛斯的果實製成。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Riesling"
msgid_plural "Riesling"
msgstr[0] "雷司令葡萄酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Riesling"
msgid "Sparkling white wine, made from the world's noblest grape."
msgstr "精選高級葡萄釀製， 德國美味佳釀的代表。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Chardonnay"
msgid_plural "Chardonnay"
msgstr[0] "霞多麗葡萄酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Chardonnay"
msgid "America's most popular wine, and for good reason."
msgstr "美國最大眾化的葡萄酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Cabernet Sauvignon"
msgid_plural "Cabernet Sauvignon"
msgstr[0] "卡本內蘇維濃葡萄酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Cabernet Sauvignon"
msgid "The heavily disputed king of red wines.  Pairs well with red meats and pasta."
msgstr "別名葡萄酒之王， 適合紅肉與義大利麵。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Pinot noir"
msgid_plural "Pinot noir"
msgstr[0] "黑比諾葡萄酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Pinot noir"
msgid ""
"Prized by collectors and adored by critics, this is one of the rarer and more "
"elegant wines."
msgstr "行家的珍藏與美食者的推崇，使它成為當代最稀少與獨特的葡萄酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "marsala"
msgid_plural "marsala"
msgstr[0] "瑪薩拉酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "marsala"
msgid "A wine popularly used in dishes served in Italian restaurants."
msgstr "普遍在義大利餐廳供應的葡萄酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "vermouth"
msgid_plural "vermouth"
msgstr[0] "苦艾酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "vermouth"
msgid ""
"A soft wine with a pleasant herbal flavor and aroma.  It is a common cocktail "
"ingredient, and can be used as a substitute for white wine."
msgstr "柔和的葡萄酒，具有令人愉悅的草藥氣味和芳香。它是一種常見的雞尾酒成分，可用作白葡萄酒的替代品。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "barley wine"
msgid_plural "barley wine"
msgstr[0] "大麥酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "barley wine"
msgid ""
"Despite the name, this is technically a strong beer and not wine, but there's "
"no need to be pedantic about it."
msgstr "尽管被称作wine，但严格意义上来说，这是一种烈性啤酒而不是葡萄酒，但没有必要对它吹毛求疵。"

#: data/json/items/comestibles/alcohol.json
#: data/mods/Magiclysm/items/comestibles.json
#. ~ Item name
msgid "whiskey"
msgid_plural "whiskey"
msgstr[0] "威士忌"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "whiskey"
msgid "A distilled grain alcohol, made from, by, and for real Southern colonels!"
msgstr "一種蒸餾的穀物酒精，由真正的南方上校專屬製造！"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "vodka"
msgid_plural "vodka"
msgstr[0] "伏特加"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "vodka"
msgid ""
"A beverage of alcohol, water, and not much else.  In America, men make vodka, "
"but in Soviet Russia, vodka makes the man."
msgstr "一種酒類，除了酒精跟水以外，就沒什麼加入其它東西。在美國人們製作伏特加，來到了俄羅斯，伏特加製造男人。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "gin"
msgid_plural "gin"
msgstr[0] "琴酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "gin"
msgid ""
"An alcoholic beverage flavored with juniper berries.  It smells faintly of "
"berries, but mostly booze."
msgstr "一種用杜松子調味的酒。 它聞起來有點漿果味，但大多是酒味。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "rum"
msgid_plural "rum"
msgstr[0] "蘭姆酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "rum"
msgid ""
"A distilled alcoholic beverage made from fermenting molasses.  Drinking it "
"might make you feel like a pirate.  Or not."
msgstr "由發酵糖蜜製成的蒸餾酒。 喝下去會讓你覺得自己是海盜。也許吧。 "

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "tequila"
msgid_plural "tequila"
msgstr[0] "龍舌蘭"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "tequila"
msgid ""
"A distilled alcoholic beverage made from a succulent plant with spiky leaves. "
" Don't eat the worm!  Wait, there's no worm in this bottle."
msgstr "一種蒸餾酒，由帶有尖葉子的多肉植物製成。 不要吃那條蟲！ 等等，這瓶子裡沒有蟲子。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "triple sec"
msgid_plural "triple sec"
msgstr[0] "橙皮酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "triple sec"
msgid "An orange-flavored liquor used in many mixed drinks."
msgstr "一款在許多調酒中用到的柳橙風味酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "sake"
msgid_plural "sake"
msgstr[0] "清酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "sake"
msgid ""
"A Japanese alcoholic beverage made by fermenting rice with the use of yeast "
"and koji mold.  This one is mostly clear, as it has been filtered."
msgstr "一种用酵母和曲霉菌大米发酵制成日本酒。这份十分清澈，因为已经经过了过滤。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "nigori sake"
msgid_plural "nigori sake"
msgstr[0] "濁酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "nigori sake"
msgid ""
"A Japanese alcoholic beverage made by fermenting rice with the use of yeast "
"and koji mold.  This one has a cloudy white color because of fine rice "
"particles in it, as it has not been filtered."
msgstr "一种用酵母和曲霉菌大米发酵制成日本酒。这份由于未经过滤，其中含有细小的大米颗粒，因此呈浑浊的白色。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "cheap wine"
msgid_plural "cheap wine"
msgstr[0] "廉價紅酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "cheap wine"
msgid "Really cheap fortified wine."
msgstr "廉價釀造酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "strong mixed alcohol"
msgid_plural "strong mixed alcohol"
msgstr[0] "高濃度混合酒精"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "strong mixed alcohol"
msgid "Strong alcoholic drinks, mixed with no regard for taste."
msgstr "混過的烈酒， 味道亂七八糟。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "weak mixed alcohol"
msgid_plural "weak mixed alcohol"
msgstr[0] "低濃度混合酒精"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "weak mixed alcohol"
msgid "Weak alcoholic drinks, mixed with no regard for taste."
msgstr "混過的酒精飲料， 味道亂七八糟。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "fruit wine"
msgid_plural "fruit wine"
msgstr[0] "水果酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "fruit wine"
msgid "Cheap booze made from fermented fruit juice.  Tastes as good as it sounds."
msgstr "由发酵果汁制成的廉价酒。味道和听起来一样好。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "brandy"
msgid_plural "brandy"
msgstr[0] "白蘭地"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "brandy"
msgid ""
"Wine that has been distilled to a higher proof.  Great as an after-dinner "
"drink, but packs a punch."
msgstr "被蒸餾到高酒精的果酒。是非常好的餐後酒， 不過後勁十足。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Queen Mary cocktail"
msgid_plural "Queen Mary cocktail"
msgstr[0] "女王瑪麗雞尾酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Queen Mary cocktail"
msgid "A cocktail made by mixing beer and grenadine syrup.  It's quite sweet."
msgstr "一款由啤酒和石榴糖浆混合而成的鸡尾酒。它很甜。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Irish coffee"
msgid_plural "Irish coffee"
msgstr[0] "愛爾蘭咖啡"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Irish coffee"
msgid ""
"Sweetened coffee and whiskey topped with milk.  Start your day the closeted "
"alcoholic way!"
msgstr "加糖的咖啡、威士忌加上牛奶。用酒來開始這一天！"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "karsk"
msgid_plural "karsk"
msgstr[0] "卡斯克"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "karsk"
msgid ""
"A cocktail made by mixing coffee and pure alcohol, typically moonshine, "
"originating from Scandinavia.  Sometimes sugar is also added."
msgstr "一种由咖啡和纯酒精混合而成的鸡尾酒，通常是用来自斯堪的纳维亚半岛的私酿威士忌。有时还会加点糖。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "gunfire cocktail"
msgid_plural "gunfire cocktail"
msgstr[0] "槍火雞尾酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "gunfire cocktail"
msgid ""
"A cocktail made by mixing black tea and rum, which has its origins in the "
"British Army."
msgstr "一种由红茶和朗姆酒混合而成的鸡尾酒，最初起源于英国陆军。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Long Island iced tea"
msgid_plural "Long Island iced tea"
msgstr[0] "長島冰茶"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Long Island iced tea"
msgid ""
"A blend of incredibly strong-flavored liquors that somehow tastes like none "
"of them.  It contains no tea, but the inclusion of cola gives it a tea-like "
"color."
msgstr "一種融合許多烈酒的神奇調酒，但喝起來又沒酒味。 它不含茶，但含有可樂使其呈現茶色。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "screwdriver cocktail"
msgid_plural "screwdriver cocktail"
msgstr[0] "螺絲起子雞尾酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "screwdriver cocktail"
msgid ""
"A mix of orange juice and vodka.  It's the surreptitious drunkard mechanic's "
"drink of choice.  A similar drink may be made by substituting cranberry juice "
"for orange juice."
msgstr "一种使用橙汁和伏特加混合而成的鸡尾酒。这是那些偷偷摸摸的酒鬼工程师们的首选饮品。用蔓越莓汁代替橙汁也可以制成类似饮品。"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "screwdriver cocktail" when COMPONENT_ID matches
#. cranberry_juice
msgid "vodka cranberry"
msgid_plural "vodka cranberry"
msgstr[0] "蔓越莓伏特加"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "wild apple"
msgid_plural "wild apple"
msgstr[0] "狂野蘋果酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "wild apple"
msgid "Like apple cider, only with vodka."
msgstr "作法類似蘋果西打， 只是加入了伏特加酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "rum & cola"
msgid_plural "rum & cola"
msgstr[0] "蘭姆可樂"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "rum & cola"
msgid ""
"Suitable for tropical retreats and Canadian artists alike.  In certain "
"variants, whiskey or sake is substituted for rum."
msgstr "适合热带度假胜地和加拿大艺术家。在某些变体中，可以用威士忌或清酒代替朗姆酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "rum & cola" when COMPONENT_ID_SUBSTRING matches
#. whiskey
msgid "whiskey and cola"
msgid_plural "whiskey and cola"
msgstr[0] "可乐威士忌"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "rum & cola" when COMPONENT_ID matches sake_filtered
msgid "sake and cola"
msgid_plural "sake and cola"
msgstr[0] "可乐清酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "grog"
msgid_plural "grog"
msgstr[0] "蛋酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "grog"
msgid ""
"An early 17th century drink eventually popularized by sailors as a easy "
"ration that contained alcohol and often a dash of sugar.  Though it barely "
"contains any alcohol, it's probably better tasting than water, probably."
msgstr "一种17世纪早期的饮料，最终被水手们作为一种含有酒精和少量糖的简单配给品而推广开来。尽管它几乎不包含任何酒精,可能它可能比水更好的品尝。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "gin and tonic"
msgid_plural "gin and tonic"
msgstr[0] "琴通寧"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "gin and tonic"
msgid ""
"A mixed alcoholic drink consisting of gin and tonic water, created in the "
"19th century as a way to make tonic water (a malaria prophylactic) more "
"palatable, but still popular to this day.  In certain variants, vodka is "
"substituted for gin."
msgstr "一种由杜松子酒和汤力水调成的混合酒精饮料，始于19世纪，作为一种使汤力水（一种疟疾预防剂）更可口的方法，但至今仍很流行。在某些变体中，伏特加取代了杜松子酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "gin and tonic" when COMPONENT_ID matches vodka
msgid "vodka and tonic"
msgid_plural "vodka and tonic"
msgstr[0] "伏特加汤力"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "pina colada"
msgid_plural "pina colada"
msgstr[0] "鳳梨可樂達"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "pina colada"
msgid ""
"A cocktail consisting of pineapple juice, coconut milk, and rum, originating "
"in Puerto Rico.  In certain variants, vodka, whiskey, or tequila are "
"substituted for rum."
msgstr "一种由菠萝汁、椰汁和朗姆酒调制成的鸡尾酒，源自波多黎各，又称椰林飘香鸡尾酒。在某些变体中，伏特加、威士忌或龙舌兰酒取代了朗姆酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "pina colada" when COMPONENT_ID_SUBSTRING matches
#. whiskey
msgid "Scotsman colada"
msgid_plural "Scotsman colada"
msgstr[0] "蘇格蘭可樂達"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "pina colada" when COMPONENT_ID matches vodka
msgid "chi chi"
msgid_plural "chi chi"
msgstr[0] "奇奇"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "pina colada" when COMPONENT_ID matches tequila
msgid "tequila colada"
msgid_plural "tequila colada"
msgstr[0] "龍舌蘭可樂"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "tequila sunrise"
msgid_plural "tequila sunrise"
msgstr[0] "龍舌蘭日出"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "tequila sunrise"
msgid ""
"A cocktail consisting of tequila, orange juice, and grenadine syrup, "
"originating from California.  In certain variants, vodka or rum may be "
"substituted for tequila, and pineapple juice may be substituted for orange "
"juice."
msgstr "一种由龙舌兰、橙汁和石榴糖浆调制成的鸡尾酒，源自加利福尼亚州。在某些变体中，伏特加或朗姆酒取代了龙舌兰酒，菠萝汁取代了橙汁。"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "tequila sunrise" when COMPONENT_ID matches vodka
msgid "vodka sunrise"
msgid_plural "vodka sunrise"
msgstr[0] "伏特加日出"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "tequila sunrise" when COMPONENT_ID matches rum
msgid "Caribbean sunrise"
msgid_plural "Caribbean sunrise"
msgstr[0] "加勒比日出"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "tequila sunrise" when COMPONENT_ID matches
#. pineapple_juice
msgid "Panama sunrise"
msgid_plural "Panama sunrise"
msgstr[0] "巴拿馬日出"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "beer"
msgid_plural "beer"
msgstr[0] "啤酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "beer"
msgid ""
"A generic-brand grain alcohol flavored with hops.  It's best served cold, in "
"a glass, and with a lime - but you're not that lucky."
msgstr "一种使用啤酒花调味的无品牌谷物酒。最好是冰过，装在玻璃杯里，配上些柠檬——但你可没那么幸运吧。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "hops spiced mead"
msgid_plural "hops spiced mead"
msgstr[0] "啤酒花香蜜酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "hops spiced mead"
msgid "Well-aged honey wine, spiced with a hint of hops.  Goes down bittersweet."
msgstr "陳年蜜酒， 加入了少許啤酒花和香料。喝起來苦甜參半。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "hopped mead"
msgid_plural "hopped mead"
msgstr[0] "啤酒花蜜酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "hopped mead"
msgid "Homebrewed honey wine, spiced with a bit of hops.  Goes down bittersweet."
msgstr "自制蜂蜜酒，加入啤酒花调味，入口苦后回甘。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "plain mead"
msgid_plural "plain mead"
msgstr[0] "蜂蜜酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "plain mead"
msgid "Homebrewed honey wine, a smooth and silky golden beverage."
msgstr "自制蜂蜜酒，一种入口柔滑的金色饮料。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "spiced mead"
msgid_plural "spiced mead"
msgstr[0] "香料蜜酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "spiced mead"
msgid "Homebrewed spiced honey wine, a tasty beverage that can be served hot or cold."
msgstr "自酿香蜜酒，一种冷热皆宜的美味饮料。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "dandelion wine"
msgid_plural "dandelion wine"
msgstr[0] "蒲公英酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "dandelion wine"
msgid ""
"A light and delicious wine made from dandelion flowers.  Slightly "
"effervescent, it is smooth and crisp."
msgstr "一種清淡可口的酒， 由蒲公英花製成。它有些微氣泡， 新鮮順口。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "burdock wine"
msgid_plural "burdock wine"
msgstr[0] "牛蒡酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "burdock wine"
msgid "A light and delicious wine made from burdock roots.  Somewhat sweet."
msgstr "一種清淡可口的酒, 由牛蒡根製成。口味偏甜。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "pine wine"
msgid_plural "pine wine"
msgstr[0] "松脂酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "pine wine"
msgid ""
"A potent wine flavored with pine resin.  Bold and pungent, its biting taste "
"and strong aroma takes some getting used to."
msgstr "一種有強烈松脂風味的酒。激烈又潑辣， 它那辛辣的口感和濃郁的香氣必須一些時間來適應。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "homebrew beer"
msgid_plural "homebrew beer"
msgstr[0] "私釀啤酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "homebrew beer"
msgid "Not the finest drink you've had, but hey, it's alcohol by the gallon."
msgstr "你手上沒有比這更好的飲料了， 不過嘛， 嘿， 裡面酒精是以加侖為單位的。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "moonshine"
msgid_plural "moonshine"
msgstr[0] "私釀烈酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "moonshine"
msgid ""
"Only the strongest, purest, good ol' fashioned hooch, distilled from corn (or "
"pumpkin) and sugar.  Guaranteed to make you forget about the whole Cataclysm "
"thing, or you get your vision back."
msgstr "一种经过蒸馏的使用玉米（或者南瓜）和糖酿成的高度酒，最强、最纯、最好的老式烈酒！保证让你忘掉这一切关于灾难的事情，或给你些梦一般的幻象。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "European pilsner"
msgid_plural "European pilsner"
msgstr[0] "皮爾森啤酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "European pilsner"
msgid ""
"A lager beer imported from Europe.  Best served cold, in a glass - but you're "
"not that lucky."
msgstr "從歐洲進口的拉格啤酒。最好冰鎮後倒在玻璃杯 -但你沒那麼幸運。 "

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "American pale ale"
msgid_plural "American pale ale"
msgstr[0] "美國淡啤酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "American pale ale"
msgid ""
"A tasty domestic craft beer.  Best served cold, in a glass - but you're not "
"that lucky."
msgstr "一份美味的本地精酿啤酒。最好是冰过，装在玻璃杯里——但你可没那么幸运吧。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "India pale ale"
msgid_plural "India pale ale"
msgstr[0] "印度淡啤酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "India pale ale"
msgid ""
"A very flavorful microbrewed beer.  Best served cold, in a glass - but you're "
"not that lucky."
msgstr "非常可口的少量釀造啤酒。最好冰鎮後倒在玻璃杯… 但你沒那麼幸運。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "stout"
msgid_plural "stout"
msgstr[0] "司陶特啤酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "stout"
msgid "A tasty craft beer, as dark in color as the days ahead."
msgstr "可口的手工啤酒， 黑的程度跟烏日一樣黑。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Belgian ale"
msgid_plural "Belgian ale"
msgstr[0] "比利時啤酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Belgian ale"
msgid ""
"A flavorful and filling beer brewed by monks in Belgium.  Best served in a "
"goblet."
msgstr "比利時僧侶釀造的一種香醇又飽足的啤酒。最好用高腳杯喝。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "imperial stout"
msgid_plural "imperial stout"
msgstr[0] "帝國司陶特啤酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "imperial stout"
msgid ""
"A very flavorful beer that has been aged in bourbon barrels.  It is as black "
"as midnight on a moonless night and has the viscosity of oil.  While very "
"tasty, it also has an alcohol content on par with wine."
msgstr "一种已经在木桶中存放了很长时间的美味啤酒，它就像无月的午夜一样黑暗，像石油一样粘稠。虽然很美味，但是酒精含量却和葡萄酒相当。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "strawberry surprise"
msgid_plural "strawberry surprise"
msgstr[0] "草莓驚奇"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "strawberry surprise"
msgid ""
"Strawberries left to ferment with a few other choice ingredients offer up a "
"surprisingly palatable mixture; you barely even have to force yourself to "
"drink it after the first few gulps."
msgstr "發酵過的草莓混合許多種配料合成的驚奇口感雞尾酒。你根本不用強迫自己就能自然的喝光光。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "boozeberry"
msgid_plural "boozeberry"
msgstr[0] "野黑莓酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "boozeberry"
msgid ""
"This fermented blueberry mixture is surprisingly hearty, though the soup-like "
"consistency is slightly unsettling no matter how much you drink."
msgstr "這個發酵的藍莓混合物意外的營養豐富， 儘管它如湯一般的濃稠度， 讓你不管喝多少都覺得有點不安。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "single malt whiskey"
msgid_plural "single malt whiskey"
msgstr[0] "單一麥芽威士忌"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "single malt whiskey"
msgid "Only the finest whiskey straight from the bung."
msgstr "瓶蓋之內全是最優等的威士忌。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "single pot still Irish whiskey"
msgid_plural "single pot still Irish whiskey"
msgstr[0] "愛爾蘭威士忌"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "single pot still Irish whiskey"
msgid "A whiskey made from a mixed mash of malted and unmalted barley."
msgstr "由搗碎的發芽和未發芽大麥所製成的威士忌。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "cheap whiskey"
msgid_plural "cheap whiskey"
msgstr[0] "便宜威士忌"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "cheap whiskey"
msgid "Really cheap blended whiskey."
msgstr "廉價混和威士忌。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Canadian whiskey"
msgid_plural "Canadian whiskey"
msgstr[0] "加拿大威士忌"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Canadian whiskey"
msgid "A multi-grain liquor made from a mash of corn and rye."
msgstr "由搗碎的玉米和黑麥所製成的雜糧酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "sherry"
msgid_plural "sherry"
msgstr[0] "雪莉酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "sherry"
msgid "East India Solera.  A true drink of a British gentleman.  Sherry, Niles?"
msgstr "東印度Solera。一款真英國紳士的飲品。Sherry, Niles?"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Bristol Cream"
msgid_plural "Bristol Cream"
msgstr[0] "Bristol Cream 雪莉酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Bristol Cream"
msgid ""
"A fine sherry that has been aged in American oak casks and bottled in "
"Bristol, England."
msgstr "在美國橡木桶陳釀的上好雪莉酒，在英國布里斯托爾裝瓶。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Madeira wine"
msgid_plural "Madeira wine"
msgstr[0] "馬德拉酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Madeira wine"
msgid "Fortified wine from Madeira.  A true Royal Navy drink."
msgstr "馬德拉生產的烈性葡萄酒。真正皇家海軍的飲品。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "fancy hobo"
msgid_plural "fancy hobo"
msgstr[0] "花式街友"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "fancy hobo"
msgid "This definitely tastes like a hobo drink."
msgstr "這味道無疑像一個街友的飲料。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "kalimotxo"
msgid_plural "kalimotxo"
msgstr[0] "紅酒可樂"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "kalimotxo"
msgid ""
"A mix of equal parts wine and cola, originating in Spain in the 1920s.  "
"Tastes better than it sounds."
msgstr "等量葡萄酒与可乐的混合物，起源于1920年代的西班牙。尝起来比听起来要好。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "bee's knees"
msgid_plural "bee's knees"
msgstr[0] "蜜蜂膝蓋"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "bee's knees"
msgid ""
"This cocktail dates from the Prohibition era.  Gin, honey and lemon in a "
"delightful mix."
msgstr "這種雞尾酒可以追溯到禁酒令時代。琴酒、蜂蜜及檸檬汁組成令人愉悅的組合。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "whiskey sour"
msgid_plural "whiskey sour"
msgstr[0] "威士忌酸酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "whiskey sour"
msgid ""
"A mixed drink made of whiskey and lemon juice, with sugar added.  In certain "
"variants, gin is substituted for whiskey."
msgstr "一种使用威士忌和柠檬汁混合调成的鸡尾酒，加了些糖。在某些变体中，可以用杜松子酒代替威士忌。"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "whiskey sour" when COMPONENT_ID matches gin
msgid "gin sour"
msgid_plural "gin sour"
msgstr[0] "杜松子酸酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "honeygold brew"
msgid_plural "honeygold brew"
msgstr[0] "黃金蜂蜜酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "honeygold brew"
msgid ""
"A mixed drink combining bee and ant honey.  It tastes great, and it's a good "
"source of nourishment."
msgstr "一种混合了蜂蜜和蚂蚁蜜的饮料。味道很棒，同时也是很好的营养来源。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "honey ball"
msgid_plural "honey balls"
msgstr[0] "蜜球"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "honey ball"
msgid ""
"Droplet-shaped ant food.  It's like a thick balloon the size of a baseball, "
"filled with sticky liquid.  Unlike bee honey, this has mostly a sour taste, "
"probably because ants feed upon a variety of things."
msgstr "水滴状的蚂蚁食物。看起来像是像是个棒球大小的气球，装满了粘稠的液体。和蜂蜜不同，这玩意是酸的，也许是因为蚂蚁的食谱要宽得多。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "spiked eggnog"
msgid_plural "spiked eggnog"
msgstr[0] "蛋奶酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "spiked eggnog"
msgid ""
"Smooth and rich, this spoon-coating mixture of milk, cream, eggs, and booze "
"is a popular traditional holiday drink.  Having been fortified with alcohol, "
"it will keep for a long time."
msgstr "順滑而濃厚， 這杯由牛奶、奶油和蛋混合而成的濃稠飲品是流行的傳統節日飲料。額外加入了酒精， 能夠長期保存。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "martini"
msgid_plural "martini"
msgstr[0] "馬丁尼"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "martini"
msgid ""
"A popular cocktail made with gin and dry vermouth, dating from the "
"Prohibition era.  In certain variants, vodka or tequila is substituted for "
"gin."
msgstr "一种十分流行的鸡尾酒，由杜松子酒和干苦艾酒调制而成，可以追溯至美国的禁酒令时代。在某些变体中，伏特加或龙舌兰酒取代了杜松子酒。"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "martini" when COMPONENT_ID matches tequila
msgid "tequini"
msgid_plural "tequini"
msgstr[0] "特其历"

#: data/json/items/comestibles/alcohol.json
#. ~ Conditional name for "martini" when COMPONENT_ID matches vodka
msgid "vodka martini"
msgid_plural "vodka martini"
msgstr[0] "伏特加马提尼"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "Bloody Mary cocktail"
msgid_plural "Bloody Mary cocktail"
msgstr[0] "血腥瑪麗雞尾酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "Bloody Mary cocktail"
msgid ""
"Tomato juice mixed with vodka and some spices.  A hangover cure of choice for "
"many."
msgstr "番茄汁加伏特加和一些香料混合而成，是许多人宿醉疗法的首选。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "'very' Bloody Mary cocktail"
msgid_plural "'very' Bloody Mary cocktail"
msgstr[0] "「血」腥瑪麗雞尾酒"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "'very' Bloody Mary cocktail"
msgid "This is definitely not tomato juice."
msgstr "这绝对不是番茄汁。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "hard seltzer"
msgid_plural "hard seltzer"
msgstr[0] "硬蘇打水"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "hard seltzer"
msgid ""
"Alcoholic sparkling water infused with delicious fruit.  Perfect for a hot "
"summer day."
msgstr "加入美味水果的含酒精氣泡水。炎炎夏日的首選。"

#: data/json/items/comestibles/alcohol.json
#. ~ Item name
msgid "homebrew hard seltzer"
msgid_plural "homebrew hard seltzer"
msgstr[0] "私釀硬蘇打水"

#: data/json/items/comestibles/alcohol.json
#. ~ Description of "homebrew hard seltzer"
msgid ""
"Alcoholic sparkling water infused with delicious fruit.  Perfect for a hot "
"summer day.  Tastes nearly as good as the one in the market."
msgstr "加入美味水果的含酒精氣泡水。炎炎夏日的首選。嘗起來和外面賣得差不多好。"

#: data/json/items/comestibles/baked.json
#. ~ Item name
msgid "pumpkin muffin"
msgid_plural "pumpkin muffins"
msgstr[0] "南瓜瑪芬"

#: data/json/items/comestibles/baked.json
#. ~ Description of "pumpkin muffin"
msgid "A baked pumpkin-apple muffin.  Perfect for a fall feast."
msgstr "南瓜和苹果制成的烤松饼，秋季盛宴的完美餐点。"

#: data/json/items/comestibles/baked.json
#. ~ Item name
msgid "hazelnut cake"
msgid_plural "hazelnut cakes"
msgstr[0] "榛子蛋糕"

#: data/json/items/comestibles/baked.json
#. ~ Description of "hazelnut cake"
msgid ""
"This traditional hazelnut cake (or Bagȣnizabȣnak cake in Abenaki) is a nice, "
"protein-rich treat for cold days."
msgstr "这种传统的榛子蛋糕（或阿本拿基语中的Bagȣnizabȣnak蛋糕）是寒冷日子里一种富含蛋白质的美味食物食物。"

#: data/json/items/comestibles/baked.json
#. ~ Item name
msgid "baklava"
msgid_plural "baklavas"
msgstr[0] "土耳其果仁千层酥"

#: data/json/items/comestibles/baked.json
#. ~ Description of "baklava"
msgid ""
"A layered pastry dessert made of filo pastry, filled with chopped nuts, and "
"sweetened with syrup or honey."
msgstr "一种分层的糕点，由菲洛酥皮制成，内含切碎的坚果，用糖浆或蜂蜜增甜。"

#: data/json/items/comestibles/baked.json
#. ~ Item name
msgid "religieuse au chocolat"
msgid_plural "religieuse au chocolats"
msgstr[0] "巧克力修女泡芙"

#: data/json/items/comestibles/baked.json
#. ~ Description of "religieuse au chocolat"
msgid ""
"A a French pastry made of a small choux pastry case stacked on top of a "
"larger one, both filled with crème pâtissière, flavored with chocolate.  Each "
"case is topped with a ganache of chocolate, then attached to each other using "
"piped buttercream icing.  Named the religieuse because when made properly, "
"the pastries look like nuns in habits."
msgstr ""
"一款法式糕点，它由一大一小两个泡芙堆叠而成，两者里边都填满了巧克力风味的卡仕达酱。每个泡芙顶部都覆盖着巧克力甘纳许（一种奶油） "
"，然后用裱花的黄油奶油糖霜将它们粘在一起。之所以取名为“religieuse”（意为“修女”），是因为如果制作得当，这款点心看起来就像穿着传统服饰的修女。"

#: data/json/items/comestibles/baked.json
#. ~ Item name
msgid "gateau st. honore"
msgid_plural "gateau st. honores"
msgstr[0] "圣奥诺雷蛋糕"

#: data/json/items/comestibles/baked.json
#. ~ Description of "gateau st. honore"
msgid ""
"A gâteau St. Honoré is a French cake that incorporates layers of classic puff "
"pastry, balls of choux pastry, and pastry cream.  This cake originated in "
"nineteenth-century France and was named after Saint Honoré, the French patron "
"saint of bakers and pastry chefs."
msgstr ""
"一款经典的法式甜点，它巧妙地结合了酥脆的千层酥皮、小巧的泡芙球以及香滑的奶油馅料。这款蛋糕诞生于19"
"世纪的法国，其命名是为了致敬法国面包师与糕点师的守护神——圣奥诺雷。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "donut hole"
msgid_plural "donut holes"
msgstr[0] "甜甜圈"

#: data/json/items/comestibles/bread.json
#. ~ Description of "donut hole"
msgid ""
"These balls of dough have been cut into shape, covered with sugar, and cooked "
"to a crisp.  A staple of fairgrounds everywhere."
msgstr "麵團球切成小塊，撒上糖，油炸。香脆可口的夜市美食。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "juvenile sourdough starter"
msgid_plural "juvenile sourdough starter"
msgstr[0] "幼年老麵種"

#: data/json/items/comestibles/bread.json
#. ~ Description of "juvenile sourdough starter"
msgid "A floury paste that is slowly going bad.  Someday it will be sourdough."
msgstr "一種慢慢發酵的粉狀糊狀物。總有一天它會成為酸麵糰。"

#: data/json/items/comestibles/bread.json
#. ~ "msg" action message of item "juvenile sourdough starter"
msgid ""
"After feeding it and caring for it for a week, your sourdough starter is "
"finally ready for the big leagues."
msgstr "餵養牠並照顧它數週之後，你的老麵種終於準備大展身手了。"

#: data/json/items/comestibles/bread.json
#. ~ "not_ready_msg" action message of item "juvenile sourdough starter"
msgid ""
"You've been caring for your starter for a while, but it's going to need "
"longer before you can do anything tasty with it."
msgstr "你一直在照顧你的老麵，但是你需要更長的時間才可以拿它做些美味的東西。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "freshly fed sourdough starter"
msgid_plural "freshly fed sourdough starter"
msgstr[0] "餵養得宜的老麵種"

#: data/json/items/comestibles/bread.json
#. ~ Description of "freshly fed sourdough starter"
msgid ""
"A floury paste with sourdough starter mixed in.  It needs a day to recover "
"its strength before it can be used again."
msgstr "一種混合著酸麵種的粉狀糊狀物。需要一天恢復它的強度才能再次使用。"

#: data/json/items/comestibles/bread.json
#. ~ "msg" action message of item "freshly fed sourdough starter"
msgid "The starter is now stinky and bubbly, and looks ready for cooking."
msgstr "老麵種現在發臭，起泡，看起來可以拿來製作了。"

#: data/json/items/comestibles/bread.json
#. ~ "not_ready_msg" action message of item "freshly fed sourdough starter"
msgid "The starter isn't quite ready to go."
msgstr "麵種還沒準備好。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "sourdough starter"
msgid_plural "sourdough starter"
msgstr[0] "老麵種"

#: data/json/items/comestibles/bread.json
#. ~ Description of "sourdough starter"
msgid ""
"A precious mix of flour, water, molds, and bacteria from the air.  When you "
"add flour and water to it, after a few hours it froths and rises."
msgstr "一团珍贵的面糊，由面粉、水、霉菌和空气中的细菌混合而成。当你把它加入面粉和水和成面团，几个小时后，面团就会发酵起泡变大。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "sourdough bread"
msgid_plural "sourdough bread"
msgstr[0] "天然酵母麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "sourdough bread"
msgid ""
"Healthy and filling, with a sharper taste and thicker crust than yeast-only "
"bread."
msgstr "健康且飽足，口感更清脆，外殼比酵母麵包更厚。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "flatbread"
msgid_plural "flatbread"
msgstr[0] "無酵麵餅"

#: data/json/items/comestibles/bread.json
#. ~ Description of "flatbread"
msgid "Simple unleavened bread."
msgstr "不加入酵母的簡單麵包。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "frybread"
msgid_plural "frybread"
msgstr[0] "炸麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "frybread"
msgid ""
"Delicious fried flatbread.  While it's not pre-contact food, it's a popular "
"treat in many Native American households, especially as ingredient for Indian "
"tacos at Powwows or for Thanksgiving."
msgstr "美味的油炸無酵餅。儘管它並非美洲原住民接觸歐洲人前的傳統食物，但在許多原住民家庭中卻是很受歡迎的食物，尤其是在帕瓦或感恩節時，可作為印地安塔可餅的配料。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "bread"
msgid_plural "bread"
msgstr[0] "麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "bread"
msgid ""
"A humble piece of bread, one of the single most important staple foods of "
"human civilization since the dawn of agriculture."
msgstr "一块不起眼的面包，自农业诞生以来人类文明最重要的主食之一。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "garlic bread"
msgid_plural "garlic bread"
msgstr[0] "蒜香麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "garlic bread"
msgid "Bread cooked with garlic, oil, and seasonings."
msgstr "用大蒜、油和调味料烤制的面包。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "toast"
msgid_plural "toast"
msgstr[0] "吐司"

#: data/json/items/comestibles/bread.json
#. ~ Description of "toast"
msgid ""
"A slice of bread with heat applied to crisp it up.  It's a bit dry and would "
"likely go better with some toppings."
msgstr "一片加热过的酥脆面包。它有点干，加上一些佐料可能会更好。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "buttered toast"
msgid_plural "buttered toast"
msgstr[0] "奶油吐司"

#: data/json/items/comestibles/bread.json
#. ~ Description of "buttered toast"
msgid "A slice of toast with butter spread on top to make it taste better."
msgstr "一片涂了黄油的烤吐司，味道更好。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "jam toast"
msgid_plural "jam toast"
msgstr[0] "果醬吐司"

#: data/json/items/comestibles/bread.json
#. ~ Description of "jam toast"
msgid "A slice of toast with jam added, to make it less dry and to add more flavor."
msgstr "一片加了果酱的吐司，没那么干，而且更有风味。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "peanut butter toast"
msgid_plural "peanut butter toast"
msgstr[0] "花生醬吐司"

#: data/json/items/comestibles/bread.json
#. ~ Description of "peanut butter toast"
msgid ""
"A slathering of peanut butter gives more heartiness and calories to a slice "
"of toast."
msgstr "抹上花生酱让这片吐司变得更暖心，更高热量。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "toad in a hole"
msgid_plural "toad in a hole"
msgstr[0] "洞中蟾蜍（吐司鑲蛋）"

#: data/json/items/comestibles/bread.json
#. ~ Description of "toad in a hole"
msgid ""
"A cooked egg served inside a piece of toast, not to be confused with the "
"English recipe of the same name."
msgstr "熟蛋夹在一片吐司里。不要把它和同名英国菜搞混。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "PBJ toast"
msgid_plural "PBJ toast"
msgstr[0] "花生酱果酱吐司"

#: data/json/items/comestibles/bread.json
#. ~ Description of "PBJ toast"
msgid ""
"A slice of toast with peanut butter and jelly on top, with added butter for "
"flavor."
msgstr "一片涂有花生酱和果酱的吐司，上面还加上了黄油调味。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "cornbread"
msgid_plural "cornbread"
msgstr[0] "玉米麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "cornbread"
msgid ""
"Healthy and filling cornbread, a Native American recipe that quickly became a "
"staple of U.S. cuisine."
msgstr "健康又饱腹的玉米面包，一种美国原住民食谱，很快成为了美国餐的主食。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "johnnycake"
msgid_plural "johnnycakes"
msgstr[0] "玉米餅"

#: data/json/items/comestibles/bread.json
#. ~ Description of "johnnycake"
msgid "A dense and tasty fried bread treat."
msgstr "濃郁美味的炸麵包。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "corn tortilla"
msgid_plural "corn tortillas"
msgstr[0] "墨西哥玉米餅"

#: data/json/items/comestibles/bread.json
#. ~ Description of "corn tortilla"
msgid "A round, thin flatbread made from finely ground corn flour."
msgstr "圓的， 由磨細的玉米粉作成的薄烤餅。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "flour tortilla"
msgid_plural "flour tortillas"
msgstr[0] "墨西哥小麦薄饼"

#: data/json/items/comestibles/bread.json
#. ~ Description of "flour tortilla"
msgid "A round, thin flatbread made from finely ground wheat flour."
msgstr "圆形的薄饼，由经过细磨的小麦粉制成。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "hardtack cracker"
msgid_plural "hardtack cracker"
msgstr[0] "压缩饼干"

#: data/json/items/comestibles/bread.json
#. ~ Description of "hardtack cracker"
msgid ""
"A dry, virtually tasteless bread cracker capable of remaining edible without "
"spoilage for vast lengths of time.  So hard it is inedible by itself.  "
"Usually broken into smaller pieces for consumption."
msgstr "一种干燥、几乎无味的饼干，可以长时间储存而不用担心变质。 这种饼干非常坚硬，无法直接食用，通常掰成小块才能吃。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "hardtack"
msgid_plural "hardtack"
msgstr[0] "硬麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "hardtack"
msgid ""
"A dry, virtually tasteless bread product capable of remaining edible without "
"spoilage for vast lengths of time.  So hard it is inedible by itself."
msgstr "一种干燥的、几乎无味的面包产品，能够长时间保存而不变质。硬到没法直接食用。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "soggy hardtack"
msgid_plural "soggy hardtack"
msgstr[0] "浸溼硬麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "soggy hardtack"
msgid ""
"A soggy, virtually tasteless bread product that has soaked up enough water "
"that it won't hurt your teeth when you chew it."
msgstr "湿漉漉、几乎无味的面饼，它吸收了足够多的水分，不再硬得咯牙。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "biscuit"
msgid_plural "biscuits"
msgstr[0] "比司吉餅乾"

#: data/json/items/comestibles/bread.json
#. ~ Description of "biscuit"
msgid ""
"Hardtack's much more palatable descendant, thanks in large part to the "
"addition of milk in the recipe.  Crumbly on the outside, soft on the inside, "
"and delicious all the way through."
msgstr "压缩饼干的后代，但是更可口，很大程度上要归功于配方中添加了牛奶。外面酥脆，里面软软的，总之就是好吃。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "wastebread"
msgid_plural "wastebread"
msgstr[0] "剩菜麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "wastebread"
msgid ""
"Flour is a commodity these days and to deal with that, most survivors resort "
"to mixing it with leftovers of other ingredients and baking it all into "
"bread.  It's filling, and that's what matters."
msgstr "面粉在这些日子越来越珍贵了，所以幸存者们开始把各种东西混进面粉，然后烤成面包。能填肚子当然是最关键的。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "brown bread"
msgid_plural "brown bread"
msgstr[0] "黑麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "brown bread"
msgid "Sweet bread made with molasses, with a consistency closer to cake."
msgstr "用糖蜜制成的甜面包，稠度更接近于蛋糕。"

#: data/json/items/comestibles/bread.json
#. ~ Item name
msgid "hallula"
msgid_plural "hallula"
msgstr[0] "哈魯拉麵包"

#: data/json/items/comestibles/bread.json
#. ~ Description of "hallula"
msgid ""
"A type of bread popular in Chile and Bolivia.  Prepared using animal lard or "
"oil, it resembles a large, round scone.  In the pre-Cataclysm world, it would "
"usually be filled with savory ingredients."
msgstr "一种在智利和玻利维亚很流行的面包。使用动物板油或植物油制成，像一个大的圆形烤饼。在大灾变前的世界里，通常会在其中填满咸香类食材。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "Mycus wine must"
msgid_plural "Mycus wine must"
msgstr[0] "馬庫斯酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "Mycus wine must"
msgid ""
"Unfermented Mycus wine.  A goopy white mess, made from Mycus fruit.  It "
"smells sweetly of mushrooms.  You need to put it in a fermenting vat to brew "
"it."
msgstr "未发酵的马卡斯酒，滑腻的白色混合物，由马卡斯果实制成。闻起来有蘑菇的香味。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "Marloss wine must"
msgid_plural "Marloss wine must"
msgstr[0] "馬洛斯酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "Marloss wine must"
msgid ""
"Unfermented Marloss wine.  A soft pinkish mess, made from Marloss berries.  "
"It has a strong aroma, but you're not quite sure if it's a good or bad one.  "
"You need to put it in a fermenting vat to brew it."
msgstr "未发酵的马洛斯酒。一种柔软的略带粉红色的果酱，由马洛斯莓制成。它有很浓的香气，但你不确定它是好是坏。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "whiskey wort"
msgid_plural "whiskey wort"
msgstr[0] "威士忌原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "whiskey wort"
msgid ""
"Unfermented whiskey.  The base of a fine drink.  Not the traditional "
"preparation, but you don't have the time.  You need to put it in a fermenting "
"vat to brew it."
msgstr "未发酵的威士忌。一个好的饮料底子，尽管不是传统的制法，但你没有时间酿造它了。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "whiskey wash"
msgid_plural "whiskey wash"
msgstr[0] "威士忌酒汁"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "whiskey wash"
msgid ""
"Fermented, but not distilled whiskey.  No longer tastes sweet.  You may want "
"to distill it before drinking."
msgstr "已经过发酵，但尚未经过蒸馏的威士忌。尝起来不再甜蜜。你可能想在喝之前蒸馏它一下。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "gin mash"
msgid_plural "gin mash"
msgstr[0] "琴酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "gin mash"
msgid "Unfermented gin mash.  Fermenting it will produce gin."
msgstr "未发酵的杜松子酒原汁。发酵会产生杜松子酒。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "gin wash"
msgid_plural "gin wash"
msgstr[0] "杜松子酒淡酒"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "gin wash"
msgid ""
"Gin wash, after the junipers have had time to add flavor.  Ready to be "
"distilled or drunk as is."
msgstr "杜松子酒淡酒，加入的杜松子经过发酵可为其增添风味，可以被进一步蒸馏提纯或者就这样饮用。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "sake mash"
msgid_plural "sake mash"
msgstr[0] "清酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "sake mash"
msgid ""
"A fine mix of water, koji rice and yeast, ready to be fermented into sake "
"once set in a fermenting vat."
msgstr "水、酒曲和酵母搅合在一起，放在罐中发酵，总有一天会变成清酒。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "unfermented soy sauce"
msgid_plural "unfermented soy sauce"
msgstr[0] "醬油（未發酵）"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "unfermented soy sauce"
msgid ""
"Brine with mashed soybeans, wheat flour and koji mold added to it.  If you "
"want to make soy sauce from this, the next step would be to let it ferment."
msgstr "一份加入了大豆泥、小麦粉和曲霉菌的盐水。如果你想用它做酱油，下一步就是让它发酵。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "unstrained soy sauce"
msgid_plural "unstrained soy sauce"
msgstr[0] "醬油（未過濾）"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "unstrained soy sauce"
msgid ""
"Nearly-finished soy sauce that still has some solid particles floating in it. "
" Still needs to be strained, and also pasteurized to get rid of harmful "
"bacteria."
msgstr "接近成品的酱油，仍有一些固体颗粒在其中漂浮着。需要过滤，也需要巴氏杀菌以去除有害细菌。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "vodka wort"
msgid_plural "vodka wort"
msgstr[0] "伏特加原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "vodka wort"
msgid ""
"Unfermented vodka.  Water with sugar from the enzymatic breakdown of malted "
"grains, or just added in pure form.  You need to put it in a fermenting vat "
"to brew it."
msgstr "未发酵的伏特加。发芽的谷物加入酶而酶解成糖，或直接加入纯糖的糖水。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "vodka wash"
msgid_plural "vodka wash"
msgstr[0] "伏特加酒汁"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "vodka wash"
msgid ""
"Fermented, but not distilled vodka.  No longer tastes sweet.  You may want to "
"distill it before drinking."
msgstr "已经过发酵，但尚未经过蒸馏的伏特加。尝起来不再甜蜜。你可能想在喝之前蒸馏它一下。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "rum wort"
msgid_plural "rum wort"
msgstr[0] "蘭姆酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "rum wort"
msgid ""
"Unfermented rum.  Sugar caramel or molasses brewed into sweet water.  "
"Basically a saccharine soup.  You need to put it in a fermenting vat to brew "
"it."
msgstr "未发酵的朗姆酒。焦糖或糖浆煮成的甜水。基本上就是甜水。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "rum wash"
msgid_plural "rum wash"
msgstr[0] "蘭姆酒酒汁"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "rum wash"
msgid ""
"Fermented, but not distilled rum.  No longer tastes sweet.  You may want to "
"distill it before drinking."
msgstr "已经过发酵，但尚未经过蒸馏的朗姆酒。尝起来不再甜蜜。你可能想在喝之前蒸馏它一下。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "fruit wine must"
msgid_plural "fruit wine must"
msgstr[0] "水果酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "fruit wine must"
msgid ""
"Unfermented fruit wine.  A sweet, boiled juice made from berries or fruit.  "
"You need to put it in a fermenting vat to brew it."
msgstr "未发酵的果酒。一种浆果和水果煮汁制成的饮料，尝起来很甜！你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "plain mead must"
msgid_plural "plain mead must"
msgstr[0] "蜂蜜酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "plain mead must"
msgid ""
"Unfermented plain mead.  Diluted honey and yeast.  You need to put it in a "
"fermenting vat to brew it."
msgstr "未发酵的普通蜂蜜酒。其实就是稀释的蜂蜜和酵母。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "hopped mead must"
msgid_plural "hopped mead must"
msgstr[0] "啤酒花蜜酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "hopped mead must"
msgid ""
"Unfermented hopped mead.  Diluted honey cooked with hops for a bitter note, "
"then cooled down and infused with yeast.  You need to put it in a fermenting "
"vat to brew it."
msgstr "未发酵的啤酒花蜜酒。被水稀释的蜂蜜与啤酒花一起煮出苦涩的味道，然后冷却并加入酵母。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "spiced mead must"
msgid_plural "spiced mead must"
msgstr[0] "香料蜜酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "spiced mead must"
msgid ""
"Unfermented spiced mead.  Diluted honey infused with spices and yeast.  You "
"need to put it in a fermenting vat to brew it."
msgstr "未发酵的辣味蜂蜜酒。其实就是稀释的蜂蜜加上辣椒和酵母。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "dandelion wine must"
msgid_plural "dandelion wine must"
msgstr[0] "蒲公英酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "dandelion wine must"
msgid ""
"Unfermented dandelion wine.  A sticky mixture of water, sugar, yeast, and "
"dandelion petals.  You need to put it in a fermenting vat to brew it."
msgstr "未发酵的蒲公英起泡酒。由水、糖、酵母和蒲公英花瓣混合而成的粘稠液体。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "burdock wine must"
msgid_plural "burdock wine must"
msgstr[0] "牛蒡酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "burdock wine must"
msgid ""
"Unfermented burdock wine.  A sticky mixture of water, sugar, yeast, and "
"burdock roots.  You need to put it in a fermenting vat to brew it."
msgstr "未发酵的牛蒡酒。由水、糖、酵母和牛蒡根混合而成的粘稠液体。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "pine wine must"
msgid_plural "pine wine must"
msgstr[0] "松脂酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "pine wine must"
msgid ""
"Unfermented pine wine.  A sticky mixture of water, sugar, yeast, and pine "
"resin.  You need to put it in a fermenting vat to brew it."
msgstr "未发酵的松针酒。由水、糖、酵母和松树脂混合而成的粘稠液体。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "beer wort"
msgid_plural "beer wort"
msgstr[0] "啤酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "beer wort"
msgid ""
"Unfermented homebrew beer.  A boiled and chilled mash of malted barley, "
"spiced with some fine hops.  You need to put it in a fermenting vat to brew "
"it."
msgstr "未发酵的家酿啤酒。里面有煮熟并冷却的捣碎的大麦麦芽，并加入了品质不错的啤酒花调味。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "seltzer wort"
msgid_plural "seltzer wort"
msgstr[0] "蘇打水原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "seltzer wort"
msgid ""
"Unfermented seltzer.  A boiled and chilled mash of refined sugar and fruit.  "
"You need to put it in a fermenting vat to brew it."
msgstr "未发酵的苏打水。由精制糖和水果煮沸且冷冻制成的糊状物。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "moonshine mash"
msgid_plural "moonshine mash"
msgstr[0] "私釀烈酒原液"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "moonshine mash"
msgid ""
"Unfermented moonshine.  Just some water, sugar and corn, like good ol' "
"auntie's recipe.  Using pumpkin instead of corn would reduce the amount of "
"extra sugar you need to add.  You need to put it in a fermenting vat to brew "
"it."
msgstr "未发酵的私酿威士忌。只是一些水、糖和玉米，就像好老姑妈的食谱一样。用南瓜代替玉米会减少你需要额外加糖的量。你需要将其放入发酵桶来酿造。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "moonshine wash"
msgid_plural "moonshine wash"
msgstr[0] "私釀烈酒酒汁"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "moonshine wash"
msgid ""
"Fermented, but not distilled moonshine.  Contains all the contaminants you "
"don't want in your moonshine, so you may want to distill it first."
msgstr "已经过发酵，但尚未经过蒸馏的私酿威士忌。包含所有你不想留在你的私酿威士忌里的杂质。你可能想在喝之前蒸馏它一下。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "curdling milk"
msgid_plural "curdling milk"
msgstr[0] "凝化乳"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "curdling milk"
msgid ""
"Milk with vinegar and natural rennet added.  Used for making cheese if left "
"in a fermenting vat for some time."
msgstr "添加了醋和天然凝乳酶的牛奶。留在發酵缸一段時間後就會成為起司。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "unfermented vinegar"
msgid_plural "unfermented vinegar"
msgstr[0] "未發酵醋"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "unfermented vinegar"
msgid ""
"A mixture of water, alcohol and fruit juice that will eventually become "
"vinegar when fermented in a vat."
msgstr "水，酒精，果汁搅合在一起，放在罐中发酵，总有一天会变成醋。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "growing wild yeast"
msgid_plural "growing wild yeast"
msgstr[0] "成長中的野生酵母"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "growing wild yeast"
msgid ""
"A sugary solution with some naturally occurring yeast.  If placed in a "
"fermenting vat and given time, it will eventually produce a more sizeable "
"yeast culture."
msgstr "一份含有天然酵母的含糖溶液。如果将其放入发酵桶中并给一点时间，总有一天会变成能用的酵母。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "malting grain"
msgid_plural "malting grain"
msgstr[0] "浸泡麥芽"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "malting grain"
msgid "Malting grain that can be used for brewing."
msgstr "將穀物浸泡在水中使其發芽，可用於釀酒。"

#: data/json/items/comestibles/brewing.json
#. ~ "msg" action message of item "malting grain"
msgid "After soaking the grain and waiting, it has finished malting."
msgstr "穀物經過了浸泡和等待，它已經完成了麥芽過程。"

#: data/json/items/comestibles/brewing.json
#. ~ "not_ready_msg" action message of item "malting grain"
msgid "The grain has not malted yet."
msgstr "穀物還没完成麥芽。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "malted grain"
msgid_plural "malted grain"
msgstr[0] "麥芽"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "malted grain"
msgid ""
"Grainy cereal used for malting.  A staple of brewing everywhere.  It can also "
"be ground into flour."
msgstr "顆粒狀的穀物。常用做為釀酒的原料。它也可以被磨成麵粉。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "soaking dandelion"
msgid_plural "soaking dandelion"
msgstr[0] "泡水蒲公英"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "soaking dandelion"
msgid "Soaked dandelions that can be used for brewing."
msgstr "浸透的蒲公英，可用于酿酒。"

#: data/json/items/comestibles/brewing.json
#. ~ "msg" action message of item "soaking dandelion"
msgid ""
"After soaking the dandelions in boiling water, the juice can be used for "
"making wine."
msgstr "蒲公英在沸水中浸泡後，汁液可以用來釀酒。"

#: data/json/items/comestibles/brewing.json
#. ~ "not_ready_msg" action message of item "soaking dandelion"
msgid "The dandelions need more time."
msgstr "蒲公英需要浸泡多些时间。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "soaked dandelion"
msgid_plural "soaked dandelion"
msgstr[0] "蒲公英汁"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "soaked dandelion"
msgid "Dandelions soaked in hot water, used for making dandelion wine."
msgstr "用沸水浸泡過的蒲公英，用於釀造蒲公英酒。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "fermenting yogurt"
msgid_plural "fermenting yogurt"
msgstr[0] "優格（發酵中）"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "fermenting yogurt"
msgid ""
"Milk inoculated with lactobacillus.  It requires some time fermenting to "
"hopefully end up as delicious yogurt."
msgstr "加了乳酸杆菌的原奶。它需要一些时间发酵，希望能最终成为美味的酸奶。"

#: data/json/items/comestibles/brewing.json
#. ~ "msg" action message of item "fermenting yogurt"
msgid "The milk has finished fermenting and turned into a slightly clumpy yogurt."
msgstr "原奶发酵完毕，变成了略带凝块的酸奶。"

#: data/json/items/comestibles/brewing.json
#. ~ "not_ready_msg" action message of item "fermenting yogurt"
msgid "The yogurt is still fermenting."
msgstr "這個優格還在發酵中。"

#: data/json/items/comestibles/brewing.json
#. ~ Item name
msgid "unfermented root beer"
msgid_plural "unfermented root beer"
msgstr[0] "根汁汽水（未发酵）"

#: data/json/items/comestibles/brewing.json
#. ~ Description of "unfermented root beer"
msgid ""
"A mixture of water, sugar, yeast and sassafras roots that will eventually "
"become root beer, if brewed in a fermenting vat."
msgstr "水，糖，酵母和黄樟根搅合在一起，如果在蒸馏器中蒸馏的话，总有一天会变成根汁汽水。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "pair of frog legs"
msgid_plural "pairs of frog legs"
msgstr[0] "蛙腿"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "pair of frog legs"
msgid "A raw pair of frog legs.  Tastes like chicken when cooked or smoked."
msgstr "一雙生蛙腿。煮熟後吃起來就像雞肉。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "pair of cooked frog legs"
msgid_plural "pairs of cooked frog legs"
msgstr[0] "煮熟蛙腿"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "pair of smoked frog legs"
msgid_plural "pairs of smoked frog legs"
msgstr[0] "煙燻蛙腿"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "fillet of fish"
msgid_plural "fillets of fish"
msgstr[0] "生魚片"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "fillet of fish"
msgid "An uncooked fish fillet.  Makes a passable meal raw."
msgstr "生魚片，勉強可以生吃。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "scrap of fish"
msgid_plural "scraps of fish"
msgstr[0] "魚肉渣"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "scrap of fish"
msgid "A tiny scrap of edible fish.  It's not much, but it'll do in a pinch."
msgstr "一小塊可食用的魚肉。它並不多，但在你別無選擇時也夠了。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked scrap of fish"
msgid_plural "cooked scraps of fish"
msgstr[0] "煮熟魚肉渣"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked fish"
msgid_plural "cooked fish"
msgstr[0] "煮熟的魚肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked fish"
msgid "A cooked fish fillet.  Very nutritious."
msgstr "煮熟的魚肉。非常營養。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "chunk of lobster meat"
msgid_plural "chunks of lobster meat"
msgstr[0] "龍蝦肉塊"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "chunk of lobster meat"
msgid "A chunk of uncooked lobster meat."
msgstr "一大塊生的龍蝦肉。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked lobster"
msgid_plural "cooked lobster"
msgstr[0] "煮熟龍蝦"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked lobster"
msgid "A chunk of delicious cooked lobster meat."
msgstr "一大塊煮熟的美味龍蝦肉。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "fillet of mollusk"
msgid_plural "fillets of mollusk"
msgstr[0] "軟體動物肉片"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "fillet of mollusk"
msgid "The raw flesh of a mollusk.  Must be cleaned and cooked before eating."
msgstr "軟體動物的生肉，食用前要先清洗和煮熟。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked mollusk"
msgid_plural "cooked mollusk"
msgstr[0] "熟烏賊肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked mollusk"
msgid ""
"Cooked mollusk meat.  Devoid of any parasites or bacteria due to heat, the "
"only thing left to do is add sauce."
msgstr "煮熟的軟體動物肉。用高溫殺死了寄生蟲和細菌，所以我說那個醬汁呢?"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "purged gastropods"
msgid_plural "purged gastropods"
msgstr[0] "乾淨蝸牛肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "purged gastropods"
msgid ""
"A handful of lucky gastropods that have been prepared for cooking by "
"repeatedly boiling and washing them to remove their mucus and pathogens."
msgstr "一把幸運的腹足類動物，多次燙過和清洗來洗淨黏液並去除病原體。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked gastropods"
msgid_plural "cooked gastropods"
msgstr[0] "熟蝸牛肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked gastropods"
msgid "Cooked gastropods.  A bit low on calories, but high in protein."
msgstr "煮熟的的腹足類動物肉。熱量有點少不過富含蛋白質。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "human stomach"
msgid_plural "human stomachs"
msgstr[0] "人胃"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "human stomach"
msgid "The stomach of a human.  It is surprisingly durable."
msgstr "人類的胃袋， 比想像中結實。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "large human stomach"
msgid_plural "large human stomachs"
msgstr[0] "大型人胃"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "large human stomach"
#. ~ Description of "large demihuman stomach"
msgid "The stomach of a large humanoid creature.  It is surprisingly durable."
msgstr "來自大型人形生物的胃袋，比想像中結實。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "chunk of human fat"
msgid_plural "chunks of human fat"
msgstr[0] "人類脂肪塊"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "chunk of human fat"
msgid "A chunk of raw fat, harvested from a human body."
msgstr "從人體切下來的脂肪。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "human tallow"
msgid_plural "human tallow"
msgstr[0] "人類脂肪"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "human tallow"
msgid ""
"A smooth white block of cleaned and rendered human fat.  It will remain "
"edible for a very long time, and can be used as an ingredient in many foods "
"and projects."
msgstr "一塊光滑的白色人類脂肪, 經過了清洗和提煉。能夠保存長時間可食用, 也能搭配其他食物或製作項目。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "human lard"
msgid_plural "human lard"
msgstr[0] "提煉人類油"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "human lard"
msgid ""
"A smooth white block of dry-rendered human fat.  It will remain edible for a "
"very long time, and can be used as an ingredient in many foods and projects."
msgstr "一塊從人類脂肪中提煉乾燥而成的白色光滑物體。它的食用保存期限非常長, 並且可以用作許多食品和製作的原料。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "human flesh"
msgid_plural "human flesh"
msgstr[0] "人肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "human flesh"
msgid "A chunk of raw meat, butchered from a human body."
msgstr "從人體屠宰而來的生肉。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked creep"
msgid_plural "cooked creep"
msgstr[0] "煮熟的人肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked creep"
msgid "A cooked slice of 'long pig'.  Tastes vary from person to person."
msgstr "一片熟制的人肉，口味因人而异。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "peppered person"
msgid_plural "peppered person"
msgstr[0] "椒盐人片"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "peppered person"
msgid ""
"A cooked slice of some person, seasoned with black pepper and salt.  Probably "
"has better taste than they did when alive."
msgstr "一片用黑胡椒和盐调味的某人的熟切片。这可能比他们活着的时候更有“品味”。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "chunk of meat"
msgid_plural "chunks of meat"
msgstr[0] "肉塊"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "chunk of meat"
msgid "A chunk of raw meat.  You could eat it as-is, but cooking it is better."
msgstr "一塊生肉，你可以直接吃，但還是煮熟比較安全。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "animal blood"
msgid_plural "animal blood"
msgstr[0] "動物血液"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "animal blood"
msgid "Blood extracted from a living creature."
msgstr "從生物抽出的血液。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "chunk of porkbelly"
msgid_plural "chunks of porkbelly"
msgstr[0] "五花肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "chunk of porkbelly"
msgid ""
"A fatty cut of pork from the belly, popular in some cuisine.  With proper "
"technique, it can be used to create bacon.  Not safe to consume in its "
"current raw form."
msgstr "豬腹部的肥肉，在某些料理中很常用。用上正確的技巧，就能被用來做成培根。現在還是生的不適合食用。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "slab of raw cured porkbelly"
msgid_plural "slabs of raw cured porkbelly"
msgstr[0] "醃過的生五花肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "slab of raw cured porkbelly"
msgid ""
"Porkbelly that has been preserved and flavored with salt and sugar to draw "
"out the moisture from the first layer.  Still raw, it is ready for smoking "
"into bacon."
msgstr "五花肉用鹽和糖從表皮排出水分來保存和調味。還是生的，已經準備好燻製成培根。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "large slab of uncut bacon"
msgid_plural "large slabs of uncut bacon"
msgstr[0] "大塊未切的培根"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "large slab of uncut bacon"
msgid ""
"A huge slab of uncut smoked bacon.  You can eat it as is, but it would be "
"more efficient to cut it into smaller portions with a knife."
msgstr "一大塊還沒切的煙燻培根。能夠直接吃，但是用刀切成小份吃起來會更有效率。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "slab of raw curing porkbelly"
msgid_plural "slabs of raw curing porkbelly"
msgstr[0] "醃製中的五花肉塊"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "slab of raw curing porkbelly"
msgid ""
"Porkbelly in the process of becoming fully cured with salt and sugar, capable "
"of becoming bacon.  The flavor is slowly developing at this stage, and is "
"significantly unpleasant due to the residual salt.  Activate it once "
"completed to make use of the final product."
msgstr "五花肉正在用鹽和糖醃製中，將會能夠變成培根。獨特的風味正在這個階段產生，大量的鹽讓它現在非常難吃。當它完成後啟動它來取得最終成品。"

#: data/json/items/comestibles/carnivore.json
#. ~ "msg" action message of item "slab of raw curing porkbelly"
msgid ""
"You pat off a bit of extra brine from the slice; this piece of meat is now "
"fully cured."
msgstr "你拍掉多餘的鹽水，這塊肉已經醃好了。"

#: data/json/items/comestibles/carnivore.json
#. ~ "not_ready_msg" action message of item "slab of raw curing porkbelly"
msgid "The meat isn't fully cured yet."
msgstr "肉還沒醃好。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "scrap of meat"
msgid_plural "scraps of meat"
msgstr[0] "肉渣"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "scrap of meat"
msgid "A tiny scrap of raw meat.  It's not much, but it'll do in a pinch."
msgstr "一小塊生肉。它並不多，但在你別無選擇時也夠了。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "scrap of human flesh"
msgid_plural "scraps of human flesh"
msgstr[0] "碎人肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "scrap of human flesh"
msgid "A tiny scrap of raw human flesh."
msgstr "一小塊生人肉。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "scrap of demihuman flesh"
msgid_plural "scraps of demihuman flesh"
msgstr[0] "亞人碎肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "scrap of demihuman flesh"
msgid "A tiny scrap of raw demihuman flesh."
msgstr "一小塊生的亞人碎肉。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "chunk of mutant meat"
msgid_plural "chunks of mutant meat"
msgstr[0] "突變體肉塊"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "chunk of mutant meat"
msgid "Raw meat from a heavily mutated animal."
msgstr "從突變體取得的生肉。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "mutant blood"
msgid_plural "mutant blood"
msgstr[0] "突變體血液"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "mutant blood"
msgid "Blood extracted from a heavily mutated creature."
msgstr "從突變體抽取的血液。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "scrap of mutant meat"
msgid_plural "scraps of mutant meat"
msgstr[0] "突變體肉碎片"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "scrap of mutant meat"
msgid ""
"A tiny scrap of raw meat from a heavily mutated animal.  It smells "
"unappealing, to say the least."
msgstr "從突變體身上取得的一小塊生肉渣。退一步來說，它很難聞。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "mutant humanoid meat"
msgid_plural "mutant humanoid meat"
msgstr[0] "人形突變體肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "mutant humanoid meat"
msgid ""
"Raw meat butchered from the body of a heavily mutated creature that was "
"unsettlingly humanoid in appearance.  It has odd bits of fur and other tissue "
"lodged in it that clearly don't belong.  You'd have to be crazy or starving "
"to eat this."
msgstr "從一具嚴重變異的人形突變體屍體上切下來的生肉。上面長著一些奇怪的毛髮和其他不應出現在這的組織。你一定是瘋了或者餓了才會吃這個。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "mutant human blood"
msgid_plural "mutant human blood"
msgstr[0] "變異人類血液"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "mutant human blood"
msgid "Blood extracted from a heavily mutated human."
msgstr "從重度突變的人類身上採集的血液。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked cretin"
msgid_plural "cooked cretin"
msgstr[0] "煮熟的人形突變體肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked cretin"
msgid ""
"Cooked meat from a heavily mutated humanoid.  Now that the worst bits have "
"been picked out, it's probably digestible, if not very appetizing."
msgstr "人形突變體的熟肉。現在最壞的部分已經挑出來了，即使很倒胃，也應該能吃了。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked pepper cretin"
msgid_plural "cooked pepper cretin"
msgstr[0] "椒鹽人形突變體肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked pepper cretin"
msgid ""
"Cooked meat from a heavily mutated humanoid.  Now that the worst bits have "
"been picked out, it's probably digestible.  It has also been properly "
"seasoned with black pepper and salt, giving it a better taste.  Still, it is "
"somewhat gross, but hey, it's food!"
msgstr "人形突變體的熟肉。現在最壞的部分已經挑出來了，應該能吃了。用了胡椒和鹽好好調味過了。仍然很噁心，不過食物就是食物！"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "chunk of tainted mutant meat"
msgid_plural "chunks of tainted mutant meat"
msgstr[0] "汙染突變體肉塊"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked tainted mutant meat"
msgid_plural "cooked tainted mutant meat"
msgstr[0] "煮熟的汙染突變體肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "smoked tainted mutant meat"
msgid_plural "smoked tainted mutant meat"
msgstr[0] "煙燻汙染突變體肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "smoked tainted mutant meat"
msgid "Rotten mutant meat that has been heavily smoked for preservation."
msgstr "經過重重燻烤的腐爛突變體肉，能夠延長保存期限。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "butchery refuse"
msgid_plural "butchery refuse"
msgstr[0] "屠宰垃圾"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "butchery refuse"
msgid ""
"Eugh.  This is a mess of dirt, excreta, connective tissue, and bits of matter "
"like hair and claws, leftover from the butchering process.  Eating it isn't "
"even worth thinking about."
msgstr "嘔。這是一堆污穢、排泄物、結締組織、以及屠宰中剔除的毛髮和爪子碎屑。根本不用想吃它了。"

#: data/json/items/comestibles/carnivore.json
#: data/mods/Xedra_Evolved/items/carnivore.json
#. ~ Item name
msgid "cooked meat"
msgid_plural "cooked meat"
msgstr[0] "熟肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked meat"
msgid ""
"A chunk of cooked meat.  It's filling and nutritious, but unseasoned and a "
"bit bland."
msgstr "一大塊煮熟的肉。充滿了營養，但沒有調味，有點清淡。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked pepper meat"
msgid_plural "cooked pepper meat"
msgstr[0] "椒鹽肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked pepper meat"
msgid ""
"A piece of cooked meat, properly seasoned with black pepper and salt.  It's "
"nutritious, yet basic seasoning adds a welcoming taste to this simple dish."
msgstr "煮熟的肉，用胡椒和鹽好好調味過了。富含營養並且基礎的調味為這簡單的餐點帶來了宜人的味道。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked fatty meat"
msgid_plural "cooked fatty meat"
msgstr[0] "煮過的五花肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked fatty meat"
msgid ""
"A chunk of cooked fatty meat.  Although absent of vitamins, it is very "
"filling and delightfully greasy."
msgstr "這是一大塊新鮮煮熟的肥肉。它缺少了維他命，但是富有飽足感而且油滋滋。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked pepper fatty meat"
msgid_plural "cooked pepper fatty meat"
msgstr[0] "椒鹽五花肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked pepper fatty meat"
msgid ""
"A chunk of cooked fatty meat properly seasoned with black pepper and salt.  "
"Although absent of vitamins, it is very filling, tasty and delightfully "
"greasy."
msgstr "這是一大塊新鮮煮熟的肥肉，用胡椒和鹽好好調味過了。它缺少了維他命，但是富有飽足感而且油滋滋。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked scrap of meat"
msgid_plural "cooked scraps of meat"
msgstr[0] "煮熟的肉渣"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked pepper scrap of meat"
msgid_plural "cooked pepper scraps of meat"
msgstr[0] "椒鹽肉渣"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked pepper scrap of meat"
msgid ""
"A cooked scrap of meat that has been properly seasoned with pepper and salt.  "
"Yet small, they have a good taste."
msgstr "用胡椒和鹽適當調味的熟肉渣。雖然很小，但味道很好。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked mutant meat"
msgid_plural "cooked mutant meat"
msgstr[0] "煮熟的突變體肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked mutant meat"
msgid "A cooked chunk of meat from a mutated animal."
msgstr "一塊突變體的熟肉。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked pepper mutant meat"
msgid_plural "cooked pepper mutant meat"
msgstr[0] "椒鹽突變體肉"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked pepper mutant meat"
msgid ""
"A cooked chunk of meat from a mutated animal which has been properly seasoned "
"with black pepper and salt, will keep your hunger away, but even seasoned, it "
"has a weird taste."
msgstr "用黑胡椒和鹽適當調味的熟突變體肉，能填飽肚子，但即使經過調味，它還是有種怪味。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked scrap of mutant meat"
msgid_plural "cooked scraps of mutant meat"
msgstr[0] "煮熟的突變體肉渣"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked scrap of mutant meat"
msgid ""
"A tiny scrap of cooked mutant meat.  It is small enough that it's hard to "
"tell how disgusting it is."
msgstr "一小塊煮熟的突變體肉。它小到能讓你去忽視它有多噁心。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked pepper scrap of mutant meat"
msgid_plural "cooked pepper scraps of mutant meat"
msgstr[0] "椒鹽突變體肉渣"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked pepper scrap of mutant meat"
msgid ""
"A tiny scrap of cooked mutant meat properly seasoned with black pepper and "
"salt.  It is small, and even though it has been seasoned, it has a weird "
"taste."
msgstr "一小塊用黑胡椒和鹽適當調味的突變體熟肉。它小到能讓你去忽視它有多噁心。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "roasted bone marrow"
msgid_plural "roasted bone marrow"
msgstr[0] "烤骨髓"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "roasted bone marrow"
msgid "Bone marrow, fully cooked to eliminate any parasites.  Tasty!"
msgstr "完全煮熟以消滅任何寄生蟲的骨髓。好吃！"

#: data/json/items/comestibles/carnivore.json
#. ~ Conditional name for "roasted bone marrow" when VITAMIN matches
#. human_flesh_vitamin
#. ~ Conditional name for "roasted pepper bone marrow" when VITAMIN matches
#. human_flesh_vitamin
msgid "Marvin marrow"
msgid_plural "Marvin marrow"
msgstr[0] "烤人骨髓"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "roasted pepper bone marrow"
msgid_plural "roasted pepper bone marrow"
msgstr[0] "椒鹽烤骨髓"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "roasted pepper bone marrow"
msgid ""
"Bone marrow, fully cooked to eliminate any parasites and properly seasoned "
"with black pepper and salt.  Tasty!"
msgstr "完全煮熟以消滅任何寄生蟲的骨髓，並用胡椒和鹽調味。好吃！"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "raw offal"
msgid_plural "raw offal"
msgstr[0] "生內臟"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "raw offal"
msgid ""
"A selection of uncooked internal organs and entrails.  Filled with essential "
"vitamins, but most people consider it a bit gross unless it's very carefully "
"prepared."
msgstr "各種未經烹煮的內部器官和腸子。含有必需的維生素，但大多數人認為它有點噁心，除非經過精心的調理。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked offal"
msgid_plural "cooked offal"
msgstr[0] "煮熟的內臟"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked offal"
msgid ""
"A selection of cooked organs and entrails.  Filled with essential vitamins, "
"but pretty unappetizing in this form."
msgstr "各種煮過的器官和內臟。含有必要的維生素，但大多數人認為它有點噁心，除非經過精心的調理。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "tainted innards"
msgid_plural "tainted innards"
msgstr[0] "污染的內臟"

#: data/json/items/comestibles/carnivore.json
#: data/json/snippets/zombie_anatomy.json
#. ~ Description of "tainted innards"
#. ~ Snippet in category "tainted_innards_desc"
msgid ""
"An unidentifiable selection of rotted innards that barely hold their form.  "
"It is revolting and certainly no longer healthy to eat."
msgstr "各種爛到無法的辨識的腐爛內臟。令人反胃，別指望它能滋補了。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "mutant organs"
msgid_plural "mutant organs"
msgstr[0] "突變體內臟"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "mutant organs"
msgid "Raw organs from a giant mutant bug."
msgstr "從巨型變異昆蟲身上取得的生器官。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "cooked mutant bug organs"
msgid_plural "cooked mutant bug organs"
msgstr[0] "煮熟的變異蟲器官"

#: data/json/items/comestibles/carnivore.json
#. ~ Description of "cooked mutant bug organs"
msgid ""
"A selection of cooked mutant bug organs.  Looks awful, but if you give it a "
"try, you'll find -- that it's worse than it looks."
msgstr "各種煮熟的變種蟲器官。看起來倒盡胃口，但如果你試試看，你會發現——它比看起來的還要糟糕。"

#: data/json/items/comestibles/carnivore.json
#. ~ Item name
msgid "pickled offal"
msgid_plural "pickled offal"
msgstr[0] "醃內臟"

