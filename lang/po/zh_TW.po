#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ NPC dialogue line
msgid ""
"We have a grand variety of preselected game modes for you to choose from!  "
"Pick one and play now!"
msgstr "我们有各种预设选项供你选择，选择其中一项并开始游玩！"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Shaun of The Dead</color>: (Defend a bar against classic "
"zombies with your five friends.  Easy and fun.)"
msgstr "<color_yellow>僵尸肖恩</color>：（与你的五个朋友在酒吧抵御经典丧尸。简单而有趣。）"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Dawn of The Dead</color>: (Classic zombies only, slower and "
"more realistic.)"
msgstr "<color_yellow>活死人黎明</color>：（只有经典丧尸，缓慢且更真实）"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Eight-Legged Freaks</color>: (Hordes of spiders!  Not "
"arachnophobia friendly!)"
msgstr "<color_yellow>八角怪</color>：（成群的蜘蛛！对蜘蛛恐惧症者不友好！）"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Day of The Triffids</color>: (Protect your mansion against the "
"triffids.)"
msgstr "<color_yellow>三尖树之日</color>：（抵御三尖树，保卫你的宅邸。）"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "<color_yellow>Skynet</color>: (Robots have decided that humans are the enemy!)"
msgstr "<color_yellow>天网</color>：（机器人已决定将人类视为敌人！）"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>The Call of Cthulhu</color>: (Fend off hordes of eldritch "
"horrors.)"
msgstr "<color_yellow>克苏鲁的呼唤</color>：（抵御成群的异界恐怖。）"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ NPC dialogue line
msgid ""
"Please alter these game options as you wish, make the experience just like "
"you want it."
msgstr "请根据你想要的游戏体验自由更改这些选项。"

