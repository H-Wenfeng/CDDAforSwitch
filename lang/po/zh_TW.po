msgstr "地板在腳下抖動著。"

#: src/monattack.cpp:4055 src/monattack.cpp:4084
msgid "a deafening roar!"
msgstr "震耳欲聾的吼聲！"

#: src/monattack.cpp:4074
#, c-format
msgid "A %s struggles to pull itself free from the %s!"
msgstr "%s 掙扎著從 %s 掙脫出來！"

