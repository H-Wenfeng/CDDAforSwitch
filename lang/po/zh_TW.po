#. ~ Response to NPC dialogue
msgid "Thanks."
msgstr "謝謝。"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Right… I don't want any trouble."
msgstr "好……我不想惹麻烦。"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Smart choice."
msgstr "選得好"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "No, and if you ask again, I'll fucking obliterate you!"
msgstr "不，如果你再问一遍，我他妈的会让你消失！"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "No, fuck off!"
msgstr "不，给我滚开！"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, okay, sorry."
msgstr "好吧, 好吧, 真抱歉。"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Seriously, give me more stuff!"
msgstr "我說真的, 再給我東西!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, fine, bye."
msgstr "好吧, 好, 再見。"

