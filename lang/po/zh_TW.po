#: data/json/items/comestibles/meat_dishes.json
#. ~ Item name
msgid "smoked sausage"
msgid_plural "smoked sausages"
msgstr[0] "煙燻香腸"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Description of "smoked sausage"
msgid "A hefty sausage that has been cured and smoked for long term storage."
msgstr "一條又大又重的香腸， 已經過醃製和煙燻， 可長期保存。"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Conditional name for "smoked sausage" when VITAMIN matches
#. human_flesh_vitamin
msgid "smoked Mannwurst"
msgid_plural "smoked Mannwursts"
msgstr[0] "煙燻人肉香腸"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Conditional name for "smoked sausage" when FLAG matches
#. STRICT_HUMANITARIANISM
msgid "smoked killbasa"
msgid_plural "smoked killbasas"
msgstr[0] "煙燻亞人肉香腸"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Item name
msgid "cooked sausage"
msgid_plural "cooked sausages"
msgstr[0] "煮熟的香腸"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Description of "cooked sausage"
msgid "A hefty cooked sausage.  Better eat it hot and fresh."
msgstr "一大根煮熟的香肠。最好趁热趁新鲜吃。"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Conditional name for "cooked sausage" when VITAMIN matches
#. human_flesh_vitamin
msgid "cooked Mannwurst"
msgid_plural "cooked Mannwursts"
msgstr[0] "熟人肉香腸"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Conditional name for "cooked sausage" when FLAG matches
#. STRICT_HUMANITARIANISM
msgid "cooked killbasa"
msgid_plural "cooked killbasas"
msgstr[0] "熟亞人肉香腸"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Item name
msgid "meat confit"
msgid_plural "meat confit"
msgstr[0] "油封肉"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Description of "meat confit"
msgid ""
"Salted meat slowly cooked in butter or melted fat, a form of food "
"preservation from the days before canning.  Rich and fatty, it will last for "
"a long time."
msgstr "把腌肉慢慢在黄油或融化的脂肪中煮熟，这是在罐装出现前的一种食品保存形式。它肥腻且风味十足，可以保存很长时间。"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Conditional name for "meat confit" when VITAMIN matches
#. human_flesh_vitamin
msgid "con confit"
msgid_plural "con confit"
msgstr[0] "油封人肉"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Conditional name for "meat confit" when FLAG matches
#. STRICT_HUMANITARIANISM
msgid "birdman confit"
msgid_plural "birdman confit"
msgstr[0] "油封亞人肉"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Conditional name for "meat confit" when COMPONENT_ID_SUBSTRING matches
#. mutant
msgid "twisted confit"
msgid_plural "twisted confit"
msgstr[0] "油封變異肉"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Item name
msgid "sweet sausage"
msgid_plural "sweet sausages"
msgstr[0] "甜香腸"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Description of "sweet sausage"
msgid "A sweet and delicious maple-flavored sausage.  Better eat it hot and fresh."
msgstr "一份香甜可口的枫糖浆味香肠，最好趁热趁新鲜吃。"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Item name
msgid "blutwurst"
msgid_plural "blutwursts"
msgstr[0] "血腸"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Description of "blutwurst"
msgid ""
"A type of German sausage made of pre-cooked meat and blood.  Better eat it "
"hot and fresh."
msgstr "一种德式香肠，由预先煮熟的肉和血制成。最好是趁热吃新鲜的。"

#: data/json/items/comestibles/meat_dishes.json
#. ~ Conditional name for "blutwurst" when VITAMIN matches human_flesh_vitamin
msgid "Menschenblutwurst"
msgid_plural "Menschenblutwursts"
msgstr[0] "人血腸"

#: data/json/items/comestibles/meat_dishes.json
