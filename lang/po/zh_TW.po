msgstr "Supply Trader"

#: data/mods/Aftershock/npcs/UICA/ground_quartermaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_quartermaster.json
#. ~ NPC dialogue line
msgid ""
"&You find the Quartermaster lazily reclined against a stack of intermodal "
"crates.  <npc_name> barely acknowledges your presence, their eyes never "
"leaving their PDA as they address you.  Need something salvor?"
msgstr ""
"&You find the Quartermaster lazily reclined against a stack of intermodal "
"crates.  <npc_name> barely acknowledges your presence, their eyes never "
"leaving their PDA as they address you.  Need something salvor?"

#: data/mods/Aftershock/npcs/UICA/ground_quartermaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_quartermaster.json
#. ~ Response to NPC dialogue
msgid "Show me what you have."
msgstr "Show me what you have."

#: data/mods/Aftershock/npcs/UICA/ground_quartermaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_quartermaster.json
#. ~ Response to NPC dialogue
msgid "Can I buy supplies here?"
msgstr "Can I buy supplies here?"

#: data/mods/Aftershock/npcs/UICA/ground_quartermaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_quartermaster.json
#. ~ NPC dialogue line
msgid "&This isn't a store.  Go to the Spaceport if you want to buy supplies."
msgstr "&This isn't a store.  Go to the Spaceport if you want to buy supplies."

#: data/mods/Aftershock/npcs/UICA/ground_quartermaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_quartermaster.json
#. ~ Response to NPC dialogue
msgid "I'm sure we can work something out.  [Bribe $3000]"
msgstr "I'm sure we can work something out.  [Bribe $3000]"

#: data/mods/Aftershock/npcs/UICA/ground_quartermaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_quartermaster.json
#. ~ NPC dialogue line
msgid "&I think you should leave."
msgstr "&I think you should leave."

#: data/mods/Aftershock/npcs/UICA/ground_quartermaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_quartermaster.json
#. ~ NPC dialogue line
msgid "&I already told you no."
msgstr "&I already told you no."

#: data/mods/Aftershock/npcs/UICA/GENERIC/nc_ground_soldier.json
#: data/mods/Aftershock/npcs/UICA/ground_soldier.json
