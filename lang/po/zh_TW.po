#. ~ [DEPRECATED] Don't translate this line.
#. ~ This string is from an obsolete source and will no longer be used in the
#. game.
msgid "Six point six Percent Nether Attunement Chance"
msgstr "异界同调 [6.6%]"

#: data/mods/MindOverMatter/obsolete/nether_attunement_spells.json
#. ~ [DEPRECATED] Don't translate this line.
#. ~ This string is from an obsolete source and will no longer be used in the
#. game.
#, c-format
msgid "6.6% chance to gain nether-attunement."
msgstr "6.6%的几率获得异界同调。"

#: data/mods/MindOverMatter/obsolete/nether_attunement_spells.json
#. ~ [DEPRECATED] Don't translate this line.
#. ~ This string is from an obsolete source and will no longer be used in the
#. game.
msgid "Eight Point Three Percent Nether Attunement Chance"
msgstr "异界同调 [8.3%]"

