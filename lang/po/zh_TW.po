msgstr "UICA Officer"

#: data/mods/Aftershock/npcs/UICA/ground_officer.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_officer.json
#. ~ NPC dialogue line
msgid "Can I help you salvor?"
msgstr "Can I help you salvor?"

#: data/mods/Aftershock/npcs/UICA/ground_officer.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_officer.json
#. ~ NPC dialogue line
msgid "Not right now, I'm busy."
msgstr "Not right now, I'm busy."

