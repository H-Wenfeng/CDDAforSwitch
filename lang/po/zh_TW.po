msgstr "更强的耐酸光环"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Greater Acid Resist Aura"
msgid "You are greatly protected from acid damage."
msgstr "你可以得到极大的保护，免受酸的损害。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_thorns_electric"
msgid "Aura of Repelling Arc"
msgstr "电弧光环"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Aura of Repelling Arc"
msgid "Anyone who attacks you will be electrified."
msgstr "任何攻击你的人都会被触电。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Aura of Repelling Arc"
msgid "The air around you sparks with electricity."
msgstr "你周围的空气充满电流。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Aura of Repelling Arc"
msgid "The air around you loses its charge."
msgstr "你周围的空气不再躁动。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "bio_acidburn"
msgid "Acidic burn"
msgstr "酸性灼傷"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Acidic burn"
msgid "Burned with acid"
msgstr "被強酸燒灼"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/obsoletion_and_migration/effects.json
#. ~ Name of effect type id "haste"
msgid "Hasted"
msgstr "加速"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/obsoletion_and_migration/effects.json
#. ~ Description of effect type "Hasted"
msgid "Your speed is boosted enormously."
msgstr "你的速度得到了極大的提升。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/obsoletion_and_migration/effects.json
#. ~ Apply message of effect type "Hasted"
msgid "Your speed is boosted to superhuman levels!"
msgstr "你的速度提升到超人的程度！"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#: data/mods/Xedra_Evolved/obsoletion_and_migration/effects.json
#. ~ Remove message of effect type "Hasted"
#. ~ Remove message of effect type "Slowed"
#. ~ Remove message of effect type "Blood Haste"
msgid "You return to your normal speed."
msgstr "你恢復正常速度。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Slowed"
msgid "Your speed is magically inhibited."
msgstr "Your speed is magically inhibited."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Slowed"
msgid "Everyone else suddenly seems to speed up!"
msgstr "Everyone else suddenly seems to speed up!"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Synaptic Stimulation"
msgid "Your mental processing is increased."
msgstr "你的心智處理能力提高了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Synaptic Stimulation"
msgid "Your mind accelerates."
msgstr "你的腦袋運作加速了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Synaptic Stimulation"
msgid "Your mind returns to normal speed."
msgstr "你的腦袋恢復正常速度。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Ogre's Strength"
msgid "You have the strength of an Ogre!"
msgstr "你有食人魔的力量！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "safe_shoppers"
msgid "Safe Shopping Experience"
msgstr "安全購物體驗"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Safe Shopping Experience"
msgid "Magical Store Security"
msgstr "魔法商店保全系統"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Safe Shopping Experience"
msgid "You feel very seen!"
msgstr "你覺得自己被人盯上了！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Safe Shopping Experience"
msgid "You no longer feel like somebody's watching you."
msgstr "你不再覺得有人盯著你了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Eagle's Sight"
msgid "You have the perception of an Eagle!"
msgstr "你有鷹的視覺！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Eagle's Sight"
msgid "You notice small details!"
msgstr "你能注意到微小的細節！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Eagle's Sight"
msgid "Your vision returns to normal."
msgstr "你的視力恢復正常。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Cat's Grace"
msgid "You have the dexterity of a cat!"
msgstr "你有貓的靈巧！"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Apply message of effect type "Cat's Grace"
#. ~ Apply message of effect type "Wicked Quick Hands"
msgid "Your reflexes are heightened!"
msgstr "你的反應提高了！"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Remove message of effect type "Cat's Grace"
#. ~ Remove message of effect type "Wicked Quick Hands"
msgid "Your reflexes return to normal."
msgstr "你的反應恢復正常。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Fox's Cunning"
msgid "You have the cunning of a Fox!"
msgstr "你有狐狸的狡猾！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Fox's Cunning"
msgid "Your intelligence is heightened!"
msgstr "你的智力提高了！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Fox's Cunning"
msgid "Your intelligence returns to normal."
msgstr "你的智力恢復正常。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "debug_full_protection"
msgid "Debug Full Protection"
msgstr "除錯完全防護"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Debug Full Protection"
msgid "You can not be harmed by anything."
msgstr "你不會受到任何傷害。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Debug Full Protection"
msgid "Your skin tingle with the power of the Devs!"
msgstr "開發人員的力量使您的皮膚發麻！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Debug Full Protection"
msgid "Your skin stops tingling, your life is empty and meaningless again."
msgstr "你的皮膚不再發麻，你的生活再度空虛又毫無意義。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "feather_fall"
msgid "Pluma"
msgstr "缓降"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Pluma"
msgid "You are light as a feather and fall like one."
msgstr "你像羽毛一樣輕盈飄落。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Pluma"
msgid "Your body feels light as a feather."
msgstr "你的身體就像羽毛一樣輕盈。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Pluma"
msgid "The earth pulls you down hard."
msgstr "大地用力地把你拉下。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "eff_frightful_presence"
msgid "Scared"
msgstr "驚恐"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "eff_frightful_presence"
msgid "Frightened"
msgstr "惶悚"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Scared, Frightened, Terrified"
msgid "Your knees are shaking, your heart beats fast, and your stomach rebels."
msgstr "你的膝蓋在顫抖著，心臟快速跳動，而且反胃。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Scared, Frightened, Terrified"
msgid "You are afraid!"
msgstr "你感到害怕！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Scared, Frightened, Terrified"
msgid "Your fear dissipates."
msgstr "你的恐懼消失了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_catoblepas_gaze"
#. ~ Name of effect type id "effect_catoblepas_gaze_monster"
msgid "Rotting Gaze"
msgstr "Rotting Gaze"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Rotting Gaze"
msgid "You flesh is rotting off!"
msgstr "You flesh is rotting off!"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Rotting Gaze"
msgid "Searing pain fills your body."
msgstr "Searing pain fills your body."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "biomancer_visceral_side_effects"
msgid "Visceral Overexertion"
msgstr "脏腑过劳"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Visceral Overexertion"
msgid ""
"You feel sickened from overtaxing your body, having extended your influence "
"over such a wide area."
msgstr "你因为将自身脏腑过度膨胀以将其覆盖这么大一片范围而感到恶心难受。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Caustic Aura"
msgid ""
"An aura of thin acid, swirling around your body ready to corrode your enemies "
"when struck or while striking."
msgstr ""
"An aura of thin acid, swirling around your body ready to corrode your enemies "
"when struck or while striking."

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Description of effect type "Coagulant Weave"
#. ~ Description of effect type "Blood Weave"
msgid ""
"Immunity to bleeding and bites, increased stamina regeneration, increased "
"hunger and thirst gain."
msgstr "对流血和咬伤免疫，增加耐力重生速度，饥渴增长速度。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Remove message of effect type "Coagulant Weave"
#. ~ Remove message of effect type "Blood Weave"
msgid "The tension running through your flesh fades."
msgstr "你感到血肉中的紧绷感消退了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "biomancer_dart_venom"
msgid "Biomantic Venom"
msgstr "生化毒素"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Biomantic Venom"
msgid "You feel sluggish and weak, from magically-induced poisoning."
msgstr "你感觉到由于生化魔法导致的迟钝及虚弱。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "tornskin_pain"
msgid "Sharp Thorns"
msgstr "尖刺荆棘"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Sharp Thorns"
msgid "Thorns are whirling around you, regularly causing cuts into you."
msgstr "荆棘在你周围旋转，导致你经常被割伤。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Sharp Thorns"
msgid "Thorns in the wind begin slicing into you!"
msgstr "风中的荆棘刺痛着你的身体！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Sharp Thorns"
msgid "The thorns fall to the ground."
msgstr "荆棘都落到地上了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "neuro_boost"
msgid "Mental Boost"
msgstr "精神刺激"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Mental Boost"
msgid "Your mind is working incredibly fast and your body struggles to keep up."
msgstr "你的大脑运转得异常快，而你的身体却在努力跟上。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "vault_atmosphere"
msgid "Vault Air"
msgstr "宝库气息"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Vault Air"
msgid "You feel at home."
msgstr "你感覺自己回到家了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Vault Air"
msgid "This smells like home."
msgstr "這兒聞起來就像是回家一樣。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Vault Air"
msgid "Time to go."
msgstr "該走了。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Magiclysm/migration_and_obsoletion/effects.json
#. ~ Name of effect type id "effect_earthshaper_petrifying_touch"
#. ~ Name of effect type id "effect_petrified"
msgid "Petrified"
msgstr "石化"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Petrified"
msgid "You are made of stone.  Fortunately it's temporary."
msgstr "You are made of stone.  Fortunately it's temporary."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "slow_freeze_effect"
msgid "Slow Freeze"
msgstr "渐冻"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Slow Freeze"
msgid "The cold slows down your foes."
msgstr "寒冷减慢了你的敌人。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "natures_commune"
msgid "Nature's Commune"
msgstr "自然交流"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Nature's Commune"
msgid ""
"You can feel Mother Nature welcoming you, revitalizing your body and calming "
"the natural fauna around you."
msgstr "你能感受到自然之母正欢迎着你的到来，你的身体恢复活力，四周的野生动物也平静下来。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Nature's Commune"
msgid "A warm embrace surrounds you, like that of a mother with her child."
msgstr "一股温暖的怀抱围绕着你，如同母亲抱着她的孩子一般。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Nature's Commune"
msgid "Your communion with Mother Nature fades."
msgstr "你同自然之母的联结逐渐消散。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Cold Heart"
msgid "Full of chilled blood, the heart slows as it grows cold."
msgstr "充满了冰冷的血液，心跳随着变冷而变慢。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Cold Heart"
msgid "You feel yourself getting slower, as ice seems to run through your veins."
msgstr "你感觉自己的速度越来越慢，因为似乎有寒冰流入你的血管。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Cold Heart"
msgid "You feel yourself recovering your normal speed."
msgstr "你感觉自己恢复了正常的速度。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Overdrive"
msgid ""
"Is it possible to dart aside and avoid a cannon ball?  Is it possible to grab "
"an arrow in flight with one hand?"
msgstr "真有可能闪身躲开炮弹吗？真有可能单手抓住飞箭吗？"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Overdrive"
msgid "You feel yourself move faster than a bullet."
msgstr "你觉得自己比子弹还快。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Overdrive"
msgid "You feel yourself returning to your normal speed."
msgstr "你感觉自己回到了正常速度。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "alkahest"
msgid "Stepped on alkahest"
msgstr "踩上万能溶剂"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Stepped on alkahest"
msgid "You're standing in alkahest!"
msgstr "你踩到了万能溶剂！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "biomechanic"
msgid "Biomechanism"
msgstr "生物力学"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Biomechanism"
msgid "Hunt.  Let them feel."
msgstr "猎杀。让他们感受一下。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Biomechanism"
msgid "Your body returns to its normal state."
msgstr "你的身体回归一般状态。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "ice_energy"
msgid "Ice erosion"
msgstr "冰霜侵蚀"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Ice erosion"
msgid "Ice crystals erode your body from all directions."
msgstr "冰晶从各个方向侵蚀你的身体。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "eshaper_melee_damage"
msgid "Heft"
msgstr "沉重"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Heft"
msgid ""
"Your body is heavy as the heaviest rocks.  Your attack speed is slowed down, "
"but your melee damage increased drastically."
msgstr "你的身体像最重的岩石一样沉。你的攻击速度减慢，但近战伤害大幅提升。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Heft"
msgid "You feel your body compress and harden."
msgstr "你感觉你的身体像被压缩并且变硬。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Heft"
msgid "You no longer feel encumbered."
msgstr "你不再感到累赘。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Invisible"
msgid "Your invisibility fades."
msgstr "你的隐身效果消失了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Machine Mind"
msgid "You have an intuitive understanding of computers."
msgstr "你对计算机多了些直观的理解。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Machine Mind"
msgid "Your mind no longer easily grasps the flow of electrons."
msgstr "你对于机器的思考力消失了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "The Body Mechanical"
msgid "Your body functions through pain with mechanical efficiency."
msgstr "尽管有些痛苦，你的身体动作仍如机器一般高效。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "The Body Mechanical"
msgid "Pain suddenly hampers you again."
msgstr "你再次受疼痛所束缚。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Crystal Wrapping"
msgid ""
"Thin layer of almost living crystals, that rapidly grows and moves on the "
"body."
msgstr "如同有生命般的薄层水晶，在身上迅速生长和移动。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Crystal Wrapping"
msgid "You feel a light, purple material cover your body and clothes."
msgstr "你感觉到一种轻薄的紫色物质覆盖了你的身体和衣物。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Crystal Wrapping"
msgid "The crystals crumble."
msgstr "水晶碎裂开来。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Electric Eye"
msgid ""
"Enhance your sight with your powers.  It allows you to see creatures of the "
"same energy around you, and some minor bonuses."
msgstr "用你的能量增强你的视力。它可以让你看到周围有同样能量的生物，还有一些别的效果。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Electric Eye"
msgid "Your sight is enhanced."
msgstr "你的目力强化了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Electric Eye"
msgid "Your sight turn back to usual state."
msgstr "你的视野恢复到了正常状态。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Electric Waves"
msgid "Your body will release a massive electric charges when you attack monsters."
msgstr "你的身体在攻击怪物时释放出无数电荷。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Electric Waves"
msgid "A powerful energy streams out of your hands."
msgstr "一股强大的能量从你的手中释放出来。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Electric Waves"
msgid "The energy streams calm down."
msgstr "能量的流动平息了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Electric Arts"
msgid "Make you less vulnerable to electric damage."
msgstr "使你受到的电击伤害减少。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Electric Arts"
msgid "You feel a small sparks under your skin.  They do not harm you."
msgstr "你感觉到皮肤下有点小火花。它们并没有伤害到你。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Electric Arts"
msgid "Sparks under your skin vanish."
msgstr "你皮肤下的火花消失了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "ice_age_eff"
msgid "Glaciation"
msgstr "冰川作用"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Glaciation"
msgid ""
"You are frozen, your bones are fragile; cracking in the cold, and your "
"muscles are cut by razor sharp ice."
msgstr "你被冻住了，你的骨头变得很脆弱，它们因寒冷而破碎，你的肌肉被锋利的冰割伤。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flower_fern_eff"
msgid "Positivity"
msgstr "积极乐观"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Positivity"
msgid "Your feel yourself a bit better."
msgstr "你感觉自己好了一些。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "glowing_mushroom_eff"
msgid "Lightness"
msgstr "轻盈"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Lightness"
msgid "You feel yourself a bit lighter.  You doubt you can lose weight from this."
msgstr "你觉得自己更轻盈了。但你不觉得自己的体重会因此下降。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flask_speed_eff"
msgid "Velocitas"
msgstr "迅捷"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Velocitas"
msgid "Make you faster, and allow to hold this state for a while."
msgstr "让你在一段时间内速度更快。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Velocitas"
msgid "You feel your legs can work much better than before"
msgstr "你感觉腿脚比以前更好使了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Velocitas"
msgid "Your speed slows down."
msgstr "你的速度慢了下来。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flask_healing_eff"
msgid "Sanatio"
msgstr "治愈"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Sanatio"
msgid "Improve your organism's ability to heal himself."
msgstr "增强你有机身体的自愈能力。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flask_stamina_eff"
msgid "Constantia"
msgstr "康斯坦提亚烈酒"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Constantia"
msgid "You can't get tired."
msgstr "你变得不知疲惫。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Constantia"
msgid "You feel an energy in your muscles, jazzed up and full of vitality."
msgstr "你会感觉到肌肉充满能量，充满活力。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Remove message of effect type "Constantia"
#. ~ Remove message of effect type "Circulatory"
msgid "The energy in your body fades away."
msgstr "你身体里的能量消失了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flask_excitement"
msgid "Motus"
msgstr "海浪"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Motus"
msgid "Your reaction now is way better than before."
msgstr "你的反应能力显著提升了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Motus"
msgid "You can feel the fly wings movement now."
msgstr "你感觉健步如飞。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Motus"
msgid "Your reflexes turn back to normal."
msgstr "你的反应恢复正常。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flask_resistance"
msgid "Resistentia"
msgstr "抵御"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Resistentia"
msgid ""
"A thin layer of energy covers your body, and allows you to take more physical "
"damage than before."
msgstr "薄薄的能量层覆盖着你的身体，让你能承受比以前更多的物理伤害。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Resistentia"
msgid "Your touch sense are blunted for a bit, but your skin feels more dense."
msgstr "你的触觉有一点迟钝，但你的皮肤感觉更致密了。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Remove message of effect type "Resistentia"
#. ~ Remove message of effect type "Endurance"
msgid "The sturdy feeling is gone."
msgstr "身体的坚固感消失了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flask_illumination"
msgid "Illuminatio"
msgstr "照耀"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Illuminatio"
msgid "Your body emit a lot of light around."
msgstr "你的身体向周围散发出大量光芒。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Illuminatio"
msgid "Your skin glow like an old lantern.  You feel no discomfort for some reason."
msgstr "你的皮肤像旧灯笼一样在发光。不过出于某种原因，你没有感到不适。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Illuminatio"
msgid "Your skin turn back to normal state."
msgstr "你的皮肤恢复到了正常状态。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flask_mana_regen"
msgid "Recuperatio"
msgstr "魔力恢复"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Recuperatio"
msgid ""
"Increase the amount of ley-lines your body can process at once, making you "
"restore your mana pool faster."
msgstr "增加你的身体一次能处理的灵脉数量，使你更快地恢复魔力池。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Recuperatio"
msgid "You can feel the thinnest ley lines around you."
msgstr "你能感受到身边最纤细的灵脉。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Recuperatio"
msgid "The mana senses blunts."
msgstr "对魔力的感应又变得迟钝了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "flask_max_mana"
msgid "Augere"
msgstr "魔力扩容"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Augere"
msgid "Increase the amount of mana you can operate."
msgstr "增加你可以操控的魔力量。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Augere"
msgid "You feel a deep mana well inside your body."
msgstr "你感觉到身体里存储的魔力进入了一口深井。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Augere"
msgid "Your well feels empty now."
msgstr "你无法再感受到那口深井了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Regeneration"
msgid "Slowly regenerate your damaged body."
msgstr "缓慢地使你受损的身体再生。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Regeneration"
msgid "Your flesh and bones start to regenerate before your eyes."
msgstr "你的骨肉开始以可见的速度再生。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "technomancer_cl_booster_effect"
msgid "Technomancer boost"
msgstr "科技法师强化"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Technomancer boost"
msgid "Your technomancer spells are empowered."
msgstr "你的科技法师咒语得到了增强。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Technomancer boost"
msgid "Your technomancer boost fades."
msgstr "你的科技法师的提升会逐渐消失。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "biomancer_cl_booster_effect"
msgid "Biomancer boost"
msgstr "生化术士强化"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Biomancer boost"
msgid "Your biomancer spells are empowered."
msgstr "你的生化术士咒语得到了增强。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Biomancer boost"
msgid "Your biomancer boost fades."
msgstr "你的生化术士的提升会逐渐消失。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Stones' Fortitude"
msgid "You feel little hunger or thirst."
msgstr "你几乎感觉不到饥饿或口渴。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Stones' Fortitude"
msgid "Your stomach suddenly rumbles as you feel a pang of hunger."
msgstr "你的肚子突然咕咕叫了起来，感到一阵饥饿。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Tremorsense"
msgid "You can feel them moving around you."
msgstr "你可以感觉到他们在你周围移动。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Tremorsense"
msgid "You can no longer discern the vibrations of the living earth."
msgstr "你再也无法辨别生命土地的振动。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_sense_outsiders"
msgid "Sense Outsider"
msgstr "界外感知"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Sense Outsider"
msgid "You can sense the presence of things that should not be."
msgstr "你可以感觉到不应该存在的东西的存在。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Sense Outsider"
msgid "Your awareness of outsiders fades."
msgstr "你对界外的感知逐渐减弱。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Witchsight"
msgid "You can sense nearby magic-wielders."
msgstr "You can sense nearby magic-wielders."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Witchsight"
msgid "Your awareness of the magically-inclined fades."
msgstr "Your awareness of the magically-inclined fades."

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Magiclysm/items/bionics.json
#. ~ Description of creature revealed by special vision "wizard_sense"
#. ~ Description of creature revealed by special vision "fae_sense"
msgid "You see the ley lines of a wielder of magic."
msgstr "You see the ley lines of a wielder of magic."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Guardian Spirit"
msgid "A protective spirit is looking out for you."
msgstr "灵体守护着你。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Guardian Spirit"
msgid "With a soft whisper, the guardian spirit returns from whence it came."
msgstr "伴随一声低语，你的守护灵离开了你。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "The Inner Voice"
msgid "Your soul gives voice to your magical prowess."
msgstr "Your soul gives voice to your magical prowess."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "The Inner Voice"
msgid "Your soul no longer speaks directly."
msgstr "Your soul no longer speaks directly."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Water's Cooling Touch"
msgid "Your skin feels like you just splashed cool water on it."
msgstr "你的皮肤好像刚被泼了凉水。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Water's Cooling Touch"
#. ~ Remove message of effect type "Cloak of Chill"
msgid "A warm breeze hits your skin."
msgstr "一阵暖风吹拂你的皮肤。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Cloak of Warmth"
msgid "The air around you is warmer thanks to your magic."
msgstr "由于你的魔法，你周围的空气变得温暖。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Remove message of effect type "Cloak of Warmth"
msgid "A cool breeze hits your skin."
msgstr "一阵冷风吹拂你的皮肤。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Cloak of Chill"
msgid "The air around you is cooler thanks to your magic."
msgstr "由于你的魔法，你周围的空气变得凉爽。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Flames of Passion"
msgid "You burn with the intensity of your conviction."
msgstr "You burn with the intensity of your conviction."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Flames of Passion"
msgid "The world seems dreary as your spell fades."
msgstr "世界在你的法术消散后显得沉闷不堪。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Slowfall"
msgid "You won't hit the ground nearly as hard anymore."
msgstr "你几乎不会再那么用力地撞击地面了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Slowfall"
msgid "You can feel gravity take hold of you again."
msgstr "你感到大地又一次承载了你。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Spider Climb"
msgid "You can quickly ascend sheer surfaces."
msgstr "你可以快速攀登陡峭的表面。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Spider Climb"
msgid "Your enhanced climbing ability vanishes."
msgstr "你增强的攀爬能力恢复如常。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Arrowflight"
msgid "Your ranged weapons travel much further than physics claims they should."
msgstr "Your ranged weapons travel much further than physics claims they should."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Arrowflight"
msgid "Your weapons return to their normal range."
msgstr "Your weapons return to their normal range."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Faerie Fire"
msgid "You are glowing."
msgstr "You are glowing."

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/MindOverMatter/effects/effects_psionic.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Remove message of effect type "Faerie Fire"
#. ~ Remove message of effect type "Illuminated"
#. ~ Remove message of effect type "Witchfire"
msgid "The glow around you fades."
msgstr "The glow around you fades."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_biomancer_swim_speed"
msgid "Frog Limbs"
msgstr "青蛙肢体"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Frog Limbs"
msgid "Your hands and feet have grown webbing, enabling faster swimming."
msgstr "你的手和脚长出了蹼，可以更快地游泳。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Frog Limbs"
msgid "With an unpleasant twisting sensation your hands and feet return to normal."
msgstr "带着不悦的扭曲感，你的手脚恢复正常。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Lashing Tentacles"
msgid "Two tentacles sprout from your shoulders, ready to attack your enemies."
msgstr "Two tentacles sprout from your shoulders, ready to attack your enemies."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Lashing Tentacles"
msgid "Your shoulders itch before two barbed tentacles erupt from them!"
msgstr "你的肩膀发痒，然后两根带刺的触手从肩膀上冒出来"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Magiclysm/migration_and_obsoletion/eocs.json
#. ~ Remove message of effect type "Lashing Tentacles"
#. ~ Player message in effect in EoC "EOC_LASHING_TENTACLES_MUTATION_REMOVE"
msgid "The tentacles recede back into your body."
msgstr "触手缩回你的身体。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Caustic Blood"
msgid "You have transformed your blood into acid."
msgstr "You have transformed your blood into acid."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Caustic Blood"
msgid "Your entire body burns for a moment."
msgstr "Your entire body burns for a moment."

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Magiclysm/migration_and_obsoletion/eocs.json
#. ~ Remove message of effect type "Caustic Blood"
#. ~ Player message in effect in EoC "EOC_BIO_CAUSTIC_BLOOD_MUTATION_REMOVE"
msgid "The faint burning sensation fades."
msgstr "微弱的灼烧感消失了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_biomancer_remove_instability"
msgid "Increased Stability"
msgstr "增加稳定性"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Increased Stability"
msgid "You are defended against the possible effects of XE037 overexposure."
msgstr "您正在抵抗 XE037 过度曝光可能造成的影响。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Increased Stability"
msgid ""
"You are still defended against the effects of XE037 overexposure but now you "
"feel awful!"
msgstr "您仍在抵抗 XE037 过度曝光的后遗症，但现在您感觉很糟糕！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Increased Stability"
#. ~ Apply message of effect type "Morphogenic Mastery"
msgid "You feel…strange."
msgstr "你感觉......奇怪。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Increased Stability"
#. ~ Remove message of effect type "Morphogenic Mastery"
msgid "The strange feeling passes and you feel more like yourself."
msgstr "奇怪的感觉消失，你觉得自己又一次变得像自己了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Morphogenic Mastery"
msgid "You are able to exert conscious control over any mutations to your body."
msgstr "You are able to exert conscious control over any mutations to your body."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Carrion Feast"
msgid "You can eat rotten food without any trouble, if you can stand the taste."
msgstr "如果你能忍受腐烂的味道，你可以毫不费力地吃腐烂的食物。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Carrion Feast"
msgid "Your have a hunger for some overly-aged meat."
msgstr "你渴望食用腐肉。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Carrion Feast"
msgid "You can't believe you even considered eating that!  Yuck!"
msgstr "你简直不能相信自己居然想过要吃那种东西！哕！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_classless_watch"
msgid "Know the Day and the Hour"
msgstr "知晓时间"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Know the Day and the Hour"
msgid "You know exactly what time it is."
msgstr "你清楚地知道现在是什么时间。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Know the Day and the Hour"
msgid "Your perfect sense of time fades away."
msgstr "你精确的时间感知消失了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Peaceful Rest"
msgid "You feel pretty sleepy."
msgstr "你觉得无比困倦。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Burning Trail"
msgid "Fire trails in your wake."
msgstr "Fire trails in your wake."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Burning Trail"
msgid "The flames you leave behind die down."
msgstr "The flames you leave behind die down."

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Description of effect type "Cloak of Fog"
msgid "The fog shields you from sight."
msgstr "雾挡住了你的视线。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Remove message of effect type "Cloak of Fog"
msgid "The fog begins to dissipate."
msgstr "雾开始散去。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Heart of the Hurricane"
msgid "Barely-controlled winds rage around you."
msgstr "难以控制的狂风在你周围肆虐。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Remove message of effect type "Heart of the Hurricane"
#. ~ Remove message of effect type "Hindering Winds"
msgid "The wind around you dies down."
msgstr "环绕着你的风停息了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Thundering Voice"
msgid "Every word you speak resounds like a crash of thunder."
msgstr "你所说的每个字都振聋发聩，犹如雷鸣。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Thundering Voice"
msgid "Your voice returns to normal."
msgstr "你的嗓音恢复如初。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Corporeal Reconstitution"
msgid "You are healing unbelievably quickly."
msgstr "你的回复速度快得不可思议。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Corporeal Reconstitution"
msgid "Your rapid regeneration slows and stops."
msgstr "你的快速回复能力消失了。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Description of effect type "Halt Bleeding"
#. ~ Description of effect type "Coagulation"
msgid "You bleed less than normal."
msgstr "你流血的速度减慢了。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Description of effect type "Halt Bleeding"
#. ~ Description of effect type "Coagulation"
msgid "You bleed much less than normal."
msgstr "你流血的速度大大减慢了。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Halt Bleeding"
msgid "You do not bleed.  At all."
msgstr "你不再流血。滴血不落。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Gluttonous Consumption"
msgid "You feel like you could eat a horse."
msgstr "你觉得自己饿的能吃下一头牛。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_flesh_rending"
msgid "Rending"
msgstr "撕裂"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Rending"
msgid "Your flesh is twisting itself apart!"
msgstr "你的肉体正在扭曲自己！"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Apply message of effect type "Rending"
msgid "Your flesh writhes where you were hit!"
msgstr "你被打之处饱受痛苦。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_teleport_anchor"
msgid "Teleport Anchor"
msgstr "传送锚"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/MindOverMatter/effects/effects_penalty.json
#. ~ Description of effect type "Teleport Anchor"
#. ~ Description of effect type "Teleport Lock"
msgid "You're not going anywhere."
msgstr "你哪儿也不能去。"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/MindOverMatter/effects/effects_monster.json
#: data/mods/MindOverMatter/effects/effects_psionic.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Name of effect type id "effect_flame_immunity"
#. ~ Name of effect type id "effect_monster_pyrokinetic_fire_immunity"
#. ~ Name of effect type id "effect_pyrokinetic_flame_immunity"
msgid "Flame Immunity"
msgstr "火焰免疫"

#: data/mods/Magiclysm/effects/effects.json
#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Description of effect type "Flame Immunity"
msgid "You are immune to heat and fire."
msgstr "你绝热绝火。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Name of effect type id "effect_spirit_walking"
msgid "Spirit Walking"
msgstr "灵体出游"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Spirit Walking"
msgid "You have shed your physical form."
msgstr "你已摆脱肉身。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Mageshield"
msgid "Your mageshield fades as the attack impacts it."
msgstr "Your mageshield fades as the attack impacts it."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Silence"
msgid "You are completely silent."
msgstr "You are completely silent."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Silence"
msgid "Your footsteps make noise again."
msgstr "Your footsteps make noise again."

#: data/mods/Magiclysm/effects/effects.json
#. ~ Description of effect type "Traverse the Wilds"
msgid "Nature is speeding your passage."
msgstr "自然加快了你的脚步。"

#: data/mods/Magiclysm/effects/effects.json
#. ~ Remove message of effect type "Traverse the Wilds"
msgid "Nature no longer speeds your movements."
msgstr "自然不再为你提供增速了。"

#: data/mods/Magiclysm/effects/effects.json data/mods/Sky_Island/effects.json
#. ~ Description of effect type "Water Strider's Walk"
#. ~ Description of effect type "Warped Waterwalking"
msgid "You can walk on the surface of the water"
msgstr "You can walk on the surface of the water"

#: data/mods/Magiclysm/effects/effects.json data/mods/Sky_Island/effects.json
