msgid "aenor chick"
msgid_plural "aenor chicks"
msgstr[0] "aenor chicks"

#: data/mods/Magiclysm/monsters/domestic.json
#. ~ Description of monster "aenor chick"
msgid ""
"An aenor chick, already as tall as a human's waist.  It still has a long way "
"to go before it can bear a rider."
msgstr ""
"An aenor chick, already as tall as a human's waist.  It still has a long way "
"to go before it can bear a rider."

