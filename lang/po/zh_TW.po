msgid_plural "basecamp clay kilns"
msgstr[0] "營寨陶窯"

#: data/json/items/basecamp.json
#. ~ Item name
msgid "basecamp fireplace"
msgid_plural "basecamp fireplaces"
msgstr[0] "營寨壁爐"

#: data/json/items/basecamp.json data/json/items/tool/pseudo.json
#. ~ Item name
msgid "basecamp stove"
msgid_plural "basecamp stoves"
msgstr[0] "營寨火爐"

#: data/json/items/basecamp.json
