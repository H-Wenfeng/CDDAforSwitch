#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Hey, can you hear me?"
msgstr "嘿，你能聽見我嗎？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "I think I know what I'm doing."
msgstr "我知道我在做什么。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Don't touch me."
msgstr "別碰我。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "What's your name?"
msgstr "你的名字是什麼？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "I thought you were my friend."
msgstr "我以為你是我的朋友。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Shut up!  Don't lie to me."
msgstr "闭嘴！别想对我说谎！"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "How do I bring you back?"
msgstr "怎么才能让你回去？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "They're all gone…"
msgstr "走了，他们都走了……"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Why did you leave me?"
msgstr "为什么你要离开我?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Oh, there you are."
msgstr "噢，这是你。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "…and just where have you been?"
msgstr "……你刚刚哪儿去了？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "You hungry?  I've got plenty of food."
msgstr "你饿吗？我有吃的。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "You thirsty?  I've got water."
msgstr "你渴吗？我有水。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Please don't go."
msgstr "别走好吗。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Don't leave me alone!"
msgstr "不要放我一個人！"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "No way man."
msgstr "不可能的，伙计。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Do you really think so?"
msgstr "你真的這麼想？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Is it really time for that?"
msgstr "這時候真的要這樣做？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Sorry, I can't hear you."
msgstr "抱歉，我聽不到你。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "You've told me already."
msgstr "你已經告訴過我了。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "I know!"
msgstr "我知道了！"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Where the hell am I?"
msgstr "这特么的又是哪？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Why are you following me?"
msgstr "你為什麼跟著我？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "This place is dangerous, we shouldn't be here."
msgstr "这里很危险，别在这呆着。"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "That's not true, is it?"
msgstr "這不是真的吧？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Are you hurt?"
msgstr "你受傷了嗎？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Tell me where it hurts."
msgstr "你伤到哪了？"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Why can't you see them?"
msgstr "Why can't you see them?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Who are you really?"
msgstr "Who are you really?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "What are you hiding from me?"
msgstr "What are you hiding from me?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "You're lying, aren't you?"
msgstr "You're lying, aren't you?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "What if they come back?"
msgstr "What if they come back?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Do you know the way out?"
msgstr "Do you know the way out?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Can you keep a secret?"
msgstr "Can you keep a secret?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Don't trust anyone."
msgstr "Don't trust anyone."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Everything is a lie."
msgstr "Everything is a lie."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "They're watching us."
msgstr "They're watching us."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "It's all a game, isn't it?"
msgstr "It's all a game, isn't it?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "We're just pawns in their game."
msgstr "We're just pawns in their game."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Why can't I remember?"
msgstr "Why can't I remember?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "What did they do to you?"
msgstr "What did they do to you?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Why did you betray me?"
msgstr "Why did you betray me?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "You have to believe me."
msgstr "You have to believe me."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Why won't you listen to me?"
msgstr "Why won't you listen to me?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "I know what I saw."
msgstr "I know what I saw."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Do you think I'm crazy?"
msgstr "Do you think I'm crazy?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "I heard them talking about us."
msgstr "I heard them talking about us."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Why can't you see it?"
msgstr "Why can't you see it?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "Everything is falling apart."
msgstr "Everything is falling apart."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
msgid "I can't trust my own mind."
msgstr "I can't trust my own mind."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_self_talk"
