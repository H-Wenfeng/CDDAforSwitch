#: data/json/items/tool/lighting.json
#. ~ "need_charges_msg" action message of item "acetylene lamp (off)"
#, c-format
msgid "The %s must be attached to a gas cylinder to light."
msgstr "%s 必須連接到瓦斯罐才能用來照明。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "acetylene lamp (on)"
msgid_plural "acetylene lamps (on)"
msgstr[0] "乙炔燈（開啟）"

#: data/json/items/tool/lighting.json
#. ~ "msg" action message of item "acetylene lamp (on)"
#, c-format
msgid "The %s is extinguished"
msgstr "%s 熄滅了。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "reading light"
msgid_plural "reading lights"
msgstr[0] "閱讀燈"

#: data/json/items/tool/lighting.json
#. ~ Description of "reading light"
msgid "A little clip-on LED light, meant for reading books in the dark."
msgstr "一個附有夾子的小型LED燈，用作在黑暗中閱讀。"

#: data/json/items/tool/lighting.json
#. ~ "msg" action message of item "reading light"
msgid "You switch on the reading light."
msgstr "你開啟了閱讀燈。"

#: data/json/items/tool/lighting.json
#. ~ "need_charges_msg" action message of item "reading light"
msgid "The reading light winks out."
msgstr "閱讀燈熄滅了。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "reading light (active)"
msgid_plural "reading lights (active)"
msgstr[0] "閱讀燈（打開）"

#: data/json/items/tool/lighting.json
#. ~ Description of "reading light (active)"
msgid ""
"A little clip-on LED light, meant for reading books in the dark.  This one is "
"turned on."
msgstr "一個附有夾子的小型LED燈，用作在黑暗中閱讀。這個是開啟了的。"

#: data/json/items/tool/lighting.json
#. ~ "msg" action message of item "reading light (active)"
msgid "You switch off the reading light."
msgstr "你關閉了閱讀燈。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "smart lamp (off)"
msgid_plural "smart lamps (off)"
msgstr[0] "智慧燈 (關閉)"

#: data/json/items/tool/lighting.json
#. ~ Description of "smart lamp (off)"
msgid "A smart lamp that can be activated remotely."
msgstr "这是一个遥控灯，它可以遥控激活。"

#: data/json/items/tool/lighting.json
#. ~ "msg" action message of item "smart lamp (off)"
msgid "You turn the smart lamp on."
msgstr "你打開了智慧燈。"

#: data/json/items/tool/lighting.json
#. ~ "need_charges_msg" action message of item "smart lamp (off)"
msgid "The smart lamp batteries are dead."
msgstr "智慧燈斷電了。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "smart lamp (on)"
msgid_plural "smart lamps (on)"
msgstr[0] "智慧燈 (啟動)"

#: data/json/items/tool/lighting.json
#. ~ Description of "smart lamp (on)"
msgid "A smart lamp which can be deactivated remotely.  Currently it is turned on."
msgstr "一种可以远程遥控的智能灯。目前它已打开。"

#: data/json/items/tool/lighting.json
#. ~ "msg" action message of item "smart lamp (on)"
msgid "Your smart lamp turned off."
msgstr "你的智慧燈關閉了。"

#: data/json/items/tool/lighting.json data/mods/MMA/bludgeons.json
#: data/mods/innawood/items/lighting.json
#. ~ Item name
msgid "torch"
msgid_plural "torches"
msgstr[0] "火炬"

#: data/json/items/tool/lighting.json
#. ~ Description of "torch"
msgid ""
"A large stick wrapped in rags that are soaked with flammable material.  When "
"lit, it produces a fair amount of light.  You'll need a lighter or matches to "
"light it."
msgstr "浸透了可燃材料的布胡乱地缠在棍子上，点燃了似乎就能照亮四周。找个打火机或者划根火柴点着它。"

#: data/json/items/tool/lighting.json
#: data/mods/Magiclysm/items/enchanted_misc.json
#. ~ "menu_text" action message of item "torch"
#. ~ "menu_text" action message of item "everburning torch"
msgid "Light torch"
msgstr "點燃火炬"

#: data/json/items/tool/lighting.json
#: data/mods/Magiclysm/items/enchanted_misc.json
#. ~ "msg" action message of item "torch"
#. ~ "msg" action message of item "everburning torch"
msgid "You light the torch."
msgstr "你點燃了火炬。"

#: data/json/items/tool/lighting.json
#. ~ Description of "torch"
msgid ""
"A large stick wrapped in rags that are soaked with flammable material.  It is "
"burning, producing plenty of light."
msgstr "浸透了可燃材料的布胡乱地缠在棍子上，正在燃烧，光芒四射。"

#: data/json/items/tool/lighting.json
#: data/mods/Magiclysm/items/enchanted_misc.json
#: data/mods/innawood/items/lighting.json
#. ~ "msg" action message of item "torch"
#. ~ "msg" action message of item "everburning torch"
msgid "The torch is extinguished."
msgstr "火炬熄滅了。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "propane lantern (off)"
msgid_plural "propane lanterns (off)"
msgstr[0] "丙烷燈（關）"

#: data/json/items/tool/lighting.json
#. ~ Description of "propane lantern (off)"
msgid ""
"A small propane-powered lantern.  It does not provide much light, but it "
"lasts a long time.  Use it to turn it on."
msgstr "小型丙烷燃料灯笼。它的光线较弱，但它的持续时间较长。用的时候请打开它。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "propane lantern (on)"
msgid_plural "propane lanterns (on)"
msgstr[0] "丙烷燈（開）"

#: data/json/items/tool/lighting.json
#. ~ Description of "propane lantern (on)"
msgid ""
"A small propane-powered lantern.  It does not provide much light, but it "
"lasts a long time.  It is turned on.  Use it to turn it off."
msgstr "小型丙烷燃料灯笼。它的光线较弱，但它的持续时间较长。它正亮着呢，不用时请关掉它。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "small candle"
msgid_plural "small candles"
msgstr[0] "细蜡烛"

#: data/json/items/tool/lighting.json
#. ~ Description of "small candle"
msgid ""
"A thin wax candle.  It doesn't provide very much light and will burn "
"relatively quickly.  You'll need a lighter or matches to light it."
msgstr "一只细长的蜡烛，能发出微弱的光线，但燃烧时间较短。你需要打火机或火柴来点燃。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "burning small candle"
msgid_plural "burning small candles"
msgstr[0] "燃烧的小蜡烛"

#: data/json/items/tool/lighting.json
#. ~ Description of "burning small candle"
msgid ""
"A thin wax candle.  It doesn't provide very much light and will burn "
"relatively quickly.  This candle is lit."
msgstr "一只细长的蜡烛，能发出微弱的光线，但燃烧时间较短。这只已经点燃了。"

#: data/json/items/tool/lighting.json
#. ~ Item name
msgid "menorah"
msgid_plural "menorahs"
msgstr[0] "烛台"

#: data/json/items/tool/lighting.json
#. ~ Description of "menorah"
msgid ""
"An eight-branched candelabra more properly called a 'hanukkiah', the menorah "
"is used to celebrate the Jewish festival of Hanukkah."
msgstr "一种有八个灯座的烛台，更准确的名称是“哈努基亚”，用于庆祝犹太人的光明节。"

#: data/json/items/tool/masonry.json
#. ~ Item name
msgid "masonry saw (off)"
msgid_plural "masonry saws (off)"
msgstr[0] "切磚機（關）"

#: data/json/items/tool/masonry.json
#. ~ Description of "masonry saw (off)"
msgid ""
"A construction tool for cutting through concrete or other surfaces.  It runs "
"on gasoline.  Using this item will cause it to turn on, turning it into a "
"very powerful but unwieldy melee weapon or a terrible chainsaw."
msgstr "一台用于切割混凝土或其他表面的建筑工具。它以汽油为燃料。使用它以将它启动，使其成为非常强大但笨拙的近战武器或是一台糟糕的链锯。"

#: data/json/items/tool/masonry.json
#. ~ value of variable 'success_message' in effect in EoC
#. "EOC_toolweapon_activate__masonrysaw" in use action of item "masonry saw
#. (off)"
msgid "With a roar, the <npc_name> screams to life!"
msgstr "随着一声轰鸣，<npc_name>猛烈地转动起来！"

#: data/json/items/tool/masonry.json
#. ~ Item name
msgid "masonry saw (on)"
msgid_plural "masonry saws (on)"
msgstr[0] "切磚機（開）"

#: data/json/items/tool/masonry.json
#. ~ Description of "masonry saw (on)"
msgid "This masonry saw is on and making a lot of noise.  Use it to turn it off."
msgstr "石材切割机已经启动，发出可怕的噪声。激活它来关闭。"

#: data/json/items/tool/masonry.json
#. ~ value of variable 'sound_message' in effect in EoC
#. "EOC_toolweapon_running__masonrysaw" in use action of item "masonry saw
#. (on)"
msgid "Your masonry saw buzzes."
msgstr "你的石材切割机吱吱作响。"

#: data/json/items/tool/masonry.json
#. ~ Item name
msgid "electric masonry saw (off)"
msgid_plural "electric masonry saws (off)"
msgstr[0] "电动石材切割机（关）"

#: data/json/items/tool/masonry.json
#. ~ Description of "electric masonry saw (off)"
msgid ""
"A construction tool for cutting through concrete or other surfaces.  It uses "
"electric motor with integrated battery and is compatible with a UPS.  Using "
"this item will cause it to turn on, turning it into a very powerful but "
"unwieldy melee weapon or a terrible chainsaw."
msgstr ""
"一台用于切割混凝土或其他表面的建筑工具。它采用带有集成电池的电动马达，并兼容UPS供电系统。使用它以将它启动，使其成为非常强大但笨拙的近战武器或是一台糟糕的"
"链锯。"

#: data/json/items/tool/masonry.json
#. ~ "msg" action message of item "electric masonry saw (off)"
msgid "You turn on the masonry saw."
msgstr "你启动了石材切割机。"

#: data/json/items/tool/masonry.json
#. ~ Item name
msgid "electric masonry saw (on)"
msgid_plural "electric masonry saws (on)"
msgstr[0] "电动石材切割机（开）"

#: data/json/items/tool/masonry.json
#. ~ Description of "electric masonry saw (on)"
msgid ""
"This electric masonry saw is on and making a lot of noise.  Use it to turn it "
"off."
msgstr "电动石材切割机已经启动，发出可怕的噪声。激活它来关闭。"

#: data/json/items/tool/masonry.json
#. ~ value of variable 'sound_message' in effect in EoC
#. "EOC_toolweapon_running__electric_masonrysaw" in use action of item
#. "electric masonry saw (on)"
msgid "Your electric masonry saw buzzes."
msgstr "你的电动石材切割机吱吱作响。"

#: data/json/items/tool/masonry.json
#. ~ Item name
msgid "grinder blade"
msgid_plural "grinder blades"
msgstr[0] "角磨刀片"

#: data/json/items/tool/masonry.json
#. ~ Description of "grinder blade"
msgid ""
"A 125 mm angle grinder blade.  You could make a power tool with it, or throw "
"it.  Wielding it without sturdy gloves is a bad idea."
msgstr "125 mm 的角磨机刀片。可以用于制作角磨机，也可以用于投掷。没戴结实的手套时最好不要拿在手上。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "adhesive bandage"
msgid_plural "adhesive bandages"
msgstr[0] "OK繃"

#: data/json/items/tool/med.json
#. ~ Description of "adhesive bandage"
msgid ""
"A small medical dressing made of a piece of sterile cloth and sticky tape, "
"used for small injuries not serious enough to require a full-size bandage."
msgstr "一片小型医用敷料，由一块无菌布和胶带组成，用于治疗那些尚不严重到需要全尺寸绷带的小伤口。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "alcohol wipe"
msgid_plural "alcohol wipes"
msgstr[0] "酒精濕巾"

#: data/json/items/tool/med.json
#. ~ Description of "alcohol wipe"
msgid ""
"A wet wipe saturated with alcohol and stored in a sterile package.  Used for "
"personal hygiene or disinfecting small wounds."
msgstr "浸在酒精中的棉片裝在無菌包裝中。用在個人清潔或消毒小傷口。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "anesthesia kit"
msgid_plural "anesthesia kits"
msgstr[0] "麻醉工具"

#: data/json/items/tool/med.json
#. ~ Description of "anesthesia kit"
msgid ""
"A kit for inducing anesthesia for surgery, containing specialized canisters "
"with a variety of powerful hypnotic, analgesic, and stimulative drugs.  It's "
"intended for use in specialized medical equipment, and can't be administered "
"manually."
msgstr "一組用來導引手術麻醉的工具包，包含各種強效催眠藥、止痛藥和興奮藥的專用藥罐。它只能用於專業的醫療設備中，不能手動使用。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "bandage"
msgid_plural "bandages"
msgstr[0] "繃帶"

#: data/json/items/tool/med.json
#. ~ Description of "bandage"
msgid ""
"A sterile cloth bandage.  Used for stopping blood loss and protecting wounds "
"from aggravation to help them heal faster."
msgstr "一条无菌布绷带。用于阻止失血和保护伤口免受恶化，以助于更快地愈合。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "makeshift bandage"
msgid_plural "makeshift bandages"
msgstr[0] "粗製繃帶"

#: data/json/items/tool/med.json
#. ~ Description of "makeshift bandage"
msgid ""
"A reasonably clean piece of cloth wrapped for use as a simple bandage.  "
"Better than nothing."
msgstr "一块相当干净的棉布卷起来做成的简易绷带。有总比没有好。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "bleached makeshift bandage"
msgid_plural "bleached makeshift bandages"
msgstr[0] "漂白的粗製繃帶"

#: data/json/items/tool/med.json
#. ~ Description of "bleached makeshift bandage"
msgid ""
"A piece of cloth treated with a bleach solution to sterilize it for use as a "
"bandage."
msgstr "一块用漂白剂溶液灭菌处理过的棉布，可以用作绷带。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "boiled makeshift bandage"
msgid_plural "boiled makeshift bandages"
msgstr[0] "煮沸的粗製繃帶"

#: data/json/items/tool/med.json
#. ~ Description of "boiled makeshift bandage"
msgid "A piece of cloth boiled in water to sterilize it for use as a bandage."
msgstr "一块在水中煮沸灭菌过的棉布，可以用作绷带。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "cotton balls"
msgid_plural "cotton balls"
msgstr[0] "棉球"

#: data/json/items/tool/med.json
#. ~ Description of "cotton balls"
msgid ""
"Fluffy balls of clean, white cotton.  They can serve as makeshift bandages in "
"an emergency."
msgstr "毛茸茸的白棉球。紧急情况下可以勉强作为简易绷带使用。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "antiseptic soaked rag"
msgid_plural "antiseptic soaked rags"
msgstr[0] "消毒過的布條"

#: data/json/items/tool/med.json
#. ~ Description of "antiseptic soaked rag"
msgid ""
"A rag soaked in antiseptic.  Useful for light wounds, probably won't help "
"with deep bites."
msgstr "一條浸泡過消毒劑的布條。對小傷口有幫助，對被咬得很深的傷口沒用。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "antiseptic soaked cotton balls"
msgid_plural "antiseptic soaked cotton balls"
msgstr[0] "消毒過的棉球"

#: data/json/items/tool/med.json
#. ~ Description of "antiseptic soaked cotton balls"
msgid ""
"Fluffy balls of clean white cotton.  Now that they've been soaked with "
"antiseptic, they are somewhat useful to disinfect a wound."
msgstr "干净的白色棉球。已经用抗菌剂浸泡过了，对伤口的消毒有一定作用。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "inhaler"
msgid_plural "inhalers"
msgstr[0] "吸入器"

#: data/json/items/tool/med.json
#. ~ Description of "inhaler"
msgid ""
"An albuterol inhaler.  Used in the treatment of bronchospasm, it is a "
"lifeline for people with asthma.  A mild stimulant, it may cause anxiety or "
"tremors."
msgstr "沙丁胺醇吸入剂。用于治疗支气管痉挛，是哮喘患者救命恩人。一种温和的兴奋剂，它可能导致焦虑或震颤。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "medical gauze"
msgid_plural "medical gauzes"
msgstr[0] "藥用紗布"

#: data/json/items/tool/med.json
#. ~ Description of "medical gauze"
msgid ""
"A decent-sized piece of cotton, sterilized and sealed.  It's designed for "
"medical purposes."
msgstr "一块大小合适的棉花，经过消毒和密封，可用于医疗目的。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "spray bottle of liquid bandage"
msgid_plural "spray bottles of liquid bandage"
msgstr[0] "液體繃帶噴霧瓶"

#: data/json/items/tool/med.json
#. ~ Description of "spray bottle of liquid bandage"
msgid ""
"Liquid bandage for minor cuts and scrapes, packaged in a tiny bottle with an "
"atomizer spray for convenient application."
msgstr "用於輕微割傷和擦傷的液體繃帶，包裝在一個小瓶子中，配有霧化器噴口，能方便使用。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "RX12 jet injector"
msgid_plural "RX12 jet injectors"
msgstr[0] "RX12 注射器"

#: data/json/items/tool/med.json
#. ~ Description of "RX12 jet injector"
msgid ""
"A Rivtech RX12 jet injector, a small pistol-shaped device used to inject "
"advanced fast-healing chemicals through the skin without using a needle.  A "
"label on the side warns against using more than two doses per hour."
msgstr ""
"Rivtech "
"RX12射流注射器是一种小型的疗伤用无针头注射器，通过皮肤直接将高效的快速治疗药剂注入身体。手枪外形，旁边的标签上印有每小时使用不得超过两次的警告文字。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "scalpel"
msgid_plural "scalpels"
msgstr[0] "手術刀"

#: data/json/items/tool/med.json
#. ~ Description of "scalpel"
msgid ""
"A very sharp knife designed for surgical cutting.  Its small, sharp blade "
"allows for precision strikes in the hands of the skilled."
msgstr ""
"一把小型的，非常锋利的刀具，被广泛应用于各项外科手术中。如果你很擅长近战武器的话，它也会是一件大杀器。\n"
"\"在寂静岭医院工作的护士们用此解剖过无数活人。\""

#: data/json/items/tool/med.json
#. ~ Item name
msgid "small oxygen delivery kit"
msgid_plural "small oxygen delivery kits"
msgstr[0] "小型输氧器"

#: data/json/items/tool/med.json
#. ~ Description of "small oxygen delivery kit"
msgid ""
"A small tank of compressed medical oxygen with a folding regulator and mask.  "
"Commonly used in emergency situations, it provides immediate relief for "
"asthma attacks or smoke inhalation, and can provide a brief burst of energy."
msgstr "一小罐医用压缩氧，附带调节器和面罩。能够迅速缓解哮喘症状和烟雾吸入损伤，也能让你在短时间内精神满满。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "syringe"
msgid_plural "syringes"
msgstr[0] "針筒"

#: data/json/items/tool/med.json
#. ~ Description of "syringe"
msgid "A medical syringe.  Used for administering intravenous drugs."
msgstr "一根醫療用針筒。能進行藥物或毒品的靜脈注射。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "thermometer"
msgid_plural "thermometers"
msgstr[0] "溫度計"

#: data/json/items/tool/med.json
#. ~ Description of "thermometer"
msgid "A plastic thermometer that can read the air temperature."
msgstr "一個塑膠溫度計， 可以用來檢視環境溫度。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "oxygen delivery kit"
msgid_plural "oxygen delivery kits"
msgstr[0] "输氧器"

#: data/json/items/tool/med.json
#. ~ Description of "oxygen delivery kit"
msgid ""
"A tank of compressed medical oxygen with a regulator and mask.  Commonly used "
"in emergency situations, it provides immediate relief for asthma attacks or "
"smoke inhalation, and can provide a brief burst of energy."
msgstr "一罐医用压缩氧，附带调节器和面罩。能够迅速缓解哮喘症状和烟雾吸入损伤，也能让你在短时间内精神满满。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "blood draw kit"
msgid_plural "blood draw kits"
msgstr[0] "抽血工具"

#: data/json/items/tool/med.json
#. ~ Description of "blood draw kit"
msgid ""
"A kit for drawing blood, including a test tube for holding the sample.  Use "
"this tool to draw blood, either from yourself or from a corpse you are "
"standing on."
msgstr "一套能用来采集血液的工具，附带一根用来保存血样的试管。使用它来抽血，可以是从你自己身上抽血，或者是你当前所站位置的尸体身上抽血。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "wrapped radiation badge"
msgid_plural "wrapped radiation badges"
msgstr[0] "包裝的輻射偵測徽章"

#: data/json/items/tool/med.json
#. ~ Description of "wrapped radiation badge"
msgid ""
"A badge that detects radiation dosage, sealed in a radiation-blocking bag.  "
"Use it to remove it from the bag."
msgstr "一块用来检测辐射量的徽章，密闭在防辐射的包装袋中。使用它以将其从包装中取出。"

#: data/json/items/tool/med.json
#. ~ "menu_text" action message of item "wrapped radiation badge"
msgid "Unwrap badge"
msgstr "拆開包裝"

#: data/json/items/tool/med.json
#. ~ "msg" action message of item "wrapped radiation badge"
msgid "You remove the badge from its wrapper, exposing it to ambient radiation."
msgstr "你從包裝中取出了偵檢卡, 將它暴露在背景輻射中。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "pair of medical scissors"
msgid_plural "pairs of medical scissors"
msgstr[0] "醫用剪刀"

#: data/json/items/tool/med.json
#. ~ Description of "pair of medical scissors"
msgid ""
"A pair of medical scissors, typically used by nurses or paramedics to cut "
"bandages or fabric."
msgstr "一把醫用剪刀，通常由護士或護理人員用來剪繃帶或織物。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "small saline infusion kit"
msgid_plural "small saline infusion kits"
msgstr[0] "小型生理盐水输液袋"

#: data/json/items/tool/med.json
#. ~ Description of "small saline infusion kit"
msgid ""
"A small, sealed plastic bag for liquids used in intravenous therapy, with "
"rubber tube and cannula - all you need to perform an infusion.  Holds 250 mL "
"of completely sterile saline, therefore it is safe to put it inside your "
"veins, if you know how."
msgstr ""
"一个用于静脉输液的小型密封塑料袋，带有橡胶管和静脉导管，有了它你就可以进行输液。里面装着 250 "
"毫升的无菌生理盐水，可以安全地注射到静脉中，如果你懂得怎么操作的话。"

#: data/json/items/tool/med.json
#. ~ "description" action message of item "small saline infusion kit"
msgid ""
"You can use it to mitigate the consequences of blood loss.  Require health "
"care 3 and some disinfectant."
msgstr "你可以用它来减轻失血的症状。需要 3 级医疗技能。"

#: data/json/items/tool/med.json
#. ~ "menu_text" action message of item "small saline infusion kit"
#. ~ "menu_text" action message of item "medium saline infusion kit"
#. ~ "menu_text" action message of item "large saline infusion kit"
#. ~ "menu_text" action message of item "huge saline infusion kit"
msgid "Infuse saline"
msgstr "输注生理盐水"

#: data/json/items/tool/med.json
#. ~ Player message in false effect in EoC "SALINE_INFUSION_250" in use action
#. of item "small saline infusion kit"
#. ~ Player message in false effect in EoC "SALINE_INFUSION_500" in use action
#. of item "medium saline infusion kit"
#. ~ Player message in false effect in EoC "SALINE_INFUSION_1000" in use
#. action of item "large saline infusion kit"
#. ~ Player message in false effect in EoC "SALINE_INFUSION_2000" in use
#. action of item "huge saline infusion kit"
msgid "You don't actually know how to use it properly."
msgstr "你其实并不知道如何正确使用它。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "medium saline infusion kit"
msgid_plural "medium saline infusion kits"
msgstr[0] "中型生理盐水输液袋"

#: data/json/items/tool/med.json
#. ~ Description of "medium saline infusion kit"
msgid ""
"A sealed plastic bag for liquids used in intravenous therapy, with rubber "
"tube and cannula - all you need to perform an infusion.  Holds 500 mL of "
"completely sterile saline, therefore it is safe to put it inside your veins, "
"if you know how."
msgstr ""
"一个用于静脉输液的密封塑料袋，带有橡胶管和静脉导管，有了它你就可以进行输液。里面装着 500 "
"毫升的无菌生理盐水，可以安全地注射到静脉中，如果你懂得怎么操作的话。"

#: data/json/items/tool/med.json
#. ~ "description" action message of item "medium saline infusion kit"
#. ~ "description" action message of item "large saline infusion kit"
#. ~ "description" action message of item "huge saline infusion kit"
msgid ""
"You can use it to mitigate the consequences of blood loss.  Require health "
"care 4."
msgstr "你可以用它来减轻失血的症状。需要 4 级医疗技能。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "large saline infusion kit"
msgid_plural "large saline infusion kits"
msgstr[0] "大型生理盐水输液袋"

#: data/json/items/tool/med.json
#. ~ Description of "large saline infusion kit"
msgid ""
"A large, sealed plastic bag for liquids used in intravenous therapy, with "
"rubber tube and cannula - all you need to perform an infusion.  Holds a liter "
"of completely sterile saline, therefore it is safe to put it inside your "
"veins, if you know how."
msgstr ""
"一个用于静脉输液的大型密封塑料袋，带有橡胶管和静脉导管，有了它你就可以进行输液。里面装着 1 "
"升的无菌生理盐水，可以安全地注射到静脉中，如果你懂得怎么操作的话。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "huge saline infusion kit"
msgid_plural "huge saline infusion kits"
msgstr[0] "超大型生理盐水输液袋"

#: data/json/items/tool/med.json
#. ~ Description of "huge saline infusion kit"
msgid ""
"A huge, sealed plastic bag for liquids used in intravenous therapy, with "
"rubber tube and cannula - all you need to perform an infusion.  Holds two "
"liters of completely sterile saline, therefore it is safe to put it inside "
"your veins, if you know how."
msgstr ""
"一个用于静脉输液的超大型密封塑料袋，带有橡胶管和静脉导管，有了它你就可以进行输液。里面装着 2 "
"升的无菌生理盐水，可以安全地注射到静脉中，如果你懂得怎么操作的话。"

#: data/json/items/tool/med.json
#. ~ Item name
msgid "dental tool set"
msgid_plural "dental tool sets"
msgstr[0] "洁牙套件"

#: data/json/items/tool/med.json
#. ~ Description of "dental tool set"
msgid "A set of picks, hooks, and scrapers designed for cleaning teeth."
msgstr "一套用于清洁牙齿的镊子、勾针和刮匙工具。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "crude bronze nail"
msgid_plural "crude bronze nails"
msgstr[0] "粗铜钉"

#: data/json/items/tool/metalworking.json
#. ~ Description of "crude bronze nail"
msgid ""
"A crude bronze nail.  Probably not useful for many things due to its size and "
"shape."
msgstr "一根粗制铜钉。从大小和形状来看，大概造不了太多东西。"

#: data/json/items/tool/metalworking.json
#. ~ Description of "anvil"
msgid ""
"A heavy block of oddly-shaped steel complete with a pritchel hole and hardy "
"hole.  Once installed, it can be used in most metalworking fabrication "
"recipes."
msgstr "一塊沉重的、形狀奇特的鋼，上面有沖頭孔和方柄鑿孔。安裝後，它可用於大多數金屬加工製造配方。"

#: data/json/items/tool/metalworking.json
#. ~ Description of "bronze anvil"
msgid ""
"A block of oddly-shaped bronze complete with a pritchel hole and hardy hole.  "
"Once installed, it can be used in most metalworking fabrication recipes."
msgstr "一塊形狀奇特的青銅，上面有沖頭孔和方柄鑿孔。安裝後，它可用於大多數金屬加工製造配方。"

#: data/json/items/tool/metalworking.json
#. ~ Description of "heavy anvil"
msgid ""
"An absolutely enormous block of oddly-shaped steel with all the bells and "
"whistles a blacksmith could ask for on an anvil.  Necessary for heavy-duty "
"metalworking or dropping on roadrunners."
msgstr "一块庞大的、形状奇特的钢，具有铁匠所需的全部功能与附件。在重型金属加工和Herobrine为谋害Steve所建的陷阱中必不可少。"

#: data/json/items/tool/metalworking.json
#. ~ Description of "small anvil"
msgid "A proper, albeit small, anvil.  Pretty handy."
msgstr "一个合适的铁砧，很小，但用起来很趁手。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "scavenger's anvil"
msgid_plural "scavenger's anvils"
msgstr[0] "scavenger's anvils"

#: data/json/items/tool/metalworking.json
#. ~ Description of "scavenger's anvil"
msgid ""
"A portion of heavy steel machinery that has been smoothed and shaped to form "
"a very adequate anvil."
msgstr ""

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "makeshift stump anvil"
msgid_plural "makeshift stump anvils"
msgstr[0] "makeshift stump anvils"

#: data/json/items/tool/metalworking.json
#. ~ Description of "makeshift stump anvil"
msgid ""
"A heavy, thick log to which several flat steel bits have been bolted to serve "
"as an anvil.  Not sufficient for detailed nor heavy work."
msgstr ""
"A heavy, thick log to which several flat steel bits have been bolted to serve "
"as an anvil.  Not sufficient for detailed nor heavy work."

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "pair of bolt cutters"
msgid_plural "pairs of bolt cutters"
msgstr[0] "剪線鉗"

#: data/json/items/tool/metalworking.json
#. ~ Description of "pair of bolt cutters"
msgid ""
"A large pair of bolt cutters.  You could use them to cut padlocks or heavy "
"gauge wire."
msgstr "一把大型的剪線鉗，可以用它來剪斷掛鎖或鐵絲網。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "charcoal forge"
msgid_plural "charcoal forges"
msgstr[0] "炭火鍛造爐"

#: data/json/items/tool/metalworking.json
#. ~ Description of "charcoal forge"
msgid ""
"A portable, charcoal-fired metalworking forge.  With the right tools, you "
"could use this for metalworking."
msgstr "一种便携式烧炭金工锻造工具。搭配合适当的工具，你可以用它来加工金属物品。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "portable charcoal kiln"
msgid_plural "portable charcoal kilns"
msgstr[0] "便携式炭窑"

#: data/json/items/tool/metalworking.json
#. ~ Description of "portable charcoal kiln"
msgid ""
"A somewhat portable drum kiln to produce charcoal via pyrolysis: the "
"incomplete burning of organic materials in the absence of oxygen.  Needs to "
"be deployed before use."
msgstr "一种通过热解法生产木炭的便携鼓式窑炉：让有机材料在缺氧环境下不完全燃烧以获得炭。使用前需要部署。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "metalworking chisel"
msgid_plural "metalworking chisels"
msgstr[0] "鐵工鑿子"

#: data/json/items/tool/metalworking.json
#. ~ Description of "metalworking chisel"
msgid ""
"A short, stout metalworking chisel.  It's used in some metalworking "
"fabrication recipes."
msgstr "一根短而粗的鐵工鑿子。能用於一些金屬加工配方。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "bronze chisel"
msgid_plural "bronze chisels"
msgstr[0] "青铜凿"

#: data/json/items/tool/metalworking.json
#. ~ Description of "bronze chisel"
msgid ""
"A short, stout metalworking chisel made of bronze.  It's used in some "
"metalworking fabrication recipes.  Bronze chisels spark less than their steel "
"counterparts, but are less durable."
msgstr "一个短而粗的金工凿，采用青铜制成。在某些金属加工制造时使用。青铜凿的火花比钢凿的要小，但不那么耐用。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "crucible"
msgid_plural "crucibles"
msgstr[0] "坩鍋"

#: data/json/items/tool/metalworking.json
#. ~ Description of "crucible"
msgid ""
"A small metalworking crucible.  Looks like a stout drink tumbler.  It's used "
"in some metalworking fabrication recipes."
msgstr "一个小的金属坩埚。看起来像是一杯烈酒。用于某些金属加工制造的模具。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "clay crucible"
msgid_plural "clay crucibles"
msgstr[0] "陶製坩鍋"

#: data/json/items/tool/metalworking.json
#. ~ Description of "clay crucible"
msgid ""
"A primitive metalworking crucible made of clay.  Looks like a stout drink "
"tumbler.  You could use it for metalworking."
msgstr "一个小的金属坩埚。看起来像是一杯烈酒。用于某些金属加工制造的模具。"

#: data/json/items/tool/metalworking.json
#. ~ Description of "electric forge"
msgid ""
"An electric metalworking forge, powered by your electric grid.  With the "
"right tools, you could use this for metalworking."
msgstr "一个可用于加工金属的电锻炉，带有一个插头。搭配合适当的工具，你可以用它来加工金属物品。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "chainmail sheet"
msgid_plural "chainmail sheets"
msgstr[0] "鏈甲薄片"

#: data/json/items/tool/metalworking.json
#. ~ Description of "chainmail sheet"
#. ~ Description of "mild steel chainmail sheet"
msgid ""
"A sheet of riveted chainmail.  With some skill, several of these sheets could "
"be connected to make effective armor."
msgstr "一片铆接而成的锁环网。稍有技巧的人能够将几片锁环网拼接成可用的护甲。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "mild steel chainmail sheet"
msgid_plural "mild steel chainmail sheets"
msgstr[0] "鏈甲薄片（低碳鋼）"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "medium steel chainmail sheet"
msgid_plural "medium steel chainmail sheets"
msgstr[0] "鏈甲薄片（中碳鋼）"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "high steel chainmail sheet"
msgid_plural "high steel chainmail sheets"
msgstr[0] "鏈甲薄片（高碳鋼）"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "hardened steel chainmail sheet"
msgid_plural "hardened steel chainmail sheets"
msgstr[0] "鏈甲薄片（硬化鋼）"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "tempered steel chainmail sheet"
msgid_plural "tempered steel chainmail sheets"
msgstr[0] "鏈甲薄片（回火鋼）"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "swage and die set"
msgid_plural "swage and die sets"
msgstr[0] "鍛造模具組"

#: data/json/items/tool/metalworking.json
#. ~ Description of "swage and die set"
msgid ""
"A set of swages and dies for metalsmithing.  These loops and metal blocks are "
"used in some metalworking fabrication recipes."
msgstr "一组用于加工模具的型砧。用于某些金属加工制造的模具。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "hotcut"
msgid_plural "hotcuts"
msgstr[0] "熱切鑿"

#: data/json/items/tool/metalworking.json
#. ~ Description of "hotcut"
msgid ""
"A hardened chisel-like object for metalsmithing.  It's used to cut lengths of "
"metal in some metalworking fabrication recipes."
msgstr "这是一种用于金属锻造的坚硬凿子。在某些金属加工制造配方中，用来将金属切割成长条。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "drift"
msgid_plural "drifts"
msgstr[0] "衝銷鑽"

#: data/json/items/tool/metalworking.json
#. ~ Description of "drift"
msgid ""
"A hardened spike-like object for metalsmithing.  It's used to make holes in "
"metal in some metalworking fabrication recipes."
msgstr "这是一种用于金属锻造的坚硬锥形冲头。在某些金属加工制造配方中，用来在金属上打孔。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "pair of kitchen tongs"
msgid_plural "pairs of kitchen tongs"
msgstr[0] "餐夹"

#: data/json/items/tool/metalworking.json
#. ~ Description of "pair of kitchen tongs"
msgid "A pair of long, metal tongs.  They are commonly used for cooking."
msgstr "一把长长的金属夹钳。是常用的烹饪工具。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "pair of flatjaw bronze tongs"
msgid_plural "pairs of flatjaw bronze tongs"
msgstr[0] "青铜平口钳"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "pair of flatjaw tongs"
msgid_plural "pairs of flatjaw tongs"
msgstr[0] "平口鉗"

#: data/json/items/tool/metalworking.json
#. ~ Description of "pair of flatjaw tongs"
msgid ""
"A pair of flatjaw tongs.  They are commonly used for metalworking, "
"fabrication, or forging recipes."
msgstr "一把平口铁钳，通常用于金属加工、制造或锻造配方。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "sandpaper"
msgid_plural "sheets of sandpaper"
msgstr[0] "砂紙"

#: data/json/items/tool/metalworking.json
#. ~ Description of "sandpaper"
msgid "A sheet of rough paper.  It is commonly used in metalworking and carpentry."
msgstr "一張粗糙的紙。 它通常用於金屬加工和木工。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "sandleather"
msgid_plural "sandleathers"
msgstr[0] "砂皮"

#: data/json/items/tool/metalworking.json
#. ~ Description of "sandleather"
msgid ""
"A patch of leather paired with a handful of sand.  Works as a substitute for "
"sandpaper."
msgstr "一块沾满了沙子的皮革。用作砂纸的替代品。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "draw plate"
msgid_plural "draw plates"
msgstr[0] "接線金屬板"

#: data/json/items/tool/metalworking.json
#. ~ Description of "draw plate"
msgid ""
"A piece of metal with holes of varying size drilled into it.  Used as part of "
"wire drawing."
msgstr "一片金屬板，上面鑽有大小不一的孔。用作電源牽線的部件。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "small sandcasting mold"
msgid_plural "small sandcasting molds"
msgstr[0] "砂铸模具（小型）"

#: data/json/items/tool/metalworking.json
#. ~ Description of "small sandcasting mold"
msgid "A small mold for casting molten metals into different shapes."
msgstr "用于将液态金属铸造成型的小型模具。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "large sandcasting mold"
msgid_plural "large sandcasting molds"
msgstr[0] "砂铸模具（大型）"

#: data/json/items/tool/metalworking.json
#. ~ Description of "large sandcasting mold"
msgid "A large mold for casting molten metals into different shapes."
msgstr "用于将液态金属铸造成型的大型模具。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "long sandcasting mold"
msgid_plural "long sandcasting molds"
msgstr[0] "砂铸模具（加长）"

#: data/json/items/tool/metalworking.json
#. ~ Description of "long sandcasting mold"
msgid "A large, long, mold for casting molten metals into different shapes."
msgstr "用于将液态金属铸造成型的大型长条模具。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "sandcasting mold"
msgid_plural "sandcasting molds"
msgstr[0] "砂铸模具"

#: data/json/items/tool/metalworking.json
#. ~ Description of "sandcasting mold"
msgid "A medium mold for casting molten metals into different shapes."
msgstr "用于将液态金属铸造成型的中型模具。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "polishing stone"
msgid_plural "polishing stones"
msgstr[0] "拋光石"

#: data/json/items/tool/metalworking.json
#. ~ Description of "polishing stone"
msgid "A large natural stone with a flat surface to grind against."
msgstr "一块天然的大石头，表面平坦可以用来研磨抛光。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "pedal powered grindstone"
msgid_plural "pedal powered grindstones"
msgstr[0] "腳踏式砂輪"

#: data/json/items/tool/metalworking.json
#. ~ Description of "pedal powered grindstone"
msgid "A round, pedal-powered grindstone, useful for grinding metal."
msgstr "圓形的、腳踏式的磨石，可用於研磨金屬。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "steel scraper"
msgid_plural "steel scrapers"
msgstr[0] "刻刀"

#: data/json/items/tool/metalworking.json
#. ~ Description of "steel scraper"
msgid "A hardened steel tool similar to a drawknife, but for metal."
msgstr "類似木工拉刀的硬化鋼製工具，不同的是這個用來加工金屬。"

#: data/json/items/tool/metalworking.json
#. ~ Item name
msgid "gas forge"
msgid_plural "gas forges"
msgstr[0] "瓦斯鍛造爐"

#: data/json/items/tool/metalworking.json
#. ~ Description of "gas forge"
msgid ""
"A gas-fueled metalworking forge.  With the right tools, you could use this "
"for metalworking."
msgstr "一种便携式燃气金工锻造工具。搭配合适当的工具，你可以用它来加工金属物品。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "compressed air horn"
msgid_plural "compressed air horns"
msgstr[0] "瓦斯喇叭"

#: data/json/items/tool/misc.json
#. ~ Description of "compressed air horn"
msgid ""
"A small can of compressed air attached to a plastic horn.  Pressing the "
"button on top causes it to emit a loud honking sound."
msgstr "这罐压缩空气被安上了一个塑料的号角，只要轻轻按下罐子上的按钮，就会发出巨大的喇叭声。"

#: data/json/items/tool/misc.json
#. ~ "noise_message" action message of item "compressed air horn"
msgid "HOOOOONK!"
msgstr "叭~~~!"

#: data/json/items/tool/misc.json
#. ~ "use_message" action message of item "compressed air horn"
msgid "You honk your airhorn."
msgstr "你按了喇叭。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "alarm clock"
msgid_plural "alarm clocks"
msgstr[0] "鬧鐘"

#: data/json/items/tool/misc.json
#. ~ Description of "alarm clock"
msgid ""
"A wind-up alarm clock.  Though the noise it makes is unpleasant to wake up "
"to, it's always good to get an early start to your day.  Can also be "
"disassembled into some useful parts."
msgstr "一個發條鬧鐘。雖然鬧鐘的噪音讓你有起床氣， 但讓你能早起總是好事。也能拆解成許多有用的零件。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "can of butane"
msgid_plural "cans of butane"
msgstr[0] "丁烷罐"

#: data/json/items/tool/misc.json
#. ~ Description of "can of butane"
msgid ""
"A non-refillable can of butane with an adapter for refilling lighters.  It "
"could be useful as a fuel, but also as a solvent or chemical reagent."
msgstr "不能裝入的丁烷罐，有個接頭口可以用來裝填可填充打火機。可當成燃料，也可用作溶劑或化學試劑。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "notched plank"
msgid_plural "notched planks"
msgstr[0] "火种凹槽木板"

#: data/json/items/tool/misc.json
#. ~ Description of "notched plank"
msgid ""
"A quarter of a wooden plank with notches cut into it, used with a fire drill "
"to create embers."
msgstr "四分之一块木板，刻有火种凹槽，用来配合钻木取火器生火。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "notched stick"
msgid_plural "notched sticks"
msgstr[0] "火种凹槽木棍"

#: data/json/items/tool/misc.json
#. ~ Description of "notched stick"
msgid ""
"A wooden stick with notches cut into it, used with a fire drill to create "
"embers."
msgstr "刻有火种凹槽的木棍，用来配合钻木取火器生火。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "clay urn"
msgid_plural "clay urns"
msgstr[0] "陶製骨灰罈"

#: data/json/items/tool/misc.json
#. ~ Description of "clay urn"
msgid "A clay container for storing cremated ashes."
msgstr "用於存放火化骨灰的陶罐。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "cow bell"
msgid_plural "cow bells"
msgstr[0] "牛鈴"

#: data/json/items/tool/misc.json
#. ~ Description of "cow bell"
msgid "A cow bell.  You feel like you need more of it."
msgstr "一个牛铃。你觉得你需要更多。（注：Need more cowbell meme）"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "crystal urn"
msgid_plural "crystal urns"
msgstr[0] "水晶骨灰罈"

#: data/json/items/tool/misc.json
#. ~ Description of "crystal urn"
msgid ""
"An exquisite, translucent container for cremated ashes, decorated with floral "
"patterns."
msgstr "精緻的半透明火化骨灰容器，飾有花卉圖案。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "entrenching tool"
msgid_plural "entrenching tools"
msgstr[0] "工兵鏟"

#: data/json/items/tool/misc.json
#. ~ Description of "entrenching tool"
msgid ""
"A stout, collapsible spade.  It's commonly used by military forces and "
"favored by hikers for digging."
msgstr "一把常用于军队的折叠铲，简易的折叠设计，非常节省空间，是野外露营、探险、旅游等活动的必备工具，备受徒步旅行者的追捧。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "etched human skull"
msgid_plural "etched human skulls"
msgstr[0] "被蝕刻的人類頭骨"

#: data/json/items/tool/misc.json
#. ~ Description of "etched human skull"
msgid "A human skull covered with strange etchings."
msgstr "一个布满奇怪蚀刻图案的人类头骨。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "fur rollmat"
msgid_plural "fur rollmats"
msgstr[0] "毛皮睡墊"

#: data/json/items/tool/misc.json
#. ~ Description of "fur rollmat"
msgid ""
"A bedroll made of pelts which can be rolled up for transport.  It insulates "
"you from the floor, making it easier to sleep.  Use it to unroll and place on "
"the ground."
msgstr "一床毛皮制成的铺盖，可以卷起来随身携带。垫在地上，让你更容易入睡。"

#: data/json/items/tool/misc.json
#. ~ "done_message" action message of item "fur rollmat"
msgid "You unroll the fur mat and lay it on the ground."
msgstr "你把毛皮墊在地上攤開來。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "garden hose"
msgid_plural "garden hoses"
msgstr[0] "園藝軟管"

#: data/json/items/tool/misc.json
#. ~ Description of "garden hose"
msgid ""
"A flexible garden hose.  If you cut it into smaller pieces, it could be used "
"for crafting or siphoning fuel from a vehicle."
msgstr "一根柔软的花园用橡胶软管。可以用来做东西，也可以用来从载具中抽油。"

#: data/json/items/tool/misc.json
#. ~ Description of "grappling hook"
msgid ""
"A folding grappling hook attached to a stout, 30-foot long piece of "
"lightweight cord.  Useful for keeping yourself safe from falls.  Can be used "
"in place of a long rope for butchering, in a pinch."
msgstr "可折叠的精钢抓钩，系在一根30英尺（约9米）长的尼龙绳上。有效保护你从高处落下时的安全。足以吊起大型尸体以便屠宰。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "grip hook"
msgid_plural "grip hooks"
msgstr[0] "手抓鉤"

#: data/json/items/tool/misc.json
#. ~ Description of "grip hook"
msgid "A simple steel meat hook with a circular steel handle."
msgstr "一个简单的钢制挂肉钩，带有个环形的钢把手。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "hand pump"
msgid_plural "hand pumps"
msgstr[0] "手動幫浦"

#: data/json/items/tool/misc.json
#. ~ Description of "hand pump"
msgid "A hand-powered pump suitable for pumping air into inflatable objects."
msgstr "一个打气筒，可以给任何物体充入空气，比如娃娃。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "leather bellow"
msgid_plural "leather bellows"
msgstr[0] "皮革风箱"

#: data/json/items/tool/misc.json
#. ~ Description of "leather bellow"
msgid "A bellow is a device constructed to furnish a strong blast of air."
msgstr "一种用来提供强劲气流的装置。"

#: data/json/items/tool/misc.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "bicycle horn"
msgid_plural "bicycle horns"
msgstr[0] "自行車叭噗"

#: data/json/items/tool/misc.json
#. ~ Description of "bicycle horn"
msgid "A simple bulb horn found on many bicycles.  Activate it to honk.  Honk honk."
msgstr "一个简单的小铃铛，许多自行车上都可以看到。激活它以发声。"

#: data/json/items/tool/misc.json
#. ~ "use_message" action message of item "bicycle horn"
msgid "You honk the bicycle horn."
msgstr "你按了自行車的吧噗。"

#: data/json/items/tool/misc.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "truck horn"
msgid_plural "truck horns"
msgstr[0] "卡車喇叭"

#: data/json/items/tool/misc.json
#. ~ Description of "truck horn"
msgid "A very loud horn, usually found on large trucks like semis."
msgstr "一个非常响亮的喇叭，通常用在拖车这样的大卡车上。"

#: data/json/items/tool/misc.json data/json/vehicleparts/vehicle_parts.json
#. ~ Item name
#. ~ Vehicle part name
msgid "car horn"
msgid_plural "car horns"
msgstr[0] "汽車喇叭"

#: data/json/items/tool/misc.json
#. ~ Description of "car horn"
msgid "A car horn meant to be attached to a car's electrical system."
msgstr "需要连接到汽车电气系统的汽车喇叭。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "large space heater"
msgid_plural "large space heaters"
msgstr[0] "大空間供暖器"

#: data/json/items/tool/misc.json
#. ~ Description of "large space heater"
#. ~ Description of "large space heater (on)"
msgid ""
"A portable electric heater that steadily emits warm air.  Raises temperature "
"about 10 degrees Celsius, and fills a larger volume of air than the smaller "
"version."
msgstr "一种便携式电加热器，能稳定地放出温暖的空气。将温度升高约10℃，并比小型版本排气量更大。"

#: data/json/items/tool/misc.json
#. ~ "msg" action message of item "large space heater"
#. ~ "msg" action message of item "small space heater"
msgid "You turn on the heater."
msgstr "你打開供暖器。"

#: data/json/items/tool/misc.json
#. ~ "need_charges_msg" action message of item "large space heater"
#. ~ "need_charges_msg" action message of item "small space heater"
msgid "The heater needs more charge."
msgstr "供暖器需要更多的電量。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "large space heater (on)"
msgid_plural "large space heaters (on)"
msgstr[0] "大空間供暖器（啟動）"

#: data/json/items/tool/misc.json
#. ~ "msg" action message of item "large space heater (on)"
#. ~ "msg" action message of item "small space heater (on)"
msgid "You turn off the heater."
msgstr "你關閉了供暖氣。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "lifestraw"
msgid_plural "lifestraws"
msgstr[0] "生命吸管"

#: data/json/items/tool/misc.json
#. ~ Description of "lifestraw"
msgid ""
"A small personal water filter.  The instructions say to set the lifestraw in "
"suspect water, let sit for one minute then drink.  The two-part filtration "
"system will purify the water you drink up to a certain amount.  Water taken "
"from uncertain sources like a river may be dirty."
msgstr ""
"一个小型的个人滤水器。将生命饮管放入污水中，静置一分钟之后即可饮用。它内置的双重过滤系统将会将一部分水净化至可饮用状态。从河流之类的不明水源取得的水有可能被"
"污染。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "plastic gasket"
msgid_plural "plastic gaskets"
msgstr[0] "塑膠墊片"

#: data/json/items/tool/misc.json
#. ~ Description of "plastic gasket"
msgid "A single-use plastic gasket."
msgstr "一次性塑膠墊片。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "permanent marker"
msgid_plural "permanent markers"
msgstr[0] "奇異筆"

#: data/json/items/tool/misc.json
#. ~ Description of "permanent marker"
msgid ""
"A King Size™ industrial-strength permanent marker, about halfway between a "
"typical marker and a can of spray paint in size.  Activate it to write "
"something down.  However, writing \"Elbereth\" probably won't help you."
msgstr ""
"King "
"Size牌的工业级记号笔，大小介于一般的记号笔和喷涂罐之间。可以用它来写东西。但是写下\"Elbereth\""
"可能不会有什么用。（注：Elbereth是NetHack中驱赶怪物的咒语）"

#: data/json/items/tool/misc.json data/json/items/tool/stationery.json
#. ~ "gerund" action message of item "permanent marker"
#. ~ "gerund" action message of item "survival marker"
#. ~ "gerund" action message of item "pen"
#. ~ "gerund" action message of item "pencil"
#. ~ "gerund" action message of item "black pen"
#. ~ "gerund" action message of item "blue pen"
#. ~ "gerund" action message of item "red pen"
#. ~ "gerund" action message of item "green pen"
msgid "Written"
msgstr "已寫入"

#: data/json/items/tool/misc.json data/json/items/tool/stationery.json
#. ~ "verb" action message of item "permanent marker"
#. ~ "verb" action message of item "survival marker"
#. ~ "verb" action message of item "pen"
#. ~ "verb" action message of item "pencil"
#. ~ "verb" action message of item "black pen"
#. ~ "verb" action message of item "blue pen"
#. ~ "verb" action message of item "red pen"
#. ~ "verb" action message of item "green pen"
msgid "Write"
msgstr "寫"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "pocket watch"
msgid_plural "pocket watches"
msgstr[0] "懷錶"

#: data/json/items/tool/misc.json
#. ~ Description of "pocket watch"
msgid ""
"An old-fashioned pocket watch.  Tells the time and looks good doing it.  Can "
"also be disassembled into some useful parts."
msgstr "一个经典款怀表，可以让你在查看时间时显得很有派头。可以被拆解成零件。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "porcelain urn"
msgid_plural "porcelain urns"
msgstr[0] "瓷器骨灰罈"

#: data/json/items/tool/misc.json
#. ~ Description of "porcelain urn"
msgid ""
"A container for holding the remains of a loved one.  Its prior owners must "
"have taken good care of it, as you can see your face reflected clearly upon "
"its surface."
msgstr "用来存放亲人骨灰的容器。它的前主人一定把它照顾得很好，因为你可以看到你的脸清楚地反射在它的表面上。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "rollmat"
msgid_plural "rollmats"
msgstr[0] "睡墊"

#: data/json/items/tool/misc.json
#. ~ Description of "rollmat"
msgid ""
"A sheet of foam which can be rolled tightly for storage.  It insulates you "
"from the floor, making it easier to sleep.  Use it to unroll and place on the "
"ground."
msgstr "卷紧便携的泡沫垫。可以垫在地板上，让你更容易进入梦乡。使用它，即可将它展开、铺在地上。"

#: data/json/items/tool/misc.json
#. ~ "done_message" action message of item "rollmat"
msgid "You unroll the mat and lay it on the ground."
msgstr "你攤開毯子, 並且把它放在地上。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "safe deposit box"
msgid_plural "safe deposit boxes"
msgstr[0] "保險箱"

#: data/json/items/tool/misc.json
#. ~ Description of "safe deposit box"
msgid ""
"A secure combination-lock box.  Sadly, you don't know the combination.  "
"Breaking into it would destroy anything of value."
msgstr "一个组合式锁箱，不幸的是，你不知道密码。强行打开的话会破坏里头值钱的东西。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "sarcophagus access code"
msgid_plural "sarcophagus access codes"
msgstr[0] "石棺通行代碼"

#: data/json/items/tool/misc.json
#. ~ Description of "sarcophagus access code"
msgid ""
"A printout displaying a string of numbers, the passcode to access the "
"elevator in the hazardous waste sarcophagus."
msgstr "一串密码，用来启动通往危险废品储存间的电梯。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "small space heater"
msgid_plural "small space heaters"
msgstr[0] "小空間供暖器"

#: data/json/items/tool/misc.json
#. ~ Description of "small space heater"
#. ~ Description of "small space heater (on)"
msgid ""
"A portable electric heater that steadily emits warm air.  Raises temperature "
"about 10 degrees Celsius."
msgstr "一种便携式电加热器，能稳定地放出温暖的空气。将温度升高约10℃。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "small space heater (on)"
msgid_plural "small space heaters (on)"
msgstr[0] "小空間供暖器（啟動）"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "spray can"
msgid_plural "spray cans"
msgstr[0] "噴漆罐"

#: data/json/items/tool/misc.json
#. ~ Description of "spray can"
msgid ""
"An aerosol spray can filled with paint.  Activate it to make graffiti on the "
"floor."
msgstr "一个装满油漆的喷雾器。激活它可以在地板上涂鸦。"

#: data/json/items/tool/misc.json
#. ~ Description of "wooden stepladder"
msgid "A ten-foot wooden stepladder.  Activate it to set it down."
msgstr "这是一把十英尺高（约3米）的木制梯子。使用它来放下梯子。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "survival marker"
msgid_plural "survival markers"
msgstr[0] "生存者炭筆"

#: data/json/items/tool/misc.json
#. ~ Description of "survival marker"
msgid ""
"A sharpened piece of charcoal used as an improvised pencil.  Almost "
"guaranteed to get your hands all covered in charcoal.  Activate it to write "
"something down."
msgstr "只是一块被磨尖的木炭，你为了磨它，弄得整个手都是木炭黑。使用它来写字。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "retractable telescope"
msgid_plural "retractable telescopes"
msgstr[0] "伸縮望遠鏡"

#: data/json/items/tool/misc.json
#. ~ Description of "retractable telescope"
msgid ""
"A homemade collapsible telescope, perfect for a pirate.  Too large and "
"inaccurate to use as a weapon scope, but carrying it in your inventory will "
"double the distance that is mapped around you during your travels."
msgstr "一个自制的可折叠式望远镜，非常适合海盗。太大而且精度不高，无法用作武器瞄准镜，但把它带在身上可以让你看到的地图视野距离翻倍。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "tear gas sprayer"
msgid_plural "tear gas sprayers"
msgstr[0] "催泪瓦斯喷罐"

#: data/json/items/tool/misc.json
#. ~ Description of "tear gas sprayer"
msgid ""
"A pocket sized plastic canister filled with a pressurized tear gas spray, a "
"step above oleoresin capsicum pepper spray in terms of potency.  Most "
"commonly used by law enforcement and bear-wary hikers, but it became more "
"common in recent months due to anxiety over the riots.  Probably won't do "
"much against a zombie, but should give anything still breathing a rather "
"nasty surprise and give you time to get away.  It contains enough spray for "
"about twenty seconds of continuous application."
msgstr ""
"一个口袋大小的塑料罐，里面装满了加压的催泪瓦斯喷雾，在效力方面比辣椒喷雾高出一截。最常见的使用群体是执法人员和防范熊类袭击的徒步旅行者，但近几个月由于社会骚"
"乱引发的恐慌，其普及度显著提升。可能对丧尸没有多大作用，但应该会给任何仍在呼吸的东西一个相当恶心的惊喜，并给你时间逃跑。喷雾能持续约二十秒。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "C-4 payload"
msgid_plural "C-4 payloads"
msgstr[0] "C-4载体"

#: data/json/items/tool/misc.json
#. ~ Description of "C-4 payload"
msgid ""
"This is a dummy item used by c4 hacks.  You should never see it outside of "
"debug."
msgstr "这是被C-4无人机使用的虚拟物品。除了调试以外你不该在游戏里看到这玩意儿。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "tear gas payload"
msgid_plural "tear gas payloads"
msgstr[0] "催淚瓦斯火箭攜帶的爆炸物"

#: data/json/items/tool/misc.json
#. ~ Description of "tear gas payload"
msgid ""
"This is a dummy item used by tear gas hacks.  You should never see it outside "
"of debug."
msgstr "這是催淚瓦斯無人機使用的虛擬物品。你永遠不應該在除錯模式之外看到它。"

#: data/json/items/tool/misc.json
#. ~ "msg" action message of item "tear gas payload"
msgid "You pull the pin on the payload."
msgstr "你拉動催淚瓦斯載體上的拉銷。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "active tear gas payload"
msgid_plural "active tear gas payloads"
msgstr[0] "催淚瓦斯載體（啟動）"

#: data/json/items/tool/misc.json
#. ~ Description of "active tear gas payload"
msgid ""
"This is a dummy item used by tear gas hacks that just so happens to be "
"counting down.  You should never see it outside of debug."
msgstr "這是催淚瓦斯無人機使用的虛擬物品。已經啟動而且正在倒數。你永遠不應該在除錯模式之外看到它。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "telescoping umbrella (collapsed)"
msgid_plural "telescoping umbrellas (collapsed)"
msgstr[0] "伸缩雨伞（折叠）"

#: data/json/items/tool/misc.json
#. ~ Description of "telescoping umbrella (collapsed)"
msgid ""
"A telescoping umbrella which has been collapsed down for easy storage.  May "
"be used to keep dry when extended and wielded."
msgstr "伸缩雨伞，已折叠，便于存放。 展开并手持可避免淋雨。"

#: data/json/items/tool/misc.json
#. ~ "msg" action message of item "telescoping umbrella (collapsed)"
msgid "You open your umbrella."
msgstr "你打开了你的伞。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "telescoping umbrella (extended)"
msgid_plural "telescoping umbrellas (extended)"
msgstr[0] "伸缩雨伞（展开）"

#: data/json/items/tool/misc.json
#. ~ Description of "telescoping umbrella (extended)"
msgid ""
"A telescoping umbrella currently in its extended form, useful for keeping dry "
"when wielded.  May be collapsed down for easy storage."
msgstr "一种伸缩雨伞，已经展开，手持时避免淋雨。 可以折叠起来，便于存放。"

#: data/json/items/tool/misc.json
#. ~ "msg" action message of item "telescoping umbrella (extended)"
msgid "You collapse your umbrella."
msgstr "你折好你的伞。"

#: data/json/items/tool/misc.json
#. ~ Description of "travel toilet"
msgid ""
"A portable plastic toilet, designed to use plastic bags for waste instead of "
"plumbing."
msgstr "一个便携塑料坐便器，使用塑料袋而非管道收集排泄物。"

#: data/json/items/tool/misc.json
#. ~ "msg" action message of item "travel toilet"
msgid "You collapse the toilet for transport."
msgstr "你将坐便器折叠起来以便携带。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "folded travel toilet"
msgid_plural "folded travel toilets"
msgstr[0] "折叠旅行厕所"

#: data/json/items/tool/misc.json
#. ~ Description of "folded travel toilet"
msgid "A portable plastic toilet.  It has been collapsed for easy transport."
msgstr "一个便携塑料坐便器，已经被折叠起来以便携带。"

#: data/json/items/tool/misc.json
#. ~ "msg" action message of item "folded travel toilet"
msgid "You unfold the travel toilet."
msgstr "你展开旅行厕所。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "Flaming Chunk of Steel +2"
msgid_plural "Flaming Chunks of Steel +2"
msgstr[0] "燃燒鋼塊 +2"

#: data/json/items/tool/misc.json
#. ~ Description of "Flaming Chunk of Steel +2"
msgid "HOLY SHIT THIS THING IS ON FIRE!"
msgstr "我 的 天 啊！着 火 啦！！"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "Whistle of Tindalos"
msgid_plural "Whistles of Tindalos"
msgstr[0] "廷達洛斯之哨"

#: data/json/items/tool/misc.json
#. ~ Description of "Whistle of Tindalos"
msgid "Who is this Tindalos guy?"
msgstr "廷達洛斯這傢伙是誰？"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "umbrella"
msgid_plural "umbrellas"
msgstr[0] "雨傘"

#: data/json/items/tool/misc.json
#. ~ Description of "umbrella"
msgid "An umbrella with a pointy end, useful for keeping dry when wielded."
msgstr "尾端是尖狀的雨傘， 手拿著的時候能夠保持不被雨淋濕。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "vortex stone"
msgid_plural "vortex stones"
msgstr[0] "渦石"

#: data/json/items/tool/misc.json
#. ~ Description of "vortex stone"
msgid ""
"A stone with spirals all over it and holes around its perimeter.  Though it "
"is fairly large, it weighs next to nothing.  Air seems to gather around it."
msgstr "一块遍布漩涡刻痕的石头，四周遍布着孔洞。虽然看上去不小，但几乎没有重量，似乎有气流聚集在这块石头的周围。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "sandbox kit"
msgid_plural "sandbox kits"
msgstr[0] "沙坑玩具桶"

#: data/json/items/tool/misc.json
#. ~ Description of "sandbox kit"
msgid ""
"A plastic bucket holding a small spade and rake, perfect for building sand "
"castles!"
msgstr "一个装着小铲子和耙子的塑料桶，非常适合建造沙堡！"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "whistle multitool"
msgid_plural "whistle multitools"
msgstr[0] "多功能哨子"

#: data/json/items/tool/misc.json
#. ~ Description of "whistle multitool"
msgid ""
"A cheap gadget combining a whistle, thermometer, magnifying glass, and "
"compass."
msgstr "一件廉價的小工具，結合了哨子、溫度計、放大鏡和指南針。"

#: data/json/items/tool/misc.json
#. ~ Description of "aluminum stepladder"
msgid "A ten-foot aluminum stepladder.  Activate it to set it down."
msgstr "这是一把十英尺（约3米）高的铝制梯子。使用它来放下梯子。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "handheld glass cutter"
msgid_plural "handheld glass cutters"
msgstr[0] "手持式玻璃刀"

#: data/json/items/tool/misc.json
#. ~ Description of "handheld glass cutter"
msgid ""
"A handheld tool used for controlled breaking of glass.  A necessity for any "
"glass cutting projects."
msgstr "用來控制玻璃破碎的手持工具。任何玻璃切割工作的必需品。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "novelty pneumatic launcher"
msgid_plural "novelty pneumatic launchers"
msgstr[0] "新奇的氣動發射器"

#: data/json/items/tool/misc.json
#. ~ Description of "novelty pneumatic launcher"
msgid ""
"A toy that uses compressed air to launch small objects for the amusement of "
"children.  It is very tiring to reload, and completely ineffective as a "
"weapon.  Pump sold separately."
msgstr "利用压缩空气发射小物体的玩具，供儿童娱乐。重新装填非常累人，而且作为武器完全没用。气泵单独出售。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "dressage whip"
msgid_plural "dressage whips"
msgstr[0] "舞步长鞭"

#: data/json/items/tool/misc.json
#. ~ Description of "dressage whip"
msgid ""
"A long, thin and flexible rod that tapers to a point, originally used to "
"stimulate a horse and give them orders."
msgstr "一种从尾到头逐渐变长且灵活的细杆，最初用于刺激马并给它们下达命令。"

#: data/json/items/tool/misc.json
#. ~ Item name
msgid "riding crop"
msgid_plural "riding crops"
msgstr[0] "马鞭"

#: data/json/items/tool/misc.json
#. ~ Description of "riding crop"
msgid ""
"A rod ending in a leather popper originally used to stimulate a horse and "
"give them orders."
msgstr "一种皮制头部的杆子，最初用来刺激马并给它们下达命令。"

#: data/json/items/tool/misc.json
#. ~ Description of "monster teeth"
msgid ""
"Impossibly-sharp teeth extracted from a giant corpse.  You could use them as "
"a weapon, but you might want to wear gloves."
msgstr "一根从某个巨怪尸体上拔出来的锋利得出奇的牙齿。可以拿来戳人，不过还是先戴上手套比较好。"

#: data/json/items/tool/misc.json
#. ~ "done_message" action message of item "monster teeth"
msgid ""
"You carefully place the teeth on the ground, ready to be walked on by "
"something passing by."
msgstr "你小心地将牙齿放在地上，让它能被经过的东西压碎。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "banjo"
msgid_plural "banjos"
msgstr[0] "五絃琴"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "banjo"
msgid "A standard factory-made banjo.  Looks to be in working condition."
msgstr "一把工廠製造的標準五絃琴。看起來狀態不錯。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "bone flute"
msgid_plural "bone flutes"
msgstr[0] "骨笛"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "bone flute"
msgid "A polished bone flute with five finger holes."
msgstr "一支磨光了， 有五個指孔的骨笛。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "clarinet"
msgid_plural "clarinets"
msgstr[0] "豎笛"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "clarinet"
msgid "An ornate clarinet made from wood."
msgstr "一支華麗的木製豎笛。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "kantele"
msgid_plural "kanteles"
msgstr[0] "康特勒琴"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "kantele"
msgid ""
"A traditional Finnish string instrument.  According to myth the first one was "
"fashioned from a great pike's bone.  This ordinary wooden one doesn't seem "
"quite as special."
msgstr "一种芬兰传统的弦乐器。根据神话，第一把琴是用一根巨大的梭鱼骨头做成的。这把普通的木制版本似乎没有那么特别。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "flute"
msgid_plural "flutes"
msgstr[0] "橫笛"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "flute"
msgid "A simple silver-plated flute."
msgstr "一支簡單的鍍銀長笛。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "trumpet"
msgid_plural "trumpets"
msgstr[0] "小號"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "trumpet"
msgid "A brass trumpet with only a few dents here and there."
msgstr "一支黃銅小號，在某幾處有些凹痕。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "ukulele"
msgid_plural "ukuleles"
msgstr[0] "烏克麗麗"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "ukulele"
msgid ""
"A small factory-made ukulele.  Makes you wish you were on a tropical island, "
"or somewhere over the rainbow."
msgstr "一家小工厂生产尤克里里。让你希望自己在一个热带岛屿上，或者彩虹之上的某个地方。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "violin"
msgid_plural "violins"
msgstr[0] "小提琴"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "violin"
msgid ""
"A cheap, factory-made violin with a built-in holder for a bow.  Still "
"produces a nice sound."
msgstr "廉價的工廠製造的小提琴，帶有內置弓架。仍然能發出美妙的聲音。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "golden fiddle"
msgid_plural "golden fiddles"
msgstr[0] "黃金小提琴"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "golden fiddle"
msgid ""
"A shiny golden fiddle, with a strange aura around it.  You feel like it once "
"belonged to the best there's ever been."
msgstr "金色的小提琴閃閃發亮，周身散發著奇異的氣息。你覺得它曾經是最棒的小提琴之一。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "golden krar"
msgid_plural "golden krars"
msgstr[0] "金羯啰"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "golden krar"
msgid "A shiny golden krar, similar to a harp."
msgstr "一把形似竖琴的闪闪发光的金羯啰。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "krar"
msgid_plural "krars"
msgstr[0] "卡拉琴"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "krar"
msgid "A wooden krar, similar to a harp."
msgstr "一把木制卡拉琴，形似竖琴。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "drum, percussion"
msgid_plural "drums, percussion"
msgstr[0] "鼓"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "drum, percussion"
msgid "A standard factory-made percussion drum.  Looks to be in working condition."
msgstr "一个标准的工厂制造的打击鼓。看起来还完好能用。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "primitive drum, percussion"
msgid_plural "primitive drums, percussion"
msgstr[0] "非洲鼓"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "primitive drum, percussion"
msgid "A handmade primitive percussion drum.  Looks to be in working condition."
msgstr "一个手工制作的原始打击鼓。看起来还完好能用。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "harmonica with a holder"
msgid_plural "harmonicas with holders"
msgstr[0] "附拖架的口琴"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "harmonica with a holder"
msgid "A harmonica with a holder, so that you can play it without a free hand."
msgstr "附有支拖架的口琴， 因此你可以不用手就能演奏。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "acoustic guitar"
msgid_plural "acoustic guitars"
msgstr[0] "木吉他"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "acoustic guitar"
msgid ""
"A simple wooden acoustic guitar with a strap so you can wear it around, even "
"when not playing."
msgstr "簡單的木吉他， 附有皮帶， 所以你即使不演奏也可以穿戴在身上。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "electric guitar"
msgid_plural "electric guitars"
msgstr[0] "電吉他"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "electric guitar"
msgid ""
"A standard factory-made electric guitar.  It's probably better at smashing "
"heads than melting faces, these days.  Has a strap."
msgstr "標準工廠製造的電吉他。如今，它可能更擅長用來砸碎頭而不是讓人感動落淚。有帶子。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "bagpipes"
msgid_plural "bagpipes"
msgstr[0] "風笛"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "bagpipes"
msgid ""
"A traditional musical instrument, using enclosed reeds fed from a reservoir "
"of air contained within a leather bag.  It has a strap so you can wear it "
"around, even when not playing."
msgstr "传统乐器，使用封闭的簧管发声，由装满空气的皮包提供空气。它有一条背带，即使不在演奏的时候，也能穿着它到处走。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "tuba"
msgid_plural "tubas"
msgstr[0] "低音號"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "tuba"
#. ~ ol' is an informal short-form for old, and here is part of big-ol as
#. large-and-cumbersome.
msgid ""
"A big ol' tuba.  Much easier to play when you're wearing it.  Thankfully, "
"this one has a harness attached."
msgstr "一个大号的大号，穿在身上时更容易演奏。谢天谢地，这个上面已经安装有一条背带了。"

#: data/json/items/tool/musical_instruments.json
#. ~ Item name
msgid "saxophone"
msgid_plural "saxophones"
msgstr[0] "薩克斯風"

#: data/json/items/tool/musical_instruments.json
#. ~ Description of "saxophone"
msgid "A brass alto saxophone with a neck strap, so you can wear it while playing."
msgstr "一個附有頸部綁帶的銅製中音薩克斯風， 你可以穿戴著它來演奏。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "chicken cage"
msgid_plural "chicken cages"
msgstr[0] "雞籠"

#: data/json/items/tool/pets.json
#. ~ Description of "chicken cage"
msgid ""
"A wire container made for transporting chickens, but you can use it to hold "
"any tiny animal.  Use it on a suitable animal to capture, use it on an empty "
"tile to release."
msgstr "用於運送雞隻的鐵絲籠，但你可以把任何類似體型的小動物裝進去。使用後選擇合適的動物即可裝入，再次使用它後選擇要放出的方向即可放出。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "dog whistle"
msgid_plural "dog whistles"
msgstr[0] "狗笛"

#: data/json/items/tool/pets.json
#. ~ Description of "dog whistle"
msgid ""
"A small whistle.  When blown into, it produces a high tone that causes nearby "
"friendly dogs to either follow you closely and stop attacking, or start "
"attacking enemies if they are currently docile."
msgstr "一只小型的哨子，吹它的时候会产生一种高频的声波，让附近所有非敌对状态的狗狗都会向你靠拢并为你而战。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "shears"
msgid_plural "shears"
msgstr[0] "羊毛剪"

#: data/json/items/tool/pets.json
#. ~ Description of "shears"
msgid "A set of shears designed to obtain wool from sheep."
msgstr "这是一把用来剪羊毛的剪刀。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "forged shears"
msgid_plural "forged shears"
msgstr[0] "鍛製羊毛剪"

#: data/json/items/tool/pets.json
#. ~ Description of "forged shears"
msgid ""
"A set of heavy-duty shears designed to obtain wool from sheep.  Made of two "
"steel blades connected by spring leaf."
msgstr "用于剪羊毛的重型剪刀，由两片钢片以弹簧片连接而成。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "bronze shears"
msgid_plural "bronze shears"
msgstr[0] "青銅剪刀"

#: data/json/items/tool/pets.json
#. ~ Description of "bronze shears"
msgid ""
"A set of forged single-piece bronze shears for cutting fabrics.  Made of two "
"painstakingly sharpened blades connected by a carefully tempered twisted "
"bridge."
msgstr "这是一对锻造加工而成的青铜剪刀，用来剪切布料。由两片经过精心磨砺的刀片组成，并由一个经过精心回火的曲柄连接。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "electric shears"
msgid_plural "electric shears"
msgstr[0] "電動羊毛剪"

#: data/json/items/tool/pets.json
#. ~ Description of "electric shears"
msgid "Electric corded shears, used to quickly shear animals."
msgstr "有线电动剪，用来快速给动物剪毛。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "horse tack"
msgid_plural "horse tacks"
msgstr[0] "馬鞍"

#: data/json/items/tool/pets.json
#. ~ Description of "horse tack"
msgid ""
"A saddle, bridle, and associated tack that can be placed on a tamed animal "
"that is capable of being ridden."
msgstr "一組鞍座、韁繩和附帶的大頭釘，可以穿戴到已馴服的動物上，你就可以騎乘動物了。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "livestock scale"
msgid_plural "livestock scales"
msgstr[0] "牲畜秤"

#: data/json/items/tool/pets.json
#. ~ Description of "livestock scale"
msgid ""
"A giant electronic scale with a rubber mat meant for weighing a single horse, "
"cow, or other large animal.  You could also weigh yourself with it."
msgstr "帶有橡膠墊的巨型電子秤，用於量秤一匹馬、牛或其他大型動物的重量。你也可以用它來量秤自己。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "pet carrier"
msgid_plural "pet carriers"
msgstr[0] "寵物籠"

#: data/json/items/tool/pets.json
#. ~ Description of "pet carrier"
msgid ""
"A plastic container meant to hold pets for transport.  Use it on a suitable "
"animal to capture, use it on an empty tile to release."
msgstr "用來裝載攜行寵物的塑膠容器。在合適的動物上使用它來捕獲動物，在空地上使用它來釋放動物。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "wooden pet carrier"
msgid_plural "wooden pet carriers"
msgstr[0] "木製寵物籠"

#: data/json/items/tool/pets.json
#. ~ Description of "wooden pet carrier"
msgid ""
"A wooden container meant to hold pets for transport.  Use it on a suitable "
"animal to capture, use it on an empty tile to release."
msgstr "木製的容器，設計用來運送寵物。使用後選擇合適的動物即可裝入，再次使用它後選擇要放出的方向即可放出。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "glass terrarium"
msgid_plural "glass terrariums"
msgstr[0] "玻璃盆栽"

#: data/json/items/tool/pets.json
#. ~ Description of "glass terrarium"
msgid ""
"A glass container meant to hold plants and/or insects.  They come in a "
"variety of sizes."
msgstr "一个用来盛放植物和/或昆虫的玻璃容器。有各种尺寸。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "survivor giant firefly lamp"
msgid_plural "survivor giant firefly lamps"
msgstr[0] "生存者巨型螢火蟲燈"

#: data/json/items/tool/pets.json
#. ~ Description of "survivor giant firefly lamp"
msgid ""
"Some enterprising survivor has decided to turn this terrarium into a light "
"source, using what appear to be a giant firefly and triffid vegetation."
msgstr "某个有进取心的幸存者决定用一只巨型萤火虫和三尖树植物把这个玻璃盆栽变成一个光源。"

#: data/json/items/tool/pets.json
#. ~ Item name
msgid "wooden dog whistle"
msgid_plural "wooden dog whistles"
msgstr[0] "木製狗笛"

#: data/json/items/tool/pets.json
#. ~ Description of "wooden dog whistle"
msgid ""
"A whistle carved out of hardwood.  When blown into, it produces a high tone "
"that causes nearby friendly dogs to either follow you closely and stop "
"attacking, or start attacking enemies if they are currently docile."
msgstr "一只硬木雕成的哨子，吹它的时候会产生一种高频的声波，让附近所有非敌对状态的狗狗都会向你靠拢并为你而战。"

#: data/json/items/tool/radio_tools.json
#. ~ Item name
msgid "RC control"
msgid_plural "RC controls"
msgstr[0] "遙控車控制器"

#: data/json/items/tool/radio_tools.json
#. ~ Description of "RC control"
msgid ""
"A remote control for an RC car, with a joystick to steer the car and colorful "
"buttons that don't seem to do anything.  Perhaps they were for the deluxe "
"model?"
msgstr "一个用来操纵遥控车的无线控制器，通过摇杆来控制车的移动，还有一堆用不到的按钮，或许是用来控制更高级的型号的。"

#: data/json/items/tool/radio_tools.json
#. ~ Item name
msgid "RC car"
msgid_plural "RC cars"
msgstr[0] "遙控車"

#: data/json/items/tool/radio_tools.json
#. ~ Description of "RC car"
msgid "A remote-controlled car.  Fun for all ages."
msgstr "一辆遥控车，老少皆宜。"

#: data/json/items/tool/radio_tools.json
#. ~ Item name
msgid "RC car (on)"
msgid_plural "RC cars (on)"
msgstr[0] "遙控車 (啟動)"

#: data/json/items/tool/radio_tools.json
#. ~ Description of "RC car (on)"
msgid ""
"A remote-controlled toy car.  It is turned on and draining its batteries just "
"like a real electric car!  Use a remote control to drive it around."
msgstr "这辆玩具遥控车已经开启，它已经被打开了，正跟正儿八经的电动车一样吃着电池！使用无线控制器来驾驶它。"

#: data/json/items/tool/radio_tools.json
#. ~ "sound_message" action message of item "RC car (on)"
msgid "buzzz…"
msgstr "滋滋…"

#: data/json/items/tool/radio_tools.json
#. ~ Item name
msgid "radio activation mod"
msgid_plural "radio activation mods"
msgstr[0] "無線電啟動模組"

#: data/json/items/tool/radio_tools.json
#. ~ Description of "radio activation mod"
msgid ""
"A small electronic device that can be attached to certain items to activate "
"them with a radio signal from an RC car controller."
msgstr "这枚小型电子元件可以被安装到某些物品上，使其可以在接收到无线控制器的信号后开启。"

#: data/json/items/tool/radio_tools.json
#. ~ Item name
msgid "radio (off)"
msgid_plural "radios (off)"
msgstr[0] "無線電 (關閉)"

#: data/json/items/tool/radio_tools.json
#. ~ Description of "radio (off)"
msgid ""
"A portable radio.  Using this radio turns it on.  It will pick up any nearby "
"signals being broadcasted and play them audibly."
msgstr "无线电，能够接受信号，并转化为声波。据说要是对准了信号塔，声音会格外响亮。"

#: data/json/items/tool/radio_tools.json
#. ~ Item name
msgid "radio (on)"
msgid_plural "radios (on)"
msgstr[0] "無線電 (啟動)"

#: data/json/items/tool/radio_tools.json
#. ~ Description of "radio (on)"
msgid ""
"A portable radio that is turned on and continually draining its batteries.  "
"It is playing the broadcast being sent from any nearby radio towers."
msgstr "这台无线电设备已经被启动，不停消耗着电池的同时不断向你播送着附近电台传出的资讯。"

#: data/json/items/tool/radio_tools.json
#. ~ Item name
msgid "two-way radio"
msgid_plural "two-way radios"
msgstr[0] "雙向無線電"

#: data/json/items/tool/radio_tools.json
#. ~ Description of "two-way radio"
msgid ""
"A radio with a transmitting unit.  You could use it to contact someone who "
"also has one."
msgstr "一种带有发射单元的收音机。你可以用它来联系同样拥有它的人。"

#: data/json/items/tool/radio_tools.json
#. ~ Item name
msgid "remote vehicle controller"
msgid_plural "remote vehicle controllers"
msgstr[0] "汽車遙控器"

#: data/json/items/tool/radio_tools.json
#. ~ Description of "remote vehicle controller"
msgid ""
"A remote controller for a real car.  Can turn onboard devices on and off.  "
"Some cars can be driven remotely."
msgstr "一个真车的遥控器。可以打开和关闭机载设备。有些汽车还可以远程驾驶。"

#: data/json/items/tool/raincatchers.json
#. ~ Description of "birchbark funnel"
msgid ""
"A small birchbark funnel.  Place it above an outdoor container to collect "
"rainwater."
msgstr "一个小型桦皮漏斗。放置在室外的容器上来收集雨水。"

#: data/json/items/tool/raincatchers.json
#. ~ "done_message" action message of item "birchbark funnel"
msgid "You place the birchbark funnel, waiting to collect rain."
msgstr "你設置了樺皮漏斗，準備收集雨水。"

#: data/json/items/tool/raincatchers.json
#. ~ Description of "funnel"
msgid ""
"A plastic funnel used to collect rainwater.  Use it outside and place a "
"container beneath it to collect water when it rains."
msgstr "一个用来收集雨水的塑料漏斗。在户外激活该物品把它放在地上，然后在它下面放一个容器就可以收集雨水了。"

#: data/json/items/tool/raincatchers.json
#. ~ "done_message" action message of item "funnel"
msgid "You place the funnel, waiting to collect rain."
msgstr "你設置了集雨器, 準備收集雨水。"

#: data/json/items/tool/raincatchers.json
#. ~ Description of "leather funnel"
msgid ""
"A small leather funnel used to collect rainwater.  Use it outside and place a "
"container beneath it to collect water when it rains."
msgstr "一个用来收集雨水的小型皮革漏斗。在户外激活该物品把它放在地上，然后在它下面放一个容器就可以收集雨水了。"

#: data/json/items/tool/raincatchers.json
#. ~ "done_message" action message of item "leather funnel"
msgid "You place the leather funnel, waiting to collect rain."
msgstr "你設置了皮製漏斗, 準備收集雨水。"

#: data/json/items/tool/raincatchers.json
#. ~ Description of "makeshift funnel"
msgid ""
"A small makeshift funnel used to collect rainwater.  Use it outside and place "
"a container beneath it to collect water when it rains."
msgstr "一个用来收集雨水的小型自制漏斗。在户外激活该物品把它放在地上，然后在它下面放一个容器就可以收集雨水了。"

#: data/json/items/tool/raincatchers.json
#. ~ "done_message" action message of item "makeshift funnel"
msgid "You place the makeshift funnel, waiting to collect rain."
msgstr "你設置了粗製集雨器, 準備收集雨水。"

#: data/json/items/tool/raincatchers.json
#. ~ Description of "metal funnel"
msgid ""
"A large metal funnel used to collect rainwater.  Less portable than plastic "
"funnels, but collects more water.  Use it outside and place a container "
"beneath it to collect water when it rains."
msgstr "一个用来收集雨水的大型金属漏斗。相较于塑料版更难移动，但能收集更多水。在户外激活该物品把它放在地上，然后在它下面放一个容器就可以收集雨水了。"

#: data/json/items/tool/raincatchers.json
#. ~ "done_message" action message of item "metal funnel"
msgid "You place the metal funnel, waiting to collect rain."
msgstr "你設置了金屬集雨器, 準備收集雨水。"

#: data/json/items/tool/raincatchers.json
#. ~ Item name
msgid "tarp raincatcher"
msgid_plural "tarp raincatchers"
msgstr[0] "蓬布集雨器"

#: data/json/items/tool/raincatchers.json
#. ~ Description of "tarp raincatcher"
msgid ""
"A collection of sticks and string with a tarpaulin to set up as an improvised "
"raincatcher."
msgstr "由一些棍子和绳子与防水油布所搭建的一个简易集雨器。"

#: data/json/items/tool/raincatchers.json
#. ~ "done_message" action message of item "tarp raincatcher"
msgid "You set up the raincatcher, waiting to collect water."
msgstr "你設置了蓬布集雨器，等待收集雨水。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "barometer"
msgid_plural "barometers"
msgstr[0] "氣壓計"

#: data/json/items/tool/science.json
#. ~ Description of "barometer"
msgid "A plastic barometer that can read atmospheric pressure."
msgstr "一个塑料气压计，可以让你知道当前气压。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "goo canister"
msgid_plural "goo canisters"
msgstr[0] "黏液罐"

#: data/json/items/tool/science.json
#. ~ Description of "goo canister"
msgid ""
"A metal canister with a label reading: \"Warning: contains highly toxic and "
"corrosive materials.  Contents may be sentient.  Open at your own risk.\" You "
"think you can feel something moving inside it."
msgstr "一个金属罐子，上面贴着个标签：\"警告：内含剧毒及极强腐蚀性物质！该物质具有自主意识！开启后果自负！\"你感觉到里面有什么东西在动。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "chemistry set"
msgid_plural "chemistry sets"
msgstr[0] "化學儀器套組"

#: data/json/items/tool/science.json
#. ~ Description of "chemistry set"
msgid ""
"A chemistry set stored in a box.  It includes glass containers, hoses, metal "
"wire, a hotplate, and a pair of safety glasses.  It might be used to craft "
"some chemistry projects if you're so inclined."
msgstr ""
"这是一整套装在盒子里的化学实验装置，包括一些玻璃器皿、软管、金属导线、加热板以及护目镜。如果你需要的话，它可用来制造化学用品。\n"
"\"用于制造纯度高达99.1%的淡蓝色结晶。\""

#: data/json/items/tool/science.json
#. ~ Item name
msgid "basic chemistry set"
msgid_plural "basic chemistry sets"
msgstr[0] "基本化學儀器套組"

#: data/json/items/tool/science.json
#. ~ Description of "basic chemistry set"
msgid ""
"A basic chemistry set including glass containers, hoses, and a pair of safety "
"glasses.  It might be used to craft some chemistry projects if you're so "
"inclined, but you'll need a source of heat."
msgstr "这是一整套基本的化学实验装置，包括一些玻璃器皿、软管以及护目镜。如果你需要的话，它可用来制造化学用品。这件物品需要热源。"

#: data/json/items/tool/science.json data/mods/innawood/items/electronics.json
#. ~ Item name
msgid "electrolysis kit"
msgid_plural "electrolysis kits"
msgstr[0] "電解套件"

#: data/json/items/tool/science.json
#. ~ Description of "electrolysis kit"
msgid ""
"A set of wiring and electrodes for applying a direct current, usually to a "
"liquid.  Useful for crafting.  Load with a storage battery or 12 V vehicle "
"battery to use."
msgstr "一整套能够进行直流电电解的线缆和电极设备，通常使用在液体上。可以用来制造物品。需要安装一个蓄电池或者 12 V 的载具电池配合使用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "ketene lamp"
msgid_plural "ketene lamps"
msgstr[0] "烯酮燈"

#: data/json/items/tool/science.json
#. ~ Description of "ketene lamp"
msgid ""
"A section of glass pipe with a bulb in the middle, which contains an "
"electrical heating element.  It is used for producing ketene via pyrolysis of "
"acetone or 1,3-butadiene from cyclohexane, for use in other chemical "
"reactions.  Due to the instability of ketene, it can't be stored and must be "
"used immediately."
msgstr ""
"这是一段中间带有灯泡的玻璃管，其中包含一个电热器。它用于通过丙酮或环己烷中的1,3-"
"丁二烯加热分解生产乙烯酮，用于其他化学反应。由于乙烯酮的不稳定性，它无法储存，必须随制随用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "makerspace kit for STEM"
msgid_plural "makerspace kits for STEM"
msgstr[0] "創客的STEM工具"

#: data/json/items/tool/science.json
#. ~ Description of "makerspace kit for STEM"
msgid ""
"A kit with hundreds of pieces and dozens of blueprints for small engineering "
"projects designed for beginner learners.  Explore mechanics and hydraulics!"
msgstr "内含数百个部件，以及数十张蓝图，搭建专为入门者设计的小型工程项目。探索机械和液压的奥秘！"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "robotics kit for young learners"
msgid_plural "robotics kits for young learners"
msgstr[0] "機器人玩具工具套件"

#: data/json/items/tool/science.json
#. ~ Description of "robotics kit for young learners"
msgid ""
"A complete robotics engineering system, for learning the basics of building "
"and programming robots.  Using sensors, motors, a core controller, and "
"hundreds of snap-together building pieces, you can follow the instructions to "
"assemble 12 different robots.  The versatile parts also allow you to make "
"robots according to your own designs."
msgstr ""
"一个完整的机器人工程系统，用于学习构建和编程机器人的基础知识。使用传感器、电机、核心控制器和数百个拼搭部件组合，你可以按照说明书组装12"
"台完全不同的机器人。多功能部件还能让你根据自己的设计制造机器人。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "Stirling engine kit"
msgid_plural "Stirling engine kits"
msgstr[0] "史特靈引擎工具套件"

#: data/json/items/tool/science.json
#. ~ Description of "Stirling engine kit"
msgid ""
"A Stirling engine kit that demonstrates the principles behind the generation "
"of electricity through the use of hot air."
msgstr "史特靈引擎工具套件展示了使用熱空氣發電的原理。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "small vacuum oven"
msgid_plural "small vacuum ovens"
msgstr[0] "小型真空爐"

#: data/json/items/tool/science.json
#. ~ Description of "small vacuum oven"
msgid ""
"A small 0.9 cubic foot vacuum oven used to purge residual solvents out of "
"liquids and solids.  Looks kind of like a microwave."
msgstr "一个体积为0.9立方英尺的小型真空炉，能够清除液体和固体中的残留溶剂。看起来有点像微波炉。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "small closed loop extractor"
msgid_plural "small closed loop extractors"
msgstr[0] "小型密閉循環萃取機"

#: data/json/items/tool/science.json
#. ~ Description of "small closed loop extractor"
msgid ""
"A small closed loop extractor used for extracting essential oils from organic "
"material, producing a high quality-extract.  It consists of a long metal tube "
"clamped onto a steel \"honey pot\".  Organic material is packed in the tube, "
"flushed with solvent, and essential oils gathered from the pot.  Must be "
"powered up to operate."
msgstr ""
"一台小型闭环萃取器，能够从有机原料中提取精油，生产出高品质的提取物。它的主体由一个钢制\"蜜罐\""
"和固定在其上方的长金属管组成。将有机原料装入金属管中，用有机溶剂反复冲洗，然后从坩埚中收集精油。需要通电才能正常运行。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "large closed loop extractor"
msgid_plural "large closed loop extractors"
msgstr[0] "大型密閉循環萃取機"

#: data/json/items/tool/science.json
#. ~ Description of "large closed loop extractor"
msgid ""
"A large machine used for extracting essential oils from large batches of "
"organic material, producing a low-quality crude oil.  It consists of three "
"long metal tubes funneled into a large drum that's set horizontally.  A "
"series of hoses and tubes come out of the machine going to different valves.  "
"It needs to be powered up to operate."
msgstr ""
"一台大型闭环萃取器，能够从大量有机原料中提取精油，生产出低品质的提取物。它由三根长金属管组成，这些金属管汇入水平放置的鼓形釜中。一系列软管和玻璃管从机器中伸"
"出，通往不同的阀门。需要通电才能正常运行。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "makeshift essential oil extractor"
msgid_plural "makeshift essential oil extractors"
msgstr[0] "粗製精油萃取機"

#: data/json/items/tool/science.json
#. ~ Description of "makeshift essential oil extractor"
msgid ""
"A makeshift extraction system.  It's pretty much just a 55 gallon drum, a "
"pipe to stir the solution, and a faucet at the bottom to drain the extractor. "
" Not the most ideal piece of equipment, but it will work."
msgstr "一台自制精油萃取器。基本上就是个55加仑大桶，配上一根搅拌溶剂用的钢管以及底部一个用来排水的水龙头组成。不是最理想的设备，但也能勉强用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "disassembled catalytic cracking reactor"
msgid_plural "disassembled catalytic cracking reactors"
msgstr[0] "催化裂解反应器（未组装）"

#: data/json/items/tool/science.json
#. ~ Description of "disassembled catalytic cracking reactor"
msgid ""
"A makeshift extraction system, or as makeshift as you can consider something "
"that was purpose-built in a laboratory by a group of experts.  Meticulously "
"disassembled.  You can reassemble and plug it into your own power grid to use "
"it."
msgstr "一套临时的催化裂解系统，或者说是那种实验室的研究人员建造的临时制取装置。现在它被仔细地拆解开了，你可以将它装好并接入你的电网使用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "qualitative filter paper"
msgid_plural "qualitative filter paper"
msgstr[0] "定性濾紙"

#: data/json/items/tool/science.json
#. ~ Description of "qualitative filter paper"
msgid ""
"A piece of filter paper for separating solids from liquids.  This filter "
"paper has a rating of 2 microns, separating more solids out than quantitative "
"filter paper, but the process takes longer.  It's intended to be disposable, "
"but you could probably use it for some time before it's unusable."
msgstr ""
"一片能将固体从液体中分离出来的滤纸。这种滤纸的过滤等级为2"
"微米，比定量滤纸能分离出更多的固体，但这一过程需要更长的时间。它是一次性的，但你也许能够在完全失效前多次使用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "quantitative filter paper"
msgid_plural "quantitative filter paper"
msgstr[0] "定量濾紙"

#: data/json/items/tool/science.json
#. ~ Description of "quantitative filter paper"
msgid ""
"A piece of filter paper for separating solids from liquids.  This filter "
"paper has a rating of 20 microns, separating less solids out than qualitative "
"filter paper, but the process is much faster.  It's intended to be "
"disposable, but you could probably use it for some time before it's unusable."
msgstr ""
"一片能将固体从液体中分离出来的滤纸。这种滤纸的过滤等级为20"
"微米，不如定性滤纸所能分离出固体多，但这一过程耗时更短。它是一次性的，但你也许能够在完全失效前多次使用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "plastic gasket set"
msgid_plural "plastic gasket sets"
msgstr[0] "塑膠墊片"

#: data/json/items/tool/science.json
#. ~ Description of "plastic gasket set"
msgid ""
"A set of three plastic gaskets.  They're intended to be single-use, but you "
"could probably use it for some time before they're too worn out to use."
msgstr "一套三个的塑料垫片。它是一次性的，但你也许能够在完全失效前多次使用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "vacuum pump"
msgid_plural "vacuum pumps"
msgstr[0] "真空泵"

#: data/json/items/tool/science.json
#. ~ Description of "vacuum pump"
msgid ""
"A small belt-driven mechanical pump capable of achieving a vacuum of -29.99 "
"hg (50 microns)."
msgstr "一台由小型皮带驱动的机械真空泵，能够达到-29.99汞柱（50微米）的真空。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "recovery pump"
msgid_plural "recovery pumps"
msgstr[0] "回收泵"

#: data/json/items/tool/science.json
#. ~ Description of "recovery pump"
msgid ""
"A medium-sized vacuum pump designed to recover solvent (hydrocarbons) from "
"extracted essential oils."
msgstr "一种从萃取的精油中回收溶剂（碳氢化合物）的中型真空泵。"

#: data/json/items/tool/science.json
#. ~ Description of "makeshift water electrolyzer"
msgid ""
"A makeshift appliance which decomposes water into oxygen and hydrogen via "
"electrolysis of sodium hydroxide solution.  Much less energy-efficient than "
"actual industrial equipment."
msgstr "一台自制的通过碱性溶液电解将水分解成氧气和氢气的设备。能源效率远低于实际工业设备。"

#: data/json/items/tool/science.json
#. ~ Description of "makeshift ammonia machine reactor"
msgid ""
"A huge appliance built from salvaged industrial equipment, which produces "
"ammonia via the Haber-Bosch process from hydrogen and nitrogen.  As it uses "
"primitive catalysts for the reaction, energy efficiency is very low.  This "
"one is powered by electricity."
msgstr "一台巨大的设备，由回收来的工业设备制成，通过哈伯-博施法用氢气和氮气反应合成氨。由于使用较为原始的催化剂进行反应，能量效率非常低。这台是电力驱动的。"

#: data/json/items/tool/science.json
#. ~ Description of "makeshift ammonia machine pipework"
msgid ""
"A rather complicated system of thick-walled pipes, powerful compressors, and "
"wiring, meant to interface with a reactor producing ammonia from nitrogen and "
"hydrogen via Haber-Bosch process.  It also acts as a power source for all the "
"low-powered electrical components of the system."
msgstr ""
"一个相当复杂的系统，由厚壁管道、强大的压缩机和电线组成，用于连接氨反应器，通过哈伯-"
"博施法用氢气和氮气合成氨。它还可以作为系统中所有低功耗电气组件的供电电源。"

#: data/json/items/tool/science.json
#. ~ Description of "makeshift nitrogen generator"
msgid ""
"A large makeshift appliance which captures nitrogen from the air for use in "
"chemistry projects.  It includes a standard air filter for filtering out dust "
"and other large particles, a deliquescent dryer to remove water vapor from "
"air, and a nitrogen membrane filter to separate nitrogen from dry air."
msgstr ""
"一台自制的从空气中收集氮气用于化学反应的大型设备。它包括一个用于过滤灰尘和其他大颗粒物的标准空气过滤器，一个用于去除空气中水汽的潮解干燥器，以及一个用于从干"
"燥空气中分离氮气的氮气膜过滤器。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "butane tank"
msgid_plural "tanks of butane"
msgstr[0] "丁烷桶"

#: data/json/items/tool/science.json
#. ~ Description of "butane tank"
msgid ""
"A tank of compressed butane.  Aside from its practicality as fuel, it can "
"also be used to extract essential oils from organic material."
msgstr "一个大型压缩丁烷罐。除了可以用作燃料以外，还可以用来从有机物质中提取精油。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "hydrogen tank"
msgid_plural "hydrogen tanks"
msgstr[0] "氫氣罐"

#: data/json/items/tool/science.json
#. ~ Description of "hydrogen tank"
msgid ""
"A tank of compressed hydrogen gas.  If you need to make water from scratch, "
"or lift a zeppelin, it could come in handy."
msgstr "壓縮氫氣罐。如果你需要從零開始製水或抬升齊柏林飛船，它可能會派上用場。"

#: data/json/items/tool/science.json
#: data/mods/Aftershock/items/containers.json
#: data/mods/aftershock_exoplanet/items/containers.json
#. ~ Item name
msgid "pressurized tank"
msgid_plural "pressurized tanks"
msgstr[0] "加壓罐"

#: data/json/items/tool/science.json
#. ~ Description of "pressurized tank"
msgid "A tank designed to hold high pressure gases."
msgstr "設計用於容納高壓氣體的儲存罐。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "hygrometer"
msgid_plural "hygrometers"
msgstr[0] "濕度計"

#: data/json/items/tool/science.json
#. ~ Description of "hygrometer"
msgid "A plastic hygrometer that can read the relative humidity in the air."
msgstr "一個塑膠濕度計， 可以用來檢視環境濕度。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "nitrogen tank"
msgid_plural "nitrogen tanks"
msgstr[0] "氮氣罐"

#: data/json/items/tool/science.json
#. ~ Description of "nitrogen tank"
msgid ""
"A tank of compressed nitrogen gas.  Nitrogen is useful for its lack of "
"reactivity.  Don't try to breathe it."
msgstr "壓縮氮氣罐。氮氣因其缺乏反應性而很有用。不要嘗試吸它。"

#: data/json/items/tool/science.json
#. ~ Item name
#. ~ Magazine name
msgid "oxygen tank"
msgid_plural "oxygen tanks"
msgstr[0] "氧氣罐"

#: data/json/items/tool/science.json
#. ~ Description of magazine "oxygen tank"
#. ~ Description of "oxygen tank"
msgid ""
"A large steel cylinder used for storing pressurized gas.  It is marked with a "
"faded, but legible O2 symbol."
msgstr "用於儲存加壓氣體的大型鋼瓶。它標有已褪色但仍能辨識的O2符號。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "platinum grille"
msgid_plural "platinum grilles"
msgstr[0] "鉑格柵"

#: data/json/items/tool/science.json
#. ~ Description of "platinum grille"
msgid ""
"A metal grille with a layer of platinum plating, suitable for use as a "
"catalyst for some chemical reactions."
msgstr "鍍有一層鉑金的金屬格柵，適合用作某些化學反應的催化劑。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "portal generator"
msgid_plural "portal generators"
msgstr[0] "傳送門產生器"

#: data/json/items/tool/science.json
#. ~ Description of "portal generator"
msgid ""
"A rare, bizarre, and arcane device of an otherworldly nature.  It's giving "
"you a headache just looking at it.  It is covered in alien markings."
msgstr "一个罕见、奇异、不可思议的来自异界的装置。光是盯着它看上一会就会让你头疼。上面覆盖了各种奇特的陌生符号。"

#: data/json/items/tool/science.json
#. ~ Description of "teleport pad"
msgid ""
"A kit for a teleporter trap, consisting of a teleporter and a solar cell that "
"is triggered when stepped upon."
msgstr "这是一个由传送器和太阳能电池组成的传送陷阱，踩上去会触发它。"

#: data/json/items/tool/science.json
#. ~ "done_message" action message of item "teleport pad"
msgid "You place the telepad."
msgstr "你設置了傳送板。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "teleporter"
msgid_plural "teleporters"
msgstr[0] "傳送器"

#: data/json/items/tool/science.json
#. ~ Description of "teleporter"
msgid "An experimental device that will teleport you a short distance when activated."
msgstr "一个神秘的装置，激活后能让你传送一小段距离。至于会不会传到怪物堆里，那就听天由命了。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "Doppler Radar Turbo 2000"
msgid_plural "Doppler Radar Turbo 2000s"
msgstr[0] "渦輪2000型都普勒天氣雷達"

#: data/json/items/tool/science.json
#. ~ Description of "Doppler Radar Turbo 2000"
msgid ""
"A briefcase with a built-in laptop that looks like it's from the 80s.  Its "
"vintage monochrome monitor displays a plethora of meteorological data.  No "
"sign of the FLDSMDFR, however."
msgstr ""
"一个内嵌了一台笔记本电脑的公文包，电脑看起来像是80"
"年代老电脑。它古董的单色显示器上显示着大量的气象数据。不过貌似它没法帮你找到什么超级食物制造机。（注：《美食从天降》）"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "basic laboratory analysis kit"
msgid_plural "basic laboratory analysis kits"
msgstr[0] "基本的實驗室分析套件"

#: data/json/items/tool/science.json
#. ~ Description of "basic laboratory analysis kit"
msgid ""
"A hefty kit containing some basic things you should probably not try to do "
"precise chemistry without: a small balance scale, a spectrophotometer, a "
"melting point apparatus, a pH meter, and a set of paper for thin layer "
"chromatography.  This makes it a lot easier to feel confident that the "
"chemical you've made is what you think it is."
msgstr ""
"一組沉重的套件，包含一些你嘗試進行精密化學的必備工具：一個小天平、一個分光光度計、一個熔點儀、一個酸鹼測計和一套用於薄層層析的紙。這讓你更加確信你所製造的化"
"學物質就是你所想要的樣子。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "small weight scale"
msgid_plural "small weight scales"
msgstr[0] "小磅秤"

#: data/json/items/tool/science.json
#. ~ Description of "small weight scale"
msgid ""
"A simple scale that uses a set of steel weights on sliding bars to measure a "
"sample's mass quite accurately."
msgstr "一個簡單的磅秤，在滑桿上使用一組鋼製砝碼來測量樣品質量，相當準確。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "spectrophotometer"
msgid_plural "spectrophotometers"
msgstr[0] "分光光度計"

#: data/json/items/tool/science.json
#. ~ Description of "spectrophotometer"
msgid ""
"A ubiquitous analytical chemistry tool that measures the light absorption of "
"a liquid sample in a special tube called a cuvette."
msgstr "一種常見的分析化學工具，可測量稱為比色皿的特殊試管中液體樣品的光吸收率。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "set of spectrometry cuvettes"
msgid_plural "sets of spectrometry cuvettes"
msgstr[0] "一套光譜儀分光液槽"

#: data/json/items/tool/science.json
#. ~ Description of "set of spectrometry cuvettes"
msgid ""
"A small box filled with precisely-calibrated square plastic tubes for "
"laboratory spectrometer use."
msgstr "一個小盒子，裡面裝有精確校準的方形塑膠管，供實驗室光譜儀使用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "pH meter"
msgid_plural "pH meters"
msgstr[0] "酸度計"

#: data/json/items/tool/science.json
#. ~ Description of "pH meter"
msgid ""
"A pair of glass probes attached to a voltmeter.  By putting one probe into a "
"calibration solution (conveniently included) and the other in a substance, "
"you can calculate the substance's acidity."
msgstr "一對連接到電壓表的玻璃探針。將一個探針放入校準溶液（儀器已配備）中，將另一個探針放入物質中，你可以計算該物質的酸度。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "voltmeter"
msgid_plural "voltmeters"
msgstr[0] "電壓計"

#: data/json/items/tool/science.json
#. ~ Description of "voltmeter"
msgid ""
"A device with two probes that let you measure the electrical potential "
"between two points."
msgstr "具有兩個探針的設備，可讓你測量兩點之間的電位。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "multimeter"
msgid_plural "multimeters"
msgstr[0] "三用電表"

#: data/json/items/tool/science.json
#. ~ Description of "multimeter"
msgid ""
"A gadget that is a little bigger than a handheld calculator, with a digital "
"display and two pointed probes connected by wires.  It can measure not just "
"voltage, but current in amps, and resistance in ohms, as well as test for "
"electrical continuity."
msgstr "比手持式計算器稍大一點的小工具，帶有數位顯示器和兩個透過電線連接的尖頭探針。它不僅可以測量電壓，還可以測量電流安培和電阻歐姆，以及電氣連續性測試。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "melting point apparatus"
msgid_plural "units of melting point apparatus"
msgstr[0] "熔點測定儀器組件"

#: data/json/items/tool/science.json
#. ~ Description of "melting point apparatus"
msgid ""
"A hot plate with a metal housing attached.  The metal housing has a "
"magnification viewport and a slot into which a capillary tube containing a "
"crystallized sample is inserted.  The device lets you precisely measure the "
"melting point of a crystal, a property very useful in identifying what it is "
"and how pure it is."
msgstr "附有金屬外殼的電熱板。金屬外殼具有放大觀察口和，以及含有結晶樣品的細管的插槽。該設備可讓你精確測量晶體的熔點，此特性對於識別晶體的性質和純度非常有用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "vortex device"
msgid_plural "vortex devices"
msgstr[0] "渦流裝置"

#: data/json/items/tool/science.json
#. ~ Description of "vortex device"
msgid ""
"A small, hefty, boring-looking machine.  Its weighted trapezoidal frame has a "
"single on-off switch and a speed dial, and on top of it sits a rubber "
"receptacle.  Pressing a test tube into the receptacle would, with power, "
"rapidly shake and mix the contents of the test tube.  It's surprisingly fun "
"to use."
msgstr ""
"一台小巧、笨重、看起来很无聊的机器。它的加重梯形框架上有一个独立开关和一个快速拨号盘，顶部有一个橡胶容器。将试管压入容器中，通电后会迅速摇晃并混合试管中的内"
"容物。使用起来出人意料的有趣。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "light detector"
msgid_plural "light detectors"
msgstr[0] "光感測器"

#: data/json/items/tool/science.json
#. ~ Description of "light detector"
msgid ""
"A photodiode on a chip, designed to convert incoming light to electrical "
"energy for quantification."
msgstr "晶片上的光電二極體，旨在將入射光轉換為電能以進行量化。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "glass prism"
msgid_plural "glass prisms"
msgstr[0] "玻璃棱鏡"

#: data/json/items/tool/science.json
#. ~ Description of "glass prism"
msgid "A high-quality crystal glass prism for separating and redirecting light."
msgstr "高品質水晶玻璃棱鏡，用於分離和重定向光線。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "small glass tube"
msgid_plural "small glass tubes"
msgstr[0] "小玻璃管"

#: data/json/items/tool/science.json
#. ~ Description of "small glass tube"
msgid "A small glass tube.  Small, tube-shaped, and made of glass."
msgstr "一個小玻璃管。體積小，管狀，玻璃製成。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "microscope"
msgid_plural "microscopes"
msgstr[0] "顯微鏡"

#: data/json/items/tool/science.json
#. ~ Description of "microscope"
msgid ""
"A classic tool for the ages!  This hefty, durable piece of lab equipment "
"makes small things look bigger.  Without electricity the light doesn't work, "
"but the rest of it is surprisingly functional.  Unfortunately it's not useful "
"for very much at the moment."
msgstr "歷久彌新的經典工具！這種笨重、耐用的實驗室設備讓小東西看起來更大。因缺乏電力，它的燈不亮了，但它的其餘部分卻出乎意料地正常運作。不幸的是，目前它的用處不大。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "dissecting microscope"
msgid_plural "dissecting microscopes"
msgstr[0] "解剖顯微鏡"

#: data/json/items/tool/science.json
#. ~ Description of "dissecting microscope"
msgid ""
"This microscope has less magnification than a standard one.  It's also "
"stereoscopic and produces a neat 3-D image of the surface.  It was typically "
"used for performing dissections and other fine-detail work on small "
"creatures.  It still works pretty well with an added light source, but what "
"would you do with it?"
msgstr ""
"這種顯微鏡的放大倍率比標準顯微鏡低。它也有立體視覺功能，可以產生清晰的表面 3D "
"影像。它通常用於對小生物進行解剖和其他精細工作。在添加光源的情況下它仍然可以很好地工作，但是你會用它做什麼？"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "separation funnel"
msgid_plural "separation funnels"
msgstr[0] "分液漏斗"

#: data/json/items/tool/science.json
#. ~ Description of "separation funnel"
msgid ""
"This thing doesn't look much like a funnel.  It's a teardrop-shaped piece of "
"glass with a stopper at the wide end and a valve at the other.  It can be "
"used to wash one liquid with another, like water and an oil, and then draw "
"off whichever of the two liquids contains a higher amount of whatever "
"compound you're trying to isolate.  With a high level of skill, it can also "
"be used to make juvenile farting noises."
msgstr ""
"這東西看起來不太像漏斗。它是一塊淚珠狀的玻璃，寬端有一個塞子，另一端有一個閥門。它可用來用一種液體淘洗另一種液體（例如水和油），然後排出兩種液體中你要分離的"
"化合物含量較高的液體。如果你的技巧夠好，還可以用來發出幼稚的放屁聲。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "burette"
msgid_plural "burettes"
msgstr[0] "滴定管"

#: data/json/items/tool/science.json
#. ~ Description of "burette"
msgid ""
"A tall glass column with a stopcock at the end.  If you're serious about "
"chemistry, you probably have a tattoo of one of these somewhere."
msgstr "一根長的玻璃柱，末端有一個旋塞。如果你深愛著化學，你身上可能會這種圖案的紋身。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "rotary evaporator"
msgid_plural "rotary evaporators"
msgstr[0] "旋轉蒸發儀"

#: data/json/items/tool/science.json
#. ~ Description of "rotary evaporator"
msgid ""
"Just looking at this thing makes you feel like a proper mad scientist.  It's "
"a series of glass tubes and round flasks, connected to a central motor and a "
"heating element.  The heating element warms one flask, kept rotating by the "
"motor, evaporating the contents.  The vapor is then condensed in the tubes "
"and collected in another flask, in case you wanted to save it for later."
msgstr ""
"只要看看这东西，你就会觉得自己是个真正的疯狂科学家。一系列玻璃管和圆烧瓶连接到一个中央电机和一个加热器上。加热器加热一个烧瓶，电机使它保持转动，令内容物蒸发"
"。然后，蒸汽在试管中冷凝，并收集到另一个烧瓶中，以备以后使用。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "fractional distillation apparatus"
msgid_plural "fractional distillation apparatuses"
msgstr[0] "分餾儀器"

#: data/json/items/tool/science.json
#. ~ Description of "fractional distillation apparatus"
msgid ""
"One of the classic pieces of mad science glassware, this is a small-volume "
"still that passes vapor through a fractional distillation column and then "
"condenses the distillate in a cooled collection column.  A grad student or a "
"robot (is there really any difference?) collects the distillate in fractions "
"so that specific contents can be analyzed.  Going a few milliliters at a "
"time, it would not be very effective to try to distill whiskey in this thing."
msgstr ""
"一件经典的疯狂科学玻璃器皿，基本上是一个小体积的蒸馏器，蒸馏物的蒸汽通过分馏塔，然后在一个冷却的收集塔中冷凝。研究生或机器人（真的有什么区别吗？）将蒸馏液收"
"集起来，以便分析具体的成分。如果你用它来蒸馏威士忌，每次大概只能得到几毫升。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "electrophoresis tray"
msgid_plural "electrophoresis trays"
msgstr[0] "電泳托盤"

#: data/json/items/tool/science.json
#. ~ Description of "electrophoresis tray"
msgid ""
"A set of plastic trays, electrodes, and a power supply designed to create an "
"electric voltage gradient through a liquid solution containing a solid gel.  "
"Stuff like proteins and DNA would then get separated on the gel according to "
"electrical charge and size.  Pretty useless now for anything but salvage."
msgstr ""
"一组塑料托盘、电极和电源，用于通过含有固体凝胶的液体溶液产生电压梯度。然后，像蛋白质和DNA之类的物质会根据电荷和大小在凝胶上分离。\n"
"\"现在这只是可回收垃圾。\""

#: data/json/items/tool/science.json
#. ~ Item name
msgid "microcentrifuge"
msgid_plural "microcentrifuges"
msgstr[0] "微量離心機"

#: data/json/items/tool/science.json
#. ~ Description of "microcentrifuge"
msgid ""
"A smaller, benchtop version of the larger furniture-sized centrifuge.  Don't "
"be fooled by its portable scale; it's still a very powerful piece of "
"equipment that can spin stuff really quickly.  It's not a toy!"
msgstr "一个台式的大型家具大小的离心机的较小版本。别被它的便携式天平欺骗了，它仍然是一个非常强大的设备，可以快速旋转东西。这不是玩具！"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "plastic stopcock"
msgid_plural "plastic stopcocks"
msgstr[0] "塑膠活栓"

#: data/json/items/tool/science.json
#. ~ Description of "plastic stopcock"
msgid "Stop giggling.  This is a tiny plastic valve, get your mind out of the gutter."
msgstr "別偷笑了。這是一個很小的塑膠閥，別想些有的沒的。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "test tube rack"
msgid_plural "test tube racks"
msgstr[0] "試管架"

#: data/json/items/tool/science.json
#. ~ Description of "test tube rack"
msgid ""
"A plastic box with holes in it.  Not that exciting, unless you're desperate "
"for a place to store a test tube.  Then it's great."
msgstr "一個有許多洞的塑膠盒。沒啥用處，除非你急需一個存放試管的地方。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "microcentrifuge tube tray"
msgid_plural "microcentrifuge tube trays"
msgstr[0] "微量離心管托盤"

#: data/json/items/tool/science.json
#. ~ Description of "microcentrifuge tube tray"
msgid "A plastic tray riddled with small holes, for storing microcentrifuge tubes."
msgstr "一個裝有小孔的塑膠托盤，用於存放微量離心管。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "ring stand"
msgid_plural "ring stands"
msgstr[0] "鐵環架"

#: data/json/items/tool/science.json
#. ~ Description of "ring stand"
msgid "A heavy metal plate and a sturdy rod, for clamping lab stuff to."
msgstr "一个由一块重金属板和一根坚固的杆组成用于夹紧实验器具的工具。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "set of ring stand clamps"
msgid_plural "sets of ring stand clamps"
msgstr[0] "鐵環架組"

#: data/json/items/tool/science.json
#. ~ Description of "set of ring stand clamps"
msgid ""
"A small box with a jumbled assortment of clamps for mounting on ring stands.  "
"There seems to be some sort of rule that all of them are missing at least one "
"wing nut for tightening; twist ties, duct tape, and other random stuff has "
"been used to compensate."
msgstr "一个小盒子，里面有各种各样的夹具，可以安装在铁架台上。所有夹具的螺栓都至少缺少了一个用于拧紧的蝶形螺母，使用了扎带、强力胶带和其他物品来代替。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "sextant"
msgid_plural "sextants"
msgstr[0] "六分儀"

#: data/json/items/tool/science.json
#. ~ Description of "sextant"
msgid ""
"A tool for measuring angles of distant objects.  It can be used for measuring "
"the altitude of the sun."
msgstr "一个用于测量远处物体角度的工具。它可以用来测量太阳的高度。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "lux meter"
msgid_plural "lux meters"
msgstr[0] "照度計"

#: data/json/items/tool/science.json
#. ~ Description of "lux meter"
msgid "A tool for measuring illuminance."
msgstr "一个测量照度的工具。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "Mi-go Biotech"
msgid_plural "Mi-go Biotech"
msgstr[0] "米戈生化科技"

#: data/json/items/tool/science.json
#. ~ Description of "Mi-go Biotech"
msgid "A piece of mi-go biotechnology."
msgstr "部分米·戈生化科技。"

#: data/json/items/tool/science.json
#: data/mods/desert_region/weather/weather_eoc.json
#. ~ "description" action message of item "Mi-go Biotech"
#. ~ "description" action message of item "test dust storm causer"
msgid "Touch the opening."
msgstr "接触开口。"

#: data/json/items/tool/science.json
#. ~ Player message in effect in EoC "EOC_MIGO_BIO_TECH_INTEREST_SLIGHT" in
#. use action of item "Mi-go Biotech"
msgid "You have a slight feeling of being watched."
msgstr "你有种轻微的被人监视的感觉。"

#: data/json/items/tool/science.json
#. ~ Player message in effect in EoC "EOC_MIGO_BIO_TECH_INTEREST_INTENSE" in
#. use action of item "Mi-go Biotech"
msgid "You have an intense feeling of being watched."
msgstr "你有种强烈的被人监视的感觉。"

#: data/json/items/tool/science.json
#. ~ Player message in effect in EoC "EOC_MIGO_BIO_TECH_MORALE" in use action
#. of item "Mi-go Biotech"
msgid "You feel amazing!"
msgstr "你感觉棒极了！"

#: data/json/items/tool/science.json
#. ~ Player message in effect in EoC "EOC_MIGO_BIO_TECH_FOCUS" in use action
#. of item "Mi-go Biotech"
msgid "You feel incredibly focused!"
msgstr "你感到无比专注！"

#: data/json/items/tool/science.json
#. ~ Player message in effect in EoC "EOC_MIGO_BIO_TECH_PAIN" in use action of
#. item "Mi-go Biotech"
msgid "You feel your aches and pains fade away!"
msgstr "你感觉你的疼痛消失了！"

#: data/json/items/tool/science.json
#. ~ Player message in effect in EoC "EOC_MIGO_BIO_TECH_SLEEPINESS" in use
#. action of item "Mi-go Biotech"
msgid "You instantly feel more awake!"
msgstr "你立刻感觉自己更清醒了！"

#: data/json/items/tool/science.json
#. ~ Conditional name for "Mi-go Biotech" when VAR matches mbt_f_function
#, c-format
msgid "%s (happy)"
msgid_plural "%s (happy)"
msgstr[0] "%s（快樂）"

#: data/json/items/tool/science.json
#. ~ Conditional name for "Mi-go Biotech" when VAR matches mbt_f_function
#, c-format
msgid "%s (focus)"
msgid_plural "%s (focus)"
msgstr[0] "%s（專注）"

#: data/json/items/tool/science.json
#. ~ Conditional name for "Mi-go Biotech" when VAR matches mbt_f_function
#, c-format
msgid "%s (pain relief)"
msgid_plural "%s (pain relief)"
msgstr[0] "%s（止痛）"

#: data/json/items/tool/science.json
#. ~ Conditional name for "Mi-go Biotech" when VAR matches mbt_f_function
#, c-format
msgid "%s (wake up)"
msgid_plural "%s (wake up)"
msgstr[0] "%s（喚醒）"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "weather glass"
msgid_plural "weather glass"
msgstr[0] "晴雨表"

#: data/json/items/tool/science.json
#. ~ Description of "weather glass"
msgid ""
"Also called storm glass or 'Goethe barometer', The weather glass barometer "
"consists of a glass container with a sealed body, half filled with water.  A "
"narrow spout connects to the body below the water level and rises above the "
"water level.  The difference between the sealed water level in the body and "
"the narrow open spout determines the atmospheric pressure.  Activate to get "
"current atmospheric pressure."
msgstr ""
"天气玻璃气压计，又称作风暴玻璃或歌德气压计，由一个装有一半水的密封玻璃容器组成。一个狭窄的喷嘴连接到容器下方的水线以下，并在水面之上延伸。容器内密封的水位与"
"喷嘴中开放的水位之间的差异决定了大气压力。激活它以查看当前的大气压力。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "hygroscope"
msgid_plural "hygroscopes"
msgstr[0] "湿度计"

#: data/json/items/tool/science.json
#. ~ Description of "hygroscope"
msgid ""
"A small rectangular box.  Inside is a device that measures humidity by "
"utilizing the hygroscopy of hair.  The hair's length changes with humidity as "
"indicated on a dial."
msgstr "一个小方盒子。盒子内部有一个装置，它通过利用头发的吸湿性来测量湿度。头发的长度会随着湿度的变化而在刻度盘上显示出来。"

#: data/json/items/tool/science.json
#. ~ Item name
msgid "glass thermometer"
msgid_plural "glass thermometers"
msgstr[0] "玻璃温度计"

#: data/json/items/tool/science.json
#. ~ Description of "glass thermometer"
msgid ""
"A device used to measure temperature.  This one is made entirely of glass.  "
"Mercury is used as its temperature sensor.  You could use this to get "
"accurate information on current air temperature."
msgstr "一个用于测量温度的设备，完全由玻璃制成，使用水银作为其温度传感器。 你可以使用它来获取有关当前气温的准确信息。"

#: data/json/items/tool/shelters.json
#. ~ Item name
msgid "damaged shelter kit"
msgid_plural "damaged shelter kits"
msgstr[0] "受損的帳篷"

#: data/json/items/tool/shelters.json
#. ~ Description of "damaged shelter kit"
msgid ""
"A disassembled small shelter made of sticks and skins.  It's been damaged and "
"needs to be repaired before you can set it up."
msgstr "用树枝和兽皮做成的可拆卸的小棚子。它被损坏了，需要修理一下才能安装。"

#: data/json/items/tool/shelters.json
#. ~ Item name
msgid "large damaged shelter"
msgid_plural "large damaged shelters"
msgstr[0] "大棚屋（损坏）"

#: data/json/items/tool/shelters.json
#. ~ Description of "large damaged shelter"
msgid ""
"A huge shelter made of sticks and skins, very bulky but with plenty of space. "
" This is broken and cannot be deployed."
msgstr "一顶用木棍和毛皮做成的棚屋，很大，空间充裕。可惜它的龙骨已经断裂，不能再次撑开使用。"

#: data/json/items/tool/shelters.json
#. ~ Item name
msgid "large tent"
msgid_plural "large tents"
msgstr[0] "大型帳篷"

#: data/json/items/tool/shelters.json
#. ~ Description of "large tent"
msgid ""
"A family sized tent in a storage bag.  It provides a large amount of space, "
"but is very bulky."
msgstr "一顶装在储存袋里的供全家出行使用的帐篷，可以提供大量的空间，但十分笨重。"

#: data/json/items/tool/shelters.json
#. ~ Item name
msgid "shelter kit"
msgid_plural "shelter kits"
msgstr[0] "帳篷"

#: data/json/items/tool/shelters.json
#. ~ Description of "shelter kit"
msgid ""
"A disassembled small shelter made of sticks and skins.  Activate it to set it "
"up."
msgstr "一顶用木棍和皮革做成的破旧的小棚屋。使用它可以把它架设在地面上。"

#: data/json/items/tool/shelters.json
#. ~ Item name
msgid "large shelter kit"
msgid_plural "large shelter kits"
msgstr[0] "大棚屋"

#: data/json/items/tool/shelters.json
#. ~ Description of "large shelter kit"
msgid ""
"A large disassembled shelter made of sticks and skins.  Activate it to set it "
"up."
msgstr "一顶用木棍和皮革做成的破旧的大棚屋。使用它可以把它架设在地面上。"

#: data/json/items/tool/shelters.json data/json/overmap/vision_levels.json
#. ~ Item name
#. ~ Overmap terrain vision level name
msgid "tent"
msgid_plural "tents"
msgstr[0] "帳篷"

#: data/json/items/tool/shelters.json
#. ~ Description of "tent"
msgid ""
"A small personal tent in a storage bag.  It's just big enough to fit one "
"person comfortably."
msgstr "一顶装在储物袋里的一个小的个人帐篷。它刚好大到可以让一个人舒服地躺在里面。"

#: data/json/items/tool/shelters.json
#. ~ Item name
msgid "aluminum tent pole"
msgid_plural "aluminum tent poles"
msgstr[0] "鋁帳篷支架"

#: data/json/items/tool/shelters.json
#. ~ Description of "aluminum tent pole"
msgid ""
"A light, collapsible tent pole made from aluminum, perfect for pitching a "
"tent."
msgstr "一根由铝制成的轻型可折叠帐篷支架，非常适合用来搭建帐篷。"

#: data/json/items/tool/smoking.json
#. ~ Item name
msgid "advanced electronic cigarette"
msgid_plural "advanced electronic cigarettes"
msgstr[0] "高階版電子菸"

#: data/json/items/tool/smoking.json
#. ~ Description of "advanced electronic cigarette"
msgid ""
"An advanced, rechargeable electronic cigarette.  A less harmful way to get "
"your nicotine fix than regular cigarettes, but still addictive.  It needs "
"batteries and nicotine liquid to function."
msgstr "电子香烟的高级可充版本。和普通香烟比起来摄取尼古丁的方式要柔和得多，不过照样会让你上瘾。需要电池和尼古丁浓缩液来运作。"

#: data/json/items/tool/smoking.json
#. ~ Item name
msgid "crack pipe"
msgid_plural "crack pipes"
msgstr[0] "快克吸食器"

#: data/json/items/tool/smoking.json
#. ~ Description of "crack pipe"
msgid ""
"A fine glass tube with a bulb with a bowl on one end.  It's used to partake "
"of certain illicit substances."
msgstr "一根细玻璃管，底部可以点火。用来享用某些，你懂的，非法的违禁物质。"

#: data/json/items/tool/smoking.json
#. ~ Item name
msgid "glass pipe"
msgid_plural "glass pipes"
msgstr[0] "玻璃管"

#: data/json/items/tool/smoking.json
#. ~ Description of "glass pipe"
msgid "A hand-blown glass pipe.  It's commonly used to smoke recreational substances."
msgstr "一根手工吹制而成的玻璃管，经常被用来吸食迷幻类植物制品。"

#: data/json/items/tool/smoking.json
#. ~ Item name
msgid "water pipe"
msgid_plural "water pipes"
msgstr[0] "水烟斗"

#: data/json/items/tool/smoking.json
#. ~ Description of "water pipe"
msgid ""
"A mass-manufactured water pipe, otherwise known as a 'bong'.  Head shops "
"often insist these are used solely for tobacco, despite their iconic status "
"as cannabis paraphernalia."
msgstr "一种批量生产的水烟壶，俗称“水烟斗”。烟具店经常强调这些东西只能用来抽烟草，尽管它早已成为抽大麻的标志性工具。"

#: data/json/items/tool/smoking.json
#. ~ Variant name of item "water pipe"
msgid "bong"
msgid_plural "bongs"
msgstr[0] "水烟壶"

#: data/json/items/tool/smoking.json
#. ~ Description of variant "bong" of item "water pipe"
msgid ""
"A mass-manufactured water pipe, otherwise known as a 'bong'.  This one is "
"made of plain, clear, glass."
msgstr "一种批量生产的水烟壶，俗称“水烟斗”。这个是由普通、透明的玻璃制成的。"

#: data/json/items/tool/smoking.json
#. ~ Variant name of item "water pipe"
msgid "cartoon bong"
msgid_plural "cartoon bongs"
msgstr[0] "卡通水烟枪"

#: data/json/items/tool/smoking.json
#. ~ Description of variant "cartoon bong" of item "water pipe"
msgid ""
"A mass-manufactured water pipe, otherwise known as a 'bong'.  It is covered "
"in copyrighted cartoon characters, all smoking marijuana."
msgstr "一种批量生产的水烟壶，俗称“水烟斗”。上面印满了受版权保护的卡通角色，全都在抽大麻。"

#: data/json/items/tool/smoking.json
#. ~ Variant name of item "water pipe"
msgid "rasta bong"
msgid_plural "rasta bongs"
msgstr[0] "拉斯塔水烟枪"

#: data/json/items/tool/smoking.json
#. ~ Description of variant "rasta bong" of item "water pipe"
msgid ""
"A mass-manufactured water pipe, otherwise known as a 'bong'.  It is colored "
"with the 'rasta' pattern of red, yellow, and green."
msgstr "一种批量生产的水烟壶，俗称“水烟斗”。上面印有红、黄和绿色组成的拉斯塔图案。"

#: data/json/items/tool/smoking.json
#. ~ Variant name of item "water pipe"
msgid "handblown bong"
msgid_plural "handblown bongs"
msgstr[0] "手工吹制水烟枪"

#: data/json/items/tool/smoking.json
#. ~ Description of variant "handblown bong" of item "water pipe"
msgid ""
"A handblown water pipe, also known as a 'bong'.  Lovingly crafted by an "
"artisan, a true fusion of aesthetic sensibilities and stoner functionalities."
msgstr "一款手工吹制的水烟枪，也被称为“水烟斗”。由工匠精心打造，真正融合了审美的情趣和“过瘾”的功能。"

#: data/json/items/tool/smoking.json
#. ~ Variant name of item "water pipe"
msgid "psychedelic bong"
msgid_plural "psychedelic bongs"
msgstr[0] "迷幻水烟枪"

#: data/json/items/tool/smoking.json
#. ~ Description of variant "psychedelic bong" of item "water pipe"
msgid ""
"A mass-manufactured water pipe, also known as a 'bong'.  It is covered in "
"stickers depicting 'psychedelic' art."
msgstr "一种大规模生产的水烟枪，也称为“水烟斗”。它被描绘“迷幻”艺术的贴纸所覆盖。"

#: data/json/items/tool/smoking.json
#. ~ Variant name of item "water pipe"
msgid "frosted bong"
msgid_plural "frosted bongs"
msgstr[0] "磨砂水烟枪"

#: data/json/items/tool/smoking.json
#. ~ Description of variant "frosted bong" of item "water pipe"
msgid ""
"A mass-manufactured water pipe, also known as a 'bong'.  It is made out of "
"frosted glass."
msgstr "一种批量生产的水烟壶，俗称“水烟斗”。这个是由磨砂玻璃制成的。"

#: data/json/items/tool/smoking.json
#. ~ Variant name of item "water pipe"
msgid "gold bong"
msgid_plural "gold bongs"
msgstr[0] "金水烟壶"

#: data/json/items/tool/smoking.json
#. ~ Description of variant "gold bong" of item "water pipe"
msgid ""
"A mass-manufactured water pipe, also known as a 'bong'.  Though it looks like "
"it's made out of gold it is, in fact, just metallic paint."
msgstr "一种批量生产的水烟壶，俗称“水烟斗”。虽然看上去像是黄金打造的，但实际上只是涂了层金属漆。"

#: data/json/items/tool/smoking.json
#. ~ Item name
msgid "tobacco pipe"
msgid_plural "tobacco pipes"
msgstr[0] "煙斗"

#: data/json/items/tool/smoking.json
#. ~ Description of "tobacco pipe"
msgid ""
"A hand-carved wooden smoking pipe.  It's designed to facilitate the "
"consumption of fire-cured tobacco leaves."
msgstr "一根手工雕刻而成的烟斗，可以用来吸食烟叶。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "stapler"
msgid_plural "staplers"
msgstr[0] "釘書機"

#: data/json/items/tool/stationery.json
#. ~ Description of "stapler"
msgid "A desk tool for fastening sheets of paper together."
msgstr "一种将纸张固定在一起的桌面用具。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "hole puncher"
msgid_plural "hole punchers"
msgstr[0] "打孔器"

#: data/json/items/tool/stationery.json
#. ~ Description of "hole puncher"
msgid ""
"A metal tool that can punch a single hole in a piece of paper.  I mean, you "
"could do more if you wanted, but you'd have to do them one at a time.  Or, if "
"you really wanted more holes with one punch, I suppose you could fold the "
"paper….  This is a one-cylinder hole puncher."
msgstr ""
"这个金属工具可以帮你在纸上打一个孔。多打几个也行，只要你肯一个一个来。或者，如果你真的非常想用它一次打好几个孔，也许可以把先纸折起来……总之它是一个单筒打孔"
"器。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "letter opener"
msgid_plural "letter openers"
msgstr[0] "開信刀"

#: data/json/items/tool/stationery.json
#. ~ Description of "letter opener"
msgid ""
"A sterling silver letter opener resembling a small dagger, with a sharp point "
"and no cutting edge.  It's used to open mail envelopes neatly and quickly."
msgstr "一把像小匕首的纯银开信刀，有锋利的刀尖，但没有开刃。它能干净利落地拆开信封。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "pair of office scissors"
msgid_plural "pairs of office scissors"
msgstr[0] "事務用剪刀"

#: data/json/items/tool/stationery.json
#. ~ Description of "pair of office scissors"
msgid ""
"A long pair of heavy-duty scissors.  You can use them to cut things such as "
"fabric or plastic apart."
msgstr "一把耐用的長剪刀。你可以用它來剪切布料或塑膠之類的東西。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "pair of kiddie scissors"
msgid_plural "pairs of kiddie scissors"
msgstr[0] "兒童剪刀"

#: data/json/items/tool/stationery.json
#. ~ Description of "pair of kiddie scissors"
msgid ""
"A pair of short scissors designed with kids in mind.  You can use them to cut "
"things such as fabric or plastic apart, although they are probably subpar "
"compared to other alternatives."
msgstr "一把專為兒童設計的短剪刀。你可以用它來剪切布料或塑膠之類的東西，儘管它比其他替代品功能要差一點。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "pair of wavy scissors"
msgid_plural "pairs of wavy scissors"
msgstr[0] "花邊剪刀"

#: data/json/items/tool/stationery.json
#. ~ Description of "pair of wavy scissors"
msgid ""
"A pair of wavy artistic scissors.  You can theoretically use them to cut "
"things but you should probably not get your hopes too high."
msgstr "一把波浪形的創作用剪刀。理論上你可以用它來剪切東西，但也許你不應該對它期望太高。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "pen"
msgid_plural "pens"
msgstr[0] "筆"

#: data/json/items/tool/stationery.json
#. ~ Description of "pen"
msgid "A fine metal pen, of much better quality than a disposable model."
msgstr "一支很好的圆珠笔，质量比普通的一次性圆珠笔要好得多。"

#: data/json/items/tool/stationery.json
#. ~ Description of "pencil"
msgid "A sharpened HB Number 2 graphite pencil, equipped with an eraser."
msgstr "一支削尖的HB#2石墨铅笔，尾部配有橡皮擦。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "black pen"
msgid_plural "black pens"
msgstr[0] "黑色筆"

#: data/json/items/tool/stationery.json
#. ~ Description of "black pen"
msgid ""
"A disposable ballpoint pen, offers a smooth writing experience on paper.  Has "
"the same logo as those disposable lighters.  This one is black."
msgstr "一支一次性圆珠笔，提供流畅的书写体验。有着和那些一次性打火机相同的商标。这支笔是黑色的。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "blue pen"
msgid_plural "blue pens"
msgstr[0] "藍色筆"

#: data/json/items/tool/stationery.json
#. ~ Description of "blue pen"
msgid ""
"A disposable ballpoint pen, offers a smooth writing experience on paper.  Has "
"the same logo as those disposable lighters.  This one is blue."
msgstr "一支一次性圆珠笔，提供流畅的书写体验。有着和那些一次性打火机相同的商标。这支笔是蓝色的。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "red pen"
msgid_plural "red pens"
msgstr[0] "紅色筆"

#: data/json/items/tool/stationery.json
#. ~ Description of "red pen"
msgid ""
"A disposable ballpoint pen, offers a smooth writing experience on paper.  Has "
"the same logo as those disposable lighters.  This one is red."
msgstr "一支一次性圆珠笔，提供流畅的书写体验。有着和那些一次性打火机相同的商标。这支笔是红色的。"

#: data/json/items/tool/stationery.json
#. ~ Item name
msgid "green pen"
msgid_plural "green pens"
msgstr[0] "綠色筆"

#: data/json/items/tool/stationery.json
#. ~ Description of "green pen"
msgid ""
"A disposable ballpoint pen, offers a smooth writing experience on paper.  Has "
"the same logo as those disposable lighters.  This one is green."
msgstr "一支一次性圆珠笔，提供流畅的书写体验。有着和那些一次性打火机相同的商标。这支笔是绿色的。"

#: data/json/items/tool/stationery.json data/mods/innawood/items/misc.json
#. ~ Item name
msgid "leather journal"
msgid_plural "leather journals"
msgstr[0] "皮製日記本"

#: data/json/items/tool/stationery.json
#. ~ Description of "leather journal"
msgid ""
"A leather-back journal for preserving notes and maps, has a strap to keep "
"loose pages contained."
msgstr "一本用来保存各类笔记和地图的皮革日记本，有一条带子固定松散的书页。"

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "bone billet"
msgid_plural "bone billets"
msgstr[0] "骨擊棒"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "bone billet"
msgid "A thick, short bone, usually used in flintknapping for soft-hammer percussion."
msgstr "一根粗短的骨头，通常用于当作软锤敲击燧石。"

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "wooden billet"
msgid_plural "wooden billets"
msgstr[0] "木擊棒"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "wooden billet"
msgid ""
"A thick, short wooden stick, usually used in flintknapping for soft-hammer "
"percussion."
msgstr "一根粗短的木棍，通常用于当作软锤敲击燧石。"

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "primitive rock drill"
msgid_plural "primitive rock drills"
msgstr[0] "原始石鑽"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "primitive rock drill"
msgid ""
"A thick, blunted wooden stick.  Can be used to drill rough holes in rock, if "
"water and sand are available, but the process is lengthy."
msgstr "一根粗钝的木棍。如果有水和沙子，可以用来在石器上钻出粗糙的孔，但耗时很长。"

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "bone punch"
msgid_plural "bone punches"
msgstr[0] "骨製中心鑽"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "bone punch"
msgid ""
"A thick, short bone with a small, pointy tip, usually used in flintknapping "
"for indirect percussion and pressure flaking."
msgstr "一根带有尖端的粗短骨头，通常用于加工燧石时桯钻打孔。"

#: data/json/items/tool/stoneworking.json
#. ~ Item name
msgid "nail punch"
msgid_plural "nail punches"
msgstr[0] "鐵釘中心鑽"

#: data/json/items/tool/stoneworking.json
#. ~ Description of "nail punch"
msgid ""
"Two pieces of wood with a steel nail secured between them with some cordage.  "
"Usually used in flintknapping for indirect percussion and pressure flaking."
msgstr "一根铁钉被牢牢绑住夹在两根木板之间，通常用于加工燧石时桯钻打孔。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "bone sewing awl"
msgid_plural "bone sewing awls"
msgstr[0] "骨製縫錐"

#: data/json/items/tool/tailoring.json
#. ~ Description of "bone sewing awl"
msgid ""
"A crude, sharpened bone awl, used for leatherworking before metal was "
"discovered.  It can also serve as an improvised stabbing weapon, but will "
"break quickly."
msgstr "一个经过粗糙打磨成型的骨锥；早在人类发现金属之前就被用于制造皮革物品了。它也能够当作一把简易的刺击武器，但会很快损坏。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "steel sewing awl"
msgid_plural "steel sewing awls"
msgstr[0] "鋼製縫錐"

#: data/json/items/tool/tailoring.json
#. ~ Description of "steel sewing awl"
msgid ""
"A steel awl with a wooden grip, usually used for leatherworking.  It can also "
"serve as an improvised stabbing weapon, but will break quickly."
msgstr "一个带着木头手柄的钢锥，能够用于制造皮革物品。它也能够当作一把简易的刺击武器，但会很快损坏。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "pair of knitting needles"
msgid_plural "pairs of knitting needles"
msgstr[0] "棒针"

#: data/json/items/tool/tailoring.json
#. ~ Description of "pair of knitting needles"
msgid ""
"A pair of stout wooden needles with round ends, used to turn thread and yarn "
"into cloth."
msgstr "一组结实的圆头木针，用来将线织成布。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "frame loom"
msgid_plural "frame looms"
msgstr[0] "框架織機"

#: data/json/items/tool/tailoring.json
#. ~ Description of "frame loom"
msgid ""
"A rather bulky and primitive wooden frame which can be used to weave cloth "
"sheets.  The process is very slow, though."
msgstr "一个巨大且原始的织布用的木架，织布效率极低。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "bone needle"
msgid_plural "bone needles"
msgstr[0] "骨針"

#: data/json/items/tool/tailoring.json
#. ~ Description of "bone needle"
msgid ""
"A sharp needle made from a bone.  Useful for making rough clothing and items. "
" Its low quality makes it rather unsuitable for anything requiring speed or "
"precision."
msgstr "一根由骨头制成的锐利针头。可用来制造粗糙的简易服装和物品。它低劣的品质使它不适合用来制造任何需要精度或速度的物品。"

#: data/json/items/tool/tailoring.json
#. ~ Description of "curved needle"
msgid ""
"A curved, sharp needle made of steel.  Its rounded shape allows it to make "
"stitches that only pierce one side of the material.  While unsuitable for "
"most tailoring projects, it's a necessity for stitching neoprene."
msgstr "一种钢制的弯曲的尖针。它的圆形的形状可以使它只穿透的材料的一侧。虽然不适合大多数的裁缝工作，但这是拼接氯丁橡胶的必需品。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "wooden needle"
msgid_plural "wooden needles"
msgstr[0] "木針"

#: data/json/items/tool/tailoring.json
#. ~ Description of "wooden needle"
msgid ""
"A wooden needle whittled down to a sharp point.  It has a narrow hole carved "
"into the head for threading.  Its low quality makes it rather unsuitable for "
"anything requiring speed or precision, or involving tougher materials like "
"Kevlar."
msgstr "一根削尖的木针，上面有个刻出来的穿线孔。它低劣的品质使它不适合用来制造任何需要精度或速度的物品，或者用于类似于凯夫拉的坚硬材质上。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "needle"
msgid_plural "needles"
msgstr[0] "针"

#: data/json/items/tool/tailoring.json
#. ~ Description of "needle"
msgid "A stainless steel needle.  It would be useful for making clothing and items."
msgstr "一根不锈钢针，可以用来缝制衣物或其它物品。"

#: data/json/items/tool/tailoring.json data/mods/Magiclysm/items/tools.json
#: data/mods/innawood/items/tool_tailoring.json
#. ~ Item name
msgid "sewing kit"
msgid_plural "sewing kits"
msgstr[0] "針線包"

#: data/json/items/tool/tailoring.json
#. ~ Description of "sewing kit"
msgid ""
"A plastic kit with a variety of needles, some plastic spools for thread, "
"small scissors, and a few other useful textile tools.  Use a sewing kit on an "
"article of clothing to attempt to repair or refit if applicable.  This uses "
"your tailoring skill."
msgstr "一組塑膠套件裡裝著各種針、一些塑膠線軸、小剪刀和一些其他有用的縫紉工具。使用它來嘗試修理或強化衣物，結果取決於你的裁縫技能。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "wooden shed stick"
msgid_plural "wooden shed sticks"
msgstr[0] "木製隔棒"

#: data/json/items/tool/tailoring.json
#. ~ Description of "wooden shed stick"
msgid ""
"A short, thin, flat wooden stick, used as a tool while weaving cloth with a "
"frame loom."
msgstr "一根细短的扁平木棍，和织布架一起用于织布。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "tanning leather hide"
msgid_plural "tanning leather hides"
msgstr[0] "鞣製過的獸皮"

#: data/json/items/tool/tailoring.json
#. ~ Description of "tanning leather hide"
msgid ""
"A treated animal hide that is undergoing the chemical processes required to "
"become leather.  You will be able to activate it to unroll and make use of it "
"when it is done."
msgstr "一张经过处理的动物皮，正在进行必要的化学变化以变成皮革。当它鞣制完成后你就可以激活它以展开并使用它。"

#: data/json/items/tool/tailoring.json
#. ~ "msg" action message of item "tanning leather hide"
msgid "You carefully unfold the tanning leather hide and shake it clean."
msgstr "你小心翼翼的的把鞣製過的獸皮攤開, 並把它上面殘留的液體甩乾淨。"

#: data/json/items/tool/tailoring.json
#. ~ "not_ready_msg" action message of item "tanning leather hide"
msgid "The tanning leather hide isn't done yet."
msgstr "獸皮尚未鞣製。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "tanning fur pelt"
msgid_plural "tanning fur pelts"
msgstr[0] "鞣製過的皮草"

#: data/json/items/tool/tailoring.json
#. ~ Description of "tanning fur pelt"
msgid ""
"A treated animal pelt that is undergoing the chemical processes required to "
"become fur.  You will be able to activate it to unroll and make use of it "
"when it is done."
msgstr "一张经过处理的动物毛皮，正在进行必要的化学变化以变成毛皮。当它鞣制完成后你就可以激活它以展开并使用它。"

#: data/json/items/tool/tailoring.json
#. ~ "msg" action message of item "tanning fur pelt"
msgid "You carefully unfold the tanning fur pelt and shake it clean."
msgstr "你小心翼翼的的把鞣製過的皮草攤開, 並把它上面殘留的液體甩乾淨。"

#: data/json/items/tool/tailoring.json
#. ~ "not_ready_msg" action message of item "tanning fur pelt"
msgid "The tanning fur pelt isn't done yet."
msgstr "皮草尚未鞣製。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "tailoring pattern set"
msgid_plural "tailoring pattern sets"
msgstr[0] "裁縫樣板"

#: data/json/items/tool/tailoring.json
#. ~ Description of "tailoring pattern set"
msgid ""
"A large set of tailoring patterns made from paper.  They're useful for making "
"any kind of cloth or leather items from scratch, but are necessary for more "
"advanced projects."
msgstr "一大套纸制的缝纫用模板，可以用来从头制造布料或者皮革衣物，在更复杂的裁缝工作中更是必不可少。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "pair of Kevlar shears"
msgid_plural "pairs of Kevlar shears"
msgstr[0] "克維拉剪"

#: data/json/items/tool/tailoring.json
#. ~ Description of "pair of Kevlar shears"
msgid ""
"A pair of heavy-duty shears suitable for cutting particularly tough "
"materials, from polyaramid fabrics to tough plastics and thin metals.  The "
"blades feature flat shearing edges and fine serrations."
msgstr "一对坚固耐用的剪刀，能切开特别坚韧的材料，从聚胺纤维到硬塑料和薄金属板。刀片既具有平坦的剪切边缘也有细密的锯齿。"

#: data/json/items/tool/tailoring.json
#. ~ Item name
msgid "electric spinwheel"
msgid_plural "electric spinwheels"
msgstr[0] "電動紡車"

#: data/json/items/tool/tailoring.json
#. ~ Description of "electric spinwheel"
msgid ""
"A device for spinning thread or yarn from fibers.  This particular model is "
"electrically-powered and easily portable."
msgstr "用于将纤维纺织成纱线的装置。这种特殊型号是电动的，便于携带。"

#: data/json/items/tool/tailoring.json data/mods/Magiclysm/items/tools.json
#: data/mods/Xedra_Evolved/items/tools.json
#: data/mods/innawood/items/tool_tailoring.json
#. ~ Item name
msgid "tailor's kit"
msgid_plural "tailor's kits"
msgstr[0] "裁縫工具"

#: data/json/items/tool/tailoring.json
#. ~ Description of "tailor's kit"
msgid ""
"A high-quality kit consisting of a variety of needles, some plastic spools "
"for thread, scissors and shears, and an awl.  Use a tailor's kit on an "
"article of clothing to attempt to repair or refit if applicable.  This uses "
"your tailoring skill."
msgstr "一組高品質套件，包括各種針、一些塑膠線軸、各種剪刀以及縫錐。使用它來嘗試修理或強化衣物，結果取決於你的裁縫技能。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "bathroom scale"
msgid_plural "bathroom scales"
msgstr[0] "浴室秤"

#: data/json/items/tool/toiletries.json
#. ~ Description of "bathroom scale"
msgid "A small bathroom scale, meant to weigh a person while naked."
msgstr "一个小型的浴室秤，用来称一个人裸体时的体重。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "scrub brush"
msgid_plural "scrub brushes"
msgstr[0] "硬毛刷"

#: data/json/items/tool/toiletries.json
#. ~ Description of "scrub brush"
msgid "A simple scrub brush for cleaning hard objects."
msgstr "一种简单的刷子，用于清洁坚硬的物体。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "dish towel"
msgid_plural "dish towels"
msgstr[0] "抹布"

#: data/json/items/tool/toiletries.json
#. ~ Description of "dish towel"
msgid "A dish towel, useful for cleaning hard surfaces."
msgstr "一条擦碗布，用于清洁坚硬的表面。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "An elegant, monogrammed dish towel.  Unfortunately, they aren't your initials."
msgstr "一种优雅的带有花押的擦碗布。不幸的是，上面不是你的姓名缩写。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "An elegant, monogrammed dish towel.  It even has your initials!"
msgstr "一种优雅的带有花押的擦碗布。上面甚至有你的姓名缩写！"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A well-used dish towel, judging by the stains."
msgstr "从污渍来看，一条用得很透的擦碗布。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A novelty dish towel featuring a popular children's cartoon character."
msgstr "一条新颖的擦碗布，上面画着一个受欢迎的儿童卡通人物。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A novelty dish towel which reads \"IT'S WINE O CLOCK\"."
msgstr "一条新颖的擦碗布，上面写着\"现在是酒点钟\"。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A dish towel with a floral pattern."
msgstr "一条鲜花图案的擦碗布。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A dish towel with a gingham pattern."
msgstr "一条格子图案的擦碗布。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A dish towel with a cat pattern."
msgstr "一条猫咪图案的擦碗布。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "electric hair trimmer"
msgid_plural "electric hair trimmers"
msgstr[0] "電動理髮器"

#: data/json/items/tool/toiletries.json
#. ~ Description of "electric hair trimmer"
msgid ""
"A pocket-sized electric trimmer made for cutting hair.  You can use it to cut "
"your hair if it's supplied with batteries.  It requires 1 unit of charge per "
"use."
msgstr "一个小巧的电动理发剪。如果你有电池，你可以用它剪头发。每次使用需要1单位的电量。"

#: data/json/items/tool/toiletries.json
#. ~ "description" action message of item "electric hair trimmer"
#. ~ "description" action message of item "makeshift haircut kit"
msgid "Trim your hair"
msgstr "理发"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "mop"
msgid_plural "mops"
msgstr[0] "拖把"

#: data/json/items/tool/toiletries.json
#. ~ Description of "mop"
msgid ""
"An unwieldy mop.  Good for cleaning up spills.  Use to mop up any 'mess' you "
"may have made."
msgstr "笨重的拖把，清理泄漏的液体很不错。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "collapsible mop"
msgid_plural "collapsible mops"
msgstr[0] "拖把（可摺疊）"

#: data/json/items/tool/toiletries.json
#. ~ Description of "collapsible mop"
msgid ""
"A long, unwieldy mop with a collapsible handle for convenient transportation. "
" You may use it to clean up any 'mess' you have made."
msgstr "笨重的拖把，手柄可折叠，便于携带。清理泄露的液体很不错。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "cotton patch"
msgid_plural "cotton patches"
msgstr[0] "棉布補丁"

#: data/json/items/tool/toiletries.json
#. ~ Description of "cotton patch"
msgid "A 6-inch square cotton patch, suitable for repairing and tailoring clothing."
msgstr "一块约6英寸（约15厘米）见方的棉布片，可以用来修补或缝制衣物。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "razor blade"
msgid_plural "razor blades"
msgstr[0] "剃鬚刀片"

#: data/json/items/tool/toiletries.json
#. ~ Description of "razor blade"
msgid "A double-edged razor blade."
msgstr "一副雙刃剃鬚刀片。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "shaving kit"
msgid_plural "shaving kits"
msgstr[0] "剃鬚工具"

#: data/json/items/tool/toiletries.json
#. ~ Description of "shaving kit"
msgid ""
"A compact, lightweight shaving kit made for travelers.  You can use it to "
"shave if it's supplied with soap.  It requires 1 unit of soap per use."
msgstr "一个为旅行者准备的紧凑、轻便的刮胡刀工具包。如果你有肥皂，你可以用它刮胡子。每次使用需要1单位的肥皂"

#: data/json/items/tool/toiletries.json
#. ~ "description" action message of item "shaving kit"
#. ~ "description" action message of item "makeshift shaving kit"
msgid "Trim your beard"
msgstr "刮胡子"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "sponge"
msgid_plural "sponges"
msgstr[0] "海綿"

#: data/json/items/tool/toiletries.json
#. ~ Description of "sponge"
msgid ""
"A cleaning aid made of soft, porous material.  Typically used for cleaning "
"hard objects."
msgstr "一块质地柔软多孔的清洁海绵，通常用来清洗硬质物品。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A round smiley-face sponge."
msgstr "一块圆形笑脸海绵。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A rectangular sponge with a green abrasive back."
msgstr "正正方方的海綿，綠色的背面很粗糙。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A dolphin-shaped sponge.  It looks at home in the water."
msgstr "一块海豚形状的海绵。它在水里就像回到家一样。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A rectangular sponge."
msgstr "正正方方的海綿。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A sponge cake-shaped sponge, the abrasive pad looks like frosting."
msgstr "一块蛋糕形海绵，看起来像结了霜一样。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A sponge in the shape of a beloved character from a children's cartoon."
msgstr "一块饱受大家喜爱的卡通人物形状的海绵。"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A cat-shaped sponge."
msgstr "一块猫形海绵。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "makeshift haircut kit"
msgid_plural "makeshift haircut kits"
msgstr[0] "粗製理髮工具"

#: data/json/items/tool/toiletries.json
#. ~ Description of "makeshift haircut kit"
msgid "A kit containing various improvised tools for cutting hair."
msgstr "一个理发套装，包括各种自制的理发工具。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "makeshift shaving kit"
msgid_plural "makeshift shaving kits"
msgstr[0] "粗製剃鬚工具"

#: data/json/items/tool/toiletries.json
#. ~ Description of "makeshift shaving kit"
msgid ""
"A makeshift shaving kit.  You can use it to shave if it's supplied with soap. "
" It requires 1 unit of soap per use."
msgstr "一把简易剃须刀。如果你有肥皂，你可以用它刮胡子。每次使用需要1单位的肥皂。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "washboard"
msgid_plural "washboards"
msgstr[0] "洗衣板"

#: data/json/items/tool/toiletries.json
#. ~ Description of "washboard"
msgid ""
"A wooden washboard.  You can use it to wash filthy clothing if it's supplied "
"with cleansing agent."
msgstr "一块木制的洗衣板。如果你有肥皂，你可以用它洗脏衣服。每次使用需要消耗清洗剂。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "washing kit"
msgid_plural "washing kits"
msgstr[0] "洗滌工具"

#: data/json/items/tool/toiletries.json
#. ~ Description of "washing kit"
msgid ""
"A combination of a washboard and a scrubbing tool.  Everything you need to "
"clean items after the apocalypse."
msgstr "洗衣板和洗刷工具组成的工具，这就是大灾变后洗涤所需的一切用具。"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "hair dye kit"
msgid_plural "hair dye kits"
msgstr[0] "染发剂套件"

#: data/json/items/tool/toiletries.json
#. ~ Description of "hair dye kit"
msgid ""
"A kit featuring all the tools needed to dye hair, including an applicator "
"brush, combs, and plastic gloves."
msgstr "一套包括染发所需的所有工具的工具包，包括涂抹刷、梳子和塑料手套。"

#: data/json/items/tool/toiletries.json
#. ~ "description" action message of item "hair dye kit"
msgid "Dye your hair"
msgstr "染发"

#: data/json/items/tool/traps.json
#. ~ Description of "bear trap"
msgid ""
"A spring-loaded pair of steel jaws connected to a sensitive pressure plate.  "
"Use it to set it on the ground, creating a trap that will ensnare and damage "
"anything that steps on it.  If you are carrying a shovel, you will have the "
"option of burying it."
msgstr "一副弹簧驱动的钢制夹子，连着灵敏的压力板。布置在地面上做成陷阱，可以保证每个失足踩上来的家伙喝上一壶。如果你随身带着铁锹，你还能把它埋在土里。"

#: data/json/items/tool/traps.json
#. ~ "bury_question" action message of item "bear trap"
msgid "Bury the beartrap?"
msgstr "把捕獸夾埋起來?"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "bear trap"
msgid "You set the beartrap."
msgstr "你設置了捕熊陷阱。"

#: data/json/items/tool/traps.json
#. ~ bury trap message of item "bear trap"
msgid "You bury the beartrap."
msgstr "你把捕獸夾埋起來了。"

#: data/json/items/tool/traps.json
#. ~ Item name
msgid "light snare kit"
msgid_plural "light snare kits"
msgstr[0] "小型捕猎陷阱"

#: data/json/items/tool/traps.json
#. ~ Description of "light snare kit"
msgid ""
"A simple loop snare, comprising a carefully wound loop of string, two anchor "
"points, and a tool to hammer them in.  It is suitable for immobilizing only "
"small animals.  It has no means of harming its target, as live meat lasts "
"longer."
msgstr "一种简单的套圈陷阱，由一根精心缠绕的绳环，两个锚点组成，并用工具将其敲入地里。它只适合抓捕小型动物，没有伤害能力，防止动物死亡导致肉快速变质。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "light snare kit"
msgid "You set the snare trap."
msgstr "你設置了繩套陷阱。"

#: data/json/items/tool/traps.json
#. ~ Item name
msgid "blade trap"
msgid_plural "blade traps"
msgstr[0] "刀刃陷阱"

#: data/json/items/tool/traps.json
#. ~ Description of "blade trap"
msgid ""
"A machete attached laterally to a motor, with a tripwire controlling its "
"throttle.  When the tripwire is pulled, the blade is swung around with great "
"force.  The trap forms a 3x3 area of effect."
msgstr "一把横向连接在电机上的砍刀，有一根拉绳连接油门。当拉绳被拉下，巨大的力量便会带动刀片形成3x3的杀伤性区域。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "blade trap"
msgid "You set the blade trap 2 squares away."
msgstr "你在2格外设置了刀片陷阱。"

#: data/json/items/tool/traps.json
#. ~ Item name
msgid "nailboard trap"
msgid_plural "nailboard traps"
msgstr[0] "釘板陷阱"

#: data/json/items/tool/traps.json
#. ~ Description of "nailboard trap"
msgid ""
"Several pieces of wood nailed together, with some nails sticking straight up. "
" If an unsuspecting victim steps on it, they'll get nails through the foot."
msgstr "这是一块厚实的木板，其中一端上有几枚长长的钉子。你可以邀请你的敌人享受脚板的\"愉悦\"。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "nailboard trap"
#, c-format
msgid "You set the board trap on the %s, nails facing up."
msgstr "你在 %s 上設置了釘板陷阱, 釘尖朝上。"

#: data/json/items/tool/traps.json
#. ~ Description of "booby trap"
msgid ""
"A crude explosive device triggered by a piece of string.  Use it to set it up "
"and wait for some poor bastard to trigger it."
msgstr "由一小截绊线触发的简易爆炸装置。激活它来安装，并等待某个可怜的小混蛋在经过时触发吧。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "booby trap"
msgid "You set the booby trap up and activate the grenade."
msgstr "你設置了詭雷並啟動了手榴彈。"

#: data/json/items/tool/traps.json
#. ~ Description of "bubble wrap"
msgid ""
"A sheet of plastic covered with air-filled bubbles.  Use it to set it on the "
"ground, creating a trap that will warn you with noise when something steps on "
"it."
msgstr "一层充满气泡的塑料薄膜，如果有东西踩过它的话，会发出足够的响声以提醒在附近活动的你。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "bubble wrap"
msgid "You set the bubble wrap on the ground, ready to be popped."
msgstr "你在地上設置了泡泡紙, 踩到就會有剝剝聲。"

#: data/json/items/tool/traps.json
#. ~ Item name
msgid "loose caltrops"
msgid_plural "loose caltrops"
msgstr[0] "雞爪釘"

#: data/json/items/tool/traps.json
#. ~ Description of "loose caltrops"
msgid ""
"A handful of small metal objects covered with many sharp points.  If an "
"unsuspecting victim steps on one, they'll get a spine through the foot."
msgstr "一些金属小刺猬，如果哪个倒霉蛋踩上去，就得担心破伤风的问题了。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "loose caltrops"
#, c-format
msgid "You scatter the caltrops on the %s."
msgstr "你把雞爪釘灑在 %s 上。"

#: data/json/items/tool/traps.json
#. ~ Item name
msgid "loose glass caltrops"
msgid_plural "loose glass caltrops"
msgstr[0] "鬆散的玻璃蒺藜"

#: data/json/items/tool/traps.json
#. ~ Description of "loose glass caltrops"
msgid ""
"A handful of glass shards glued together to expose all their sharp edges.  If "
"an unsuspecting victim steps on one, they'll get cut."
msgstr "这些碎玻璃片用胶水粘在一起，露出锋利的边缘。如果哪个倒霉蛋踩上去，就会被割伤。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "loose glass caltrops"
#, c-format
msgid "You scatter the glass caltrops on the %s."
msgstr "你把玻璃蒺藜撒在 %s 上。"

#: data/json/items/tool/traps.json
#. ~ Description of "crossbow trap"
msgid ""
"A simple tripwire attached to the trigger of a loaded crossbow.  When the "
"tripwire is pulled, the crossbow fires.  Only a single bolt can be used, "
"after which the trap is disabled."
msgstr "一根轻巧的棉线轻柔地连在了弩的扳机之上，绊线拉动后致命的短矢就会直奔目标而去。但只有一发弩矢，之后就需要重新填装了。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "crossbow trap"
msgid "You set the crossbow trap."
msgstr "你設置了十字弓陷阱。"

#: data/json/items/tool/traps.json
#. ~ Description of "land mine"
msgid ""
"A military anti-personnel fragmentation mine that is triggered when stepped "
"on."
msgstr "一个已经埋设好的军用反步兵破片地雷，一旦踩上就会爆炸。"

#: data/json/items/tool/traps.json
#. ~ "bury_question" action message of item "land mine"
msgid "Bury the land mine?"
msgstr "埋藏地雷?"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "land mine"
msgid "You set the land mine."
msgstr "你設置了地雷。"

#: data/json/items/tool/traps.json
#. ~ bury trap message of item "land mine"
msgid "You bury the land mine."
msgstr "你埋藏了地雷。"

#: data/json/items/tool/traps.json
#. ~ Description of "shotgun trap"
msgid ""
"A simple tripwire attached to the trigger of a loaded double slam-fire "
"shotgun.  When the tripwire is pulled, the shotgun fires.  Two shells are "
"loaded; the first time the trigger is pulled, one or both shells may be "
"discharged."
msgstr "一根轻巧的棉线轻柔地连在了一把双管霰弹枪的扳机之上，绊线拉动后霰弹枪就会双管齐发，给那位不幸的家伙一个痛快。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "shotgun trap"
msgid "You set the shotgun trap."
msgstr "你設置了霰彈槍陷阱。"

#: data/json/items/tool/traps.json
#. ~ Item name
msgid "tripwire trap"
msgid_plural "tripwire traps"
msgstr[0] "絆索陷阱"

#: data/json/items/tool/traps.json
#. ~ Description of "tripwire trap"
msgid ""
"A length of thin string with some affixing tools on either end.  It must be "
"placed across a doorway or other thin passage to function.  Its purpose is to "
"trip up trespassers, causing them to stumble and possibly hurt themselves "
"slightly."
msgstr "一个绊索陷阱，只能设置在门口或是狭窄的走廊。入侵者将触发它，将其绊倒的同时也可能造成轻微伤害。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "tripwire trap"
msgid "You string up the tripwire."
msgstr "你將絆線拉好。"

#: data/json/items/tool/traps.json
#. ~ Item name
msgid "loose teeth caltrops"
msgid_plural "loose teeth caltrops"
msgstr[0] "尖齿蒺藜"

#: data/json/items/tool/traps.json
#. ~ Description of "loose teeth caltrops"
msgid ""
"A handful of small impossibly-sharp teeth glued together.  If an unsuspecting "
"victim steps on one, they'll get a tooth through the foot."
msgstr "一把小而锋利的牙齿粘在一起。如果一个毫无戒心的受害者踩到了一颗，他们会把一颗牙齿穿过脚。"

#: data/json/items/tool/traps.json
#. ~ "done_message" action message of item "loose teeth caltrops"
#, c-format
msgid "You scatter the teeth caltrops on the %s."
msgstr "你将尖齿蒺藜洒在%s上。"

#: data/json/items/tool/unfoldable.json
#. ~ Item name
msgid "folded Bicycle"
msgid_plural "folded Bicycles"
msgstr[0] "摺疊式自行車"

#: data/json/items/tool/unfoldable.json
#. ~ Description of "folded Bicycle"
msgid "A folded Bicycle."
msgstr "一架被折叠起来的自行车。"

#: data/json/items/tool/unfoldable.json
#. ~ Item name
msgid "folded wheelchair"
msgid_plural "folded wheelchairs"
msgstr[0] "摺疊輪椅"

#: data/json/items/tool/unfoldable.json
#. ~ Description of "folded wheelchair"
msgid "A folded Wheelchair."
msgstr "一架被折叠起来的轮椅车。"

#: data/json/items/tool/unfoldable.json data/json/vehicles/boats.json
#. ~ Item name
#. ~ Vehicle name
msgid "inflatable boat"
msgid_plural "inflatable boats"
msgstr[0] "充氣船"

#: data/json/items/tool/unfoldable.json
#. ~ Description of "inflatable boat"
msgid ""
"This rubber rowboat (with oars included) is deflated for storage.  Activate "
"it with an air pump in your inventory to inflate and launch it."
msgstr "这艘橡胶皮划艇被放掉气，折叠夹带船桨方便存放。你带着有打气筒时，可以激活将其充气并展开。"

#: data/json/items/tool/unfoldable.json
#. ~ Item name
msgid "skateboard"
msgid_plural "skateboards"
msgstr[0] "滑板"

#: data/json/items/tool/unfoldable.json
#. ~ Description of "skateboard"
msgid "A skateboard."
msgstr "一个滑板。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "wood axe"
msgid_plural "wood axes"
msgstr[0] "伐木斧"

#: data/json/items/tool/woodworking.json
#. ~ Description of "wood axe"
msgid ""
"A large, two-handed wood axe.  It makes a good melee weapon, but is a bit "
"slow to recover between swings."
msgstr "巨大的双手木斧。是个优秀的近战武器，至于速度比较慢，请不要在意这些细节。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "bow saw"
msgid_plural "bow saws"
msgstr[0] "弓形鋸"

#: data/json/items/tool/woodworking.json
#. ~ Description of "bow saw"
msgid ""
"A saw that is more at home outdoors than inside.  It's used for trimming "
"trees, pruning, and cutting firewood, but may be used for other rough cuts as "
"well."
msgstr "一把弓锯，在户外使用起来比室内相比更施展得开。用于伐木、剪枝和砍柴，但也可用于其他不需要精细切割的场景。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "chainsaw (off)"
msgid_plural "chainsaws (off)"
msgstr[0] "鏈鋸 (關閉)"

#: data/json/items/tool/woodworking.json
#. ~ Description of "chainsaw (off)"
msgid ""
"A treecutting tool moonlighting as a weapon of opportunity.  If loaded with "
"gas, using this item will turn it on, turning it into a very powerful but "
"unwieldy melee weapon."
msgstr "一件便利的伐木工具，偶尔也作为武器使用。装填汽油之后，激活它来开启。威力巨大，不过难以掌控。"

#: data/json/items/tool/woodworking.json
#. ~ Player makes sound in effect in EoC "EOC_toolweapon_activate__chainsaw"
#. in use action of item "chainsaw (off)"
#. ~ Player message in effect in EoC "EOC_toolweapon_activate__chainsaw" in
#. use action of item "chainsaw (off)"
msgid "With a roar, the chainsaw screams to life!"
msgstr "隨著一陣咆哮， 鏈鋸猛烈的啟動了！"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "chainsaw (on)"
msgid_plural "chainsaws (on)"
msgstr[0] "鏈鋸 (啟動)"

#: data/json/items/tool/woodworking.json
#. ~ Description of "chainsaw (on)"
msgid "This chainsaw is on and making a lot of noise.  Use it to turn it off."
msgstr "這把開著的鏈鋸正產生大量的噪音。使用它來關閉。"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'sound_message' in effect in EoC
#. "EOC_toolweapon_running__chainsaw" in use action of item "chainsaw (on)"
msgid "Your chainsaw rumbles."
msgstr "你的鏈鋸隆隆作響。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "pole saw (off)"
msgid_plural "pole saws (off)"
msgstr[0] "长柄锯（关）"

#: data/json/items/tool/woodworking.json
#. ~ Description of "pole saw (off)"
msgid ""
"A lumbering tool intended for trimming hedges and tree branches at a "
"distance.  If loaded with gas, using this item will cause it to turn on, "
"making it into an unwieldy polearm."
msgstr "用于远距离修剪树篱和树枝的伐木工具。如果装满汽油，使用此物品会使其开启，使其变成笨重的长柄武器。"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'success_message' in effect in EoC
#. "EOC_toolweapon_activate__polesaw" in use action of item "pole saw (off)"
msgid "With a roar, the pole saw screams to life!"
msgstr "随着一声轰鸣，长柄锯猛烈地转动起来！"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "pole saw (on)"
msgid_plural "pole saws (on)"
msgstr[0] "长柄锯（开）"

#: data/json/items/tool/woodworking.json
#. ~ Description of "pole saw (on)"
msgid "This pole saw is on and making a lot of noise.  Use it to turn it off."
msgstr "长柄锯已经启动，发出可怕的噪声。激活它来关闭。"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'sound_message' in effect in EoC
#. "EOC_toolweapon_running__polesaw" in use action of item "pole saw (on)"
msgid "Your pole saw rumbles."
msgstr "你的长柄锯隆隆作响。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "circular saw (off)"
msgid_plural "circular saws (off)"
msgstr[0] "圓鋸機 (關閉)"

#: data/json/items/tool/woodworking.json
#. ~ Description of "circular saw (off)"
msgid ""
"A lightweight, handheld cordless circular saw.  Spins a circular blade fast "
"enough to cut wood, zombies, or in an emergency, pizza.  The blade, while "
"effective in combat, is hard to hit with due to its small size."
msgstr "一把轻便的手持无线圆锯，能够用来切木头、丧尸或者……呃，如果你等不及了的话，披萨。虽然刃片看起来能在战斗中起到很大作用，但体积太小，想用它打中敌人可不容易。"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'success_message' in effect in EoC
#. "EOC_toolweapon_activate__circsaw" in use action of item "circular saw
#. (off)"
msgid "With a loud buzz, the <npc_name> roars to life!"
msgstr "随着一声轰鸣，<npc_name>猛烈地转动起来！"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "circular saw (on)"
msgid_plural "circular saws (on)"
msgstr[0] "圓鋸機 (啟動)"

#: data/json/items/tool/woodworking.json
#: data/mods/Xedra_Evolved/items/inventor/melee.json
#. ~ Description of "circular saw (on)"
#. ~ Description of "chainsaw spear (on)"
msgid ""
"A lightweight, handheld cordless circular saw.  It is currently on and the "
"blade is spinning; use this item to turn it off."
msgstr "一把轻便的手持无线圆锯。它的刃片正高速旋转。激活它来关闭。"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'sound_message' in effect in EoC
#. "EOC_toolweapon_running__circsaw" in use action of item "circular saw (on)"
msgid "Your circular saw buzzes."
msgstr "你的圓鋸機滋滋作響。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "copper hatchet"
msgid_plural "copper hatchets"
msgstr[0] "铜短柄斧"

#: data/json/items/tool/woodworking.json
#. ~ Description of "copper hatchet"
msgid "A primitive axe made from a small wedge of copper affixed to a short haft."
msgstr "一把原始的斧，楔形的铜质斧头下方装有较短的手柄。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "bronze axe"
msgid_plural "bronze axes"
msgstr[0] "青銅斧"

#: data/json/items/tool/woodworking.json
#. ~ Description of "bronze axe"
msgid ""
"A socketed bronze axe with a work-hardened edge, tightly bound to the shaft "
"with cords."
msgstr "一把带銎的青铜斧，刃口经过加工硬化，斧头像用绳索紧紧地绑在斧柄上。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "hatchet"
msgid_plural "hatchets"
msgstr[0] "手斧"

#: data/json/items/tool/woodworking.json
#. ~ Description of "hatchet"
msgid ""
"A one-handed hatchet.  Makes a great melee weapon, and is useful both for "
"chopping things and hammering them."
msgstr "一柄单手的短斧，是一件不错的近战武器，也可以用于砍柴与捶打。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "luthier toolset"
msgid_plural "luthier toolsets"
msgstr[0] "制琴工具"

#: data/json/items/tool/woodworking.json
#. ~ Description of "luthier toolset"
msgid ""
"A set of luthier tools in several sizes and types.  Guaranteed to have the "
"right tools for creating musical instruments from wood."
msgstr "一套有多种尺寸和类型的制琴师工具。保证拥有合适的工具来用木头制作乐器。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "electric chainsaw (off)"
msgid_plural "electric chainsaws (off)"
msgstr[0] "電鋸 (關閉)"

#: data/json/items/tool/woodworking.json
#. ~ Description of "electric chainsaw (off)"
msgid ""
"A treecutting tool moonlighting as a weapon of opportunity.  If loaded with "
"batteries, using this item will turn it on, turning it into a very powerful "
"but unwieldy melee weapon."
msgstr "一件便利的伐木工具，偶尔也作为武器使用。装填电池之后，激活它来开启。威力巨大，不过难以掌控。"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'success_message' in effect in EoC
#. "EOC_toolweapon_activate__elec_chainsaw" in use action of item "electric
#. chainsaw (off)"
msgid "With a roar, the electric chainsaw screams to life!"
msgstr "隨著一陣咆哮， 電鋸猛烈的啟動了！"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "electric chainsaw (on)"
msgid_plural "electric chainsaws (on)"
msgstr[0] "電鋸 (啟動)"

#: data/json/items/tool/woodworking.json
#. ~ Description of "electric chainsaw (on)"
msgid ""
"This electric chainsaw is on and making a lot of noise.  Use it to turn it "
"off."
msgstr "這把開著的電鋸正產生大量的噪音。使用它來關閉。"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'sound_message' in effect in EoC
#. "EOC_toolweapon_running__elec_chainsaw" in use action of item "electric
#. chainsaw (on)"
msgid "Your electric chainsaw rumbles."
msgstr "你的電鋸隆隆作響。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "corded electric chainsaw (off)"
msgid_plural "corded electric chainsaws (off)"
msgstr[0] "有线电动链锯（关）"

#: data/json/items/tool/woodworking.json
#. ~ Description of "corded electric chainsaw (off)"
msgid ""
"A treecutting tool moonlighting as a weapon of opportunity.  It has a short "
"electric cord, which you can connect to the generator or your home grid.  "
"Extension cord not included."
msgstr "一种临时用作武器的砍树工具。它有一根短电线，你可以把它连接到发电机或家里的电网上。不包括延长线。"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'success_message' in effect in EoC
#. "EOC_toolweapon_activate__elec_chainsaw_cord" in use action of item "corded
#. electric chainsaw (off)"
msgid "With a roar, the corded electric chainsaw screams to life!"
msgstr "随着一声轰鸣，有线电锯尖轰鸣起来！"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "corded electric chainsaw (on)"
msgid_plural "corded electric chainsaws (on)"
msgstr[0] "有线电动链锯（开）"

#: data/json/items/tool/woodworking.json
#. ~ value of variable 'sound_message' in effect in EoC
#. "EOC_toolweapon_running__elec_chainsaw_cord" in use action of item "corded
#. electric chainsaw (on)"
msgid "Your corded electric chainsaw rumbles."
msgstr "你的有线电锯隆隆作响。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "stone axe head"
msgid_plural "stone axe heads"
msgstr[0] "石製斧頭刀片"

#: data/json/items/tool/woodworking.json
#. ~ Description of "stone axe head"
msgid "A broad piece of stone with an edge narrow enough to roughly chop wood."
msgstr "边缘狭窄的宽阔石头，勉强可以用来砍树。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "metal axe head"
msgid_plural "metal axe heads"
msgstr[0] "金屬斧頭刀片"

#: data/json/items/tool/woodworking.json
#. ~ Description of "metal axe head"
msgid ""
"A chunk of steel with one edge hammered down to something resembling a "
"cutting edge.  It works passably well, but really can't compare to a proper "
"axe."
msgstr "一大块钢材，一边被锤成类似于刀刃的东西。它的使用效果还可以，但完全不能与一把真正的斧子相提并论。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "stone adze"
msgid_plural "stone adzes"
msgstr[0] "石錛"

#: data/json/items/tool/woodworking.json
#. ~ Description of "stone adze"
msgid "A stone adze, a primitive tool for smoothing or scraping wood objects."
msgstr "石锛，用来削平木头的原始工具。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "stone axe"
msgid_plural "stone axes"
msgstr[0] "石斧"

#: data/json/items/tool/woodworking.json
#. ~ Description of "stone axe"
msgid ""
"A stone with a narrow edge affixed to a stick.  It can chop wood, but "
"requires much more effort than a modern axe."
msgstr "一块固定在棍子上的窄边石头。它勉强能砍木头，但比现代斧头要费劲得多。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "wood saw"
msgid_plural "wood saws"
msgstr[0] "木鋸"

#: data/json/items/tool/woodworking.json
#. ~ Description of "wood saw"
msgid ""
"A thin saw, useful for cutting through wood objects.  Activate it to turn "
"pre-cut logs into planks."
msgstr "一把很薄的锯子，可以用来锯木头。激活它将砍倒的原木锯成木板。"

#: data/json/items/tool/woodworking.json
#. ~ Item name
msgid "stone chisel"
msgid_plural "stone chisels"
msgstr[0] "石鑿"

#: data/json/items/tool/woodworking.json
#. ~ Description of "stone chisel"
msgid ""
"A short, primitive chisel made from hard stone, usually used for primitive "
"woodworking."
msgstr "一把用坚硬的石头做成的简易短凿，通常用于原始的木工制造。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "pallet of wet adobe bricks"
msgid_plural "pallets of wet adobe bricks"
msgstr[0] "整棧板的濕軟土坏磚"

#: data/json/items/tool/workshop.json
#. ~ Description of "pallet of wet adobe bricks"
msgid "A pallet full of heavy mud bricks which need to dry slowly to be usable."
msgstr "一个装满重泥砖的托盘，需要慢慢干燥才能使用。"

#: data/json/items/tool/workshop.json
#. ~ "msg" action message of item "pallet of wet adobe bricks"
msgid "You test the bricks, and they're solid enough to use."
msgstr "你试了试，这块砖似乎已足够结实可以使用。"

#: data/json/items/tool/workshop.json
#. ~ "not_ready_msg" action message of item "pallet of wet adobe bricks"
msgid "The bricks are still too damp to bear weight."
msgstr "这块砖还太湿，承受不了重量。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "pallet of dry adobe bricks"
msgid_plural "pallets of dry adobe bricks"
msgstr[0] "整棧板的乾土坏磚"

#: data/json/items/tool/workshop.json
#. ~ Description of "pallet of dry adobe bricks"
msgid ""
"A pallet of humble mud bricks that have dried for a week while you were out "
"risking your life.  Disassemble it to retrieve your frame and building "
"supplies."
msgstr "一堆简陋的泥砖，在你出去浴血奋战时，已经在这干燥一个星期了。拆解它来取回你的框架和建造材料。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "acetylene-gas machine"
msgid_plural "acetylene-gas machines"
msgstr[0] "乙炔製造機"

#: data/json/items/tool/workshop.json
#. ~ Description of "acetylene-gas machine"
msgid ""
"A bulky device that turns water and calcium carbide into unpressurized "
"acetylene."
msgstr "这个大型设备将水和电石反应，转化生成常压的乙炔气。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "angle grinder"
msgid_plural "angle grinders"
msgstr[0] "角磨機"

#: data/json/items/tool/workshop.json
#. ~ Description of "angle grinder"
msgid ""
"A widespread power tool, often used for removing excess material or polishing "
"surfaces."
msgstr "这种广泛的电动工具经常用于去除多余的材料或抛光表面。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "cutoff disc"
msgid_plural "cutoff discs"
msgstr[0] "切割圓盤"

#: data/json/items/tool/workshop.json
#. ~ Description of "cutoff disc"
msgid ""
"A manufactured disc for an angle grinder, with a thin, abrasive edge designed "
"for cutting metal."
msgstr "一个用在角磨机上的量产圆盘，具有用于切割金属的薄研磨刃。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "metal grinding disc"
msgid_plural "metal grinding discs"
msgstr[0] "金屬磨盤"

#: data/json/items/tool/workshop.json
#. ~ Description of "metal grinding disc"
msgid ""
"A manufactured disc for an angle grinder, with a thick, abrasive surface "
"designed for grinding and shaping metal."
msgstr "一个用在角磨机上的量产圆盘，具有用于研磨和金属塑形的厚研磨表面。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "brick kiln"
msgid_plural "brick kilns"
msgstr[0] "磚窯"

#: data/json/items/tool/workshop.json
#. ~ Description of "brick kiln"
msgid ""
"A portable coal-or-charcoal-fired kiln.  It is designed for firing bricks, "
"but you could use it to fire anything made of clay."
msgstr "便携式砖窑，可使用木炭或煤炭作为燃料。专为烧制砖块而设计，但也可用于烧制其他粘土制品。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "carding paddles"
msgid_plural "pairs of carding paddles"
msgstr[0] "毛絨刷"

#: data/json/items/tool/workshop.json
#. ~ Description of "carding paddles"
msgid ""
"A pair of toothy wooden paddles used to clean fibers for use in textile "
"production."
msgstr "在紡織生產中， 用來清潔纖維而使用的齒狀木製刷片。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "makeshift vacuum mold"
msgid_plural "makeshift vacuum molds"
msgstr[0] "粗製真空成形機"

#: data/json/items/tool/workshop.json
#. ~ Description of "makeshift vacuum mold"
msgid ""
"A homemade vacuum-forming machine with an air pump.  It's used for creating "
"plastic molds."
msgstr "一台带气泵的自制真空吸塑机。它能够用来制作塑料模具。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "vacuum molder"
msgid_plural "vacuum molders"
msgstr[0] "真空成形機"

#: data/json/items/tool/workshop.json
#. ~ Description of "vacuum molder"
msgid ""
"A vacuum-forming machine with an air pump.  It's used for creating plastic "
"molds."
msgstr "一台带气泵的真空吸塑机。它能够用来制作塑料模具。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "paint chipper"
msgid_plural "paint chippers"
msgstr[0] "油漆刮刀"

#: data/json/items/tool/workshop.json
#. ~ Description of "paint chipper"
msgid "A tool similar to a chisel, designed to remove paint."
msgstr "一個類似鑿子的工具， 用來刮除油漆。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "clamp"
msgid_plural "clamps"
msgstr[0] "夾鉗"

#: data/json/items/tool/workshop.json
#. ~ Description of "clamp"
msgid ""
"A metal clamp, useful for holding things in place, especially if you have "
"several of them."
msgstr "一个金属夹具，如果想要固定某物时会非常有用，特别是当你有好几个这种夹具时。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "claw bar"
msgid_plural "claw bars"
msgstr[0] "撬桿"

#: data/json/items/tool/workshop.json
#. ~ Description of "claw bar"
msgid ""
"A small prying tool with a clawed bend at one end for pulling spikes.  Use it "
"to open locked doors without destroying them or to lift manhole covers.  You "
"could also wield it to bash some heads in."
msgstr "一个小型撬棍，一端有一个带爪的弯曲用于拔出铁钉，可以轻易进出别人的家里而不破坏门或者用来开启下水沟井盖，还可以潇洒的敲开丧尸的脑袋。"

#: data/json/items/tool/workshop.json
#. ~ Description of "concrete mixer"
msgid ""
"A portable concrete mixer.  It is large and heavy, but it can be operated "
"solo.  Unfold to use."
msgstr "一台便携式的水泥搅拌机。虽然它又庞大又笨重，但是能够独自运行。展开来使用。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "cordless drill"
msgid_plural "cordless drills"
msgstr[0] "無線電鑽"

#: data/json/items/tool/workshop.json
#. ~ Description of "cordless drill"
msgid "A cordless battery-powered drill with a selection of drill bits."
msgstr "配備多種鑽頭的電池供電的無線電鑽。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "power drill"
msgid_plural "power drills"
msgstr[0] "电动钻机"

#: data/json/items/tool/workshop.json
#. ~ Description of "power drill"
msgid ""
"A black power drill with a selection of bits.  Uses a power cord, so it will "
"have to be plugged into a power grid or vehicle to function."
msgstr "一台配有各式钻头的黑色电动钻机。使用电源线供电，所以需要将其插入电网或车辆中才能运作。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "cordless impact wrench"
msgid_plural "cordless impact wrenches"
msgstr[0] "無線衝擊扳手"

#: data/json/items/tool/workshop.json
#. ~ Description of "cordless impact wrench"
msgid ""
"A cordless battery-powered impact wrench, designed to deliver high torque via "
"an internal rotating hammer.  It comes with a standard set of sockets, and "
"makes a loud ratcheting sound when it operates.  You could use it to turn "
"large bolts or change a vehicle wheel."
msgstr "电池供电的无绳式电动冲击扳手，内部旋转锤可以产生高扭力。配有一套标准的接头套筒，在运行时会发出响亮的棘轮声。 激活它可以转动更大号的螺栓，或者用于更换轮胎。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "distaff and spindle"
msgid_plural "distaves and spindles"
msgstr[0] "紡錘"

#: data/json/items/tool/workshop.json
#. ~ Description of "distaff and spindle"
msgid "A pair of specialized wooden rods used to spin fibers into thread and yarn."
msgstr "一對專門將纖維紡成縫線和紗的木棍。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "electric jackhammer"
msgid_plural "electric jackhammers"
msgstr[0] "電動手提鑿岩機"

#: data/json/items/tool/workshop.json
#. ~ Description of "electric jackhammer"
msgid ""
"A construction tool for drilling through hard rock or other surfaces.  It "
"runs on a cell compatible with a UPS.  Use it to blast a hole in adjacent "
"solid terrain."
msgstr "一种能够钻穿坚硬岩石或其他表面的建筑工具。它靠UPS驱动，开启后，可以把附近的地面或者敌人钻出一个大洞来。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "hacksaw"
msgid_plural "hacksaws"
msgstr[0] "鋼鋸"

#: data/json/items/tool/workshop.json
#. ~ Description of "hacksaw"
msgid "A sturdy saw, useful for cutting through metal objects."
msgstr "一把堅固的鋸子，適合用來切割金屬物品。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "tin snips"
msgid_plural "tin snips"
msgstr[0] "鐵皮剪"

#: data/json/items/tool/workshop.json
#. ~ Description of "tin snips"
msgid ""
"A pair of tin snips, resembling a sturdy pair of scissors with beefy blades "
"designed to cut through thin sheets of soft metal.  These cannot cut through "
"thick metals like a hacksaw can, but are better suited to precision work and "
"leave a cleaner edge."
msgstr "一把鐵皮剪，看起來像是配有堅硬刀片的堅固剪刀，專用於剪斷軟質金屬薄片。它無法像鋼鋸那樣切割厚金屬，但更適合精密工作並留下更乾淨的切邊。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "hammer"
msgid_plural "hammers"
msgstr[0] "鐵鎚"

#: data/json/items/tool/workshop.json
#. ~ Description of "hammer"
msgid ""
"A demagnetized steel claw hammer with a wooden grip.  With a hammer, nails, "
"and planks in your inventory, you could board up adjacent doors and windows.  "
"It has myriad other uses as well."
msgstr "一把消磁的鋼製羊角錘，有著木製握把。使用鐵鎚、鐵釘與木材就能加固鄰近門窗。另外還有許多用途。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "bronze hammer"
msgid_plural "bronze hammers"
msgstr[0] "青銅鎚"

#: data/json/items/tool/workshop.json
#. ~ Description of "bronze hammer"
msgid ""
"A simple crude bronze hammer.  It is not as sophisticated or useful as its "
"steel alternative but it does get the job of hammering in nails well enough."
msgstr "一把簡單粗製的青銅鎚。它不像鋼製鎚子那樣精緻好用，但拿它來釘釘子是沒問題的。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "bronze nail puller"
msgid_plural "bronze nail pullers"
msgstr[0] "青铜拔钉器"

#: data/json/items/tool/workshop.json
#. ~ Description of "bronze nail puller"
msgid ""
"A crude nail puller made of bronze.  Not really as good as its steel "
"alternative but it gets job of pulling out nails good enough."
msgstr "用青铜制成的简易的拔钉器。虽然没有钢制品那么好，但它可以很好地拔出钉子。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "bronze wood saw"
msgid_plural "bronze wood saws"
msgstr[0] "青铜木工锯"

#: data/json/items/tool/workshop.json
#. ~ Description of "bronze wood saw"
msgid ""
"A simple wood saw made of bronze.  Not as great as its steel equivalent, but "
"it's good enough."
msgstr "一把简易青铜木工锯。没钢制木工锯用的那么顺手，但也够用了。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "hand drill"
msgid_plural "hand drills"
msgstr[0] "手動鑽頭"

#: data/json/items/tool/workshop.json
#. ~ Description of "hand drill"
msgid ""
"A primitive manual drill with a single drill bit.  It is slow to use, and "
"will exhaust you quickly."
msgstr "一种只有单种钻头的原始手摇钻。用起来相当慢，还会迅速耗尽你的精力。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "rubber hose"
msgid_plural "rubber hoses"
msgstr[0] "橡膠軟管"

#: data/json/items/tool/workshop.json
#. ~ Description of "rubber hose"
msgid ""
"A flexible rubber hose.  It could be used for crafting or siphoning fuel from "
"a vehicle."
msgstr "一條有彈性的橡膠軟管。能夠用在製作物品，或是從車輛油桶抽取汽油。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "bottle jack"
msgid_plural "bottle jacks"
msgstr[0] "瓶式千斤頂"

#: data/json/items/tool/workshop.json
#. ~ Description of "bottle jack"
msgid "A portable hydraulic bottle jack used for lifting vehicles."
msgstr "便攜式液壓瓶式千斤頂， 用於抬起車輛。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "makeshift jack"
msgid_plural "makeshift jacks"
msgstr[0] "粗製千斤頂"

#: data/json/items/tool/workshop.json
#. ~ Description of "makeshift jack"
msgid ""
"A poorly-constructed improvised scissor jack used for lifting vehicles if "
"you're brave enough to use it."
msgstr "結構不良的粗製剪式千斤頂，如果你夠勇敢的話，可以用它來抬起車輛。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "scissor jack"
msgid_plural "scissor jacks"
msgstr[0] "剪式千斤頂"

#: data/json/items/tool/workshop.json
#. ~ Description of "scissor jack"
msgid "A compact scissor jack used for lifting vehicles."
msgstr "一個牢固的剪式千斤頂， 用於抬起車輛。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "jackhammer"
msgid_plural "jackhammers"
msgstr[0] "手提鑿岩機"

#: data/json/items/tool/workshop.json
#. ~ Description of "jackhammer"
msgid ""
"A construction tool for drilling through hard rock or other surfaces.  It "
"runs on gasoline.  Use it (if loaded) to blast a hole in adjacent solid "
"terrain."
msgstr "用於鑽穿堅硬岩石或其他表面的建築施工工具。它靠汽油運作。使用它（如果已裝有汽油）在鄰近的堅固地形上鑽洞。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "electric kiln"
msgid_plural "electric kilns"
msgstr[0] "電窯"

#: data/json/items/tool/workshop.json
#. ~ Description of "electric kiln"
msgid ""
"An electric kiln, powered by your electric grid.  It is designed for firing "
"bricks, but you could use it to fire anything made of clay.  With a little "
"mechanical know-how, you could probably even convert it to run directly off a "
"vehicle's power system."
msgstr "一个使用电池供电的电窑，带有一个插头。原本设计用来烧制砖块，但你可以用它来烧制任何用黏土制品。如果会一些机械知识，你甚至可以把它改装为车载电源供电。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "gunsmith repair kit"
msgid_plural "gunsmith repair kits"
msgstr[0] "槍匠修理工具"

#: data/json/items/tool/workshop.json
#. ~ Description of "gunsmith repair kit"
msgid ""
"A complete tool kit made to repair damaged firearms.  Powered by standard "
"batteries, it is a vital tool for long-term firearms maintenance.  It "
"requires 1 charge of battery power per use."
msgstr "用來修理受損槍械的完整工具組。使用一般電池供電，是槍械長期保養的重要工具。每次使用消耗 1 電量。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "makeshift hammer"
msgid_plural "makeshift hammers"
msgstr[0] "粗製鎚子"

#: data/json/items/tool/workshop.json
#. ~ Description of "makeshift hammer"
msgid ""
"A crude hammer made from a piece of metal affixed to a stick.  It functions "
"adequately, but really can't compare to a proper hammer."
msgstr "把金屬固定在棍子上製成的粗糙鎚子。當作鎚子敲敲打打沒有問題，但還比不上真正的鐵鎚。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "bronze fileset"
msgid_plural "bronze filesets"
msgstr[0] "青铜锉刀组"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "metal fileset"
msgid_plural "metal filesets"
msgstr[0] "金屬銼刀組"

#: data/json/items/tool/workshop.json
#. ~ Description of "metal fileset"
msgid ""
"A set of tools commonly used to remove small amounts of material from the "
"surface of metal objects."
msgstr "一把常用于去除金属物体表面少量的材料的工具。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "metallic smoother"
msgid_plural "metallic smoothers"
msgstr[0] "金屬製的水泥刮刀"

#: data/json/items/tool/workshop.json
#. ~ Description of "metallic smoother"
msgid ""
"A tool that is most often used to smooth concrete or mortar in construction "
"projects."
msgstr "一把在建筑工程中常用于磨平混凝土或砂浆的工具。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "miscellaneous repair kit"
msgid_plural "miscellaneous repair kits"
msgstr[0] "雜項維修工具組"

#: data/json/items/tool/workshop.json
#. ~ Description of "miscellaneous repair kit"
msgid ""
"A portable tool kit consisting of a small craft knife for precise carving of "
"replacement parts from raw materials, a wood saw for more heavy-duty wood "
"cutting, and a patch of soft material for cleaning surfaces.  If supplied "
"with duct tape, it can be used to repair certain items."
msgstr ""
"一個便攜式工具包，包括用于從原材料中精確替換部件的小型刻刀、用于切割木材的耐用木工鋸以及用于清潔表面的柔軟布條。配合足夠的強力膠帶，可用于修複部分材質特殊的"
"物品。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "multitool"
msgid_plural "multitools"
msgstr[0] "多功能工具"

#: data/json/items/tool/workshop.json
#. ~ Description of "multitool"
msgid ""
"A cleverly designed all-in-one tool which combines several smaller tools into "
"the handles of a pair of pliers."
msgstr "一把巧妙設計的多合一工具， 它的把手就是一隻鉗子， 還結合了幾個小工具。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "camping multitool"
msgid_plural "camping multitools"
msgstr[0] "野營多功能工具"

#: data/json/items/tool/workshop.json
#. ~ Description of "camping multitool"
msgid ""
"A 'Hideman' brand multi-tool.  This model includes extra options for outdoors "
"use such as a firestarting rod, awl, rescue whistle and a hammering surface."
msgstr "「Hideman」品牌多功能工具。該型號包括適合戶外使用的額外工具，例如點火棒、錐子、救援哨和錘頭。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "acetylene torch"
msgid_plural "acetylene torches"
msgstr[0] "乙炔焊槍"

#: data/json/items/tool/workshop.json
#. ~ Description of "acetylene torch"
msgid ""
"A compact tool kit intended for welding and cutting metal, this portable "
"oxygen-acetylene torch includes a torch handle and cutting attachment in an "
"easy-to-carry tote.  It needs to be connected to a pressurized cylinder of an "
"appropriate welding gas before use.  In addition to its metalworking uses, "
"you can activate it in order to destroy metal barriers."
msgstr ""
"這款便攜式氧-"
"乙炔焊槍是一款用於焊接和切割金屬的緊湊型工具套件，在易於攜帶的手提包中包括焊槍手柄和切割附件。使用前需連接適當焊接氣體的加壓鋼瓶。除了金屬加工用途外，你還可"
"以使用它來摧毀金屬障礙物。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "paint brush"
msgid_plural "paint brushes"
msgstr[0] "油漆刷"

#: data/json/items/tool/workshop.json
#. ~ Description of "paint brush"
msgid "A wide brush, suitable for painting walls."
msgstr "一個大的刷子， 適合用來粉刷牆壁。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "pickaxe"
msgid_plural "pickaxes"
msgstr[0] "十字鎬"

#: data/json/items/tool/workshop.json
#. ~ Description of "pickaxe"
msgid ""
"A large steel pickaxe, suitable for breaking up hard things or (with enough "
"skill) hard targets.  Strike the earth!"
msgstr "一把钢制大镐头，刨墙砸头两不误。劳动人民一声吼，地球也要抖三抖！"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "bronze pickaxe"
msgid_plural "bronze pickaxes"
msgstr[0] "青銅十字鎬"

#: data/json/items/tool/workshop.json
#. ~ Description of "bronze pickaxe"
msgid ""
"A heavy-headed cast and worked tool with a pointed wedge on one side for "
"breaking stone and a flat wedge on the other for prying it out.  You could "
"mine with this."
msgstr "一把整体铸造加工成型的头部大而沉重的工具，一端尖楔用来砸碎石头，另一端平楔用来撬出碎石。你可以用它挖矿。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "pin reamer"
msgid_plural "pin reamers"
msgstr[0] "銷子鉸刀"

#: data/json/items/tool/workshop.json
#. ~ Description of "pin reamer"
msgid ""
"Handheld pin reamers of this kind are used to enlarge existing holes, or "
"remove any burs and such from them."
msgstr "這種手持式銷子鉸刀用於擴大現有孔徑，或移除任何毛刺之類的東西。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "pliers"
msgid_plural "pliers"
msgstr[0] "鉗子"

#: data/json/items/tool/workshop.json
#. ~ Description of "pliers"
msgid ""
"A basic pair of slip-joint pliers, able to handle basic mechanical work.  "
"Anything more complex will require a wrench."
msgstr "一把外形简单的鲤鱼钳，只能用来做一些基本的机械工作，再复杂一点的操作就需要用扳手了。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "tongue-and-groove pliers"
msgid_plural "tongue-and-groove pliers"
msgstr[0] "管鉗"

#: data/json/items/tool/workshop.json
#. ~ Description of "tongue-and-groove pliers"
msgid ""
"A large pair of slip-joint pliers bent at the elbow, able to handle basic "
"mechanical work.  Anything more complex will require a wrench."
msgstr "一把弯头处弯曲的大型滑动鲤鱼钳，只能用来做一些基本的机械工作，再复杂一点的操作就需要用扳手了。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "locking pliers"
msgid_plural "locking pliers"
msgstr[0] "鎖定鉗"

#: data/json/items/tool/workshop.json
#. ~ Description of "locking pliers"
msgid ""
"A pair of pliers with extra-hefty jaws and an adjustable mechanism to clamp "
"them in a locked grip on whatever unfortunate object is trapped between them. "
" They could grip and turn a fairly large bolt head, or clamp two parts "
"together temporarily."
msgstr ""
"一把有个特别大的钳口的钳子，还有一个可调节的机构，可以将钳子夹在可锁紧的夹钳中，夹住任何被夹在钳子之间的不幸物体。它可以抓住并转动相当大的螺栓，或者暂时将两"
"个零件夹在一起。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "electric polisher"
msgid_plural "electric polishers"
msgstr[0] "電力打磨機"

#: data/json/items/tool/workshop.json
#. ~ Description of "electric polisher"
msgid ""
"An electric polisher, used to buff metal surfaces until they are reflective "
"like a mirror."
msgstr "一台电动打磨机，用来打磨金属地面，直到它们像镜子一样亮。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "stone hammer"
msgid_plural "stone hammers"
msgstr[0] "石鎚"

#: data/json/items/tool/workshop.json
#. ~ Description of "stone hammer"
msgid ""
"A rock affixed to a stick in the crude facsimile of a hammer.  It functions "
"adequately, but really can't compare to a proper hammer, and can't pull out "
"nails either."
msgstr "一个插着棒子的岩石，勉强构成锤子的形状。它功能类似锤子，但比真正的锤子差太多，而且没法用它拔出钉子。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "reciprocating saw"
msgid_plural "reciprocating saws"
msgstr[0] "往復鋸"

#: data/json/items/tool/workshop.json
#. ~ Description of "reciprocating saw"
msgid ""
"A battery-powered tool, commonly known by the generic trademark Sawzall, that "
"uses an electric motor to push a straight sawblade back and forth to rapidly "
"cut wood or metal.  It is useful for heavy demolition and construction work, "
"but poorly suited to precision tasks."
msgstr "一种以电池为动力的工具，通常也被称为军刀锯，它使用电动机往复驱动一根直锯，以快速切割木材或金属。它适用于大型拆除和建筑作业，但不适合干精细活。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "Hub 01 HWP maintenance kit"
msgid_plural "Hub 01 HWP maintenance kits"
msgstr[0] "Hub 01 HWP 維修工具箱"

#: data/json/items/tool/workshop.json
#. ~ Description of "Hub 01 HWP maintenance kit"
msgid ""
"A heavy-duty bag marked with the Hub 01 logo.  It contains space for barrels, "
"adapters, and proprietary tools.  Embossed on the inside is a sketch of the "
"Hybrid Weapons Platform."
msgstr "一个印着Hub 01标志的沉甸甸的箱子。它包含用于放置枪管、适配器和专用工具的空间。内部压印出了混合武器平台的缩略图。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "screwdriver"
msgid_plural "screwdrivers"
msgstr[0] "螺絲起子"

#: data/json/items/tool/workshop.json
#. ~ Description of "screwdriver"
msgid ""
"A Philips-head screwdriver.  It is important for almost all electronics "
"crafting, most mechanics crafting, and has many more uses."
msgstr "十字頭螺絲起子。它對幾乎所有電子工藝、多數的機械工藝都很重要，而且還有更多其他用途。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "screwdriver set"
msgid_plural "screwdriver sets"
msgstr[0] "螺絲起子套裝"

#: data/json/items/tool/workshop.json
#. ~ Description of "screwdriver set"
msgid ""
"A set of screwdrivers in several sizes and blade types.  Guaranteed to have "
"the right tools for more precise work."
msgstr "一組有多種尺寸和起子頭型的螺絲起子。確保有合適的工具來進行更精確的工作。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "socket screwdriver set"
msgid_plural "socket screwdriver sets"
msgstr[0] "六角螺絲起子套裝"

#: data/json/items/tool/workshop.json
#. ~ Description of "socket screwdriver set"
msgid ""
"A ratcheting screwdriver with a collection of hex sockets for turning small "
"bolts or nuts, including a couple standard screwdriver bits."
msgstr "帶有一組六角套筒的棘輪螺絲起子，用於轉動小螺栓或螺母，包括幾個標準尺寸的起子頭。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "socket wrench set"
msgid_plural "socket wrench sets"
msgstr[0] "套筒扳手組"

#: data/json/items/tool/workshop.json
#. ~ Description of "socket wrench set"
msgid ""
"A thick-handled ratchet wrench with an assortment of interchangeable sockets "
"in common hex bolt sizes.  You could loosen or tighten fairly large bolts "
"with this, and the ratchet makes a satisfying clicking sound."
msgstr "一把厚柄齿轮扳手，带有各种通用六角螺栓尺寸的可更换套筒。你可以用这个松开或拧紧相当大的螺栓，齿轮能发出令人满意的咔嗒声。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "firearm repair kit"
msgid_plural "firearm repair kits"
msgstr[0] "槍械修理工具"

#: data/json/items/tool/workshop.json
#. ~ Description of "firearm repair kit"
msgid ""
"A portable tool kit made to repair damaged firearms.  Powered by standard "
"batteries, it is a vital tool for long-term firearms maintenance.  It "
"requires one charge of battery power per use."
msgstr "用來修理受損槍械的便攜工具組。使用一般電池供電，是槍械長期保養的重要工具。每次使用消耗 1 電量。"

#: data/json/items/tool/workshop.json
#. ~ Description of "soldering iron"
msgid ""
"A device with a metal tip that can get very hot.  It is necessary for "
"advanced electronics crafting.  Has a short cable that you can plug to your "
"grid."
msgstr "一種金屬尖端能產生高溫的設備。這是先進電子產品製造必備的工具。有一條短電纜，你可以將其連接至電網。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "portable soldering iron"
msgid_plural "portable soldering irons"
msgstr[0] "隨身電烙鐵"

#: data/json/items/tool/workshop.json
#. ~ Description of "portable soldering iron"
msgid ""
"A device with a metal tip that can get very hot.  It is necessary for "
"advanced electronics crafting.  This one is a portable version, and contains "
"a slot for a battery."
msgstr "一種金屬尖端能產生高溫的設備。這是先進電子產品製造必備的工具。這個是便攜式的，有一個電池匣。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "lug wrench"
msgid_plural "lug wrenches"
msgstr[0] "單向扳手"

#: data/json/items/tool/workshop.json
#. ~ Description of "lug wrench"
msgid ""
"A steel rod bent 90 degrees with a socket on the shorter end, made to hold "
"the lug nuts of a car's wheels to either fasten or loosen for convenient "
"removal and replacement.  Makes for a decent melee weapon in a pinch."
msgstr "一根彎曲90度的鋼棍，短端有一個套筒，用來固定車輪的凸緣螺母，以便拆卸和更換。在緊要關頭時可以用來當作近戰武器。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "toolbox"
msgid_plural "toolboxes"
msgstr[0] "工具箱"

#: data/json/items/tool/workshop.json
#. ~ Description of "toolbox"
msgid ""
"A stout metal box for holding tools.  It has a handle on the top and a latch "
"on the front."
msgstr "一个结实的金属工具盒。它的顶部有一个把手，正面有一个插销。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "workshop toolbox"
msgid_plural "workshop toolboxes"
msgstr[0] "工坊工具箱"

#: data/json/items/tool/workshop.json
#. ~ Description of "workshop toolbox"
msgid ""
"A stout metal box for holding tools.  It is much bigger than a regular "
"toolbox, and can be used to store more tools as a result."
msgstr "一个结实的金属工具盒。这一个比一般的工具盒都要大，也就是说里面可以存放更多的工具。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "arc welder"
msgid_plural "arc welders"
msgstr[0] "電弧焊機"

#: data/json/items/tool/workshop.json
#. ~ Description of "arc welder"
msgid ""
"A cable-powered tool for welding metal pieces together using an electric arc. "
" It is an indispensable tool for construction or repair."
msgstr "一台带插头的焊机，用于金属电弧焊，是建造或修理不可缺少的工具。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "makeshift arc welder"
msgid_plural "makeshift arc welders"
msgstr[0] "粗製電弧焊機"

#: data/json/items/tool/workshop.json
#. ~ Description of "makeshift arc welder"
msgid ""
"A crude arc welder fashioned from a few small transformers, some wire, an "
"improvised electrode holder, and a complete disregard for personal safety.  "
"While it's not as efficient as a factory-made welder, it will serve in a "
"pinch."
msgstr "简陋的电弧焊机，由几台小变压器、一些电线、一个临时制作的电极架组成，完全无视个人安全。它的效率不如工厂出品的标准焊机，但在必要时也不是不能用。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "high-temperature welding kit"
msgid_plural "high-temperature welding kits"
msgstr[0] "高溫焊接工具組"

#: data/json/items/tool/workshop.json
#. ~ Description of "high-temperature welding kit"
msgid ""
"A welder combined with a fireproof insulating blanket allows for advanced "
"welds and repairs to tempered steels."
msgstr "焊接機結合防火絕緣毯，可以對回火鋼進行高級焊接和修復。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "wooden smoother"
msgid_plural "wooden smoothers"
msgstr[0] "木製的水泥刮刀"

#: data/json/items/tool/workshop.json
#. ~ Description of "wooden smoother"
msgid ""
"A large makeshift tool used in smoothing concrete or mortar in construction "
"projects.  You could also use it as an improvised head-basher."
msgstr "這個大型自制工具通常用于在建築時平整混凝土、抹平砂漿。情況緊急的時候你也可以拿它削別人的腦袋。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "X-Acto knife"
msgid_plural "X-Acto knives"
msgstr[0] "X-Acto 美工刀"

#: data/json/items/tool/workshop.json
#. ~ Description of "X-Acto knife"
msgid ""
"A small, sharp knife, designed for making precise cuts for textiles or "
"crafts.  It could cause decent damage, but is difficult to land a solid hit "
"with.  Its small, sharp blade allows for precision strikes in the hands of "
"the skilled."
msgstr "小而锋利的刀，用于精确切割纺织品或工艺品。它可以造成相当大的伤害，但很难击中目标。小而锋利的刀刃熟练的人手中可以实现精确打击。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "small adjustable wrench"
msgid_plural "small adjustable wrenches"
msgstr[0] "小型活動扳手"

#: data/json/items/tool/workshop.json
#. ~ Description of "small adjustable wrench"
msgid ""
"A compact adjustable crescent wrench, with a short handle that fits in the "
"palm of your hand.  It could be used for turning small hex-head nuts or bolts."
msgstr "一把结构紧凑的新月形可调扳手，手柄很短，可放在手掌中。它可用于转动小型六角螺母或螺栓。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "adjustable wrench"
msgid_plural "adjustable wrenches"
msgstr[0] "活動扳手"

#: data/json/items/tool/workshop.json
#. ~ Description of "adjustable wrench"
msgid "An adjustable crescent wrench.  It is used in many mechanics crafting recipes."
msgstr "一把新月形可调扳手。是许多机械制造的必备之物。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "large adjustable wrench"
msgid_plural "large adjustable wrenches"
msgstr[0] "大型活動扳手"

#: data/json/items/tool/workshop.json
#. ~ Description of "large adjustable wrench"
msgid ""
"An unusually large adjustable crescent wrench, with a long handle and jaws "
"that widen over two inches.  This could easily turn most bolts, and should "
"even work on wheel lug nuts."
msgstr "一把非常大的新月形可调扳手，手柄很长，钳口约两英寸（约5厘米）宽。这样可以很容易地转动大多数螺栓，甚至可以转动车轮凸缘螺母。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "heavy-duty pipe wrench"
msgid_plural "heavy-duty pipe wrenches"
msgstr[0] "重型管道扳手"

#: data/json/items/tool/workshop.json
#. ~ Description of "heavy-duty pipe wrench"
msgid ""
"A 48in pipe wrench, normally used in oil fields and in the maintenance of "
"public utilities.  It's much larger and heavier than you have any practical "
"use for."
msgstr "一把48英寸的管钳，通常用于油田和公共设施的维护工作。这玩意儿又大又沉，根本找不到任何能用上它的地方。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "leather hose"
msgid_plural "leather hoses"
msgstr[0] "皮製軟管"

#: data/json/items/tool/workshop.json
#. ~ Description of "leather hose"
msgid ""
"A hose made of leather.  Watertight and flexible, it can be used to siphon "
"fuel from a vehicle tank.  However, it's not as elastic as a rubber hose."
msgstr "一根用皮革制成的软管。水密而且有弹性，可从车辆油箱中抽取燃油。但是它的弹性不如橡胶软管好。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "makeshift hand drill"
msgid_plural "makeshift hand drills"
msgstr[0] "粗製手動鑽頭"

#: data/json/items/tool/workshop.json
#. ~ Description of "makeshift hand drill"
msgid ""
"A makeshift manual drill made with a pipe and an improvised drill bit.  Using "
"it is very slow, and will exhaust you quickly."
msgstr "一个用铁管和原始手工钻头制成的简易手摇钻。转速非常缓慢，而且会迅速耗尽你的精力。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "wire draw machine"
msgid_plural "wire draw machines"
msgstr[0] "拉線機"

#: data/json/items/tool/workshop.json
#. ~ Description of "wire draw machine"
msgid "A machine designed specifically for turning metal rods into wire."
msgstr "一台专门用来把金属棒变成金属丝的机器。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "propane torch"
msgid_plural "propane torches"
msgstr[0] "丙烷焊炬"

#: data/json/items/tool/workshop.json
#. ~ Description of "propane torch"
msgid ""
"A compact tool kit intended for heating metal, this portable propane torch "
"includes a torch handle and accessories in an easy-to-carry tote.  It needs "
"to be connected to a pressurized propane cylinder before use."
msgstr "一个用于加热金属的紧凑型工具包，这套便携式丙烷喷枪包括一个喷枪手柄和配件，都装在一个便于携带的工具包里。在使用前需要连接到一个丙烷加压气瓶上。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "block and tackle"
msgid_plural "blocks and tackles"
msgstr[0] "滑輪組"

#: data/json/items/tool/workshop.json
#. ~ Description of "block and tackle"
msgid ""
"A sturdy metal housing with a number of pulleys that can be used with a thick "
"rope or a chain to gain mechanical advantage on a lift."
msgstr "一套滑轮组，由坚固的金属外壳包裹住，可与粗绳或钢链一起使用，以获得起重时的省力优势。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "wooden block and tackle"
msgid_plural "wooden blocks and tackles"
msgstr[0] "木製滑輪組"

#: data/json/items/tool/workshop.json
#. ~ Description of "wooden block and tackle"
msgid ""
"A wooden housing with a pair of pulleys that can be used with a thick rope or "
"a chain to gain mechanical advantage on a lift.  Not as durable as a metal "
"set."
msgstr "一套滑轮组，由木制外壳包裹住，可与粗绳或钢链一起使用，以获得起重时的省力优势。不如钢制的版本坚固。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "welding blanket"
msgid_plural "welding blankets"
msgstr[0] "焊接防護毯"

#: data/json/items/tool/workshop.json
#. ~ Description of "welding blanket"
msgid ""
"A non-flammable mat used to protect surfaces from welding splatter, or to "
"insulate a weld when repairing tempered metal.  This one is made with "
"asbestos."
msgstr "阻燃的衬垫，在焊接时可用于保护工作面免遭焊接飞溅的损害，或在修复回火金属时用于隔离焊缝。这一块是用石棉做的。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "makeshift welding blanket"
msgid_plural "makeshift welding blankets"
msgstr[0] "粗製焊接防護毯"

#: data/json/items/tool/workshop.json
#. ~ Description of "makeshift welding blanket"
msgid ""
"A makeshift mostly-non-flammable mat used to protect surfaces from welding "
"splatter or to insulate a weld when repairing tempered metal.  This one is "
"stitched together from oven insulation batts."
msgstr "粗制的阻燃垫，用于保护工作面免遭焊接飞溅的损害，或在修复回火金属时保证焊缝绝缘。其实就是缝在一起的烤箱绝缘垫。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "thread cutting set"
msgid_plural "thread cutting sets"
msgstr[0] "螺纹加工套件"

#: data/json/items/tool/workshop.json
#. ~ Description of "thread cutting set"
msgid ""
"This is a set of a external thread cutting die inserted into a manual grip "
"and an internal thread cutting die used as a drill bit."
msgstr "一整套攻螺纹与套螺纹的工具，包括攻螺纹的丝锥，套螺纹的板牙等。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "fanning mill"
msgid_plural "fanning mills"
msgstr[0] "扬谷机"

#: data/json/items/tool/workshop.json
#. ~ Description of "fanning mill"
msgid ""
"A machine for separating seed from chaff.  It mechanized the winnowing "
"process, in which the grain was separated from the lighter chaff and straw by "
"blowing a leather bellows."
msgstr "从谷壳中分离种子的机器。它机械化了簸扬过程，在这个过程中，通过吹一个皮革风箱将谷物与较轻的谷壳和稻草分开。"

#: data/json/items/tool/workshop.json
#. ~ Item name
msgid "bench vise"
msgid_plural "bench vises"
msgstr[0] "台鉗"

#: data/json/items/tool/workshop.json
#. ~ Description of "bench vise"
msgid ""
"A heavy, metal vise bolted down to a work surface.  With its jaws and screw, "
"it can tightly hold items, useful for a wide array of handiwork such as "
"soldering, woodworking, welding, anything that can be aided by a firm grip.  "
"Also has a small, flat metal surface, useful for light metalworking if needed."
msgstr ""
"这是一种固定在工作台面上的重型金属虎钳，通过其钳口和螺丝机构，能紧紧夹持物品，对于需要稳固抓握的多种手工活非常有用，比如焊接、木工、焊接等工作。它还带有一块"
"小而平坦的金属表面，必要时可用于轻型金工操作。"

#: data/json/items/tool/workshop.json
#. ~ Description of "Exodii kiln"
msgid ""
"An electric kiln, powered by your electric grid.  A bit larger than a "
"refridgerator, this Exodii-manufactured kiln is large enough to repair the "
"sheets of ceramic they use for armor.  It is designed for firing sheets of "
"the Exodii's ceramic, but you could use it to fire anything made of clay.  A "
"large and power-hungry appliance."
msgstr ""
"一台由流亡族制造的巨型电窑，需要接入你的电网才能运作。它的体积比冰箱还大，而且是个十足的“电老虎”。其尺寸之大，足以修复流亡族用作护甲的陶瓷板。虽然其设计初"
"衷是烧制流亡族的特种陶瓷，但你也可以用它来烧制任何黏土制品。"

#: data/json/items/vehicle/alternator.json
#: data/json/vehicleparts/alternator.json
#. ~ Item name
#. ~ Vehicle part name
msgid "car alternator"
msgid_plural "car alternators"
msgstr[0] "汽車發電機"

#: data/json/items/vehicle/alternator.json
#. ~ Description of "car alternator"
msgid "A standard alternator used to power vehicle electrical systems."
msgstr "一台用於驅動車輛電氣系統的標準發電機。"

#: data/json/items/vehicle/alternator.json
#: data/json/vehicleparts/alternator.json
#. ~ Item name
#. ~ Vehicle part name
msgid "motorbike alternator"
msgid_plural "motorbike alternators"
msgstr[0] "機車發電機"

#: data/json/items/vehicle/alternator.json
#. ~ Description of "motorbike alternator"
msgid ""
"A compact, lightweight alternator used to power small vehicle electrical "
"systems."
msgstr "一个紧凑轻便的用来带动小型汽车电气系统的发电机。"

#: data/json/items/vehicle/alternator.json
#: data/json/vehicleparts/alternator.json
#. ~ Item name
#. ~ Vehicle part name
msgid "bicycle alternator"
