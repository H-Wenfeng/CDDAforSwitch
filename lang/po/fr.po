msgstr "Je suis en mauvais état, réparez-moi!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I can't keep going like this!"
msgstr "Je ne peux pas continuer dans cet état!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm breaking down!"
msgstr "Je suis en train de me désagréger!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "Can you fix me?"
msgstr "Est-ce que vous pouvez me réparer?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm all busted up!"
msgstr "Je suis en mauvais état!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "They did a number on me!"
msgstr "Ils m'on démoli·e!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "Don't let me fall apart!"
msgstr "Ne me laisser pas tomber en morceaux!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I need some serious repairs!"
msgstr "Je besoin de sérieuses réparations!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm in pieces over here!"
msgstr "Je suis en plusieurs morceaux!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "Can you put me back together?"
msgstr "Est-ce que vous pouvez me raccommoder en un seul morceau?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I've seen better days!"
msgstr "J'ai connu de meilleurs jours!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm not as tough as I used to be!"
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "This isn't looking good for me!"
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm falling to bits!"
msgstr "Je me morcèle!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_damaged>"
msgid "I'm barely holding together!"
msgstr "Je tiens à peine en un seul morceau!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Let me kill something already!"
msgstr "Laissez-moi tuer quelque chose!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'm bored."
msgstr "Je m'ennuie."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "What's for dinner?"
msgstr "Qu'est-ce qu'on a pour le dîner?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Wow!  Everything looks so… nevermind."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You seriously need friends."
msgstr "Vous avez vraiment besoin de compagnie."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "So, got any hobbies?"
msgstr "Donc… Vous faites quoi de votre temps libre?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I spy with my little eye… oh right, I don't have eyes."
msgstr "J’espionne avec mon petit œil… Oh ouais j'ai oublié(e), je n'ai pas d'yeux."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Lovely weather we're having, huh?"
msgstr "Beau temps, hein?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "So what if everyone you know is dead, you've still got me, right?"
msgstr ""
"Qui s'en fiche que tout le monde que vous ayez jamais connu(e) soit morts, "
"vous avez toujours moi non?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Best friends forever!"
msgstr "Meilleurs ami(e)s pour la vie!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Come on!  What're we doing here?!"
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "This trip was pointless."
msgstr "Ce voyage était inutile."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You're gonna die out here."
msgstr "Vous allez mourir là-dehors."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You're in charge?  We're screwed."
msgstr "Vous êtes responsable? On est fichu·e·s."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Dang, you look terrible."
msgstr "Wow, vous avez l'air horrible."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You should take a shower."
msgstr "Vous devriez prendre une douche."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "We should go home, it's not safe here."
msgstr "On devrait rentrer à la maison, cet endroit est dangereux."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "We're in over our heads!"
msgstr "Nous sommes dépassé·e·s!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "There's something following us, I can feel it."
msgstr "Il y a quelque chose qui nous suit, je le sens."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'm your best friend, right?"
msgstr "Je suis votre meilleur(e) ami(e), non?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Sorry about earlier, can you forgive me?"
msgstr "Désolé pour ce qui s'est passé tout à l'heure, on oublie?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Do you think it'll rain today?"
msgstr "Vous pensez qu'il va pleuvoir aujourd'hui?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I love you!"
msgstr "Je t'aime!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Shhh… I think I heard something."
msgstr "Chuttt… Je crois que j'ai entendu quelque chose."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Did you hear that?"
msgstr "Avez-vous entendu ça?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Try not to drop me."
msgstr "Essayez de ne pas me lâcher."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "How many do you think we've killed?"
msgstr "Combien vous pensez qu'on en a tués?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'll keep you safe."
msgstr "Je vais vous protéger."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Do you ever wonder why we're here?"
msgstr "Vous vous demandez pourquoi nous sommes sur terre des fois?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I think we should turn back."
msgstr "Je pense que nous devrions faire demi-tour."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Is this real life?"
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You can't survive without me."
msgstr "Vous ne pouvez pas survivre sans moi."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Do you believe in fate?"
msgstr "Vous croyez au destin?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "What if this is all a dream?"
msgstr "Et si tout ceci n'était qu'un rêve?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Are we being followed?"
msgstr "Est-ce qu'on est suivis?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I think we're lost."
msgstr "Je crois qu'on est perdus·es."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'm the only one you can trust."
msgstr "Je suis la seule chose en qui vous pouvez faire confiance."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Do you remember the good old days?"
msgstr "Vous vous rappelez des bon vieux temps?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You're not alone, you have me."
msgstr "Vous n'êtes pas tout·e seul·e, vous m'avez."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Everything is going to be fine."
msgstr "Tout va bien se passer."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I'm feeling chatty today."
msgstr "Je me sens loquace aujourd'hui."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Ever had one of those days?"
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "What's the plan now?"
msgstr "C'est quoi le plan maintenant?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I miss the old days."
msgstr "Je regrette le bon vieux temps."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "It's awfully quiet around here."
msgstr "Tout est affreusement silencieux ici."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "You need a hobby."
msgstr "Vous avez besoin d'un passe-temps."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Have you ever seen anything like this?"
msgstr "Vous avez déjà vu quelque chose comme ça?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "We should rest soon."
msgstr "Nous devrions nous reposer bientôt."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I've got your back."
msgstr "Je suis là pour vous."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "We make a great team."
msgstr "Nous faisons une bonne équipe."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "This place gives me the creeps."
msgstr "Cet endroit me donne froid dans le dos."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "Got any stories to share?"
msgstr "Vous avez des histoires à raconter?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I think we're being watched."
msgstr "J'ai l'impression que quelque chose nous observe."

#: data/json/snippets/schizophrenia.json
#: data/mods/Magiclysm/npc/TALK_FORGE_PIRATE.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
#. ~ NPC dialogue line
msgid "Watch your step."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I've seen worse."
msgstr "J'ai vu pire."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "I think I'm growing on you."
msgstr "Je pense que je commence à vous apprécier."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "<schizo_weapon_talk_misc>"
msgid "What's our next move?"
msgstr "C'est quoi notre prochaine étape?"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like the world is out to get you."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel a mounting sense of impending doom."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid ""
"You gain the sudden realization that you must have been responsible for the "
"Cataclysm."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You get the odd feeling that your thoughts are not your own."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel as if everyone in the world must be playing a sick prank on you."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You are being watched… by THEM."
msgstr "ILS vous observent!"

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you should get back home."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can feel your heart racing, something is watching you."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel lost.  Painfully and irrevocably lost."
msgstr "Vous vous sentez perdu·e.  Terriblement et irrévocablement perdu·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You know someone is following you."
msgstr "Vous êtes sûr·e que quelqu'un vous suit."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel eyes on you, but see no one."
msgstr "Vous ressentez des yeux vous fixer, mais ne voyez rien."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Everyone is conspiring against you."
msgstr "Tout le monde conspire contre vous."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear whispers behind your back."
msgstr "Vous entendez des murmures derrière vous."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "They are trying to control your mind."
msgstr "Ils essayent de contrôler votre cerveau."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like a puppet on strings."
msgstr "Vous avez l'impression d'être un mannequin suspendu par des ficelles."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You suspect your food is poisoned."
msgstr "Vous soupçonnez que quelqu'un à empoisonné votre nourriture."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Every shadow hides an enemy."
msgstr "Chaque ombre cache un ennemi."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't trust anyone, not even yourself."
msgstr "Vous ne pouvez faire confiance à personne, même pas vous."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Someone is listening to your thoughts."
msgstr "Quelqu'un écoute vos pensées."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Your mind feels like it's being invaded."
msgstr "Votre crâne vous donne l'impression d'être infiltré."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear footsteps behind you, but see no one."
msgstr "Vous entendez des bruits de pas derrière vous, mais ne voyez rien."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're being hunted."
msgstr "Vous avez l'impression d'être traqué·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Your thoughts are not your own."
msgstr "Vos pensées ne vous appartiennent pas."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You sense danger around every corner."
msgstr "Vous avez l'impression que des dangers horribles sont derrière chaque coin."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're being watched constantly."
msgstr "Vous avez l'impression d'être sous surveillance constante."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear voices whispering secrets."
msgstr "Vous entendez des voix murmurer des secrets."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't shake the feeling of dread."
msgstr "Vous ne pouvez pas vous débarrasser d'un sentiment d'appréhension persistante."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're in a nightmare."
msgstr "Vous avez l'impression de vivre dans un cauchemar."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Every sound makes you jump."
msgstr "Chaque bruit vous fait tressailler."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like a target."
msgstr "Vous avez l'impression d'être ciblé·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't trust what you see."
msgstr "Vous ne pouvez pas faire confiance à ce que vous voyez."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel a presence behind you."
msgstr "Vous ressentez une présence derrière vous."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You sense something evil nearby."
msgstr "Vous ressentez quelque chose de malfaisant dans les environs."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Your paranoia is overwhelming."
msgstr "Votre paranoïa est accablante."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're going mad."
msgstr "Vous vous sentez devenir cinglé·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't escape the feeling of being watched."
msgstr "Vous n'arrivez pas à dissiper l'impression d'être observé·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're under surveillance."
msgstr "Vous avez l'impression d'être surveillé·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear faint whispers in your ear."
msgstr "Vous entendez des murmures ténus dans l'une de vos oreilles."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel trapped and isolated."
msgstr "Vous vous sentez pris·e au piège et isolé·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You sense an imminent threat."
msgstr "Vous avez l'impression qu'un danger imminent approche."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "Your mind is filled with fear."
msgstr "Votre crâne est inondé de peur."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're losing control."
msgstr "Vous avez l'impression de perdre contrôle."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You can't trust anyone's intentions."
msgstr "Vous ne pouvez faire confiance aux intentions de personne."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're being manipulated."
msgstr "Vous avez l'impression d'être manipulé·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You hear your name being called in the distance."
msgstr "Vous entendez quelqu'un vous appeler au loin."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You feel like you're being followed."
msgstr "Vous avez l'impression d'être suivi·e."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_paranoid"
msgid "You sense a malevolent force around you."
msgstr "Vous ressentez une force malveillante autour de vous."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You gain the sudden realization that you are the creator of the universe."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You increase all your skills to level 10."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You feel that this must be a global reality show, in which you are the star."
msgstr ""

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid ""
"You now know that you are a secret agent, kept alive to continue serving the "
"government."
msgstr ""
"Vous savez maintenant que vous êtes un agent secret, maintenu en vie pour "
"continuer à servir le gouvernement.\n"
" "

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You feel in full control of the situation."
msgstr "Vous vous sentez en plein contrôle de la situation."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You are the most important person in the world."
msgstr "Vous êtes la personne la plus importante de ce monde."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You have the power to change reality."
msgstr "Vous avez le pouvoir de changer votre réalité."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You are destined for greatness."
msgstr "Vous êtes destiné·e pour de grandes choses."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You are a god among mortals."
msgstr "Vous êtes un être divin parmi les mortels."

#: data/json/snippets/schizophrenia.json
#. ~ Snippet in category "schizo_delusion_grandiose"
msgid "You possess unlimited knowledge."
msgstr "Vous possédez un savoir sans limites."

