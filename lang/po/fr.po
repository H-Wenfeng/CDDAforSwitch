msgid_plural "electric hair trimmers"
msgstr[0] "tondeuse à cheveux électrique"
msgstr[1] "tondeuses à cheveux électriques"
msgstr[2] "tondeuses à cheveux électriques"

#: data/json/items/tool/toiletries.json
#. ~ Description of "electric hair trimmer"
msgid ""
"A pocket-sized electric trimmer made for cutting hair.  You can use it to cut "
"your hair if it's supplied with batteries.  It requires 1 unit of charge per "
"use."
msgstr ""
"Une tondeuse de poche conçue pour couper les cheveux et la barbe.  Consomme "
"10 unités de charge issues de batteries par utilisation."

#: data/json/items/tool/toiletries.json
#. ~ "description" action message of item "electric hair trimmer"
#. ~ "description" action message of item "makeshift haircut kit"
msgid "Trim your hair"
msgstr "Coupez vos cheveux"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "mop"
msgid_plural "mops"
msgstr[0] "balai"
msgstr[1] "balais"
msgstr[2] "balais"

#: data/json/items/tool/toiletries.json
#. ~ Description of "mop"
msgid ""
"An unwieldy mop.  Good for cleaning up spills.  Use to mop up any 'mess' you "
"may have made."
msgstr ""
"Une serpillière peu maniable. Pratique pour nettoyer les sols lisses et se "
"débarrasser de flaques et éclaboussures liquides. Activez-la pour nettoyer "
"des 'saletés' que vous auriez pu provoquer."

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "collapsible mop"
msgid_plural "collapsible mops"
msgstr[0] "serpillière pliable"
msgstr[1] "serpillières pliables"
msgstr[2] "serpillières pliables"

#: data/json/items/tool/toiletries.json
#. ~ Description of "collapsible mop"
msgid ""
"A long, unwieldy mop with a collapsible handle for convenient transportation. "
" You may use it to clean up any 'mess' you have made."
msgstr ""
"Une serpillière longue et peu maniable avec un manche pliable pour un "
"transport pratique. Vous pouvez l'utiliser pour nettoyer tout le \"désordre\" "
"que vous avez fait."

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "cotton patch"
msgid_plural "cotton patches"
msgstr[0] "carré de cotton"
msgstr[1] "carrés de cotton"
msgstr[2] "carrés de cotton"

#: data/json/items/tool/toiletries.json
#. ~ Description of "cotton patch"
msgid "A 6-inch square cotton patch, suitable for repairing and tailoring clothing."
msgstr ""
"Un carré de 15cm de côté de coton, convenable pour réparer ou fabriquer des "
"vêtements."

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "razor blade"
msgid_plural "razor blades"
msgstr[0] "lame de rasoir"
msgstr[1] "lames de rasoir"
msgstr[2] "lames de rasoir"

#: data/json/items/tool/toiletries.json
#. ~ Description of "razor blade"
msgid "A double-edged razor blade."
msgstr "Une lame de rasoir à double tranchant."

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "shaving kit"
msgid_plural "shaving kits"
msgstr[0] "kit de rasage"
msgstr[1] "kits de rasage"
msgstr[2] "kits de rasage"

#: data/json/items/tool/toiletries.json
#. ~ Description of "shaving kit"
msgid ""
"A compact, lightweight shaving kit made for travelers.  You can use it to "
"shave if it's supplied with soap.  It requires 1 unit of soap per use."
msgstr ""
"Un kit de rasage compact et léger conçu pour les voyageurs. Vous pouvez "
"l'utiliser pour vous raser s'il est fourni avec du savon. Il nécessite 1 "
"unité de savon par utilisation."

#: data/json/items/tool/toiletries.json
#. ~ "description" action message of item "shaving kit"
#. ~ "description" action message of item "makeshift shaving kit"
msgid "Trim your beard"
msgstr "Coupez votre barbe"

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "sponge"
msgid_plural "sponges"
msgstr[0] "éponge"
msgstr[1] "éponges"
msgstr[2] "éponges"

#: data/json/items/tool/toiletries.json
#. ~ Description of "sponge"
msgid ""
"A cleaning aid made of soft, porous material.  Typically used for cleaning "
"hard objects."
msgstr ""
"Un outil de nettoyage consistant de matériel souple et poreux typiquement "
"utilisé pour nettoyer des surfaces imperméables et rigides."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A round smiley-face sponge."
msgstr "Une éponge smiley ronde."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A rectangular sponge with a green abrasive back."
msgstr "Une éponge rectangulaire au dos vert abrasif."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A dolphin-shaped sponge.  It looks at home in the water."
msgstr "Une éponge en forme de dauphin ayant l'air à l'aise dans l'eau."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A rectangular sponge."
msgstr "Une éponge rectangulaire."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A sponge cake-shaped sponge, the abrasive pad looks like frosting."
msgstr "Une éponge en forme de gâteau, le tampon abrasif ressemble à du glaçage."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A sponge in the shape of a beloved character from a children's cartoon."
msgstr ""
"Une éponge ayant la forme d'un personnage bien-aimé d'un dessin animé pour "
"enfants."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "sponge"
msgid "A cat-shaped sponge."
msgstr "Une éponge en forme de chat."

#: data/json/items/tool/toiletries.json
#. ~ Item name
msgid "makeshift haircut kit"
