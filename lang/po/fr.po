#: data/json/effects.json
#. ~ Name of effect type id "bad_food_ennui"
msgid "Gross Food"
msgstr "Nourriture Répugnante"

#: data/json/effects.json
#. ~ Name of effect type id "bad_food_ennui"
msgid "Demoralizing Food"
msgstr "Nourriture Démoralisante"

#: data/json/effects.json
#. ~ Name of effect type id "bad_food_ennui"
msgid "Depressing Food"
msgstr "Nourriture Très Démoralisante"

#: data/json/effects.json
#. ~ Description of effect type "Gross Food"
msgid "The food you eat is disgusting."
msgstr "La nourriture que vous mangez est infâme."

#: data/json/effects.json
#. ~ Description of effect type "Demoralizing Food"
msgid "Eating nothing but disgusting rations is starting to get you down."
msgstr ""
"Ne manger rien que de la nourriture infâme commence à sérieusement plomber "
"votre moral."

#: data/json/effects.json
#. ~ Description of effect type "Depressing Food"
msgid ""
"Sure, you survived, but what kind of survival is this, eating these "
"disgusting rations day in and day out?"
msgstr ""
"Sûr vous êtes toujours en vie, mais quelle sorte de survie force quelqu'un à "
"manger toute cette nourriture infâme tous les jours?"

#: data/json/effects.json
#. ~ Name of effect type id "hypovolemia"
msgid "Mild Hypovolemic Shock"
msgstr "Choc Hypovolémique Bénin"

#: data/json/effects.json
#. ~ Name of effect type id "hypovolemia"
msgid "Moderate Hypovolemic Shock"
msgstr "Choc Hypovolémique Modéré"

#: data/json/effects.json
#. ~ Name of effect type id "hypovolemia"
msgid "Advanced Hypovolemic Shock"
msgstr "Choc Hypovolémique Avancé"

#: data/json/effects.json
#. ~ Name of effect type id "hypovolemia"
msgid "Severe Hypovolemic Shock"
msgstr "Choc Hypovolémique Grave"

#: data/json/effects.json
#. ~ Description of effect type "Mild Hypovolemic Shock"
msgid "You've lost some blood and look somewhat pale."
msgstr "Vous avez perdu du sang et avez l'air pale."

#: data/json/effects.json
#. ~ Description of effect type "Moderate Hypovolemic Shock"
msgid "You've lost a large amount of blood, and you're not feeling well."
msgstr ""
"Vous avez perdu une quantité volumineuse de sang et vous ne vous sentez pas "
"très bien."

#: data/json/effects.json
#. ~ Description of effect type "Advanced Hypovolemic Shock"
msgid ""
"You've lost an awful lot of blood, and your condition is severe.  Seek "
"medical attention."
msgstr ""
"Vous avez perdu une grande quantité de sang, votre condition est inquiétante "
"et requiert des soins médicaux urgents."

#: data/json/effects.json
#. ~ Description of effect type "Severe Hypovolemic Shock"
msgid ""
"You've lost tremendous amount of blood, and you're standing on death's door.  "
"Saline infusion might save you."
msgstr ""

#: data/json/effects.json
#. ~ Apply message of effect type "Mild Hypovolemic Shock, Moderate
#. Hypovolemic Shock, Advanced Hypovolemic Shock, Severe Hypovolemic Shock"
msgid "You have lost a lot of blood, and your condition worsens."
msgstr "Vous avez perdu beaucoup de sang, et votre condition se détériore."

#: data/json/effects.json
#. ~ Remove message of effect type "Mild Hypovolemic Shock, Moderate
#. Hypovolemic Shock, Advanced Hypovolemic Shock, Severe Hypovolemic Shock"
msgid "You are no longer in shock."
msgstr "Vous n'êtes plus en état de choc."

#: data/json/effects.json
#. ~ Decay message of effect type "Mild Hypovolemic Shock, Moderate
#. Hypovolemic Shock, Advanced Hypovolemic Shock, Severe Hypovolemic Shock"
msgid "Your blood volume increases, and you feel better; but still, you look pale."
msgstr "Votre volume de sang augment, et vous vous sentez mieux, mais un peu pale."

#: data/json/effects.json
#. ~ Decay message of effect type "Mild Hypovolemic Shock, Moderate
#. Hypovolemic Shock, Advanced Hypovolemic Shock, Severe Hypovolemic Shock"
msgid "You feel stronger as your blood volume starts to improve."
msgstr "Vous vous sentez mieux dû à votre volume de sang commençant à se normaliser."

#: data/json/effects.json
#. ~ Decay message of effect type "Mild Hypovolemic Shock, Moderate
#. Hypovolemic Shock, Advanced Hypovolemic Shock, Severe Hypovolemic Shock"
msgid "You're not dying from lack of blood, but you're not out of the woods yet."
msgstr ""
"Vous n'être pas sur le point de mourir de manque de sang, mais vous n'êtes "
"pas non plus en parfaite forme."

#: data/json/effects.json
#. ~ Name of effect type id "haslight"
msgid "Lit Up"
msgstr "Éclairé"

#: data/json/effects.json
#. ~ Description of effect type "Lit Up"
msgid "You are carrying a light and can't hide well."
msgstr ""
"Vous avez une source de lumière sur vous, ceci rends la tâche de bien se "
"cacher assez difficile."

#: data/json/effects.json
#. ~ Name of effect type id "mending"
msgid "Started Recovery"
msgstr "Commence À Guérir"

#: data/json/effects.json
#. ~ Name of effect type id "mending"
msgid "Recovering"
msgstr "En voie de rétablissement"

#: data/json/effects.json
#. ~ Name of effect type id "mending"
msgid "Mostly Recovered"
msgstr "Quasiment Guéri"

#: data/json/effects.json
#. ~ Description of effect type "Started Recovery, Recovering, Mostly
#. Recovered"
msgid "This damaged limb is slowly regaining its functions."
msgstr "Ce membre endommagé est en train de regagner sa fonction."

#: data/json/effects.json
#. ~ Description of effect type "Disabled"
msgid "This limb is damaged beyond use and may require a splint to recover."
msgstr ""
"Ce membre a été suffisamment endommagé pour être maintenant inutile et aura "
"peut être besoin d'une attelle pour guérir plus vite."

#: data/json/effects.json data/json/snippets/schizophrenia.json
#. ~ Apply message of effect type "Disabled"
#. ~ Snippet in category "broken_limb"
msgid "Your limb breaks!"
msgstr "Votre membre ce brise"

#: data/json/effects.json
#. ~ Remove message of effect type "Disabled"
msgid "The broken limb has mended."
msgstr "Ce membre brisé s'est guéri."

#: data/json/effects.json
#. ~ Name of effect type id "pkill"
msgid "Painkillers"
msgstr "Anti-douleurs"

#: data/json/effects.json
#. ~ Description of effect type "Painkillers"
msgid ""
"You are under the influence of analgesic substances to relieve pain, but they "
"may numb you a bit."
msgstr ""
"Vous êtes sous l'influence de substances analgésiques capable de lutter "
"contre la douleur, mais ceci peut avoir un effet négatif sur vos réflexes et "
"votre mouvement."

#: data/json/effects.json
#. ~ Blood analysis description of effect type "Painkillers"
msgid "Painkiller"
msgstr "Anti-douleurs"

#: data/json/effects.json
#. ~ Name of effect type id "happy"
msgid "Happy"
msgstr "Content"

#: data/json/effects.json
#. ~ Name of effect type id "happy"
msgid "Joyful"
msgstr "Joyeux"

#: data/json/effects.json
#. ~ Name of effect type id "happy"
msgid "Elated"
msgstr "Exalté"

#: data/json/effects.json
#. ~ Description of effect type "Happy, Joyful, Elated"
msgid "Life is good."
msgstr "La vie est belle."

#: data/json/effects.json
#. ~ Description of effect type "Happy, Joyful, Elated"
msgid "Oh what a day!  What a lovely day!"
msgstr "Oh quelle journée! Quelle belle journée!"

#: data/json/effects.json
#. ~ Description of effect type "Happy, Joyful, Elated"
msgid "I'm on top of the world, baby!"
msgstr "Je suis au sommet du monde, bébé!"

#: data/json/effects.json
#. ~ Name of effect type id "sad"
msgid "Unhappy"
msgstr "Mécontent(e)"

#: data/json/effects.json
#. ~ Name of effect type id "sad"
msgid "Sad"
msgstr "Triste"

#: data/json/effects.json
#. ~ Name of effect type id "sad"
msgid "Depressed"
msgstr "Déprimé"

#: data/json/effects.json
#. ~ Description of effect type "Unhappy, Sad, Depressed"
msgid "You are not content with your life."
msgstr "Vous n'êtes pas content·e avec votre vie récente."

#: data/json/effects.json
#. ~ Description of effect type "Unhappy, Sad, Depressed"
msgid "This is not what you planned for your life."
msgstr "Ce n'est pas ce que vous aviez prévu pour votre vie."

#: data/json/effects.json
#. ~ Description of effect type "Unhappy, Sad, Depressed"
msgid "You wonder what's the point of fighting?"
msgstr ""

#: data/json/effects.json
#. ~ Description of effect type "Unhappy, Sad, Depressed"
msgid "When will all your suffering end?"
msgstr "Quand toutes vos souffrances finiront-elles?"

#: data/json/effects.json
#. ~ Miss message of effect type "Unhappy, Sad, Depressed"
msgid "You dejectedly consider the pointlessness of it all."
msgstr ""

#: data/json/effects.json data/mods/Xedra_Evolved/effects/effects.json
#. ~ Name of effect type id "irradiated"
#. ~ Name of effect type id "effect_weakening"
msgid "Weakness"
msgstr "Faiblesse"

#: data/json/effects.json
#. ~ Blood analysis description of effect type "Weakness"
msgid "Irradiated"
msgstr "Irradié"

#: data/json/effects.json
#. ~ Description of effect type "Stimulants"
msgid "You're very jittery and pumped up, probably from some stimulants."
msgstr ""
"Vous êtes une boule de nerfs surexcitée, ceci étant probablement causé par la "
"consommation d'un stimulant."

#: data/json/effects.json
#. ~ Name of effect type id "depressants"
#. ~ Blood analysis description of effect type "Depressants"
msgid "Depressants"
msgstr "Dépresseurs"

#: data/json/effects.json
#. ~ Description of effect type "Depressants"
msgid "You are under the influence of depressants, and in a bit of a daze."
msgstr "Vous êtes sous l'influence de dépresseurs et vous vous sentez un peu hébété."

#: data/json/effects.json
#. ~ Name of effect type id "stim_overdose"
msgid "Stimulant Overdose"
msgstr "Overdose de stimulants"

#: data/json/effects.json
#. ~ Description of effect type "Stimulant Overdose"
msgid ""
"You can't sit still as you feel your heart pounding out of your chest.  You "
"probably overdosed on those stims."
msgstr ""
"Vous ne pouvez pas rester immobile pendant que votre cœur bat la chamade. "
"Vous avez probablement fait une surdose de stimulants."

#: data/json/effects.json
#. ~ Miss message of effect type "Stimulant Overdose"
msgid "You shake with the excess stimulation."
msgstr "La stimulation excessive vous fait trembler."

#: data/json/effects.json
#. ~ Name of effect type id "weak_antibiotic_visible"
msgid "Took Weak Antibiotic"
msgstr "A pris des antibiotiques faibles"

#: data/json/effects.json
#. ~ Description of effect type "Took Weak Antibiotic"
msgid ""
"You consumed mild antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Vous avez consommé un antibiotique léger il y a quelque temps pour lutter "
"contre l'infection.\n"
"Si vous ne récupérez pas, vous voudrez peut-être prendre une autre dose, mais "
"prenez garde au surdosage."

#: data/json/effects.json
#. ~ Name of effect type id "antibiotic_visible"
msgid "Took Antibiotic"
msgstr "A pris des antibiotiques"

#: data/json/effects.json
#. ~ Description of effect type "Took Antibiotic"
msgid ""
"You consumed antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Vous avez consommé des antibiotiques il y a quelque temps pour lutter contre "
"l'infection.\n"
"Si vous ne récupérez pas, vous voudrez peut-être prendre une autre dose, mais "
"prenez garde au surdosage."

#: data/json/effects.json
#. ~ Name of effect type id "strong_antibiotic_visible"
msgid "Took Strong Antibiotic"
msgstr "A pris des antibiotiques puissants"

#: data/json/effects.json
#. ~ Description of effect type "Took Strong Antibiotic"
msgid ""
"You consumed prescription-grade antibiotic some time ago to fight off "
"infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Il y a quelque temps, vous avez utilisé un antibiotique d'ordonnance pour "
"lutter contre les infections bactériennes.\n"
"Si vous ne récupérez pas, vous voudrez peut-être prendre une autre dose, mais "
"prenez garde au surdosage."

#: data/json/effects.json
#. ~ Blood analysis description of effect type "weak_antibiotic"
#. ~ Blood analysis description of effect type "antibiotic"
#. ~ Blood analysis description of effect type "strong_antibiotic"
msgid "Antibiotics"
msgstr "Antibiotiques"

#: data/json/effects.json
#. ~ Name of effect type id "panacea"
msgid "Panacea"
msgstr "Panacée"

#: data/json/effects.json
#. ~ Description of effect type "Panacea"
msgid "You feel incredible!  You could take on the world!"
msgstr ""
"Vous vous sentez fantastique! Comme si vous pouviez vous battre contre le "
"monde entier et gagner!"

#: data/json/effects.json
#. ~ Name of effect type id "tummy_tablet"
msgid "Soothed Stomach"
msgstr "Estomac Apaisé"

#: data/json/effects.json
#. ~ Description of effect type "Soothed Stomach"
msgid "You are under the effects of a stomach soother."
msgstr "Vous êtes affecté(e) par les effets d'une substance apaisant votre estomac."

#: data/json/effects.json
#. ~ Name of effect type id "antifungal"
#. ~ Blood analysis description of effect type "Antifungals"
msgid "Antifungals"
msgstr "Antifongiques"

#: data/json/effects.json
#. ~ Description of effect type "Antifungals"
msgid "You are under the effects of an antifungal medicine or chemicals."
msgstr "Vous êtes sous l'influence de produits chimiques ou médicaments antifongiques."

#: data/json/effects.json
#. ~ Name of effect type id "emp"
msgid "Discharge"
msgstr "Électrocuté"

#: data/json/effects.json
#. ~ Description of effect type "Discharge"
msgid "You've been recently affected by an electromagnetic pulse."
msgstr "Vous avez récemment subi(e) les effets d'une onde de choc IEM."

#: data/json/effects.json
#. ~ Name of effect type id "supercharged"
msgid "Supercharged"
msgstr "Hyperchargé"

#: data/json/effects.json
#. ~ Description of effect type "Supercharged"
msgid "You've been struck by lightning, and feel… different."
msgstr "Vous avez été frappé(e) par la foudre et vous vous sentez… différent(e)."

#: data/json/effects.json
#. ~ Name of effect type id "pd_str_bad"
msgid "Muscle Vanishment"
msgstr "Disparition Musculaire"

#: data/json/effects.json
#. ~ Name of effect type id "pd_str_bad"
msgid "Muscle Disappearance"
msgstr "Affaiblissement Musculaire"

#: data/json/effects.json
#. ~ Description of effect type "Muscle Vanishment"
msgid "You feel as if your muscles are not quite there."
msgstr ""
"Vous avez l'impression que vos muscles ne sont pas totalement présents dans "
"cette réalité."

#: data/json/effects.json
#. ~ Description of effect type "Muscle Disappearance"
msgid "You feel as if your muscles are not in your body."
msgstr "Vous avez l'impression que vos muscles ne sont plus dans votre corps."

#: data/json/effects.json
#. ~ Miss message of effect type "Muscle Vanishment, Muscle Disappearance"
msgid "Your lack of strength stops you!"
msgstr "Votre manque de force vous empêche de faire ceci!"

#: data/json/effects.json
#. ~ Name of effect type id "pd_dex_bad"
msgid "Weak Grasp"
msgstr "Préhension Faible"

#: data/json/effects.json
#. ~ Name of effect type id "pd_dex_bad"
msgid "Inexistent Grasp"
msgstr "Préhension Inexistante"

#: data/json/effects.json
#. ~ Description of effect type "Weak Grasp"
msgid "You seem to have problems touching things."
msgstr "Vous semblez avoir des problèmes à vraiment toucher les choses."

#: data/json/effects.json
#. ~ Description of effect type "Inexistent Grasp"
msgid "You feel as if your hands just pass through matter."
msgstr "Vous avez l'impression que vos mains ne font que passer à travers la matière."

#: data/json/effects.json
#. ~ Miss message of effect type "Weak Grasp, Inexistent Grasp"
msgid "Your attacks don't seem to touch your enemies!"
msgstr ""
"Vos attaques n'ont pas l'air de toucher vos ennemis, passant à travers sans "
"aucun dégât!"

#: data/json/effects.json
#. ~ Name of effect type id "pd_per_bad"
msgid "Distorted Vision"
msgstr "Vision Distordue"

#: data/json/effects.json
#. ~ Name of effect type id "pd_per_bad"
msgid "Otherworldly Vision"
msgstr "Vision Surréaliste"

#: data/json/effects.json
#. ~ Description of effect type "Distorted Vision"
msgid "You have problems distinguishing shapes and colors."
msgstr "Vous avez des problèmes à distinguer les formes et les couleurs."

#: data/json/effects.json
#. ~ Description of effect type "Otherworldly Vision"
msgid "You seem to see slightly different realities every time you blink."
msgstr ""
"Vous avez l'impression d'ouvrir les yeux sur une réalité légèrement "
"différente à chaque fois que vous clignez des yeux."

#: data/json/effects.json
#. ~ Miss message of effect type "Distorted Vision, Otherworldly Vision"
msgid "You can't distinguish up from down!"
msgstr "Vous n'arrivez plus à distinguer le haut du bas!"

#: data/json/effects.json
#. ~ Name of effect type id "pd_int_bad"
msgid "Wandering Mind"
msgstr "Intellect Voyageur"

#: data/json/effects.json
#. ~ Name of effect type id "pd_int_bad"
msgid "Foreign Mind"
msgstr "Intellect Étrange"

#: data/json/effects.json
#. ~ Description of effect type "Wandering Mind"
msgid "Your thoughts seem to wander around on their own."
msgstr "Vos pensées ont l'air de se balader de leur propre grès."

#: data/json/effects.json
#. ~ Description of effect type "Foreign Mind"
msgid "Foreign thoughts seem to invade your mind."
msgstr ""
"Des pensées ayant l'air d'appartenir à une autre personne envahissent votre "
"esprit."

#: data/json/effects.json
#. ~ Miss message of effect type "Wandering Mind, Foreign Mind"
msgid "You suddenly think you shouldn't do that!"
msgstr "Vous avez soudainement l'impression que vous ne devriez pas faire ceci!"

#: data/json/effects.json
#. ~ Name of effect type id "pd_rejection"
msgid "World Rejection"
msgstr "Rejeté(e) par le Monde"

#: data/json/effects.json
#. ~ Name of effect type id "pd_rejection"
msgid "Dimensional Rejection"
msgstr "Réjection Dimensionnelle"

#: data/json/effects.json
#. ~ Description of effect type "World Rejection"
msgid ""
"Faint sparks surround your every move, your body aches more with every "
"passing second."
msgstr ""
"Chacun de vos mouvements et suivi de faibles étincelles, votre corps souffre "
"de plus en plus avec chaque seconde qui passe."

#: data/json/effects.json
#. ~ Description of effect type "Dimensional Rejection"
msgid ""
"Sparks swarm around you, your body hurts and even the air seems to reject "
"your existence."
msgstr ""
"Des étincelles vous entourent, votre corps souffre et même l'air autour de "
"vous donne l'impression de rejeter votre existence."

#: data/json/effects.json
#. ~ Remove message of effect type "World Rejection, Dimensional Rejection"
msgid ""
"The world is no longer trying to eject you from this plane of existence, for "
"now."
msgstr "Le monde n’essaie plus de vous éjecter de ce plan d’existence, pour le moment."

#: data/json/effects.json
#. ~ Decay message of effect type "World Rejection, Dimensional Rejection"
msgid "The rejection you feel from all around you has become a little easier to bear."
msgstr ""
"Le rejet que vous ressentez partout autour de vous est devenu un peu plus "
"facile à supporter."

#: data/json/effects.json
#. ~ Name of effect type id "pd_strengthened_reality"
msgid "World's Acceptance"
msgstr "Acceptation du monde"

#: data/json/effects.json
#. ~ Name of effect type id "pd_strengthened_reality"
msgid "World's Embracement"
msgstr "Enlacement Du Monde"

#: data/json/effects.json
#. ~ Name of effect type id "pd_strengthened_reality"
msgid "Dimensional Foothold"
msgstr "Ancrage Dimensionnel"

#: data/json/effects.json
#. ~ Name of effect type id "pd_strengthened_reality"
msgid "Dimensional Assimilation"
msgstr "Assimilation Dimensionnelle"

#: data/json/effects.json
#. ~ Description of effect type "World's Acceptance"
msgid "The world around you seems calmer with your presence and actions."
msgstr ""
"Le monde autour de vous semble plus calme vis-à-vis de votre présence et "
"actions."

#: data/json/effects.json
#. ~ Description of effect type "World's Embracement"
msgid ""
"The world around you seems to regard you as one of their own, your body is a "
"little easier to move now."
msgstr ""
"Le monde autour de vous semble vous considérer comme l'un des leurs. Votre "
"corps a plus de facilité à bouger maintenant."

#: data/json/effects.json
#. ~ Description of effect type "Dimensional Foothold"
msgid ""
"You can more easily exert your will around you, this dimension is, if not "
"welcoming you, obeying you a little.  You have managed to secure a foothold "
"in this reality."
msgstr ""
"Vous pouvez exercer votre volonté autour de vous ; cette dimension vous obéit "
"quelque peu, voire vous accepte."

#: data/json/effects.json
#. ~ Description of effect type "Dimensional Assimilation"
msgid ""
"The very fabric of reality is blending in with your body, your will is "
"greatly easier to exert around you and your body is trying to permanently "
"assimilate with this world, it just needs a little push…"
msgstr ""
"Le tissu même de la réalité se fond dans votre corps, votre volonté est "
"beaucoup plus facile à exercer autour de vous et votre corps essaie de "
"s'assimiler en permanence à ce monde, il a juste besoin d'un petit coup de "
"pouce…"

#: data/json/effects.json
#. ~ Apply message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "Your eyes open to a whole new world!"
msgstr "Vos yeux s'ouvrent sur une réalité inédite!"

#: data/json/effects.json
#. ~ Remove message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "You start to feel rejected by the world again."
msgstr "Vous commencez de nouveau à vous sentir rejeté par le monde. "

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "Did the world just oppose you?"
msgstr "Le monde ne viendrait pas de s'opposer à vous ?"

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "For a moment you felt a great hostility all around you."
msgstr "Pendant quelques instants, vous ressentez une grande hostilité tout autour."

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "Did your enemy just vanish for a moment?"
msgstr "Votre ennemi n'a-t-il pas disparu pendant quelques instants ?"

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "You felt weird for a moment."
msgstr "Vous vous êtes senti bizarre pendant un moment."

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "Was that a spark?"
msgstr "Était-ce une étincelle ?"

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "Your grip suddenly failed you."
msgstr "Votre emprise sur la réalité s'est soudainement relâchée. "

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "Something just flashed in front of your eyes."
msgstr "Quelque chose a flashé devant vos yeux."

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "Why did the hit go that way?"
msgstr "Pourquoi le coup est parti comme ça ?"

#: data/json/effects.json
#. ~ Miss message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid "You could swear that you hit it!"
msgstr "Vous juriez que vous l'avez touché !"

#: data/json/effects.json
#. ~ Decay message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid ""
"The world no longer embraces you as its child.  At least it still tolerates "
"your presence."
msgstr ""
"Le monde ne vous considère plus comme son protégé. Au moins, il tolère "
"toujours votre présence."

#: data/json/effects.json
#. ~ Decay message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid ""
"You have lost your foothold and can no longer command the world around you, "
"the world sees you now as only an unruly child."
msgstr ""
"Vous avez perdu votre emprise, et ne pouvez plus contrôler le monde autour de "
"vous ; le monde vous voit comme un enfant turbulent."

#: data/json/effects.json
#. ~ Decay message of effect type "World's Acceptance, World's Embracement,
#. Dimensional Foothold, Dimensional Assimilation"
msgid ""
"You can no longer bend the world to your will.  You have failed in blending "
"in with this reality and have now only a foothold left."
msgstr ""
"Vous ne pouvez plus soumettre le monde à votre volonté. Vous n'avez pas "
"réussi à vous intégrer dans cette réalité, et n'y avez plus qu'un pied dans "
"la porte."

#: data/json/effects.json
#. ~ Name of effect type id "migo_atmosphere"
msgid "Stinking Air"
msgstr "Air Nauséabond"

#: data/json/effects.json
#. ~ Name of effect type id "migo_atmosphere"
msgid "Disorienting Air"
msgstr "Air Désorientant"

#: data/json/effects.json
#. ~ Name of effect type id "migo_atmosphere"
msgid "Smothering Air"
msgstr "Air Étouffant"

#: data/json/effects.json
#. ~ Description of effect type "Stinking Air"
msgid "The air in here smells like vinegar and mold."
msgstr "L'air ici à une odeur ressemblant au vinaigre et à la moisissure."

#: data/json/effects.json
#. ~ Description of effect type "Disorienting Air"
msgid ""
"The air in here smells like vinegar and mold.  It makes you feel soft-headed "
"and confused."
msgstr ""
"L'air ici à une odeur ressemblant au vinaigre et à la moisissure, "
"étourdissant vos sens et rendant vos pensées confuses."

#: data/json/effects.json
#. ~ Description of effect type "Smothering Air"
msgid ""
"The air in here smells like vinegar and mold.  It is closing in and "
"smothering you, making it impossible to think clearly."
msgstr ""
"L'air ici à une odeur ressemblant au vinaigre et à la moisissure, tellement "
"épais qu'il vous étouffe et oppresse vos pensées."

#: data/json/effects.json
#. ~ Apply message of effect type "Stinking Air, Disorienting Air, Smothering
#. Air"
msgid "The air in here smells like vinegar and mold, and hurts your lungs a bit."
msgstr ""
"L'air ici à une odeur ressemblant au vinaigre et à la moisissure et irrite "
"vos poumons un peu."

#: data/json/effects.json
#. ~ Miss message of effect type "Stinking Air, Disorienting Air, Smothering
#. Air"
msgid "You feel groggy in this sweltering, foul air."
msgstr "Vous vous sentez étourdi(e) dans cet air nauséabond et torride."

#: data/json/effects.json
#. ~ Name of effect type id "fetid_goop"
msgid "Covered in Fetid Goop"
msgstr "Couvert(e) de Bouillie Fétide"

#: data/json/effects.json
#. ~ Description of effect type "Covered in Fetid Goop"
msgid ""
"The feeling of the goop slowly sliding on your skin revulses you and the "
"smell makes you gag."
msgstr ""
"La sensation de la bouillie glissant sur votre peau vous révulse et l'odeur "
"vous donne des haut-le-cœur."

#: data/json/effects.json
#. ~ Apply message of effect type "Covered in Fetid Goop"
msgid "You're disgusted by the goop."
msgstr "La bouillie vous dégoûte."

#: data/json/effects.json
#. ~ Name of effect type id "incorporeal"
msgid "Incorporeal"
msgstr "Incorporel"

#: data/json/effects.json
#. ~ Description of effect type "Incorporeal"
msgid "You lack substance, as if you aren't quite fully here."
msgstr ""
"Vous manquez de substance, comme si vous faisiez pas totalement partie de ce "
"monde."

#: data/json/effects.json
#. ~ Name of effect type id "weary_1"
msgid "Lightly Weary"
msgstr "Légèrement fatigué"

#: data/json/effects.json
#. ~ Description of effect type "Lightly Weary"
msgid ""
"You've been pretty active for a while; operating at the highest levels of "
"activity will be impaired.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 1.25x"
msgstr ""
"Vous avez été assez actif/active pour un bon moment. Participer aux activités "
"les plus intenses vous sera maintenant plus difficile.\n"
"Les malus de mouvement suivants seront appliqués aux niveaux d'activité "
"suivants:\n"
"Extrême: 1.25x"

#: data/json/effects.json
#. ~ Name of effect type id "weary_2"
msgid "Moderately Weary"
msgstr "Moyennement fatigué"

#: data/json/effects.json
#. ~ Description of effect type "Moderately Weary"
msgid ""
"You've been quite active for a while; operating at higher levels of activity "
"will be impaired.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 1.67x, Active: 1.33x"
msgstr ""
"Vous avez été actif/active pour un bon moment. Participer aux activités les "
"plus intenses vous sera maintenant plus difficile.\n"
"Les malus de mouvement suivants seront appliqués aux niveaux d'activité "
"suivants:\n"
"Extrême: 1.67x, Actif: 1.33x"

#: data/json/effects.json data/json/ui/sidebar-legacy-labels-narrow.json
#: data/json/ui/zenfs/health.json
#. ~ Name of effect type id "weary_3"
#. ~ Label of UI widget "ln_weariness_desc"
#. ~ Label of UI widget "zenfs_weariness_num"
msgid "Weary"
msgstr "Fatigue"

#: data/json/effects.json
#. ~ Description of effect type "Weary"
msgid ""
"You've been very active for a while, and need to slow down for a bit.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 2.5x, Active: 2x, Brisk: 1.5x"
msgstr ""
"Vous avez été très actif/active pour un bon moment et avez besoin de faire "
"une pause pour un moment. Participer aux activités intenses vous sera "
"maintenant plus difficile.\n"
"Les malus de mouvement suivants seront appliqués aux niveaux d'activité "
"suivants:\n"
"Extrême: 2.5x, Haut: 2x, Tonique: 1.5x"

#: data/json/effects.json
#. ~ Name of effect type id "weary_4"
msgid "Very Weary"
msgstr "Très fatigué"

#: data/json/effects.json
#. ~ Description of effect type "Very Weary"
msgid ""
"You've been extremely active for a while, and need to slow down.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 5x, Active: 4x, Brisk: 3x, Moderate: 2x"
msgstr ""
"Vous avez été extrêmement actif/active pour un bon moment et avez vraiment "
"besoin de faire une pause pour un moment. Participer aux activités intenses "
"vous sera maintenant plus difficile.\n"
"Les malus de mouvement suivants seront appliqués aux niveaux d'activité "
"suivants:\n"
"Extrême: 5x, Haut: 4x, Tonique: 3x, Modéré: 2x"

#: data/json/effects.json
#. ~ Name of effect type id "weary_5"
#. ~ Name of effect type id "weary_6"
#. ~ Name of effect type id "weary_7"
#. ~ Name of effect type id "weary_8"
msgid "Extremely Weary"
msgstr "Extrêmement fatigué"

#: data/json/effects.json
#. ~ Description of effect type "Extremely Weary"
msgid ""
"You've been extremely active for a while, and can't take much more activity.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Vous avez été extrêmement actif/active pour un bon moment et il sera "
"compliqué de forcer votre corps à donner plus d'effort.\n"
"Les malus de mouvement suivants seront appliqués aux niveaux d'activité "
"suivants:\n"
"Extrême: 10x, Haut: 8x, Tonique: 6x, Modéré: 4x, Léger: 2x"

#: data/json/effects.json
#. ~ Description of effect type "Extremely Weary"
msgid ""
"You've been extremely active for a while, and really need to get some rest.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Vous avez été extrêmement actif/active pour un bon moment et avez vraiment "
"besoin de donner du repos à votre corps.\n"
"Les malus de mouvement suivants seront appliqués aux niveaux d'activité "
"suivants:\n"
"Extrême: 10x, Haut: 8x, Tonique: 6x, Modéré: 4x, Léger: 2x"

#: data/json/effects.json
#. ~ Description of effect type "Extremely Weary"
msgid ""
"You've been extremely active for a while; it's time to stop.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Vous avez été extrêmement actif/active pour un bon moment, vous tenez à peine "
"debout et il est temps de s'arrêter.\n"
"Les malus de mouvement suivants seront appliqués aux niveaux d'activité "
"suivants:\n"
"Extrême: 10x, Haut: 8x, Tonique: 6x, Modéré: 4x, Léger: 2x"

#: data/json/effects.json
#. ~ Description of effect type "Extremely Weary"
msgid ""
"You've been extremely active for a while, and can no longer keep pushing.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Vous avez été extrêmement actif/active pour un bon moment, vous tenez à peine "
"debout et n'êtes plus capable de donner quoi que ce soit.\n"
"Les malus de mouvement suivants seront appliqués aux niveaux d'activité "
"suivants:\n"
"Extrême: 10x, Haut: 8x, Tonique: 6x, Modéré: 4x, Léger: 2x"

#: data/json/effects.json
#. ~ Description of effect type "Full"
#. ~ Apply message of effect type "Full"
msgid "You feel quite full, and a bit sluggish."
msgstr ""
"Votre estomac est plein, peut être qu'une sieste digestive serait une bonne "
"idée?"

#: data/json/effects.json
#. ~ Description of effect type "Engorged"
#. ~ Apply message of effect type "Engorged"
msgid "Your stomach is full to bursting.  This was a mistake."
msgstr ""
"Votre estomac est plein au point d'être douloureux.  Vous auriez dû penser "
"deux fois avant d'avaler ça."

#: data/json/effects.json
#. ~ Name of effect type id "weakened_inertia"
#. ~ Name of effect type id "strengthened_inertia"
msgid "Weakened Inertia"
msgstr "Inertie Affaiblie"

#: data/json/effects.json
#. ~ Description of effect type "Weakened Inertia"
msgid "Your body moves strangely easily, as if it weighted less."
msgstr "Votre corps se déplace étrangement facilement, comme s'il pesait moins."

#: data/json/effects.json
#. ~ Apply message of effect type "Weakened Inertia"
msgid "Your inertia itself is damaged, but the outcome seems suspiciously beneficial."
msgstr ""
"Votre inertie elle-même est endommagée, mais le résultat semble étrangement "
"bénéfique."

#: data/json/effects.json
#. ~ Remove message of effect type "Weakened Inertia"
msgid "Reality reasserts itself and your inertia returns to normal."
msgstr "La réalité reprend ses droits et votre inertie revient à la normale."

#: data/json/effects.json
#. ~ Description of effect type "Weakened Inertia"
msgid "Your body is strangely difficult to move, as if it weighted more."
msgstr "Votre corps est étrangement difficile a bouger, comme s'il était plus lourd."

#: data/json/effects.json
#. ~ Apply message of effect type "Weakened Inertia"
msgid "Your inertia itself is damaged, but hopefully it's not permanent yet."
msgstr ""
"Votre inertie elle-même est endommagée, espérons que ce n'est pas encore "
"permanent."

#: data/json/effects.json
#. ~ Name of effect type id "warped_viewpoint"
msgid "Warped Viewpoint"
msgstr "Perspective Déformée"

#: data/json/effects.json
#. ~ Description of effect type "Warped Viewpoint"
msgid ""
"Space is warped around you such that you can see a wider arc and as if "
"everything was closer."
msgstr ""
"L'espace est déformé autour de vous de manière à ce que vous puissiez voir un "
"arc plus large et comme si tout était plus proche."

#: data/json/effects.json
#. ~ Apply message of effect type "Warped Viewpoint"
msgid ""
"Space around you is damaged but in the process your can see more and more "
"easily than before."
msgstr ""
"L'espace autour de vous est endommagé, mais ce faisant, vous pouvez voir de "
"plus en plus facilement qu'auparavant."

#: data/json/effects.json
#. ~ Remove message of effect type "Warped Viewpoint"
#. ~ Remove message of effect type "Narrowed Viewpoint"
msgid "Reality reasserts itself and your perspective returns to normal."
msgstr "La réalité se réaffirme et votre perspective revient à la normale."

#: data/json/effects.json
#. ~ Name of effect type id "narrow_viewpoint"
msgid "Narrowed Viewpoint"
msgstr "Perspective Rétrécie"

#: data/json/effects.json
#. ~ Description of effect type "Narrowed Viewpoint"
msgid ""
"Space is warped around you such that you can see less and as if everything "
"was farther away."
msgstr ""
"L'espace est déformé autour de vous de telle sorte que vous pouvez voir "
"moins, comme si tout était plus loin qu'en vérité."

#: data/json/effects.json
#. ~ Apply message of effect type "Narrowed Viewpoint"
msgid "Space around you is damaged narrowing your perspective."
msgstr "L'espace autour de vous est endommagé, ce qui réduit votre perspective."

#: data/json/effects.json
#. ~ Name of effect type id "weakened_gravity"
msgid "Weakened Gravity"
msgstr "Gravité Affaiblie"

#: data/json/effects.json
#. ~ Description of effect type "Weakened Gravity"
msgid ""
"Something is wrong with local spacetime and everything near you seems to "
"weigh less."
msgstr ""
"Quelque chose ne va pas avec l'espace-temps local et tout autour de vous à "
"l'air de peser moins."

#: data/json/effects.json
#. ~ Apply message of effect type "Weakened Gravity"
msgid "Space around you is damaged and everything near you seems to weigh less."
msgstr ""
"L’espace autour de vous est endommagé et tout ce qui se trouve à proximité "
"semble moins lourd."

#: data/json/effects.json
#. ~ Remove message of effect type "Weakened Gravity"
#. ~ Remove message of effect type "Strengthened Gravity"
msgid "Reality reasserts itself and your gravity returns to normal."
msgstr "La réalité reprend ses droits et votre gravité redevient normale."

#: data/json/effects.json
#. ~ Name of effect type id "strengthened_gravity"
msgid "Strengthened Gravity"
msgstr "Gravité Renforcée"

#: data/json/effects.json
#. ~ Description of effect type "Strengthened Gravity"
msgid ""
"Something is wrong with local spacetime and everything near you seems to "
"weigh more."
msgstr ""
"Quelque chose ne va pas dans l'espace-temps local et tout ce qui est proche "
"de vous semble peser plus lourd."

#: data/json/effects.json
#. ~ Apply message of effect type "Strengthened Gravity"
msgid "Space around you is damaged and everything near you seems to weigh more."
msgstr ""
"L'espace autour de vous est endommagé et tout ce qui est autour de vous "
"semble peser plus lourd."

#: data/json/effects.json
#. ~ Name of effect type id "slowed_time"
msgid "Slowed Time"
msgstr "Temps Ralenti"

#: data/json/effects.json
#. ~ Description of effect type "Slowed Time"
msgid ""
"Something is wrong with local spacetime and everything around seems to move "
"faster than you."
msgstr ""
"Quelque chose ne va pas dans l'espace-temps local et tout ce qui est autour "
"de vous semble bouger plus rapidement."

#: data/json/effects.json
#. ~ Apply message of effect type "Slowed Time"
msgid "Time around you is damaged and everything near you seems to move faster."
msgstr ""
"Le temps semble endommagé et tout ce qui est autour de vous semble bouger "
"plus rapidement."

#: data/json/effects.json
#. ~ Remove message of effect type "Slowed Time"
msgid "Reality reasserts itself and your time returns to normal."
msgstr "La réalité reprends ses droits et le temps revient à la normal."

#: data/json/effects.json
#. ~ Name of effect type id "nvg_green"
msgid "Night Vision Goggles (Green)"
msgstr "Jumelles de Vision Nocturne (Verte)"

#: data/json/effects.json
#. ~ Description of effect type "Night Vision Goggles (Green)"
msgid "Your night vision goggles give a green tint to the world."
msgstr "Vos jumelles de vision nocturne vous font voir le monde en vert."

#: data/json/effects.json
#. ~ Description of effect type "Glowing Gas"
msgid ""
"You've inhaled a lungful of glowing nether parasite spores.  Thankfully, they "
"don't seem adapted to the human physiology."
msgstr ""
"Vous avez avalé une bouffée de spores de parasites du néant, heureusement "
"pour vous, on dirait que ceux-ci ne sont pas encores adaptés à votre "
"physiologie humaine."

#: data/json/effects.json
#. ~ Apply message of effect type "Glowing Gas"
msgid ""
"You inhale a lungful of the glowing gas, and you have an urge to violently "
"cough."
msgstr ""
"Vous inhalez une bouffée du gaz luisant, vous donnant une envie irrésistible "
"de tousser violemment."

#: data/json/effects.json
#. ~ Miss message of effect type "Glowing Gas"
msgid "Your lungs burn from the glowing gas."
msgstr "Le gaz luisant brûle vos poumons."

#: data/json/effects.json
#. ~ Description of effect type "Glowing"
msgid "You are covered in glowing nether spores!"
msgstr "Vous êtes couvert(e) de spores du néant luisantes!"

#: data/json/effects.json
#. ~ Apply message of effect type "Glowing"
msgid "The glowing spores settle on you!"
msgstr "Les spores luisantes se déposent sur vous!"

#: data/json/effects.json
#. ~ Name of effect type id "molting"
msgid "Molting"
msgstr "Mue"

#: data/json/effects.json
#. ~ Description of effect type "Molting"
msgid "You feel a strong urge to hide somewhere safe."
msgstr "Vous avez très envie de vous cacher dans un endroit sûr."

#: data/json/effects.json
#. ~ Apply message of effect type "Molting"
msgid "Your chitin plating itches against your body."
msgstr "Vos plaques de chitine démangent."

#: data/json/effects.json
#. ~ Name of effect type id "molting_imminent"
msgid "Imminent Molting"
msgstr "Mue Imminente"

#: data/json/effects.json
#. ~ Description of effect type "Imminent Molting"
msgid "Seek shelter, you will be helpless when it begins."
msgstr "Cherchez un abri, vous serez impuissant·e quand cela commencera."

#: data/json/effects.json
#. ~ Apply message of effect type "Imminent Molting"
msgid ""
"You can hardly move in your tightening exoskeleton, and you feel a strong "
"impulse to hunker down somewhere safe."
msgstr ""
"Vous pouvez à peine bouger dans votre exosquelette se resserrant d'instant en "
"instant et vous ressentez une forte envie de vous cacher dans un endroit sûr."

#: data/json/effects.json
#. ~ Name of effect type id "VITRIFYING"
msgid "Among Glass"
msgstr "Un·e avec le Verre"

#: data/json/effects.json
#. ~ Description of effect type "Among Glass"
msgid "It is very peaceful here."
msgstr "C'est très calme ici."

#: data/json/effects.json
#. ~ Name of effect type id "hay_fever"
msgid "Hay Fever"
msgstr "Rhume des Foins"

#: data/json/effects.json
#. ~ Description of effect type "Hay Fever"
msgid "Your eyes are itchy and you've got a runny nose."
msgstr "Vos yeux vous démangent et votre nez coule."

#: data/json/effects.json
#. ~ Name of effect type id "star_vampire_blood_drank"
msgid "Drank blood"
msgstr "A bu du sang"

#: data/json/effects.json
#. ~ Description of effect type "Drank blood"
msgid "The star vampire has drunk blood and is now visible."
msgstr "Le vampire stellaire a bu du sang et est désormais visible."

#: data/json/effects.json
#: data/json/obsoletion_and_migration_0.I/obsolete_effect.json
#. ~ Name of effect type id "star_vampire_blood_drink_feral"
#. ~ Name of effect type id "star_vampire_blood_drink"
msgid "Exsanguination"
msgstr "Exsanguination"

#: data/json/effects.json
#. ~ Description of effect type "Exsanguination"
msgid "The monster is drinking your blood, you vile feral!"
msgstr "Le monstre est en train de boire votre sang, espèce de vil sauvage!"

#: data/json/effects.json
#. ~ Name of effect type id "ink_gland_ink"
msgid "Depleted ink"
msgstr "Encre épuisée"

#: data/json/effects.json
#. ~ Name of effect type id "ink_gland_ink"
msgid "Deflated ink glands"
msgstr "Glandes à Encre Dégonflées"

#: data/json/effects.json
#. ~ Name of effect type id "ink_gland_ink"
msgid "Inky glands"
msgstr "Glandes à encre"

#: data/json/effects.json
#. ~ Name of effect type id "ink_gland_ink"
msgid "Bulged ink glands"
msgstr "Glandes à Encre Gonflées"

#: data/json/effects.json
#. ~ Description of effect type "Depleted ink"
msgid "Your ink glands are empty.  Given some time and hydration they will recharge."
msgstr ""
"Vos glandes à encre sont vides.  Avec un peu de temps et d'hydratation, elles "
"se rechargeront."

#: data/json/effects.json
#. ~ Description of effect type "Deflated ink glands"
msgid ""
"Your ink glands are almost empty.  Given some time and hydration they will "
"recharge."
msgstr ""
"Vos glandes à encre sont presque vides.  Avec un peu de temps et "
"d'hydratation, elles se rechargeront."

#: data/json/effects.json
#. ~ Description of effect type "Inky glands"
msgid ""
"Your ink glands have some ink inside.  Given some time and hydration, more "
"ink will be generated."
msgstr ""
"Vos glandes à encre contiennent une certain quantité d'encre.  Avec un peu de "
"temps et d'hydratation, plus d'encre sera générée."

#: data/json/effects.json
#. ~ Description of effect type "Bulged ink glands"
msgid "Your ink glands are bulged and full.  No more ink is being created."
msgstr "Vos glandes à encre sont bombées et pleines.  Plus aucune encre n’est créée."

#: data/json/effects.json
#. ~ Name of effect type id "cramped_space"
msgid "Cramped Space"
msgstr "Espace Étroit"

#: data/json/effects.json
#. ~ Description of effect type "Cramped Space"
#. ~ Apply message of effect type "Cramped Space"
msgid "Your movements are restricted by the surroundings."
msgstr ""

#: data/json/effects.json
#. ~ Remove message of effect type "Cramped Space"
msgid "You are able to move freely again."
msgstr ""

#: data/json/effects.json
#. ~ Miss message of effect type "Cramped Space"
msgid "You don't have any room to move!"
msgstr "Vous n'avez pas de place pour bouger!"

#: data/json/effects.json
#. ~ Name of effect type id "gliding"
msgid "Gliding"
msgstr "Vol Plané"

#: data/json/effects.json
#. ~ Description of effect type "Gliding"
msgid "You are gliding through the air."
msgstr "Vous planez dans l'air."

#: data/json/effects.json
#. ~ Name of effect type id "slow_descent"
msgid "Slow Descent"
msgstr "Chute Ralentie"

#: data/json/effects.json
#. ~ Description of effect type "Slow Descent"
msgid "You are descending at a safe speed."
msgstr "Vous chutez sans danger à une vitesse raisonnable."

#: data/json/effects.json data/json/mutations/mutations.json
#. ~ Name of effect type id "mute"
#. ~ Mutation name
msgid "Mute"
msgstr "Muet"

#: data/json/effects.json
#. ~ Description of effect type "Mute"
msgid "You can't talk."
msgstr "Vous ne pouvez pas parler."

#: data/json/effects.json
#. ~ Name of effect type id "social_satisfied"
msgid "Good Company"
msgstr "Bonne Compagnie"

#: data/json/effects.json
#. ~ Description of effect type "Good Company"
msgid "It feels good to spend time around others."
msgstr "C'est agréable de passer du temps avec les autres."

#: data/json/effects.json
#. ~ Name of effect type id "social_dissatisfied"
msgid "Very Lonely"
msgstr "Très Isolé(e)"

#: data/json/effects.json
#. ~ Name of effect type id "social_dissatisfied"
msgid "All Alone"
msgstr "Tout(e) Seul(e)"

#: data/json/effects.json
#. ~ Description of effect type "Lonely"
msgid "You feel a little lonely."
msgstr "Vous vous sentez un peu seul(e)."

#: data/json/effects.json
#. ~ Description of effect type "Very Lonely"
msgid "You could really use a friend right now."
msgstr "Vous auriez vraiment besoin d'un(e) ami(e) pour vous tenir compagnie."

#: data/json/effects.json
#. ~ Description of effect type "All Alone"
msgid "What's the point of surviving if you're all alone?"
msgstr "Quel est le but de survivre si vous restez tout(e) seul(e)?"

#: data/json/effects.json
#. ~ Name of effect type id "asocial_satisfied"
msgid "Alone"
msgstr "Seul(e)"

#: data/json/effects.json
#. ~ Description of effect type "Alone"
msgid "Being on your own makes you feel good."
msgstr "Être seul(e) est agréable."

#: data/json/effects.json
#. ~ Name of effect type id "asocial_dissatisfied"
msgid "Irritable"
msgstr "Irritable"

#: data/json/effects.json
#. ~ Name of effect type id "asocial_dissatisfied"
msgid "Annoyed"
msgstr "Agacé(e)"

#: data/json/effects.json
#. ~ Description of effect type "Irritable"
msgid "Being around others has left you feeling drained."
msgstr "Être en contact avec d'autres personnes vous épuise."

#: data/json/effects.json
#. ~ Description of effect type "Annoyed"
msgid "OK, that's enough social time.  You'd really rather be alone now."
msgstr ""
"Bon, ça suffit pour passer du temps en société. Tu préfèrerais vraiment être "
"seul maintenant."

#: data/json/effects.json
#. ~ Description of effect type "Crowded"
msgid ""
"Your nerves are frayed from all this socializing.  You need some alone time "
"to recharge."
msgstr ""
"Vos nerfs sont à vif à cause de toutes ces interactions sociales. Vous avez "
"besoin de passer du temps seul pour vous ressourcer."

#: data/json/effects.json
#. ~ Name of effect type id "natural_stance"
msgid "Natural Stance"
msgstr "Posture Naturelle"

#: data/json/effects.json
#. ~ Description of effect type "Natural Stance"
msgid ""
"You are positioned to take advantage of your mutated anatomy, and will "
"receive no penalties for crouching in melee combat.  Wielding a weapon will "
"cause you to lose this effect."
msgstr ""
"Vous êtes dans une position adéquate pour profiter de votre anatomie mutante, "
"et vous ne recevrez pas de pénalités de combat rapproché en étant "
"accroupi(e). Manier une arme vous fera perdre cette effet."

#: data/json/effects.json
#. ~ Name of effect type id "subaquatic_sonar"
msgid "Subaquatic SONAR"
msgstr "SONAR Subaquatique"

#: data/json/effects.json
#. ~ Description of effect type "Subaquatic SONAR"
msgid ""
"Every few seconds, an ultrasonic pulse is broadcast from your location.  If "
"you're underwater and your hearing is good enough, you may be able to "
"navigate by the pings that come back."
msgstr ""
"À des intervalles de quelques secondes, une impulsion ultrasonique est "
"diffusée depuis votre position. Si vous êtes sous l'eau et votre ouïe est "
"suffisamment bonne, vous pourriez peut-être vous orienter grâce aux échos "
"revenant vers vous."

#: data/json/effects.json
#. ~ Blood analysis description of effect type "anticoagulant_draculin"
msgid "Draculin"
msgstr "Draculine"

#: data/json/effects.json
#. ~ Name of effect type id "a_winner_is_u"
msgid "Winning!"
msgstr "Gagnant!"

#: data/json/effects.json
#. ~ Name of effect type id "triffid_fiber_indigestion"
msgid "Uneasy stomach"
msgstr "Estomac incommodé"

#: data/json/effects.json
#. ~ Name of effect type id "triffid_fiber_indigestion"
msgid "Bloated stomach"
msgstr "Estomac ballonné"

#: data/json/effects.json
#. ~ Name of effect type id "triffid_fiber_indigestion"
msgid "Strained stomach"
msgstr "Estomac Tendu"

#: data/json/effects.json
#. ~ Name of effect type id "triffid_fiber_indigestion"
msgid "Overloaded stomach"
msgstr "Estomac Surchargé"

#: data/json/effects.json
#. ~ Description of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
msgid ""
"Your stomach constantly feels like it's full, even when you haven't eaten in "
"awhile."
msgstr ""

#: data/json/effects.json
#. ~ Apply message of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
msgid "Your stomach starts to feel strange and bloated."
msgstr ""

#: data/json/effects.json
#. ~ Remove message of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
msgid "Your stomach feels normal again."
msgstr ""

#: data/json/effects.json
#. ~ Decay message of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
msgid "Your gut feels less bloated."
msgstr ""

#: data/json/effects.json
#. ~ Decay message of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
msgid "You feel the strain in your stomach lessen."
msgstr ""

#: data/json/enchantments.json
#. ~ Description of creature revealed by special vision
#. "infrared_creature_tiny"
msgid "You see a tiny figure radiating heat."
msgstr "Vous voyez une silhouette minuscule dégageant de la chaleur."

#: data/json/enchantments.json
#. ~ Description of creature revealed by special vision
#. "infrared_creature_small"
msgid "You see a small figure radiating heat."
msgstr "Vous voyez une silhouette diminutive dégageant de la chaleur."

#: data/json/enchantments.json
#. ~ Description of creature revealed by special vision
#. "infrared_creature_medium"
msgid "You see a medium figure radiating heat."
msgstr "Vous voyez une silhouette moyenne dégageant de la chaleur."

#: data/json/enchantments.json
#. ~ Description of creature revealed by special vision
#. "infrared_creature_large"
msgid "You see a large figure radiating heat."
msgstr "Vous voyez une silhouette volumineuse dégageant de la chaleur."

#: data/json/enchantments.json
#. ~ Description of creature revealed by special vision
#. "infrared_creature_huge"
msgid "You see a huge figure radiating heat."
msgstr "Vous voyez une silhouette énorme dégageant de la chaleur."

#: data/json/enchantments.json
#. ~ Description of creature revealed by special vision
#. "infrared_creature_medium"
msgid "You sense a creature with your thermal nostrils."
msgstr "Vous ressentez une créature avec vos narines thermiques."

#: data/json/enchantments.json data/mods/Aftershock/effects_esper.json
#: data/mods/BombasticPerks/perks.json
#: data/mods/MindOverMatter/effects/effects_psionic.json
#: data/mods/aftershock_exoplanet/effects_esper.json
#. ~ Description of creature revealed by special vision
#. "electric_creature_sense"
msgid "You sense something emitting electricity here."
msgstr "Vous ressentez quelque chose émettant de l'électricité ici."

#: data/json/enchantments.json
#. ~ Name of a enchantment
msgid "Night Vision Goggles"
msgstr "Jumelles de Vision Nocturne"

#: data/json/enchantments.json
#. ~ Description of enchantment "Night Vision Goggles"
msgid ""
"You are wearing night vision goggles which allow you to see really well in "
"the dark."
msgstr ""
"Vous portez des lunettes de vision nocturne qui vous permettent de très bien "
"voir dans le noir."

#: data/json/enchantments.json
#. ~ Description of enchantment "Night Vision Goggles"
msgid ""
"You are wearing night vision goggles which allow you to see quite well in the "
"dark."
msgstr ""
"Vous portez des lunettes de vision nocturne qui vous permettent de voir assez "
"bien dans le noir."

#: data/json/enchantments.json
#. ~ Description of enchantment "Night Vision Goggles"
msgid "You are wearing night vision goggles which allow you to see in the dark."
msgstr ""
"Vous portez des lunettes de vision nocturne qui vous permettent de voir dans "
"le noir."

#: data/json/enchantments.json
#. ~ Description of enchantment "Night Vision Goggles"
msgid ""
"You are wearing night vision goggles which allow you to poorly see in the "
"dark."
msgstr ""
"Vous portez des lunettes de vision nocturne qui vous permettent de mal voir "
"dans le noir."

#: data/json/enchantments.json data/mods/Aftershock/items/item_enchants.json
#: data/mods/aftershock_exoplanet/items/item_enchants.json
#. ~ Name of a enchantment
msgid "Cold Climate Control"
msgstr "Contrôle du climat froid"

