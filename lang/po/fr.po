msgid_plural "makeshift bandages"
msgstr[0] "bandage improvisé"
msgstr[1] "bandages improvisés"
msgstr[2] "bandages improvisés"

#: data/json/items/tool/med.json
#. ~ Description of "makeshift bandage"
msgid ""
"A reasonably clean piece of cloth wrapped for use as a simple bandage.  "
"Better than nothing."
msgstr ""
"Un morceau de tissu raisonnablement propre enroulé pour être utilisé comme "
"bandage. Mieux que rien."

#: data/json/items/tool/med.json
#. ~ Item name
msgid "bleached makeshift bandage"
msgid_plural "bleached makeshift bandages"
msgstr[0] "bandage improvisé blanchi"
msgstr[1] "bandages improvisés blanchis"
msgstr[2] "bandages improvisés blanchis"

#: data/json/items/tool/med.json
#. ~ Description of "bleached makeshift bandage"
