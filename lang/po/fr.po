#: data/json/enchantments.json
#. ~ Name of a enchantment
msgid "Inactive exoskeleton"
msgstr "Exosquelette Inactif"

#: data/json/enchantments.json
#. ~ Description of enchantment "Inactive exoskeleton"
msgid "The exoskeleton is inactive and makes moving in it difficult and exhausting."
msgstr "L'exosquelette est inactif et rend les mouvements difficiles et épuisants."

#: data/json/enchantments.json
#. ~ Name of a enchantment
msgid "Active combat exoskeleton mk.1"
msgstr "Exosquelette de combat mk.1 allumé"

#: data/json/enchantments.json
#. ~ Description of enchantment "Active combat exoskeleton mk.1"
msgid ""
"Now powered, the exoskeleton provides <color_white>significant</color> "
"improvements to your carry weight and movement exertion while the life "
"support system shields you against harmful gas, cools you down, and dampens "
"harmful sounds."
msgstr ""
"Avec ses batteries alimentées, cet exosquelette vous offre une assistance "
"<color_white>considérable</color> à vos mouvements vous permettant de porter "
"bien plus et fatiguer beaucoup moins vite que la normale.  Un système de "
"survie intégré vous protège aussi des gaz toxiques ou asphyxiants, de la "
"surchauffe et des bruits nocifs."

#: data/json/enchantments.json
#. ~ Name of a enchantment
msgid "Active combat exoskeleton mk.2"
msgstr "Exosquelette de combat mk.2 allumé"

#: data/json/enchantments.json
#. ~ Description of enchantment "Active combat exoskeleton mk.2"
msgid ""
"Now powered, the exoskeleton provides <color_white>moderate</color> "
"improvements to your carry weight and movement exertion while the life "
"support system shields you against harmful gas, cools you down, and dampens "
"harmful sounds."
msgstr ""
"Avec ses batteries alimentées, cet exosquelette vous offre une assistance "
"<color_white>modérée</color> à vos mouvements vous permettant de porter plus "
"et fatiguer moins vite que la normale.  Un système de survie intégré vous "
"protège aussi des gaz toxiques ou asphyxiants, de la surchauffe et des bruits "
"nocifs."

#: data/json/enchantments.json
#. ~ Name of a enchantment
msgid "Active combat exoskeleton mk.3"
msgstr "Exosquelette de combat mk.3 allumé"

#: data/json/enchantments.json
#. ~ Description of enchantment "Active combat exoskeleton mk.3"
msgid ""
"Now powered, the exoskeleton provides <color_white>slight</color> "
"improvements to your carry weight and movement exertion while the life "
"support system shields you against harmful gas, cools you down, and dampens "
"harmful sounds."
msgstr ""
"Avec ses batteries alimentées, cet exosquelette vous offre une assistance "
"<color_white>légère</color> à vos mouvements vous permettant de porter un peu "
"plus et fatiguer un peu moins vite que la normale.  Un système de survie "
"intégré vous protège aussi des gaz toxiques ou asphyxiants, de la surchauffe "
"et des bruits nocifs."

