msgstr "Vos pouvoirs atténuent considérablement la douleur que vous ressentez."

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Name of effect type id "effect_biokin_pkill_6"
msgid "Overcoming Extreme Pain"
msgstr "Surmonter Douleurs Extrêmes"

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Description of effect type "Overcoming Extreme Pain"
msgid "Your powers are enormously lessening the pain you feel."
msgstr "Vos pouvoirs réduisent énormément la douleur que vous ressentez."

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Description of effect type "Oxygen Absorption"
msgid "You can absorb oxygen through your skin."
msgstr "Vous êtes capable d'absorber de l'oxygène à travers votre peau."

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Name of effect type id "effect_biokin_flexibility"
msgid "Flexibility"
msgstr "Flexibilité"

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Description of effect type "Flexibility"
msgid "You are enhancing your range of motion."
msgstr "Vous améliorez votre amplitude de mouvement."

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Remove message of effect type "Flexibility"
