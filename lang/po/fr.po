#: data/json/items/tool/electronics.json
#. ~ Description of "camera"
msgid ""
"A point-and-shoot digital camera with a digital viewfinder, a backup "
"'iron-sight', and flash.  You can look at your photos on the digital screen, "
"or transfer them with any standard electronic device."
msgstr ""

#: data/json/items/tool/electronics.json
#. ~ Item name
msgid "professional camera"
msgid_plural "professional cameras"
msgstr[0] "caméra professionnelle"
msgstr[1] "caméras professionnelles"
msgstr[2] "caméras professionnelles"

#: data/json/items/tool/electronics.json
#. ~ Description of "professional camera"
msgid ""
"A 35 mm digital SLR (single-lens reflex) camera with optical and digital "
"viewfinders, a zoom lens with auto-focus and stabilizer, and flash.  You can "
"look at your photos on the digital screen or transfer them with any standard "
"electronic device.  Before the Cataclysm, you could have taken "
"professional-grade photos using this."
msgstr ""

#: data/json/items/tool/electronics.json
#. ~ Item name
msgid "cellphone"
msgid_plural "cellphones"
msgstr[0] "téléphone portable"
msgstr[1] "téléphones portables"
msgstr[2] "téléphones portables"

#: data/json/items/tool/electronics.json
#. ~ Description of "cellphone"
msgid ""
"A cellphone, an older cousin of the smartphone that is still popular in "
"certain circles due to its reliability and sturdiness.  Using the phone will "
"turn it on and provide light, assuming it is sufficiently charged.  It also "
"tells the time and has an alarm feature."
msgstr ""

#: data/json/items/tool/electronics.json data/mods/Aftershock/items/tools.json
#: data/mods/Xedra_Evolved/items/electronics.json
#: data/mods/aftershock_exoplanet/items/tools.json
