#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "kitchen station"
msgstr "poste de cuisine  "

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "workshop station"
msgstr "poste d'atelier  "

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-appliances.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "oven"
msgstr "four"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "oven"
msgid ""
"A standard electric convection-based oven, commonly used for heating and "
"cooking food.  It's plugged in and ready to go."
msgstr ""
"Un four électrique standard à convection, couramment utilisé pour chauffer et "
"cuire des aliments.  Il est branché et prêt à fonctionner."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "stationary water purifier"
msgstr "purificateur d'eau fixe"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "stationary water purifier"
msgid ""
"This device effectively sterilizes water.  Activate it to clean all water in "
"a connected tank, at the cost of some electricity."
msgstr ""
"Cet appareil stérilise efficacement l'eau.  Activez-le pour assainir toute "
"l'eau d'un réservoir connecté, au prix d'un peu d'électricité."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "arcade machine"
msgstr "machine d'arcade"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "arcade machine"
msgid ""
"A bulky upright arcade cabinet, brightly painted and slightly worn with age.  "
"Ready to be played."
msgstr ""
"Une borne d'arcade verticale volumineuse, peinte avec des couleurs vives et "
"légèrement usée par le temps.  Prête à être jouée."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "arc furnace"
msgid_plural "arc furnaces"
msgstr[0] "four à arc électrique"
msgstr[1] "fours à arc électrique"
msgstr[2] "fours à arc électrique"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "arc furnace"
msgid ""
"An arc furnace designed to burn a powdery mix of coke and limestone to create "
"calcium carbide.  Plugged in and ready to go."
msgstr ""
"Un four à arc conçu pour brûler un mélange poudreux de coke et de calcaire "
"afin de créer du carbure de calcium. Branché et prêt à fonctionner."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/metalworking.json
#. ~ Vehicle part name
#. ~ Item name
msgid "electric forge"
msgid_plural "electric forges"
msgstr[0] "forge électrique"
msgstr[1] "forges électriques"
msgstr[2] "forges électriques"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "electric forge"
msgid ""
"An electric forge, plugged in and ready to be used for metalworking.  If you "
"attempt to craft an item that needs a forge, you will be given the option of "
"selecting it as a tool."
msgstr ""
"Une forge électrique, branchée et prête à être utilisée pour le travail du "
"métal. Si vous tentez de fabriquer un objet nécessitant une forge, vous aurez "
"la possibilité de la sélectionner comme outil."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_kiln"
msgid ""
"An electric kiln for baking brick or clay.  When plugged in and powered you "
"could use this to harden bricks or clay.  If you attempt to craft an item "
"that needs a kiln, you will be given the option of selecting it as a tool."
msgstr ""
"An electric kiln for baking brick or clay.  When plugged in and powered you "
"could use this to harden bricks or clay.  If you attempt to craft an item "
"that needs a kiln, you will be given the option of selecting it as a tool."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "drill press"
msgid_plural "drill presses"
msgstr[0] "Perceuse a colonne"
msgstr[1] "Perceuses a colonne"
msgstr[2] "Perceuses à colonne  "

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "drill press"
msgid ""
"A powerful drill mounted on a slide that lets it drop precisely down.  Useful "
"in all kinds of projects, from industrial fabrication to home woodworking.  "
"Plugged in and ready to go."
msgstr ""
"Une perceuse puissante montée sur une glissière qui lui permet de descendre "
"avec précision. Utile pour toutes sortes de projets, de la fabrication "
"industrielle au travail du bois à domicile. Branchée et prête à l'emploi."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "table saw"
msgid_plural "table saws"
msgstr[0] "scie à table"
msgstr[1] "scies à table"
msgstr[2] "scies à table"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "table saw"
msgid ""
"A rotating sawblade set into a large, flat table.  Used for making straight, "
"measured cuts, it's a key tool in any carpenter's arsenal.  Plugged in and "
"ready to go."
msgstr ""
"Une lame de scie rotative encastrée dans une grande table plate. Utilisée "
"pour effectuer des coupes droites et mesurées, c'est un outil essentiel dans "
"l'arsenal de tout menuisier. Branchée et prête à l'emploi."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "mitre saw"
msgid_plural "mitre saws"
msgstr[0] "scie à onglet"
msgstr[1] "scies à onglet"
msgstr[2] "scies à onglet"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "mitre saw"
msgid ""
"A circular sawblade on an arm that can slide and rotate in several "
"directions, this is a staple tool for nearly any carpentry.  Plugged in and "
"ready to go."
msgstr ""
"Une lame de scie circulaire sur un bras qui peut coulisser et tourner dans "
"plusieurs directions, c'est un outil de base pour presque tous les travaux de "
"menuiserie. Branché et prêt à l'emploi."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "band saw"
msgid_plural "band saws"
msgstr[0] "scie à ruban"
msgstr[1] "scies à ruban"
msgstr[2] "scies à ruban"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "band saw"
msgid ""
"A ribbonlike sawblade runs in a single direction in this tool, allowing "
"precise cuts at almost any angle.  Plugged in and ready to go."
msgstr ""
"Une lame de scie en forme de ruban fonctionne dans une seule direction dans "
"cet outil, permettant des coupes précises sous presque tous les angles. "
"Branchée et prête à l'utilisation."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "router table"
msgstr "Défonceuse sur table"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "router table"
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves.  Plugged in and ready to go."
msgstr ""
"Cette table est équipée d'une défonceuse, d'un moteur rotatif et d'une tête "
"de lame interchangeable pour la découpe de profils et de rainures "
"spécifiques. Branchée et prête à l'emploi."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "planer"
msgid_plural "planers"
msgstr[0] "raboteuse"
msgstr[1] "raboteuses"
msgstr[2] "raboteuses"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "planer"
msgid ""
"A hefty tool that will take in a board and cut it smooth and flat to a "
"specific width, particularly great if working with raw lumber stock, but also "
"good just for shaving wood down to size.  Plugged in and ready to go."
msgstr ""
"Un outil lourd qui prend une planche et la coupe de manière lisse et plate à "
"une largeur spécifique, particulièrement utile si vous travaillez avec du "
"bois brut, mais aussi simplement pour réduire le bois à la taille voulue. "
"Branché et prêt à l'emploi."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "jointer"
msgid_plural "jointers"
msgstr[0] "dégauchisseuse"
msgstr[1] "dégauchisseuses"
msgstr[2] "dégauchisseuses"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "jointer"
msgid ""
"A table-shaped tool with a rotating blade that will cut down, smooth out, and "
"square off a board to make it nice and smooth.  Plugged in and ready to go."
msgstr ""
"Un outil en forme de table avec une lame rotative qui coupera, lissera et "
"équarrira une planche pour la rendre belle et lisse.  Branchée et prête à "
"l'utilisation."

#: data/json/furniture_and_terrain/appliances.json data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Item name
msgid "catalytic cracking reactor"
msgid_plural "catalytic cracking reactors"
msgstr[0] "réacteur de craquage catalytique"
msgstr[1] "réacteurs de craquage catalytique"
msgstr[2] "réacteurs de craquage catalytique"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "catalytic cracking reactor"
msgid ""
"A makeshift extraction system, or as makeshift as you can consider something "
"that was purpose-built in a laboratory by a group of experts."
msgstr ""
"Un système d’extraction improvisé, du moins aussi improvisé que l’on puisse "
"imaginer quelque chose qui a été spécialement construit dans un laboratoire "
"par un groupe d’experts."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "hydraulic press"
msgid_plural "hydraulic presses"
msgstr[0] "presse hydraulique"
msgstr[1] "presses hydrauliques"
msgstr[2] "presses hydrauliques"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "hydraulic press"
msgid ""
"If you really want to squash something a lot, this is exactly the right "
"industrial tool for you.  Plugged in and ready to go."
msgstr ""
"Si vous voulez vraiment écraser quelque chose avec une force extrême ceci est "
"l'outil industriel qu'il vous. Branchée et prêt à être utilisée."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "air compressor"
msgid_plural "air compressors"
msgstr[0] "compresseur d'air"
msgstr[1] "compresseurs d'air"
msgstr[2] "compresseurs d'air"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "air compressor"
msgid ""
"This durable tank is topped with a motor that will cram as much air into the "
"tank as possible.  Plugged in and ready to go."
msgstr ""
"Ce réservoir durable est surmonté d’un moteur qui compressera autant d’air "
"que possible dans le réservoir.  Branché et prêt à l'utilisation."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "large heater"
msgstr "large radiateur"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "small heater"
msgstr "petit radiateur"

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift water electrolyzer"
msgid_plural "makeshift water electrolyzers"
msgstr[0] "électrolyseur d'eau improvisé"
msgstr[1] "électrolyseurs d'eau improvisés"
msgstr[2] "électrolyseurs d'eau improvisés"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift water electrolyzer"
msgid ""
"A makeshift appliance which decomposes water into oxygen and hydrogen via "
"electrolysis of sodium hydroxide solution, with a power cord to connect it to "
"an electric grid."
msgstr ""
"Un appareil improvisé qui décompose l'eau en oxygène et hydrogène par "
"électrolyse d'une solution d'hydroxyde de sodium, avec un câble "
"d'alimentation pour le connecter à un réseau électrique."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift ammonia machine reactor"
msgid_plural "makeshift ammonia machine reactors"
msgstr[0] "réacteur d'ammoniac improvisé"
msgstr[1] "réacteurs d'ammoniac improvisés"
msgstr[2] "réacteurs d'ammoniac improvisés"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift ammonia machine reactor"
msgid ""
"A huge appliance built from salvaged industrial equipment, which produces "
"ammonia via the Haber-Bosch process from hydrogen and nitrogen.  It has a "
"power cord to connect it to an electric grid."
msgstr ""
"Un énorme appareil construit à partir d'équipement industriel récupéré "
"capable de produire de l'ammoniac via le procédé Haber-Bosch à partir "
"d'hydrogène et d'azote.  Il dispose d'un cordon d'alimentation pour le "
"connecter à un réseau électrique."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift ammonia machine pipework"
msgid_plural "makeshift ammonia machine pipeworks"
msgstr[0] "tuyauterie improvisée pour machine à ammoniac"
msgstr[1] "tuyauteries improvisées pour machine à ammoniac"
msgstr[2] "tuyauteries improvisées pour machine à ammoniac"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift ammonia machine pipework"
msgid ""
"A rather complicated system of thick-walled pipes, powerful compressors, and "
"wiring, meant to interface with a reactor producing ammonia from nitrogen and "
"hydrogen via the Haber-Bosch process, with a power cord to connect it to an "
"electric grid."
msgstr ""
"Un système assez compliqué de tuyaux à parois épaisses, de puissants "
"compresseurs et de câblage, destiné à s'interfacer avec un réacteur "
"produisant de l'ammoniac à partir d'azote et d'hydrogène via le procédé "
"Haber-Bosch, avec un cordon d'alimentation pour le relier à un réseau "
"électrique."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift nitrogen generator"
msgid_plural "makeshift nitrogen generators"
msgstr[0] "générateur d'azote improvisé"
msgstr[1] "générateurs d'azote improvisés"
msgstr[2] "générateurs d'azote improvisés"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift nitrogen generator"
msgid ""
"A large makeshift appliance which captures nitrogen from the air for use in "
"chemistry projects, with a power cord to connect it to an electric grid."
msgstr ""
"Un grand appareil de fortune qui capture l'azote de l'air pour l'utiliser "
"dans des projets de chimie, avec un cordon d'alimentation pour le connecter à "
"un réseau électrique."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/cables.json
#. ~ Vehicle part name
#. ~ Item name
msgid "power cord"
msgid_plural "power cords"
msgstr[0] "rallonge électrique"
msgstr[1] "rallonges électriques"
msgstr[2] "rallonges électriques"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "power cord"
msgid ""
"A power cord sticking out of an appliance.  You need to plug it into a "
"powered grid for the appliance to work properly."
msgstr ""
"Un cordon d'alimentation qui dépasse d'un appareil.  Vous devez le brancher "
"sur un réseau électrique pour que l'appareil fonctionne correctement."

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "wall light"
msgstr "lampe murale"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "wall light"
msgid "A wall-mounted lamp that provides illumination when turned on."
msgstr "Une lampe murale qui éclaire lorsqu'elle est allumée."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-decorative.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "standing lamp"
msgstr "lampe sur pied"

