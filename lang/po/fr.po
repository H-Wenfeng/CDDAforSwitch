msgstr ""
"Un réfrigérateur robuste. Lorsqu'il est allumé, il refroidit les aliments "
"qu'il contient, prolongeant ainsi la durée de conservation des aliments."

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#: data/json/furniture_and_terrain/furniture_refrigeration.json
#: data/json/items/appliances/appliances_refrigeration.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "display fridge"
msgid_plural "display fridges"
msgstr[0] "réfrigérateur d'exposition"
msgstr[1] "réfrigérateurs d'exposition"
msgstr[2] "réfrigérateurs d'exposition"

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#. ~ Description of vehicle part "display fridge"
msgid ""
"A display fridge.  When turned on, it will cool the food inside, extending "
"the time until the food spoils."
msgstr ""
"Un réfrigérateur de présentation. Lorsqu'il est allumé, il refroidit les "
"aliments qu'il contient, prolongeant ainsi la durée de conservation des "
"aliments."

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#: data/mods/Aftershock/items/appliances.json
#: data/mods/aftershock_exoplanet/items/appliances.json
#. ~ Vehicle part name
#. ~ Item name
msgid "freezer"
msgid_plural "freezers"
msgstr[0] "freezer"
msgstr[1] "freezers"
msgstr[2] "freezers"

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#. ~ Description of vehicle part "freezer"
msgid ""
"A common upright freezer.  When turned on, it will freeze the food inside, "
"preventing any further expiration."
msgstr ""
"Un congélateur vertical courant. Lorsqu'il est allumé, il congèle les "
"aliments qu'il contient, empêchant ainsi leur expiration."

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#: data/json/furniture_and_terrain/furniture_refrigeration.json
#: data/json/items/appliances/appliances_refrigeration.json
