msgstr[1] "torchons à vaisselle"
msgstr[2] "torchons à vaisselle"

#: data/json/items/tool/toiletries.json
#. ~ Description of "dish towel"
msgid "A dish towel, useful for cleaning hard surfaces."
msgstr "Un torchon à vaisselle, utile pour nettoyer des surfaces rigides."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "An elegant, monogrammed dish towel.  Unfortunately, they aren't your initials."
msgstr ""
"Un élégant torchon à monogramme. Malheureusement, ce ne sont pas vos "
"initiales."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "An elegant, monogrammed dish towel.  It even has your initials!"
msgstr "Un élégant torchon à monogramme. Il porte même vos initiales !"

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A well-used dish towel, judging by the stains."
msgstr ""
"Un torchon à vaisselle ayant été utilisé profusément, jugeant par par les "
"tâches le recouvrant."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A novelty dish towel featuring a popular children's cartoon character."
msgstr ""
"Un torchon à vaisselle sur lequel est imprimé un personnage populaire de "
"cartoon d'enfant."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
msgid "A novelty dish towel which reads \"IT'S WINE O CLOCK\"."
msgstr "Une serviette fantaisie sur laquelle on peut lire « C'EST L'HEURE DU VIN »."

#: data/json/items/tool/toiletries.json
#. ~ Snippet of item "dish towel"
