#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built brick wall"
msgstr "mur en briques à moitié construit"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built brick wall"
msgid ""
"Half of a brick wall.  It requires some more resources and effort before it'd "
"be considered a suitable wall."
msgstr ""
"Une section de mur en briques à moitié finie. Plus de briques et d'effort "
"vont être nécessaire avant que ceci ait assez de hauteur pour bloquer un "
"assaut ou soutenir un toit."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "brick wall"
msgstr "mur en briques"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "brick wall"
msgid ""
"A solid brick wall, sturdy enough to support a roof with enough walls and to "
"keep out any unwanted visitors."
msgstr ""
"Une section de mur en briques assez solide pour soutenir un toit et repousser "
"la plupart des assauts."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "stone wall"
msgstr "mur en pierres"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "stone wall"
msgid "A sturdy stone wall."
msgstr "Un mur solide en pierre."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "whitewashed stone masonry wall"
msgstr "mur en pierre blanchie"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "whitewashed stone masonry wall"
msgid ""
"A wall of carefully cut and laid stones, joined with mortar.  The exterior "
"has been finished with plaster and whitewashed."
msgstr ""
"Un mur en pierres soigneusement taillées et posées, jointées avec du mortier. "
"L'extérieur a été fini avec du plâtre et blanchi à la chaux."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built stone wall"
msgstr "mur en pierres inachevé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built stone wall"
msgid ""
"Half of a sturdy stone wall.  Some work still needs to be done before it can "
"be considered a suitable wall."
msgstr ""
"Une section de mur en pierre solide à moitié finie.  Plus de pierre et "
"d'effort vont être nécessaire avant que ceci ait assez de hauteur pour "
"bloquer un assaut ou soutenir un toit."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "smoothed rock"
msgstr "roche lisse"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "smoothed rock"
msgid ""
"A block of stone that's been smoothed and shaped, commonly granite or marble "
"for funerary chapels and mausoleums."
msgstr ""
"Un bloc de pierre lissé et façonné, généralement en granit ou en marbre pour "
"les chapelles funéraires et les mausolées."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built adobe wall"
msgstr "mur d'adobe inachevé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built adobe wall"
msgid ""
"Half of an adobe brick wall.  It requires some more resources and effort "
"before it'd be considered a suitable wall."
msgstr ""
"Une section de mur en briques d'adobes à moitié finie.  Plus de briques et "
"d'effort vont être nécessaire avant que ceci ait assez de hauteur pour "
"bloquer un assaut ou soutenir un toit."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "adobe wall"
msgstr "mur d'adobe"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "adobe wall"
msgid ""
"A solid adobe brick wall that's both sturdy enough to support a roof and keep "
"out any unwanted visitors."
msgstr ""
"Un mur de briques crues solides, à la fois robuste pour supporter un toit et "
"pour tenir les visiteurs indésirables à distance."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "concrete wall with ropes"
msgstr "mur de béton avec cordes"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "concrete wall with ropes"
msgid "A boxlike wall of concrete with ropes attached to the exterior edges."
msgstr ""
"Un mur en béton en forme de boîte avec des cordes attachées aux bords "
"extérieurs.\""

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "corrugated metal wall"
msgstr "mur en tôle ondulée"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "corrugated metal wall"
msgid ""
"A wall made from a thin sheet of corrugated steel held in a frame, weather- "
"and windproof but not very insulating or durable."
msgstr ""
"Une section de mur consistant d'une plaque peu épaisse de tôle maintenue en "
"place par des tiges de ferraille ou de bois.  Passable pour se protéger du "
"vent et des intempéries, mais pas vraiment capable de bloquer un assaut ou "
"garder la chaleur."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "bulkhead"
msgid ""
"An industrially fabricated thick sheet carefully positioned, this wall is "
"capable of resisting extreme elements as well as hostile forces."
msgstr ""
"Une paroi en métal fabriquée sur mesure et attentivement positionnée et "
"sécurisée pour pouvoir resister à la fois à la furie des éléments et aux "
"forces hostiles."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built simple concrete wall"
msgstr "mur simple en béton inachevé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built simple concrete wall"
msgid ""
"A partially-poured concrete wall that could probably keep anything behind it "
"quite safe if it were finished."
msgstr ""
"Un mur en béton à moitié construit qui devrait être probablement être capable "
"de garder tout derrière très en sécurité lors-ce que celui-ci sera achevé."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built reinforced concrete wall"
msgstr "mur en béton armé à moitié construit"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built reinforced concrete wall"
msgid ""
"Poured concrete with methodically placed rebar sticking out, which isn't "
"practical for supporting roofs or shelter.  It needs more resources before it "
"could be considered complete."
msgstr ""
"Un section de mur en béton coulé avec des barres d'armature placées "
"méthodiquement à travers, mais en pointant encore toujours, ceci n'a pas "
"encore une hauteur pratique pour supporter un toit et aura besoin de plus de "
"travail et ressources avant de pouvoir être considéré comme complet."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "rebar cage"
msgstr "treillis d'acier"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "rebar cage"
msgid ""
"A structural support system made of rebar that appears to be the early stages "
"of a reinforced concrete wall, just missing the poured concrete."
msgstr ""
"Un système de barres d'armature entrecroisées pour fournir un support "
"structurel à un mur, il reste juste à couler le béton."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "simple metal wall"
msgstr "mur en métal"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "simple metal wall"
msgid ""
"A relatively simple wall made of cobbled-together scrap metal.  It's still "
"capable of blocking intruders and supporting a roof with adjacent walls."
msgstr ""
"Une section de mur assez rudimentaire assemblé à partir de morceaux de "
"ferraille, mais comme même assez solide pour tenir contre la plupart des "
"assauts et soutenir un toit."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built simple metal wall"
msgstr "mur en métal inachevé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built simple metal wall"
msgid ""
"A partially-built makeshift metal wall that could potentially support a roof "
"if it were completed."
msgstr ""
"Un mur métallique de fortune inachevé qui pourrait potentiellement supporter "
"un toit s'il était terminé."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "chipped wood wall"
msgstr "mur en bois ébréché"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "chipped wood wall"
msgid ""
"A wall of aligned planks that's starting to crack and break open.  Some "
"replacement wood and a number of nails could patch this up quick."
msgstr ""
"Une section de mur en planches alignées un peu amochées craquées ici et là.  "
"Rien qu'un peu de bois et quelques clous ne pourrait pas raccommoder."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "broken wood wall"
msgstr "mur en bois cassé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "broken wood wall"
msgid ""
"A number of planks are missing and the structure is beginning to sag and fall "
"apart.  It's going to need quite a bit of work to repair."
msgstr ""
"Une section de mur en planches donnant l'air d'être sur le point de "
"s'éffondrer, un bon nombre de planches ont été réduites en morceaux.  Réparer "
"tout cela va demander beaucoup de boulot."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "burnt wall"
msgstr "mur brûlé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "burnt wall"
msgid ""
"Whatever this wall used to be made of, it's little more than charred remains "
"now."
msgstr ""

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built log wall"
msgstr "mur de rondins inachevé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built log wall"
msgid ""
"A half-constructed wall of notched logs that interlock to provide stability.  "
"Needs a few more logs to hold up a roof.  Looks flammable."
msgstr ""
"Un mur inachevé en rondins de bois emboîtés pour fournir de la stabilité. "
"Nécessite quelques rondins supplémentaires pour soutenir un toit. Semble "
"inflammable."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "log wall"
msgstr "mur de rondins"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "log wall"
msgid ""
"A tall wall of timber suitable for housing and insulating from the weather.  "
"Quite flammable."
msgstr ""
"Un haut mur en bois adapté pour l'habitation et l'isolation contre les "
"intempéries. Très inflammable."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "chipped log wall"
msgstr "mur de rondins ébréché"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "chipped log wall"
msgid ""
"A moderately damaged log wall, it could probably be patched up with some "
"planks and nails."
msgstr ""
"Une section de mur en bûches amochée, vous pourriez probablement le réparer "
"avec quelques planches et clous."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "broken log wall"
msgstr "mur de rondins cassé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "broken log wall"
msgid ""
"A destroyed log wall, with only a supporting log left, ready to collapse.  "
"Looks repairable if the damage was replaced and patched together with nails "
"and planks."
msgstr ""
"Une section de mur en bûches détruite ne possédant plus qu'une bûche de "
"support prête à s'éffondrer.  Ceci à l'air toute de même réparable si vous "
"avez des planches et des clous à disposition."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "palisade wall"
msgstr "palissade"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "palisade wall"
msgid ""
"An age-old type of fortification consisting of hefty lumber staked into the "
"ground and cabled together."
msgstr ""
"Un type de fortification millénaire consistant de troncs de bois rangé en "
"ligne et attachés ensemble."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "wattle-and-daub wall"
msgstr "mur en torchis"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "wattle-and-daub wall"
msgid ""
"A relatively primitive wall made by daubing together a lattice of wooden "
"strips using some combination of wet soil, clay, sand, animal dung, and straw."
msgstr ""
"Un section de mur utilisant une méthode assez primitive où un cadre en bois "
"est remplie d'une combinaison de terre humide, d'argile, de sable, de selles "
"animales et de paille."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "broken wattle-and-daub wall"
msgstr "mur en torchis cassé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "broken wattle-and-daub wall"
msgid ""
"A wattle-and-daub wall section that has been destroyed, leaving mostly just "
"the frame, and even that is barely held together."
msgstr ""
"Une section de mur en torchis ayant été détruite, laissant à peine le cadre, "
"et même celui-ci a vu de meilleurs jours."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built wattle-and-daub wall"
msgstr "demi-mur en torchis"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built wattle-and-daub wall"
msgid ""
"A partially-complete wattle-and-daub wall with some of the wooden strip "
"lattice in place.  It still requires the rest of the lattice and supporting "
"wet compound to be filled in."
msgstr ""
"Une section de mur en torchis à moitié finie ayant une partie de son cadrage "
"en bois en place.  Pour l'achever vous aurez besoin d'installer le reste du "
"cadrage et remplir celui-ci."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "junk metal wall"
msgstr "mur en ferraille"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "junk metal wall"
msgid ""
"A wall of rusty scrap metal bolted and wire-tied to a sturdy frame.  Very "
"fashionable in post-apocalyptic shantytowns.  Can support a roof."
msgstr ""
"Un mur de métal rouillé boulonné et attaché avec du fil à un cadre robuste. "
"Très à la mode dans les bidonvilles post-apocalyptiques. Peut supporter un "
"toit."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "rammed earth wall"
msgstr "mur en pisé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "rammed earth wall"
msgid ""
"A solid wall of compressed dirt, sturdy enough to support a roof with enough "
"walls and to keep out some unwanted visitors."
msgstr ""
"Un mur solide en terre comprimée, suffisamment robuste pour supporter un toit "
"avec suffisamment de murs et pour tenir les visiteurs indésirables à distance."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Bashing sound
msgid "heavy rumbling!"
msgstr "un grondement lourd !"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "smooth dirt wall"
msgstr "mur de terre lisse"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "smooth dirt wall"
msgid ""
"A solid wall of compressed dirt, mixed with… something to keep it stable.  "
"Its surface glistens slightly, and it smells like rotten milk."
msgstr ""
"Un mur de terre compressée mélangée avec… quelque chose pour apporter plus de "
"stabilité.  La surface reflète la lumière légèrement et le tout à une odeur "
"légère de lait caillé."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "warped wall"
msgstr "mur déformé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "warped wall"
msgid ""
"At first glance, this looks like a simple stone wall.  But the angles don't "
"add up, and the shadows are wrong.  Whatever this is, it doesn't belong here."
msgstr ""
"Au premier regard, ceci n'a l'air d'être qu'un mur en pierre tout à fait "
"normale, mais plus vous y faites attention, plus vous vous rendez compte que "
"les angles ne sont pas normaux et les ombres vous donnent la migraine. Peu "
"importe ce qui est en train de causer ceci, ce n'est pas quelque chose qui "
"devrait exister."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "junk metal barrier"
msgstr "barrière de ferraille"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "junk metal barrier"
msgid ""
"A simple wall of rusty scrap metal bolted and wire-tied to a makeshift frame. "
" Very fashionable in post-apocalyptic shantytowns.  This one isn't quite "
"strong enough to support a roof, but could be reinforced."
msgstr ""
"Un mur simple en métal rouillé boulonné et attaché avec du fil à un cadre de "
"fortune. Très à la mode dans les bidonvilles post-apocalyptiques. Celui-ci "
"n'est pas assez solide pour supporter un toit, mais pourrait être renforcé."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "glass wall"
msgstr "mur en verre"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "glass wall"
msgid ""
"A barrier made of glass, it's nothing complicated, and looks extremely "
"fragile.  Some contain glass break sensors or window sensors that trigger an "
"alarm if the glass is damaged."
msgstr ""
"Un vitrine en verre, rien de compliqué et extrêmement fragile. Certains "
"contiennent des capteurs capables de déclencher une alarme si le verre est "
"brisé ou quelque chose passe à travers."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "laminated glass"
msgstr "verre feuilleté"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "laminated glass"
msgid ""
"A laminated glass barrier, composed of layers of glass and plastic held "
"together by an interlayer."
msgstr ""
"Une barrière de verre feuilleté, composée de couches de verre et de plastique "
"maintenues ensemble par un intercouche."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "ballistic glass"
msgstr "verre pare-balle"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "ballistic glass"
msgid "A ballistic glass barrier, consisting of layers of laminated glass."
msgstr "Une barrière de verre balistique, composée de couches de verre feuilleté."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "reinforced glass"
msgstr "verre renforcé"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "reinforced glass"
msgid ""
"A thicker pane of glass with thin metal wires embedded throughout, "
"strengthening the structural properties.  Still weaker than other types of "
"walls, and not made to support a roof either."
msgstr ""
"Une vitre plus épaisse avec de fins fils métalliques incrustés partout, "
"renforçant les propriétés structurelles. Toujours plus faible que d'autres "
"types de murs, et non conçue pour supporter un toit non plus."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "reinforced glass with closed shutters"
msgstr "verre renforcé avec volets fermés"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "reinforced glass with closed shutters"
msgid ""
"A secondary layer of protection over reinforced glass, these metal shutters "
"are typically used to ward off criminals or protect against damage from "
"extreme weather.  Looks like it can only be opened from the inside.  Even "
"with the installed shutters, it isn't feasible in supporting a roof."
msgstr ""
"Une couche de protection secondaire sur le verre renforcé, ces volets "
"métalliques sont généralement utilisés pour repousser les criminels ou "
"protéger contre les dommages causés par les intempéries. Il semble qu'ils ne "
"peuvent être ouverts que de l'intérieur. Même avec les volets installés, il "
"n'est pas envisageable de supporter un toit."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "reinforced glass with open shutters"
msgstr "verre renforcé avec volets ouverts"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "reinforced glass with open shutters"
msgid ""
"Hanging metal shutters that haven't been deployed, exposing the reinforced "
"glass.  It appears as though the metal shutters can only be activated from "
"the inside."
msgstr ""
"Volets métalliques suspendus qui n'ont pas été déployés, exposant le verre "
"renforcé. Il semble que les volets métalliques ne peuvent être activés que de "
"l'intérieur."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "lighthouse lens"
msgstr "lentille de phare"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "lighthouse lens"
msgid ""
"An intricate arrangement of glass, designed to focus light from within to be "
"visible over long distances."
msgstr ""
"Un arrangement complexe de verre, conçu pour concentrer la lumière de "
"l'intérieur afin qu'elle soit visible sur de longues distances."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "metal bars"
msgstr "barres de métal"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "metal bars"
msgid ""
"Thick, heavy bars from the floor to the ceiling, interlaced wall to wall.  "
"Not made to support roofs, but great for blocking paths."
msgstr ""
"Des barreaux épais et lourds allant du sol au plafond, entrelacés de mur en "
"mur. Non conçus pour supporter des toits, mais excellents pour bloquer les "
"passages."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "paper wall"
msgstr "mur de papier"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "paper wall"
msgid ""
"A huge wall of ambiguous pulpy matter, covered in sticky wasp saliva.  You "
"could smash it down effortlessly."
msgstr ""
"Un immense mur de matière pulpeuse ambiguë, recouvert de salive collante de "
"guêpe. Vous pourriez le démolir sans effort."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "layered paper wall"
msgstr "mur en papier mâché stratifié"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "layered paper wall"
msgid ""
"A thick wall of layered tree pulp and wasp saliva, hardened to withstand the "
"elements.  You could break through this, but it won't be easy."
msgstr ""
"Un mur épais de pulpe d'arbre et de salive de guêpe stratifié, durci pour "
"résister aux intempéries. Vous pourriez le percer, mais ce ne sera pas facile."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "root wall"
msgstr "mur racine"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "root wall"
msgid "A dirt wall covered with roots."
msgstr "Un mur de terre recouvert de racines."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "wax wall"
msgstr "mur de cire"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "wax wall"
msgid "A wall made entirely out of wax."
msgstr "Un mur composé de cire d'insecte pure."

#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_mall.json
#: data/json/overmap/overmap_terrain/overmap_terrain_special.json
#: data/mods/Magiclysm/worldgen/overmap_terrain.json
#: data/mods/No_Hope/overmap/overmap_terrain_necropolis.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "solid earth"
msgstr "terre"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "solid earth"
msgid "A wall of solid earth."
msgstr "Un mur de terre solide."

#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/overmap/overmap_terrain/overmap_terrain_hardcoded.json
#: data/json/overmap/overmap_terrain/overmap_terrain_netherum_labyrinth.json
#: data/json/overmap/overmap_terrain/overmap_terrain_special.json
#: data/mods/Magiclysm/worldgen/overmap_terrain.json
#: data/mods/No_Hope/overmap/overmap_terrain_necropolis.json
#: data/mods/innawood/mining/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "solid rock"
msgstr "roche brute"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "solid rock"
msgid ""
"A wall of solid rock, could be full of all kinds of interesting things.  Best "
"grab your pickaxe or equivalent digging implement, and strike the earth!"
msgstr ""
"\"Un mur de roche solide, qui pourrait contenir toutes sortes de choses "
"intéressantes. Prenez votre pioche ou un outil de creusement équivalent, et "
"frappez la terre !"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "red stone"
msgstr "pierre rouge"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "red stone"
msgid "A wall of red stone."
msgstr "Un mur de pierre rouge."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "green stone"
msgstr "pierre verte"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "green stone"
msgid "A wall of green stone."
msgstr "Un mur de pierre verte."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "blue stone"
msgstr "pierre bleue"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "blue stone"
msgid "A wall of blue stone."
msgstr "Un mur de pierre bleu."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "little column"
msgstr "petite colonne"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "little column"
msgid "A small support column."
msgstr "Un petit support de colonne."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "half-built column"
msgstr "Une colonne à moitié construite."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "half-built column"
msgid ""
"An empty wooden frame in the shape of a column, built around a concrete and "
"rebar foundation.  It isn't capable of supporting roofs or shelter, and needs "
"more resources before it could be considered complete."
msgstr ""
"Un coffrage en bois vide en forme de colonne construit autour d'une fondation "
"en béton et barres d'armature. Il n'est pas capable de supporter des toits ou "
"des abris et semble avoir besoin de plus de ressources avant d'être considéré "
"comme terminé."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "column"
msgstr "colonne"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "column"
msgid "A concrete column."
msgstr "Une colonne en béton."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "bollard"
msgstr "borne de sécurité"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "bollard"
msgid ""
"A set of concrete and steel bollards sticking out of the ground, designed to "
"protect areas against vehicle ram attacks.  It requires a few more steps for "
"you to walk between the bollards."
msgstr ""
"Un set de bornes en béton armé émergeant du sol et conçues pour protéger des "
"zones piétonnes d'attaque au véhicule bélier. Vous avez besoin de contourner "
"les bornes et ceci rends la traversée à pied légèrement plus longue que la "
"normale."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "large metal support"
msgstr "large support métallique"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "large metal support"
msgid "A heavy-duty metal support beam."
msgstr "Une poutre de support en métal robuste."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "small metal support"
msgstr "petit support métallique"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "small metal support"
msgid "A metal support beam."
msgstr "Une poutre de support métallique."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "field stone wall"
msgstr "mur en pierre des champs"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "field stone wall"
msgid "A sturdy, dry stone wall.  Just rocks fitted together without mortar."
msgstr "Un mur de pierres sèches solide."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "field stone half-wall"
msgstr "demi mur en pierre des champs"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "field stone half-wall"
msgid ""
"A sturdy, half-height, dry stone wall.  Just rocks fitted together without "
"mortar."
msgstr ""
"Un solide mur de pierres sèches à mi-hauteur. Il s'agit de pierres assemblées "
"sans mortier."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "pillar"
msgstr "Pilier"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "pillar"
msgid ""
"A concrete column that helps keep the mine's ceiling and walls from "
"collapsing."
msgstr ""
"Un pilier en béton qui soutient le plafond et les murs de la mine et les "
"empêche de s'effondrer."

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "hardened resin mass"
msgstr "masse de résine durcie"

#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Description of terrain "hardened resin mass"
msgid ""
"A mass of expansive foam that has hardened like a rock, tough enough to stop "
"most zombies from breaking through.  It's big enough to walk ontop of."
msgstr ""
"Un amas de mousse s'étant solidifiée comme de la pierre, assez solide pour "
"empêcher la plupart des zombies de charger à travers et assez large pour "
"marcher au-dessus."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window"
msgstr "fenêtre"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window"
msgid ""
"A giant sheet of glass inserted into a window, typically found on the side of "
"shops to showcase goods."
msgstr ""
"Un panneau de verre inséré dans un cadre de fenêtre vide, typiquement utilisé "
"dans les vitrines de magasin."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "taped window"
msgstr "fenêtre masquée"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped window"
msgid ""
"Duct tape covers this window, blocking sunlight and visibility.  You could "
"remove the duct tape by cutting it off."
msgstr ""
"Du gros ruban adhésif couvre cette fenêtre, bloquant la lumière et la "
"visibilité. Vous pourriez retirer cet adhésif en le coupant."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with curtains"
msgstr "fenêtre avec rideaux"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with curtains"
msgid ""
"A closed window with fancy curtains on the inside that can be drawn closed to "
"block visibility and shut out any light."
msgstr ""
"Une fenêtre fermée avec des rideaux fantaisie à l'intérieur qui peuvent être "
"tirés pour bloquer la visibilité et empêcher la lumière de passer."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying message of terrain "window with curtains"
#. ~ Prying message of terrain "window without curtains"
#. ~ Prying message of terrain "window with closed curtains"
msgid "You pry open the window."
msgstr "Vous forcez l'ouverture de la fenêtre."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying failure of terrain "window with curtains"
#. ~ Prying failure of terrain "window without curtains"
#. ~ Prying failure of terrain "window with closed curtains"
msgid "You pry, but can't pry open the window."
msgstr "Vous faites levier, mais ne pouvez pas faire levier pour ouvrir la fenêtre."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window without curtains"
msgstr "fenêtre sans rideaux"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window without curtains"
msgid ""
"A closed smaller window typically found in residential homes.  You could "
"install a curtain rod and drapes to block visibility and shut out any light "
"if you had the supplies and skill."
msgstr ""
"Un petite fenêtre fermée commune dans les maisons résidentielles trop petite "
"pour laisser une personne passer. Vous pourriez y installer un rideau pour "
"bloquer lumière et visibilité avec les matériaux et compétences nécessaires."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open window without curtains"
msgstr "fenêtre ouverte sans rideaux"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open window without curtains"
msgid ""
"A smaller window typically found in residential homes.  It's open and can be "
"crawled through."
msgstr ""
"Une petite fenêtre généralement trouvée dans les maisons résidentielles. Elle "
"est ouverte et on peut y ramper."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped window"
msgid ""
"A smaller window typically found in residential homes.  This one has been "
"blocked out with duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Une petite fenêtre commune dans les maisons résidentielles trop petite pour "
"laisser une personne passer ayant été occluse avec du ruban adhésif opaque. "
"Vous pourriez retirer le ruban adhésif en le coupant."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped window"
msgid ""
"A window with fancy curtains on the inside.  This one has been blocked out "
"with duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Une fenêtre équipée d'un rideau. Celle-ci est pour l'instant fermée et a été "
"occluse avec du ruban adhésif opaque. Vous pourriez retirer le ruban adhésif "
"en le coupant."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open window with curtains"
msgstr "fenêtre ouverte avec rideaux"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open window with curtains"
msgid ""
"A window with fancy curtains on the inside that can be drawn closed to block "
"visibility and shut out any light.  It's open and you can crawl through."
msgstr ""
"Une fenêtre ouverte équipée d'un rideau étant pour l'instant ouvert mais "
"pouvant être fermé pour bloquer visibilité et lumière. Vous pourriez ramper à "
"travers."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with closed curtains"
msgstr "fenêtre avec rideaux fermés"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with closed curtains"
msgid ""
"A closed window with fancy curtains that have been drawn shut, blocking "
"sunlight and visibility.  The curtains can only be opened from the inside.  "
"If you examined the curtains more closely, you could peek through the drapes "
"or tear down everything.  Or you could just smash the window open."
msgstr ""
"Une fenêtre fermée, son rideau tiré pour bloquer visibilité et lumière. "
"Celui-ci ne peut être ouvert que de l'intérieur, l'examiner de plus près vous "
"permettrait de choisir de jeter un coup d'œil dehors en le soulevant "
"discrètement, l'ouvrir ou l'enlever de la fenêtre. Vous pourriez aussi "
"simplement juste briser la fenêtre."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped window"
msgid ""
"Duct tape covers this window, blocking out any sunlight and visibility.  You "
"could remove the duct tape by cutting it off."
msgstr ""
"Cette fenêtre a été recouverte de ruban adhésif pour bloquer toute visibilité "
"et lumière. Vous pourriez retirer le ruban adhésif en le coupant."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "empty window"
msgstr "fenêtre vide"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "empty window"
msgid ""
"An empty window frame made of planks and nails.  You could install a sheet of "
"glass, or board it up for protection.  You could also convert it into a solid "
"wall if you took the time to construct it."
msgstr ""
"Un cadre de fenêtre vide en bois équipé d'un rideau étant pour l'instant "
"ouvert. Vous pourriez y ajouter une vitre, ou même l'obstruer avec par "
"example des planches pour bloquer cette entrée possible. Vous pourriez aussi "
"faire de ceci un mur si vous avez le temps de le remodeler."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "empty window with curtains"
msgstr "cadre de fenêtre vide avec rideau"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "empty window with curtains"
msgid ""
"An empty window frame consisting of planks and nails, with open curtains.  "
"You could install a sheet of glass, or even board it up for protection.  You "
"could also convert it into a wall if you took the time to construct it."
msgstr ""
"Un cadre de fenêtre vide en bois équipé d'un rideau étant pour l'instant "
"ouvert. Vous pourriez y ajouter une vitre, ou même l'obstruer avec par "
"example des planches pour bloquer cette entrée possible. Vous pourriez aussi "
"faire de ceci un mur si vous avez le temps de le remodeler."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "empty window with closed curtains"
msgstr "cadre de fenêtre avec rideau fermé"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "empty window with closed curtains"
msgid ""
"An empty window frame consisting of planks and nails, with closed curtains.  "
"If you examined the curtains more closely, you could peek through the drapes "
"or tear down everything.  You could install a sheet of glass, or even board "
"it up for protection.  You could also convert it into a wall if you took the "
"time to construct it."
msgstr ""
"Un cadre de fenêtre vide composé de planches et de clous, avec des rideaux "
"fermés. Si vous examiniez les rideaux de plus près, vous pourriez voir à "
"travers les draperies ou tout arracher. Vous pourriez installer une vitre ou "
"même le boucher pour vous protéger. Vous pourriez également le transformer en "
"mur si vous preniez le temps de le construire."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window frame"
msgstr "cadre de fenêtre"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window frame"
msgid ""
"A wooden window frame filled with shattered glass.  You'll probably get hurt "
"if you crawl through the sharp and jagged shards.  You could smash out the "
"remaining pieces, or take your time and quietly remove them."
msgstr ""
"Un cadre de fenêtre dont la vitre a été brisée, des fragments acérés "
"remplissant maintenant le cadre. Dans cet état essayer de ramper à travers "
"vous blessera probablement. Vous pourriez vous débarrasser des morceaux de "
"verre en frappant dessus, mais ceci serait relativement bruyant, ou prendre "
"le temps de les enlever soigneusement un par un plus ou moins "
"silencieusement. "

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "boarded up window"
msgstr "fenêtre barricadée"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "boarded up window"
msgid ""
"A glass window that has been covered with nailed-down planks, blocking "
"sunlight and visibility.  It's not much stronger, but it could be further "
"reinforced with strategically placed planks."
msgstr ""
"Une fenêtre en verre ayant été couvertes de planches clouées obstruant "
"visibilité et lumière. Ce n'est pas beaucoup plus robuste, mais cela pourrait "
"être renforcé davantage avec quelques planches placées judicieusement."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying message of terrain "boarded up window"
msgid "You pry the boards from the window."
msgstr "Vous forcez l'ouverture de la fenêtre."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "boarded up window"
msgid ""
"An empty window frame that has been covered with nailed-down planks, blocking "
"sunlight and visibility.  It's not a very strong barrier, but it could be "
"further reinforced with strategically placed planks."
msgstr ""
"Un cadre de fenêtre vide ayant été couvert avec des planches bloquant "
"visibilité et lumière. Ceci n'est pas beaucoup plus robuste, mais pourrait "
"être davantage renforcé avec quelques planches placées judicieusement."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying message of terrain "boarded up window"
msgid "You pry the boards from the window frame."
msgstr "Vous forcez l'ouverture de la fenêtre."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with makeshift shutters"
msgstr "fenêtre avec volets improvisés"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with makeshift shutters"
msgid ""
"A glass window with a heavy makeshift shutter bolted into the window frame, "
"with a wooden bar to close it from the inside.  It's fairly sturdy when "
"closed."
msgstr ""

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with open makeshift shutters"
msgstr "fenêtre avec volets improvisés ouverts"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with open makeshift shutters"
msgid ""
"A glass window with a heavy makeshift shutter bolted into the window frame, "
"with a wooden bar to close it from the inside.  The shutters are currently "
"open, and offer no more defense than any glass window."
msgstr ""

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Prying message of terrain "window with open makeshift shutters"
msgid "You pry the window open"
msgstr ""

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with open makeshift shutters"
msgid ""
"A glass window with a heavy makeshift shutter bolted into the window frame, "
"with a wooden bar to close it from the inside.  Both the shutters and the "
"window glass are wide open, offering no defense."
msgstr ""

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "reinforced boarded up window"
msgstr "fenêtre barricadée renforcée"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced boarded up window"
msgid ""
"A heavily fortified glass window with planks carefully placed across the "
"glass to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Une fenêtre en verre renforcée avec des planches rendue encore plus solide "
"avec quelques planches fixées judicieusement pour bloquer visibilité et "
"lumière. Y ajouter quelques pics et des plaques en métal pour la renforcer "
"encore davantage serait possible."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced boarded up window"
msgid ""
"A heavily fortified window with planks carefully placed across the open frame "
"to block vision.  Adding a few spikes and metal plating would further "
"increase its durability."
msgstr ""
"Un cadre de fenêtre renforcé avec des planches rendu encore plus solide avec "
"quelques planches fixées judicieusement pour bloquer visibilité et lumière. Y "
"ajouter quelques pics et des plaques en métal pour la renforcer encore "
"davantage serait possible."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "armored boarded up window"
msgstr "fenêtre barricadée blindée"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "armored boarded up window"
msgid ""
"This once-normal glass window now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Cette fenêtre autrefois normale est maintenant menaçante avec des pointes le "
"long des bords, renforcée par des plaques de métal placées laborieusement "
"sous les renforts en bois."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "armored boarded up window"
msgid ""
"This once-normal window frame now menaces with spikes along the edges, with "
"laboriously placed metal sheeting to further strengthen the wooden "
"reinforcements underneath."
msgstr ""
"Cette fenêtre autrefois normale est maintenant menaçante avec des pointes le "
"long des bords, renforcée par des plaques de métal placées laborieusement "
"sous les renforts en bois."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with metal bars"
msgstr "fenêtre avec barres métalliques"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal bars"
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed in high-value "
"stores, or ones in bad neighborhoods."
msgstr ""
"Une immense plaque de verre insérée dans une fenêtre avec d'épaisses grilles "
"de sécurité, rendant impossible d'y ramper. Généralement installée dans les "
"magasins de grande valeur ou dans les mauvais quartiers."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window frame with metal bars"
msgstr "cadre de fenêtre avec barres en métal"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window frame with metal bars"
msgid ""
"A window frame blocked with thick security grilles, making it impossible to "
"crawl through.  Typically installed in high-value stores, or ones in bad "
"neighborhoods."
msgstr ""
"Un cadre de fenêtre bloqué par d'épaisses grilles de sécurité, rendant "
"impossible d'y ramper. Généralement installées dans les magasins de grande "
"valeur ou dans les mauvais quartiers."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal bars"
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed in high-value "
"stores, or ones in bad neighborhoods.  It has a small sticker in one corner, "
"reading 'Protected by SecuriCorp.  Keeping you safe since 1993.'"
msgstr ""

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with metal bars and curtains"
msgstr "fenêtre avec barreaux métalliques et rideaux"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal bars and curtains"
msgid ""
"A barred window with fancy curtains that have been drawn shut, blocking "
"sunlight and visibility.  The curtains can only be opened from the inside.  "
"If you examined the curtains more closely, you could peek through the drapes "
"or tear down everything."
msgstr ""
"Une fenêtre à barreaux en métal équipée d'un rideau ayant été tiré pour "
"bloquer toute visibilité et lumière. Le rideau est tiré pour bloquer "
"visibilité et lumière. Celui-ci ne peut être ouvert que de l'intérieur, "
"l'examiner de plus près vous permettrait de choisir de jeter un coup d'œil "
"dehors en le soulevant discrètement, l'ouvrir ou l'enlever de la fenêtre."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal bars and curtains"
msgid ""
"A giant sheet of glass inserted into a window with thick security grilles, "
"making it impossible to crawl through.  Typically installed in high-value "
"stores, or ones in bad neighborhoods.  This one has been retrofitted with "
"curtains, which are currently open."
msgstr ""
"Une immense plaque de verre insérée dans une fenêtre avec d'épaisses grilles "
"de sécurité, rendant impossible d'y ramper. Généralement installées dans les "
"magasins de grande valeur ou dans les mauvais quartiers. Celle-ci a été "
"modernisée avec des rideaux, qui sont actuellement ouverts."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "stone wall with high stained glass window"
msgstr "mur de pierre avec grande fenêtre en vitrail"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "stone wall with high stained glass window"
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an elegant emerald landscape."
msgstr ""
"Un mur de pierre avec une grande fenêtre en vitrail représentant un paysage "
"émeraude élégant."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Bashing sound
msgid "a crash and glass breaking!"
msgstr "un crash et du verre qui se brise !"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "stone wall with high stained glass window"
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an otherworldly radiant ruby flower blooming."
msgstr ""
"Un mur de pierre avec une grande fenêtre en vitrail représentant une fleur de "
"rubis radieuse et surnaturelle en pleine floraison."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "high stained glass window"
msgstr "vitrail"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "high stained glass window"
msgid ""
"A stone wall with a high window containing breathtaking craftsmanship of "
"stained glass featuring an alluring azure oceanic abyss."
msgstr ""
"Un mur de pierre avec une grande fenêtre en vitrail représentant un abysse "
"océanique azur fascinant."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with metal grate"
msgstr "fenêtre avec grille métallique"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate"
msgid ""
"Metal bars made into a grate for a glass window.  Highly durable and will "
"stand against any foe."
msgstr ""
"Barreaux métalliques formant une grille pour une fenêtre en verre, très "
"durables et résistantes à tous les ennemis."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "window with metal grate and curtains"
msgstr "fenêtre avec grille métallique et rideaux"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate and curtains"
msgid ""
"Metal bars made into a grate for a glass window with a closed curtain.  "
"Highly durable and will stand against any foe."
msgstr ""
"Barreaux métalliques formant une grille pour une fenêtre en verre avec un "
"rideau fermé. Très durables et résistantes à tout ennemi."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate and curtains"
msgid ""
"Metal bars made into a grate for a glass window with an opened curtain.  "
"Highly durable and will stand against any foe."
msgstr ""
"Barreaux métalliques formant une grille pour une fenêtre en verre avec un "
"rideau ouvert. Très durables et résistantes à tout ennemi."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate"
msgid ""
"Metal bars made into a grate for an empty window.  Highly durable and will "
"stand against any foe."
msgstr ""

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate and curtains"
msgid ""
"Metal bars made into a grate for an empty window frame with a closed curtain. "
" Highly durable and will stand against any foe."
msgstr ""
"Barreaux métalliques formant une grille pour une fenêtre vide avec un rideau "
"fermé. Très durables et résistantes à tout ennemi."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "window with metal grate and curtains"
msgid ""
"Metal bars made into a grate for an empty window frame with an opened "
"curtain.  Highly durable and will stand against any foe."
msgstr ""
"Barreaux métalliques formant une grille pour une fenêtre vide avec un rideau "
"ouvert. Très durables et résistantes à tout ennemi."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "single glazed window"
msgstr "fenêtre à simple vitrage"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "single glazed window"
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's currently closed."
msgstr ""
"Une fenêtre simple vitrage. Contient une grande plaque de verre insérée dans "
"un cadre de fenêtre. Elle est actuellement fermée."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open single glazed window"
msgstr "fenêtre à simple vitrage ouverte"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open single glazed window"
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's open and can be crawled through."
msgstr ""
"Une fenêtre à simple vitrage en verre ouverte. Consiste d'une seule vitre en "
"verre insérée dans un cadre de fenêtre. Vous pourriez ramper à travers."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "single glazed window with closed curtains"
msgstr "fenêtre à simple vitrage avec rideau fermé"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "single glazed window with closed curtains"
msgid ""
"A closed single glazed window with a fancy curtain on the inside that is "
"closed to block visibility and shut out any light."
msgstr ""
"Une fenêtre à simple vitrage fermée. Consiste d'une seule vitre en verre "
"insérée dans un cadre de fenêtre. Équipée d'un rideau tiré pour bloquer "
"visibilité et lumière. Celui-ci ne peut être ouvert que de l'intérieur, "
"l'examiner de plus près vous permettrait de choisir de jeter un coup d'œil "
"dehors en le soulevant discrètement, l'ouvrir ou l'enlever de la fenêtre."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "single glazed window with curtains"
msgstr "fenêtre à simple vitrage avec rideau"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "single glazed window with curtains"
msgid ""
"A closed single glazed window with a fancy curtain on the inside that can be "
"drawn closed to block visibility and shut out any light."
msgstr ""
"Une fenêtre à simple vitrage fermée. Consiste d'une seule vitre en verre "
"insérée dans un cadre de fenêtre. Équipée d'un rideau étant pour l'instant "
"ouvert mais pouvant être fermé pour bloquer visibilité et lumière."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open single glazed window with curtains"
msgstr "fenêtre à simple vitrage ouverte avec rideau"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open single glazed window with curtains"
msgid ""
"A single glazed window with a fancy curtain on the inside that can be drawn "
"closed to block visibility and shut out any light.  It's open and can be "
"crawled through."
msgstr ""
"Une fenêtre à simple vitrage ouverte. Consiste d'une seule vitre en verre "
"insérée dans un cadre de fenêtre. Équipée d'un rideau étant pour l'instant "
"ouvert mais pouvant être fermé pour bloquer visibilité et lumière. Vous "
"pourriez ramper à travers."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "taped single glazed window"
msgstr "fenêtre à simple vitrage couverte de ruban adhésif"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "taped single glazed window"
msgid ""
"A single glazed window.  Consists of a giant sheet of glass inserted into a "
"window frame.  It's currently closed.  This one has been blocked out with "
"duct tape.  You could remove the duct tape by cutting it off."
msgstr ""
"Une fenêtre à simple vitrage. Consiste d'une seule vitre en verre insérée "
"dans un cadre de fenêtre. Celle-ci est pour l'instant fermée et a été occluse "
"avec du ruban adhésif opaque. Vous pourriez retirer le ruban adhésif en le "
"coupant."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "reinforced single glazed window"
msgstr "fenêtre à simple vitrage renforcée"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced single glazed window"
msgid ""
"A reinforced single glazed window.  Consists of a giant sheet of reinforced "
"glass inserted into a window frame.  It's currently closed."
msgstr ""
"Une fenêtre à simple vitrage renforcée. Consiste d'une seule vitre en verre "
"renforcé inséré dans un cadre de fenêtre. Celle-ci est pour l'instant fermée."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "open reinforced single glazed window"
msgstr "fenêtre à simple vitrage renforcée ouverte"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "open reinforced single glazed window"
msgid ""
"A reinforced single glazed window.  Consists of a giant sheet of reinforced "
"glass inserted into a window frame.  It's open and can be crawled through."
msgstr ""
"Une fenêtre à simple vitrage renforcée ouverte. Consiste d'une seule vitre en "
"verre renforcé insérée dans un cadre de fenêtre. Vous pourriez ramper à "
"travers."

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Terrain name
msgid "reinforced single glazed window with closed curtains"
msgstr "fenêtre à simple vitrage renforcée avec rideau fermé"

#: data/json/furniture_and_terrain/terrain-windows.json
#. ~ Description of terrain "reinforced single glazed window with closed
#. curtains"
msgid ""
"A closed reinforced single glazed window with a fancy curtain on the inside "
"that is drawn closed to block visibility and shut out any light."
msgstr ""
"Une fenêtre à simple vitrage renforcée fermée. Consiste d'une seule vitre en "
"verre renforcé insérée dans un cadre de fenêtre, son rideau tiré pour bloquer "
"visibilité et lumière. Celui-ci ne peut être ouvert que de l'intérieur, "
"l'examiner de plus près vous permettrait de choisir de jeter un coup d'œil "
