#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"WHY THE FUCK are you doing this to me?\""
msgstr "\"MERDE, MAIS POURQUOI vous me faites ça?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"LEAVE!  NOW!\""
msgstr "\"PARTEZ MAINTENANT!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
