#: src/crafting.cpp:1200
#, c-format
msgid "%s helps with crafting…"
msgstr "%s vous aide avec ce projet de fabrication…"

#: src/crafting.cpp:1356
#, c-format
msgid "You mess up and destroy the %s."
msgstr "Vous ratez quelque chose et détruisez le/la %s."

#: src/crafting.cpp:1357
#, c-format
msgid "<npcname> messes up and destroys the %s"
msgstr "<npcname> gâche et détruit le %s"

#: src/crafting.cpp:1396
#, c-format
msgid "You mess up and lose %d%% progress."
msgstr "Vous faites des erreurs et perdez %d%% de vos progrès."

#: src/crafting.cpp:1397
