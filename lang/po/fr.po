#. ~ Monster attack message
#, c-format
msgid "%1$s tries to bite your %2$s, but can't penetrate your armor."
msgstr "%1$s essaie de mordre votre %2$s, mais n'arrive pas à pénétrer votre armure."

#: data/json/monsters/nether.json
#. ~ Monster attack message
#, c-format
msgid "%1$s tries to bite <npcname>'s %2$s, but can't penetrate their armor."
msgstr ""
"%1$s essaie de mordre le/la %2$s de <npcname>, mais n'arrive pas à pénétrer "
"son armure. "

#: data/json/monsters/nether.json
#. ~ Monster attack message
#, c-format
msgid "%1$s fastens onto your %2$s and greedily drinks your blood!"
msgstr "%1$s s'adhère à votre %2$s et commence à boire votre sang avidement!"

