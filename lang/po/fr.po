msgstr ""

#: data/mods/Xedra_Evolved/effects/effects.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of effect type id "effect_ierde_rooted_in_place"
#. ~ Mutation name
msgid "The Root of the Mountain"
msgstr "Les Racines de la Montagne"

#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Description of effect type "The Root of the Mountain"
msgid ""
"Drawing on the immobility of the mountain, you are resilient but rooted in "
"place."
msgstr ""
"Vous avez invoqué l'immobilité des montagnes, ceci vous permet de mieux vous "
"défendre mais vous fixe en place."

#: data/mods/Xedra_Evolved/effects/effects.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
