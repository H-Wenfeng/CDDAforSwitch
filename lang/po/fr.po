msgstr "Une échelle allant jusqu'à l'étage supérieur."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
#. ~ Description of terrain "ladder"
msgid "A ladder leading down."
msgstr "Une échelle allant jusqu'à l'étage inférieur."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
#. ~ Description of terrain "ladder"
msgid "A ladder leading up and down."
msgstr "Une échelle pouvant vous amener à l'étage inférieur ou supérieur."

