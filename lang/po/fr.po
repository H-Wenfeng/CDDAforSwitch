msgid_plural "garlanders"
msgstr[0] "guirlandier"
msgstr[1] "guirlandiers"
msgstr[2] "guirlandiers"

#: data/mods/Aftershock/mobs/aliens.json
#: data/mods/aftershock_exoplanet/monsters/aliens.json
#. ~ Description of monster "garlander"
msgid ""
"A ribbon-like alien that glides along the ground on countless hair-thin legs, "
"wrapping around sources of body heat to absorb as much as it can before "
"gliding on."
msgstr ""
"Un animal extraterrestre ressemblant plus a une guirlande se déplaçant sur "
"une multitude de pattes fines comme des cheveux qu'à un animal. Cette "
"créature étrange s'enroule autour de toute source de chaleur qu'elle peut "
"trouver jusqu'à ce qu'elles se tarissent."

#: data/mods/Aftershock/mobs/aliens.json
#: data/mods/aftershock_exoplanet/monsters/aliens.json
#. ~ Monster message of special attack of monster "garlander"
msgid "The air around the garlander feels unnaturally cold!"
msgstr ""

