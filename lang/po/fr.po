msgstr[0] "Parchemin de Reconstitution Corporelle"
msgstr[1] "Parchemins de Reconstitution Corporelle"
msgstr[2] "Parchemins de Reconstitution Corporelle"

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Description of "Scroll of Corporeal Reconstitution"
msgid "Cuts?  Lacerations?  Torn organs?  Fix all that with this handy spell."
msgstr ""
"Coupures?  Lacérations?  Organes déchirés?  Réparez tout ça avec ce sort "
"pratique."

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Item name
msgid "Scroll of Halt Bleeding"
msgid_plural "Scrolls of Halt Bleeding"
msgstr[0] "Parchemin d'Halter Hémorragie"
msgstr[1] "Parchemins d'Halter Hémorragie"
msgstr[2] "Parchemins d'Halter Hémorragie"

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Description of "Scroll of Halt Bleeding"
msgid "Keep all that blood in your body."
msgstr "Gardez tout ce sang à l'intérieur de votre corps."

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Item name
msgid "Scroll of Flensing Fingers"
msgid_plural "Scrolls of Flensing Fingers"
