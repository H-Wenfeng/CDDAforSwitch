#. ~ Item name
msgid "chest minifreezer"
msgid_plural "chest minifreezers"
msgstr[0] "mini-congélateur coffre"
msgstr[1] "mini-congélateurs coffres"
msgstr[2] "mini-congélateurs coffres"

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#. ~ Description of vehicle part "chest minifreezer"
msgid ""
"A small chest freezer.  When turned on, it will freeze the food inside, "
"preventing any further expiration."
msgstr ""
"Un petit congélateur coffre. Lorsqu'il est allumé, il congèle les aliments "
"qu'il contient, empêchant ainsi leur péremption."

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#: data/json/items/appliances/appliances_refrigeration.json
#. ~ Vehicle part name
#. ~ Item name
msgid "food truck freezer"
msgid_plural "food truck freezers"
msgstr[0] "congélateur pour food trucks"
msgstr[1] "congélateurs pour food trucks"
msgstr[2] "congélateurs pour food trucks"

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#. ~ Description of vehicle part "food truck freezer"
msgid ""
"A heavy, portable freezer.  When turned on, it will freeze the food inside, "
"preventing any further expiration."
msgstr ""
"Un congélateur lourd et portable. Lorsqu'il est mis en marche, il congèle les "
"aliments qu'il contient, les empêchant ainsi de se périmer."

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#: data/json/furniture_and_terrain/furniture_refrigeration.json
#: data/json/items/appliances/appliances_refrigeration.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "chest freezer"
msgid_plural "chest freezers"
msgstr[0] "grand congélateur coffre"
msgstr[1] "grands congélateurs coffre"
msgstr[2] "grand congélateur coffre"

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#. ~ Description of vehicle part "chest freezer"
msgid ""
"A big chest freezer.  When turned on, it will freeze the food inside, "
"preventing any further expiration.  Don't fall in!"
msgstr ""
"Un grand congélateur coffre. Lorsqu'il est allumé, il gèle les aliments qu'il "
"contient, empêchant ainsi leur expiration. Ne tombez pas dedans !"

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#: data/json/furniture_and_terrain/furniture_refrigeration.json
#: data/json/items/appliances/appliances_refrigeration.json
