msgstr[0] "congélateur à porte vitrée"
msgstr[1] "congélateurs à porte vitrée"
msgstr[2] "congélateur à porte vitrée"

#: data/json/furniture_and_terrain/appliances_refrigeration.json
#. ~ Description of vehicle part "glass door freezer"
msgid ""
"A glass door freezer.  When turned on, it will freeze the food inside, "
"preventing any further expiration."
msgstr ""
"Un congélateur à porte vitrée. Lorsqu'il est mis en marche, il congèle les "
"aliments qu'il contient, les empêchant ainsi de se périmer."

#: data/json/furniture_and_terrain/appliances_refrigeration.json
