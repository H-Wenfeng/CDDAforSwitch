#: data/mods/Defense_Mode/dialogue/TALK_DM_MERCHANT.json
#. ~ NPC dialogue line
msgid ""
"Nice to see you again.  Would you like to buy something, hire someone, or "
"somethin' else?"
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_DM_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "I'll buy something."
msgstr "J'aimerais acheter quelque chose."

#: data/mods/Defense_Mode/dialogue/TALK_DM_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "What'll it cost me to get some help around here?"
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_DM_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "I'd like to hire some help."
msgstr "J'aimerais embaucher de l'aide."

#: data/mods/Defense_Mode/dialogue/TALK_DM_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "Nevermind, I don't want anything."
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_DM_MERCHANT.json
#. ~ NPC dialogue line
msgid ""
"It's usually $500.  You can pay me up front in either goods or money, then "
"we'll talk."
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_DM_MERCHANT.json
#. ~ NPC dialogue line
msgid "Anything else I can do for you?"
msgstr "Quelque chose d'autre que je peux faire pour vous?"

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "Nice to see you."
msgstr "Un plaisir de vous voir."

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ NPC dialogue line
msgid ""
"Oh, you're not one of the <zombies>.  I'm glad to see another survivor out "
"here, such a relief."
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "I'll be back later."
msgstr "Je reviendrais plus tard."

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "What are you doing out here in the sticks?"
msgstr "Qu'est-ce qui vous amène ici au milieu de nul part?"

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "Why don't you come with me, maybe we can hold out here?"
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "I gotta go."
msgstr "Je dois y aller."

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ NPC dialogue line
msgid ""
"I can't remember, actually.  I have a vague sense of being in my house, "
"asleep, before I woke up in the middle of a field.  I have this strange "
"feeling that something's after me, keep seeing things out in the woods, so I "
"had to keep moving."
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "Seems like a hard life."
msgstr "Ça à l'air d'être une vie dure."

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "Where'd you get all your stuff at?"
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid ""
"I guess we're both in a similar predicament, then.  Why not team up with me?  "
"We can hold out together and try to stay alive."
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ NPC dialogue line
msgid ""
"I just found it near where I woke up at.  Who's it was and where it came from "
"I have no idea, but I couldn't find anyone else around, and it seemed like "
"it'd all been left there for someone to pick up."
msgstr ""

#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "Makes sense."
msgstr ""

