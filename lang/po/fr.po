msgstr ""

#: data/json/skillDisplayType.json
#. ~ Display string for skill display type "display_melee"
msgid "Melee skills"
msgstr "Compétences de mêlée"

#: data/json/skillDisplayType.json
#. ~ Display string for skill display type "display_ranged"
msgid "Ranged skills"
msgstr "Compétences de combat à distance"

#: data/json/skillDisplayType.json
#. ~ Display string for skill display type "display_crafting"
msgid "Crafting skills"
msgstr "Compétences de fabrication"

#: data/json/skillDisplayType.json
#. ~ Display string for skill display type "display_interaction"
msgid "Interaction skills"
msgstr "Compétences d'interaction"

#: data/json/skills.json
#. ~ Skill name
msgid "social"
msgstr "social"

#: data/json/skills.json
#. ~ Description of skill "social"
msgid ""
"Your skill in speaking to other people.  Covers ability in boasting, "
"flattery, threats, persuasion, lies, bartering, and other facets of "
"interpersonal communication.  Works best in conjunction with a high level of "
"intelligence."
msgstr ""
"Votre habileté à parler aux autres.  Couvre la capacité de se vanter, de "
"flatter, de menacer, de persuader, de mentir, de troquer et d'autres facettes "
"de la communication interpersonnelle.  Fonctionne mieux en conjonction avec "
"un niveau élevé d’intelligence."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You probably don't care about talking to other people much."
msgstr "Parler aux autres ne vous intéresse manifestement pas beaucoup."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You know how to communicate."
msgstr "Vous savez comment communiquer."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You're a good communicator."
msgstr "Vous communiquez aisèment."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You know effective communication methods and sales tactics."
msgstr ""
"Vous êtes capable de communiquer succinctement ainsi que de négocier "
"passablement."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You're possibly a psychologist."
msgstr "Vous êtes probablement un·e psychiatre."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You're not used to talking to people."
msgstr "Vous n'êtes pas vraiment habitué·e à parler aux autres."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You rarely offend people by accident."
msgstr "Il vous est difficile de vexer quelqu'un par accident."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You can communicate your ideas well."
msgstr "Vous êtes capable d'aisèment communiquer vos idées."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You can make friends easily and drive a hard bargain."
msgstr ""
"Vous êtes capable de vous faire des amis aisément ainsi que de négocier avec "
"les meilleurs."

#: data/json/skills.json
#. ~ Level description of skill "social"
msgid "You could sell ocean water to a hermit crab."
msgstr "Vous pourriez vendre de l'eau de mer à un bernard-l'hermite."

#: data/json/skills.json
#. ~ Skill name
msgid "computers"
msgstr "informatique"

#: data/json/skills.json
#. ~ Description of skill "computers"
msgid ""
"Your skill in accessing and manipulating computers.  Higher levels can allow "
"a user to navigate complex software systems and even bypass their security."
msgstr ""
"Votre compétence à utiliser les ordinateurs. Les niveaux plus élevés vous "
"permettent d'utiliser les logiciels les plus complexes et vous pourriez même "
"pirater leur sécurité."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You barely know the minimum of how to use a computer."
msgstr "Vous êtes à peine capable d'allumer un ordinateur."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You knew how to surf the web back when that was possible."
msgstr "Vous étiez capable de surfer le web lorsque ceci était encore possible."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You're aware what a \"command prompt\" is."
msgstr "Vous savez ce qu'une \"interface de commande\" veut dire."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You know how to write code in a few scripting languages."
msgstr ""
"Vous savez comment écrire du code avec quelques différents languages de "
"script."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You have an in–depth knowledge of code and how computers function."
msgstr ""
"Vous possédez un savoir profond concernant les ordinateurs et comment les "
"programmer."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You have probably read the entire SICP."
msgstr "Vous avez probablement lu entièrement le SICP."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid ""
"You can navigate to the \"phone\" app on your smartphone and likely \"hunt "
"and peck\" to type."
msgstr ""
"Vous êtes à peine capable d'utiliser l'application d'appels sur un smartphone "
"et il vous faut un peu de temps pour trouver chaque touche."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You can probably touch-type."
msgstr "Vous êtes probablement capable de taper sur un clavier."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You can debug a mod conflict for a video game."
msgstr "Vous êtes probablement capable de débuguer un conflit de mods."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You can make your own mods for a video game."
msgstr "Vous êtes capable de coder vos propres mods pour un jeu vidéo."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid "You can code your own video game."
msgstr "Vous êtes capable de coder votre propre jeu vidéo."

#: data/json/skills.json
#. ~ Level description of skill "computers"
msgid ""
"You could get paid to bounty-hunt vulnerabilities in government databases, if "
"any government was still around."
msgstr ""

#: data/json/skills.json
#. ~ Description of skill "health care"
msgid ""
"Your skill in effecting medical treatment.  Higher levels allow better use of "
"medicines and items like bandages and first aid kits, and reduce the failure "
"and complication rates of medical procedures."
msgstr ""
"Votre compétence dans l’exécution de traitements médicaux.  Des niveaux plus "
"élevés permettent une meilleure utilisation des médicaments et des objets "
"tels que les bandages et les trousses de premiers secours, et réduisent les "
"taux d'échec et de complications des procédures médicales."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You barely have any idea how your own body works."
msgstr "Vous savez à peine comment votre propre corps fonctionne."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You're at least aware the blood should stay inside you."
msgstr ""
"Vous êtes au moins au courant que votre sang est censé rester à l'intérieur "
"de vous."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You have a decent idea of first aid."
msgstr "Vous avez des bonnes connaissances concernant les premiers secours."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You're well-trained in first aid."
msgstr "Vous connaissez beaucoup de choses sur comment raccommoder quelqu'un."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You know a lot about how the body works and how to deal with many injuries."
msgstr ""
"Vous avez une vaste base de connaissances sur le fonctionnement du corps et "
"comment traiter une variété de blessures."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You may know how to do simple surgeries."
msgstr ""
"Vous connaissez les étapes nécessaires pour réaliser des opérations de "
"chirurgie simples."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You might be able to put a bandaid on a minor cut without passing out."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You can do basic first-aid techniques without panicking too much."
msgstr "Vous êtes capable d'administrer les premiers soins sans trop paniquer."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You're used to using a first-aid kit."
msgstr "Vous êtes capable d'utiliser un kit de premiers secours."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "Dealing with injuries is becoming routine for you."
msgstr "Vous occupez de blessures plus ou moins grave c'est la routine pour vous."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You could probably work in the ER."
msgstr ""
"Vous pourriez probablement travailler aux urgences, si celles-ci étaient "
"toujours ouvertes."

#: data/json/skills.json
#. ~ Level description of skill "health care"
msgid "You almost certainly can perform a simple surgery."
msgstr ""
"Vous pouvez probablement accomplir une opération de chirurgie simple avec "
"succès."

#: data/json/skills.json
#. ~ Skill name
msgid "mechanics"
msgstr "mécanique"

#: data/json/skills.json
#. ~ Description of skill "mechanics"
msgid ""
"Your skill in engineering, maintaining and repairing vehicles and other "
"mechanical systems.  This skill covers the craft of items with complex parts, "
"and plays a role in the installation of bionic equipment."
msgstr ""
"Votre compétence dans le domaine de la création, de l'entretien et de la "
"réparation de véhicules et divers systèmes mécaniques.  Vous permet de "
"fabriquer des objets aux pièces complexes, et joue un rôle dans "
"l'installation des implants bioniques."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You know that cars are supposed to be able to go forward."
msgstr "Vous savez que les voitures font vroum vroum."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You know how to check your oil."
msgstr "Vous savez où regarder pour vérifier le niveau d'huile."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You know the basic ideas of how a car works."
msgstr "Vous avez une idée basique de comment une voiture fonctionne."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You know how to fix most issues a car could have."
msgstr ""
"Vous savez comment réparer la plupart des problèmes qu'une voiture pourrait "
"avoir."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You know how to build a car from scratch."
msgstr "Vous avez les connaissances pour assembler une voiture à partir de rien."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You can change a wheel.  Potentially."
msgstr "Vous pouvez peut être changer une roue."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You can do the basics of car maintenance."
msgstr "Vous pouvez plus ou moins entretenir un véhicule."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You can fix most common issues your car could have."
msgstr ""
"Vous êtes capable de réparer la plupart des problèmes qu'une voiture pourrait "
"avoir."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You can install an engine."
msgstr "Vous êtes capable d'installer un moteur."

#: data/json/skills.json
#. ~ Level description of skill "mechanics"
msgid "You're a skilled enough mechanic you can install a second engine."
msgstr ""
"Vous avez l'expertise nécessaire en mécanique pour installer un second moteur "
"dans un véhicule."

#: data/json/skills.json
#. ~ Description of skill "devices"
msgid ""
"Your skill in manipulating fine devices like security systems, traps, locks "
"and other precision tasks.  This skill does not affect the evasion of traps "
"that are triggered."
msgstr ""
"Votre habileté à manipuler des appareils délicats tels que des systèmes de "
"sécurité, des pièges, des serrures et d'autres tâches de précision.  Cette "
"compétence n'affecte pas l'évasion des pièges déclenchés."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "You know keys go in locks and traps go off if you step on them."
msgstr ""
"Les clés vont dans des serrures et les pièges se déclenchent lorsque vous "
"marchez dedans, c'est tout ce que vous savez des deux."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "You know how to set basic traps."
msgstr "Vous savez comment créer des pièges basiques."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "You know how to set most traps and how most locks function."
msgstr ""
"Vous savez comment la plupart des pièges et la majorité des serrures "
"fonctionnent."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "You're a knowledgeable trapper and locksmith."
msgstr "Vous êtes un·e cognoscenti des pièges et serrures."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "You have an intricate understanding of traps and locks."
msgstr "Vous possédez une connaissance encyclopédique des serrures et pièges."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "You shouldn't try disarming anything, you'll only hurt yourself."
msgstr ""
"Vous ne devriez probablement pas essayer de désarmer quoi que ce soit, vous "
"ne feriez que vous mettre en danger."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "You might be able to pick the simplest locks and can disarm basic traps."
msgstr ""
"Vous êtes capable de crocheter les serrures les plus rudimentaires et "
"désarmer des pièges basiques."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "You can easily disarm most traps and pick some locks."
msgstr ""
"Vous êtes capable de désarmer la plupart des pièges et pouvez crocheter des "
"serrures assez complexes."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid "Lockpicking shouldn't be a problem for you."
msgstr "Crocheter une serrure n'est pas un problème pour vous."

#: data/json/skills.json
#. ~ Level description of skill "devices"
msgid ""
"You can disarm a landmine.  It's still extremely unsafe.  But you can.  "
"Probably."
msgstr ""
"Vous pouvez désarmer une mine.  Ceci est toujours ridiculement risqué, mais "
"il y a peut être une chance qu'elle ne vous explose pas au visage."

#: data/json/skills.json
#. ~ Skill name
msgid "vehicles"
msgstr "véhicules"

#: data/json/skills.json
#. ~ Description of skill "vehicles"
msgid ""
"Your skill in operating and steering a vehicle in motion, from cars and boats "
"to helicopters and hot air balloons.  A higher level allows greater control "
"over vehicles at higher speeds, and reduces the penalty of shooting while "
"driving."
msgstr ""
"Votre habileté à conduire et à diriger un véhicule en mouvement, des voitures "
"aux bateaux en passant par les hélicoptères et montgolfières.  Un niveau plus "
"élevé permet un meilleur contrôle des véhicules à des vitesses plus élevées "
"et réduit votre pénalité lorsque vous tirez au volant."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You know what a car looks like."
msgstr "Vous savez à quoi une voiture ressemble."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You know the basics of driving a car."
msgstr "Vous connaissez les bases nécessaires pour conduire une voiture."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You know how to drive a car."
msgstr "Vous savez comment conduire une voiture."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You probably know how to drive larger vehicles like a truck or bus."
msgstr ""
"Vous savez probablement comment conduire un large véhicule comme un camion ou "
"un bus."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You know how to drive even in difficult conditions."
msgstr "Vous savez comment conduire même durant des conditions défavorables."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You know tricks even racecar drivers use."
msgstr "Vous connaissez quelques astuces de pilote de course."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You don't even have a driver's license."
msgstr "Vous n'avez même pas un permis de conduire."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You were good enough to get a driver's license."
msgstr "Vous avez le niveau basique pour passer le permis de conduire avec succès."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You've driven a car enough for it to become routine."
msgstr "Vous avez conduit assez pour acquérir des automatismes solides."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You're better than most drivers on the road.  Well, not that any are left."
msgstr ""
"Vous étiez beaucoup plus compétent·e derrière le volant que la plupart des "
"personnes utilisant la route, et ce n'est pas comme si beaucoup sont toujours "
"là pour vous irriter."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You can keep control of most vehicles even in awkward conditions."
msgstr ""
"Vous pouvez garder contrôle au volant même durant des conditions "
"épouvantables."

#: data/json/skills.json
#. ~ Level description of skill "vehicles"
msgid "You could compete on a race track."
msgstr "Vous pourriez probablement piloter contre les meilleurs."

#: data/json/skills.json
#. ~ Skill name
msgid "athletics"
msgstr "athlétisme"

#: data/json/skills.json
#. ~ Description of skill "athletics"
msgid ""
"Your athletic ability, including swimming endurance and ability to swim with "
"weight.  Athletic skill also improves your overall cardio fitness and stamina."
msgstr ""
"Votre capacité athlétique, y compris l’endurance en natation et la capacité à "
"nager avec du poids.  Les compétences athlétiques améliorent également votre "
"forme cardio et votre endurance globale."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You don't even let people tell you that you should be more active."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You're at least aware exercise is good and that you should do it more."
msgstr ""
"Vous êtes au moins au courant que le sport est bon pour vous et que vous "
"devriez être plus actif·ve."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You know how to exercise."
msgstr "Vous savez comment faire du sport."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You know proper form and stretches."
msgstr ""
"Vous connaissez les bonnes postures à adopter durant vos efforts et les "
"étirements corrects à accomplir avant et après."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You could be a personal trainer."
msgstr "Vous pourriez être un⋅e coach personnel⋅le."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You're a couch potato."
msgstr "Vous êtes une patate de canapé."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You might be able to doggy paddle."
msgstr "Vous êtes capable de faire la nage du chien."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You're reasonably active and a decent swimmer."
msgstr ""
"Vous nagez de temps en temps et pourriez peut être faire une ou deux "
"longueurs de piscine avant d'avoir besoin d'une pause."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You're active and a good swimmer."
msgstr ""
"Faire quelques longueurs d'une piscine olympique ne devrait pas être un trop "
"grand problème pour vous."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You're very active and a great swimmer."
msgstr "Vous pourriez vous débrouiller dans une compétition de nage."

#: data/json/skills.json
#. ~ Level description of skill "athletics"
msgid "You could swim across the English Channel."
msgstr "Vous pourriez nager d'un bout à l'autre de la Manche."

#: data/json/skills.json
#. ~ Skill name
msgid "fabrication"
msgstr "fabrication"

#: data/json/skills.json
#. ~ Description of skill "fabrication"
msgid ""
"Your skill in working with raw materials and shaping them into useful "
"objects.  This skill plays an important role in the crafting of many objects."
msgstr ""
"Votre compétence à travailler les matériaux bruts et à les assembler pour en "
"faire des objets plus utiles. Cette compétence permet de fabriquer de "
"nombreux objets."

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid "You barely know which side of the hammer you should hold."
msgstr "Vous ne savez même pas par quel bout tenir un marteau."

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid "You know how to hold a hammer."
msgstr "Vous savez comment manier un marteau."

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid ""
"You're a decent DIYer and know how to craft a variety of wooden items or very "
"basic metalworking."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid "You're a fairly skilled DIYer and know how to craft a variety of metal items."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid ""
"You're an exceptionally skilled DIYer and know how to smith basic tools and "
"weapons."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid "You know the ins and outs of making almost anything you can think of."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid "You can only craft the most basic things."
msgstr "Vous n'êtes capable de fabriquer que les objets les plus basiques."

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid "You can craft a few basic things."
msgstr "Vous êtes capable de fabriquer quelques choses simples."

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid "You can craft a variety of useful stuff without much issue."
msgstr ""
"Vous êtes capable de fabriquer une variété d'objets utiles sans trop de "
"problèmes."

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid ""
"You can easily craft useful, if junky weapons and armor, but nothing too "
"complex."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid "You can craft even complex objects without fail."
msgstr ""
"Vous êtes capable de fabriquer des objets particulièrement complexes sans "
"problème."

#: data/json/skills.json
#. ~ Level description of skill "fabrication"
msgid ""
"You have created many things with your hands and you should have little issue "
"crafting anything."
msgstr ""
"Vos mains ont créé un peu près tout ce qui peut être fabriqué et rien ne "
"devrait être un problème pour vous."

#: data/json/skills.json
#. ~ Description of skill "food handling"
msgid ""
"Your skill in combining food ingredients to make other, tastier food items.  "
"Also includes food preservation and safety, brewing, butchery, and more."
msgstr ""
"Votre habileté à combiner des ingrédients alimentaires pour créer d’autres "
"aliments plus savoureux.  Inclue également votre capacité à conserver et "
"garder sains les aliments, le brassage, la boucherie et bien plus encore."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You probably lived on takeout."
msgstr "Vous étiez probablement en train de survivre sur des plats à emporter."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You know the basics of how not to burn your house down."
msgstr "Vous maîtrisez les bases pour ne pas commencer un incendie dans votre cuisine."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You know how to cook reasonably."
msgstr "Vous savez comment cuisiner relativement bien."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You know how to cook a wide variety of food."
msgstr "Vous savez comment cuisiner une variété de plats."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You know how to cook the most advanced and complex dishes."
msgstr ""
"Vous savez comment cuisiner la plupart des recettes qui pourrait vous venir à "
"l'esprit."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You'd burn a PB&J, somehow."
msgstr ""
"Vous pourriez d'une manière ou d'une autre brûler une tartine sans "
"grille-pain."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You can boil an egg."
msgstr "Vous êtes capable de bouillir un œuf."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You can cook a variety of recipes."
msgstr "Vous êtes capable de cuisiner une variété de recettes."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You can cook most recipes with ease."
msgstr "Vous êtes capable de cuisiner aisément plus ou moins n'importe quelle recette."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You'd win a neighborhood bake-off."
msgstr "Vous seriez probablement en première place dans un concours local de cuisine."

#: data/json/skills.json
#. ~ Level description of skill "food handling"
msgid "You'd be an excellent chef, too bad all the zombies want to eat is you."
msgstr ""
"Vous pourriez cuisiner dans un restaurant Michelin, dommage que vous êtes la "
"seule chose que les zombies veulent manger."

#: data/json/skills.json
#. ~ Description of skill "tailoring"
msgid ""
"Your skill in the craft and repair of clothing, bags, blankets and other "
"textiles.  Affects knitting, sewing, stitching, weaving, and nearly anything "
"else involving a needle and thread."
msgstr ""
"Votre compétence pour fabriquer et réparer vêtements, sacs, couvertures et "
"autres textiles. Tricot, tissage, couture, tout ce qui implique du fil et une "
"aiguille est à votre portée."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You know nothing about tailoring."
msgstr "Vous ne connaissez absolument rien sur la couture."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You know the very basics of how to sew a patch over a small hole."
msgstr ""
"Vous êtes à peu près capable de coudre un carré de tissu pour réparer un "
"petit trou."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You know how to sew."
msgstr "Vous n'êtes pas trop mauvais·e avec une aiguille."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You know how to sew well."
msgstr "Vous êtes capable de coudre adéquatement."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You know how to sew with non-standard materials."
msgstr "Vous êtes capable de bien coudre avec des matériaux insolites."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You're a very knowledgeable tailor."
msgstr "Vous avez un talent indéniable avec une aiguille."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You can put a shirt on without ripping it, at least."
msgstr "Vous êtes capable d'enfiler un t-shirt sans le déchirer…"

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You've held a sewing needle once or twice."
msgstr "Vous avez tenu une aiguille une ou deux fois dans votre vie."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You can repair or sew simple clothing."
msgstr "Vous êtes capable de réparer ou coudre des vêtements simples."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You can repair or sew more complex clothing."
msgstr "Vous êtes capable de réparer ou coudre des vêtements assez complexes."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You're skilled at working with non-standard materials like Kevlar."
msgstr ""
"Vous êtes capable de réparer ou coudre des choses avec des matériaux "
"insolites comme du Kevlar."

#: data/json/skills.json
#. ~ Level description of skill "tailoring"
msgid "You can sew anything you could dream of."
msgstr "Vous pouvez coudre tout ce qui pourrait possiblement vous venir à l'esprit."

#: data/json/skills.json
#. ~ Skill name
msgid "survival"
msgstr "survie"

#: data/json/skills.json
#. ~ Description of skill "survival"
msgid ""
"Your skill in surviving the wilderness, and in crafting various basic "
"survival items.  This also covers your ability to skin and butcher animals "
"for meat and hides."
msgstr ""
"Votre compétence à faire face à la vie sauvage et à fabriquer des objets "
"simples de survie.  Cela vous permet également de dépecer et mettre en pièces "
"les animaux pour récupérer leurs peaux et leur viande."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You're aware the outdoors is gross."
msgstr ""
"La seule chose que vous connaissez au sujet de la cambrousse c'est que vous "
"ne voulez pas y être."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You know the very basics of camping."
msgstr "Vous connaissez les bases du camping."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You know how to craft a fire drill to start fires without lighters."
msgstr "Vous savez comment fabriquer un allume-feu et n'avait pas besoin de briquet."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You probably memorized most of the Scouting handbook."
msgstr "Vous avez probablement en mémoire la majorité du manuel des Scouts."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You're exceptionally knowledgeable in all things outdoorsy."
msgstr ""
"Vous êtes exceptionnellement bien informé·e sur toutes les choses impliquant "
"les grands espaces."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You need to touch grass."
msgstr "Vous avez vraiment besoin d'aller dehors."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You've touched grass."
msgstr "Vous êtes allé·e dehors une ou deux fois, probablement."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You might've been a cub scout as a kid."
msgstr "Vous avez peut être passé une ou deux semaines dans un club de scouts."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You're a skilled scout and can pitch a tent with ease."
msgstr "Vous pouvez camper sans trop de problèmes."

#: data/json/skills.json
#. ~ Level description of skill "survival"
msgid "You could likely be dropped into a forest with nothing and thrive."
msgstr ""
"Vous pourriez probablement être laissé·e dans une forêt au milieu de nul part "
"et prospérer."

#: data/json/skills.json
#. ~ Skill name
msgid "electronics"
msgstr "électronique"

#: data/json/skills.json
#. ~ Description of skill "electronics"
msgid ""
"Your skill in dealing with electrical systems, used in the craft and repair "
"of objects with electrical components.  This skill is an important part of "
"installing and managing bionic implants."
msgstr ""
"Votre compétence à fabriquer et réparer des objets électriques. Cette "
"compérence joue un grand rôle pour l'installation et la gestion des implants "
"bioniques."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid ""
"You don't know the first thing about how electricity works.  It might as well "
"be magic to you."
msgstr ""
"Vous ne savez absolument rien au sujet de l'électricité et tout cela est de "
"la magie pour vous."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid "You have a very rudimentary knowledge on how electricity works."
msgstr "Vous êtes au courant de ce qu'est un circuit et pas grand chose d'autre."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid "You have some idea of how electricity works."
msgstr "Vous savez quelques choses sur le sujet des appareils électriques."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid ""
"You have a good understanding of how electricity works and were possibly an "
"electrician."
msgstr ""
"Vous avez une bonne maîtrise des principes de l'électricité et auriez-pu vous "
"débrouiller comme électricien⋅ne."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid "You have an intricate understanding of electronics and how they function."
msgstr ""
"Vous possédez une connaissance encyclopédique des appareils électroniques et "
"comment ceux-ci fonctionnent."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid "You can turn a light switch on or off."
msgstr "Vous êtes capable d'appuyer sur un interrupteur."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid "You can craft extremely basic electronics like flashlights."
msgstr ""
"Vous êtes capable d'assembler des appareils électroniques extrêmement "
"basiques comme une lampe torche."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid ""
"You can craft some electrical gadgets and set up an at-home power grid "
"without major fire hazards."
msgstr ""
"Vous pouvez assembler des gadgets électrique et installer un réseau "
"électrique de domicile sans trop de risques d'incendie."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid "You can craft a variety of useful electronics."
msgstr "Vous êtes capable d'assembler une variété d'appareils électroniques utiles."

#: data/json/skills.json
#. ~ Level description of skill "electronics"
msgid "You can craft any electrical device you can think of."
msgstr ""
"Vous êtes capable d'assembler plus ou moins n'importe quel type d'appareil "
"électrique."

#: data/json/skills.json
#. ~ Description of skill "archery"
msgid ""
"Your skill in using bow weapons, from hand-carved self bows to complex "
"compound bows.  Quiet and effective, they require strength of body and sight "
"to wield, and are not terribly accurate over a long distance."
msgstr ""
"Votre habileté à utiliser des armes de type arc, des auto-arcs sculptés à la "
"main aux arcs à poulies complexes. Calmes et efficaces, ils exigent force de "
"force et vue, et ne sont pas très précis sur une longue distance."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You know what a bow looks like."
msgstr "Vous savez à quoi un arc devrait ressembler."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You know how to nock an arrow."
msgstr "Vous savez comment bien encocher une flèche."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You know the basics of archery."
msgstr "Vous connaissez les bases du tir à l'arc."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You're knowledgeable about archery."
msgstr "Vous connaissez beaucoup de choses concernant le tir à l'arc."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You have a wealth of knowledge about archery."
msgstr "Vous savez plus ou moins tout ce qu'il y a savoir sur le tir à l'arc."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You're lucky if the arrow doesn't spin sideways."
msgstr ""
"Ce ne serait pas une surprise avec votre niveau atroce si la flèche faisait "
"demi-tour vers vous."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You can usually get the arrow to fly straight-ish."
msgstr "Vous êtes capable de faire voler une flèche plus ou moins droit."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You can usually hit an archery target."
msgstr "Vous touchez la cible avec vos flèches plus souvent que vous la ratez."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You're a fairly skilled archer."
msgstr "Vous êtes assez doué⋅e au tir à l'arc."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You're a skilled archer and might've done well in some competitions."
msgstr ""
"Vous avez du talent avec un arc et auriez probablement pu bien vous "
"débrouiller durant une compétition."

#: data/json/skills.json
#. ~ Level description of skill "archery"
msgid "You'd've been a terror at the Battle of Agincourt."
msgstr "Vous auriez été une vraie terreur à Azincourt."

#: data/json/skills.json
#. ~ Description of skill "marksmanship"
msgid ""
"Your overall skill in using bows and firearms.  With higher levels, this "
"general experience increases accuracy with any bows or firearms, but is "
"secondary to practice with the type of ranged weapon in question."
msgstr ""
"Votre compétence pour mieux viser avec les arcs et les armes à feu. Les "
"niveaux les plus élevés augmentent la précision des arcs et armes à feu, mais "
"il vous faut également pratiquer la compétence du type d'arme que vous "
"utilisez."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "You don't even know how to aim a gun."
msgstr "Vous ne savez absolument rien sur comment viser avec une arme à feu."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "You know where the iron sights on a gun are."
msgstr "Vous êtes au courant d'où les mires d'une arme à feu sont."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "You know the basics of aiming."
msgstr "Vous connaissez les bases nécessaires pour bien viser."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "You know how to aim most ranged weapons fairly well."
msgstr "Vous savez comment viser correctement avec la plupart des armes à feu."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid ""
"You know how to aim even at long distances taking into account bullet drop "
"and wind speed."
msgstr ""
"Vous savez comment tirer à longues distances et prendre compte des choses "
"comme la chute de la balle ou comment le vent affectera sa trajectoire."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid ""
"Your hands shake, your aim is shit, and you close your eyes before each shot. "
" You could aim at the ground and somehow miss."
msgstr ""
"Vos mains tremblent, vous viser atrocement, et vous fermez vos yeux à chaque "
"fois que vous tirez sur la gâchette.  Vous pourriez viser vos pieds et "
"réussir à rater."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "Holding a gun steady is difficult for you."
msgstr "Garder une arme à feu sur une cible est problématique pour vous."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "You've been to the range a few times and can usually hit the target."
msgstr ""
"Vous avez déjà essayé de viser sur une cible et vous êtes même capable de la "
"toucher de temps en temps."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "Your aim is pretty good even at medium ranges."
msgstr "Vous visez bien à des distances raisonnables."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "You have good aim even at fairly long ranges."
msgstr "Vous visez bien même à de plutôt longues distances."

#: data/json/skills.json
#. ~ Level description of skill "marksmanship"
msgid "You're a veritable sniper."
msgstr "Vous êtes un vrai sniper."

#: data/json/skills.json
#. ~ Description of skill "launchers"
msgid ""
"Your skill in using heavy weapons like rocket, grenade or missile launchers.  "
"These weapons have a variety of applications and may carry immense "
"destructive power, but they are cumbersome and hard to manage."
msgstr ""
"Votre compétence pour utiliser les roquettes, grenades ou autres lance "
"missiles. Ces armes à l'immense pouvoir destructeur sont bien souvent "
"encombrantes et difficiles à gérer."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid "You know nothing about launchers, cannons, or anything similar."
msgstr ""
"Vous ne connaissez absolument rien sur le sujet des lanceurs et canons ou "
"quoi que ce soit de similaire."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid "You've at least read about cannons or flamethrowers."
msgstr "Vous avez au moins lu quelques trucs sur le sujet des canons et lance-flammes."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid "You probably built a spud launcher at some point."
msgstr "Vous avez probablement construit un lance-patate auparavant."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid "You're skilled with various types of launchers."
msgstr "Vous avez un bon niveau de compétence avec une variété de types de lanceurs."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid "You're a rare expert in knowledge about various types of launchers."
msgstr "Vous êtes un⋅e expert⋅e sur le sujet des lanceurs."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid "Rather understandably, you have never fired any kind of launcher before."
msgstr ""
"Ceci n'est probablement pas hors de la normale, mais vous n'avez jamais "
"utilisé un lanceur auparavant."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid "You may have fired a spud cannon at some point."
msgstr "Vous avez peut être tiré un lance-patate auparavant."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid "You have experience firing launchers or flamethrowers, somehow."
msgstr ""
"Vous avez le privilège rare d'avoir de l'expérience sur l'utilisation de "
"lanceurs et lance-flammes."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid ""
"Your growing level of experience with rocket launchers, flamethrowers, or "
"cannons is worrying."
msgstr ""
"Votre maîtrise considérable de l'utilisation de lance-roquettes, "
"lance-flammes et canons variés est un peu inquiétante."

#: data/json/skills.json
#. ~ Level description of skill "launchers"
msgid ""
"You just want to watch the world burn, and you're really damn good at making "
"sure it will."
msgstr ""
"Vous ne voulez rien d'autre que voir le monde brûler, et vous avez le talent "
"nécessaire pour être sûr⋅e que celui-ci s'envole en fumée."

#: data/json/skills.json
#. ~ Skill name
msgid "handguns"
msgstr "pistolets"

#: data/json/skills.json
#. ~ Description of skill "handguns"
msgid ""
"Handguns have poor accuracy compared to rifles, but are usually quick to fire "
"and reload faster than other guns.  They are very effective at close "
"quarters, though unsuited for long range engagement."
msgstr ""
"Les pistolets sont moins précis que les fusils mais bien souvent plus rapides "
"à tirer et à recharger. Ils sont très efficaces à courte portée, mais ne sont "
"pas fait pour des combats à longue portée."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "You can't tell a revolver from a semiautomatic."
msgstr "Vous êtes incapable de distinguer un revolver d'un pistolet semi-automatique."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "You can tell a revolver from a semiautomatic."
msgstr "Vous êtes capable de distinguer un revolver d'un pistolet semi-automatique."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "You know the basics of handguns and their usage."
msgstr ""
"Vous maîtrisez les bases nécessaires pour utiliser et entretenir un pistolet "
"de façon sûre et efficace."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "You're knowledgeable about handguns and their uses."
msgstr ""
"Vous connaissez beaucoup de choses concernant les pistolets et comment "
"ceux-ci sont utilisés."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid ""
"You know every trick and technique for firing handguns accurately and "
"effectively."
msgstr ""
"Vous connaissez plus ou moins toute les astuces et techniques utilisée pour "
"tirer avec un pistolet de façon efficace et précise."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "Hopefully it won't fly out of your hands when you fire one."
msgstr ""
"Espérons qu'un pistolet ne va pas s'envoler lorsque vous décidez d'essayer de "
"tirer avec."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "Handguns feel awkward to use for you."
msgstr "Vous n'êtes pas très comfortable avec un pistolet dans vos mains."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "You're comfortable with the usage of handguns."
msgstr ""
"Vous avez un bon niveau de maîtrise et comfortable avec quelques types de "
"pistolet."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "You're quite skilled and accurate with handguns."
msgstr "Vous êtes assez doué⋅e et précis⋅e avec une variété de types de pistolet."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid "You could win a duel at high noon."
msgstr "Vous pourriez gagner un duel à midi pile."

#: data/json/skills.json
#. ~ Level description of skill "handguns"
msgid ""
"You're a deadeye with pistols and can likely hit someone at 20 yards from the "
"hip with ease."
msgstr ""
"Vous êtes un as avec une gâchette et pourriez toucher aisément quelqu'un à 20 "
"mètres en tirant de votre hanche."

#: data/json/skills.json
#. ~ Description of skill "rifles"
msgid ""
"Classic rifles have terrific range and accuracy compared to other firearms, "
"but may be slow to fire and reload, and can prove difficult to use in close "
"combat.  Short-barreled rifles and carbines are more like SMGs and perform "
"well in close combat."
msgstr ""
"Les fusils classiques ont une portée et une précision remarquables par "
"rapport aux autres armes à feu, mais ils peuvent être lents à tirer et à "
"recharger, et peuvent s'avérer difficiles à utiliser en combat rapproché. Les "
"fusils à canon court et les carabines ressemblent davantage à des "
"pistolets-mitrailleurs et donnent de bons résultats en combat rapproché."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "Rifles are complicated weaponry and you don't know anything about them."
msgstr ""
"Les fusils sont des machines complexes et vous ne savez pas grand chose à "
"leur sujet."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "You at least have rudimentary knowledge of rifles."
msgstr ""
"Vous possédez des connaissances rudimentaires sur le fonctionnement des "
"fusils."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "You can maintain your average standard-issue rifle."
msgstr "Vous êtes capable d'entretenir un fusil standard adéquatement."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "You have an intricate knowledge of all the parts of a rifle and their use."
msgstr ""
"Vous possédez un savoir encyclopédique des composants d'un fusil et de leur "
"fonctions."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid ""
"You can probably disassemble and reassemble your rifle in the dark with your "
"hands tied together."
msgstr ""
"Vous pourriez probablement désassembler et réassembler un fusil dans le noir "
"avec vos mains liées."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "You've never fired a rifle before."
msgstr "Vous n'avez jamais tiré un fusil."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "You can at least shoulder a rifle."
msgstr "Vous pouvez plus ou moins épauler un fusil."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "You're at least as competent as the average soldier straight out of boot camp."
msgstr ""
"Votre niveau avec un fusil est équivalent à celui d'une recrue sortant de "
"l'école."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "Rifles feel familiar in your hands."
msgstr "Les fusils sont bienvenus dans vos mains."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "You're a genuinely good shot."
msgstr "Vous êtes assez doué⋅e avec un fusil."

#: data/json/skills.json
#. ~ Level description of skill "rifles"
msgid "You could be a career sniper."
msgstr "Vous auriez probablement pu avoir une carrière come sniper professionnel."

#: data/json/skills.json
#. ~ Description of skill "shotguns"
msgid ""
"Shotguns are easy to shoot and can inflict massive damage, but their "
"effectiveness and accuracy decline rapidly with range.  Slugs can be loaded "
"into shotguns to provide greater range, though they are somewhat inaccurate."
msgstr ""
"Les fusils à pompe font d'énormes dégâts à courte portée, mais leur "
"efficacité diminue très vite a portée plus grande.  Vous pouvez les charger "
"avec des cartouches slug balles pour améliorer la portée en échange d'une "
"précision réduite."

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid "\"Shot-guns?\"  But all guns are shot?"
msgstr "Un \"fusil à pompe\"?  C'est quoi une pompe?"

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid "You know what a shotgun is."
msgstr "Vous savez ce qu'est un fusil à pompe."

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid ""
"You know enough about shotguns to get mad about unrealistic pellet spread in "
"video games."
msgstr ""
"Vous connaissez suffisamment au sujet des fusils à pompe pour que leur "
"dispersion dans la plupart des jeu vidéos vous irrite."

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid "You're knowledgeable about the handling and maintenance of shotguns."
msgstr ""
"Vous connaissez un peu près tout ce qu'il y a savoir au sujet des fusils à "
"pompe et comment les entretenir."

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid "You couldn't hit the broad side of a barn."
msgstr "Vous ne pourriez pas tirer sur un éléphant dans un couloir."

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid "You can usually hit a clay pigeon if it's just sitting there."
msgstr "Vous pouvez probablement tirer sur un pigeon d'argile stationnaire."

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid "You probably have experience skeet shooting."
msgstr "Vous pourriez bien vous débrouiller dans une compétition de ball-trap."

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid "You're a very skilled skeet shooter."
msgstr "Vous pourriez probablement gagner un championnat de ball-trap."

#: data/json/skills.json
#. ~ Level description of skill "shotguns"
msgid "You could snipe with most shotguns if you weren't limited by the spread."
msgstr ""
"Vous pourriez faire du tir de précision avec la plupart des fusils à pompe si "
"la dispersion n'était pas un problème."

#: data/json/skills.json
#. ~ Skill name
msgid "submachine guns"
msgstr "pistolets mitrailleurs"

#: data/json/skills.json
#. ~ Description of skill "submachine guns"
msgid ""
"Comprised of an automatic rifle carbine designed to fire a pistol cartridge, "
"submachine guns can reload and fire quickly, sometimes in bursts, but they "
"are relatively inaccurate and may be prone to mechanical failures."
msgstr ""
"Constituées d'un fusil automatique conçu pour tirer des balles de pistolet, "
"les pistolets mitrailleurs se rechargent et tirent rapidement, certains en "
"rafale, mais sont assez imprécis et peuvent être sujet à des défaillances "
"mécaniques."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You don't know the first thing about submachine guns."
msgstr "Il y a des pistolets qui peuvent mitrailler?"

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You know very little about SMGs."
msgstr ""
"Vous savez vraiment pas grand chose sur ce qui fait fonctionner un pistolet "
"mitrailleur."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You know a decent bit about firing SMGs accurately."
msgstr "Vous savez quelques trucs sur les pistolets mitrailleurs."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You're knowledgeable about the tactics used with SMGs."
msgstr ""
"Vous avez une bonne familiarité avec les tactiques impliquant les pistolets "
"mitrailleurs."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You've never held an SMG before."
msgstr "Vous n'avez jamais tenu une pistolet mitrailleur."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You have minimal experience with SMGs."
msgstr ""
"Vous avez peut être tenu un pistolet mitrailleur une ou deux fois dans votre "
"vie."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You have some experience with SMGs."
msgstr "Vous avez un bon niveau d'expérience avec les pistolets mitrailleurs."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You're fairly experienced with SMGs."
msgstr "Vous êtes assez doué⋅e avec un pistolet mitrailleur."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You're very experienced with SMGs."
msgstr "Vous êtes particulièrement doué⋅e avec un pistolet mitrailleur."

#: data/json/skills.json
#. ~ Level description of skill "submachine guns"
msgid "You're a CQB expert with SMGs."
msgstr "Vous êtes un·e expert·e avec les pistolets mitrailleurs en combat rapproché."

#: data/json/skills.json
#. ~ Description of skill "throwing"
msgid ""
"Your skill in throwing objects over a distance.  Skill increases accuracy, "
"and at higher levels, the range of a throw."
msgstr ""
"Votre compétence à lancer des objets à distance. Les premiers niveaux "
"augmentent la précision, et les niveaux les plus élevés augementent la portée."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid ""
"You've managed to avoid gym class your whole life and barely know how to "
"throw a rock.  Impressive."
msgstr ""
"Vous avez réussi à séchez plus ou moins tout vos cours de gym et êtes à peine "
"capable de jeter un caillou sans que celui-ci vous tombe sur les pieds.  "
"Remarquable."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid ""
"You know how to throw things.  Which is good, since that's an inherent skill "
"of being human."
msgstr ""
"Vous savez plus ou moins comment jeter quelque chose, ce qui ne devrait pas "
"être très impressionnant vu que ceci est une des choses les plus basiques "
"qu'un être humain devrait maîtriser."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid "You know how to throw stuff with reasonable accuracy."
msgstr "Vous savez comment jeter des choses avec une précision raisonnable."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid "You know proper form and methods for throwing accurately."
msgstr ""
"Vous maîtrisez la bonne forme et les méthodes nécessaires pour jeter quelque "
"chose avec précision."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid "You could teach sports.  The ones that involve throwing stuff anyway."
msgstr ""
"Vous pourriez être un coach.  Du moins un coach pour un sport qui implique de "
"devoir jeter quelque chose."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid ""
"You're lucky if you don't drop the thing you're throwing at your feet.  Be "
"extra careful with grenades."
msgstr ""
"Jeter quelque chose veut juste dire que vous laissez cela tomber sur vos "
"pieds la plupart du temps.  Mélangez cela avec des grenades à vos risques et "
"périls."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid ""
"You can usually throw a rock at a person if they're not too far away, or "
"moving."
msgstr ""
"Vous pouvez peut être jeter un caillou à une cible, si celle-ci n'est pas "
"trop loin et ne bouge pas."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid "You can accurately throw a dodgeball at someone."
msgstr "Vous feriez une bonne addition à une équipe de balle au prisonnier."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid "You can pitch a baseball across home plate into the strike zone reliably."
msgstr ""
"Vous pouvez jeter une balle de baseball là où elle doit atterrir presque sans "
"fautes."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid "You've got a good fastball."
msgstr ""
"Vous pourriez vous débrouiller dans les disciplines de jet d'une compétition "
"d'athlétisme."

#: data/json/skills.json
#. ~ Level description of skill "throwing"
msgid ""
"You could've become a professional pitcher.  At least beaning zombies doesn't "
"give them a free walk to first base."
msgstr ""
"Vous auriez pu avoir une carrière comme lanceur de baseball, au moins frapper "
"un zombie avec un projectile n'est pas une faute."

#: data/json/skills.json
#. ~ Description of skill "melee"
msgid ""
"Your skill and finesse in personal combat, both with and without a weapon.  "
"Higher levels can significantly increase the accuracy and effectiveness of "
"your physical attacks."
msgstr ""
"Votre compétence au combat rapproché, avec ou sans arme. Les niveaux les plus "
"élevés peuvent nettement accroitre la précision et l'efficacité de vos coups."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid ""
"You have no idea how to do anything other than vaguely swing in their "
"direction."
msgstr ""
"Vous n'avez absolument aucune idée de comment vous battre à part battre des "
"bras vaguement vers l'ennemi."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid "You can theoretically fight."
msgstr "Vous pouvez théoriquement vous battre."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid ""
"You've learned enough to avoid overswinging and falling off balance if you "
"miss."
msgstr ""
"Vous avez appris assez pour éviter de mettre trop de force dans un coup et "
"perdre votre équilibre si vous ratez."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid "Whether self-taught or trained, you've learned quite a lot about fighting."
msgstr ""
"Que ce soit autodidacte ou suivant l'enseignement de quelqu'un, vous "
"connaissez beaucoup de choses concernant le combat rapproché."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid "You could teach a platoon of medieval soldiers how to fight in a war."
msgstr ""
"Vous pourriez enseigner à un groupe comment se battre comme si le Moyen-Âge "
"était de retour."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid "Any fighting you do is mostly just panicked flailing."
msgstr ""
"Tout ce que vous êtes capable de faire dans une bagarre est battre des bras "
"futilement."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid "Your panicked flailing has become somewhat more determined flailing."
msgstr "Vos battements de bras sont un peux moins futiles et un peu plus utiles."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid "Your fighting now actually resembles proper form and is far less clumsy."
msgstr ""
"Lorsque vous vous battez vous possédez maintenant une bonne posture et vos "
"mouvements sont beaucoup moins maladroits."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid "You're a proper fighter and can use most techniques."
msgstr ""
"Vous pouvez vous débrouiller dans une bagarre et la plupart des techniques ne "
"sont pas trop difficiles à apprendre et maîtriser."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid ""
"You're a skilled man-at-arms that wouldn't look out of place fighting on a "
"medieval battlefield."
msgstr "Vous seriez capable de vous débrouiller dans une bataille médiévale."

#: data/json/skills.json
#. ~ Level description of skill "melee"
msgid ""
"In a world with guns you've dedicated yourself to mastering melee combat, and "
"you're damn good at it too."
msgstr ""
"Dans un monde rempli d'armes à feu vous vous êtes appliqué⋅e à maîtriser le "
"combat rapproché, et vous êtes devenu⋅e vraiment, vraiment doué⋅e."

#: data/json/skills.json
#. ~ Skill name
msgid "bashing weapons"
msgstr "armes contondantes"

#: data/json/skills.json
#. ~ Description of skill "bashing weapons"
msgid ""
"Your skill in fighting with blunt weaponry, from rocks and sticks to baseball "
"bats and the butts of rifles.  Skill increases damage, and higher levels will "
"improve the accuracy of an attack."
msgstr ""
"Votre compétence à manier les armes contondantes. Une simple pierre, une "
"batte de baseball ou même la crosse d'un fusil. Les niveaux plus élevés "
"augmentent les dégâts et la précision des attaques."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid "You don't even know how to swing a baseball bat properly."
msgstr "Vous ne savez même pas comment une batte de baseball est utilisée."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid "You at least know how to swing a baseball bat."
msgstr "Vous savez plus ou moins comment frapper avec une batte de baseball."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid ""
"You have a decent idea how to maneuver blunt weapons without falling off "
"balance."
msgstr ""
"Vous avez une bonne idée de comment balancer une arme contendante sans perdre "
"votre équilibre."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid ""
"You've learned how to leverage blunt weapons best to get powerful, accurate "
"hits."
msgstr ""
"Vous avez appris comment utiliser le poids d'une arme contendante de façon "
"efficace pour achever des frappes puissantes et précises."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid "You could teach a class on fighting with maces and hammers."
msgstr ""
"Vous pourriez former quelqu'un sur comment utiliser des masses ou des "
"marteaux comme un guerrier médieval."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid ""
"You've somehow gone through life without even swinging a stick for fun.  How "
"awful."
msgstr ""
"Vous avez d'une manière ou d'une autre réussi à vivre jusqu'à maintenant sans "
"jamais ramasser un bâton et frapper des choses avec.  Déprimant."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid "You can swing a baseball bat."
msgstr "Vous êtes capable de plus ou moins manier une batte sans la faire tomber."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid "You can reliably hit a pitch while at bat."
msgstr ""
"Vous pourriez être capable de frapper une balle de baseball avec une "
"régularité raisonnable."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid ""
"You're a decently skilled batter and good at using all sorts of bludgeons, "
"improvised or otherwise."
msgstr ""
"Vous avez une bonne familiarité avec une variété d'armes contendantes, "
"improvisées ou non."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid ""
"You can hit zombies over the head even with random junk and still make it "
"look good."
msgstr ""
"Vous êtes capable de faire exploser un crâne de zombie de façon spectaculaire "
"même avec quelque chose d'aléatoire émergeant tout juste d'un garage."

#: data/json/skills.json
#. ~ Level description of skill "bashing weapons"
msgid ""
"You can swing a heavy, poorly-weighted sledgehammer with pinpoint accuracy "
"even against a moving target."
msgstr ""
"Vous êtes capable de frapper une cible mouvante précisément même avec une "
"massue de démolition lourde et mal équilibrée."

#: data/json/skills.json
#. ~ Skill name
msgid "cutting weapons"
msgstr "armes tranchantes"

#: data/json/skills.json
#. ~ Description of skill "cutting weapons"
msgid ""
"Your skill in fighting with weaponry designed to cut, hack and slash an "
"opponent.  Lower levels of skill increase accuracy and damage, while higher "
"levels will help to bypass heavy armor and thick hides."
msgstr ""
"Votre compétence à manier les armes conçues pour couper, entailler et "
"taillader vos adversaires. Les premiers niveaux vous permettent d'augmenter "
"la précision et les dégâts, tandis que les niveaux les plus élevés permettent "
"de passer au travers des armures et des peaux les plus robustes."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You don't even know how to play-swordfight."
msgstr "Vous ne savez même pas comment faire de l'escrime avec un bâton d'enfant."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You at least know which part of the sword you're supposed to hold."
msgstr "Vous savez au moins quel part de l'épée vous êtes censé⋅e tenir."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You've learned how to cut properly with draw cuts and similar techniques."
msgstr "Vous avez appris comment lacérer correctement avec une lame."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You've learned how to fight with swords effectively."
msgstr "Vous avez appris comment la plupart des épées sont utilisées."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You've studied the blade."
msgstr "Vous avez étudier la lame."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You'd probably hit with the flat of the blade more than the edge."
msgstr "Vous peinez à utiliser une lame au lieu du plat."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You can usually get a decent cut when chopping."
msgstr "Vous arrivez assez bien à couper quelque chose avec une bonne lame."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You can reliably keep good edge alignment when slicing."
msgstr ""
"Vous êtes capable de garder la bonne orientation lorsque vous lacérez quelque "
"chose avec une lame."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "You're a fairly skilled swordsman."
msgstr "Vous êtes assez doué⋅e avec une épée."

#: data/json/skills.json
#. ~ Level description of skill "cutting weapons"
msgid "With your skill, in another life you could duel a samurai."
msgstr ""
"Avec votre talent, dans une autre vie vous auriez pu gagner un duel contre un "
"samouraï."

#: data/json/skills.json
#. ~ Description of skill "dodging"
msgid ""
"Your ability to dodge an oncoming threat, be it an enemy's attack, a "
"triggered trap, or a falling rock.  This skill is also used in attempts to "
"fall gracefully, and for other acrobatic feats.  The first number shown "
"includes modifiers, and the second does not."
msgstr ""
"Votre habileté à esquiver une menace imminente, qu'il s'agisse d'une attaque "
"ennemie, d'un piège déclenché ou d'une chute de roches.  Cette compétence est "
"également utilisée pour tenter de tomber avec grâce et pour d'autres "
"prouesses acrobatiques.  Le premier nombre affiché inclut des modificateurs, "
"le second non.  "

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid ""
"For most people, jumping out of the way of danger is instinct, and you barely "
"have that."
msgstr ""
"Pour la plupart des gens essayer d'éviter un danger est instinctif, mais vous "
"n'êtes même pas capable de ça."

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid "You might know how to dodge."
msgstr "Vous pouvez probablement esquiver de temps à autre."

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid ""
"You've learned how to minimize your movement with dodging to avoid "
"overexerting yourself."
msgstr ""
"Vous avez appris comment minimiser les mouvements nécessaires pour éviter des "
"attaques sans vous fatiguer."

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid ""
"You have a good grasp on various dodging techniques and ways to avoid being "
"grabbed."
msgstr ""
"Vous avez une bonne maîtrise des différentes techniques d'esquive et comment "
"éviter d'être saisi⋅e."

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid ""
"You know how to do a dodge, duck, dip, dive, and how to win every game of "
"dodgeball."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid "Your reflexes are dull and you have two left feet.  Hope you don't trip."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid "You can at least dodge without tripping over your own feet."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid "You have decent reflexes and can dodge a dodgeball."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid "You're fairly squirrely, most enemies will have some difficulty hitting you."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "dodging"
msgid "You have exceptional reflexes and are very slippery and hard to pin down."
msgstr ""
"Vous possédez des réflexes exceptionnels et glissez comme une anguille hors "
"des prises de vos adversaires."

#: data/json/skills.json
#. ~ Skill name
msgid "piercing weapons"
msgstr "armes perçantes"

#: data/json/skills.json
#. ~ Description of skill "piercing weapons"
msgid ""
"Your skill in fighting with knives, spears and other such stabbing "
"implements.  Skill increases attack accuracy as well as the chance of "
"inflicting a deadly and critical blow."
msgstr ""
"Votre compétence au combat avec les couteaux, les lances et autres armes de "
"type poignard. Les niveaux les plus élevés augmentent la précision et la "
"chance d'infliger des coups critiques voire mortels."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "You might not even be aware you're supposed to stab with a spear."
msgstr ""
"Vous n'êtes probablement même pas au courant que vous êtes censé·e pointer le "
"bout pointu d'une lance vers un ennemi."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "You understand the gist of thrusting weapons."
msgstr ""
"Vous comprenez les mouvements basiques nécessaires pour utiliser une arme "
"perçante."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "You know some of the techniques involved with thrusting weapons."
msgstr ""
"Vous avez étudié des routines assez élaborées pour utiliser des armes "
"perçantes un peu mieux."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "You're well-learned in fencing or spearmanship."
msgstr "Vous avez un bon niveau d'expérience avec une arme d'hast ou d'escrime."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "You could open a fencing school or start your own spear lessons."
msgstr ""
"Vous pourriez probablement éduquer votre propre petite phalange de lances "
"avec vos connaissances étendues sur les armes perçantes."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "You have a hard time spearing steak with a fork."
msgstr "Vous avez des difficultés à percer un steak avec une fourchette."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "Stabbing is an awkward motion for you."
msgstr ""
"Poignarder quelque chose n'est juste pas quelque chose qui vous vient "
"naturellement."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "You're a decent fencer or spearman."
msgstr "Vous êtes décent·e avec une rapière ou une lance."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid "You're a skilled fencer or spearman."
msgstr "Vous êtes sacrément doué·e avec une rapière ou une lance."

#: data/json/skills.json
#. ~ Level description of skill "piercing weapons"
msgid ""
"You're a commando with a knife, a fencing expert, and an accomplished "
"spearman."
msgstr ""
"Vous êtes un·e commando avec un couteau, pourriez vous débrouiller en escrime "
"olympique, et frotter vos épaules avec les phalanges d'Alexandre le Grand."

#: data/json/skills.json
#. ~ Skill name
msgid "unarmed combat"
msgstr "combat mains nues"

#: data/json/skills.json
#. ~ Description of skill "unarmed combat"
msgid ""
"Your skill in hand-to-hand fighting.  For the unskilled, it's a good way to "
"get hurt, but those with enough practice can perform special blows and "
"techniques to quickly dispatch enemies."
msgstr ""
"Votre compétence au combat à mains nues. Avec un niveau élevé cette "
"compétence peux vous permettre de délivrer des coups spéciaux pour "
"neutraliser rapidement un adversaire."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You've never had any interest in learning to fight."
msgstr "Apprendre à vous battre n'a jamais été quelque chose qui vous intéressait."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You can theoretically throw a punch."
msgstr "Vous êtes théoriquement capable d'assener une bonne beigne."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You know how to throw down."
msgstr "Vous savez comment vous battre."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You really know how to throw down."
msgstr ""

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You could probably teach your own martial art."
msgstr "Vous pourriez probablement fonder votre propre art martial."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "Punching someone is more likely to hurt you than them."
msgstr ""
"Vous une assez bonne chance de vous blesser si vous essayez de frapper "
"quelqu'un."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You can throw a punch.  Not well, but you can throw one."
msgstr "Vous pouvez assenez une beigne.  Pas très bien, mais vous pouvez le faire."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You're enough of a scrapper to fight with your fists if you have to."
msgstr ""
"Vous êtes assez doué⋅e pour vous défendre adéquatement avec vos poings si "
"cela est nécessaire."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You could win most bar fights."
msgstr "Vous pourriez probablement triompher dans la plupart des bagarres."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You'd have your black belt if any dojos were still open."
msgstr ""
"Vous pourriez passer une ceinture noire dans n'importe quel dojo si ceux-ci "
"était toujours ouverts."

#: data/json/skills.json
#. ~ Level description of skill "unarmed combat"
msgid "You could have multiple black belts or box in the major leagues."
msgstr "Vous pourriez passer plusieurs ceintures noires et boxer parmi les meilleurs."

#: data/json/skills.json
#. ~ Skill name
msgid "applied science"
msgstr "science appliquée"

#: data/json/skills.json
#. ~ Description of skill "applied science"
msgid ""
"Your skill in general 'bench science', applying any of a wide range of "
"precision techniques based on your overall understanding of scientific "
"principles.  This is not a research skill, but about using the results of "
"others' research."
msgstr ""
"Votre compétence générale en \"science de laboratoire\", appliquant de "
"nombreuses techniques de précision basées sur votre compréhension globale des "
"principes scientifiques.  Il ne s'agit pas de votre compétence dans la "
"recherche, mais votre capacité à utiliser les résultats de la recherche "
"d'autres personnes."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid "You're not even theoretically a physicist."
msgstr "Vous n'êtes même pas théoriquement un·e physiciste."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid "You have the basic understanding of science on par with a high schooler."
msgstr "Vous avez le niveau de savoir scientifique nécessaire pour passer le bac."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid "You have a decent understanding of science on par with a college graduate."
msgstr ""
"Vous avez le niveau nécessaire pour vous débrouiller durant une licence "
"scientifique."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid ""
"You have a deep understanding of the scientific method and possibly have a "
"degree in a scientific field."
msgstr ""
"Vous possédez un niveau de savoir scientifique considérable et probablement "
"un diplôme."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid "You likely have a PhD in a scientific field."
msgstr ""
"Vous possédez un doctorat scientifique, où vous auriez pu essayer d'en "
"obtenir un."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid "You skipped all your science classes."
msgstr "Vous avez séché toutes vos classes de science."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid "You've at least done high school chemistry classes."
msgstr "Vous avez au moins écouté durant vos classes de chimie de lycée."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid "You've worked with a few chemicals and can follow simple procedures."
msgstr ""
"Vous avez manipulé quelques types de produits chimiques et êtes capable de "
"suivre des procédures simples."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid ""
"You can follow some more complicated procedures and likely took advanced "
"chemistry courses."
msgstr ""
"Vous êtes capable de comprendre des procédures assez compliquées et avez "
"probablement suivi des cours de chimie avancés."

#: data/json/skills.json
#. ~ Level description of skill "applied science"
msgid "You can do some advanced chemistry, or just make drugs."
msgstr ""
"Vous êtes capable d'accomplir de la chimie complexe, ou juste synthétiser des "
"drogues sans faire du poison."

