#: data/json/furniture_and_terrain/terrain-mechanisms.json
#. ~ Terrain name
msgid "mechanical winch"
msgstr "treuil mécanique"

#: data/json/furniture_and_terrain/terrain-mechanisms.json
#. ~ Description of terrain "mechanical winch"
msgid ""
"A gate control winch.  If it's functioning, it can be used to open or close a "
"nearby gate or door."
msgstr ""
"Un treuil de commande de portail. S'il fonctionne, il peut être utilisé pour "
"ouvrir ou fermer un portail ou une porte à proximité."

#: data/json/furniture_and_terrain/terrain-mechanisms.json
#. ~ Description of terrain "mechanical winch"
#. ~ Description of terrain "control lever"
