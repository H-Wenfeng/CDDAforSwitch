#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "broken metal floor"
msgstr "sol métallique cassé"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "broken metal floor"
msgid ""
"Something has cratered this metal flooring.  It will be difficult to move "
"things across."
msgstr ""
"Quelque chose à endommagé cette section de sol en métal suffisamment pour "
"entraver significativement le mouvement à travers."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "floor"
msgstr "sol"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "floor"
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with wooden posts and beams that can support a roof."
msgstr ""
"Dalles de bois imbriquées, probablement traitées contre le feu, avec des "
"poteaux et des poutres en bois qui peuvent supporter un toit."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "primitive floor"
msgstr "sol de cahute"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "primitive floor"
msgid "A timber floor and supports that can support a roof."
msgstr "Un plancher et des supports en bois qui peuvent supporter un toit."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "simple metal floor"
msgstr "sol métallique rudimentaire"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "simple metal floor"
msgid ""
"A crudely welded-together metal floor with steel trusses and supporting "
"girders.  Can support a roof."
msgstr ""
"Un sol métallique grossièrement soudé avec des poutres en acier et des "
"poutres de soutien. Peut supporter un toit."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "waxed floor"
msgstr "parquet ciré"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "waxed floor"
msgid ""
"Hardwood flooring that has been treated with chemicals to improve slip "
"resistance and sliding, commonly for recreational sports.  It can support a "
"roof."
msgstr ""
"Revêtement de sol en bois dur traité avec des produits chimiques pour "
"améliorer l'adhérence et le glissement, généralement utilisé pour les sports "
"de loisirs. Peut supporter un toit."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "dirt floor"
msgstr "sol en terre"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "dirt floor"
msgid ""
"A floor consisting of finely mixed earth that has been tamped down.  It can "
"support a roof."
msgstr ""
"Un sol composé de terre finement mélangée et tassée. Il peut supporter un "
"toit."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "utility light"
msgstr "baladeuse"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "utility light"
msgid ""
"An industrial floodlight set up to illuminate the surroundings.  Smashing it "
"doesn't seem like it'd produce any worthwhile salvage."
msgstr ""
"Un projecteur industriel installé pour éclairer les environs. Le briser ne "
"semble pas offrir de récupération utile."

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Terrain name
msgid "wax floor"
msgstr "sol de cire"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#. ~ Description of terrain "wax floor"
msgid "A floor section made entirely out of wax."
msgstr "Une partie du sol entièrement en cire."

