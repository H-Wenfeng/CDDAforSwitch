msgstr[0] "antipsychotique"
msgstr[1] "antipsychotiques"
msgstr[2] "antipsychotiques"

#: data/json/items/comestibles/med.json
#. ~ Description of "antipsychotic"
msgid ""
"Anti-psychotic medication.  Used to stabilize brain chemistry, it can arrest "
"hallucinations and other symptoms of psychosis.  Carries a sedative effect."
msgstr ""
"Médicament antipsychotique. Utilisé pour stabiliser la chimie du cerveau, il "
"peut arrêter les hallucinations et les autres symptômes de la psychose. Il a "
"un effet sédatif."

#: data/json/items/comestibles/med.json
#. ~ Variant name of item "antipsychotic"
msgid "Thorazine"
msgid_plural "Thorazine"
msgstr[0] "Chlorpromazine"
msgstr[1] "Chlorpromazine"
msgstr[2] "Chlorpromazine"

#: data/json/items/comestibles/med.json
#. ~ Description of variant "Thorazine" of item "antipsychotic"
msgid "Its generic name is chlorpromazine."
msgstr "Aussi connue sous son nom générique chlorpromazine."

#: data/json/items/comestibles/med.json
#. ~ Item name
msgid "thyme oil"
msgid_plural "thyme oil"
msgstr[0] "huile de thym"
msgstr[1] "huile de thym"
msgstr[2] "huile de thym"

#: data/json/items/comestibles/med.json
#. ~ Description of "thyme oil"
msgid ""
"Some essential oil made from thyme, which can act as a mildly irritating "
"antiseptic."
msgstr ""
"Une huile essentielle faite à partir de thym, qui peut servir d'antiseptique "
"tout en étant légèrement irritant."

#: data/json/items/comestibles/med.json
#. ~ Item name
