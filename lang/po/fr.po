#. ~ Refusal reason for a shop item group
msgid "You need an armament license to buy this."
msgstr "Il faut un permis d'armement pour l'acheter."

#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_gun_trader.json
#: data/mods/aftershock_exoplanet/npcs/Augustmoon_Salvors/augustmoon_gun_trader.json
#. ~ Name suffix of an NPC
msgid "gun trader"
msgstr "vendeur/vendeuse d'armes"

#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_gun_trader.json
#: data/mods/aftershock_exoplanet/npcs/Augustmoon_Salvors/augustmoon_gun_trader.json
#. ~ NPC dialogue line
msgid ""
"&You find the clerk leaning before an almost impressive collection of "
"weaponry, most of it neatly displayed in racks or hanging from the curved "
"prefab ceiling.  <mypronoun> barely acknowledges your approach, it doesn't "
"seem like customer service is a priority here."
msgstr ""

#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_gun_trader.json
#: data/mods/aftershock_exoplanet/npcs/Augustmoon_Salvors/augustmoon_gun_trader.json
#. ~ Response to NPC dialogue
msgid "You sell guns here right?"
msgstr "Vous vendez des armes ici?"

#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_outfitter.json
#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_tool_trader.json
#: data/mods/Aftershock/npcs/Mercurial/clerk.json
