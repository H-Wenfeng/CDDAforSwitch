msgstr[1] "revolvers de chasse"
msgstr[2] "revolvers de chasse"

#: data/json/items/gun/4570.json
#. ~ Description of gun "hunting hand cannon"
#. ~ Description of "hunting hand cannon"
msgid ""
"A massive single-action revolver.  While the .45-70 rifle round loses "
"significant velocity in its short pistol barrel, it still competes with other "
"large magnum handguns in terms of power."
msgstr ""

#: data/json/items/gun/4570.json
