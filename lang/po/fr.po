#: data/json/npcs/your_followers/liam_chat.json
#: data/json/npcs/your_followers/liam_main_dialogue.json
#: data/json/npcs/your_followers/luo_follower.json
#. ~ Response to NPC dialogue
msgid "<lets_go>"
msgstr "<lets_go>"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_girl.json
#. ~ NPC dialogue line
msgid ""
"Thank you for saving me.  It's a shame my mother didn't make it… you did "
"everything you could, and I don't blame you for it…"
msgstr ""
"Merci de m'avoir sauvé.  C'est vraiment triste que ma mère n'ai pas survécu… "
"vous avez fait ce que vous pouviez, et je ne vous blâme pas pour ça…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_girl.json
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#: data/json/npcs/cabin_chemist/chemist_missions.json
