#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"When did you find out?\""
msgstr "\"Quand est-ce que vous avez compris?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Seven o'clock.\""
msgstr "\"Sept heures.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Nobody is helping us.\""
msgstr "\"Personne ne nous aide.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We're on our own.\""
msgstr "\"Il va falloir qu'on se débrouille seuls.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We're all alone.\""
msgstr "\"Nous sommes seuls.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We should split into groups of two each.\""
msgstr "\"On devrait se séparer en groupes de deux.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"It can't follow all of us.\""
msgstr "\"Il ne peux pas nous suivre tous.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Be careful out there.\""
msgstr "\"Soyez prudent là dehors.\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
msgid "\"There you are.\""
msgstr "\"Vous voilà.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"I've been looking all over for you.\""
msgstr "\"Je vous ai cherché partout.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"It's looking for us.\""
msgstr "\"Il nous cherche.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"It's faster than us.\""
msgstr "\"Il est plus rapide que nous.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"It's looking right at us.\""
msgstr "\"Ça nous a vu.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"It's heading right for us!\""
msgstr "\"Il se dirige vers nous!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Can you swim?\""
msgstr "\"Vous savez nager?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Don't do that.\""
msgstr "\"Ne faites pas ça.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_surgeon
msgid "\"You hear that?\""
msgstr "\"Vous entendez?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Be quiet.\""
msgstr "\"Silence.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Look out!\""
msgstr "\"Attention!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Run!\""
msgstr "\"Courrez!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Hurry!\""
msgstr "\"Vite!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"No!\""
msgstr "\"Non!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"I'll never forget you.\""
msgstr "\"Je ne vous oublierai jamais.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Take his gun, we're going to need it.\""
msgstr "\"Prenez cette arme, on va en avoir besoin.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"How do we get out of here?\""
msgstr "\"Comment on sort d'ici?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"This place is like a maze.\""
msgstr "\"Cet endroit est comme un labyrinthe.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Oh God, I'm the only one left.\""
msgstr "\"Mon Dieu, je suis le seul survivant.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Please, I don't want to die.\""
msgstr "\"S'il vous plait, je ne veux pas mourir.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Mom.\""
msgstr "\"Maman.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Mom, I miss you.\""
msgstr "\"Maman, tu me manques.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Me go, you stay.\""
msgstr "\"Moi partir, toi rester.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Please, God.\""
msgstr "\"S'il vous plaît, mon Dieu.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon,
#. mon_vocal_bigfrog
#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_slaver,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
msgid "a gurgling sound."
msgstr "un gargouillis."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon,
#. mon_vocal_bigfrog
#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_slaver,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
msgid "a choking sound."
msgstr "un étouffement."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a snapping sound."
msgstr "un claquement."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "BEEP!"
msgstr "BEEP!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a loud hiss."
msgstr "un sifflement fort."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a loud crackling noise."
msgstr "un crépitement fort."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a klaxon blaring!"
msgstr "un bruit de klaxon!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"EMERGENCY, EMERGENCY!\""
msgstr "\"URGENCE, URGENCE!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a static hissing sound."
msgstr "un sifflement statique."

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"That creepy abandoned post-apocalyptic lab complex looks safe…\""
msgstr ""
"\"Ce complexe de laboratoire abandonné sera sûrement un bon endroit ou se "
"poser…\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid ""
"\"Don't worry, it isn't like anything could teleport out of the containment "
"cells.\""
msgstr ""
"\"Pas de panique! Ce n'est pas comme si quelque chose pouvait se téléporter "
"hors des cellules de confinement.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Hold on, I want to pulp that zombie corpse.\""
msgstr "\"Attendez! Je veux pulvériser ce cadavre de zombie.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"What did that thing just hit me with?\""
msgstr "\"Avec quoi ce truc vient il de me frapper?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"I can barely move.  Run!  Save yourself!\""
msgstr "\"Je peux à peine bouger. Court! Sauve toi!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr "\"Oh sale connard égoïste, tu va le regretter\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"I… I feel weak…\""
msgstr "\"Je… je me sens faible…\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi-go_surgeon
msgid "\"Oi, dingus, you can't keep me in 'ere.\""
msgstr "\"Hé! Le cinglé, tu peux pas me garder la dedans.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We got a treaty w'yer people, don'we?\""
msgstr "\"On a un traité avec vos gens, non?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"This'll get back t'my bosses, right and so!\""
msgstr "\"Ça j'vais en informer mon chef et pas plus tard que maintenant!\"  "

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Lemme outta here!\""
msgstr "\"Laissez moi sortir de là!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We're both scavs, in't we?\""
msgstr "\"On est tout les deux des pillards, non?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Hey look, that one's carrying something.  Let's crack it open and steal it.\""
msgstr "\"Hé regarde, celui la transporte un truc. On l'ouvre et on prend tout\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"G… geddoff me you… you bastard…\""
msgstr "\"La… Lâche-moi, salopard…\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"GET WELL SOON!\""
msgstr "\"BON RÉTABLISSEMENT!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
