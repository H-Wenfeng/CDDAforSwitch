msgid " Recover Foragers"
msgstr " Récupérer Cueilleurs·ses"

#: src/faction_camp.cpp:1065
#, c-format
msgid ""
"Notes:\n"
"Send a companion to set traps for small game.\n"
"\n"
"Skill used: devices\n"
"Difficulty: N/A\n"
"Trapping Possibilities:\n"
"> small and tiny animal corpses\n"
"May produce less food than consumed!\n"
"Risk: Low\n"
"Intensity: Light\n"
"Time: 6 Hours, Repeated\n"
"Positions: %d/2\n"
msgstr ""
"Remarques :\n"
"Envoyez un compagnon pour poser des pièges pour le petit gibier.\n"
"\n"
"Compétence utilisée : dispositifs\n"
"Difficulté : N/A\n"
