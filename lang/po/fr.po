msgid_plural "wool staples"
msgstr[0] "tresses de laine"
msgstr[1] "tresses de laine"
msgstr[2] "tresses de laine"

#: data/json/items/resources/tailoring.json
#. ~ Description of "wool staple"
msgid ""
"A natural cluster of wool fibers.  Could be processed into felt patches or "
"yarn."
msgstr ""
"Un amas de fibres de laine, pourrait être transformé en du feutre ou une "
"bobine."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "fur patch"
msgid_plural "fur patches"
msgstr[0] "carré de fourrure"
msgstr[1] "carrés de fourrure"
msgstr[2] "carrés de fourrure"

#: data/json/items/resources/tailoring.json
#. ~ Description of "fur patch"
msgid ""
"A small bolt of fur from an animal, roughly six inches square.  Can be made "
"into patchwork fur sheets or used to repair fur fabric."
msgstr ""
"Petit morceau de fourrure provenant d'un animal, d'environ 15 cm de côté. On "
"peut en faire des draps de fourrure en patchwork ou les utiliser pour réparer "
"un tissu de fourrure."

#: data/json/items/resources/tailoring.json
#. ~ Item name
msgid "faux fur patch"
msgid_plural "faux fur patches"
msgstr[0] "carré de fausse fourrure"
msgstr[1] "carrés de fausse fourrure"
msgstr[2] "carrés de fausse fourrure"

#: data/json/items/resources/tailoring.json
#. ~ Description of "faux fur patch"
msgid ""
"A small bolt of garishly-colored faux fur, roughly six inches square.  Can be "
"made into patchwork faux fur sheets or used to repair faux fur fabric."
msgstr ""
"Un petit morceau de fausse fourrure aux couleurs criardes, d'environ 15 cm de "
"côté. Il peut être utilisé pour réaliser des patchworks de fausse fourrure ou "
"pour réparer des tissus en fausse fourrure."

#: data/json/items/resources/tailoring.json
#. ~ Item name
