msgctxt "u:n"
msgid "Hey stranger.  How's life treatin' ya these days?"
msgstr "Hé, l'étranger. Comment la vie te traite-t-elle ces jours-ci ?"

#: data/json/npcs/other/TALK_NPC_APARTMENT_SURVIVOR.json
#: data/json/npcs/other/TALK_NPC_PREPPER_SURVIVOR.json
#. ~ NPC dialogue line
