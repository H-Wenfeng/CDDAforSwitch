#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a whisper behind you, too low to make out any words."
msgstr ""
"Vous entendez un chuchotement derrière vous, la voix parlant trop bas pour "
"que vous soyez capable de distinguer des mots."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a single loud footstep behind you."
msgstr ""

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a low growl that fades away into silence."
msgstr "Vous entendez un grognement sourd qui s'éloigne rapidement."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a drawn-out, rasping breath that ends in a cough."
msgstr ""
"Vous entendez une inspiration râpeuse prolongée qui s'achève en une quinte de "
"toux."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a few moments of toneless droning before it abruptly ends."
msgstr ""
"Vous entendez un bourdonnement monotone pendant quelques secondes qui "
"s'achève brutalement."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a low hum that makes your teeth vibrate."
msgstr "Vous entendez un bourdonnement grave qui fait vibrer vos dents."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear indistinct yelling, too muffled to make out."
msgstr ""
"Vous entendez des cris indistincts, trop étouffés pour comprendre quoi que ce "
"soit."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "Your ears suddenly ring, blocking out all other sounds."
msgstr ""
"Vos oreilles commencent à siffler soudainement et vous n'arrivez plus a "
"entendre quoi que ce soit d'autre pendant un moment."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a single low tone from a distant bell."
msgstr "Vous entendez une note grave unique sonnée par une cloche éloignée."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a high-pitched tittering that is suddenly cut-off."
msgstr "Vous entendez un ricanement aigu qui s'interrompt soudainement."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "For a moment, you hear the sound of water flowing over stone."
msgstr ""
"Pendant un moment, vous avez l'impression d'entendre de l'eau s'écoulant sur "
"la pierre."

#: data/mods/MindOverMatter/snippets/snippets_observed.json
#. ~ Snippet in category "observed_effect_hearing_sounds"
msgid "You hear a very faint, \"Tekeli-li!  Tekeli-li!\""
msgstr "Vous entendez un \"Tekeli-li!  Tekeli-li!\" très attenué."

#: data/mods/MindOverMatter/snippets/speech.json
#. ~ Speech from speaker mon_feral_human_pyrokin3, mon_feral_human_pyrokin2,
#. mon_civilian_pyrokinetic
msgid "the crackle of flames."
msgstr "un craquement de flammes."

#: data/mods/MindOverMatter/snippets/speech.json
#. ~ Speech from speaker mon_feral_human_pyrokin3, mon_feral_human_pyrokin2
msgid "\"Must… burn…\""
msgstr "\"Je dois… brûler…\""

#: data/mods/MindOverMatter/snippets/speech.json
#. ~ Speech from speaker mon_feral_human_teep2
