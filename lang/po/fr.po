#: data/mods/alt_map_key/overmap_terrain_light_green.json
#. ~ Terrain name
#. ~ Overmap terrain vision level name
#. ~ Overmap terrain name
msgid "open air"
msgstr "plein air"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#. ~ Description of terrain "open air"
msgid "An area of open air."
msgstr "Un volume vide rempli d'air."

#: data/json/furniture_and_terrain/special_use/isherwood_spawnpoints.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/furniture_and_terrain/terrain_vitrified.json
#. ~ Description of terrain "dirt"
msgid ""
"It's dirt.  Looks like some fine soil for tillage.  Could also be dug out for "
"construction projects."
msgstr ""
"C'est de la terre. On dirait de la terre fine pour le travail du sol. Elle "
"pourrait également être creusée pour des projets de construction."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture-plants.json
#. ~ Terrain name
#. ~ Furniture name
msgid "forest floor"
msgstr "tapis forestier"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "forest floor"
msgid "Covered in twigs and lots of brown, decaying leaves."
msgstr "Une section de sol couvert de mousses, brindilles et feuilles mortes."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "mound of sand"
msgid "A mound of sand."
msgstr "Un monticule de sable."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "glassed sand"
msgstr "sable vitré"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "glassed sand"
msgid ""
"A patch of sand with a crust of natural glass atop it from exposure to "
"intense heat."
msgstr ""
"Un bout de sable recouvert d'une croûte de verre naturel, formé par une "
"exposition à une chaleur intense."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/furniture_and_terrain/terrain_vitrified.json
#. ~ Bashing sound
msgid "crunch"
msgstr "crunch"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "upturned dirt"
msgstr "terre retournée"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "upturned dirt"
msgid ""
"An area of loose dirt, not easily traversable.  If examined more closely, "
"it's quite favorable for planting seeds and the like."
msgstr ""
"Une zone de terre meuble, difficile à traverser. Si examinée de plus près, "
"elle est plutôt favorable pour planter des graines et autres."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "mound of upturned dirt"
msgstr "monticule de terre retournée"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "mound of upturned dirt"
msgid "A giant hill of dirt that looks like you could crawl inside for shelter."
msgstr ""
"Une énorme colline de terre qui a l'air d'offrir un abri où l'on pourrait se "
"glisser."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "odd fault"
msgstr "faille étrange"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "odd fault"
msgid ""
"An unnaturally humanoid-shaped hole, it seems oddly familiar.  You feel a "
"strange urge to examine it closer, as if it belongs to you somehow."
msgstr ""
"Ce trou à la forme anormalement humanoïde vous semble étrangement familier. "
"Vous ressentez une étrange envie de l'examiner de plus près, comme s'il vous "
"appartenait d'une manière ou d'une autre."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Player message in effect in EoC "EOC_TERRAIN_FAULT" in terrain "odd
#. fault"'s examine action
msgid ""
"This wall is perfectly vertical.  Odd, twisted holes are set in it, leading "
"as far back into the solid rock as you can see.  The holes are humanoid in "
"shape, but with long, twisted, distended limbs."
msgstr ""
"Ce mur est parfaitement vertical. Il est percé de trous étranges et tordus "
"qui s'enfoncent aussi loin que possible dans la roche solide. Les trous ont "
"une forme humanoïde, mais avec des membres longs, tordus et distendus."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "grave"
msgstr "tombe"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "grave"
msgid ""
"A dirt grave, with some grass growing on it.  At least some of the dead do "
"actually rest in peace."
msgstr ""
"Une tombe en terre battue, avec un peu d'herbe qui pousse dessus. Au moins, "
"certains morts reposent en paix."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "grave"
msgid ""
"A fresh grave, covered with stones, either to keep something from digging it "
"up or to keep one inside from digging out of it.  Or both.  Two planks mark "
"this place of someone's eternal rest."
msgstr ""
"Une tombe fraîche, recouverte de pierres, soit pour empêcher quelque chose de "
"la creuser, soit pour empêcher quelqu'un qui se trouve à l'intérieur de la "
"tombe de la creuser. Ou les deux. Deux planches marquent l'endroit du repos "
"éternel de quelqu'un."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "rock floor"
msgid ""
"A relatively flat area of rock and stone.  Looks stable enough to be mined "
"with the proper mining gear."
msgstr ""
"Une zone rocheuse relativement plate. Elle semble suffisamment stable pour "
"être exploitée avec l'équipement minier approprié."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "rubber mulch"
msgstr "paillis de caoutchouc"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "rubber mulch"
msgid ""
"A large area mulched with shredded rubber.  It's a softer place to land than "
"regular dirt."
msgstr ""
"Une grande zone paillée avec du caoutchouc déchiqueté. C'est un endroit plus "
"doux que la terre battue."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/overmap/vision_levels.json
#: data/mods/innawood/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
#. ~ Overmap terrain vision level name
msgid "pavement"
msgstr "chaussée"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "pavement"
msgid ""
"A segment of asphalt, slowly degrading from cracks, frost heaves, and lack of "
"maintenance."
msgstr ""
"Un segment d'asphalte qui se dégrade lentement à cause des fissures, des "
"soulèvements dus au gel et du manque d'entretien."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/innawood/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "yellow pavement"
msgstr "chaussée jaune"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/innawood/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "yellow pavement"
msgid ""
"Streaks of carefully aligned yellow paint mark the road to inform drivers not "
"to cross.  No one is enforcing these rules anymore."
msgstr ""
"Des bandes de peinture jaune soigneusement alignées marquent la route pour "
"indiquer aux conducteurs qu'ils ne doivent pas traverser. Plus personne ne "
"fait respecter ces règles."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "pedestrian crossing"
msgstr "passage à piétons"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "pedestrian crossing"
msgid ""
"White polymer lines painted on the pavement which indicate places where "
"pedestrians should cross the road."
msgstr ""
"Lignes de polymère blanches peintes sur la chaussée qui indiquent les "
"endroits où les piétons doivent traverser la route."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "sidewalk"
msgid ""
"An area of common poured concrete, damaged by frost heaves and large cracks "
"due to lack of maintenance."
msgstr ""
"Une zone de béton coulé commun, endommagée par des coups de gel et de grandes "
"fissures dues à un manque d'entretien."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "concrete floor"
msgid "A bare and cold concrete floor."
msgstr "Un sol en béton nu et froid."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_habitat_floor.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_habitat_floor.json
#. ~ Description of terrain "reinforced concrete floor"
msgid ""
"An extremely resilient floor made from carefully placed rebar and poured "
"concrete, capable of providing protection from the elements.  As for the "
"matching roof, it still requires supporting walls, otherwise it may very well "
"cave in."
msgstr ""
"Un plancher extrêmement résistant, fait de barres d'armature soigneusement "
"placées et de béton coulé, capable d'offrir une protection contre les "
"éléments. Quant au toit assorti, il nécessite encore des murs de soutien, "
"faute de quoi il risque de s'effondrer."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "concrete"
msgstr "béton"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "concrete"
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles."
msgstr ""
"Un segment plus récent de béton coulé avec des finitions de surface pour "
"l'esthétique et la résistance aux cycles de gel-dégel."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "concrete"
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles.  Covered with a streak of yellow paint."
msgstr ""
"Un segment plus récent de béton coulé avec des finitions de surface pour "
"l'esthétique et la résistance aux cycles de gel-dégel. Recouvert d'une trace "
"de peinture jaune."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "wooden floor"
msgstr "sol en bois"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "wooden floor"
msgid ""
"A wooden floor created from boards, packed tightly together and nailed down.  "
"Common on patios."
msgstr ""
"Plancher en bois constitué de planches serrées les unes contre les autres et "
"clouées. Courant sur les terrasses."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "wooden floor gangway"
msgstr "passerelle en bois"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "wooden floor gangway"
msgid ""
"A wooden gangway bridging a short gap.  Sturdy enough to act as a floor, but "
"not sufficient to support additional flooring."
msgstr ""
"Une passerelle en bois qui comble un court espace. Suffisamment solide pour "
"servir de plancher, mais pas assez pour supporter un plancher supplémentaire."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "metal floor"
msgid ""
"High-quality and tough checkered metal flooring to reduce the risk of slips "
"and falls."
msgstr ""
"Revêtement de sol métallique en damier de haute qualité et résistant pour "
"réduire le risque de glissades et de chutes."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "metal floor gangway"
msgstr "passerelle de sol en métal"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "metal floor gangway"
msgid ""
"A metal gangway bridging a short gap.  Sturdy enough to act as a floor, but "
"not sufficient to support additional flooring."
msgstr ""
"Passerelle métallique permettant de combler un court espace. Suffisamment "
"solide pour servir de plancher, mais pas assez pour supporter un plancher "
"supplémentaire."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "linoleum tile"
msgid ""
"A section of flooring made out of a tough, rubbery material.  Colored a "
"simple white."
msgstr ""
"Une section de plancher faite d'un matériau résistant et caoutchouteux. De "
"couleur blanche simple."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "linoleum tile"
msgid "A section of flooring made out of a tough, gray, rubbery material."
msgstr "Une section de plancher faite d'un matériau dur, gris et caoutchouteux."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "dirt floor"
msgid "A floor consisting of finely mixed earth that has been tamped down."
msgstr "Une section de sol consistant de terre ayant été pulvérisée puis tassée."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "gelatinous ground"
msgstr "sol gélatineux"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "gelatinous ground"
msgid ""
"An incursion of a large area of otherworldly substrate, it feels like walking "
"on hardened gelatin."
msgstr ""
"Une incursion de sol extradimensional donnant l'impression d'être entièrement "
"composé de gélatine durcie."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "orifice"
msgstr "orifice"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "orifice"
msgid ""
"A large round orifice, with trails of fresh and dried-up strange green liquid "
"with a strongly acidic odor covering its inner sides."
msgstr ""
"Un orifice sphérique, des trainées d'un liquide vert étrange en train de "
"sécher recouvrant l'intérieur."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "elevator"
msgid "An elevator section of the flight deck."
msgstr "Une section de l'ascenseur du pont d'envol."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "deck coating"
msgstr "revêtement de pont"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "deck coating"
msgid ""
"A thick metal hull coating, covered with a military-grade epoxy mix.  Used "
"for runways, and can't be melted by jet engine nozzles."
msgstr ""
"Un revêtement de coque métallique épais, recouvert d'un mélange époxy de "
"qualité militaire. Il est utilisé pour les pistes d'atterrissage et ne peut "
"être fondu par les tuyères des moteurs à réaction."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "yellow deck coating"
msgstr "revêtement jaune pour terrasse"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "yellow deck coating"
msgid ""
"A thick metal hull covering, covered with a military-grade epoxy mix and "
"painted yellow."
msgstr ""
"Un revêtement en métal épais, recouverte d'un mélange époxy de qualité "
"militaire et peinte en jaune."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "red deck coating"
msgstr "revêtement de terrasse rouge."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "red deck coating"
msgid ""
"A thick metal hull covering, covered with a military-grade epoxy mix, and "
"painted red."
msgstr ""
"Un revêtement en métal épais, recouvert d'un mélange époxy militaire et peint "
"en rouge."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "white deck coating"
msgstr "revêtement de terrasse blanc."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "white deck coating"
msgid ""
"A thick metal hull covering, covered with a military-grade epoxy mix and "
"painted white."
msgstr ""
"Un revêtement en métal épais, recouvert d'un mélange époxy militaire et peint "
"en blanc."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "stone masonry floor"
msgstr "sol en pierre taillée"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "stone masonry floor"
msgid "A floor of carefully cut and laid stones, joined with mortar."
msgstr "Un sol en pierres soigneusement taillées et posées, jointées avec du mortier."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "metal grate"
msgid ""
"A walkway that can be used as a protective covering over drains, or even as a "
"filter."
msgstr ""
"Un passage qui peut être utilisé comme protection au-dessus des drains, ou "
"même comme filtre."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "red floor"
msgstr "sol rouge"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "red floor"
msgid "A red section of flooring."
msgstr "Une section de plancher rouge."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "green floor"
msgstr "sol vert"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "green floor"
msgid "A green section of flooring."
msgstr "Une section de sol verte."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "blue floor"
msgstr "sol bleu"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "blue floor"
msgid "A blue section of flooring."
msgstr "Une section de sol bleue."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_flora.json
#. ~ Terrain name
msgid "oak tree"
msgstr "chêne"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "oak tree"
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout the New England region.  If you look closely, you can see some "
"acorns the squirrels haven't gotten yet."
msgstr ""
"Un arbre aux feuilles caduques massif appartenant au genre \"Quercus\", un "
"arbre commun à travers la Nouvelle Angleterre. Vous observez quelques glands "
"mûrs n'ayant pas encore été touchés par les écureuils."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout the New England region."
msgstr ""
"Un arbre aux feuilles caduques massif appartenant au genre \"Quercus\", un "
"arbre commun à travers la Nouvelle Angleterre."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "walnut tree"
msgstr "noyer"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "walnut tree"
msgid ""
"A massive tree belonging to the 'Juglans' genus.  If you look closely, you "
"can see some unharvested walnuts."
msgstr ""
"Un arbre massif appartenant au genre \"Juglans\". En regardant de plus près, "
"vous observez des noix ayant l'air récoltables."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A massive tree belonging to the 'Juglans' genus."
msgstr "Un arbre massif appartenant au genre \"Juglans\"."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "butternut tree"
msgstr "noyer cendré"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "butternut tree"
msgid ""
"A massive tree belonging to the 'Juglans' genus, but with lighter bark and "
"more elongated fruits than the more common black walnut.  If you look "
"closely, you can see some unharvested butternuts."
msgstr ""
"Un arbre massif appartenant au genre \"Juglans\", son écorce étant plus "
"claire et ses fruits plus allongés que le noyer noir plus répandu. Vous "
"observez quelques noix douces pouvant être récoltées."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"A massive tree belonging to the 'Juglans' genus, but with lighter bark and "
"more elongated fruits than the more common black walnut."
msgstr ""
"Un arbre massif appartenant au genre \"Juglans\", son écorce étant plus "
"claire et ses fruits plus allongés que le noyer noir plus répandu."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "blackjack oak"
msgstr "chêne noir"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "blackjack oak"
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  You could peel off the bark "
"sections if you examined the tree more closely."
msgstr ""
"Arbre à feuilles caduques du genre \"Quercus\", dont l'écorce est fendue en "
"plaques rectangulaires noires séparées par d'étroites fissures orange. En "
"examinant l'arbre de plus près, on peut décoller les parties de l'écorce."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  All the usable bark has been "
"stripped off."
msgstr ""
"Un arbre à feuilles caduques du genre \"Quercus\", dont l'écorce est fissurée "
"en plaques rectangulaires noires séparées par d'étroites fissures oranges. "
"Toute l'écorce utilisable a été enlevée."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "alder tree"
msgstr "aulne"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "alder tree"
msgid ""
"A deciduous flowering tree with serrated, scalloped, round-obovate leaves, "
"commonly forming dense groves alongside water."
msgstr ""
"Un arbre à fleurs aux feuilles rondes-obovales caduques, dentelées et "
"festonnées formant habituellement de denses bosquets le long de plans d'eau."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/TropiCataclysm/furniture_and_terrain/tropical_terrain_flora.json
#. ~ Terrain name
msgid "chestnut tree"
msgstr "châtaignier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "chestnut tree"
msgid ""
"A massive tree belonging to the 'Castanea' genus.  If you look closely, you "
"can see some unharvested chestnuts."
msgstr ""
"Un arbre massif appartenant au genre \"Castanea\". En regardant de plus près, "
"vous observez des châtaignes ayant l'air récoltables."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A massive tree belonging to the 'Castanea' genus."
msgstr "Un arbre massif appartenant au genre \"Castanea\"."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "beech tree"
msgstr "hêtre"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "beech tree"
msgid ""
"A massive tree belonging to the 'Fagus' genus.  If you look closely, you can "
"see some unharvested beech nuts."
msgstr ""
"Un arbre massif appartenant au genre \"Fagus\". En regardant de plus près, "
"vous observez des faînes ayant l'air récoltables."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A massive tree belonging to the 'Fagus' genus."
msgstr "Un arbre massif appartenant au genre \"Fagus\"."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "hazelnut tree"
msgstr "noisetier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hazelnut tree"
msgid ""
"A stubby tree belonging to the 'Corylus' genus.  If you look closely, you can "
"see some unharvested hazelnuts."
msgstr ""
"Un arbre trapu appartenant au genre \"Corylus\". En regardant de plus près, "
"vous observez des noisettes ayant l'air récoltables."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hazelnut tree"
msgid "A stubby tree belonging to the 'Corylus' genus."
msgstr "Un arbre trapu appartenant au genre \"Corylus\"."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "basswood tree"
msgstr "tilleul"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "basswood tree"
msgid ""
"The American linden.  It has pretty and sweet-smelling flowers in the summer, "
"and you might be able to eat its young leaves in the spring."
msgstr ""
"Le tilleul d'Amérique. Il a de jolies fleurs odorantes en été, et vous "
"pourrez peut-être manger ses jeunes feuilles au printemps."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"The American linden.  It has pretty and sweet-smelling flowers in the summer, "
"and its edible young leaves have already been harvested."
msgstr ""
"Le tilleul d'Amérique. Il porte de jolies fleurs odorantes en été et ses "
"jeunes feuilles comestibles ont déjà été récoltées."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "cottonwood tree"
msgstr "peuplier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "cottonwood tree"
msgid ""
"A large tree belonging to the 'Populus' genus, commonly found throughout the "
"New England region.  You see some cottonwood tree bolls that can be harvested."
msgstr ""
"Un grand arbre appartenant au genre \"Populus, un arbre commun à travers la "
"Nouvelle Angleterre. Vous observez quelque capsules à votre portée que vous "
"pourriez récolter."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "cottonwood tree"
msgid ""
"A large tree belonging to the 'Populus' genus, commonly found throughout the "
"New England region.  All the cottonwood tree bolls have been harvested."
msgstr ""
"Un grand arbre appartenant au genre \"Populus, un arbre commun à travers la "
"Nouvelle Angleterre. Toute les capsules à votre portée ont été récoltées."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "elm tree"
msgstr "orme"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "elm tree"
msgid ""
"A large tree belonging to the 'Ulmus' genus, commonly found throughout the "
"New England region."
msgstr ""
"Un large arbre appartenant au genre \"Ulmus\", un arbre commun à travers la "
"nouvelle angleterre."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead tree"
msgstr "arbre mort"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead tree"
msgid ""
"An indiscernible tree that has withered away due to weather, fire, or "
"otherworldly causes."
msgstr ""
"Un arbre indiscernable qui s'est desséché à cause des intempéries, du feu ou "
"d'autres causes."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead tree"
msgid ""
"An indiscernible tree that has withered away due to weather, fire, or "
"otherworldly causes.  Someone or something has broken most of its dead "
"branches, leaving little but its gnarled trunk."
msgstr ""
"Un arbre indiscernable qui s'est desséché sous l'effet du temps, du feu ou "
"d'autres causes. Quelqu'un ou quelque chose a cassé la plupart de ses "
"branches mortes, ne laissant que son tronc noueux."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "warped dead tree"
msgstr "arbre mort déformé"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "warped dead tree"
msgid ""
"This deciduous tree's branches are warped into a spiral.  This appears to "
"have killed it."
msgstr ""
"Les branches de cet arbre à feuilles caduques ont été transformée en "
"spirales, ce processus l'ayant apparemment tué."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/innawood/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "young tree"
msgstr "jeune arbre"

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/innawood/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "young tree"
msgid ""
"A relatively young sapling of an indeterminate species.  It could take "
"decades before reaching maturity, so there's no use waiting around."
msgstr ""
"Un arbre relativement jeune dont l'espèce est encore difficile à déterminer. "
"Cela pourrait prendre des décennies avant qu'ils soit mature, donc ne restez "
"pas planté(e) là à l'attendre."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "mega fern"
msgstr "fougère géante"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "mega fern"
msgid ""
"A gigantic fern like nothing you've seen before.  The leaves are a bright "
"scarlet with a net-like structure of green veins.  The multipronged trunks "
"have the texture of balsa wood."
msgstr ""
"Une fougère gigantesque comme vous n'en avez jamais vu auparavant. Les "
"feuilles sont d'un écarlate vif avec une structure de veines vertes en forme "
"de filet. Les troncs à plusieurs branches ont la texture du bois de balsa."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "apple tree"
msgstr "pommier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apple tree"
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known as "
"apples.  If you examined the branches more closely, you could probably find a "
"few mature ones in autumn."
msgstr ""
"Cet arbre est un membre du genre \"Malus\", produisant le fruit connu sous le "
"nom de pomme. Si vous examiniez ses branches durant l'automne vous pourriez "
"probablement trouver en trouver quelques unes bien mûres."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known as "
"apples.  There do not appear to be any ripe apples now."
msgstr ""
"Un membre du genre \"Malus\", cet arbre produit des fruits communément connus "
"sous le nom de pommes. Il n'y a pas l'air d'avoir de pommes mûres dessus en "
"ce moment."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "crabapple tree"
msgstr "pommier sauvage"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "crabapple tree"
msgid ""
"This tree is a member of the 'Malus' genus, though unlike popular cultivars, "
"its fruits are small and sour.  If you examined the branches more closely, "
"you could probably find a few mature ones in autumn."
msgstr ""
"Cet arbre appartient au genre \"Malus\", mais contrairement aux cultivars "
"populaires, ses fruits sont petits et amers. Si vous examiniez de plus près "
"les branches, vous pourriez probablement en trouver quelques-uns de mûrs en "
"automne."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"This tree is a member of the 'Malus' genus, though unlike popular cultivars, "
"its fruits are small and sour.  There do not appear to be any ripe crabapples "
"now."
msgstr ""
"Cet arbre appartient au genre \"Malus\", mais contrairement aux cultivars "
"populaires, ses fruits sont petits et amers. Il ne semble pas y avoir de "
"pommes sauvages mûres actuellement."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "pear tree"
msgstr "poirier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pear tree"
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces fruit in "
"the fall.  If you examined the branches more closely, you could probably find "
"a few mature ones."
msgstr ""
"Un \"Pyrus communis\" ou poirier commun, produisant ses fruits durant "
"l'automne. Si vous examiniez ses branches de plus près, vous pourriez "
"probablement en trouver plusieurs assez mûres."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pear tree"
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces fruit in "
"the fall.  Looks like all the ripe pears have been picked."
msgstr ""
"Un \"Pyrus communis\" ou poirier commun, produisant ses fruits durant "
"l'automne. On dirait que toutes les poires mûres ont déjà été cueillies."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "coffee tree"
msgstr "arbre à café du kentucky"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "coffee tree"
msgid ""
"This is 'Gymnocladus dioicus', or the Kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  If you examined the "
"branches more closely, you could probably find a few mature ones."
msgstr ""
"Cet arbre est un \"Gymnocladus dioicus\", également connu sous le nom de "
"caféier du Kentucky, qui produit des gousses de café torréfiables et des "
"feuilles infusables en automne. Si vous examiniez de plus près les branches, "
"vous pourriez probablement en trouver quelques-unes de mûres."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"This is 'Gymnocladus dioicus', or the Kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  Looks like all the "
"ripe pods have been picked."
msgstr ""
"Cet arbre est un \"Gymnocladus dioicus\", également connu sous le nom de "
"caféier du Kentucky, qui produit des gousses de café torréfiables et des "
"feuilles infusables en automne. Il semble que toutes les gousses mûres ont "
"été cueillies."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "cherry tree"
msgstr "cerisier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "cherry tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  If you examined the foliage more closely, you could "
"probably find some viable clusters."
msgstr ""
"Un membre de l'une de quelques espèces différentes du genre \"Prunus\" "
"présentes en Nouvelle Angleterre, ayant pour fruits des cerises durant l'été. "
"Si vous examiniez ses branches de plus près, vous pourriez probablement en "
"trouver quelques grappes mûres."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "cherry tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  Looks like all the ripe bunches of cherries have "
"been picked."
msgstr ""
"Un membre de l'une de quelques espèces différentes du genre \"Prunus\" "
"présentes en Nouvelle Angleterre, ayant pour fruits des cerises durant l'été. "
"On dirait que toutes les cerises mûres on déjà été cueillies."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "juniper tree"
msgstr "genévrier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "juniper tree"
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries "
"grow over two to three years.  It flowers in the first year, produces a green "
"berry the second, and in the third produces the more famed blue varieties.  "
"If you examined the foliage more closely, you could probably find some viable "
"clusters."
msgstr ""
"L'une des espèces de \"Juniperus\" qui poussent en Nouvelle-Angleterre, les "
"baies de genévrier poussent sur deux ou trois ans. Il fleurit la première "
"année, produit une baie verte la deuxième année et, la troisième année, les "
"variétés bleues les plus célèbres. En examinant le feuillage de plus près, on "
"peut probablement trouver des grappes viables."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "juniper tree"
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries "
"grow over two to three years.  It flowers in the first year, produces a green "
"berry the second, and in the third produces the more famed blue varieties.  "
"Looks like all the ripe bunches of berries have been picked."
msgstr ""
"L'une des espèces de \"Juniperus\" qui poussent en Nouvelle-Angleterre, les "
"baies de genévrier poussent sur deux ou trois ans. Il fleurit la première "
"année, produit des baies vertes la deuxième année et, la troisième année, les "
"variétés bleues les plus célèbres. On dirait que toutes les grappes de baies "
"mûres ont été cueillies."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "peach tree"
msgstr "pêcher"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "peach tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  If you examined the branches more closely, you could "
"probably find some mature peaches."
msgstr ""
"Un membre de l'une de quelques espèces différentes du genre \"Prunus\" "
"présentes en Nouvelle Angleterre, ayant pour fruits des pêches durant l'été. "
"Si vous examiniez ses branches de plus près, vous pourriez probablement en "
"trouver quelques unes bien mûres."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "peach tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  Looks like all the ripe peaches have been picked."
msgstr ""
"Un membre de l'une de quelques espèces différentes du genre \"Prunus\" "
"présentes en Nouvelle Angleterre, ayant pour fruits des pêches durant l'été. "
"On dirait que toutes les pêches mûres on déjà été cueillies."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "apricot tree"
msgstr "abricotier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apricot tree"
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  If you examined the spurs more closely, "
"you could probably find some mature apricots."
msgstr ""
"Une espèce greffée de 'Prunus armeniaca', rare en Nouvelle-Angleterre. "
"Produit des abricots en été. Si vous examiniez les branches de plus près, "
"vous pourriez probablement trouver quelques abricots mûrs."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apricot tree"
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  Looks like all the ripe apricots have "
"been picked."
msgstr ""
"Une espèce greffée de 'Prunus armeniaca', rare en Nouvelle-Angleterre. "
"Produit des abricots en été. On dirait que tous les abricots mûrs ont été "
"cueillis."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "plum tree"
msgstr "prunier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "plum tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  If you examined the spurs more closely, you "
"could probably find some ripe plums."
msgstr ""
"L'une des nombreuses espèces de 'Prunus' que l'on trouve en "
"Nouvelle-Angleterre, il produit des prunes en été. En examinant de plus près "
"les éperons, on peut probablement trouver des prunes mûres."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "plum tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  Looks like all the ripe plums have been picked."
msgstr ""
"L'une des nombreuses espèces de Prunus que l'on trouve en "
"Nouvelle-Angleterre, il produit des prunes en été. On dirait que toutes les "
"prunes mûres ont été cueillies."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "mulberry tree"
msgstr "mûrier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "mulberry tree"
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known as "
"mulberries.  In the summer, many berries can be picked."
msgstr ""
"Cet arbre fait partie du genre 'Morus', produisant des fruits communément "
"appelés mûres. En été, de nombreuses baies peuvent être cueillies."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "mulberry tree"
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known as "
"mulberries.  There do not appear to be any ripe mulberries now."
msgstr ""
"Cet arbre appartient au genre \"Morus\" et produit des fruits communément "
"appelés mûres. Il ne semble pas y avoir de mûres actuellement."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tupelo tree"
msgstr "gommier noir"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tupelo tree"
msgid ""
"Its name, originating from Native American tongues and garbled by the "
"settlers, approximately means \"swamp tree\".  During autumn it bears "
"cherry-like fruits."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tupelo tree"
msgid ""
"Its name, originating from Native American tongues and garbled by the "
"settlers, approximately means \"swamp tree\".  During autumn it bears "
"cherry-like fruits, but someone picked this one clean already."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "nannyberry tree"
msgstr "viorne lentago"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "nannyberry tree"
msgid ""
"This small tree, it could almost be a large shrub, bears clusters of dark "
"blue berries in autumn."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "nannyberry tree"
msgid ""
"This small tree, it could almost be a large shrub, bears clusters of dark "
"blue berries in autumn, but someone picked this one clean already."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "elderberry tree"
msgstr "sureau"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "elderberry tree"
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly known "
"as elderberries.  In the summer, many berries can be picked."
msgstr ""
"Cet arbre est un membre du genre \"Sambucus\", et produit des baies "
"communément connues comme baies de sureau durant l'été."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "elderberry tree"
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly known "
"as elderberries.  There do not appear to be any ripe elderberries now."
msgstr ""
"Cet arbre est un membre du genre \"Sambucus\", et produit des baies "
"communément connues comme baies de sureau durant l'été. Il n'y a pas l'air "
"d'avoir de baies mûres en ce moment."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "pine tree"
msgstr "sapin"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pine tree"
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  If "
"you examined the tree more closely, you might find usable sticky whorls, "
"resin clumps, and pinecones."
msgstr ""
"Un conifère imposant appartenant aux genre \"Pinus\", et celui-ci faisant "
"probablement partie d'une des trois espèces les plus répandues en Nouvelle "
"Angleterre, \"P. strobus\",\"P. resinosa\" ou \"P. rigida\". Si vous "
"inspectiez l'arbre de plus près, vous pourriez probablement trouver des "
"spirales suintant de la résine de pin utile, des amas de résine et des pommes "
"de pin."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pine tree"
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"Some of the branches and resin clumps have been stripped away and many of the "
"pinecones aren't developed fully yet, but given a season, it could be "
"harvestable again."
msgstr ""
"Un conifère imposant appartenant aux genre \"Pinus\", et celui-ci faisant "
"probablement partie d'une des trois espèces les plus répandues en Nouvelle "
"Angleterre, \"P. strobus\",\"P. resinosa\" ou \"P. rigida\". Cet arbre à "
"l'air d'avoir été débarrassé de la majorité de ces pommes de pin et de sa "
"résine facilement accessible, mais sera probablement capable de produire plus "
"si vous attendez une saison."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead pine tree"
msgstr "sapin mort"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead pine tree"
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"This tree's branches are bare, and it appears to be dead."
msgstr ""
"Un conifère imposant appartenant aux genre \"Pinus\", et celui-ci faisant "
"probablement partie d'une des trois espèces les plus répandues en Nouvelle "
"Angleterre, \"P. strobus\",\"P. resinosa\" ou \"P. rigida\". Ses branches "
"sont nues et l'arbre à l'air d'être mort."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "warped dead pine tree"
msgstr "pin mort déformé"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "warped dead pine tree"
msgid ""
"The branches of this pine tree have been twisted into a shape that remind you "
"of Sierpinski triangles.  It did not survive being warped like this."
msgstr ""
"Les branches de cet arbre ont été altérées jusqu'à ce qu'elle ressemblent une "
"forme qui rappellent les triangles de Sierpinski, l'arbre n'ayant pas survécu "
"cette transformation traumatique."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "birch tree"
msgstr "bouleau"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "birch tree"
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling "
"bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  You could tear "
"off some strips of bark if you examined the tree more closely."
msgstr ""
"Grand arbre à feuilles caduques du genre Betula, à l'écorce pelée "
"caractéristique. Les espèces comme 'B. alleghaniensis', 'B. papyrifera' et "
"'B. populifolia' sont les plus communes dans la région de la "
"Nouvelle-Angleterre. En examinant l'arbre de plus près, vous pourriez "
"arracher quelques bandes d'écorce."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "birch tree"
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling "
"bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  Looks like there "
"isn't enough rhytidome to peel off yet."
msgstr ""
"Grand arbre à feuilles caduques du genre Betula, à l'écorce pelée "
"caractéristique. Les espèces comme 'B. alleghaniensis', 'B. papyrifera' et "
"'B. populifolia' sont les plus communes dans la région de la "
"Nouvelle-Angleterre. On dirait qu'il n'y a pas encore assez de rhytidome pour "
"se détacher."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "willow tree"
msgstr "saule"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "willow tree"
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long, thin, leafy "
"branches that hang down like curtains.  You could tear off some bark."
msgstr ""
"Arbre à feuilles caduques du genre \"Saule\", grand et large, aux branches "
"longues, fines et feuillues qui pendent comme des rideaux. On peut arracher "
"de l'écorce."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "willow tree"
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long, thin, leafy "
"branches that hang down like curtains.  Looks like all usable bark has been "
"torn off, and new rhytidomes have not formed yet."
msgstr ""
"Arbre à feuilles caduques du genre 'Saule', haut et large, avec de longues "
"branches fines et feuillues qui pendent comme des rideaux. On dirait que "
"toute l'écorce utilisable a été arrachée et que les nouveaux rhytidomes ne se "
"sont pas encore formés."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "maple tree"
msgstr "érable"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "maple tree"
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  It could be tapped in order to extract maple sap."
msgstr ""
"Grand arbre à feuilles caduques du genre Erable. Les feuilles ont une forme "
"particulière avec cinq dents. On peut l'entailler pour en extraire la sève "
"d'érable."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "maple tree"
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  A spigot is wedged into the trunk, and sweet maple "
"sap can be extracted."
msgstr ""
"Grand arbre à feuilles caduques du genre Erable. Les feuilles ont une forme "
"particulière avec cinq dents. Le tronc est muni d'un embout qui permet "
"d'extraire la sève de l'érable."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "hickory tree"
msgstr "caryer"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hickory tree"
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for hickory nuts "
"if you examined the tree more closely."
msgstr ""
"Un grand arbre caduque appartenant au genre Carya. Vous pourriez essayer de "
"trouver des noix de caryer en examinant l'arbre de plus près."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hickory tree"
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It looks like the tree has been "
"picked clean of hickory nuts."
msgstr ""
"Un grand arbre caduque appartenant au genre Carya. Il n'y a l'air de rester "
"aucune noix de caryer dans son feuillage."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "pistachio tree"
msgstr "pistachier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pistachio tree"
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is "
"not native to this region.  You could look for pistachio nuts if you examined "
"the tree more closely."
msgstr ""
"Un arbre caduque appartenant au genre \"Pistacia\". Cet arbre a été "
"attentivement cultivé et ne pousse pas normalement dans cette région du "
"monde. Vous pourriez essayer de trouver des pistaches en examinant l'abre de "
"plus près."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pistachio tree"
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is "
"not native to this region.  Unfortunately, it looks like it has been picked "
"clean of pistachio nuts."
msgstr ""
"Un arbre caduque appartenant au genre \"Pistacia\". Cet arbre a été "
"attentivement cultivé et ne pousse pas normalement dans cette région du "
"monde. Il n'y a l'air de rester aucune pistache dans son feuillage."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "almond tree"
msgstr "amandier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "almond tree"
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  You could look for fresh almonds if you examined "
"the tree more closely."
msgstr ""
"Arbre à feuilles caduques du genre 'Prunus'. Il s'agit d'un arbre cultivé qui "
"n'est pas originaire de cette région. En examinant l'arbre de plus près, on "
"pourrait y trouver des amandes fraîches."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "almond tree"
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  There are no almonds left to pick on the tree."
msgstr ""
"Arbre à feuilles caduques du genre 'Prunus'. Il s'agit d'un arbre cultivé, "
"qui n'est pas originaire de cette région. Il n'y a plus d'amandes à cueillir "
"sur l'arbre."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "pecan tree"
msgstr "pacanier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pecan tree"
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for pecan nuts if "
"you examined the tree more closely."
msgstr ""
"Un grand arbre caduque appartenant au genre Carya. Vous pourriez essayer de "
"trouver des noix de pécan en examinant l'arbre de plus près."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pecan tree"
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It doesn't look like there are "
"any pecan nuts left on the tree."
msgstr ""
"Un grand arbre caduque appartenant au genre Carya. Il n'y a l'air de rester "
"aucune noix de pécan dans son feuillage."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead hickory tree"
msgstr "caryer mort"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead hickory tree"
msgid ""
"The dead remnants of a tall deciduous tree of the 'Carya' genus.  Nothing "
"useful can be foraged from this poor, dead tree."
msgstr ""
"Ce qui reste d'un grand arbre caduque appartenant au genre Carya. Rien ne "
"peut être récolté de ce pauvre arbre mort à part du bois si vous souhaitez "
"l'abattre."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "sassafras tree"
msgstr "sassafras"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "sassafras tree"
msgid ""
"This tree is a member of the 'Sassafras' genus, known for its aromatic "
"qualities.  In the winter and spring, the sap rich roots can be harvested to "
"make a sweet beverage."
msgstr ""
"Cet arbre fait partie du genre \"Sassafras\", connu pour ses qualités "
"aromatiques. En hiver et au printemps, les racines riches en sève peuvent "
"être récoltées pour préparer une boisson sucrée."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "sassafras tree"
msgid ""
"This tree is a member of the 'Sassafras' genus, known for its aromatic "
"qualities.  This tree's roots have been harvested, any more and the tree will "
"die."
msgstr ""
"Cet arbre fait partie du genre 'Sassafras', connu pour ses qualités "
"aromatiques. Les racines de cet arbre ont été récoltées, si elles le sont "
"encore, l'arbre mourra."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/items/comestibles/other.json
#. ~ Terrain name
#. ~ Item name
msgid "underbrush"
msgid_plural "underbrushes"
msgstr[0] "sous-bois"
msgstr[1] "sous-bois"
msgstr[2] "sous-bois"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "underbrush"
msgid ""
"Small plants and shrubs that decorate the forest.  An observant forager could "
"obtain edible plants, acorns, eggs, and mushrooms from it."
msgstr ""
"Petites plantes et arbustes qui décorent la forêt. Un observateur avisé "
"pourrait en obtenir des plantes comestibles, des glands, des œufs et des "
"champignons."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "underbrush"
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it."
msgstr ""
"Les petites plantes, mousses et buissons poussant sur le sol d'une forêt. "
"Cette zone a déjà été fouillée et il n'y a rien d'autre d'intéressant à "
"ramasser ici."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "underbrush"
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it.  Frost "
"covers it."
msgstr ""
"Les petites plantes, mousses et buissons poussant sur le sol d'une forêt, "
"tous couverts d'une fine couche de gel. Cette zone a déjà été fouillée et il "
"n'y a rien d'autre d'intéressant à ramasser ici."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/mods/alt_map_key/overmap_terrain_pink.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "bee hive"
msgstr "ruche"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "bee hive"
msgid ""
"A hive of bees located in a cavity inside a tree, swarming in and out at a "
"feverish pace.  There's probably honey inside."
msgstr ""
"Une ruche d'abeilles situé dans une cavité d'arbre, les habitantes "
"bourdonnant autour de l'entrée sans jamais s'épuiser. Il y a peut être du "
"miel à récolter à l'intérieur si vous possédez un moyen de les assommer ou ne "
"craignez pas leur colère."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/overmap/overmap_terrain/overmap_terrain_agricultural.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "apiary"
msgstr "ruche"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apiary"
msgid ""
"A man-made wooden box designed to hold honeybees and facilitate the care for "
"a hive.  The modular construction allows for inspecting the bees and "
"harvesting their bounty without destroying the hive completely.  This year's "
"harvest should be ready by now."
msgstr ""
"Une boite en bois fabriquée pour accueillir des abeilles à miel et simplifiez "
"l'entretien par un apiculteur de leur ruche. La construction modulaire permet "
"d'inspécter la santé des abeilles et récolter leur miel sans détruire leur "
"colonie complétement. La récolte de cette année à l'air d'être prête."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apiary"
msgid ""
"A man-made wooden box designed to host honeybees and facilitate the care for "
"a hive.  The modular construction allows for inspecting the bees and "
"harvesting their bounty without destroying the hive completely.  It will be "
"some time before this one is ready to harvest."
msgstr ""
"Une boite en bois fabriquée pour accueillir des abeilles à miel et simplifiez "
"l'entretien par un apiculteur de leur ruche. La construction modulaire permet "
"d'inspécter la santé des abeilles et récolter leur miel sans détruire leur "
"colonie complétement. Vous allez devoir patienter un bon moment avant que le "
"miel de celle-ci soit prêt à être récolté."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "shrub"
msgstr "arbuste"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "shrub"
msgid "A small shrub."
msgstr "Un petit buisson."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "peanut bush"
msgstr "buisson à cacahuètes"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "peanut bush"
msgid "A small bush of crunchy peanuts."
msgstr "Un petit buisson plein de cacahuètes craquantes."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small peanut bush that's fruitless."
msgstr "Un petit buisson dépourvu des cacahuètes poussant normalement dessus."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "autumn olive"
msgstr "chalef d'automne"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "autumn olive"
msgid ""
"An invasive species from Japan which is also called silverberry.  Widely "
"planted in the 1940s to combat erosion, it spread far and wide, often even "
"displacing native plants.  As it name says, it bears fruits in autumn, which "
"are quite unlike olives."
msgstr ""
"Une espèce invasive japonaise aussi connu sous le nom d'argousier.  Plantée à "
"outrance durant les années 40 pour combattre l'érosion des sols, celle-ci fut "
"capable de se répandre à travers l'Amérique rapidement et supplanter un bon "
"nombre de plantes autochtones.  Comme le nom suggère, cette plante fruite en "
"automne, mais ceux-ci n'ont pas grand chose à voire avec des olives."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"An invasive species from Japan which is also called silverberry.  Widely "
"planted in the 1940s to combat erosion, it spread far and wide, often even "
"displacing native plants.  As it name says, it bears fruits in autumn, which "
"are quite unlike olives, but this particular plant has been harvested already."
msgstr ""
"Une espèce invasive japonaise aussi connu sous le nom d'argousier.  Plantée à "
"outrance durant les années 40 pour combattre l'érosion des sols, celle-ci fut "
"capable de se répandre à travers l'Amérique rapidement et supplanter un bon "
"nombre de plantes autochtones.  Comme le nom suggère, cette plante fruite en "
"automne, mais ceux-ci n'ont pas grand chose à voire avec des olives.  Ont "
"dirait que tout les fruits mûrs ont déjà été récoltés."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "hobblebush"
msgstr "viorne à feuilles d'aulne"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hobblebush"
msgid ""
"Called hobblebush because it may hinder and trip, hobbles, unwary hikers with "
"its branches bending over and taking root.  It also bears surprisingly sweet "
"berries in autumn."
msgstr ""
"Connu sous le nom de \"hobblebush\" en anglais du à son habitude de faire "
"trébucher les randonneurs avec des branches capable de s'enraciner.  Produit "
"des baies étonnamment sucrées en automne."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"Called hobblebush because it may hinder and trip, hobbles, unwary hikers with "
"its branches bending over and taking root.  It also bears surprisingly sweet "
"berries in autumn, if it hadn't been picked clean already."
msgstr ""
"Connu sous le nom de \"hobblebush\" en anglais du à son habitude de faire "
"trébucher les randonneurs avec des branches capable de s'enraciner.  Produit "
"des baies étonnamment sucrées en automne.  On dirait que toutes les baies ont "
"déjà été récoltées."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "blueberry bush"
msgstr "myrtillier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "blueberry bush"
msgid "A small bush of sweet blueberries."
msgstr "Un petit buisson rempli de myrtilles sucrées."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small blueberry bush that's fruitless."
msgstr "Un petit buisson dépourvu des myrtilles poussant normalement dessus."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "strawberry bush"
msgstr "fraisier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "strawberry bush"
msgid "A small bush of juicy strawberries."
msgstr "Un petit buisson plein de fraises juteuses."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small strawberry bush that's fruitless."
msgstr "Un petit buisson dépourvu des fraises poussant normalement dessus."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "blackberry bush"
msgstr "buisson de ronces"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "blackberry bush"
msgid "A small bush of delicious blackberries.  Watch out for its thorns!"
msgstr "Un petit buisson plein de mûres délicieuses. Attention aux épines!"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small blackberry bush that's fruitless.  Watch out for its thorns!"
msgstr "Un petit buisson de mûres sans fruits. Attention aux épines !"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "huckleberry bush"
msgstr "buisson d'airelle"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "huckleberry bush"
msgid "A small bush of huckleberries, often mistaken for blueberries."
msgstr "Un petit buisson de myrtilles, souvent confondues avec des bleuets."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small huckleberry bush that's fruitless."
msgstr "Un petit buisson de myrtilles sans fruits."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "raspberry bush"
msgstr "framboisier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "raspberry bush"
msgid "A small bush of delicious raspberries.  Watch out for its thorns!"
msgstr "Un petit buisson de délicieuses framboises. Attention aux épines !"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small raspberry bush that's fruitless.  Watch out for its thorns!"
msgstr "Un petit framboisier stérile. Attention aux épines !"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "grape bush"
msgstr "vigne"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "grape bush"
msgid "A bush of a different species invaded by grape vines."
msgstr "Un buisson d'une espèce différente étant envahi de vignes de raisins."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A bush of a different species invaded by grape vines, but they're fruitless."
msgstr "Un buisson d'une autre espèce envahi par des vignes, mais sans fruits."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "spicebush"
msgstr "lindera benzoin"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "spicebush"
msgid "A bush that features small, red berries."
msgstr "Un buisson avec de petites baies rouges."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A bush that usually features small, red berries but it was picked clean."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "black chokeberry bush"
msgstr "aronia à fruits noirs"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "black chokeberry bush"
msgid ""
"Drooping black berries adorn the shrub during autumn.  These have a "
"distinctive star-shaped fold and look quite juicy."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "Drooping black berries adorned this shrub, but the shrub was picked clean."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "rose bush"
msgstr "rosier"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "rose bush"
msgid ""
"A fat bush of beautiful red roses, if only you could get a date!  Watch out "
"for its thorns!"
msgstr ""
"Un gros buisson de belles roses rouges, si seulement tu pouvais avoir un "
"rendez-vous ! Attention aux épines !"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A fat rose bush that currently has no blooms.  Watch out for its thorns!"
msgstr "Un gros rosier qui ne fleurit pas pour l'instant. Attention aux épines !"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "hydrangea bush"
msgstr "buisson d'hortensias"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hydrangea bush"
msgid "A dense bush of fragrant blue hydrangeas."
msgstr "Un buisson dense d'hortensias bleus parfumés."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A fat hydrangea bush that currently has no blooms."
msgstr "Un gros buisson d'hortensias qui n'a pas encore de fleurs."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "lilac bush"
msgstr "buisson de lilas"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "lilac bush"
msgid "A wide bush of bright pinkish-purple lilacs."
msgstr "Un large buisson de lilas rose-pourpre vif."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A wide lilac bush that currently has no blooms."
msgstr "Un large buisson de lilas qui ne fleurit pas actuellement."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tree trunk"
msgstr "tronc"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tree trunk"
msgid ""
"A section of trunk from a tree that has been cut down.  Can be sawn into logs "
"with the right tool."
msgstr ""
"Section du tronc d'un arbre qui a été abattu. Peut être scié en billes avec "
"l'outil adéquat."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tree stump"
msgstr "souche d'arbre"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tree stump"
msgid "A tree stump, a remnant of a tree that has been cut down."
msgstr "Une souche d'arbre, un vestige d'un arbre qui a été coupé."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "woodchips"
msgstr "copeaux de bois"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "woodchips"
msgid ""
"Small splinters of wood laid out in a layer to prevent unwanted plants from "
"growing."
msgstr ""
"Petits éclats de bois disposés en couche pour empêcher les plantes "
"indésirables de pousser."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/items/comestibles/other.json
#. ~ Terrain name
#. ~ Item name
msgid "grass"
msgid_plural "grass"
msgstr[0] "herbe"
msgstr[1] "herbe"
msgstr[2] "herbe"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "grass"
msgid ""
"An area of hardy Kentucky bluegrass about ankle high.  Cutting the grass "
"short enough would destroy the root system, causing this area to turn into a "
"patch of dirt."
msgstr ""
"Une zone de pâturin du Kentucky rustique d'une hauteur d'environ une "
"cheville. Couper l'herbe assez court détruirait le système racinaire, ce qui "
"transformerait cette zone en un champ de terre."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "white grass"
msgstr "herbe blanche"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "white grass"
msgid ""
"An area of Kentucky bluegrass covered in white latex-based paint, with neat "
"lines designed for recreational sports."
msgstr ""
"Une zone de pâturage du Kentucky recouverte d'une peinture blanche à base de "
"latex, avec des lignes nettes conçues pour les sports de loisirs."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "long grass"
msgstr "herbes longues"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "long grass"
msgid "An area of long, shaggy grass about shin high."
msgstr ""
"Une zone d'herbes longues et broussailleuses arrivant un peu en dessous du "
"genou."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tall grass"
msgstr "hautes herbes"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tall grass"
msgid "An area of tall grass about head high."
msgstr "Une zone d'herbes hautes arrivant à hauteur de tête."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead grass"
msgstr "herbe morte"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead grass"
msgid "An area of long, shaggy grass that hasn't been cut recently."
msgstr ""
"Une zone d'herbes longues et broussailleuses ayant fanées pour une raison ou "
"une autre."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "grazed grass"
msgstr "herbe broutée"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "grazed grass"
msgid ""
"An area of extremely short green stubble protruding from the dirt.  Something "
"has been clearly grazing here."
msgstr ""
"Une zone de très courte herbe verte dépassant de la terre. Il est clair que "
"quelque chose a pâturé ici."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "golf green"
msgstr "green de golf"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "golf green"
msgid "An area of grass mowed very short and neat."
msgstr "Une zone d'herbe verte ayant été coupée très courte et régulièrement."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_alien.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_alien_meadow.json
#. ~ Terrain name
msgid "alien grass"
msgstr "herbe étrange"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "alien grass"
msgid ""
"An area of something that almost looks like grass.  The blades are serrated "
"and move on their own."
msgstr ""
"Une zone d'un organisme ayant presque l'air d'être de l'herbe, les brins "
"remuent de leur propre volonté et ont l'air coupants et dentelés."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "golf hole"
msgstr "trou de golf"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "golf hole"
msgid "A small plastic cup embedded in an area of very short, neat grass."
msgstr ""
"Un trou en plastique ayant été inséré au milieu d'une section d'herbe verte "
"ayant été coupée très courte et régulièrement."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "young bamboo shoots"
msgstr "jeunes pousses de bambou"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "young bamboo shoots"
msgid ""
"An area of young bamboo shoots about ankle high.  Many shoots are just barely "
"pushing above the ground."
msgstr ""
"Une zone de jeunes pousses de bambou arrivant au niveau de la cheville, la "
"plupart émergeant juste du sol."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "young bamboo shoots"
msgid ""
"An area of young bamboo shoots about ankle high.  The smallest shoots have "
"already been harvested."
msgstr ""
"Une zone de jeunes pousses de bambou arrivant au niveau de la cheville. Les "
"plus petites pousses ont déjà été récoltées."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "long bamboo shoots"
msgstr "longues pousses de bambou"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "long bamboo shoots"
msgid "An area of long bamboo shoots about shin high."
msgstr "Une zone de longues pousses de bambou arrivant un peu en dessous du genou."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tall bamboo"
msgstr "bambou"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tall bamboo"
msgid "A tall bamboo thicket about head high."
msgstr "Un bosquet épais de bambou arrivant à hauteur de tête."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead bamboo"
msgstr "bambou mort"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead bamboo"
msgid "An area of long, brown, dead bamboo shoots covered in white fungus."
msgstr ""
"Une zone de longues pousses de bambou brunes et mortes, couvertes de "
"champignons blancs."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "fern"
msgstr "fougère"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "fern"
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern from "
"the stem."
msgstr ""
"Une plante courte avec des milliers de feuilles qui poussent de manière "
"fractale à partir de la tige."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "fern"
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern.  All "
"of the curled shoots have been harvested."
msgstr ""
"Une plante courte avec des milliers de feuilles qui poussent selon un modèle "
"fractal. Toutes les pousses enroulées ont été récoltées."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "mushroom colony"
msgstr "colonie de champignons"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "mushroom colony"
msgid ""
"A large pile of organic matter which has molded over with fungus.  The caps "
"of many mundane mushrooms spring from the top, you can even recognize some.  "
"The fungi growing here don't seem edible, though."
msgstr ""
"Un grand tas de matière organique recouvert de moisissure. Les chapeaux de "
"nombreux champignons banals poussent du dessus, vous pouvez même en "
"reconnaître certains. Cependant, les champignons qui poussent ici ne semblent "
"pas comestibles."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "Marloss bush"
msgstr "buisson de Marloss"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "Marloss bush"
msgid ""
"This alien plant superficially resembles a blueberry bush, and hangs with "
"large, juicy pink pomes that emit a heady, fruity aroma."
msgstr ""
"Cette plante étrangère ressemble superficiellement à un buisson de myrtilles, "
"et elle est couverte de gros fruits roses juteux qui dégagent un arôme "
"capiteux et fruité."

#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/json/furniture_and_terrain/terrain-triffid.json
#: data/mods/Magiclysm/furniture_and_terrain/terrain_druid.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_alien.json
#: data/mods/TropiCataclysm/furniture_and_terrain/terrain_fungal_termite.json
#. ~ Bashing failed sound
msgid "poof!"
msgstr "pouf!"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal bed"
msgstr "lit fongique"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal bed"
msgid "Fungus grows thick here, obscuring the ground beneath it."
msgstr "Les champignons y poussent en abondance, obscurcissant le sol."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal floor"
msgstr "sol fongique"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal floor"
msgid ""
"Grayish mold coats both the floor and the roof here, silent and still.  Stray "
"spores waft through the air."
msgstr ""
"Des moisissures grisâtres recouvrent le sol et le toit, ici, silencieux et "
"immobile. Des spores éparses flottent dans l'air."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal floor"
msgid "Grayish mold coats the floor here, silent and still."
msgstr "Des moisissures grisâtres recouvrent le sol ici, silencieux et immobile."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal floor"
msgid "Grayish mold coats the ground here, silent and still."
msgstr "Une moisissure grisâtre recouvre le sol ici, silencieux et immobile."

#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/json/monsters/fungus.json
#. ~ Terrain name
#. ~ Monster name
msgid "fungal wall"
msgid_plural "fungal walls"
msgstr[0] "mur mycellaire"
msgstr[1] "murs mycellaires"
msgstr[2] "murs mycellaires"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal wall"
msgid ""
"Several thick, large tendrils of fungus perforate the wall here, piercing "
"straight through it from the outside.  Despite the apparent damage, the wall "
"is still structurally sound."
msgstr ""
"Plusieurs vrilles épaisses et larges de champignons perforent le mur ici, le "
"traversant de part en part depuis l'extérieur. Malgré les dégâts apparents, "
"la structure du mur est encore solide."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal wall"
msgid ""
"The fungus here has grown thickly and tightly enough to form a solid wall.  "
"It feels very stiff to the touch, and seems to be very strong."
msgstr ""
"Le champignon ici a poussé de manière suffisamment épaisse et serrée pour "
"former un mur solide. Il est très rigide au toucher et semble très résistant."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal mound"
msgstr "monticule fongique"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal mound"
msgid "A mound of fungal matter, intertwined in itself."
msgstr "Un monticule de matières fongiques, imbriquées les unes dans les autres."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal shrub"
msgstr "arbuste fongique"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal shrub"
msgid ""
"This shrub has been completely absorbed by the mushrooms.  Its branches droop "
"and have lost much of their structure, and its leaves have vanished, replaced "
"by fleshy gray sacks that visibly expand and contract."
msgstr ""
"Cet arbuste a été complètement absorbé par les champignons. Ses branches "
"s'affaissent et ont perdu une grande partie de leur structure, et ses "
"feuilles ont disparu, remplacées par des sacs gris charnus qui se dilatent et "
"se contractent visiblement."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal tree"
msgstr "arbre fongique"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal tree"
msgid ""
"Once tall and majestic, this tree is now a slave to the fungus like the "
"landscape around it.  Its bark is penetrated by and covered with fungal "
"tendrils, and the canopy has rotted away, leaving only the branches, "
"stretching forlornly to the sky as if to escape the infection overrunning it."
msgstr ""
"Autrefois grand et majestueux, cet arbre est désormais esclave du champignon, "
"comme le paysage qui l'entoure. Son écorce est pénétrée et recouverte de "
"vrilles fongiques, et la canopée a pourri, ne laissant que les branches, "
"s'étirant vers le ciel comme pour échapper à l'infection qui l'envahit."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "young fungal tree"
msgstr "jeune arbre fongique"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "young fungal tree"
msgid "A small sapling poking through the ground, infested by fungal mold."
msgstr "A small sapling poking through the ground, infested by fungal mold."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "Marloss tree"
msgstr "arbre de Marloss"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "Marloss tree"
msgid ""
"This tree stands as a stark outlier to the landscape around it.  Despite its "
"infestation, its leaves wave proudly in the wind, colored pinkish-white.  Its "
"branches are heavy with pink fruit that looks both mutated and delicious."
msgstr ""
"Cet arbre se démarque nettement du paysage qui l'entoure. Malgré son "
"infestation, ses feuilles, d'un blanc rosé, ondulent fièrement dans le vent. "
"Ses branches sont chargées de fruits roses qui semblent à la fois mutants et "
"délicieux."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "shallow water"
msgstr "eau peu profonde"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "shallow water"
msgid ""
"The water isn't too deep here.  With a watertight container, you could gather "
"fresh water from here.  Not safe to drink as is."
msgstr ""
"L'eau n'est pas très profonde ici. Avec un contenant étanche, vous pourriez "
"prélever de l'eau fraiche ici, mais celle-ci ne sera pas saine tel quelle."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "deep water"
msgstr "eau profonde"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "deep water"
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a "
"watertight container, you could gather fresh water from here.  Not safe to "
"drink as is."
msgstr ""
"Vous avez du mal à voir le fond à travers l'eau profonde ici. Avec un "
"récipient étanche, vous pourriez recueillir de l'eau douce ici. Elle n'est "
"pas potable en l'état."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "murky shallow water"
msgstr "eau trouble peu profonde"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "murky shallow water"
msgid ""
"The water isn't too deep here but is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"L'eau n'est pas très profonde ici, mais elle est trouble en raison de la "
"présence de matières organiques. Avec un récipient étanche, on peut y "
"recueillir de l'eau fétide. Elle n'est pas potable en l'état."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "murky shallow water"
msgid ""
"The water isn't too deep here but it is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"L'eau n'est pas très profonde ici, mais elle est trouble et contient des "
"matières organiques. Avec un récipient étanche, on peut y recueillir de l'eau "
"fétide. Elle n'est pas potable en l'état."

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/mods/Magiclysm/furniture_and_terrain/terrain_druid.json
#. ~ Terrain name
msgid "flowing shallow water"
msgstr "eau courante peu profonde"

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/mods/Magiclysm/furniture_and_terrain/terrain_druid.json
#. ~ Description of terrain "flowing shallow water"
msgid ""
"The streaming water isn't too deep here.  With a watertight container, you "
"could gather fresh water from here.  Not safe to drink as is, although "
"probably safer than stagnant water."
msgstr ""
"L'eau qui coule n'est pas trop profonde ici. Avec un récipient étanche, on "
"peut y recueillir de l'eau douce. Elle n'est pas potable en l'état, mais elle "
"est sans doute plus sûre que l'eau stagnante."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "flowing deep water"
msgstr "eau courante profonde"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "flowing deep water"
msgid ""
"The streaming water looks deep here.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is, although probably "
"safer than stagnant water."
msgstr ""
"L'eau qui coule ici semble profonde. Avec un récipient étanche, on peut y "
"recueillir de l'eau douce. Cette eau n'est pas potable telle quelle, mais "
"elle est sans doute plus sûre que l'eau stagnante."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "shallow water"
msgid ""
"The water isn't too deep here.  With a watertight container, you could gather "
"salt water from here."
msgstr ""
"L'eau n'est pas trop profonde ici. Avec un récipient étanche, on peut "
"recueillir de l'eau salée ici."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "deep water"
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a "
"watertight container, you could gather salt water from here."
msgstr ""
"Vous avez du mal à voir le fond à travers l'eau profonde ici. Avec un "
"récipient étanche, vous pourriez recueillir de l'eau salée à partir d'ici."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "surf"
msgstr ""

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "surf"
msgid "A broad area of fine sand, washed by waves coming in from the sea."
msgstr "Une vaste étendue de sable fin, balayée par les vagues de la mer."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "pool water"
msgstr "eau de piscine"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "pool water"
msgid ""
"A deep pool full of water.  Never swim without a lifeguard present.  Even "
"though monsters probably ate them."
msgstr ""
"Une piscine profonde remplie d'eau. Ne jamais nager sans la présence d'un "
"sauveteur. Même si des monstres les ont probablement mangés."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "shallow pool water"
msgstr "Eau de piscine peu profonde."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "shallow pool water"
msgid "A shallow pool of water."
msgstr "Une eau de piscine peu profonde."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "sewage"
msgstr "égout"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "sewage"
msgid ""
"Gross.  Sewage water flows through here.  As if it needed saying, this isn't "
"safe to drink."
msgstr ""
"Dégoûtant. De l'eau usée coule ici. Inutile de préciser que ce n'est pas "
"potable."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "lava"
msgid ""
"An extremely hot, glowing liquid, composed of molten rock and/or metal.  In "
"some places, lava-grilled steak is a delicacy."
msgstr ""
"Un liquide extrêmement chaud et incandescent, composé de roche en fusion "
"et/ou de métal. Dans certains endroits, le steak grillé à la lave est une "
"délicatesse."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "submersed water"
msgstr "eau submergée"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "submersed water"
msgid ""
"You are submerged below the surface of the water, your feet can't touch the "
"ground.  With a watertight container, you could gather fresh water from here. "
" Not safe to drink as is."
msgstr ""
"Vous êtes immergé sous la surface de l'eau, vos pieds ne touchent pas le sol. "
"Avec un contenant étanche, vous pourriez recueillir de l'eau douce ici. Ne "
"pas boire sans traitement."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "submersed salt water"
msgstr "eau salée submergée"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "submersed salt water"
msgid ""
"You are submerged below the surface of the water, your feet can't touch the "
"ground.  With a watertight container, you could gather salt water from here."
msgstr ""
"Vous êtes immergé sous la surface de l'eau, vos pieds ne touchent pas le sol. "
"Avec un contenant étanche, vous pourriez recueillir de l'eau salée ici."

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/mods/desert_region/overmap/desert_overmap_terrain.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "lake bed"
msgstr "fond de lac"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "lake bed"
msgid ""
"You are standing at the bottom of a body of fresh water.  With a watertight "
"container, you could gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Vous êtes debout au fond d'un plan d'eau douce. Avec un contenant étanche, "
"vous pourriez recueillir de l'eau douce ici. Ne pas boire sans traitement."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "ocean bed"
msgstr "fond d'océan"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "ocean bed"
msgid ""
"You are standing at the bottom of a body of salt water.  With a watertight "
"container, you could gather salt water from here.  Not safe to drink as is."
msgstr ""
"Vous êtes debout au fond d'un plan d'eau salée. Avec un contenant étanche, "
"vous pourriez recueillir de l'eau salée ici. Ne pas boire sans traitement."

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "bulkhead"
msgstr "cloison"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "bulkhead"
msgid ""
"The top of a submerged structure.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Le sommet d'une structure submergée. Avec un contenant étanche, vous pourriez "
"recueillir de l'eau douce ici. Ne pas boire sans traitement."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "bulkhead"
msgid "The bottom of a submerged structure."
msgstr "Le fond d'une structure submergée."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "submerged concrete"
msgstr "béton submergé"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "submerged concrete"
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of concrete. "
" With a watertight container, you could gather fresh water from here.  Not "
"safe to drink as is."
msgstr ""
"Vous vous trouvez au fond d'un plan d'eau douce sur une dalle de béton. Avec "
"un conteneur étanche, vous pourriez recueillir de l'eau douce ici. Ne pas "
"boire sans traitement. "

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "submerged concrete"
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of "
"yellow-painted concrete.  With a watertight container, you could gather fresh "
"water from here.  Not safe to drink as is."
msgstr ""
"Vous vous trouvez au fond d'un plan d'eau douce sur une dalle de béton peinte "
"en jaune. Avec un conteneur étanche, vous pourriez recueillir de l'eau douce "
"ici. Ne pas boire sans traitement. "

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "hot spring water"
msgstr "eau de source chaude"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "hot spring water"
msgid ""
"Scalding hot water, not particularly safe for swimming.  With a watertight "
"container, you could gather fresh water from here.  Not safe to drink as is."
msgstr ""
"De l'eau extrêmement chaude, pas particulièrement sûre pour la baignade. Avec "
"un contenant étanche, vous pourriez recueillir de l'eau douce ici. Ne pas "
"boire sans traitement."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "recess"
msgstr "cavité"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "recess"
msgid "A shallow pit in the ground."
msgstr "Un trou peu profond. "

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "flood water"
msgstr "eau d'inondation"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "flood water"
msgid ""
"The water isn't too deep here, it seems to have either pooled here or risen "
"from a pipe leaking nearby.  With a watertight container, you could gather "
"fresh water from here.  Not safe to drink as is."
msgstr ""
"L'eau n'est pas très profonde ici, elle semble s'être accumulée ici ou avoir "
"jailli d'une fuite de tuyau à proximité. Avec un contenant étanche, vous "
"pourriez recueillir de l'eau douce ici. Ne pas boire sans traitement."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "metal compactor"
msgstr "compacteur de métal"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "metal compactor"
msgid ""
"A hydraulic machine for squeezing scrap into more compact chunks.  Useless "
"now that there's no power."
msgstr ""
"Machine hydraulique pour presser les déchets en morceaux plus compacts. "
"Inutile maintenant qu'il n'y a plus d'électricité."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "gasoline pump"
msgstr "pompe à essence"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "gasoline pump"
msgid ""
"Precious GASOLINE.  The former world bowed to their petroleum god as it led "
"them to their ruin.  There's plenty left over to fuel your inner road "
"warrior.  If this gas dispenser doesn't give up the goods for free, you may "
"have to pay at a nearby terminal."
msgstr ""
"Précieuse ESSENCE. L'ancien monde s'est incliné devant leur dieu du pétrole "
"alors qu'il les menait à leur ruine. Il en reste suffisamment pour alimenter "
"votre guerrier de la route intérieur. Si ce distributeur de carburant ne vous "
"offre pas les produits gratuitement, vous devrez peut-être payer à un "
"terminal à proximité."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "smashed gas pump"
msgstr "pompe à essence détruite"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "smashed gas pump"
msgid ""
"The horror!  This gasoline pump has been destroyed, denying you access to the "
"liquid gold."
msgstr ""
"L'horreur ! Cette pompe à essence a été détruite, vous refusant l'accès à "
"l'or liquide."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "diesel pump"
msgstr "pompe à diesel"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "diesel pump"
msgid ""
"A diesel fuel pump.  This roadside attraction provides all the thick, gloopy "
"liquid POWER you need to move your sensibly oversized APOCALYPTIC SUPERTRUCK "
"from point A to points beyond.  If it doesn't dispense fuel immediately, try "
"banging on it or grunt your way over the nearby payment terminal."
msgstr ""
"Une pompe à diesel. Cette attraction routière fournit tout le liquide épais "
"et visqueux dont vous avez besoin pour déplacer votre SUPERTRUCK "
"APOCALYPTIQUE démesurément dimensionné du point A aux points au-delà. Si elle "
"ne distribue pas immédiatement le carburant, essayez de frapper dessus ou de "
"grogner en passant sur le terminal de paiement à proximité."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "smashed diesel pump"
msgstr "pompe à diesel détruite"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "smashed diesel pump"
msgid ""
"You're not getting any diesel out of this pump any time soon.  Some barbarian "
"decided to take their frustration out on it."
msgstr ""
"Vous n'obtiendrez pas de diesel de cette pompe de si tôt. Un barbare a décidé "
"de se défouler dessus."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "JP8 pump"
msgstr "pompe à JP8"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "JP8 pump"
msgid ""
"A pump that dispenses JP8.  If this gas dispenser doesn't give up the goods "
"for free, you may have to pay at a nearby terminal."
msgstr ""
"Une pompe à kérosène JP8. Si ce distributeur de carburant ne vous donne pas "
"les biens gratuitement, vous devrez peut-être payer à un terminal à proximité."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "smashed JP8 pump"
msgstr "pompe à JP8 détruite"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "smashed JP8 pump"
msgid ""
"You're not getting any JP8 out of this pump any time soon.  Some barbarian "
"decided to take their frustration out on it."
msgstr ""
"Vous n'obtiendrez pas de JP8 de cette pompe de si tôt. Un barbare a décidé de "
"se défouler dessus."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "avgas pump"
msgstr "pompe à carburant d’aviation"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "avgas pump"
msgid ""
"A pump that dispenses avgas.  If this gas dispenser doesn't give up the goods "
"for free, you may have to pay at a nearby terminal."
msgstr ""
"Une pompe à essence d'aviation. Si ce distributeur de carburant ne vous donne "
"pas les biens gratuitement, vous devrez peut-être payer à un terminal à "
"proximité."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "smashed avgas pump"
msgstr "pompe à carburant d’aviation détruite"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "smashed avgas pump"
msgid ""
"You're not getting any avgas out of this pump any time soon.  Some barbarian "
"decided to take their frustration out on it."
msgstr ""
"Vous n'obtiendrez pas d'essence à aviation de cette pompe de si tôt. Un "
"barbare a décidé de se défouler dessus."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "ticket vendor"
msgstr "distributeur de billets"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "ticket vendor"
msgid ""
"A machine with a little screen and slots, intended to take your money and "
"provide you with a ticket."
msgstr ""
"Une machine avec un petit écran et des fentes, destinée à prendre votre "
"argent et à vous fournir un billet."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "ticket machine"
msgstr "machine à tickets"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "ticket machine"
msgid ""
"A machine that will provide you access to whatever lies beyond it - for the "
"price of a ticket, of course."
msgstr ""
"Une machine qui vous donnera accès à ce qui se trouve derrière elle - pour le "
"prix d'un billet, bien sûr."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "ventilation shutters"
msgstr "volets de ventilation."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "ventilation shutters"
msgid ""
"A large wall-mounted panel, covered with fragile metal sheets that regulate "
"airflow."
msgstr ""
"Un grand panneau mural, recouvert de fines plaques métalliques fragiles qui "
"régulent le flux d'air."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "missile"
msgstr "missile"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "missile"
msgid ""
"A section of an ICBM, an Intercontinental Ballistic Missile.  This isn't the "
"kind of rocket that goes to the moon."
msgstr ""
"Une section d'un missile balistique intercontinental (MBI). Ce n'est pas le "
"type de fusée qui va sur la lune."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "blown-out missile"
msgstr "missile défectueux"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "blown-out missile"
msgid ""
"A section of an ICBM, an Intercontinental Ballistic Missile.  This isn't the "
"kind of rocket that's going anywhere."
msgstr ""
"Une section d'un missile balistique intercontinental (MBI). Ce n'est pas le "
"type de fusée qui va quelque part."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_commercial.json
#: data/json/recipes/basecamps/base/fbmc_fire_lookout_tower/recipe_modular_fire_lookout_tower_common.json
#: data/json/recipes/basecamps/base/fbmc_helipad/recipe_modular_helipad_common.json
#: data/json/recipes/basecamps/base/fbmc_lightindustry/recipe_modular_lightindustry_00.json
#: data/json/recipes/basecamps/base/fbmc_lightindustry/recipe_modular_lightindustry_10.json
#: data/json/recipes/basecamps/base/fbmc_outpost/recipe_modular_outpost_normal.json
#: data/json/recipes/basecamps/base/recipe_modular_hub/version_2/recipe_modular_field_common.json
#: data/mods/alt_map_key/overmap_terrain_blue.json
#. ~ Terrain name
#. ~ Overmap terrain name
#. ~ Blueprint name of recipe crafting "faction_base_fire_lookout_tower_radio"
#. ~ Blueprint name of recipe crafting "faction_base_helipad_radio"
#. ~ Blueprint name of recipe crafting "faction_base_lightindustry_00_radio"
#. ~ Blueprint name of recipe crafting "faction_base_lightindustry_10_radio"
#. ~ Blueprint name of recipe crafting "faction_base_outpost_normal_radio"
#. ~ Blueprint name of recipe crafting "fbmh_2_radio_tower"
msgid "radio tower"
msgstr "tour radio"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "radio tower"
msgid "The structure of a radio transmission tower."
msgstr "La structure d'une tour de transmission radio."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture.json
#. ~ Terrain name
msgid "radio controls"
msgstr "contrôle de radio"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "radio controls"
msgid ""
"A console that appears to control a nearby radio transmission tower.  It "
"doesn't seem to be fully operational."
msgstr ""
"Une console qui semble contrôler une tour de transmission radio à proximité. "
"Elle ne semble pas être entièrement opérationnelle."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "truss pillar"
msgstr "pilier d'entretoise"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "truss pillar"
msgid ""
"A hollow metal pillar composed of interconnected beams that distribute loads "
"efficiently while maintaining stability and strength."
msgstr ""
"Un pilier métallique creux composé de poutres interconnectées qui distribuent "
"les charges efficacement tout en maintenant la stabilité et la résistance."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "high gauge pipe"
msgstr "tuyau haute pression"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "high gauge pipe"
msgid "A section of high gauge pipe."
msgstr "Section de tuyau à haute pression."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "high gauge pump"
msgstr "pompe à haute pression"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "high gauge pump"
msgid "An unpowered pump that previously would have moved fluids around in a hurry."
msgstr "Une pompe défectueuse qui auparavant déplaçait rapidement les fluides."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "drilling machinery"
msgstr "machine de forage"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "drilling machinery"
msgid ""
"All the machinery required to operate and control de drill string and the "
"drill bit down below.  It is now inactive."
msgstr ""
"Tout le matériel nécessaire pour faire fonctionner et contrôler la colonne de "
"forage et le trépan en dessous. Il est maintenant inactif."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "drill string"
msgstr "colonne de forage"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "drill string"
msgid ""
"An extremely resistant length of mechanical tubing used to reach deep under "
"water and drill into pockets of oil."
msgstr ""
"Un tuyau mécanique extrêmement résistant utilisé pour atteindre les "
"profondeurs sous l'eau et forer dans des poches de pétrole."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "CVD machine"
msgstr "machine CVD"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "CVD machine"
msgid ""
"The bulk of a highly technical-looking apparatus controlled by a nearby "
"console."
msgstr ""
"Le gros d'un appareil d'apparence très technique contrôlé par une console à "
"proximité."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "CVD control panel"
msgstr "panneau de commande CVD"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "CVD control panel"
msgid ""
"A VERY expensive-looking apparatus that's labeled 'Chemical Vapor Deposition "
"Machine'.  With the input of certain exceptionally rare chemicals and "
"elements, one could conceivably coat one's weapon with diamond.  While the "
"process is extremely complicated, a previous user has helpfully sketched: "
"Hydrogen + charcoal = smiley face."
msgstr ""
"Un appareil d'apparence très coûteuse, étiqueté 'Machine de Dépôt Chimique en "
"Phase Vapeur'. Avec l'apport de certains produits chimiques et éléments "
"exceptionnellement rares, on pourrait concevoir de recouvrir son arme de "
"diamant. Bien que le processus soit extrêmement compliqué, un utilisateur "
"précédent a gracieusement esquissé : Hydrogène + charbon = visage souriant.\""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "nanofabricator"
msgstr "nanofabricateur"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "nanofabricator"
msgid ""
"A great column of advanced machinery.  Within this self-contained, "
"miniaturized factory, several 3D printers work in tandem with a robotic "
"assembler to manufacture nearly any inorganic object."
msgstr ""
"Une grande colonne de machinerie avancée. À l'intérieur de cette usine "
"miniature autonome, plusieurs imprimantes 3D fonctionnent en tandem avec un "
"assembleur robotique pour fabriquer presque n'importe quel objet inorganique."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_manufactured.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_manufactured.json
#. ~ Terrain name
msgid "nanofabricator control panel"
msgstr "panneau de commandes de nanofabricateur"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_manufactured.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_manufactured.json
#. ~ Description of terrain "nanofabricator control panel"
msgid ""
"A small computer panel attached to a nanofabricator.  It has a single slot "
"for reading templates."
msgstr ""
"Un petit panneau informatique attaché à un nanofabricant. Il possède un seul "
"emplacement pour lire des modèles."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "cloning vat"
msgstr "cuve de clonage"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "cloning vat"
msgid ""
"A vat full of solution, probably intended to hold growing clones of people or "
"other life forms."
msgstr ""
"Une cuve rempli de solution, probablement destiné à contenir des clones en "
"croissance de personnes ou d'autres formes de vie."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_tanks.json
#. ~ Bashing failed sound
msgid "plunk."
msgstr "plounk."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "slot machine"
msgstr "machine à sous"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "slot machine"
msgid ""
"A machine with a bright screen flashing hypnotic promises of wealth.  If "
"gambling with your life on a daily basis isn't enough for you, you can also "
"gamble with this."
msgstr ""
"A machine with a bright screen flashing hypnotic promises of wealth. If "
"gambling with your life on a daily basis isn't enough for you, you can also "
"gamble with this."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "water pump"
msgstr "pompe à eau"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "water pump"
msgid ""
"A deep well, collecting groundwater.  An installed pump allows you to draw "
"water from it."
msgstr ""
"Un puits profond, recueillant de l'eau souterraine. Une pompe installée vous "
"permet de puiser de l'eau dedans."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "wooden well"
msgstr "puit en bois"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "wooden well"
msgid ""
"A deep well, collecting groundwater.  A wooden frame with a rope and bucket "
"allows you to draw water from it, with some elbow grease."
msgstr ""
"Un puits profond, recueillant de l'eau souterraine. Un cadre en bois avec une "
"corde et un seau vous permet de puiser de l'eau dedans, avec un peu d'effort."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "salt water pump"
msgstr "pompe à eau salée"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "salt water pump"
msgid ""
"A water pump connected to a pipe supplying it with salt water.  Not good to "
"drink, but it has other uses."
msgstr ""
"Une pompe à eau connectée à un tuyau lui fournissant de l'eau salée. Pas "
"potable, mais elle a d'autres utilisations."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "water dispenser"
msgstr "distributeur d'eau"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "water dispenser"
msgid "A machine with several taps that dispenses clean water."
msgstr "Une machine avec plusieurs robinets qui distribue de l'eau propre."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "telecom cabinet"
msgstr "cabine téléphonique"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "telecom cabinet"
msgid ""
"A cabinet full of telecom equipment.  With the lines down, you might be able "
"to take it apart for its useful electronics."
msgstr ""
"Un cabinet plein d'équipements de télécommunications. Avec les lignes "
"coupées, vous pourriez être en mesure de le démonter pour en récupérer les "
"composants électroniques utiles."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "damaged telecom cabinet"
msgstr "cabine téléphonique endommagée"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "damaged telecom cabinet"
msgid ""
"A damaged telecom cabinet.  You might still be able to salvage some useful "
"electronic scrap from it."
msgstr ""
"Une armoire de télécommunications endommagée. Vous pourriez encore être en "
"mesure de récupérer des morceaux électroniques utiles."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "HV oil circuit breaker"
msgstr "Disjoncteur de circuit haute tension "

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "HV oil circuit breaker"
msgid "A circuit breaker that uses oil in its arc suppression chamber."
msgstr "Un disjoncteur qui utilise de l'huile dans sa chambre de suppression des arcs."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Bashing sound
msgid "pow!"
msgstr "pow!"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "small HV oil circuit breaker"
msgstr "petit disjoncteur de circuit haute tension à huile"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "small HV oil circuit breaker"
msgid "A small circuit breaker that uses oil in its arc suppression chamber."
msgstr ""
"Un petit disjoncteur qui utilise de l'huile dans sa chambre de suppression "
"des arcs."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "large switchgear"
msgstr "grand équipement de commutation"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "large switchgear"
msgid "A switchgear panel.  It's covered in breaker switches, fuses, and gauges."
msgstr ""
"Un panneau de commutation. Il est couvert de disjoncteurs, de fusibles et de "
"manomètres."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "small switchgear"
msgstr "petit commutateur"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "small switchgear"
msgid ""
"A small switchgear panel.  It's covered in breaker switches, fuses, and "
"gauges."
msgstr ""
"Un petit panneau de commutation. Il est couvert de disjoncteurs, de fusibles "
"et de manomètres."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "lightning arrester"
msgstr "parafoudre"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "lightning arrester"
msgid ""
"A component designed to protect insulation and conductors in an electrical "
"system by directing lightning through itself and into the ground."
msgstr ""
"Un composant conçu pour protéger l'isolation et les conducteurs d'un système "
"électrique en dirigeant la foudre à travers lui et dans le sol."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "disconnect switch"
msgstr "interrupteur de déconnexion"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "disconnect switch"
msgid ""
"A switch used to make sure an electrical system doesn't have any current "
"flowing through it, for maintenance periods."
msgstr ""
"Un interrupteur utilisé pour s'assurer qu'un système électrique ne contient "
"aucun courant pendant les périodes de maintenance."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "current transformer"
msgstr "transformateur de courant"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "current transformer"
msgid "An electronic component used to transform the voltage of a current."
msgstr "Un composant électronique utilisé pour transformer la tension d'un courant."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "potential transformer"
msgstr "transformateur de potentiel"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "potential transformer"
msgid "A specialized type of electrical transformer."
msgstr "Un type spécialisé de transformateur électrique."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "conveyor belt"
msgstr "bande transporteuse"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "conveyor belt"
msgid "A conveyor belt.  Used to transport things."
msgstr ""
"Un tapis roulant utilisé pour transporter des choses d'une machine à une "
"autre."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "milking machine"
msgstr "machine à traire"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "milking machine"
msgid "A machine used in the dairy industry to milk cows."
msgstr "Une machine utilisée dans l'industrie laitière pour traire les vaches."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "bulk tank"
msgstr "citerne"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "bulk tank"
msgid "A heavy, high capacity tank."
msgstr "Un réservoir lourd et de grande capacité."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "rocky obstacle"
msgstr "obstacle rocheuse"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "rocky obstacle"
msgid ""
"Some larger rocks arranged and crudely rammed into the ground to slow down "
"who or whatever is trying to cross."
msgstr ""
"De grosses pierres disposées et grossièrement enfoncées dans le sol pour "
"ralentir ceux ou ce qui tente de traverser."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/json/recipes/basecamps/base/fbmc_fire_lookout_tower/recipe_modular_fire_lookout_tower_common.json
#: data/json/recipes/basecamps/base/fbmc_helipad/recipe_modular_helipad_common.json
#: data/json/recipes/basecamps/base/fbmc_lighthouse/recipe_modular_lighthouse_common.json
#: data/json/recipes/basecamps/base/fbmc_lightindustry/recipe_modular_lightindustry_00.json
#: data/json/recipes/basecamps/base/fbmc_lightindustry/recipe_modular_lightindustry_10.json
#: data/json/recipes/basecamps/base/fbmc_outpost/recipe_modular_outpost_normal.json
#: data/json/recipes/basecamps/base/fbmc_radio_tower/recipe_modular_radio_tower_common.json
#: data/json/recipes/basecamps/base/recipe_modular_hub/version_2/recipe_modular_field_common.json
#. ~ Terrain name
#. ~ Blueprint name of recipe crafting
#. "faction_base_fire_lookout_tower_root_cellar"
#. ~ Blueprint name of recipe crafting "faction_base_helipad_root_cellar"
#. ~ Blueprint name of recipe crafting "faction_base_lighthouse_root_cellar"
#. ~ Blueprint name of recipe crafting
#. "faction_base_lightindustry_00_root_cellar"
#. ~ Blueprint name of recipe crafting
#. "faction_base_lightindustry_10_root_cellar"
#. ~ Blueprint name of recipe crafting
#. "faction_base_outpost_normal_root_cellar"
#. ~ Blueprint name of recipe crafting "faction_base_radio_tower_root_cellar"
#. ~ Blueprint name of recipe crafting "fbmh_2_root_cellar"
msgid "root cellar"
msgstr "cellier"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "root cellar"
msgid "A cellar dug into the earth for storing food in a cool environment."
msgstr ""
"Une cave creusée dans la terre pour stocker de la nourriture dans un "
"environnement frais."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "covered well"
msgstr "puits recouvert"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "covered well"
msgid ""
"A deep well, collecting groundwater.  You won't be able to get any water "
"unless you add some mechanism for drawing it up to the surface."
msgstr ""
"Un puits profond, recueillant de l'eau souterraine. Vous ne pourrez pas "
"puiser d'eau sans ajouter un mécanisme pour la remonter à la surface."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "covered salt water well"
msgstr "Puits d'eau salée couvert"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "covered salt water well"
msgid ""
"A deep well, collecting salt water from a surrounding swamp.  You won't be "
"able to get any water unless you add some mechanism for drawing it up to the "
"surface."
msgstr ""
"Un puits profond, recueillant de l'eau salée d'un marais environnant. Vous ne "
"pourrez pas puiser d'eau sans ajouter un mécanisme pour la remonter à la "
"surface."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "pit filled with straw"
msgstr "Trou rempli de paille"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "pit filled with straw"
msgid ""
"A shallow pit filled with some straw.  Very crude.  Itchy and uncomfortable, "
"but better than the bare ground."
msgstr ""
"Un trou peu profond rempli de paille. Vraiment rudimentaire, irritant et "
"inconfortable, mais mieux que dormir sur le sol dur."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "improvised shelter"
msgstr "abri improvisé"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "improvised shelter"
msgid ""
"An improvised shelter providing a little bit of protection, that can be used "
"to take refuge from the elements or to protect a campfire from the rain."
msgstr ""
"Un abri improvisé fournissant pouvant servir de protection contre les "
"intempéries et aussi capable de protéger un feu de camp de la pluie."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "improvised shelter"
msgid ""
"An improvised shelter which has been made a bit more comfortable by filling "
"it with dry plant matter, which should provide some more insulation.  Trying "
"to contain a fire here would be a bad idea."
msgstr ""
"Un abri improvisé ayant été aménagé pour être un peu plus comfortable en le "
"remplissant avec de la matière végétale sèche, fournissant aussi un peu "
"d'isolation thermique. Essayer de contenir un feu à l'intérieur serait une "
"mauvaise idée."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "pine lean-to"
msgstr "appentis en sapin"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "pine lean-to"
msgid ""
"A small shelter, roofed with pine branches, that can be used to take refuge "
"from the elements or to protect a campfire from the rain."
msgstr ""
"Un petit abri couvert de branches de pin pouvant être utilisé comme un refuge "
"contre les intempéries ou pour protéger un feu de camp de la pluie."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "tarp lean-to"
msgstr "appentis avec bâche"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "tarp lean-to"
msgid ""
"A small shelter, covered by a waterproof tarp, that can be used to take "
"refuge from the elements or to protect a campfire from the rain."
msgstr ""
"Un petit abri couvert par une bâche imperméable et pouvant être utilisé comme "
"un refuge contre les intempéries ou pour protéger un feu de camp de la pluie."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "brick oven base"
msgstr "base de four en brique"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "brick oven base"
msgid "A flat assembly of carefully stacked bricks that is not quite an oven."
msgstr ""
"Un assemblage plat de briques soigneusement empilées qui n'est pas tout à "
"fait un four."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "exposed brick oven"
msgstr "four en brique exposé"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "exposed brick oven"
msgid ""
"A large brick oven that could make several pizzas at once.  This one seems to "
"be missing its door, and cannot be used in such a state."
msgstr ""
"Un grand four en briques qui pouvait faire plusieurs pizzas à la fois. "
"Celui-ci semble avoir perdu sa porte et ne peut être utilisé dans cet état."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/json/items/tool/pseudo.json
#. ~ Terrain name
#. ~ Item name
msgid "brick oven"
msgid_plural "brick ovens"
msgstr[0] "four en briques"
msgstr[1] "fours en briques"
msgstr[2] "fours en briques"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "brick oven"
