msgid_plural "camphine"
msgstr[0] "camphine"
msgstr[1] "camphine"
msgstr[2] "camphine"

#: data/json/items/fuel.json
#. ~ Description of "camphine"
msgid ""
"A blend of turpentine and ethanol, historically used as the successor to "
"whale oil for lamps before kerosene."
msgstr ""
"Mélange de térébenthine et d'éthanol, historiquement utilisé comme successeur "
"de l'huile de baleine pour les lampes avant le kérosène."

#: data/json/items/fuel.json
#. ~ Description of "crude lamp oil"
msgid "A crude, natural oil made for use in pre-modern oil lamps."
msgstr "Huile brute et naturelle utilisée dans les lampes à huile pré-modernes."

