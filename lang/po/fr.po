#: data/json/effects.json
#. ~ Name of effect type id "tetanus"
msgid "Muscle Cramps"
msgstr "Crampes Musculaires"

#: data/json/effects.json
#. ~ Description of effect type "Muscle Cramps"
msgid "Your muscles are binding up, you should probably find a sedative."
msgstr ""
"Vos muscles n'arrêtent pas de se contracter douloureusement, vous devriez "
"probablement trouver un sédatif pour les relaxer."

#: data/json/effects.json
#. ~ Apply message of effect type "Muscle Cramps"
msgid "Your muscles start convulsing!"
msgstr "Mos muscles comment à convulser!"

#: data/json/effects.json
#. ~ Blood analysis description of effect type "Muscle Cramps"
msgid "Clostridium tetani Infection"
msgstr "Infection: Clostridium tetani"

#: data/json/effects.json
#. ~ Name of effect type id "rat_bite_fever"
msgid "Puckered Scratches"
msgstr "Égratignures Inflammées"

#: data/json/effects.json
#. ~ Apply message of effect type "Puckered Scratches"
msgid ""
"Your skin starts burning around some of your scratches.  Some aspirin might "
"relieve the effects."
msgstr ""
"La peau autour de certaines de vos égratignures brûle un peu. De l'aspirine "
"pourrait vous soulager."

#: data/json/effects.json
#. ~ Remove message of effect type "Puckered Scratches"
msgid "The fever breaks."
msgstr "Vos symptômes fiévreux se dissipent."

#: data/json/effects.json
#. ~ Blood analysis description of effect type "Puckered Scratches"
msgid "Streptobacillus moniliformis Infection"
msgstr "Infection: Streptobacillus moniliformis"

#: data/json/effects.json
#. ~ Name of effect type id "datura"
msgid "Experiencing Datura"
msgstr "En Cours de Trip de Datura"

#: data/json/effects.json
#. ~ Description of effect type "Experiencing Datura"
msgid "Buy the ticket, take the ride.  The datura has you now."
msgstr ""
"Achetez le ticket, montez sur le manège. Vous étes sous la possession de la "
"datura maintenant."

#: data/json/effects.json
#. ~ Blood analysis description of effect type "Experiencing Datura"
msgid "Anticholinergic Tropane Alkaloids"
msgstr "Alcaloïdes Tropaniques Anticholinergiques"

#: data/json/effects.json
#. ~ Name of effect type id "grabbed"
msgid "Grabbed"
msgstr "Empoigné"

#: data/json/effects.json
#. ~ Description of effect type "Grabbed"
msgid ""
"You have been grabbed and held in place by an attack.  You're not able to "
"move until breaking the grab, and depending on the strength of your opponent "
"using this limb is difficult to impossible.\n"
"Wait in place or attempt to move without attacking to try and remove this "
"effect."
msgstr ""
"Vous avez été agrippé·e et retenu·e par une attaque.  Vous ne serez pas "
"capable de bouger jusqu'à ce que vous brisiez la prise, et selon la force de "
"votre adversaire, utiliser ce membre est difficile, voire impossible. \n"
"Patientez sur place ou essayez de vous déplacer sans attaquer pour tenter de "
"supprimer cet effet."

#: data/json/effects.json
#. ~ Name of effect type id "grabbing"
#. ~ Name of effect type id "grabbing_2"
#. ~ Name of effect type id "grabbing_3"
msgid "Grabbing"
msgstr "Saisie"

#: data/json/effects.json
#. ~ Description of effect type "Grabbing"
msgid "Grabbing another creature and holding them in place."
msgstr "Vous avez agrippé une autre creature et la maintenez en place."

#: data/json/effects.json
#. ~ Description of effect type "Grabbing"
msgid "Grabbing another creature and holding them in place with a second appendage."
msgstr ""
"Vous avez agrippé une autre créature et la maintenez en place avec un second "
"membre."

#: data/json/effects.json
#. ~ Name of effect type id "lack_sleep"
msgid "Lacking Sleep"
msgstr "Manque de sommeil"

#: data/json/effects.json
#. ~ Description of effect type "Lacking Sleep"
msgid "You haven't slept in a while, and it shows."
msgstr "Cela fait un moment que vous n'avez pas dormi et cela se voit."

#: data/json/effects.json
#. ~ Apply message of effect type "Lacking Sleep"
msgid "You are too physically tired to function well."
msgstr "Vous êtes trop fatigué(e) pour fonctionner correctement."

#: data/json/effects.json
#. ~ Miss message of effect type "Lacking Sleep"
msgid "You don't have energy to fight."
msgstr "Vous n'avez pas assez d'énergie pour vous battre."

#: data/json/effects.json
#. ~ Apply message of effect type "lying_down"
msgid "You lie down to go to sleep…"
msgstr "Vous vous couchez pour dormir."

#: data/json/effects.json
#. ~ Apply message of effect type "sleep"
msgid "You fall asleep."
msgstr "Vous vous endormez."

#: data/json/effects.json data/mods/Xedra_Evolved/spells/spell_eocs.json
#. ~ Remove message of effect type "sleep"
#. ~ Player message in effect in EoC "EOC_LUCID_DREAM_END"
msgid "You wake up."
msgstr "Vous vous réveillez."

#: data/json/effects.json
#. ~ Blood analysis description of effect type "narcosis"
msgid "Narcosis"
msgstr "Narcosie"

#: data/json/effects.json
#. ~ Name of effect type id "under_operation"
msgid "Under Operation"
msgstr "En cours d'opération"

#: data/json/effects.json
#. ~ Description of effect type "Under Operation"
msgid "You are being operated on.  Try to stay still."
msgstr "Vous êtes en train de vous faire opérer. Veuillez rester immobile."

#: data/json/effects.json
#. ~ Name of effect type id "playing_instrument"
msgid "Playing an Instrument"
msgstr "En train de jouer d'un Instrument"

#: data/json/effects.json
#. ~ Description of effect type "Playing an Instrument"
msgid ""
"You're playing an instrument.\n"
"Focusing on playing music distracts you, slowing you down."
msgstr ""
"Vous jouez d'un instrument.\n"
"Vous concentrer sur la musique vous distrait, ce qui vous ralentit."

#: data/json/effects.json
#. ~ Name of effect type id "corroding"
msgid "Corroding"
msgstr "En train d'être corrodé"

#: data/json/effects.json
#. ~ Description of effect type "Corroding"
#. ~ Apply message of effect type "Corroding"
msgid "You're covered in acid!"
msgstr "Vous êtes couvert d'acide!"

#: data/json/effects.json
#. ~ Name of effect type id "zapped"
msgid "Zapped"
msgstr "Électrocuté(e)"

#: data/json/effects.json
#. ~ Description of effect type "Zapped"
msgid "You've been zapped with electricity and are barely able to move!"
msgstr "Vous vous êtes fait électrocuté(e) et êtes à peine capable de bouger!"

#: data/json/effects.json
#. ~ Apply message of effect type "Zapped"
msgid "You're zapped!"
msgstr "Vous êtes électrocuté(e)!"

#: data/json/effects.json
#. ~ Name of effect type id "electrocuted"
msgid "Electrocuted"
msgstr "Électrocuté(e)"

#: data/json/effects.json
#. ~ Description of effect type "Electrocuted"
msgid "You're being shocked with electricity to the point of serious harm!"
msgstr "Vous êtes électrocuté·e au point d'être gravement blessé·e!"

#: data/json/effects.json
#. ~ Apply message of effect type "Electrocuted"
msgid "You're being electrocuted!"
msgstr "Vous êtes en train d'être électrocuté(e)!"

#: data/json/effects.json
#. ~ Name of effect type id "mutation_internal_damage"
msgid "Botched Mutation"
msgstr "Mutation Ratée"

#: data/json/effects.json
#. ~ Name of effect type id "mutation_internal_damage"
msgid "Destroyed Bionic"
msgstr "Implant Bionique Détruit"

#: data/json/effects.json
#. ~ Description of effect type "Botched Mutation, Destroyed Bionic"
msgid "Your changing body did not cope well with your bionics."
msgstr ""
"Votre corps en métamorphose ne fait pas un bon voisin avec vos implants "
"bioniques."

#: data/json/effects.json
#. ~ Apply message of effect type "Botched Mutation, Destroyed Bionic"
msgid "Your twisting flesh strains against the bionics invading your body."
msgstr ""
"Votre chair en transformation lutte contre l'intrusion de vos implants "
"bioniques."

#: data/json/effects.json
#. ~ Name of effect type id "anemia"
msgid "Early Iron Deficiency"
msgstr "Carence de Fer Bénigne"

#: data/json/effects.json
#. ~ Name of effect type id "anemia"
msgid "Iron Deficiency"
msgstr "Carence de Fer"

#: data/json/effects.json
#. ~ Name of effect type id "anemia"
msgid "Acute Iron Deficiency"
msgstr "Carence de Fer Aiguë"

#: data/json/effects.json
#. ~ Description of effect type "Early Iron Deficiency"
msgid ""
"A lack of iron in your diet has hampered the efficiency and regeneration of "
"your red blood cells."
msgstr ""
"Une carence de fer commence à compromettre l'équilibre entre le "
"renouvellement et la sénescence de vos cellules rouges."

#: data/json/effects.json
#. ~ Description of effect type "Iron Deficiency"
msgid ""
"Prolonged lack of iron in your diet has compromised the efficiency and "
"regeneration of your red blood cells."
msgstr ""
"Une carence prolongée de fer dans votre alimentation compromets l'équilibre "
"entre le renouvellement et la sénescence de vos cellules rouges."

#: data/json/effects.json
#. ~ Description of effect type "Acute Iron Deficiency"
msgid ""
"Severe lack of iron in your diet results in your red blood cells dying faster "
"then they are regenerating."
msgstr ""
"Une carence grave de fer dans votre alimentation a pour conséquence de rendre "
"le rythme de renouvellement des cellules rouges dans votre sang plus lent que "
"leur rythme de sénescence naturel."

#: data/json/effects.json
#. ~ Apply message of effect type "Early Iron Deficiency, Iron Deficiency,
#. Acute Iron Deficiency"
#. ~ Apply message of effect type "Early Anemia, Anemia, Acute Anemia"
msgid "You begin feeling increasingly tired and listless."
msgstr "Vous vous sentez de plus en plus à court d'énergie et apathique."

#: data/json/effects.json
#. ~ Remove message of effect type "Early Iron Deficiency, Iron Deficiency,
#. Acute Iron Deficiency"
msgid "You are no longer in risk of becoming anemic."
msgstr "Vous n'êtes plus à risque de devenir anémique."

#: data/json/effects.json
#. ~ Decay message of effect type "Early Iron Deficiency, Iron Deficiency,
#. Acute Iron Deficiency"
msgid "Your iron deficiency is nearly resolved."
msgstr "Votre carence de fer est pratiquement guérie."

#: data/json/effects.json
#. ~ Decay message of effect type "Early Iron Deficiency, Iron Deficiency,
#. Acute Iron Deficiency"
msgid "Your feel stronger as your iron deficiency starts to improve."
msgstr "Vous vous sentez mieux dû à la réduction de votre carence de fer."

#: data/json/effects.json
#. ~ Blood analysis description of effect type "Early Iron Deficiency, Iron
#. Deficiency, Acute Iron Deficiency"
#. ~ Name of effect type id "redcells_anemia"
#. ~ Blood analysis description of effect type "Early Anemia, Anemia, Acute
#. Anemia"
msgid "Anemia"
msgstr "Anémie"

#: data/json/effects.json
#. ~ Name of effect type id "redcells_anemia"
msgid "Early Anemia"
msgstr "Anémie Bénigne"

#: data/json/effects.json
#. ~ Name of effect type id "redcells_anemia"
msgid "Acute Anemia"
msgstr "Anémie Aiguë"

#: data/json/effects.json
#. ~ Description of effect type "Early Anemia, Anemia, Acute Anemia"
msgid "Loss of red blood cells results in progressively worsening anemia."
msgstr ""
"La perte de sang entraîne des symptômes d'anémie d'une gravité croissante au "
"volume perdu."

#: data/json/effects.json
#. ~ Remove message of effect type "Early Anemia, Anemia, Acute Anemia"
msgid "You no longer feel anemic."
msgstr "Vous ne vous sentez plus anémique."

#: data/json/effects.json
#. ~ Decay message of effect type "Early Anemia, Anemia, Acute Anemia"
msgid "Your anemia is nearly resolved."
msgstr "Votre anémie est pratiquement guérie."

#: data/json/effects.json
#. ~ Decay message of effect type "Early Anemia, Anemia, Acute Anemia"
msgid "Your feel stronger as your anemia starts to improve."
msgstr "Votre anémie s'améliore et vous vous sentez plus fort."

#: data/json/effects.json
#. ~ Name of effect type id "scurvy"
msgid "Early Scurvy"
msgstr "Scorbut Bénin"

#: data/json/effects.json
#. ~ Name of effect type id "scurvy"
#. ~ Blood analysis description of effect type "Early Scurvy, Scurvy, Bad
#. Scurvy"
msgid "Scurvy"
msgstr "Scorbut"

#: data/json/effects.json
#. ~ Name of effect type id "scurvy"
msgid "Bad Scurvy"
msgstr "Scorbut Grave"

#: data/json/effects.json
#. ~ Description of effect type "Early Scurvy, Scurvy, Bad Scurvy"
msgid ""
"A lack of vitamin C in your diet will result in progressively worse symptoms "
"of scurvy."
msgstr ""
"Un manque de vitamine C dans votre alimentation va aggraver les symptômes du "
"scorbut progressivement."

#: data/json/effects.json
#. ~ Apply message of effect type "Early Scurvy, Scurvy, Bad Scurvy"
msgid "You start to develop symptoms of scurvy."
msgstr "Vous commencez à voir apparaître les symptômes du scorbut."

#: data/json/effects.json
#. ~ Remove message of effect type "Early Scurvy, Scurvy, Bad Scurvy"
msgid "Your scurvy has resolved."
msgstr "Votre scorbut se résorbe."

#: data/json/effects.json
#. ~ Decay message of effect type "Early Scurvy, Scurvy, Bad Scurvy"
msgid "Your vitamin C deficiency is starting to resolve."
msgstr "Votre carence en vitamine C est en train de se résoudre."

#: data/json/effects.json
#. ~ Decay message of effect type "Early Scurvy, Scurvy, Bad Scurvy"
msgid "Your scurvy lessens as your Vitamin C deficiency improves."
msgstr "Votre scorbut diminue grâce à l'apport en vitamine C."

#: data/json/effects.json
#. ~ Name of effect type id "betablock"
msgid "Beta blocker"
msgstr "Bêta-bloquant"

#: data/json/effects.json
#. ~ Description of effect type "Beta blocker"
msgid ""
"You are under the influence of a beta blocker.  This controls your heart "
"rate, decreasing the influence of stressful events such as pain on it.  "
"However, it also lowers blood pressure and induces sleepiness."
msgstr ""
"Vous êtes sous l'influence d'un bêtabloquant. Ce médicament contrôle votre "
"rythme cardiaque, diminuant ainsi l'influence d'événements stressants comme "
"la douleur. Cependant, il diminue également la tension artérielle et induit "
"la somnolence."

#: data/json/effects.json
#. ~ Blood analysis description of effect type "Beta blocker"
msgid "Beta Blocker"
msgstr "Bêta-bloquants"

#: data/json/effects.json
#. ~ Name of effect type id "hypervitaminosis"
#. ~ Blood analysis description of effect type "Hypervitaminosis"
msgid "Hypervitaminosis"
msgstr "Hypervitaminose"

#: data/json/effects.json
#. ~ Description of effect type "Hypervitaminosis"
msgid "An excess of vitamins has badly affected your metabolism."
msgstr "Un excès de vitamines a gravement affecté votre métabolisme."

#: data/json/effects.json
#. ~ Apply message of effect type "Hypervitaminosis"
msgid "Your metabolism becomes unstable."
msgstr "Votre métabolisme devient instable."

#: data/json/effects.json
#. ~ Remove message of effect type "Hypervitaminosis"
msgid "Your metabolism becomes more stable."
msgstr "Votre métabolisme devient plus stable."

#: data/json/effects.json
#. ~ Name of effect type id "toxin_buildup"
msgid "Concerning symptoms"
msgstr "Symptômes inquiétants"

#: data/json/effects.json
#. ~ Name of effect type id "toxin_buildup"
msgid "Unnerving symptoms"
msgstr "Symptômes inquiétants"

#: data/json/effects.json
#. ~ Description of effect type "Concerning symptoms"
msgid "Your muscles keep twitching strangely."
msgstr "Vos muscles n'arrêtent pas de trembler bizarrement."

#: data/json/effects.json
#. ~ Description of effect type "Unnerving symptoms"
msgid ""
"Your nervous system is malfunctioning, almost like it's being torn apart from "
"the inside."
msgstr ""
"Votre système nerveux malfonctionne comme s'il était en train d'être déchiré "
"de l'intérieur."

