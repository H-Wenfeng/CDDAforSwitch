#: data/json/speech.json data/mods/Aftershock/speech.json
#: data/mods/CrazyCataclysm/crazy_speech.json
#: data/mods/aftershock_exoplanet/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker afs_mon_migoturret
#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
msgid "\"Hello?\""
msgstr "\"Bonjour?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Papaya!\""
msgstr "\"Papaye!\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker mon_turret, mon_mi_go, mon_mi_go_slaver
msgid "\"Who's there?\""
msgstr "\"Qui est là?\""

#: data/json/speech.json data/mods/Aftershock/speech.json
#: data/mods/aftershock_exoplanet/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker afs_mon_migoturret
msgid "\"Can you help me?\""
msgstr "\"Vous pouvez m'aider?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Over here!\""
msgstr "\"Par ici!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Can you repeat that?\""
msgstr "\"Vous pouvez répéter?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"You're just copying me, aren't you?\""
msgstr "\"Vous me copiez c'est ça?\""

#: data/json/snippets/schizophrenia.json data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Snippet in category "schizo_self_shout"
msgid "\"I'm not afraid of you!\""
msgstr "\"Je n'ai pas peur de vous!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
#. ~ Speech from speaker mon_feral_maid_broom, mon_feral_maid_candlestick,
#. mon_feral_maid_knife
msgid "\"Come here!\""
msgstr "\"Venez ici!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Please, don't!\""
msgstr "\"S'il vous plaît ne faites pas ça!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a horrified scream!"
msgstr "un cri horrifié!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a little girl's wailing!"
msgstr "un pleur de petite fille!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"So, what is this thing supposed to be, exactly?\""
msgstr "\"Qu'est ce que c'est censé être cette chose exactement ?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Uncategorized object seven-seven-three-four.\""
msgstr "\"Objet non catégorisé sept-sept-trois-quatre.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We found it in a wreckage, barely alive.  Not the first one, either.\""
msgstr ""
"\"Nous l'avons trouvé dans une épave, à peine vivant.  Ce n'est pas le "
"premier non plus.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "\"La zone dix-neuf en possède quelques-uns en chambre froide.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Mommy, help!\""
msgstr "\"Maman à l'aide!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We're still trying to figure out what makes it tick.\""
msgstr "\"Nous essayons toujours de comprendre ce qui le fait fonctionner.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We're not even sure what it is.\""
msgstr "\"On n'est même pas sûrs de ce que c'est.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_surgeon
msgid "\"The cell structure is unlike any we've ever seen.\""
msgstr "\"La structure cellulaire ne ressemble à rien jamais vu.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"It does seem to have some form of higher level brain functioning.\""
msgstr ""
"\"Il semble y avoir une certaine forme de fonctionnement cérébral de niveau "
"supérieur.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Problem solving, memory retention, that sort of thing.\""
msgstr "\"Résolution de problèmes, rétention de mémoire, ce genre de choses.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"There appear to be some anomalous aspects to the mimicry.\""
msgstr "\"Des aspects anormaux ont été identifiés dans son mimétisme.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Members of the species have some kind of neurocognitive link.\""
msgstr "\"Les membres de l'espèce ont une sorte de lien neurocognitif.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"This one's repeating phrases that the previous specimen was exposed to.\""
msgstr "\"Celui-ci répète des phrases auxquelles le spécimen précédent a été exposé.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a child shrieking!"
msgstr "un cri d'enfant!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Oh God, my leg, Oh God!\""
msgstr "\"Ma jambe, oh mon dieux ma jammbee!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "a long cry of agony!"
msgstr "un long cri d'agonie!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"You mean it's not just parroting us?\""
msgstr "\"Vous voulez dire que ce n'est pas juste de l'imitation?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"It's parroting us, but we're uncertain as to how or why.\""
msgstr "\"Cette chose nous mimique, mais nous ne savons pas comment ou pourquoi.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"It may be a mechanism for attracting prey.\""
msgstr "\"Ça pourrait être un mécanisme pour attirer des proies.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"It could even be a way of trying to scare us off.\""
msgstr "\"Cela pourrait même être une manière de nous effrayer.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We just don't know.\""
msgstr "\"Nous ne savons tout simplement pas.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "an anguished wail!"
msgstr "un cri angoissé!"

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"You're gonna rot in hell for this!\""
msgstr "\"Vous allez pourrir en Enfer pour ça!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"You hear me!?\""
msgstr "\"Vous m'entendez!?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"You're gonna rot in hell, you pieces of shit!\""
msgstr "\"Vous allez pourrir en enfer, salauds!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_surgeon
msgid "\"Like we said, we have no idea what it's thinking.\""
msgstr ""
"\"Comme expliqué précédemment, nous n'avons pas la moindre idée de comment "
"cette chose pense.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Is that glass electrified?\""
msgstr "\"Il est électrifié le verre ?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Why don't you touch it and find out?\""
msgstr "\"Pourquoi pas le toucher et voir ce qui se passe?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Of course it is.\""
msgstr "\"Bien sûr que oui.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"What'll happen if the power goes out?\""
msgstr "\"Que se passera-t-il si le courant s'éteint?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Don't worry about it.\""
msgstr "\"Ne t'inquiète pas à ce sujet\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Don't worry.\""
msgstr "\"T'en fais pas\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"There are seven backup generators.\""
msgstr "\"Il y a sept générateurs de secours\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"And what if all the backups fail?\""
msgstr "\"Et si les générateurs de secours tombent en panne?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"We'd have to terminate the specimen.\""
msgstr "\"Nous devrons éliminer le spécimen.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"The glass alone won't keep us safe for very long.\""
msgstr "\"Juste une fenêtre d'observation ne nous protègera pas très longtemps\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"That fuckin' thing is horrible, man, it gives me the creeps.\""
msgstr "\"Cette chose est horrible, putain mec, ça me fout les jetons\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"It's probably more scared of us than we are of it.\""
msgstr "\"Ça a probablement plus peur de nous que nous avons peur d'elle\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Somehow, I doubt that.\""
msgstr "\"Je ne sais pas pourquoi mais j'en doute\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Hey, we got other specimens that could withstand a grenade.\""
msgstr ""
"«Hé, on a d'autres spécimens qui seraient probablement capable d'encaisser "
"une grenade.»  "

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"And that's supposed to comfort me?\""
msgstr "\"Et c'est censé me réconforter?\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"At least we know they can die.\""
msgstr "\"Au moins on sait qu'ils peuvent mourir.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"U-O Seven-Seven-Three-Four.\""
msgstr "«U-O Sept-Sept-Trois-Quatre.» "

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Individual instances of U-O Seven-Seven-Three-Four.\""
msgstr "\"Instances individuelles de U-O Sept-Sept-Trois-Quatre.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"To be kept in a standard biohazardous containment chamber.\""
msgstr ""
"\"À conserver dans une chambre de confinement standard pour risques "
"biologiques.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Until such time as more permanent arrangements are made.\""
msgstr "\"Jusqu'à ce que des dispositions plus permanentes soient prises.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Shows a noted preference for human brain tissue.\""
msgstr "\"Montre une préférence marquée pour les tissus cérébraux humains.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"Destroy the specimen if it begins to interact with the lock.\""
msgstr "\"Détruisez le spécimen si celui-ci commence à interagir avec le verrou.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Kill them all and let God sort them out!\""
msgstr "\"Tuez-les tous, Dieu reconnaîtra les siens!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"I watched a snail crawl along the edge of a straight razor.\""
msgstr "\"J'ai regardé un escargot ramper le long du tranchant d'un rasoir.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"I've seen horrors, horrors that you've seen.\""
msgstr "\"J'ai vu des horreurs, des horreurs que vous avez vues.\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver
msgid "\"I love the smell of napalm in the morning.\""
msgstr "\"J’adore l’odeur du napalm le matin.\""

#: data/json/speech.json
