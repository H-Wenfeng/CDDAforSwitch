#: src/activity_actor.cpp:358
#, c-format
msgid "Your %s is little more than an awkward club now."
msgstr "Votre %s est à peine mieux qu'une massue peu pratique."

#: src/activity_actor.cpp:372
#, c-format
msgid ""
"Your %s has some mechanical malfunction.  You tried to quickly fix it, and it "
"works now!"
msgstr ""
"Votre %s a un problème mécanique. Vous essayez de le/la réparer rapidement, "
"et ça fonctionne !"

#: src/activity_actor.cpp:378
#, c-format
msgid ""
"Your %s has some mechanical malfunction.  You tried to quickly fix it, but "
"failed!"
msgstr ""
"Votre %s a un problème mécanique.  Vous avez essayé de le résoudre rapidement "
"sans succès!"

#: src/activity_actor.cpp:386
#, c-format
msgid "Your %s is too hot, and little screen signalizes the gun is inoperable."
msgstr ""
"Votre %s est trop chaud, un petit écran vous signal que l'arme est "
"inutilisable."

#: src/activity_actor.cpp:675
msgid "Auto drive canceled."
msgstr "Conduite automatique annulée."

#: src/activity_actor.cpp:685 src/activity_handlers.cpp:1625
#: src/activity_handlers.cpp:1653
msgid "You have reached your destination."
msgstr "Vous avez atteint votre destination."

#: src/activity_actor.cpp:713
msgid "Something got in the way of smashing."
msgstr "Quelque chose bloque votre fracassement."

#: src/activity_actor.cpp:722
msgid "You're no longer able to make progress smashing here."
msgstr "Fracasser ici n'a plus d'effet."

#: src/activity_actor.cpp:803
#. ~ %1$s - gunmod, %2$s - gun.
#, c-format
msgid "You remove your %1$s from your %2$s."
msgstr "Vous retirez %1$s de %2$s."

#: src/activity_actor.cpp:879
msgid "You cause a short circuit!"
msgstr "Vous provoquez un court-circuit!"

#: src/activity_actor.cpp:917
msgid "You cannot hack this."
msgstr "Vous ne pouvez pas pirater ça."

#: src/activity_actor.cpp:923 src/activity_actor.cpp:2735
#: src/activity_actor.cpp:6749 src/computer_session.cpp:551
#: src/computer_session.cpp:570 src/computer_session.cpp:1359
#: src/computer_session.cpp:1630
msgid "an alarm sound!"
msgstr "une alarme retenti!"

#: src/activity_actor.cpp:928
msgid "You fail the hack, but no alarms are triggered."
msgstr "Votre piratage échoue, mais aucune alarme n'a été déclenchée."

#: src/activity_actor.cpp:944
msgid "You hack the terminal and route all available fuel to your pump!"
msgstr "Vous piratez le terminal et redirigez toute l'essence vers votre pompe!"

#: src/activity_actor.cpp:946
msgid "Glug Glug Glug Glug Glug Glug Glug Glug Glug"
msgstr "Gloup Gloup Gloup Gloup Gloup Gloup Gloup Gloup"

#: src/activity_actor.cpp:948 src/explosion.cpp:743 src/gates.cpp:252
#: src/gates.cpp:262 data/json/items/tool/fire.json
#. ~ "need_charges_msg" action message of item "refillable lighter"
msgid "Nothing happens."
msgstr "Rien ne se passe."

#: src/activity_actor.cpp:951
msgid "The door on the safe swings open."
msgstr "La porte du coffre-fort s'ouvre."

#: src/activity_actor.cpp:954
msgid "You activate the panel!"
msgstr "Vous activez le panneau!"

#: src/activity_actor.cpp:955
msgid "The nearby doors unlock."
msgstr "Les serrures des portes à proximité se désengagent."

#: src/activity_actor.cpp:992 src/iuse.cpp:9085
msgid "It's too dark to write!"
msgstr "Il fait trop sombre pour écrire!"

#: src/activity_actor.cpp:1009
#, c-format
msgid "You copy the recipe for %1$s into your recipe book."
msgstr "Vous copiez la recette de fabrication de %1$s dans votre livre de recettes."

#: src/activity_actor.cpp:1092
msgid "You found the wire that starts the engine."
msgstr "Vous avez trouvé le câble permettant de démarrer le moteur."

#: src/activity_actor.cpp:1096
msgid "You found a wire that looks like the right one."
msgstr "Vous avez trouvé ce qui semble être le cable correct."

#: src/activity_actor.cpp:1101
msgid "The red wire always starts the engine, doesn't it?"
msgstr "Le fil rouge démarre toujours le moteur, non?"

#: src/activity_actor.cpp:1106
msgid "By process of elimination, you found the wire that starts the engine."
msgstr ""
"Vous avez déduit le câble permettant de démarrer le moteur en procédant par "
"élimination."

#: src/activity_actor.cpp:1217 src/activity_actor.cpp:1240
#. ~ Sound of a metal sawing tool at work!
msgid "grnd grnd grnd"
msgstr "grnd grnd grnd"

#: src/activity_actor.cpp:1221 src/activity_actor.cpp:1244
#: src/activity_actor.cpp:2446 src/activity_actor.cpp:6143
#: src/activity_actor.cpp:6624
#, c-format
msgid "Your %1$s ran out of charges."
msgstr "Votre %1$s n'a plus de charges."

#: src/activity_actor.cpp:1223 src/activity_actor.cpp:1246
#: src/activity_actor.cpp:2448 src/activity_actor.cpp:6145
#: src/activity_actor.cpp:6626
#, c-format
msgid "%1$s %2$s ran out of charges."
msgstr "%1$s %2$s n'a plus de charges."

#: src/activity_actor.cpp:1468 src/activity_actor.cpp:1590
msgid "You come to a gentle landing."
msgstr "Vous parvenez à atterrir en douceur."

#: src/activity_actor.cpp:1469 src/activity_actor.cpp:1591
msgid "<npcname> comes to a gentle landing."
msgstr "<npcname> atterrit en douceur."

#: src/activity_actor.cpp:1477 src/activity_actor.cpp:1498
#, c-format
msgid "You collide with %s, bringing an abrupt halt to your glide."
msgstr ""
"Vous entrez en collision avec %s, ce qui vous stoppe brutalement dans votre "
"élan."

#: src/activity_actor.cpp:1478 src/activity_actor.cpp:1499
#, c-format
msgid "<npcname> collides with %s, bringing an abrupt halt to their glide."
msgstr "<npcname> percute %s , le/la stoppant net dans son élan."

#: src/activity_actor.cpp:1510
#, c-format
msgid "You deftly maneuver around %s."
msgstr "Vous manœuvrez agilement autour de %s."

#: src/activity_actor.cpp:1511
#, c-format
msgid "<npcname> deftly maneuvers around %s."
msgstr "<npcname> manoeuvre agilement autour de %s."

#: src/activity_actor.cpp:1667
msgid "You no longer have the book!"
msgstr "Vous ne possédez plus le livre!"

#: src/activity_actor.cpp:1668
msgid "<npcname> no longer has the book!"
msgstr "<npcname> n'a plus le livre!"

#: src/activity_actor.cpp:1717 src/character.cpp:12349 src/npc.cpp:1346
msgid "It's too dark to read!"
msgstr "Il fait trop sombre pour lire!"

#: src/activity_actor.cpp:1733
msgid "You no longer have the e-book!"
msgstr "Vous ne possédez plus l'e-book!"

#: src/activity_actor.cpp:1734
msgid "<npcname> no longer has the e-book!"
msgstr "<npcname> n'a plus l'e-book!"

#: src/activity_actor.cpp:1742 src/activity_actor.cpp:2876
#, c-format
msgid "%1$s %2$s ran out of batteries."
msgstr "%1$s %2$s n'a plus de batterie."

#: src/activity_actor.cpp:1884
#, c-format
msgid "Your theoretical knowledge of %s increases to level %d."
msgstr "Vos connaissances théoriques en %s augmentent au niveau %d."

#: src/activity_actor.cpp:1887
#, c-format
msgid "%s increases their %s knowledge."
msgstr "%s augmente ses connaissances à propos de %s."

#: src/activity_actor.cpp:1897
#, c-format
msgid "You learn a little about %s!  (%d%%)"
msgstr " Vous en apprenez un peu plus au sujet de %s! (%d%%)"

#: src/activity_actor.cpp:1908
#, c-format
msgid "You can no longer learn from %s."
msgstr "Vous ne pouvez plus apprendre à partir de %s."

#: src/activity_actor.cpp:1921 src/activity_actor.cpp:2040
#, c-format
msgid "%s learns a little about %s!"
msgstr "%s apprends un peu au sujet de %s!"

#: src/activity_actor.cpp:1926
#, c-format
msgid "%s learn a little about %s!"
msgstr "%s en apprend un peu sur %s!"

#: src/activity_actor.cpp:1931 src/activity_actor.cpp:2048
#: src/activity_actor.cpp:2053
#, c-format
msgid "%s can no longer learn from %s."
msgstr "%s ne peut plus apprendre de %s."

#: src/activity_actor.cpp:1973
msgid ""
"You train the moves according to the book, but can't get a grasp of the "
"style, so you start from the beginning."
msgstr ""
"Vous vous entraînez aux mouvements selon le livre, mais vous n'arrivez pas à "
"maîtriser le style, alors vous recommencez depuis le début."

#: src/activity_actor.cpp:1977
msgid ""
"This martial art is not easy to grasp.  You start training the moves from the "
"beginning."
msgstr ""
"Cet art martial n'est pas facile à apprendre. Vous commencez à vous entrainer "
"avec les mouvements les plus basiques."

#: src/activity_actor.cpp:1981
msgid ""
"You decide to read the manual and train even more.  In martial arts, patience "
"leads to mastery."
msgstr ""
"Vous décidez de lire le manuel et de vous entrainer encore plus.  Avec les "
"arts martiaux, la patience mène à la maîtrise."

#: src/activity_actor.cpp:1985
msgid "You try again.  This training will finally pay off."
msgstr "Vous essayez encore.  Vos efforts finiront par payer."

#: src/activity_actor.cpp:1989
msgid "You train for a while."
msgstr "Vous vous entraînez un moment."

#: src/activity_actor.cpp:2033
#, c-format
msgid "%s increases their %s level."
msgstr "%s augmente son niveau de %s."

#: src/activity_actor.cpp:2129
msgid "You finish reading."
msgstr "Vous terminer de lire."

#: src/activity_actor.cpp:2287
msgid "You lose track of some hauled items as they didn't fit on the current tile."
msgstr ""
"Vous perdez la trace de certains objets transportés car ils ne tenaient pas "
"sur la case actuelle."

#: src/activity_actor.cpp:2341
msgid "Moving canceled auto-pickup."
msgstr "Bouger a annulé le ramassage automatique."

#: src/activity_actor.cpp:2354
msgid "Some items were not picked up!"
msgstr "Des objets n'ont pas été ramassés!"

#: src/activity_actor.cpp:2510
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain_vitrified.json
#. ~ Boltcut sound of terrain "chain link fence"
#. ~ Boltcut sound of terrain "wire fence"
#. ~ Boltcut sound of terrain "barbed wire fence"
msgid "Snick, snick, gachunk!"
msgstr "Clink, clink, clack!"

#: src/activity_actor.cpp:2614
msgid "The lock opens…"
msgstr "La serrure s'ouvre…"

#: src/activity_actor.cpp:2627 src/activity_actor.cpp:2639
msgid "You can't open this lock."
msgstr "Vous ne pouvez pas ouvrir cette serrure."

#: src/activity_actor.cpp:2707
msgid "Your clumsy attempt jams the lock!"
msgstr "Votre maladresse bloque la serrure!"

#: src/activity_actor.cpp:2712
msgid "The lock stumps your efforts to pick it, and you destroy your tool."
msgstr "La serrure résiste à vos efforts de la crocheter, et vous cassez votre outil."

#: src/activity_actor.cpp:2716
msgid "The lock stumps your efforts to pick it, and you damage your tool."
msgstr ""
"La serrure résiste à vos efforts de la crocheter, et vous endommagez votre "
"outil."

#: src/activity_actor.cpp:2719
msgid "The lock stumps your efforts to pick it."
msgstr "La serrure résiste à vos efforts de la crocheter."

#: src/activity_actor.cpp:2769
msgid "There is nothing to lockpick nearby."
msgstr "Il n'y a rien à crocheter dans les environs."

#: src/activity_actor.cpp:2769
msgid "Use your lockpick where?"
msgstr "Où voulez-vous utiliser votre crochet?"

#: src/activity_actor.cpp:2781
msgid "You pick your nose and your sinuses swing open."
msgstr "Vous crochetez votre nez et vos sinus sont soudainement ouverts."

#: src/activity_actor.cpp:2784
msgid ""
"You can pick your friends, and you can\n"
"pick your nose, but you can't pick\n"
"your friend's nose."
msgstr ""
"Tu peux avoir des amis, et tu peux\n"
"avoir un nez, mais tu ne peux pas avoir\n"
"le nez de tes amis"

#: src/activity_actor.cpp:2786
msgid "That door isn't locked."
msgstr "Cette porte n'est pas verrouillée."

#: src/activity_actor.cpp:2788
msgid "That cannot be picked."
msgstr "Cela ne peut pas être ramassé."

#: src/activity_actor.cpp:2926
#, c-format
msgid "You scan %d %s into your device."
msgstr "Vous scannez %d %s dans votre appareil."

#: src/activity_actor.cpp:2927 src/activity_actor.cpp:2930
msgid "book"
msgid_plural "books"
msgstr[0] "livre"
msgstr[1] "livres"
msgstr[2] "livres"

#: src/activity_actor.cpp:2929
#, c-format
msgid "%s scans %d %s into their device."
msgstr "%s scanne %d %s dans leur appareil."

