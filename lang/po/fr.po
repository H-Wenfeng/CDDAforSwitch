#: data/mods/Aftershock/mutations/esper.json
#: data/mods/aftershock_exoplanet/mutations/esper.json
#. ~ Description of mutation "Telekinetic"
msgid "The ability to move objects without touching them."
msgstr ""

#: data/mods/Aftershock/mutations/esper.json
#: data/mods/aftershock_exoplanet/mutations/esper.json
#. ~ Mutation name
msgid "Telepath"
msgstr "Télépathe"

#: data/mods/Aftershock/mutations/esper.json
#: data/mods/MindOverMatter/mutations/traits.json
#: data/mods/aftershock_exoplanet/mutations/esper.json
#. ~ Description of mutation "Telepath"
#. ~ Description of mutation "Awakened Telepath"
msgid "The ability to read thoughts and influence others' minds."
msgstr "La capacité de lire les pensées et d'influencer l'esprit des autres."

#: data/mods/Aftershock/mutations/human_plus.json
#: data/mods/aftershock_exoplanet/mutations/human_plus.json
#. ~ Mutation name
msgid "Genemod: Improved Physical Capability"
msgstr ""

