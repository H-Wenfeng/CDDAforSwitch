msgid_plural "hardened steel battle axes"
msgstr[0] "hache de guerre en acier cémenté"
msgstr[1] "haches de guerre en acier cémenté"
msgstr[2] "haches de guerre en acier cémenté"

#: data/json/items/melee/bludgeons.json
#. ~ Description of "hardened steel battle axe"
