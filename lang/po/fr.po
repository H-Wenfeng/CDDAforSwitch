msgstr "Pollen Affaiblissant"

#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Name of effect type id "effect_arvore_attacked_a_triffid"
msgid "Broken Green Pact "
msgstr ""

#: data/mods/Xedra_Evolved/effects/effects.json
#. ~ Description of effect type "Broken Green Pact "
