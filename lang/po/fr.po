msgid_plural "steel prosthetic left arms"
msgstr[0] "prothèse de bras gauche en acier"
msgstr[1] "prothèses de bras gauche en acier"
msgstr[2] "prothèses de bras gauche en acier"

#: data/mods/Limb_WIP/armor/arm_prosthetics.json
