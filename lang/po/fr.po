msgid "bandage"
msgid_plural "bandages"
msgstr[0] "bandage"
msgstr[1] "bandages"
msgstr[2] "bandages"

#: data/json/items/tool/med.json
#. ~ Description of "bandage"
msgid ""
"A sterile cloth bandage.  Used for stopping blood loss and protecting wounds "
"from aggravation to help them heal faster."
msgstr ""
"Un bandage en tissu stérilisé. Utilisé pour stopper les hémorragies et "
"protéger les plaies des contaminations externes, leurs permettant de guérir "
"plus vite."

#: data/json/items/tool/med.json
#. ~ Item name
