#: data/json/npcs/other/homeless/TALK_homeless_survivor.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_broker.json
#: data/json/npcs/refugee_center/surface_staff/NPC_old_guard_doctor.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_scavenger_mercenary.json
#: data/mods/Aftershock/npcs/cyrus_whately.json
#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/Xedra_Evolved/npc/vampire_mentor.json
#: data/mods/aftershock_exoplanet/npcs/cyrus_whately.json
#: data/mods/aftershock_exoplanet/npcs/milly_whately_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/prepnet_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ Response to NPC dialogue
#. ~ NPC dialogue line
msgid "Who are you?"
msgstr "Qui êtes-vous?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ NPC dialogue line
msgid ""
"Dangerous?  It may look different, but this land cares and provides for us.  "
"We are celebrating with a feast, in fact.  Do you care to join us?"
msgstr ""
"Dangereux ? Cela peut paraître différent, mais cette terre prend soin de nous "
"et subvient à nos besoins. Nous célébrons cela avec un festin, en fait. "
"Voulez-vous vous joindre à nous ?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "Well, sure."
msgstr "Bien sûr."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "I'd… rather not."
msgstr "Je… J'aimerais m'en abstenir."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "I'm sorry… I have places to be."
msgstr "Désolé·e… Je pense que j'ai d'autres affaires à gérer."

#: data/json/npcs/Kindred/NPC_Brigitte_LaCroix.json
#: data/json/npcs/TALK_MARLOSS_VOICE.json
#: data/json/npcs/godco/visitors/TALK_CARAVAN_MERCHANT_PREDATORY.json
#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#: data/json/npcs/isolated_road/isolated_road_jay_dialogue.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_broker.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_group_survivors.json
#: data/json/npcs/robofac/NPC_Cranberry_Foster.json
#. ~ Response to NPC dialogue
msgid "Alright."
msgstr "D'accord."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "Can I join you?"
msgstr "Puis-je me joindre à vous?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "Understood.  Can I join you?"
msgstr "Compris. Puis-je me joindre à vous?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ NPC dialogue line
msgid "Oh, but you already have."
msgstr "Oh, mais vous faites déjà partie de notre groupe."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "Yes… yes I have."
msgstr "Oui… Oui j'en fais déjà partie."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ NPC dialogue line
msgid "Join us then, eat from this meal with us."
msgstr "Rejoignez-nous dans ce cas, et partagez ce repas avec nous."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "[Take Marloss berry.] Thank you."
msgstr "[Prenez la baie de Marloss.] Merci."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "I have changed my mind, thank you."
msgstr "J'ai changé d'avis, non merci."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#. ~ Response to NPC dialogue
msgid "I'm joining no stinking cult!  Take your berry and shove it!"
msgstr "Je ne rejoins aucune secte puante ! Prends ta baie et va la chercher !"

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ Response to NPC dialogue
msgid "One of who?"
msgstr "L'un de qui ?"

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ Response to NPC dialogue
msgid "My thoughts exactly.  We have a lot in common, we should travel together!"
msgstr ""
"C'est exactement ce que je pense. Nous avons beaucoup de points communs, nous "
"devrions voyager ensemble !"

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ Response to NPC dialogue
msgid "A daring trader?  Yes.  Let's trade items."
msgstr "Un·e commerçant·e audacieux·se?  Oui.  Échangeons des objets."

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ Response to NPC dialogue
msgid "It's not safe here anymore, you need to move on."
msgstr "Les choses ne sont plus sûres ici, vous devez reprendre la route."

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ Response to NPC dialogue
msgid "How did you make it?"
msgstr "Comment l'as-tu fait ?"

#: data/json/npcs/TALK_NC_FARMER.json data/json/npcs/TALK_SURVIVOR_CHEF.json
#. ~ Response to NPC dialogue
msgid "What did you do before the Cataclysm?"
msgstr "Qu'est-ce que vous faisiez avant le Cataclysme?"

#: data/json/npcs/TALK_NC_FARMER.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
#. ~ Response to NPC dialogue
msgid "Have anything to trade?"
msgstr "Vous avez quelque chose à échanger?"

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ NPC dialogue line
msgid ""
"One of the nice things about the country life is the troubles of the world "
"take a little longer to reach you, and some don't get you at all.  We didn't "
"see any dead the first day, but we heard all kinds of crazy things on the "
"news."
msgstr ""
"L'un des avantages de la vie à la campagne, c'est que les problèmes du monde "
"mettent un peu plus de temps à vous atteindre, et certains ne vous touchent "
"même pas du tout. Nous n'avons vu aucun mort le premier jour, mais nous avons "
"entendu toutes sortes de choses folles aux informations."

#: data/json/npcs/Backgrounds/hunter_2.json
#: data/json/npcs/Backgrounds/rural_1.json
#: data/json/npcs/Backgrounds/rural_2.json data/json/npcs/TALK_NC_FARMER.json
#: data/json/npcs/TALK_SURVIVOR_CHEF.json
#: data/mods/Aftershock/npcs/Backgrounds/BGRS_migo_2.json
#: data/mods/Aftershock/npcs/Backgrounds/BGRS_migo_3.json
#: data/mods/Xedra_Evolved/npc/draco_dune.json
#: data/mods/aftershock_exoplanet/npcs/Backgrounds/BGRS_migo_2.json
#: data/mods/aftershock_exoplanet/npcs/Backgrounds/BGRS_migo_3.json
#: data/mods/innawood/npcs/Backgrounds/hunter_2.json
#: data/mods/innawood/npcs/Backgrounds/rural_1.json
#: data/mods/innawood/npcs/Backgrounds/rural_2.json
#. ~ Response to NPC dialogue
msgid "What happened next?"
msgstr "Que s'est-il passé ensuite ?"

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ NPC dialogue line
msgid ""
"Come a little closer, I don't want to make too much noise.  You smell much "
"nicer than what I'm used to.  Someone in trouble banged on the door that "
"night, she said she was desperate, she had a baby, her home had burned down "
"and her drugs were gone and there were monsters in the streets.  We figured "
"she was on drugs, but we couldn't turn them away so we gave them food and let "
"them stay in the barn."
msgstr ""
"Approchez-vous un peu, je ne veux pas faire trop de bruit. Vous sentez bien "
"meilleur que ce à quoi je suis habituée. Une personne en difficulté a frappé "
"à la porte cette nuit-là, elle a dit qu'elle était désespérée, qu'elle avait "
"un bébé, que sa maison avait brûlé et que sa drogue avait disparu et qu'il y "
"avait des monstres dans les rues. Nous avons pensé qu'elle était sous "
"l'emprise de la drogue, mais nous ne pouvions pas les renvoyer, alors nous "
"leur avons donné à manger et les avons laissés dans la grange."

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ Response to NPC dialogue
msgid "That's decent, was she all right?"
msgstr "C'est bien, elle allait bien ?"

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ NPC dialogue line
msgid ""
"She was not all right.  I don't know what happened, if she was already "
"turning or if something got in and got her, but she and the baby didn't make "
"it.  We lost some more people trying to figure that out, it was horrible."
msgstr ""
"Elle n'allait pas bien. Je ne sais pas ce qui s'est passé, si elle était déjà "
"en train de se retourner ou si quelque chose l'a attrapée, mais elle et le "
"bébé n'ont pas survécu. Nous avons perdu d'autres personnes qui essayaient de "
"comprendre cela, c'était horrible."

#: data/json/npcs/TALK_NC_FARMER.json
#. ~ Response to NPC dialogue
msgid "Are you all right?"
msgstr "Est-ce que tout va bien?"

#: data/json/npcs/TALK_STRIP_MALL.json
#. ~ Computer name placed on map
msgid "Shady Hills Corporation: Branch Manager"
msgstr "Shady Hills Corporation : Directeur de Succursale"

#: data/json/npcs/TALK_STRIP_MALL.json
#. ~ NPC dialogue line
msgid ""
"Shady Hills Corporation.\n"
" You are logged in as: Branch Manager.\n"
"\n"
"WARNING!  ERROR A101; FAILURE DETECTED IN POWER SUPPLY.\n"
" RESERVE POWER ACTIVATED.  CONTACT INFORMATION TECHNOLOGY DEPARTMENT "
"IMMEDIATELY!"
msgstr ""
"Shady Hills Corporation.\n"
"Vous êtes connecté en tant que : Responsable de succursale.\n"
"\n"
"ATTENTION ! ERREUR A101 ; DÉFAILLANCE DÉTECTÉE DANS L'ALIMENTATION "
"ÉLECTRIQUE.\n"
"RÉSERVE D'ÉNERGIE ACTIVÉE. CONTACTEZ IMMÉDIATEMENT LE SERVICE INFORMATIQUE !"

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_NURSING_HOME.json
#: data/json/npcs/computers/TALK_RET_COMM.json
#. ~ Response to NPC dialogue
msgid "Access Messages"
msgstr "Accéder aux messages"

#: data/json/npcs/TALK_STRIP_MALL.json
#. ~ Response to NPC dialogue
msgid "Access Main Drive"
msgstr "Accéder au disque principal"

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_MSU14.json
#: data/json/npcs/computers/TALK_NURSING_HOME.json
#: data/json/npcs/computers/TALK_PREPPER_1_COMPUTER.json
#: data/json/npcs/computers/TALK_RET_COMM.json
#: data/mods/MindOverMatter/npcs/dialogue/computer_dialogue.json
#. ~ Response to NPC dialogue
msgid "Log Off"
msgstr "Fermer la Session"

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_NURSING_HOME.json
#: data/json/npcs/computers/TALK_RET_COMM.json
#. ~ NPC dialogue line
msgid ""
"WARNING!  ERROR A101; FAILURE DETECTED IN POWER SUPPLY.\n"
" RESERVE POWER ACTIVATED.  CONTACT INFORMATION TECHNOLOGY DEPARTMENT "
"IMMEDIATELY!\n"
"\n"
" WARNING!  ERROR B231; UNABLE TO CONNECT TO MESSAGING SERVER.\n"
" ERROR REFRESHING MESSAGES.  NOT ALL MESSAGES MAY BE DISPLAYED.\n"
" CONTACT INFORMATION TECHNOLOGY DEPARTMENT IMMEDIATELY!"
msgstr ""
"ATTENTION ! ERREUR A101 ; DÉFAILLANCE DÉTECTÉE DANS L'ALIMENTATION "
"ÉLECTRIQUE.\n"
"RÉSERVE D'ÉNERGIE ACTIVÉE. CONTACTEZ IMMÉDIATEMENT LE SERVICE INFORMATIQUE !\n"
"\n"
"ATTENTION ! ERREUR B231 ; IMPOSSIBLE DE SE CONNECTER AU SERVEUR DE "
"MESSAGERIE.\n"
"ERREUR LORS DE L'ACTUALISATION DES MESSAGES. IL EST POSSIBLE QUE TOUS LES "
"MESSAGES NE S'AFFICHENT PAS.\n"
"CONTACTEZ IMMÉDIATEMENT LE SERVICE INFORMATIQUE !"

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_RET_COMM.json
#. ~ Response to NPC dialogue
msgid "[!]RE: Important Status Update"
msgstr "[!]RE : Mise à jour importante sur le statut"

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_NURSING_HOME.json
#: data/json/npcs/computers/TALK_RET_COMM.json
#. ~ Response to NPC dialogue
msgid "RETURN TO MAIN PAGE"
msgstr "RETOUR À LA PAGE PRINCIPALE"

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_RET_COMM.json
#. ~ NPC dialogue line
msgid ""
"FROM: Kristi Gordee, SVP Operations\n"
"  TO: [Branch Managers], [Community Managers]\n"
"  RE: Important Status Update\n"
"\n"
" Everyone,\n"
" You are to follow your appropriate lockdown protocols at your discretion.  "
"With the recent events as they are, we must do our utmost to ensure that our "
"goals remain priority.\n"
"\n"
" Branch Managers - your deliveries will have an altered schedule.  I will "
"send a separate email with details.  Ensure the hidden safe rooms are "
"properly secured.\n"
" Community Managers - Lockdown the community appropriately.  Tell the "
"residents that it is for their protection, but do not let them leave.  We "
"need them for the Big Pappy project to be successful.  I am going to send you "
"some contacts who can discreetly install a heavy security gate.\n"
"\n"
" You will continue to receive your bonus pay as agreed upon.  Do not lose "
"sight of our important endgame."
msgstr ""
"DE : Kristi Gordee, vice-présidente principale des opérations\n"
"À : [Directeurs de succursale], [Responsables de communauté]\n"
"OBJET : Mise à jour importante sur le statut\n"
"\n"
"Tout le monde,\n"
"Vous devez suivre vos protocoles de confinement appropriés à votre "
"discrétion. Compte tenu des événements récents, nous devons faire tout notre "
"possible pour garantir que nos objectifs restent prioritaires.\n"
"\n"
"Directeurs de succursale - vos livraisons auront un calendrier modifié. Je "
"vous enverrai un e-mail séparé avec les détails. Assurez-vous que les salles "
"de sécurité cachées sont correctement sécurisées.\n"
"Directeurs de communauté - Confinez la communauté de manière appropriée. "
"Dites aux résidents que c'est pour leur protection, mais ne les laissez pas "
"partir. Nous avons besoin d'eux pour que le projet Big Pappy réussisse. Je "
"vais vous envoyer des contacts qui peuvent installer discrètement une lourde "
"barrière de sécurité.\n"
"\n"
"Vous continuerez à recevoir votre prime comme convenu. Ne perdez pas de vue "
"notre objectif important."

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_NURSING_HOME.json
#: data/json/npcs/computers/TALK_RET_COMM.json
#. ~ Response to NPC dialogue
msgid "RETURN TO MESSAGES"
msgstr "RETOURNER AUX MESSAGES"

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_NURSING_HOME.json
#: data/json/npcs/computers/TALK_RET_COMM.json
#. ~ NPC dialogue line
msgid "ERROR ACCESSING SERVER"
msgstr "ERREUR SURVENUE EN ACCÉSSANT LE SERVEUR"

#: data/json/npcs/TALK_STRIP_MALL.json
#: data/json/npcs/computers/TALK_NURSING_HOME.json
#. ~ Response to NPC dialogue
msgid "RETURN TO PREVIOUS PAGE"
msgstr "RETOUR À LA PAGE PRÉCÉDENTE"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
#. ~ Response to NPC dialogue
msgid "How are you alive?"
msgstr "Comment êtes vous toujours vivant(e)?"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
#. ~ Response to NPC dialogue
msgid "Horrible.  Did you get any pictures yourself?"
msgstr "Horrible. As-tu pris des photos toi-même ?"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
#. ~ Response to NPC dialogue
msgid "What'd you do?"
msgstr "Qu'est-ce que vous avez fait?"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
#. ~ Response to NPC dialogue
msgid "Crazy, so you have been here ever since?"
msgstr "C'est fou, vous êtes donc ici depuis ce jour ?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Greetings friend, it's nice to see you."
msgstr "Bonjour mon ami(e), enchanté de vous voir."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "What sorcery is this?"
msgstr "Quelle sorcellerie est-ce ceci?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Welcome home Foodkid!"
msgstr "Bienvenue à la maison Foodkid!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Still here?  Take your time, it's rough out there."
msgstr "Toujours là ? Prenez votre temps, c'est difficile."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Greeting citizen, what brings you to the FoodLair?"
msgstr "Bonjour citoyen, qu'est-ce qui vous amène à FoodLair ?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Greetings… Foodperson?"
msgstr "Bonjour… Foodperson?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I am you but from an alternate reality."
msgstr "Je suis vous mais venu(e) d'une réalité alternative."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I am Foodperson, who are YOU?"
msgstr "Je suis Foodperson, qui êtes VOUS?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "There is only one real Foodperson!"
msgstr "Il n'y a qu'un seul vrai Foodperson !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I am the REAL Foodperson!"
msgstr "Je suis le VRAI Foodperson !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid ""
"So, you are a REAL FOODPERSON, right?  You know my <name_g> over there?  You "
"know that you ruined his legacy?"
msgstr ""
"Alors, vous êtes un VRAI FOODPERSON, n'est-ce pas ? Vous connaissez mon "
"<name_g> là-bas ? Vous savez que vous avez ruiné son héritage ?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Nevermind me, I'm just going to leave."
msgstr "Ne vous occupez pas de moi, je vais m'en aller."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Wow!  Such an honor to meet you in person!"
msgstr "C'est un tel honneur de vous rencontrer en personne ! "

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Are you joking?  Foodperson is not real, it's a restaurant mascot!"
msgstr ""
"Vous plaisantez ? Foodperson n'est pas réel, c'est une mascotte de restaurant "
"!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid ""
"The great Foodperson in the flesh!  Such an honor to finally meet you in "
"person!"
msgstr ""
"Le grand Foodperson en chair et en os ! C'est un honneur de vous rencontrer "
"enfin en personne !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Ah… well, nice to meet you Foodperson."
msgstr "Ah… et bien, enchanté·e de vous rencontrer Foodperson."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Do not mock me, for my strength is quite real!  Get out of here now!"
msgstr ""
"Ne vous moquez pas de moi, car ma force est bien réelle ! Sortez d'ici tout "
"de suite !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Sheesh, ok, calm down, I'm leaving!"
msgstr "Sheesh, ok, calmez-vous, je m'en vais !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Forgive me, I didn't mean to disrespect you."
msgstr "Excusez-moi, je ne voulais pas vous manquer de respect."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Oh yeah?  Show me what you can do!"
msgstr "Ah oui ? Montre-moi ce que tu sais faire !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "A common mistake, but I can assure you that I'm very real!"
msgstr "Une erreur courante, mais je peux vous assurer que je suis bien réel !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
#. ~ Response to NPC dialogue
msgid "Sure, whatever."
msgstr "Ok, peu importe."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Ok… I believe you."
msgstr "Ok… Je vous croie."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Anyway, do you need something?"
msgstr "À part ça, vous avez besoin de quelque chose?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Are you interested in some trading?"
msgstr "Vous seriez intéressé(e) à échanger un peu?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Let's trade?"
msgstr "Échangeons?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I'm looking for a place to stay."
msgstr "Je cherche un endroit où vivre."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I want to get stronger.  Please teach me."
msgstr "Je veux devenir plus fort(e). Apprenez-moi."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Please share your knowledge."
msgstr "N'hésitez pas à partager vos connaissances."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I'm building up a team, people with special abilities."
msgstr ""
"Je suis en train de constituer une équipe, composée de personnes dotées de "
"capacités particulières."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Can you tell me again about this sidekick offer?"
msgstr "Pouvez-vous m'en dire plus sur l'offre de cet acolyte? "

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Alright, I thought about this, what do you say about we team up?"
msgstr "D'accord, j'y ai pensé, que dirais-tu de faire équipe ?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I'm good, bye."
msgstr "C'est bon, au revoir."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "I already have everything I need here in the FoodLair!"
msgstr "J'ai déjà tout ce dont j'ai besoin ici, dans le FoodLair !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Alright let's see what you've got."
msgstr "Très bien, voyons ce que vous avez."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "But I am worthy!"
msgstr "Mais je suis digne!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "I can teach you a few tricks."
msgstr "Je peux vous apprendre quelques astuces."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "This is no place for a civilian.  You should go to the refugee center."
msgstr ""
"Ce n'est pas un endroit pour un civil. Vous devriez aller au centre de "
"réfugiés."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Damn!"
msgstr "Wouah !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Well… You seem like a decent sort, I might have an offer for you."
msgstr ""
"Eh bien… Vous semblez être quelqu'un de bien, j'ai peut-être une offre à vous "
"faire."

#: data/json/npcs/Kindred/NPC_Brigitte_LaCroix.json
#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#: data/json/npcs/isolated_road/isolated_road_jay_dialogue.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom.json
#: data/mods/DinoMod/NPC/NC_BO_BARONYX.json
#. ~ Response to NPC dialogue
#. ~ NPC dialogue line
msgid "I'm listening."
msgstr "J'écoute."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Sorry but I work alone."
msgstr "Désolé, mais je travaille seul."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "We could really use your help!"
msgstr "Nous avons vraiment besoin de votre aide !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "That sounds great!"
msgstr "Cela semble très bien !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Ok…"
msgstr "Ok…"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I need to think about it."
msgstr "Je dois y réfléchir."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Huh… no thanks."
msgstr "Euh… non merci."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "There's other things I'd like to discuss."
msgstr "Il y a d'autres choses dont j'aimerais discuter."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Alright bye."
msgstr "D'accord, au revoir."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "The way you talk, the way you move… You're… You're me?  But how?"
msgstr ""
"La façon dont vous parlez, la façon dont vous bougez… Vous êtes… Vous êtes "
"moi?  Mais comment?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid ""
"I… I don't know.  It probably has something to do with <the_cataclysm>!  What "
"do you say we team up to find out?"
msgstr ""
"Je… Je ne sais pas.  Cela a probablement quelque chose à voir avec "
"<le_cataclysme>!  Et si on faisait équipe pour le découvrir?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid ""
"It might have something to do with <the_cataclysm>, mind if I stay here while "
"we try to figure this out?"
msgstr ""
"Cela pourrait avoir un rapport avec <the_cataclysm>, cela vous dérange si je "
"reste ici pendant que nous essayons de le découvrir ?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "This can't be true, you're trying to trick me!"
msgstr "Ce n'est pas possible, vous essayez de me piéger !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I need time to think."
msgstr "J'ai besoin de temps pour réfléchir."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Wha… but.  But… how?"
msgstr "Qu… mais.  Mais… comment?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "No time to explain, the world is at an end and we must join forces to save it!"
msgstr ""
"Pas le temps d'expliquer, le monde est à sa fin et nous devons unir nos "
"forces pour le sauver !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid ""
"The Cataclysm weakened the space-time continuum, I accidentally fell through "
"a tear in reality and ended up here.  I will need access to your resources to "
"keep fighting."
msgstr ""
"Le Cataclysme a affaibli le continuum espace-temps, je suis tombé "
"accidentellement à travers une déchirure de la réalité et j'ai atterri ici. "
"J'aurai besoin d'accéder à vos ressources pour continuer à me battre."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid ""
"I am the ultimate Foodperson, I travel the multiverse consuming powers from "
"all the Foodpersons.  And now I've come for you!"
msgstr ""
"Je suis l'ultime Foodperson, je voyage dans le multivers en consommant les "
"pouvoirs de tous les Foodpersons. Et maintenant, je suis venu pour vous !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Can't tell you now.  In due time all will be revealed."
msgstr "Je ne peux pas vous le dire maintenant. En temps voulu, tout sera révélé."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Of course, whatever you need… Foodperson."
msgstr "Bien sûr, tout ce dont vous avez besoin… Foodperson."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Thank you Foodperson!  It's good to know I have a friend here."
msgstr ""
"Merci à Foodperson ! C'est bon de savoir que j'ai un ami ici.Thank you "
"Foodperson!  It's good to know I have a friend here."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "It's crazy out there, it's going to be a tough journey but I'm with you!"
msgstr ""
"C'est de la folie là-dehors, ça va être un voyage difficile, mais je suis "
"avec vous !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Let's go, we have a world to save!"
msgstr "Allons-y, nous avons un monde à sauver!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "There can be only one!"
msgstr "Il ne peut y en avoir qu'un seul !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I AM THE ONE!"
msgstr "JE SUIS L'UNIQUE!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "Wow, calm down, it's just a prank bro."
msgstr "Wow, calme-toi, c'est juste une blague, mon frère."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "WAIT!  There might be another way!"
msgstr "ATTENDEZ ! Il y a peut-être une autre solution !"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid "I don't want to fight you.  I'm leaving."
msgstr "Je ne veux pas me battre avec vous. Je m'en vais."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ NPC dialogue line
msgid "Umm, I'm not sure I'm following you…"
msgstr "Je ne suis pas sûr de vous suivre…"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#. ~ Response to NPC dialogue
msgid ""
"You know what, <name_b>, I don't want to talk to you anymore.  <kill_npc> "
"<name_b>!"
msgstr "Tu sais quoi, <name_b>, je ne veux plus te parler. <kill_npc> <name_b> !"

#: data/json/npcs/classes.json data/json/npcs/portal_storm/Portal_NPC.json
#. ~ Name of an NPC class
msgid "No class"
msgstr "Pas de classe"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#: data/json/npcs/classes.json
#. ~ Job description of "No class" NPC class
#. ~ Job description of "Fisherman" NPC class
msgid "I'm just wandering."
msgstr "J'ère."

#: data/json/npcs/classes.json
#. ~ Job description of "No class" NPC class
msgid "I'm a dummy class for better NPC items later into the Cataclysm."
msgstr ""
"Je suis une classe factice pour obtenir de meilleurs objets de PNJ plus tard "
"dans le Cataclysme."

#: data/json/npcs/classes.json
#. ~ Name of an NPC class
msgid "Debug Dude"
msgstr "Debug Dude"

#: data/json/npcs/classes.json
#. ~ Job description of "Debug Dude" NPC class
msgid "I'm helping you test the game."
msgstr "Je vous aide à tester le jeu."

#: data/json/npcs/classes.json
#. ~ Name of an NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
msgid "Shopkeep"
msgstr "Marchand"

#: data/json/npcs/classes.json data/json/npcs/godco/classes.json
#: data/json/npcs/militia/GM_Militia_Merchant.json
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_quartermaster.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/NPC_Smokes.json
#: data/json/npcs/scrap_trader/scrap_trader.json
#. ~ Job description of "Shopkeep" NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#. ~ Job description of "Merchant" NPC class
#. ~ Smokes is a firefighter that volunteered to take stock of what was
#. available and keep inventory. He's gradually had more lumped onto him as
#. the Free Merchants struggle to put themselves together, but he feels
#. obligated to help, even though he doesn't really want to have all the
#. responsibility he does.
#. ~ Retained to prevent errors.
msgid "I'm a local shopkeeper."
msgstr "Je suis un vendeur local."

#: data/json/npcs/classes.json data/json/npcs/godco/classes.json
#: data/json/npcs/refugee_center/surface_staff/NPC_old_guard_doctor.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
#. ~ Name of an NPC class
#. ~ Name suffix of an NPC
#. ~ Appears in the refugee center as a source of missions and info.  Faction
#. critical.
#. ~ Provides advanced medical attention.
msgid "Doctor"
msgstr "Docteur"

#: data/json/npcs/classes.json
#: data/json/npcs/refugee_center/surface_staff/NPC_old_guard_doctor.json
#: data/mods/Aftershock/npcs/cyropod_classes.json
#: data/mods/aftershock_exoplanet/npcs/cyropod_classes.json
#. ~ Job description of "Doctor" NPC class
#. ~ Job description of "Veterinarian" NPC class
#. ~ Reasonably, this class should receive animal-specific medical
#. proficiencies if they're ever added.
#. ~ Job description of "Thawed Doctor" NPC class
msgid "I'm looking for wounded to help."
msgstr "Je cherche des blessés pour leur venir en aide."

#: data/json/npcs/classes.json
#. ~ Name of an NPC class
#. ~ Reasonably, this class should receive animal-specific medical
#. proficiencies if they're ever added.
msgid "Veterinarian"
msgstr "Vétérinaire"

#: data/json/npcs/classes.json
#. ~ Name of an NPC class
msgid "Cowboy"
msgstr "Cowboy"

#: data/json/npcs/classes.json
#. ~ Job description of "Cowboy" NPC class
msgid "I'm looking to make an honest living using the skills I gained in the country."
msgstr ""
"Je cherche à gagner honnêtement ma vie en utilisant les compétences que j'ai "
"acquises dans le pays."

#: data/json/npcs/classes.json data/json/npcs/npc.json
#. ~ Name of an NPC class
#. ~ Name suffix of an NPC
#. ~ Generic Marloss Priest who leads pilgrim bands.
msgid "Marloss Voice"
msgstr "Voix de Marloss"

