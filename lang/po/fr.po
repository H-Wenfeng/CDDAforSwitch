msgid_plural "large bone replicas"
msgstr[0] "réplique d'os large"
msgstr[1] "répliques d'os larges"
msgstr[2] "répliques d'os larges"

#: data/json/items/resources/stone.json
#. ~ Description of "large bone replica"
msgid "A plaster replica of a huge bone."
msgstr "Une réplique en plâtre d'un os aux dimensions impressionnantes."

