msgid_plural "Scrolls of Summon Tanglevine"
msgstr[0] "Parchemin d'Invoquer Vignes Enchevêtrées"
msgstr[1] "Parchemins d'Invoquer Vignes Enchevêtrées"
msgstr[2] "Parchemins d'Invoquer Vignes Enchevêtrées"

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Description of "Scroll of Summon Tanglevine"
