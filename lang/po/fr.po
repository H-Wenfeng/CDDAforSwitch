#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Response to NPC dialogue
msgid "Hold still.  *Remove <npc_name>'s muscle jitters*"
msgstr "Restez tranquille. *Retirez les tressaillements de <npc_name>*"

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Player message in an effect
msgid ""
"You touch <npc_name> and reach out with your powers, looking for the illness "
"within them.  You soon find it, a shadow over their limbs, and draw it into "
"yourself."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Response to NPC dialogue
msgid "Hold still.  *Remove <npc_name>'s mood swings*"
msgstr "Restez tranquille. *Remédiez les sautes d'humeur de <npc_name>*"

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Response to NPC dialogue
msgid "Hold still.  *Remove <npc_name>'s weakening sickness*"
msgstr "Restez tranquille. *Traitez l'affaiblissement de <npc_name>*"

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Player message in an effect
msgid ""
"You touch <npc_name> and reach out with your powers, looking for the illness "
"within them.  You soon find it, a shadow over their entire body, and draw it "
"into yourself."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Response to NPC dialogue
msgid "Hold still.  *Remove <npc_name>'s narcolepsy*"
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Response to NPC dialogue
msgid "Hold still.  *Remove <npc_name>'s seasonal allergies*"
msgstr "Restez tranquille.  *Remédiez les allergies saisonnières de <npc_name>*"

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Player message in an effect
msgid ""
"You touch <npc_name> and reach out with your powers, looking for the illness "
"within them.  You soon find it, a shadow over their head and lungs, and draw "
"it into yourself."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Response to NPC dialogue
msgid "Hold still.  *Remove <npc_name>'s seasonal affective disorder*"
msgstr ""
"Restez tranquille.  *Remédiez les troubles affectifs saisonniers de "
"<npc_name>*"

#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Response to NPC dialogue
msgid "Actually, maybe now's not the best time."
msgstr "En fait, peut être que ce n'est pas un bon moment."

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "[Telepathy Check] What are you talking about?  This is mine."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid "Oh, I…I don't know what I was thinking.  I…sorry."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid "It is?  Oh, it…it is.  Right.  Right."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid "I…I thought that…never mind."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid "But you…no, I thought…I just…"
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid "What?  But that's…we've had…how did you…"
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid ""
"*'s weapon flies out of his hands.\n"
"\n"
"\"<freaking> <name_b>!  You some kind of witch?"
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid "*'s weapon flies out of his hands and he lets out a startled yelp."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid ""
"*'s weapon flies out of her hands.\n"
"\n"
"\"<freaking> <name_b>!  You some kind of witch?"
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ NPC dialogue line
msgid "*'s weapon flies out of her hands and she lets out a startled yelp."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "Get out of here before I do worse."
msgstr "Sortez d'ici avant que je fasse quelque chose que je vais peut être regretter."

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "[Far Hand Check] *Try to rip their weapon out of their hands*."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ Player message in an effect
msgid "Your telekinesis attempt failed!"
msgstr "Votre tentative de télékinésie échoue!"

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#: data/mods/MindOverMatter/npcs/dialogue/refugee_guards_traitor.json
#. ~ Response to NPC dialogue
msgid "[Brilliant Flash Check] *blind <npc_name>*"
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ Player message in an effect
msgid "<npc_name> looks away as the air erupts in a burst of light!"
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "[Mood Stablization Check] You don't want to hurt me."
msgstr ""

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
#: data/mods/MindOverMatter/npcs/dialogue/refugee_guards_traitor.json
#. ~ Player message in an effect
msgid "Your telepathy attempt failed!"
msgstr "Votre tentative de télépathie échoue!"

#: data/mods/MindOverMatter/npcs/dialogue/generic_dialogue.json
