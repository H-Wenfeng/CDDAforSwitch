msgstr[1] "Lianes noueuses"
msgstr[2] "Lianes noueuses"

#: data/json/monsters/triffid.json
#. ~ Description of monster "creeper hub"
msgid ""
"A thick stalk, rooted to the ground.  It rapidly sprouts thorny vines in all "
"directions."
msgstr ""
"Une tige épaisse, enracinée dans le sol. Elle pousse rapidement des lianes "
"épineuses dans toutes les directions."

#: data/json/monsters/triffid.json
#. ~ Monster name
msgid "creeper vine"
msgid_plural "creeper vines"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/monsters/triffid.json
#. ~ Description of monster "creeper vine"
msgid "A thorny vine, twisting wildly as it grows with incredible speed."
msgstr ""
"Une vigne épineuse, qui se tortille sauvagement en poussant à une vitesse "
