msgstr[1] "branches de pin"
msgstr[2] "branches de pin"

#: data/json/items/generic.json
#. ~ Description of "pine bough"
msgid ""
"A branch from a pine tree, oozing sticky sap and bristling with prickly "
"needles."
msgstr "Une branche de sapin, suintant de la sève collante et aux épines hérissées."

#: data/json/items/generic.json
#. ~ Item name
