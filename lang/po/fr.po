msgstr[1] "morceaux de plastique"
msgstr[2] "morceaux de plastique"

#: data/json/items/resources/plastic.json
#. ~ Description of "plastic chunk"
msgid ""
"A piece of plastic.  It could be used to fabricate, repair, or reinforce "
"plastic items."
msgstr ""
"Un morceau de plastique.  Vous pourriez l'utiliser pour fabriquer, réparer ou "
"renforcer une vaste sélection d'objets."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "synthetic fabric patch"
msgid_plural "synthetic fabric patches"
msgstr[0] "carré de textile synthétique"
msgstr[1] "carrés de textile synthétique"
msgstr[2] "carrés de textile synthétique"

#: data/json/items/resources/plastic.json
#. ~ Description of "synthetic fabric patch"
msgid ""
"A six-inch square patch of synthetic fabric.  Unlike you and other natural "
"materials, it won't degrade much with age.  Maybe that's less of a bad thing "
"now."
msgstr ""
"Une pièce de tissu synthétique d'un carré de 15 cm de côté. Contrairement à "
"vous et à d'autres matériaux naturels, il ne se dégrade pas beaucoup avec "
"l'âge. C'est peut-être moins grave aujourd'hui."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "Lycra patch"
msgid_plural "Lycra patches"
msgstr[0] "carré de Lycra"
msgstr[1] "carrés de Lycra"
msgstr[2] "carrés de Lycra"

#: data/json/items/resources/plastic.json
#. ~ Description of "Lycra patch"
msgid ""
"A six-inch square patch of synthetic fabric blended with stretchy Lycra "
"fibers.  It could be used to make flexible yet strong clothing.  Stylish, but "
"bad for the environment; at least you're recycling it."
msgstr ""
"Il s'agit d'une pièce de tissu synthétique de 15 cm de côté, mélangée à des "
"fibres Lycra extensibles. Il pourrait être utilisé pour fabriquer des "
"vêtements à la fois souples et résistants. C'est élégant, mais c'est mauvais "
"pour l'environnement ; au moins, vous le recyclez."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "large plastic sheet"
msgid_plural "large plastic sheets"
msgstr[0] "grande bâche en plastique"
msgstr[1] "grandes bâches en plastique"
msgstr[2] "grandes bâches en plastique"

#: data/json/items/resources/plastic.json
#. ~ Description of "large plastic sheet"
msgid ""
"A large sheet of flexible plastic, the sort that might have been used for "
"commercial wrapping or for weather-sealing a home."
msgstr ""
"Une grande feuille de plastique souple, du type de celles utilisées pour "
"l'emballage commercial ou l'étanchéité d'une maison."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "plastic sheet"
msgid_plural "plastic sheets"
msgstr[0] "bâche en plastique"
msgstr[1] "bâches en plastique"
msgstr[2] "bâches en plastique"

#: data/json/items/resources/plastic.json
#. ~ Description of "plastic sheet"
msgid ""
"A small sheet of flexible plastic, like a cut-up garbage bag.  It might be "
"useful for waterproofing clothes."
msgstr ""
"Une petite feuille de plastique souple, comme un sac poubelle découpé. Elle "
"peut être utile pour imperméabiliser les vêtements."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "polycarbonate sheet"
msgid_plural "polycarbonate sheets"
msgstr[0] "pièce de polycarbonate"
msgstr[1] "pièces de polycarbonate"
msgstr[2] "pièces de polycarbonate"

#: data/json/items/resources/plastic.json
#. ~ Description of "polycarbonate sheet"
msgid ""
"A polycarbonate sheet that can be used for, among other things, vacuum "
"molding."
msgstr ""
"Feuille de polycarbonate qui peut être utilisée, entre autres, pour le "
"moulage sous vide."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "rigid plastic sheet"
msgid_plural "rigid plastic sheets"
msgstr[0] "pièce de plastique rigide"
msgstr[1] "pièces de plastique rigide"
msgstr[2] "pièces de plastique rigide"

#: data/json/items/resources/plastic.json
#. ~ Description of "rigid plastic sheet"
msgid ""
"A large, rigid sheet of transparent polycarbonate, useful for all manner of "
"things; from construction to art, or even amateur snowboarding."
msgstr ""
"Une grande feuille rigide de polycarbonate transparent, utile pour toutes "
"sortes de choses, de la construction à l'art, ou même au snowboard amateur."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "panoramic lens"
msgid_plural "panoramic lenses"
msgstr[0] "lentille panoramique"
msgstr[1] "lentilles panoramiques"
msgstr[2] "lentilles panoramiques"

#: data/json/items/resources/plastic.json
#. ~ Description of "panoramic lens"
msgid ""
"A relatively broad strip of chemical and impact-resistant polycarbonate "
"plastic, most commonly used for the construction of wide-view visors and "
"single-element eye pieces that offer maximal vision."
msgstr ""
"Bande relativement large de plastique polycarbonate résistant aux produits "
"chimiques et aux chocs, utilisée le plus souvent pour la construction de "
"visières à large champ de vision et d'oculaires à élément unique offrant une "
"vision maximale."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "inhalation valve"
msgid_plural "inhalation valves"
msgstr[0] "valve d'inhalation"
msgstr[1] "valves d'inhalation"
msgstr[2] "valves d'inhalation"

#: data/json/items/resources/plastic.json
#. ~ Description of "inhalation valve"
msgid ""
"An essential component of any gas mask, this is a small one-way valve that "
"allows purified air to pass from a gas respirator's filter element to the "
"mask's interior, delivering safe, breathable air to one's lungs."
msgstr ""
"Composante essentielle de tout masque à gaz, il s'agit d'une petite valve "
"unidirectionnelle qui permet à l'air purifié de passer de l'élément filtrant "
"d'un respirateur à gaz à l'intérieur du masque, délivrant ainsi de l'air sûr "
"et respirable aux poumons."

#: data/json/items/resources/plastic.json
#. ~ Item name
msgid "40mm filter port"
msgid_plural "40mm filter ports"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/plastic.json
#. ~ Description of "40mm filter port"
msgid ""
"A compact plastic and metal housing with a threaded exterior, designed to "
"retain a screwed-on 40-mm canister filter and allow the airtight passage of "
"air from the filter media to a gas mask's inhalation valve."
msgstr ""
"Boîtier compact en plastique et en métal avec un extérieur fileté, conçu pour "
"retenir une cartouche filtrante de 40 mm vissée et permettre le passage "
"étanche de l'air du média filtrant vers la soupape d'inhalation d'un masque à "
"gaz."

#: data/json/items/resources/stone.json
#. ~ Item name
msgid "flaking rock"
msgid_plural "flaking rocks"
msgstr[0] "pierre de taille"
msgstr[1] "pierres de taille"
msgstr[2] "pierres de taille"

#: data/json/items/resources/stone.json
#. ~ Description of "flaking rock"
msgid ""
"A rock the size of a baseball which chips in a semi-predictable way if "
"struck, leaving a sharp edge.  Makes a decent melee weapon, and is also good "
"for throwing at enemies."
msgstr ""
"Un caillou de la taille d'une balle de baseball qui s'ébrèche de façon "
"semi-prévisible lorsqu'il est frappé, laissant une arête tranchante. Il "
"constitue une bonne arme de mêlée et peut également être lancé sur les "
"ennemis."

#: data/json/items/resources/stone.json
#. ~ Item name
msgid "flint"
msgid_plural "flints"
msgstr[0] "silex"
msgstr[1] "silex"
msgstr[2] "silex"

#: data/json/items/resources/stone.json
#. ~ Description of "flint"
msgid ""
"A chunk of flint, the kind of rock that can make sparks if stuck against "
"high-carbon steel.  It also chips in a semi-predictable way if struck, "
"leaving a sharp edge."
msgstr ""
"Un morceau de silex, un type de pierre capable de produire des étincelles "
"quand il est frappé contre un morceau d'acier à haut carbone. Le silex peut "
"aussi être taillé plutôt facilement pour une tête d'outil ou d'arme en pierre."

#: data/json/items/resources/stone.json
#. ~ Item name
msgid "field stone"
msgid_plural "field stones"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/stone.json
#. ~ Description of "field stone"
msgid ""
"A medium, flatish, heavy rock, big enough and flat enough to be used as a "
"block in field stone walls."
msgstr ""
"Un rocher moyen, plat et lourd, suffisamment grand et plat pour être utilisé "
"comme bloc dans les murs en pierre de taille."

#: data/json/items/resources/stone.json
#. ~ Item name
msgid "large rock"
msgid_plural "large rocks"
msgstr[0] "grosse pierre"
msgstr[1] "grosses pierres"
msgstr[2] "grosses pierres"

#: data/json/items/resources/stone.json
#. ~ Description of "large rock"
msgid ""
"A large, heavy rock, big enough to be used as a primitive anvil or shaped "
"into larger stone items."
msgstr ""
"Un gros rocher lourd, suffisamment grand pour être utilisé comme enclume "
"primitive ou pour être façonné en objets de pierre plus grands."

#: data/json/items/resources/stone.json
#. ~ Item name
msgid "fiber insulation batt"
msgid_plural "fiber insulation batts"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/stone.json
#. ~ Description of "fiber insulation batt"
msgid ""
"A foil-wrapped batt of fibrous insulation; fire- and moisture-resistant, it's "
"used for hot appliances like dishwashers and ovens."
msgstr ""
"Il s'agit d'un matelas d'isolation fibreuse enveloppé d'une feuille "
"d'aluminium. Résistant au feu et à l'humidité, il est utilisé pour les "
"appareils chauds tels que les lave-vaisselle et les fours."

#: data/json/items/resources/stone.json
#. ~ Item name
msgid "bone replica"
msgid_plural "bone replicas"
msgstr[0] "réplique d'os"
msgstr[1] "répliques d'os"
msgstr[2] "répliques d'os"

#: data/json/items/resources/stone.json
#. ~ Description of "bone replica"
msgid "A plaster replica of a bone."
msgstr "Une réplique en plâtre d'un os."

#: data/json/items/resources/stone.json
#. ~ Item name
