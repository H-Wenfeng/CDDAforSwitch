msgstr "(sur votre personne et dans les environs)"

#: src/craft_command.cpp:146
#, c-format
msgid ""
"You don't have enough charges to complete the %s.\n"
"Start crafting anyway?"
msgstr ""
"Vous ne possédez pas assez de charges pour compléter le/la %s.\n"
"Voulez-vous commencer à travailler tout de même?"

#: src/craft_command.cpp:151
msgid "You don't have the required proficiencies to craft this!"
msgstr "Vous ne possédez pas les aptitudes requises pour fabriquer ceci!"

#: src/craft_command.cpp:162
msgid ""
"This craft will use rotten components.\n"
"Start crafting anyway?"
msgstr ""
"Ce projet utilisera des composants pourris.\n"
"Voulez-vous commencer à travailler tout de même?"

#: src/craft_command.cpp:171
msgid ""
"This craft will use favorited components.\n"
"Start crafting anyway?"
msgstr ""
"Ce projet utilisera des composants ayant été favorisés.\n"
"Voulez-vous commencer à travailler tout de même?"

#: src/craft_command.cpp:243
msgid "Some components used previously are missing.  Continue?"
msgstr ""
"Certains ingrédients utilisés précédemment ne sont plus disponibles. "
"Voulez-vous continuer?"

#: src/craft_command.cpp:247
msgid "Item(s): "
msgstr "Objet(s):"

#: src/craft_command.cpp:253
msgid "Tool(s): "
msgstr "Outil(s):"

#: src/craft_command.cpp:278
#, c-format
