#: data/json/npcs/other/TALK_NPC_CAMPER.json
#: data/json/npcs/other/TALK_shelter_survivors.json
#: data/json/npcs/other/homeless/TALK_homeless_survivor.json
#: data/mods/Defense_Mode/dialogue/TALK_WANDERING_SURVIVOR.json
#. ~ Response to NPC dialogue
msgid "Care to trade?"
msgstr "Tu veux faire du troc?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Has anyone come recently?"
msgstr "Quelqu'un est arrivé récemment ?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ NPC dialogue line
msgid ""
"I'm just a simple man from a simple family.  Before <the_cataclysm> I had a "
"fishing boat, and I went to sea on it, to catch fish and other marine life.  "
"This is how my grandfather lived, my father lived, and I began to live like "
"that.  I had a large family, 7 children, but not many survived, only my wife "
"and daughter remained…"
msgstr ""

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ NPC dialogue line
msgid ""
"You know, pretty good.  It is cozy here, there is a lot of space, and most "
"importantly, it's safe.  We even started considering this place as our new "
"home.  By the way, while I was fishing, a bottle with a piece of paper came "
"to the shore of our island.  Here, take a look.\", he gave you a piece of "
"paper, something was written on it: '0030045-0030045-35321700', with "
"something similar to lightning scribbled nearby.  \"I wonder what it could "
"mean…"
msgstr ""

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ NPC dialogue line
msgid "Good news, <name_g>.  One survivor sailed to us recently."
msgstr "Bonne nouvelle, <name_g>. Un survivant est arrivé jusqu'à nous il y a peu."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ NPC dialogue line
msgid ""
"Nobody came, <name_g>.  I'm beginning to doubt that anyone else has survived "
"besides us…"
msgstr ""
"Personne n'est arrivé, <name_g>.  Je commence à croire que personne d'autre "
"n'ai survécu à part nous…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#: data/json/npcs/other/meteorologist.json
#. ~ NPC dialogue line
msgid "Are we there yet, <name_g>?"
msgstr "Est-ce qu'on y est, <name_g>?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Almost."
msgstr "Presque."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ NPC dialogue line
msgid "Is it safe, my <name_g>?"
msgstr "Est-ce que c'est sûr, mon/ma <name_g>?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Yes.  Ground floor is clear."
msgstr "Oui, le rez-de-chaussé est dégagé."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Yes.  First floor is clear."
msgstr "Oui, le premier étage est dégagé."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Yes.  Second floor is clear."
msgstr "Oui, le deuxième étage est dégagé."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Yes.  Third floor is clear."
msgstr "Oui, le troisième étage a été vidé."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Yes.  Fourth floor is clear."
msgstr "Oui, le quatrième étage est dégagé."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Yes.  Top floor is clear."
msgstr "Oui, le dernier étage est dégagé."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#: data/json/npcs/snippets/talk_tags_combat.json
#. ~ Response to NPC dialogue
#. ~ Snippet in category "<its_safe>"
#. ~ NPC complaint when the danger level drops from significant to very low,
#. so things are 'safe'
msgid "Looks like that's over."
msgstr "On dirait que c'est fini."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Not yet."
msgstr "Pas encore."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ NPC dialogue line
msgid "<its_safe>  Let's clean the next floor."
msgstr "<its_safe>, allons nettoyer l'étage suivant."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ NPC dialogue line
msgid "<its_safe>  Let's return to the first floor."
msgstr "<its_safe> Retournons au premier étage."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "We did it.  All safe."
msgstr "On a réussit. Tout est sûr."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "I'm sorry, I failed you… I couldn't bring them alive…"
msgstr ""

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "I'm sorry, I failed you… I couldn't bring your wife alive…"
msgstr ""

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "I'm sorry, I failed you… I couldn't bring your daughter alive…"
msgstr ""

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Response to NPC dialogue
msgid "Nothing, really."
msgstr "Pas grand chose vraiment."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ NPC dialogue line
msgid ""
"<name_g>… I entrusted you with the most valuable thing that I have left, and "
"you…"
msgstr "<name_g>… Je vous ai confié ce que j'avais de plus cher au monde, et vous…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Mission name
msgid "Lighthouse"
msgstr "Phare"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Description of mission "Lighthouse"
msgid "Lead Mikhail to lighthouse."
msgstr "Conduisez Mikhail au phare."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Lighthouse"
msgid ""
"We've been wandering around the state with my family for a long time since "
"<the_cataclysm>, and I realized that the safest hideout is the island.  I "
"left my family in a shelter, and went to explore the area, looking for some "
"island nearby, in a lake or in the ocean.  And you know, I found a sea map "
"marked with navigational beacons near here.  If you want, you can help me get "
"to one of these and take a good look at it."
msgstr ""
"Cela fait longtemps que nous errons dans le pays avec ma famille, et j'ai "
"compris que la meilleure cachette était une île. J'ai laissé ma famille dans "
"un abri et je suis parti explorer la région, à la recherche d'une île proche, "
"dans un lac ou dans l'océan. Et vous savez, j'ai trouvé une carte maritime "
"avec des balises de navigation près d'ici. Si vous voulez, vous pouvez "
"m'aider à atteindre l'une d'entre elles et à l'examiner de près."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Lighthouse"
msgid "Good.  I'll be right behind you."
msgstr "Bien. Je serai juste derrière toi."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Lighthouse"
#. ~ Dialogue line in mission "House cleaning"
#. ~ Dialogue line in mission "Fisherman's family"
#. ~ Dialogue line in mission "Fisherman's boat"
#. ~ Dialogue line in mission "Fixing lighthouse"
msgid "Well, it's your choice."
msgstr "Eh bien, c'est ton choix."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Lighthouse"
msgid "First we need to find a transport to get there."
msgstr "Pour commencer nous devons trouver un moyen de transport pour y arriver."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Lighthouse"
msgid "We finally reached it."
msgstr "On l'a finalement atteint."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Lighthouse"
msgid "Looks nice, <name_g>.  Now I need to clean it from <zombies> somehow…"
msgstr ""
"Ça à l'air bien, <name_g>.  Maintenant on doit trouver un moyen de se "
"débarrasser des <zombies>…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Mission name
msgid "House cleaning"
msgstr "Nettoyage de la maison."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Description of mission "House cleaning"
msgid "Clean lighthouse from <zombies> with Mikhail."
msgstr "Nettoyez le phare de ses <zombies>avec Mikhail."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "House cleaning"
msgid ""
"So, we found the lighthouse.  Now, I need to clean it.  Want to help me with "
"it?"
msgstr ""
"Donc, nous avons trouvé le phare. Maintenant nous avons besoin de nous "
"débarrasser de ce qu'il y a à l'intérieur. Vous voulez m'aider?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "House cleaning"
msgid ""
"Great.  Let's do it together.  I'll be right behind you.  We will clean floor "
"by floor.  If you decide that the floor is clean, tell me about it, and we "
"will move on to the next, and so on to the very top."
msgstr ""
"Super. Faisons-le ensemble. Je serai juste derrière vous. Nous nettoierons "
"étage par étage. Si vous décidez que l'étage est propre, dites-le-moi, et "
"nous passerons au suivant, et ainsi de suite jusqu'au sommet."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "House cleaning"
msgid "Be careful.  These <name_b>s are most dangerous in tight spaces."
msgstr ""

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "House cleaning"
msgid "<its_safe>"
msgstr "<its_safe>"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "House cleaning"
msgid "Great, incredibly great.  All that remains is to wash all the floors…"
msgstr ""

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Mission name
msgid "Fisherman's family"
msgstr "Famille du pêcheur"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Description of mission "Fisherman's family"
msgid "Mikhail asked you to bring back his family."
msgstr "Mikhail vous demande de ramener sa famille."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fisherman's family"
msgid ""
"We found the lighthouse and cleared it of <zombies>.  Now, I need to bring my "
"family here.  May I ask you for a favor?  Since you bring me here, can you go "
"back, find my family and bring them here?"
msgstr ""
"Nous avons trouvé le phare et l'avons débarrassé des zombies.  Maintenant, je "
"dois amener ma famille ici. Je peux vous demander une faveur ? Puisque vous "
"m'avez amené ici, pouvez-vous y retourner, trouver ma famille et les "
"rapatrier ici ?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fisherman's family"
msgid ""
"You are my savior!  I'll take a look around here for a while, prepare "
"everything here for their arrival."
msgstr ""
"Vous êtes ma sauveuse/mon sauveur ! Je vais jeter un coup d'œil par ici "
"pendant un moment, préparer tout ici pour leur arrivée."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fisherman's family"
msgid "Please be very careful.  I don't want to lose them…"
msgstr "S'il-vous plait soyez vraiment prudent.  Je ne veux pas les perdre…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fisherman's family"
msgid "I don't even know how to thank you, <name_g>.  I am in eternal debt to you."
msgstr ""
"Je ne sais même pas comment vous remercier, <name_g>. Je vous suis "
"éternellement reconnaissant."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Mission name
msgid "Fisherman's boat"
msgstr "Bateau du pêcheur"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Description of mission "Fisherman's boat"
msgid "Help Mikhail make a boat.  Bring 250 nails."
msgstr "Aidez Mikhail a construire un bateau. Ramenez 250 clous."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fisherman's boat"
msgid ""
"The building has been cleared of <zombies>, my family is here, everything is "
"going very well.  It remains only to provide ourselves with food, transport "
"and we can not worry about the future.  You helped me and my family so much, "
"can you help us with something else?  I need a boat for fishing, or just to "
"explore the area.  Can you help me make a boat?"
msgstr ""
"Le bâtiment a été débarrassé des zombies, ma famille est là, tout se passe "
"très bien. Il ne reste plus qu'à se procurer de la nourriture, un moyen de "
"transport et nous n'aurons plus à nous inquiéter de l'avenir. Vous nous avez "
"tellement aidés, moi et ma famille, pouvez-vous nous aider pour autre chose ? "
"J'ai besoin d'un bateau pour pêcher, ou simplement pour explorer la région. "
"Pouvez-vous m'aider à fabriquer un bateau ?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fisherman's boat"
msgid ""
"Thank you, <name_g>.  I need only 250 nails.  I'll find the planks, the rest "
"of the tools too, but the main problem is the nails.  Too much for one boat, "
"but I want to have resources in reserve, just in case."
msgstr ""
"Merci, <name_g>. Je n'ai besoin que de 250 clous. Je trouverai les planches, "
"le reste des outils aussi, mais le principal problème, ce sont les clous. "
"C'est trop pour un seul bateau, mais je veux avoir des ressources en réserve, "
"juste au cas où."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fisherman's boat"
msgid "Please, if you can, don't disassemble furniture here.  It can still be useful."
msgstr ""
"S'il vous plaît, si vous le pouvez, ne démontez pas les meubles ici. Ils "
"peuvent encore être utiles."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#: data/mods/Xedra_Evolved/npc/npc_vampiresacrifice_chat.json
#. ~ Dialogue line in mission "Fisherman's boat"
#. ~ Dialogue line in mission "Help me find my favorite book.  Apocalypse Now"
#. ~ Dialogue line in mission "Help me find my favorite book.  Brave New
#. World."
#. ~ Dialogue line in mission "Help me find my favorite book.  Cat's Cradle."
#. ~ Dialogue line in mission "Help me find my favorite game.  Pathogen"
#. ~ Dialogue line in mission "Help me find my favorite game.  Steam Gears"
#. ~ Dialogue line in mission "Help me find my favorite game.  Terraforming
#. Mercury"
msgid "Did you find it?"
msgstr "Vous avez trouvé ce que je vous ai demandé?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fisherman's boat"
msgid ""
"Very good, <name_g>, thank you!  Now we are not afraid of hunger, rain, or "
"other bad weather, he-he.  By the way, I have a small supply of fish, tackle, "
"baits and rods.  If you are interested, I can share some with you."
msgstr ""

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Mission name
msgid "Fixing lighthouse"
msgstr "Réparez le phare"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Description of mission "Fixing lighthouse"
msgid ""
"Mikhail asked you to find someone, who have enough expertise to fix the "
"mechanism of lighthouse."
msgstr ""
"Mikhail vous a demandé de trouver quelqu'un(e) qui a suffisamment d'expertise "
"pour réparer le mécanisme du phare."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fixing lighthouse"
msgid ""
"My family is here, we have food, water, boat and a roof over our heads, all "
"thanks to you, <name_g>.  Now, I also want to help other survivors.  Here's "
"what I thought: if I can get this old lighthouse up and running, other "
"survivors will see its light from afar.  If they see it, they will think that "
"there are living people here, and will try to get here.  Can you help me fix "
"it?"
msgstr ""
"Ma famille est ici, nous avons de la nourriture, de l'eau, un bateau et un "
"toit au-dessus de nos têtes, tout cela grâce à vous, <name_g>. Maintenant, je "
"veux aussi aider d'autres survivants. Voici ce que j'ai pensé : si je peux "
"remettre ce vieux phare en marche, d'autres survivants verront sa lumière de "
"loin. S'ils la voient, ils penseront qu'il y a des gens vivants ici, et ils "
"essaieront de venir. Pouvez-vous m'aider à le réparer ?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fixing lighthouse"
msgid ""
"I knew you wouldn't refuse!  But there is one problem: I have no idea how to "
"fix it.  Maybe if you met someone who have experience in electrical "
"engineering, we can figure out how to start this old junk."
msgstr ""
"Je savais que vous ne refuseriez pas ! Mais il y a un problème : je n'ai "
"aucune idée de comment le réparer. Peut-être que si tu rencontrais quelqu'un "
"qui a de l'expérience dans l'ingénierie électrique, nous pourrions trouver "
"comment faire fonctionner cette vieille machine."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fixing lighthouse"
msgid ""
"I'm sure that not all burned in flames of <the_cataclysm> and you can find "
"someone suitable."
msgstr ""
"Je suis sûre que tout n'a pas brûlé dans les flammes de <the_cataclysm> et "
"que vous pourrez trouver quelqu'un qui fera l'affaire."

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fixing lighthouse"
msgid "Well, have you fixed it?"
msgstr "Donc, vous l'avez réparé?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#. ~ Dialogue line in mission "Fixing lighthouse"
msgid "Splendid, <name_g>!  We can only wait now…"
msgstr "Splendide, <name_g>!  Il ne reste plus qu'à attendre maintenant…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#. ~ Unique name of a female NPC
msgid "Heather Frolova"
msgstr "Heather Frolova"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#. ~ NPC dialogue line
msgid "I'm scared.  Where is my husband?"
msgstr "J'ai peur. Où est mon mari?"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#. ~ NPC dialogue line
msgid ""
"Thank you for saving me.  It's a shame my Angelina didn't make it… you did "
"everything you could, and I don't blame you for it…"
msgstr ""
"Merci de m'avoir sauvé.  C'est triste que mon Angelina n'ait pas survécu… "
"mais vous avez fait tout ce que vous pouviez, et je ne vous en veux pas…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#. ~ NPC dialogue line
msgid "Poor, poor Angelina…"
msgstr "Pauvre, pauvre Angelina…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#. ~ NPC dialogue line
msgid ""
"I don't have much to tell, sorry.  I'm busy with tiding this place, making it "
"our new home.  You should talk to my husband, he doesn't look busy right now. "
" Or always…"
msgstr ""
"Je n'ai pas grand-chose à raconter, désolée.  Je m'occupe d'aménager cet "
"endroit, d'en faire notre nouvelle maison.  Vous devriez parler à mon mari, "
"il n'a pas l'air très occupé en ce moment.  Ou jamais…"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#. ~ Mission name
msgid "Protect fisherman's wife"
msgstr "Protégez la femme du pêcheur"

#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#. ~ Description of mission "Protect fisherman's wife"
msgid "She looks like a nice woman.  Maybe you should not let her die?"
msgstr ""
"Elle a l'air d'une femme sympa. Peut-être vous ne devriez pas la laisser "
"mourir ?"

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ Response to NPC dialogue
msgid "You said that you have experience in electrical engineering…"
msgstr "Vous aviez dit que vous aviez des connaissances en ingénierie électrique…"

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ NPC dialogue line
msgid "I did, actually.  Why are you asking?"
msgstr "Je l'ai fait, en fait. Pourquoi cette question ?"

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ Response to NPC dialogue
msgid "We're here.  Ready to start?"
msgstr "Nous sommes là. Prêt à commencer ?"

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ Response to NPC dialogue
msgid "Can you repair the mechanism of the lighthouse?"
msgstr "Pouvez-vous réparer le mécanisme du phare ?"

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ NPC dialogue line
msgid "Sure thing, boss.  Take me there and in a few days it will be like new."
msgstr "Bien sûr Boss. Emmenez-moi là et dans quelques jours ça sera comme neuf."

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ NPC dialogue line
msgid "Hmm, looks shitty.  I'll do my best."
msgstr "Hmmm, ça a l'air pourri. Je vais faire de mon mieux."

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ Response to NPC dialogue
msgid "Start working."
msgstr "Commencez à travailler."

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ NPC dialogue line
msgid "All done, boss.  Tell that fisherman to try it in action."
msgstr "C'est fait, patron.  Dites à ce pêcheur de l'essayer."

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ NPC dialogue line
msgid "I'm still working, boss."
msgstr "Je suis toujours en train de travailler boss."

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ Affirmative response to NPC dialogue
msgid "Thanks for wasting my time, <name_b>.  <end_talking>"
msgstr "Merci d'avoir gaspillé mon temps, <name_b>. <end_talking>"

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#. ~ Negative response to NPC dialogue
msgid "We're done here.  <end_talking>"
msgstr "On en a terminé ici. <end_talking>"

#: data/json/npcs/Lighthouse_Family/TALK_fix_lighthouse.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_missions.json
#: data/mods/MindOverMatter/npcs/dialogue/refugee_guards_traitor.json
#. ~ Response to NPC dialogue
msgid "Good."
msgstr "Bien."

#: data/json/npcs/Lighthouse_Family/npc_survivor.json
#. ~ NPC dialogue line
msgid "Hello!  Glad to meet another survivor."
msgstr "Bonjour!  Ça fait du bien de rencontrer un autre survivant."

#: data/json/npcs/Lighthouse_Family/npc_survivor.json
#. ~ Response to NPC dialogue
msgid "Me too.  How did you manage to get here?"
msgstr "Moi aussi. Comment avez-vous fait pour arriver ici ?"

#: data/json/npcs/Lighthouse_Family/npc_survivor.json
#. ~ Response to NPC dialogue
msgid "I'm glad you are OK."
msgstr "Je suis content(e) que vous soyez ok."

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ NPC dialogue line
msgid "Heya, scav."
msgstr "Hey, mec."

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "Did you build this place?"
msgstr "Vous avez construit cet endroit?"

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "Why do you still use cash?"
msgstr "Pourquoi utilisez-vous toujours du cash ?"

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "You're a trader?"
msgstr "T'es un marchand?"

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "I need some supplies."
msgstr "J'ai besoin de provisions."

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "Need help with anything?"
msgstr "Besoin d'aide avec quelque chose?"

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#: data/json/npcs/refugee_center/surface_refugees/NPC_Boris_Borichenko.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/mods/Sky_Island/dialog_statue.json
#. ~ Response to NPC dialogue
#. ~ Dialogue line in mission "Bring Boris a circular saw."
#. ~ Dialogue line in mission "Bring Boris his son's lost writing."
msgid "I see…"
msgstr "Je vois…"

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ NPC dialogue line
msgid ""
"Why not?  Everyone else does, so I suppose that's all that matters.  My ATM "
"over there still works, connected to the bank servers and everything."
msgstr ""
"Pourquoi pas ? Tout le monde le fait, alors je suppose que c'est tout ce qui "
"compte. Mon distributeur de billets là-bas fonctionne toujours, il est "
"connecté aux serveurs de la banque et tout."

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "Hmm…"
msgstr "Hmm…"

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ NPC dialogue line
msgid ""
"I suppose I am.  Scavs like you need supplies, right?  And I could always use "
"more money."
msgstr ""
"Je suppose que oui. Les pilleurs comme toi ont besoin de provisions, n'est-ce "
"pas ? Et je pourrais toujours utiliser plus d'argent."

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "Alright…"
msgstr "D'accord…"

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ NPC dialogue line
msgid "Not at the moment, check back later perhaps."
msgstr "Pas pour le moment, reviens plus tard peut-être."

#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#. ~ Response to NPC dialogue
msgid "Sure…"
msgstr "Ok…"

#: data/json/npcs/bunker_shop/classes.json data/json/npcs/bunker_shop/npc.json
#: data/json/npcs/godco/classes.json
#: data/json/npcs/militia/GM_Militia_Merchant.json
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_quartermaster.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/NPC_Smokes.json
#: data/json/npcs/scrap_trader/scrap_trader.json
#: data/mods/Defense_Mode/npcs.json
#. ~ Name of an NPC class
#. ~ Name suffix of an NPC
#. ~ Name suffix of a male NPC
#. ~ Appears in the refugee center as shopkeeper with missions.  Faction
#. critical.  Real name: Gavin Wheeler
#. ~ Smokes is a firefighter that volunteered to take stock of what was
#. available and keep inventory. He's gradually had more lumped onto him as
#. the Free Merchants struggle to put themselves together, but he feels
#. obligated to help, even though he doesn't really want to have all the
#. responsibility he does.
#. ~ Retained to prevent errors.
msgid "Merchant"
msgstr "Marchand"

#: data/json/npcs/bunker_shop/classes.json
#. ~ Job description of "Merchant" NPC class
msgid "I sell things to make a living."
msgstr "Je vends des choses pour vivre."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Mission name
msgid "Find A Basic Analysis Kit"
msgstr "Trouver Un Kit d'Analyse Basique"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Description of mission "Find A Basic Analysis Kit"
msgid "Obtain a basic laboratory analysis kit for the chemist."
msgstr "Obtenez un kit d'analyse de laboratoire basique pour le chimiste."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
msgid "I need a basic laboratory analysis kit."
msgstr "J'ai besoin d'un kit d'analyse de laboratoire basique."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
msgid ""
"I've checked the stock here at this house, and it turns out there's a few "
"pieces of equipment I need.  Firstly, I need a reliable way to take "
"measurements and verify results.  If you could get me a basic laboratory "
"analysis kit just to get started, I'd be grateful.  That's the first step "
"towards making everything I brought with me useful."
msgstr ""
"J'ai vérifié le stock de cette maison et il s'avère qu'il y a quelques pièces "
"d'équipement dont j'ai besoin. Tout d'abord, j'ai besoin d'un moyen fiable de "
"prendre des mesures et de vérifier les résultats. Si vous pouviez me procurer "
"un kit d'analyse de laboratoire de base pour commencer, je vous en serais "
"reconnaissant. C'est le premier pas pour que tout ce que j'ai apporté soit "
"utile."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/lumbermill_employees/lumbermill_missions.json
#: data/json/npcs/scrap_trader/scrap_trader_missions.json
#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
#. ~ Dialogue line in mission "Find Some Hydrochloric Acid"
#. ~ Dialogue line in mission "Find Some Gasoline"
#. ~ Dialogue line in mission "Establish A Trade Route"
#. ~ Dialogue line in mission "Find Drive Belts"
#. ~ Dialogue line in mission "Get 1,000 Nails"
#. ~ Dialogue line in mission "Get 6,800 Nails"
#. ~ Dialogue line in mission "Find 6 Blankets"
#. ~ Dialogue line in mission "Find 25 Magnetrons"
#. ~ Dialogue line in mission "Obtain 300 Charcoal"
#. ~ Dialogue line in mission "Obtain 100 Solder"
msgid "I'll be here when you get back.  Good luck!"
msgstr "Je serai là à votre retour. Bonne chance !"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/lumbermill_employees/lumbermill_missions.json
#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
#. ~ Dialogue line in mission "Find Some Hydrochloric Acid"
#. ~ Dialogue line in mission "Find Some Gasoline"
#. ~ Dialogue line in mission "Find 6 Blankets"
msgid "Well, someone's got to do it."
msgstr "Quelqu'un doit le faire."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
msgid "One of those old labs might have one."
msgstr "L'un des vieux laboratoires pourrait en avoir un."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
#. ~ Dialogue line in mission "Find Some Gasoline"
#. ~ Dialogue line in mission "Obtain a guitar string"
msgid "Do you have it?"
msgstr "Vous avez ce que je vous ai demandé?"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
msgid "Thank you!  I can't wait to get started!"
msgstr "Merci! J'ai hâte de commencer!"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
#. ~ Dialogue line in mission "Find Some Hydrochloric Acid"
#. ~ Dialogue line in mission "Find Some Gasoline"
msgid "That's unfortunate.  I guess I'll have to find it myself."
msgstr "Dommage. Je suppose que je devrais en trouver moi-même."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Mission name
msgid "Find Some Hydrochloric Acid"
msgstr "Trouvez de l'Acide Chlorhydrique"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Description of mission "Find Some Hydrochloric Acid"
msgid "Obtain 15 liters of hydrochloric acid for the chemist."
msgstr "Trouvez 15 litres d'acide chlorhydrique pour le chimiste."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Hydrochloric Acid"
msgid "I need 15 liters of hydrochloric acid."
msgstr "J'ai besoin de 15 litres d'acide chlorhydrique."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Hydrochloric Acid"
msgid ""
"The last thing I really need to get going is hydrochloric acid.  It's one of "
"those chemicals that's just perfect for so many things.  An acidifying "
"reagent, and one of the best.  With a large supply of hydrochloric acid, you "
"and I are only a few steps removed from a stable source of antiseptic, "
"fungicide, and even some light explosives!  As the only apparent health "
"authority left, I do have to warn you not to get it on your skin, though.  "
"Find this for me and I'll sell you whatever I can make."
msgstr ""
"La dernière chose dont j'ai vraiment besoin pour commencer est l'acide "
"chlorhydrique. C'est l'un de ces produits chimiques parfaits pour tant de "
"choses. C'est un réactif acidifiant, et l'un des meilleurs. Avec une grande "
"réserve d'acide chlorhydrique, vous et moi ne sommes qu'à quelques pas d'une "
"source stable d'antiseptique, de fongicide et même d'explosifs légers ! En "
"tant que seule autorité sanitaire apparente restante, je dois cependant vous "
"avertir de ne pas en mettre sur votre peau. Trouvez-moi ça et je vous vendrai "
"tout ce que je peux fabriquer."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Hydrochloric Acid"
msgid ""
"You might find large quantities in a warehouse somewhere, but it often got "
"sold as a household cleaner, did you know that?"
msgstr ""
"Vous pourriez en trouver de grandes quantités dans un entrepôt quelque part, "
"mais il est souvent vendu comme produit d'entretien ménager, le saviez-vous ?"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Hydrochloric Acid"
msgid "Do you have the hydrochloric acid?"
msgstr "Vous avez l'acide chlorhydrique?"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Hydrochloric Acid"
msgid "Wonderful!  I'm sure this will be quite helpful."
msgstr "Super ! Je suis sûr(e) que ça sera d'une grande aide."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Mission name
msgid "Find Some Gasoline"
msgstr "Trouvez de l'Essence"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Description of mission "Find Some Gasoline"
msgid "Obtain 100 liters of gasoline for the chemist."
msgstr "Trouvez 100 litres d'essence pour le chimiste."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Gasoline"
msgid "I need 100 liters of gas."
msgstr "J'ai besoin de 100 litres d'essence."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Gasoline"
msgid ""
"I'm in a bit of a spot.  I keep a generator around here to power all my "
"scientific equipment.  It has a bit of gas in it, but I've burned through "
"that and I can't use most of my tools without power.  This may seem like a "
"lot, but if you could get me 100 liters of gas, I'll pay you back any way I "
"can."
msgstr ""
"Je suis dans une situation délicate. J'ai un générateur ici pour alimenter "
"tout mon matériel scientifique. Il contient un peu de gaz, mais je l'ai "
"épuisé et je ne peux pas utiliser la plupart de mes outils sans énergie. Cela "
"peut sembler beaucoup, mais si vous pouviez me procurer 100 litres de gaz, je "
"vous rembourserais par tous les moyens."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Gasoline"
msgid ""
"I bet the best place to find that much gas is still a gas station.  Bringing "
"it all here is another problem.  You might want one of those big steel drums "
"we used to use to haul off hazardous waste before <the_cataclysm>."
msgstr ""
"Je parie que le meilleur endroit pour trouver une telle quantité de gaz est "
"encore une station-service. L'acheminer jusqu'ici est un autre problème. Vous "
"pourriez avoir besoin d'un de ces grands fûts en acier que l'on utilisait "
"pour transporter les déchets dangereux avant <the_cataclysm>."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Find Some Gasoline"
msgid ""
"Wonderful!  Thank you so much!  This will keep me running for a long, long "
"time."
msgstr ""
"Merveilleux!  Merci beaucoup!  Ceci devrait me suffire pour un bon, bon "
"moment."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/godco/godco_missions.json
#. ~ Dialogue line in mission "Find Some Gasoline"
#. ~ Dialogue line in mission "Renewable Energy"
msgid "Thanks for trying…  I guess."
msgstr "Merci d'avoir essayé au moins... Je suppose."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/lumbermill_employees/lumbermill_missions.json
#: data/json/npcs/scrap_trader/scrap_trader_missions.json
#. ~ Mission name
msgid "Establish A Trade Route"
msgstr "Établir Une Route Commerciale"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Description of mission "Establish A Trade Route"
msgid ""
"Establish trade relations between the chemist and a refugee center, and bring "
"back a writ of the agreement."
msgstr ""
"Établissez des relations commerciales entre le chimiste et un centre de "
"réfugiés, et rapportez un exemplaire de l'accord."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/lumbermill_employees/lumbermill_missions.json
#: data/json/npcs/scrap_trader/scrap_trader_missions.json
#. ~ Dialogue line in mission "Establish A Trade Route"
msgid "Go negotiate a trade agreement."
msgstr "Allez négocier un accord commercial."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Establish A Trade Route"
msgid ""
"I was out scavenging recently, and I found one of those old evac shelters.  "
"Turns out the computer was still on and it had an address for a refugee "
"center.  I think my skills might be useful to them, for helping maintain "
"medical supplies and whatnot, so I want you to head over there and see if "
"they're interested.  I'd do it myself, but I need to look after this place."
msgstr ""
"J'ai fait des recherches récemment et j'ai trouvé un de ces vieux abris "
"d'évacuation. Il s'avère que l'ordinateur était encore allumé et qu'il y "
"avait l'adresse d'un centre de réfugiés. Je pense que mes compétences "
"pourraient leur être utiles, pour aider à maintenir les fournitures médicales "
"et autres, alors je veux que tu y ailles et que tu vois s'ils sont "
"intéressés. Je le ferais bien moi-même, mais je dois m'occuper de cet endroit."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/scrap_trader/scrap_trader_missions.json
#. ~ Dialogue line in mission "Establish A Trade Route"
msgid "Please?  This is really important to me."
msgstr "S'il vous plaît?  C'est vital pour moi."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/lumbermill_employees/lumbermill_missions.json
#: data/json/npcs/scrap_trader/scrap_trader_missions.json
#. ~ Dialogue line in mission "Establish A Trade Route"
msgid ""
"It should be pretty simple making the deal, but I'd recommend taking a car "
"over there myself."
msgstr ""
"Il devrait être assez simple de conclure l'accord, mais je recommanderais d'y "
"emmener moi-même une voiture."

#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/scrap_trader/scrap_trader_missions.json
#. ~ Dialogue line in mission "Establish A Trade Route"
msgid "What did they say about it?"
msgstr "Qu’ont-ils dit à ce sujet?"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Establish A Trade Route"
msgid "How does this help me?"
msgstr "Il y a quoi pour moi dans ça?"

#: data/json/npcs/cabin_chemist/chemist_missions.json
#. ~ Dialogue line in mission "Establish A Trade Route"
msgid "That's unfortunate.  I guess I'll have to find other customers."
msgstr "Dommage. Je suppose que je vais devoir trouver d'autres clients."

#: data/json/npcs/cabin_chemist/chemist_npc.json
#. ~ Name suffix of an NPC
msgid "chemist"
msgstr "chimiste"

#: data/json/npcs/cabin_chemist/chemist_npc.json
#: data/json/overmap/overmap_special/specials.json
#. ~ Name of an NPC class
#. ~ Name of NPC faction camp
msgid "Chemist"
msgstr "Chimiste"

#: data/json/npcs/cabin_chemist/chemist_npc.json
#. ~ Job description of "Chemist" NPC class
msgid "I make and sell chemicals"
msgstr "Je manufacture et vends des produits chimiques"

#: data/json/npcs/cabin_chemist/chemist_npc.json
#. ~ Response to NPC dialogue
msgid "Could you tell me about yourself again?"
msgstr "Pouvez-vous me parler de vous, encore ?"

#: data/json/npcs/cabin_chemist/chemist_npc.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_logger.json
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_merchant.json
#: data/json/npcs/other/TALK_ANIMAL_SHELTER_SURVIVOR.json
#: data/json/npcs/other/TALK_GUN_STORE_SURVIVOR.json
#: data/json/npcs/other/TALK_NPC_APARTMENT_SURVIVOR.json
#: data/json/npcs/other/TALK_NPC_CAMPER.json
#: data/json/npcs/other/TALK_NPC_MOONSHINER.json
#: data/json/npcs/other/TALK_NPC_PREPPER_SURVIVOR.json
#: data/json/npcs/other/TALK_shelter_survivors.json
#: data/json/npcs/other/homeless/TALK_homeless_survivor.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_broker.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_group_survivors.json
