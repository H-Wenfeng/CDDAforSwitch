#. ~ Response to NPC dialogue
msgid "I talked to them."
msgstr "Je leur ai parlé."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Here it is!"
msgstr "Le voilà!"

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Justice has been served."
msgstr "Justice a été rendue."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "I killed them.  All of them."
msgstr "Je les ai tués. Tous."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "I brought 'em."
msgstr "Je les ai apportés."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "I've taken care of it"
msgstr "Je m'en suis occupé…"

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid ""
"I found it, but I'm keeping it, and I'll find you another one.  "
"<done_conversation_section>"
msgstr ""

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid ""
"I found it, but I'm keeping it, and I'll find you another one.  "
"<end_talking_bye>"
msgstr ""

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Mission success!  I don't know what else to say."
msgstr "Mission réussie! Je vois pas quoi dire d'autre."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Glad to help.  I need no payment."
msgstr "Content de pouvoir aider. Je n'ai besoin de rien."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "How about some items as payment?"
msgstr "Que diriez-vous d'objets comme récompense?"

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/godco/members/NPC_Corrie_Kaja_Dosia.json
#. ~ Response to NPC dialogue
msgid "Maybe you can teach me something as payment?"
msgstr ""

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Glad to help.  I need no payment.  <end_talking_bye>"
msgstr ""

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_teamster.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
#. ~ Response to NPC dialogue
msgid "Glad to help."
msgstr "Heureux d'aider."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Glad to help.  <end_talking_bye>"
msgstr "Ravi·e d'avoir aidé.  <end_talking_bye>"

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Well, um, sorry."
msgstr "Hum, désolé."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "I'm sorry.  I did what I could."
msgstr "Je suis désolé·e.  J'ai fais ce que j'ai pu."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ NPC dialogue line
msgid "Sure, here you go!"
msgstr "Ok, voilà pour vous!"

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/godco/godco_missions.json
#: data/json/npcs/godco/members/NPC_Helena_Misinter.json
#: data/json/npcs/godco/members/NPC_Maria_Serrano.json
#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_broker.json
#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_jabberwock.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_missions.json
#: data/mods/DinoMod/NPC/NC_BO_BARONYX.json
#: data/mods/Xedra_Evolved/npc/boann.json
#. ~ Response to NPC dialogue
#. ~ Dialogue line in mission "Retrieve the fertility supplements"
#. ~ Dialogue line in mission "Find cactus seeds"
#. ~ Dialogue line in mission "Fishy Business"
#. ~ Dialogue line in mission "Mathematical Measures"
#. ~ Dialogue line in mission "Plumbing Maintenance"
#. ~ Dialogue line in mission "Planning Planers"
#. ~ Dialogue line in mission "Purging Heresy"
#. ~ Dialogue line in mission "Find Chris Isherwood"
#. ~ Dialogue line in mission "Gather 2000 units of sand"
#. ~ Dialogue line in mission "Gather 100 units of clay"
msgid "Thank you."
msgstr "Merci."

#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#. ~ Response to NPC dialogue
msgid "Thanks, bye."
msgstr "Merci, au revoir."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Well, I guess it's just us."
msgstr "Eh bien, je pense que c'est seulement nous."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "At least we've got shelter."
msgstr "Au moins nous avons un abri."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "What should we do now?"
msgstr "Qu'est-ce qu'on fait maintenant?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Any tips?"
msgstr "Des astuces?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/other/meteorologist.json
#. ~ Response to NPC dialogue
msgid "Want to travel with me?"
msgstr "Vous voulez voyager avec moi?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Want to share some useful items with me?"
msgstr "Vous voulez partager des objets utiles avec moi ?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I don't know, look for supplies and other survivors I guess."
msgstr "Je ne sais pas trop, chercher des provisions et d'autres survivants j'imagine."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Maybe we should start boarding up this place."
msgstr "On devrait peut-être commencer par barricader cet endroit."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid ""
"I suppose getting a car up and running would be really be useful if we have "
"to move."
msgstr "J'imagine que trouver une voiture serait vraiment utile si on doit bouger."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid ""
"We could look for a farm.  They should have food and tools, and they aren't "
"close to cities."
msgstr ""
"On pourrait trouver une ferme. Il devrait y avoir de la nourriture et des "
"outils, et ce n'est pas trop proche des villes."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "We should probably stay away from cities, even if they have lots of supplies."
msgstr "On devrait sûrement rester loin des villes, même s'il y a beaucoup de denrées."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Hmm, okay."
msgstr "Hum, ok."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/refugee_center/surface_refugees/NPC_Draco_Dune.json
#. ~ Response to NPC dialogue
msgid "Thanks!"
msgstr "Merci !"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Focus on the road, mate!"
msgstr "Concentre toi sur la route!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I'm driving here!"
msgstr "Je conduis là!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ NPC dialogue line
msgid "I'm too thirsty, give me something to drink."
msgstr "Je meurs de soif, donne-moi quelque chose à boire."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ NPC dialogue line
msgid "I'm too hungry, give me something to eat."
msgstr "Je meurs de faim, donne-moi quelque chose à manger."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Nothing comes to my mind now.  Ask me later perhaps?"
msgstr "Rien ne me vient en tête. Redemande-moi plus tard peut-être ?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I have some reason for not telling you."
msgstr "J'ai des raisons de ne pas te le dire."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/mods/MindOverMatter/npcs/dialogue/follower_dialogue.json
#. ~ Response to NPC dialogue
msgid "Ah, okay."
msgstr "Ah, d'accord."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Not until I get some antibiotics…"
msgstr "Pas avant que j'ai des antibiotiques."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Why should I travel with you?"
msgstr "Pourquoi je voyagerais avec toi?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Understood.  I'll get those antibiotics."
msgstr "C'est compris. Je rapporte les antibiotiques."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Right, right, I'll ask later."
msgstr "Oui ok, je demanderai plus tard."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "I can keep you safe."
msgstr "Je peux assurer ta sécurité."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "You can keep me safe."
msgstr "Tu peux assurer ma sécurité."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "I'll kill you if you don't."
msgstr "Je vous tue si vous n'obéissez pas."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "You got it, I'm with you!"
msgstr "Ok ça me va, je te suis!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/mods/BombasticPerks/perkdata/praise.json
#. ~ Response to NPC dialogue
#. ~ Snippet in category "<good_job>"
msgid "Awesome!"
msgstr "Super!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Yeah… I don't think so."
msgstr "Mouais… je ne crois pas non."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
#: data/mods/Xedra_Evolved/npc/vampire_mentor.json
#. ~ NPC dialogue line
#. ~ Response to NPC dialogue
msgid "What is it?"
msgstr "Qu'est-ce que c'est ?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "How much further?"
msgstr "C'est encore loin?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "I'd like to lead for a while."
msgstr "J'aimerais nous guider un moment."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Step aside.  I'm leader now."
msgstr "Écarte toi. C'est moi qui mène maintenant."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Alright.  You can lead now."
msgstr "D'accord, ouvrez le chemin."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Good.  Something else…"
msgstr "Cool.  Autre chose…"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, okay."
msgstr "Ok, ok."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Alright, show me how it's done."
msgstr "Ok, montre moi comment c'est fait."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, let's begin."
msgstr "Ok, commençons."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay.  Lead the way."
msgstr "D'accord ouvre le chemin."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "No, we'll be okay here."
msgstr "Non, je suis bien ici."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Alright, who should participate?"
msgstr "Ok, qui doit participer?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Let's see…"
msgstr "Voyons voir…"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Alright, let's begin."
msgstr "D'accord, c'est parti."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Sounds good."
msgstr "Ça me va."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I can't train you properly while you're operating a vehicle!"
msgstr "Je ne peux pas vous former correctement pendant que vous conduisez!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I can't train you properly while I'm operating a vehicle!"
msgstr "Je ne peux pas vous former correctement et conduire en même temps!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Give it some time, I'll show you something new later…"
msgstr "Patientez un peu, je vous montrerai quelque chose de nouveau plus tard…"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I have some reason for denying you training."
msgstr "J'ai mes raisons pour mon refus de vous former."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "We'll talk about a training seminar after you're done operating that vehicle."
msgstr ""
"On pourra parler d'un séminaire de formation quand vous aurez fini de "
"conduire."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I can't host a seminar while I'm operating a vehicle!"
msgstr "Je ne peux pas organiser un séminaire et conduire ce véhicule en même temps!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Give it some time, we'll talk about a training seminar later…"
msgstr "Donnez-moi un petit moment avant qu'on organise un autre séminaire."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I have some reason to refuse hosting a training seminar."
msgstr "J'ai mes raisons pour mon refus d'organiser un séminaire."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Not a bloody chance, I'm going to get left behind!"
msgstr "Aucune chance, je vais être mis à l'écart!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/holdouts/Rural-Cowboy_Nihilist.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
#. ~ Response to NPC dialogue
msgid "Fine."
msgstr "Bien."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I'm on watch."
msgstr "Je suis à la bourre."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/your_followers/liam_main_dialogue.json
#: data/json/npcs/your_followers/luo_follower.json
#. ~ Response to NPC dialogue
msgid "I need you to come with me."
msgstr "Il faut que vous veniez avec moi."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/snippets/talk_tags_line.json
#: data/json/npcs/your_followers/liam_main_dialogue.json
#: data/json/npcs/your_followers/luo_follower.json
#. ~ Response to NPC dialogue
#. ~ Snippet in category "<whats_up>"
#. ~ Friendly or neutral greetings.
msgid "Let's talk."
msgstr "Parlons."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I really don't feel comfortable doing so…"
msgstr "Je me sens pas à l'aise pour faire ça…"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "I'll give you some space."
msgstr "Je vais vous faire de la place."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "I'd prefer to keep that to myself."
msgstr "J'aimerais garder ça pour moi."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "I understand…"
msgstr "Je comprends…"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Why should I share my equipment with you?"
msgstr "Pourquoi je partagerais mon équipement avec toi?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, fine."
msgstr "D'accord."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Because I'm holding a thermal detonator!"
msgstr "Parce que j'ai un détonateur thermique entre les mains!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Because I'm your friend!"
msgstr "Parce que je suis votre ami·e!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Well, I am helping you out…"
msgstr "Eh bien, je vous aide…"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "I'll give it back!"
msgstr "Je te le rendrai!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Give it to me, or else!"
msgstr "Donne le moi, sinon!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Never mind, I'll do without.  <end_talking_bye>"
msgstr "Tant pis, je ferais sans.  <end_talking_bye>"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Okay, here you go."
msgstr "Ok, voilà pour toi."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Thanks!  But can I have some more?"
msgstr "Merci! Mais je peux en avoir plus?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Thanks, see you later!"
msgstr "Merci, à plus tard!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "You picked up something that does not belong to you…"
msgstr "Vous avez ramassé quelque chose qui ne vous appartient pas…"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, okay, this is all a misunderstanding.  Sorry, I'll drop it now."
msgstr "Ok ok, c'est un malentendu. Désolé(e), j'arrête d'en parler."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "No, I'm keeping it.  Try and take it off me, I dare you."
msgstr "Non je le/la garde. Essaye de me le/la reprendre pour voir !"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Look, I really need this.  Please let me have it."
msgstr "Écoute, j'ai vraiment besoin de ça. S'il te plait laisse moi l'avoir."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "What, this?  It's not the same one, you are mistaken."
msgstr "C'est quoi ? C'est pas la même chose, tu te trompes."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "I'm sorry.  Look, I already dropped it, okay?"
msgstr "Je suis désolé(e). Écoute j'ai déjà lâché l'affaire ok ?"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Don't try and talk yourself out of this, drop it now."
msgstr "Essaye pas de t'en sortir en déblatérant, lâche ça tout de suite."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, I'm dropping it…"
msgstr "Ok, je lâche ça…"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Just this once, you can keep it.  Don't tell anyone else."
msgstr "Juste pour cette fois tu peux garder ça. Ne le dis à personne d'autre."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/exodii/common_talk.json
#: data/json/npcs/godco/members/NPC_Aunt_Theresa.json
#: data/json/npcs/godco/members/NPC_Helena_Misinter.json
#: data/json/npcs/godco/members/cook.json
#: data/json/npcs/isolated_road/isolated_road_cody_dialogue.json
#: data/json/npcs/isolated_road/isolated_road_cody_fabricate.json
#: data/json/npcs/isolated_road/isolated_road_cody_prototype.json
#: data/json/npcs/isolated_road/isolated_road_cody_weaponsmith.json
#: data/json/npcs/other/TALK_NPC_PREPPER_SURVIVOR.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/robofac/NPC_Cranberry_Foster.json
#: data/json/npcs/robofac/robofac_intercom/robofac_intercom_prototypes.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
#: data/json/npcs/your_followers/liam_chat.json
#: data/mods/No_Hope/NPC/NPC_Old_Guard_Commo.json
#. ~ Response to NPC dialogue
msgid "Thanks."
msgstr "Merci."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "Right… I don't want any trouble."
msgstr "Ok… Je ne veux pas de problèmes."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Smart choice."
msgstr "Bon choix."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "No, and if you ask again, I'll fucking obliterate you!"
msgstr "Non, et si tu demandes encore, je te défonce !"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ NPC dialogue line
msgid "No, fuck off!"
msgstr "Non, casses-toi !"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, okay, sorry."
msgstr "Ok, ok, désolé."

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Seriously, give me more stuff!"
msgstr "Sérieux, donne moi plus de matos!"

#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#. ~ Response to NPC dialogue
msgid "Okay, fine, bye."
