#: data/mods/MindOverMatter/snippets/snippets_new.json
#. ~ Snippet in category "lab_postit_psi"
msgid "<given_name> is up for awakening.  Ban her from the poker game"
msgstr "<given_name> a commencé à s'éveiller. Exclue-la des soirées poker"

#: data/mods/MindOverMatter/snippets/snippets_new.json
#. ~ Snippet in category "lab_postit_psi"
