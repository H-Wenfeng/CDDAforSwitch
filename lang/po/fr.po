#: data/json/items/ammo.json
#. ~ Item name
msgid "spiked homemade rocket"
msgid_plural "spiked homemade rockets"
msgstr[0] "roquette hérissée artisanale"
msgstr[1] "roquettes hérissées artisanales"
msgstr[2] "roquettes hérissées artisanales"

#: data/json/items/ammo.json
#. ~ Description of "spiked homemade rocket"
msgid ""
"A hand-built rocket, consisting of a spike welded onto a pipe filled with "
"improvised rocket fuel.  Horribly inaccurate, as can be expected of this "
"grade of weapon, but packs a fierce punch… if it hits."
msgstr ""
"Une fusée artisanale, composée d'une pointe soudée à un tuyau rempli de "
"carburant improvisé.  Horriblement imprécise, comme on peut s'y attendre avec "
"ce type d'arme, elle est néanmoins redoutable… si elle touche."

#: data/json/items/ammo.json
#. ~ Item name
msgid "explosive homemade rocket"
msgid_plural "explosive homemade rockets"
msgstr[0] "roquette explosive artisanale"
msgstr[1] "roquettes explosive artisanales"
msgstr[2] "roquettes explosive artisanales"

#: data/json/items/ammo.json
#. ~ Description of "explosive homemade rocket"
msgid ""
"A hand-built rocket, consisting of a simple explosive warhead attached onto a "
"pipe, filled with improvised rocket fuel.  Not very powerful, but can be made "
"from scratch."
msgstr ""
"Une roquette faite main, consistant en une simple tête explosive attachée sur "
"un tuyau rempli de carburant improvisé à fusée. Pas très puissante, mais peut "
"être fabriquée à partir de rien."

#: data/json/items/ammo.json
#. ~ Item name
msgid "incendiary homemade rocket"
msgid_plural "incendiary homemade rockets"
msgstr[0] "Roquette incendiaire artisanale"
msgstr[1] "Roquettes incendiaires artisanales"
msgstr[2] "Roquettes incendiaires artisanales"

#: data/json/items/ammo.json
#. ~ Description of "incendiary homemade rocket"
msgid ""
"A hand-built rocket, consisting of a container of flammable gel attached onto "
"a pipe, filled with improvised rocket fuel.  A short-range incendiary - "
"handle with care!"
msgstr ""
"Fusée artisanale composée d'un récipient de gel inflammable fixé à un tuyau, "
"rempli de carburant improvisé. Un incendiaire à courte portée - à manipuler "
"avec précaution !"

