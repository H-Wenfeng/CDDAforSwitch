msgstr[1] "Parchemins de Peau Épineuse"
msgstr[2] "Parchemins de Peau Épineuse"

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Description of "Scroll of Thornskin"
msgid "Transform your skin into bark covered in sharp thorns."
msgstr "Transforme votre peau en écorce couverte d'épines aiguisées."

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Item name
msgid "Scroll of Stranglethorns"
msgid_plural "Scrolls of Stranglethorns"
msgstr[0] "Parchemin de Ronces Étrangleuses"
msgstr[1] "Parchemins de Ronces Étrangleuses"
msgstr[2] "Parchemins de Ronces Étrangleuses"

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Description of "Scroll of Stranglethorns"
msgid ""
"Conjure a bunch of thick brambles out of the ground to either form a wall or "
"slow your enemies."
msgstr ""
"Invoque une masse de ronces épaisse et épineuse hors du sol pour former un "
"mur ou un arc piègant ou ralentissant vos ennemis."

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Item name
msgid "Scroll of Cloak of Fog"
msgid_plural "Scrolls of Cloak of Fog"
msgstr[0] "Parchemin de Manteau de Brouillard"
msgstr[1] "Parchemins de Manteau de Brouillard"
msgstr[2] "Parchemins de Manteau de Brouillard"

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Description of "Scroll of Cloak of Fog"
msgid ""
"Summon up a large cloud of mist that will conceal your movements from your "
"enemies."
msgstr ""
"Invoque un large nuage de brouillard autour de vous pour masquer vos "
"mouvements des yeux de vos ennemis."

#: data/mods/Magiclysm/items/spell_scrolls.json
#. ~ Item name
msgid "Scroll of Heart of the Hurricane"
msgid_plural "Scrolls of Heart of the Hurricane"
msgstr[0] "Parchemin de Cœur du Cyclone"
msgstr[1] "Parchemins de Cœur du Cyclone"
msgstr[2] "Parchemins de Cœur du Cyclone"

