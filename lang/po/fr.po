#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Furniture name
msgid "broken console"
msgstr "console cassé"

#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Description of furniture "broken console"
msgid ""
"A standalone computer terminal.  It doesn't seem to be working.  It's the "
"broken screen and shattered circuit boards telling you that."
msgstr ""
"Un terminal informatique autonome. Il ne semble pas fonctionner. C'est "
"l'écran cassé et les circuits imprimés brisés qui vous le disent."

#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Furniture name
msgid "computer console"
msgstr "ordinateur"

#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Description of furniture "computer console"
msgid ""
"A standalone computer terminal, the screen glowing with dim artificial light. "
" If examined closely, you can read what's on the screen and perform any "
"allowed functions.  It might even be possible to hack it, given the skills."
msgstr ""
"Un terminal informatique autonome, dont l'écran est éclairé par une faible "
"lumière artificielle. En l'examinant de près, on peut lire ce qui s'y trouve "
"et exécuter toutes les fonctions autorisées. Il est même possible de le "
"pirater, si l'on dispose des compétences nécessaires."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/recipes/basecamps/expansion/recipe_modular_workshop/version_2/recipe_modular_workshop_common.json
#. ~ Furniture name
#. ~ Blueprint name of recipe crafting "fbmw_2_common_1"
#. ~ Blueprint name of recipe crafting "fbmw_2_common_smithy_2"
msgid "forge"
msgstr "forge"

#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Description of furniture "forge"
msgid "A metalworking station typically used in combination with an anvil."
msgstr ""
"Poste de travail des métaux généralement utilisé en combinaison avec une "
"enclume."

#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Furniture name
msgid "Cody's forge"
msgstr "forge de Cody"

#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Description of furniture "Cody's forge"
msgid ""
"A metalworking station typically used in combination with an anvil.  You can "
"see pipes running into the walls."
msgstr ""
"Poste de travail du métal généralement utilisé en combinaison avec une "
"enclume. On peut voir des tuyaux dans les murs."

#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Description of furniture "anvil"
msgid ""
"A heavy block of oddly-shaped metal with a pritchel hole and hardy hole.  "
"It's used for metalworking."
msgstr ""
"Un bloc lourd de métal de forme bizarre, avec un trou pour la prise et un "
"trou pour la trempe. Il est utilisé pour le travail des métaux."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/metalworking.json
#. ~ Furniture name
#. ~ Item name
msgid "bronze anvil"
msgid_plural "bronze anvils"
msgstr[0] "enclume en bronze"
msgstr[1] "enclumes en bronze"
msgstr[2] "enclumes en bronze"

#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Description of furniture "bronze anvil"
msgid ""
"A heavy block of oddly-shaped bronze with a pritchel hole and hardy hole.  "
"It's used for metalworking."
msgstr ""
"Un lourd bloc de bronze de forme étrange, avec un trou pour la prise et un "
"trou pour la trempe. Il est utilisé pour le travail des métaux."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json data/json/items/tool/metalworking.json
#. ~ Furniture name
#. ~ Item name
