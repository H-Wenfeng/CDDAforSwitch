#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
#: data/mods/aftershock_exoplanet/npcs/Backgrounds/npc_classes_mutant.json
#. ~ Name of an NPC class
msgid "Bird Mutant"
msgstr "Mutant Avien"

#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
#: data/mods/aftershock_exoplanet/npcs/Backgrounds/npc_classes_mutant.json
#. ~ Job description of "Bird Mutant" NPC class
msgid ""
"I'm looking for bird mutagen… this world is no place for humans anymore, and "
