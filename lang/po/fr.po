#: data/json/monsters/bird.json
#. ~ Monster name
msgid "ruffed grouse"
msgid_plural "ruffed grouses"
msgstr[0] "gélinotte huppée"
msgstr[1] "gélinottes huppées"
msgstr[2] "gélinottes huppées"

#: data/json/monsters/bird.json
#. ~ Description of monster "ruffed grouse"
msgid ""
"A very common game bird, these creatures remind you of what a wild chicken "
"must have been like."
msgstr ""
"Un gibier à plumes très commun, ces créatures ont l'air de ce à quoi un "
"poulet sauvage devait ressembler."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "American crow"
msgid_plural "American crows"
msgstr[0] "corneille d'Amérique"
msgstr[1] "corneilles d'Amérique"
msgstr[2] "corneilles d'Amérique"

#: data/json/monsters/bird.json
#. ~ Description of monster "American crow"
msgid ""
"Sleek and glossy feathers cover this dark bird.  Its pointed bill and more "
"streamlined body distinguish it from the larger, stouter raven.  They call "
"with loud caws and if captured can be taught to mimic human speech."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "raven"
msgid_plural "ravens"
msgstr[0] "corbeau"
msgstr[1] "corbeaux"
msgstr[2] "corbeaux"

#: data/json/monsters/bird.json
#. ~ Description of monster "raven"
msgid ""
"Slightly smaller than a chicken, this glossy black bird has a heavy beak and "
"dark, sparkly eyes.  It emits a variety of sounds including croaks and a "
"knocking sound."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "blue jay"
msgid_plural "blue jays"
msgstr[0] "geai bleu"
msgstr[1] "geais bleus"
msgstr[2] "geais bleus"

#: data/json/monsters/bird.json
#. ~ Description of monster "blue jay"
msgid "A small, noisy bird with distinctive blue feathers."
msgstr "Un petit oiseau bruyant aux plumes bleues distinctives."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "cardinal"
msgid_plural "cardinals"
msgstr[0] "cardinal"
msgstr[1] "cardinaux"
msgstr[2] "cardinaux"

#: data/json/monsters/bird.json
#. ~ Description of monster "cardinal"
msgid ""
"A small songbird, famous for its distinctive crest and facial markings.  A "
"well-known example of sexual dimorphism, the males are colored much more "
"vibrantly than the females."
msgstr ""
"Un petit oiseau chanteur, célèbre pour sa crête et ses marques faciales "
"distinctives.  Exemple bien connu de dimorphisme sexuel, les mâles ont des "
"couleurs beaucoup plus vives que les femelles."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "American robin"
msgid_plural "American robins"
msgstr[0] "merle d'Amérique"
msgstr[1] "merles d'Amérique"
msgstr[2] "merles d'Amérique"

#: data/json/monsters/bird.json
#. ~ Description of monster "American robin"
msgid ""
"A brown songbird with a reddish-orange breast.  Their eggs are a distinctive "
"shade of blue."
msgstr ""
"Un oiseau chanteur brun avec une poitrine rouge-orange.  Leurs œufs sont "
"distinctivement bleus."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "house sparrow"
msgid_plural "house sparrows"
msgstr[0] "moineau domestique"
msgstr[1] "moineaux domestiques"
msgstr[2] "moineaux domestiques"

#: data/json/monsters/bird.json
#. ~ Description of monster "house sparrow"
msgid ""
"A small bird with brown and gray feathers.  Introduced to North America in "
"the 1850s, it is now one of the most abundant birds in the continent."
msgstr ""
"Un petit oiseau aux plumes brunes et grises.  Introduit en Amérique du Nord "
"dans les années 1850, c'est aujourd'hui l'un des oiseaux les plus abondants "
"du continent."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "black-capped chickadee"
msgid_plural "black-capped chickadees"
msgstr[0] "mésange à tête noire"
msgstr[1] "mésanges à tête noire"
msgstr[2] "mésanges à tête noire"

#: data/json/monsters/bird.json
#. ~ Description of monster "black-capped chickadee"
msgid ""
"A tiny species of tit native to North America, with a distinctive black cap "
"on its head."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "cedar waxwing"
msgid_plural "cedar waxwings"
msgstr[0] "jaseur d'Amérique"
msgstr[1] "jaseurs d'Amérique"
msgstr[2] "jaseurs d'Amérique"

#: data/json/monsters/bird.json
#. ~ Description of monster "cedar waxwing"
msgid ""
"A small species of waxwing with a distinctive feathered crest and a black "
"mask pattern on its face."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "mallard"
msgid_plural "mallards"
msgstr[0] "colvert"
msgstr[1] "colverts"
msgstr[2] "colverts"

#: data/json/monsters/bird.json
#. ~ Description of monster "mallard"
msgid ""
"A common species of duck often seen around rivers and other bodies of water.  "
"It feeds primarily on insects, seeds, roots, and, pre-Cataclysm, bread scraps."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "domestic duck"
msgid_plural "domestic ducks"
msgstr[0] "canard domestique"
msgstr[1] "canards domestiques"
msgstr[2] "canards domestiques"

#: data/json/monsters/bird.json
#. ~ Description of monster "domestic duck"
msgid "A domestic variety of the common mallard sporting while plumage."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "Canada goose"
msgid_plural "Canada geese"
msgstr[0] "oie canadienne"
msgstr[1] "oies canadiennes"
msgstr[2] "oies canadiennes"

#: data/json/monsters/bird.json
#. ~ Description of monster "Canada goose"
msgid "A common type of waterfowl that regrets leaving Canada."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "wild turkey"
msgid_plural "wild turkeys"
msgstr[0] "dinde sauvage"
msgstr[1] "dindes sauvages"
msgstr[2] "dindes sauvages"

#: data/json/monsters/bird.json
#. ~ Description of monster "wild turkey"
msgid ""
"A large and colorful game bird native to the forests of North America.  Its "
"head and beak are covered in fleshy protuberances."
msgstr ""
"Un grand gibier à plume coloré originaire des forêts d'Amérique du Nord. Sa "
"tête et son bec sont couverts de protubérances charnues"

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "domestic turkey"
msgid_plural "domestic turkeys"
msgstr[0] "dinde domestique"
msgstr[1] "dindes domestiques"
msgstr[2] "dindes domestiques"

#: data/json/monsters/bird.json
#. ~ Description of monster "domestic turkey"
msgid ""
"A domesticated relative of the common wild turkey.  Lost most of its colors "
"and the ability to fly, but at least it got bigger!"
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "ring-necked pheasant"
msgid_plural "ring-necked pheasants"
msgstr[0] "faisan à collier"
msgstr[1] "faisans à collier"
msgstr[2] "faisans à collier"

#: data/json/monsters/bird.json
#. ~ Description of monster "ring-necked pheasant"
msgid ""
"A medium-sized game bird that can have bright feathers depending on the sex.  "
"Introduced from Asia to New England."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "yellow chick"
msgid_plural "yellow chicks"
msgstr[0] "oisillon jaune"
msgstr[1] "oisillons jaunes"
msgstr[2] "oisillons jaunes"

#: data/json/monsters/bird.json
#. ~ Description of monster "yellow chick"
msgid "A tiny yellow and brown chick, it could be from a number of different species."
msgstr ""
"Un petit poussin jaune et brun pouvant appartenir à un nombre de différentes "
"espèces."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "oversized crow"
msgid_plural "oversized crows"
msgstr[0] "corbeau surdimensionné"
msgstr[1] "corbeaux surdimensionnés"
msgstr[2] "corbeaux surdimensionnés"

#: data/json/monsters/bird.json
#. ~ Description of monster "oversized crow"
msgid ""
"A horrible bird grown three or four times bigger than ought to be possible "
"and sporting a swollen gut that might look comical if it weren't for the "
"razor sharp beak and the madness in its beady eyes."
msgstr ""
"Un oiseau horrible ayant grossi jusqu'à trois ou quatre fois la taille que "
"vous pensez être possible pour ce genre de créature, ses entrailles gonflées "
"auraient presque l'air comique si vous étiez capable d'ignorer son bec "
"aiguisé comme un rasoir et le dérangement profond visible dans ses yeux "
"globuleux."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "bloated corvid"
msgid_plural "bloated corvids"
msgstr[0] "corvidé gorgé"
msgstr[1] "corvidés gorgés"
msgstr[2] "corvidés gorgés"

#: data/json/monsters/bird.json
#. ~ Description of monster "bloated corvid"
msgid ""
"This may have once been a crow or a raven, but now it's a deformed "
"monstrosity nearly the size of a man.  It heaves its sable bulk awkwardly "
"along the ground, too overfed on carrion to fly."
msgstr ""
"Il s'agissait peut-être autrefois d'une corneille ou d'un corbeau, mais c'est "
"désormais une monstruosité déformée presque de la taille d'un homme trainant "
"maladroitement sa masse sombre le long du sol, trop suralimenté en charognes "
"pour voler."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "feral pigeon"
msgid_plural "feral pigeons"
msgstr[0] "pigeon urbain"
msgstr[1] "pigeons urbains"
msgstr[2] "pigeons urbains"

#: data/json/monsters/bird.json
#. ~ Description of monster "feral pigeon"
msgid ""
"A gentle, plump, small-billed bird with a skin saddle, or cere, between its "
"bill and forehead.  On the ground, it struts about with a characteristic "
"bobbing of the head.  It is a strong, swift flier thanks to its long wings "
"and powerful flight muscles."
msgstr ""
"Un oiseau doux, dodu, à petit bec, avec une cire entre le bec et le front.  "
"Au sol, il se pavane avec un mouvement de tête caractéristique.  C'est un "
"oiseau actif et rapide grâce à ses longues ailes et ses puissants muscles de "
"vol."

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "domestic goose"
msgid_plural "domestic geese"
msgstr[0] "oie domestique"
msgstr[1] "oies domestiques"
msgstr[2] "oies domestiques"

#: data/json/monsters/bird.json
#. ~ Description of monster "domestic goose"
msgid ""
"A type of waterfowl well known for its loud honking and relatively aggressive "
"behavior."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "ruby-throated hummingbird"
msgid_plural "ruby-throated hummingbirds"
msgstr[0] "colibri à gorge rubis"
msgstr[1] "colibris à gorge rubis"
msgstr[2] "colibris à gorge rubis"

#: data/json/monsters/bird.json
#. ~ Description of monster "ruby-throated hummingbird"
msgid ""
"A very small hummingbird of varied colorful feathers.  It flies at incredible "
"speeds while seeking nectar among flowers."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "downy woodpecker"
msgid_plural "downy woodpeckers"
msgstr[0] "pic mineur"
msgstr[1] "pics mineurs"
msgstr[2] "pics mineurs"

#: data/json/monsters/bird.json
#. ~ Description of monster "downy woodpecker"
msgid ""
"A small bird with woody colors and a colored crest on its head.  Well known "
"for its ability to poke holes on trees while looking for grubs."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "American coot"
msgid_plural "American coots"
msgstr[0] "foulque d'Amérique"
msgstr[1] "foulques d'Amérique"
msgstr[2] "foulques d'Amérique"

#: data/json/monsters/bird.json
#. ~ Description of monster "American coot"
msgid ""
"A bird belonging to the same family as rails.  Its relatives can be found "
"worldwide in freshwater habitats."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "double-crested cormorant"
msgid_plural "double-crested cormorants"
msgstr[0] "cormoran à aigrettes"
msgstr[1] "cormorans à aigrettes"
msgstr[2] "cormorans à aigrettes"

#: data/json/monsters/bird.json
#. ~ Description of monster "double-crested cormorant"
msgid ""
"An aquatic bird with a long snake-like neck.  While often considered coastal "
"birds, they feel just as at home in freshwater habitats."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "common gallinule"
msgid_plural "common gallinules"
msgstr[0] "gallinule d'Amérique"
msgstr[1] "gallinules d'Amérique"
msgstr[2] "gallinules d'Amérique"

#: data/json/monsters/bird.json
#. ~ Description of monster "common gallinule"
msgid ""
"A bird belonging to the same family as rails.  A relative of the coot with a "
"distinctive red coloration on its heads and brownish plumage."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "horned grebe"
msgid_plural "horned grebes"
msgstr[0] "grèbe cornu"
msgstr[1] "grèbes cornus"
msgstr[2] "grèbes cornus"

#: data/json/monsters/bird.json
#. ~ Description of monster "horned grebe"
msgid ""
"A medium-sized aquatic bird with a long neck.  They can be distinguished by "
"their strange leg placement which makes them great at diving."
msgstr ""

#: data/json/monsters/bird.json
#. ~ Monster name
msgid "domestic guineafowl"
msgid_plural "domestic guineafowl"
msgstr[0] "pintade domestique"
msgstr[1] "pintades domestiques"
msgstr[2] "pintades domestiques"

#: data/json/monsters/bird.json
#. ~ Description of monster "domestic guineafowl"
msgid ""
"A domestic bird that originated from Africa.  Easily recognizable for the "
"strange helmet on its head and its white-gray plumage."
msgstr ""

#: data/json/monsters/civilians.json
#. ~ Monster name
msgid "panicked person"
msgid_plural "panicked persons"
msgstr[0] "personne paniquée"
msgstr[1] "personnes paniquées"
msgstr[2] "personnes paniquées"

#: data/json/monsters/civilians.json
#. ~ Description of monster "panicked person"
msgid ""
"This hysterical individual has a faint, yet fading, glint of intelligence in "
"their bloodshot eyes.  They sometimes scream in fear and behave clearly "
"irrationally.  This will quite likely cause their demise at the hands of the "
"undead horde rather quickly."
msgstr ""
"Un individu hystérique, une faible lueur d'intelligence brillant encore dans "
"ses yeux injectés de sang, se comportant totalement irrationnellement et "
"hurlant de temps à autre, ceci causera probablement leur fin aux mains des "
"hordes zombifiées, et vous voudrez probablement ne pas être proche d'eux "
"lorsque cela arrivera."

#: data/json/monsters/civilians.json
#. ~ Monster name
msgid "petrified person"
msgid_plural "petrified persons"
msgstr[0] "personne pétrifiée"
msgstr[1] "personnes pétrifiées"
msgstr[2] "personnes pétrifiées"

#: data/json/monsters/civilians.json
#. ~ Description of monster "petrified person"
msgid ""
"They just stand there, staring into the void, with a vacant expression on "
"their face.  Barely moving, they will probably fall to the undead horde soon."
msgstr ""
"Cet individu reste planté là sans rien faire, son regard vide ne fixant rien "
"en particulier, et son visage rempli d'une expression hébétée, cette victime "
"du cataclysme succombera au hordes le moment où celles-ci réaliseront sa "
"présence."

#: data/json/monsters/civilians.json
#. ~ Monster name
msgid "overconfident officer"
msgid_plural "overconfident officers"
msgstr[0] "policier présomptueux"
msgstr[1] "policiers présomptueux"
msgstr[2] "policiers présomptueux"

#: data/json/monsters/civilians.json
#. ~ Description of monster "overconfident officer"
msgid ""
"Gun in hand, this police officer is determined to make a last stand against "
"the horde."
msgstr ""
"Son pistolet à la main, cet officier de police s'est déterminé à accomplir "
"une dernière lutte contre les hordes de morts-vivants."

#: data/json/monsters/civilians.json
#. ~ Description of special attack of monster "overconfident officer"
msgid "The officer fires their Glock 22!"
msgstr "Le policier tire avec son Glock 22!"

#: data/json/monsters/civilians.json
#. ~ Description of monster "overconfident officer"
msgid ""
"Rifle in hand, this police officer is determined to make a last stand against "
"the horde."
msgstr ""
"Son fusil dans les mains, cet officier de police s'est déterminé à accomplir "
"une dernière lutte contre les hordes de morts-vivants."

#: data/json/monsters/civilians.json
#. ~ Description of special attack of monster "overconfident officer"
msgid "The officer fires their AR-15!"
msgstr "Le policier tire avec son AR-15!"

#: data/json/monsters/civilians.json
#. ~ Monster name
msgid "futile fighter"
msgid_plural "futile fighters"
msgstr[0] "combattant futile"
msgstr[1] "combattants futiles"
msgstr[2] "combattants futiles"

#: data/json/monsters/civilians.json
#. ~ Description of monster "futile fighter"
msgid ""
"Obviously, this aggravated yet rallied person has lost their wits and tries "
"to fight the undead with just a knife in their hands."
msgstr ""
"Cette personne à perdue la boule et est en train d'essayer de tuer tout les "
"zombies dans ses environs avec rien d'autre qu'un couteau de cuisine dans ses "
"mains."

#: data/json/monsters/civilians.json
#. ~ Monster name
msgid "armed fighter"
msgid_plural "armed fighters"
msgstr[0] "combattant armé"
msgstr[1] "combattants armés"
msgstr[2] "combattants armés"

#: data/json/monsters/civilians.json
#. ~ Description of monster "armed fighter"
msgid ""
"Handgun in hand, this person is determined to make a last stand against the "
"horde."
msgstr ""
"Son pistolet à la main, cette personne s'est déterminée à accomplir une "
"dernière lutte contre les hordes de morts-vivants."

#: data/json/monsters/civilians.json
#. ~ Description of special attack of monster "armed fighter"
msgid "The gunman fires their sidearm!"
msgstr "Le flingueur tire avec son pistolet!"

#: data/json/monsters/civilians.json
#. ~ Monster name
msgid "hospitalized person"
msgid_plural "hospitalized persons"
msgstr[0] "personne hospitalisée"
msgstr[1] "personnes hospitalisées"
msgstr[2] "personnes hospitalisées"

#: data/json/monsters/civilians.json
#. ~ Description of monster "hospitalized person"
msgid ""
"This person is severely ill in some form or another, requiring intensive care "
"that is not available anymore after the Cataclysm.  There is nothing you can "
"do for them."
msgstr ""

#: data/json/monsters/civilians.json
#. ~ Monster name
msgid "terrified parent"
msgid_plural "terrified parents"
msgstr[0] "parent terrifié"
msgstr[1] "parents terrifiés"
msgstr[2] "parents terrifiés"

#: data/json/monsters/civilians.json
#. ~ Description of monster "terrified parent"
msgid ""
"Obsessed with finding their offspring, they scour the environment for certain "
"death."
msgstr ""
"Obsédé par l’idée de retrouver sa progéniture, cette pauvre créature "
"parcourra les environs jusqu'à sa mort assurée."

#: data/json/monsters/cyborgs.json
#. ~ Monster name
msgid "broken cyborg"
msgid_plural "broken cyborgs"
msgstr[0] "cyborg brisé"
msgstr[1] "cyborgs brisés"
msgstr[2] "cyborgs brisés"

#: data/json/monsters/cyborgs.json
#. ~ Description of monster "broken cyborg"
msgid ""
"A robot body with the head of a human.  All kinds of electronic wires and "
"devices are implanted in its head.  The remaining patches of skin look "
"diseased or rotting.  This cyborg moves erratically and has a confused and "
"deranged look in its eyes.  Any personality or humanity it once had is "
"clearly gone for good."
msgstr ""
"Un corps de robot avec une tête d'humain.  Toutes sortes de fils et appareils "
"électroniques sont implantés dans sa tête.  Les zones de peau restantes "
"semblent malades ou pourries.  Ce cyborg se déplace de manière erratique et a "
"un regard confus et dérangé.  Toute personnalité ou humanité pouvant "
"autrefois être présente a clairement disparu pour de bon."

#: data/json/monsters/cyborgs.json
#. ~ Monster name
msgid "prototype cyborg"
msgid_plural "prototype cyborgs"
msgstr[0] "cyborg prototype"
msgstr[1] "cyborgs prototypes"
msgstr[2] "cyborgs prototypes"

#: data/json/monsters/cyborgs.json
#. ~ Description of monster "prototype cyborg"
msgid ""
"A human fused with a mess of metal parts and wires.  While their eyes are "
"empty, the flashes of pain that occasionally cross their face remind you "
"that, deep down, there is a person just like you trapped in this grotesque "
"body.  Someone with enough surgical skills might be able to restore some of "
"their humanity.  If only anyone cared…"
msgstr ""
"Un humain fusionné avec un fouillis de pièces et de fils métalliques.  Bien "
"que ses yeux soient vides, les éclairs de douleur qui traversent parfois son "
"visage vous rappellent qu'au fond, il y a une personne comme vous enfermée "
"dans ce corps grotesque.  Quelqu’un possédant suffisamment de compétences en "
"chirurgie pourrait être en mesure de restaurer une partie de son humanité.  "
"Si seulement quelqu’un s’en souciait…"

#: data/json/monsters/cyborgs.json
#. ~ Monster name
msgid "Exodii worker"
msgid_plural "Exodii workers"
msgstr[0] "ouvrier Exodii"
msgstr[1] "ouvriers Exodii"
msgstr[2] "ouvriers Exodii"

#: data/json/monsters/cyborgs.json
#. ~ Description of monster "Exodii worker"
msgid "A mostly humanoid robot equipped with various construction tools."
msgstr "Un robot plus ou moins humanoïde équipé d'outils de construction variés."

#: data/json/monsters/cyborgs.json
#. ~ Monster name
msgid "Exodii quadruped"
msgid_plural "Exodii quadrupeds"
msgstr[0] "quadrupède Exodii"
msgstr[1] "quadrupèdes Exodii"
msgstr[2] "quadrupèdes Exodii"

#: data/json/monsters/cyborgs.json
#. ~ Description of monster "Exodii quadruped"
msgid ""
"This enormous quadrupedal robot seems to be cobbled together from parts, most "
"of them unfamiliar to you.  It moves with a heavy, oddly graceful gait, its "
"footsteps leaving shallow craters behind.  It bristles with an arsenal of "
"weaponry, and while it doesn't seem to be in a rush to target you, you feel "
"that you should keep your distance anyway."
msgstr ""
"Un énorme robot quadrupède semblant être composé de pièces hétéroclites "
"étranges.  Il se déplace avec une démarche lourde et étrangement gracieuse, "
"ses pas laissant derrière lui des cratères peu profonds.  Il est doté d'un "
"arsenal d'armes et, même s'il ne semble pas pressé de vous cibler, vous "
"sentez que vous devriez quand même garder vos distances."

#: data/json/monsters/cyborgs.json
#. ~ Monster message of special attack of monster "Exodii quadruped"
msgid "The Exodii quadruped fires its weapon pod!"
msgstr ""

#: data/json/monsters/cyborgs.json data/json/monsters/defense_bot.json
