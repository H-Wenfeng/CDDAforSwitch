#: data/json/field_type.json
#. ~ Name of effect type id "LIXA_decompressed"
msgid "In Decompressed Space"
msgstr "Dans Espace décompressé"

#: data/json/field_type.json
#. ~ Description of effect type "In Decompressed Space"
msgid ""
"For an instant, every inch of this infinite space is itself infinite, slowing "
"you drastically."
msgstr ""
"Pendant un instant, chaque centimètre de cet espace infini est lui-même "
"infini, vous ralentissant considérablement."

#: data/json/field_type.json
#. ~ Apply message of effect type "In Decompressed Space"
msgid "Space unfolds and extends around you!"
msgstr "L'espace se déploie et s'étend autour de vous !"

#: data/json/field_type.json
#. ~ Miss message of effect type "In Decompressed Space"
msgid "You cannot make any progress in all this vastness."
msgstr "Vous ne pouvez faire aucun progrès dans toute cette immensité."

#: data/json/field_type.json
#. ~ Field intensity level
msgid "decompressed space"
msgstr "Espace décompressé"

#: data/json/field_type.json
#. ~ Name of effect type id "LIXA_unfolded_eff"
msgid "Unfolded"
msgstr "Déplié"

#: data/json/field_type.json
#. ~ Description of effect type "Unfolded"
msgid ""
"There is no longer an inside or outside of you.  It is all one side; flat, "
"infinite, and everything you have ever been.  You wonder if you're having no "
"trouble understanding it because your brain works better spread out like this."
msgstr ""
"Il n'y a plus d'intérieur ni d'extérieur en vous. Tout est d'un seul côté, "
"plat, infini, et tout ce que vous avez toujours été. Vous vous demandez si "
"vous n'avez pas de mal à le comprendre parce que votre cerveau fonctionne "
"mieux étalé comme ça."

#: data/json/flags.json
#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "DEBUG_ONLY"
msgid ""
"This is not intended to be visible during normal gameplay.  <bad>Please file "
"a bug report</bad> unless you are seeing this in the debug menu."
msgstr ""
"Ce bug n'est pas censé être visible pendant le jeu normal. <bad>Veuillez "
"remplir un rapport de bogue</bad> à moins que vous ne le voyiez dans le menu "
"de débogage."

#: data/json/flags.json
#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ABLATIVE_CHAINMAIL_ARMS"
#. ~ Description of JSON flag "ABLATIVE_CHAINMAIL_ELBOWS"
#. ~ Description of JSON flag "ABLATIVE_CHAINMAIL_LEGS"
#. ~ Description of JSON flag "ABLATIVE_CHAINMAIL_KNEES"
#. ~ Description of JSON flag "ABLATIVE_CHAINMAIL_TORSO"
msgid ""
"You can use this armor <info>with chainmail</info> without encumbrance "
"penalty."
msgstr ""
"Vous pouvez utiliser cette armure <info>avec de la maille</info> sans "
"pénalité d'encombrement."

#: data/json/flags.json
#. ~ Description of restriction of JSON flag "ABLATIVE_CHAINMAIL_ARMS"
#. ~ Description of restriction of JSON flag "ABLATIVE_CHAINMAIL_ELBOWS"
#. ~ Description of restriction of JSON flag "ABLATIVE_CHAINMAIL_LEGS"
#. ~ Description of restriction of JSON flag "ABLATIVE_CHAINMAIL_KNEES"
#. ~ Description of restriction of JSON flag "ABLATIVE_CHAINMAIL_TORSO"
msgid "Item must be a chainmail compatible armor piece"
msgstr "L'objet doit être une pièce d'armure compatible avec une cotte de maille"

#: data/json/flags.json
#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ABLATIVE_LARGE"
msgid "This plate will fit in <info>large</info> armor pockets."
msgstr ""
"Cette plaque rentrera dans une <info>grande</info> poche pour plaque "
"pare-balles."

#: data/json/flags.json
#. ~ Description of restriction of JSON flag "ABLATIVE_LARGE"
