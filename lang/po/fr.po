#: data/json/items/armor/ballistic_armor.json
#. ~ Item name
#. ~ Variant name of item "US ballistic vest"
msgid "US ballistic vest"
msgid_plural "US ballistic vests"
msgstr[0] "gilet pare-balles US"
msgstr[1] "gilets pare-balles US"
msgstr[2] "gilets pare-balles US"

#: data/json/items/armor/ballistic_armor.json
#. ~ Description of "US ballistic vest"
msgid ""
"A ballistic vest with specialized pockets on the front, back, and sides to "
"hold armor plates.  While this plate carrier is still protective even without "
"inserts, it's too soft to effectively stop high-energy projectiles on its own."
msgstr ""
"Un gilet pare-balles avec des poches spécialisées à l'avant, l'arrière et les "
"deux côtés pour enfiler des plaques. Bien que ce gilet soit tout de même "
"assez bon pour vous protéger de divers types de dégâts, il vous sera "
"néanmoins nécessaire d'y insérer des plaques pour qu'il soit capable "
"d'arrêter des projectiles à haute énergie."

#: data/json/items/armor/ballistic_armor.json
#. ~ Description of variant "US ballistic vest" of item "US ballistic vest"
msgid ""
"This version is patterned in multi-environment camouflage, and was "
"standard-issue for the US Army."
msgstr ""
"Cette version a un motif de camouflage universel et faisait partie de "
"l'équipement standard de l'armée américaine."

#: data/json/items/armor/ballistic_armor.json
#. ~ Variant name of item "US ballistic vest"
msgid "SWAT ballistic vest"
msgid_plural "SWAT ballistic vests"
msgstr[0] "gilet pare-balles SWAT"
msgstr[1] "gilets pare-balles SWAT"
msgstr[2] "gilets pare-balles SWAT"

#: data/json/items/armor/ballistic_armor.json
#. ~ Description of variant "SWAT ballistic vest" of item "US ballistic vest"
msgid ""
"This version is colored black, and was once used by specialized police "
"forces.  \"SWAT\" is emblazoned on the back."
msgstr ""
"Cette version est noire et jugeant l'acronyme SWAT blasonné sur le dos,  "
"faisait partie de l'équipement d'un groupement de police spécialisée."

