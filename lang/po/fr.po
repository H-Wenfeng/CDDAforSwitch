#: data/json/effects_on_condition/addictions_eocs.json
#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_MUTAGEN_ADDICTION"
msgid "You daydream what it'd be like if you were *different*.  Different is good."
msgstr ""
"Vous rêvassez à ce que cela serait si vous étiez *différent*. Être différent, "
"c'est bon!"

#: data/json/effects_on_condition/addictions_eocs.json
#. ~ Player message in nested effect in then statement in nested effect in
#. then statement in false effect in EoC "EOC_MUTAGEN_ADDICTION"
msgid "You haven't had any mutagen lately."
msgstr "Vous n'avez pris aucun mutagène dernièrement."

#: data/json/effects_on_condition/addictions_eocs.json
#. ~ Player message in nested effect in else statement in nested effect in
#. then statement in false effect in EoC "EOC_MUTAGEN_ADDICTION"
msgid "You could use some new parts…"
msgstr "Vous auriez bien envie de nouveaux organes…"

#: data/json/effects_on_condition/bionic_active_eocs.json
#. ~ Player message in effect in EoC "EOC_bio_adrenaline"
msgid "Safeguards kicks in, and the bionic refuses to activate!"
msgstr ""

#: data/json/effects_on_condition/bionic_active_eocs.json
#. ~ Player message in effect in EoC "EOC_time_freeze"
msgid "You cannot activate Time Dilation while mounted."
msgstr ""

#: data/json/effects_on_condition/bionic_active_eocs.json
#. ~ Player message in false effect in EoC "EOC_time_freeze"
msgid "You activate your Time Dilation."
msgstr "Vous activez votre Dilation Temporelle."

#: data/json/effects_on_condition/bionic_active_eocs.json
#. ~ Player message in false effect in EoC "EOC_time_freeze"
msgid "Your speed suddenly increases!"
msgstr "Votre vitesse s'acroit soudainement !"

#: data/json/effects_on_condition/bionic_active_eocs.json
#. ~ Player message in nested effect in then statement in false effect in EoC
#. "EOC_time_freeze"
msgid "Your muscles tear with the strain!"
msgstr "Vos muscles se déchirent sous l'effet de la tension !"

#: data/json/effects_on_condition/bionic_active_eocs.json
#. ~ Player message in effect in EoC "EOC_bio_hydraulics"
msgid "Your muscles hiss as hydraulic strength fills them!"
msgstr "Vos muscles sifflent alors qu'ils sont rempli d'une force hydraulique."

#: data/json/effects_on_condition/bionic_active_eocs.json
