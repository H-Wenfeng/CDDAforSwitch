#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "freshwater snail"
msgid_plural "freshwater snails"
msgstr[0] "escargot d'eau douce"
msgstr[1] "escargots d'eau douce"
msgstr[2] "escargots d'eau douce"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "freshwater snail"
msgid ""
"A tiny and shelled aquatic gastropod of either native or introduced stock.  "
"Dangerous to eat raw but properly cooked and cleaned it may serve as a fine "
"dish."
msgstr ""
"Un gastropode aquatique et muni d'une coquille natif ou introduit dans cet "
"écosystème. Bien qu'il soit dangereux à manger cru, un bon cuisinier peu le "
"transformer en plat gourmet."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "oversized snail"
msgid_plural "oversized snails"
msgstr[0] "escargot surdimensionné"
msgstr[1] "escargots surdimensionnés"
msgstr[2] "escargots surdimensionnés"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "oversized snail"
msgid ""
"A shelled gastropod either of native or introduced stock.  This one looks "
"larger than usual."
msgstr ""
"Gastéropode à coquille d'origine indigène ou introduite. Celui-ci semble plus "
"grand que d'habitude."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "giant snail"
msgid_plural "giant snails"
msgstr[0] "escargot gigantesque"
msgstr[1] "escargots gigantesques"
msgstr[2] "escargots gigantesques"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "giant snail"
msgid "A snail grown to human size.  Its mouth and underside dripping acid."
msgstr ""
"Un escargot ayant grossi jusqu'à atteindre la taille d'un homme adulte, sa "
"gueule et son pied gluant répandant de l'acide fumant partout où il passe."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "snail larva"
msgid_plural "snail larvae"
msgstr[0] "larve d'escargot"
msgstr[1] "larves d'escargot"
msgstr[2] "larves d'escargot"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "snail larva"
msgid "A small snail larva."
msgstr "Une petite larve d'escargot."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "colossal snail"
msgid_plural "colossal snails"
msgstr[0] "escargot colossal"
msgstr[1] "escargots colossaux"
msgstr[2] "escargots colossaux"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "colossal snail"
msgid ""
"An enormous gastropod with a massive shell on its back.  It slowly crawls "
"over the ground while leaving acid in its path."
msgstr ""
"Un énorme gastéropode avec une énorme coquille sur le dos. Il rampe lentement "
"sur le sol en laissant de l'acide sur son passage."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "oversized slug"
msgid_plural "oversized slugs"
msgstr[0] "limace surdimensionnée"
msgstr[1] "limaces surdimensionnées"
msgstr[2] "limaces surdimensionnées"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "oversized slug"
msgid ""
"A gastropod either of native or introduced stock.  This one looks larger than "
"usual."
msgstr ""
"Un gastéropode indigène ou introduit. Celui-ci semble plus grand que "
"d'habitude."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "giant slug"
msgid_plural "giant slugs"
msgstr[0] "limace gigantesque"
msgstr[1] "limaces gigantesques"
msgstr[2] "limaces gigantesques"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "giant slug"
msgid ""
"A disturbingly large mutated slug as large as a human.  Venom drips from what "
"must be its mouth, and it is covered with sticky mucus."
msgstr ""
"Une limace mutante d'une taille inquiétante, aussi grande qu'un humain. Du "
"venin coule de ce qui doit être sa bouche, et elle est couverte de mucus "
"collant."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "slug larva"
msgid_plural "slug larvae"
msgstr[0] "larve de limace"
msgstr[1] "larves de limace"
msgstr[2] "larves de limace"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "slug larva"
msgid "A small slug larva."
msgstr "Une petite larve de limace."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "colossal slug"
msgid_plural "colossal slugs"
msgstr[0] "limace colossale"
msgstr[1] "limaces colossales"
msgstr[2] "limaces colossales"

#: data/json/monsters/mollusk.json
#. ~ Description of monster "colossal slug"
msgid ""
"A mutated leopard slug, as wide as a golf cart.  Venom dripping from its "
"fanged maw as it slithers around slowly, leaving a trail of glistening slime."
msgstr ""
"Une limace léopard mutante, aussi large qu'un caddy. Le venin dégoulinent de "
"ses défenses alors qu'elle glisse doucement, laissant une trace de slime "
"gluant."

#: data/json/monsters/mollusk.json
#. ~ Monster name
msgid "sludge crawler"
msgid_plural "sludge crawlers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/monsters/mollusk.json
#. ~ Description of monster "sludge crawler"
msgid ""
"A sluglike creature, eight feet long and the width of a refrigerator.  Its "
"black body glistens as it oozes its way along the ground.  Eyestalks "
"occasionally push their way out of the oily mass and look around."
msgstr ""
"Une créature ressemblant à une limace, longue de deux mètres et large comme "
"un réfrigérateur. Son corps noir luit tandis qu'elle se fraye un chemin sur "
"le sol. De temps en temps, des paupières sortent de la masse huileuse et "
"regardent autour d'elles."

#: data/json/monsters/mutant.json
#. ~ Monster name
msgid "experimental mutant"
msgid_plural "experimental mutants"
msgstr[0] "mutant expérimental"
msgstr[1] "mutants expérimentaux"
msgstr[2] "mutants expérimentaux"

#: data/json/monsters/mutant.json
#. ~ Description of monster "experimental mutant"
msgid ""
"A deformed mutant in a torn jumpsuit, looking at you with insane hatred.  "
"Their skin is a chaotic mix of scales, fur and chitin, and their fingers end "
"in long talons."
msgstr ""
"Un mutant difforme, vêtu d'une combinaison déchirée, vous regarde avec une "
"haine insensée. Sa peau est un mélange chaotique d'écailles, de fourrure et "
"de chitine, et ses doigts se terminent par de longues serres."

#: data/json/monsters/mutant.json
#. ~ Monster name
msgid "bestial mutant"
msgid_plural "bestial mutants"
msgstr[0] "mutant bestial"
msgstr[1] "mutants bestiaux"
msgstr[2] "mutants bestiaux"

#: data/json/monsters/mutant.json
#. ~ Description of monster "bestial mutant"
msgid ""
"A towering mutated test subject, covered in thick fur and the torn bottom "
"part of a jumpsuit.  Their legs end in large padded feet not unlike a dog's, "
"but they still manage to stand upright, freeing up their clawed hands to tear "
"you apart."
msgstr ""
"Un imposant cobaye mutant, recouvert d'une épaisse fourrure et du bas déchiré "
"d'une combinaison. Ses jambes se terminent par de larges pattes rembourrées "
"qui ne sont pas sans rappeler celles d'un chien, mais il parvient tout de "
"même à se tenir debout, libérant ainsi ses mains griffues pour vous mettre en "
"pièces."

#: data/json/monsters/mutant.json
#. ~ Monster name
msgid "ungulate mutant"
msgid_plural "ungulate mutants"
msgstr[0] "mutant ongulé"
msgstr[1] "mutants ongulés"
msgstr[2] "mutants ongulés"

#: data/json/monsters/mutant.json
#. ~ Description of monster "ungulate mutant"
msgid ""
"A gigantic mutated test subject, still wearing the tattered remains of an "
"orange jumpsuit.  They walk on four warped legs ending in hooves, and their "
"head is dominated by a glistening, tangled crown of antlers that scratch the "
"ceiling."
msgstr ""
"Un gigantesque cobaye mutant, portant encore les restes d'une combinaison "
"orange. Il marche sur quatre jambes déformées terminées par des sabots, et sa "
"tête est dominée par une couronne de bois étincelante et enchevêtrée qui raye "
"le plafond."

#: data/json/monsters/mutant.json
#. ~ Monster name
msgid "arthropod mutant"
msgid_plural "arthropod mutants"
msgstr[0] "mutant arthropoïde"
msgstr[1] "mutants arthropoïdes"
msgstr[2] "mutants arthropoïdes"

#: data/json/monsters/mutant.json
#. ~ Description of monster "arthropod mutant"
msgid ""
"A horribly mutated experimental subject.  Their original body - still wearing "
"an orange jumpsuit - flops around lifelessly, carried by twelve segmented "
"legs covered in hairy chitin erupting from their back.  At the base of the "
"front pair of legs, an almost-human scalp gives way to a dozen "
"irregularly-sized eyes and a set of mandibles, and from their hind end a "
"stinger not unlike a scorpion's emerges."
msgstr ""
"Un sujet d'expérience horriblement muté. Son corps d'origine - toujours vêtu "
"d'une combinaison orange - flotte sans vie, porté par douze pattes segmentées "
"couvertes de chitine poilue qui jaillissent de son dos. À la base de la paire "
"de jambes avant, un cuir chevelu presque humain laisse place à une douzaine "
"d'yeux de taille irrégulière et à un ensemble de mandibules, et de leur "
"extrémité arrière émerge un dard semblable à celui d'un scorpion."

#: data/json/monsters/mutant.json
#. ~ Monster name
msgid "camouflaged mutant"
msgid_plural "camouflaged mutants"
msgstr[0] "mutant caméléon"
msgstr[1] "mutants caméléons"
msgstr[2] "mutants caméléons"

#: data/json/monsters/mutant.json
#. ~ Description of monster "camouflaged mutant"
msgid ""
"A mutated test subject, running on all fours at alarming speed.  Their short "
"fur changes color to match the background in an instant, making you struggle "
"to keep the thing in focus.  Their thin limbs end in long talons, and their "
"mouth is held perpetually open by a set of knife-sized fangs."
msgstr ""
"Un sujet de test mutant, courant à quatre pattes à une vitesse alarmante. Sa "
"fourrure courte change de couleur en un instant pour s'adapter à "
"l'arrière-plan, ce qui vous oblige à vous efforcer de faire la mise au point "
"sur l'objet. Ses membres fins se terminent par de longues serres et sa bouche "
"est maintenue perpétuellement ouverte par une série de crocs de la taille "
"d'un couteau."

#: data/json/monsters/mutant.json
#. ~ Monster name
msgid "transcendent mutant"
msgid_plural "transcendent mutants"
msgstr[0] "mutant transcendant"
msgstr[1] "mutants transcendants"
msgstr[2] "mutants transcendants"

#: data/json/monsters/mutant.json
#. ~ Description of monster "transcendent mutant"
msgid ""
"An experimental subject wearing a surprisingly clean orange jumpsuit.  They "
"look unchanged at a distance, but as you approach their head spins towards "
"you with unnatural speed.  Their face is disconcertingly beautiful, but their "
"eyes shine with an intelligence far beyond human - and a deep disgust "
"directed at you."
msgstr ""
"Un sujet expérimental portant une combinaison orange étonnamment propre. Il "
"semble inchangé à distance, mais lorsque vous vous approchez de lui, sa tête "
"tourne vers vous à une vitesse anormale. Son visage est d'une beauté "
"déconcertante, mais ses yeux brillent d'une intelligence bien supérieure à "
"celle de l'homme - et d'un profond dégoût à votre égard."

#: data/json/monsters/mutant.json
#. ~ Monster message of special attack of monster "transcendent mutant"
msgid ""
"The mutant gestures at you and barks a few orders, sending its pack of "
"mutants into a frenzy."
msgstr ""
"Le mutant vous fait un geste et aboie quelques ordres, ce qui met sa meute de "
"mutants en ébullition."

#: data/json/monsters/mutant.json
#. ~ Monster name
msgid "mutant child"
msgid_plural "mutant children"
msgstr[0] "enfant mutant"
msgstr[1] "enfants mutants"
msgstr[2] "enfants mutants"

#: data/json/monsters/mutant.json
#. ~ Description of monster "mutant child"
msgid ""
"A thin child with a shaved head, wearing a too-large white lab coat over a "
"baggy orange jumpsuit.  They turn their head towards you with uncanny speed, "
"and you're taken aback by the inhuman curiosity burning in their eyes.  Their "
"angelic smile does very little to reassure you of their intentions."
msgstr ""
"Un enfant maigre au crâne rasé, vêtu d'une blouse blanche trop grande sur une "
"combinaison orange trop large. Il tourne la tête vers vous avec une rapidité "
"déconcertante, et vous êtes surpris par la curiosité inhumaine qui brûle dans "
"ses yeux. Leur sourire angélique n'est pas de nature à vous rassurer sur "
"leurs intentions."

#: data/json/monsters/mutant.json
#. ~ Death message of monster "mutant child"
msgid ""
"The child's eyes widen, and they try to say something before falling to the "
"ground."
msgstr ""
"Les yeux de l'enfant s'écarquillent et il essaie de dire quelque chose avant "
"de tomber par terre."

#: data/json/monsters/mutant.json
#. ~ Monster name
msgid "shelled mutant"
msgid_plural "shelled mutants"
msgstr[0] "mutant gastropode"
msgstr[1] "mutants gastropodes"
msgstr[2] "mutants gastropodes"

#: data/json/monsters/mutant.json
#. ~ Description of monster "shelled mutant"
msgid ""
"An enormous mutant hidden beneath a gray segmented shell, crawling on a "
"carpet of innumerable tentacles covered with suckers.  They hold three "
"thicker, branching limbs high on their front end, each dotted with dozens of "
"unblinking eyeballs."
msgstr ""
"Un énorme mutant caché sous une carapace grise et segmentée, rampant sur un "
"tapis d'innombrables tentacules couverts de ventouses. Il porte à l'avant "
"trois membres épais et ramifiés, parsemés de dizaines de globes oculaires qui "
"ne clignent pas des yeux."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "Cerbearus"
msgid_plural "Cerbearuses"
msgstr[0] "Cerbère"
msgstr[1] "Cerbères"
msgstr[2] "Cerbères"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "Cerbearus"
msgid ""
"Sometime between the Cataclysm and now, this black bear has gained two extra "
"heads.  This doesn't seem to have improved its disposition."
msgstr ""
"Entre le Cataclysme et aujourd'hui, cet ours noir a gagné deux têtes "
"supplémentaires. Cela ne semble pas avoir amélioré son comportement."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "dambreaker"
msgid_plural "dambreakers"
msgstr[0] "briseur de barrage"
msgstr[1] "briseurs de barrage"
msgstr[2] "briseurs de barrage"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "dambreaker"
msgid ""
"This mutated beaver is almost double its normal size, and its back is covered "
"with tough-looking bristles."
msgstr ""
"Ce castor mutant a presque deux fois la taille de ces congénères normaux, et "
"son dos est couvert d'épines acérées."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "dambreaker kit"
msgid_plural "dambreaker kits"
msgstr[0] "chaton de briseur de barrage"
msgstr[1] "chatons de briseur de barrage"
msgstr[2] "chatons de briseur de barrage"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "dambreaker kit"
msgid "An unnaturally large baby beaver with an array of bristles covering its back."
msgstr ""
"Un bébé castor anormalement grand dont le dos est recouvert d'une multitude "
"de poils."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "feaver"
msgid_plural "feavers"
msgstr[0] "castor multicolore"
msgstr[1] "castors multicolores"
msgstr[2] "castors multicolores"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "feaver"
msgid ""
"This mutant beaver's body is covered with brightly-colored feathers in a "
"particularly eyecatching pattern.  It must have been very lucky not to have "
"been caught by a predator before now."
msgstr ""
"Le corps de ce castor mutant est recouvert de plumes aux couleurs vives qui "
"forment un motif particulièrement accrocheur. Il a dû avoir beaucoup de "
"chance de ne pas avoir été attrapé par un prédateur auparavant."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "bald beaver kit"
msgid_plural "bald beaver kits"
msgstr[0] "castoreau nu"
msgstr[1] "castoreaux nus"
msgstr[2] "castoreaux nus"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "bald beaver kit"
msgid ""
"This beaver kit lacks any fur covering its body, instead looking reminiscent "
"of a plucked chicken."
msgstr ""
"Ce kit de castor n'a pas de fourrure sur le corps et ressemble plutôt à un "
"poulet plumé."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "grinning coyote"
msgid_plural "grinning coyotes"
msgstr[0] "coyote grimaçant"
msgstr[1] "coyotes grimaçants"
msgstr[2] "coyotes grimaçants"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "grinning coyote"
msgid ""
"Were it not for the misshapen snout and visible teeth, this would look like "
"an ordinary Northeastern coyote.  Closer inspection of its mouth reveals row "
"after row of serrated, shark-like teeth."
msgstr ""
"Vous pourriez probablement vous dire que ceci n'est qu'un coyote du Nord-Est "
"ordinaire si vous arriviez à ignorer son museau difforme et ses babines "
"fendues en un rictus exposant plusieurs rangées de dents dentelées ayant "
"l'air d'avoir été volées de la gueule d'un requin."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "grinning coyote pup"
msgid_plural "grinning coyote pups"
msgstr[0] "chiot de coyote grimacant"
msgstr[1] "chiots de coyote grimacant"
msgstr[2] "chiots de coyote grimacant"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "grinning coyote pup"
#. ~ Description of monster "slavering coyote pup"
msgid "A cute coyote pup.  Though, on a closer look, something is off about it."
msgstr ""
"Un petit chiot de coyote mignon.  Uhm, en regardant de plus près, il a l'air "
"assez bizarre."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "slavering coyote"
msgid_plural "slavering coyotes"
msgstr[0] "coyote écumant"
msgstr[1] "coyotes écumants"
msgstr[2] "coyotes écumants"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "slavering coyote"
msgid ""
"Unnatural bulges line the neck of this obviously-mutated coyote; green-tinted "
"foam flecks from its lips, and there's a crazed look in its eyes."
msgstr ""
"Des bourrelets n'ayant pas l'air naturels enflent le cou de ce coyote "
"évidemment mutant. L'écume verdâtre s'écoulant de ses babines et la lueur de "
"folie dans ses yeux vous suggère que l'abattre serait une pitié."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "slavering coyote pup"
msgid_plural "slavering coyote pups"
msgstr[0] "chiot de coyote écumant"
msgstr[1] "chiots de coyote écumant"
msgstr[2] "chiots de coyote écumant"

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "spideer"
msgid_plural "spideers"
msgstr[0] "cerf arachnide"
msgstr[1] "cerfs arachnide"
msgstr[2] "cerfs arachnide"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "spideer"
msgid ""
"This once-ordinary deer has grown a disturbingly agile array of extra limbs, "
"plus three extra eyes.  Its antlers wriggle subtly in the wind."
msgstr ""
"Un cerf mutant ayant développé quatres pattes supplémentaires sur lesquelles "
"celui-ci se déplace avec une agilité déroutante, ainsi que trois yeux "
"supplémentaires et des bois gigotants de temps à autre."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "spideer fawn"
msgid_plural "spideer fawns"
msgstr[0] "faon arachnide"
msgstr[1] "faons arachnides"
msgstr[2] "faons arachnides"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "spideer fawn"
msgid ""
"This obviously mutated adolescent deer moves unsteadily on its eight legs, "
"nervously scanning the area with all five eyes."
msgstr ""
"Un jeune cerf évidemment mutant se déplaçant en chancelant sur ses huit "
"pattes et scannant nerveusement les environs avec ces cinq yeux. "

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "mongrel"
msgid_plural "mongrels"
msgstr[0] "bâtard mutant"
msgstr[1] "bâtards mutants"
msgstr[2] "bâtards mutants"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "mongrel"
msgid ""
"This dog of unidentifiable breed looks like it has seen better days.  Its "
"wiry hair is patchy, revealing scales underneath, but it still happily wags "
"its tails anyways."
msgstr ""
"Ce chien de race non identifiable semble avoir connu des jours meilleurs. Son "
"poil dur est parsemé de taches, laissant apparaître des écailles, mais il "
"remue quand même joyeusement la queue."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "Loper"
msgid_plural "Lopers"
msgstr[0] "Chien mutant"
msgstr[1] "Chiens mutants"
msgstr[2] "Chiens mutants"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "Loper"
msgid ""
"This dog has undergone visible mutation.  While its body is larger than "
"normal, its legs are noticeably elongated, muscular and covered in long "
"cord-like fur.  It easily stands as tall as you and watches your every move "
"closely with reflective eyes."
msgstr ""
"Ce chien a subi une mutation visible. Si son corps est plus grand que la "
"normale, ses pattes sont sensiblement allongées, musclées et recouvertes "
"d'une longue fourrure en forme de corde. Il est facilement aussi grand que "
"vous et observe attentivement chacun de vos mouvements avec des yeux "
"réfléchissants."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "Loper puppy"
msgid_plural "Loper puppies"
msgstr[0] "Chiot mutant"
msgstr[1] "Chiots mutants"
msgstr[2] "Chiots mutants"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "Loper puppy"
msgid ""
"An adorable, but unusual puppy.  It wags its tail happily but something about "
"its legs seems off."
msgstr ""
"Un chiot adorable, mais inhabituel. Il remue joyeusement la queue, mais ses "
"pattes semblent mal placées."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "Mauler"
msgid_plural "Maulers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "Mauler"
msgid ""
"This stocky dog has undergone visible mutation.  Its jaw has widened and "
"features more teeth than any dog should ever have.  While its toothy grin is "
"unnerving, its tail wags as energetically as ever."
msgstr ""
"Ce chien trapu a subi une mutation visible. Sa mâchoire s'est élargie et "
"comporte plus de dents qu'aucun chien ne devrait jamais en avoir. Si son "
"rictus est déconcertant, sa queue remue toujours aussi énergiquement."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "Mauler puppy"
msgid_plural "Mauler puppies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "Mauler puppy"
msgid ""
"An adorable, but unusual puppy.  It wags its tail happily but something about "
"its mouth seems off."
msgstr ""
"Un chiot adorable, mais inhabituel. Il remue joyeusement la queue, mais "
"quelque chose dans sa bouche semble anormal."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "Thrasher"
msgid_plural "Thrashers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "Thrasher"
msgid ""
"This dog has undergone visible mutation.  Its paws are larger than normal and "
"have developed long digging nails.  Its fur is extremely short, barely "
"covering its leathery skin."
msgstr ""
"Ce chien souffre de mutations visibles. Ces pattes avant sont beaucoup plus "
"larges et musclées que la normale et ont développées de longues griffes ayant "
"l'air adaptées pour creuser. Sa fourrure est extrêmement courte, donnant "
"l'impression que la peau tannée de celui-ci est chauve en plusieurs endroits."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "Thrasher puppy"
msgid_plural "Thrasher puppies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "Thrasher puppy"
msgid ""
"An adorable, but unusual puppy.  It wags its tail happily but something about "
"its paws seems off."
msgstr ""
"Un chiot adorable, mais anormal. Sa queue s'agite de joie mais quelque chose "
"avec ses pattes avant ne va vraiment pas."

#: data/json/monsters/mutant_mammal.json
#. ~ Monster name
msgid "dextrous raccoon"
msgid_plural "dextrous raccoons"
msgstr[0] "raton-laveur adroit"
msgstr[1] "ratons-laveurs adroits"
msgstr[2] "ratons-laveurs adroits"

#: data/json/monsters/mutant_mammal.json
#. ~ Description of monster "dextrous raccoon"
msgid ""
"Its paws have grown to be longer, and it seems capable of briefly standing on "
"its hindlimbs.  You wonder if this sleazy beast is able to open doors yet."
msgstr ""

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "albino penguin"
msgid_plural "albino penguins"
msgstr[0] "pingouin albinos"
msgstr[1] "pingouins albinos"
msgstr[2] "pingouins albinos"

#: data/json/monsters/nether.json
#. ~ Description of monster "albino penguin"
msgid ""
"An eight-foot-tall, ghastly white penguin.  Its muscular body suggests "
"immense strength, but it seems placid unless otherwise provoked."
msgstr ""
"Un pingouin blanc effroyable de deux mètres de haut. Son corps musclé suggère "
"une force immense, mais il semble placide à moins d'être provoqué."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "amigara horror"
msgid_plural "amigara horrors"
msgstr[0] "horreur d'Amigara"
msgstr[1] "horreurs d'Amigara"
msgstr[2] "horreurs d'Amigara"

#: data/json/monsters/nether.json
#. ~ Description of monster "amigara horror"
msgid ""
"A hellish, vaguely humanoid horror, two stories tall.  Its face is "
"grotesquely stretched out, its limbs deformed to unrecognizable outgrowths."
msgstr ""
"Une créature vaguement humaine des enfers haute comme deux étages. Son visage "
"est étiré et ses membres déformés par des excroissances."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "blank body"
msgid_plural "blank bodies"
msgstr[0] "corps pâle"
msgstr[1] "corps pâles"
msgstr[2] "corps pâles"

#: data/json/monsters/nether.json
#. ~ Description of monster "blank body"
msgid ""
"This is some form of unnatural changeling creature; its appearance is a bland "
"mockery of the human form.  Featureless and pale, its repugnant countenance "
"is all the more unsettling due to its lack of eyes and distinguishing "
"features except for a perfectly round mouth.  Adding to its unearthly "
"appearance is the way it moves, stiff and doll-like as though it was only "
"feigning knowing how to walk."
msgstr ""
"Une créature totalement contre-nature, son apparence vaguement humanoïde, "
"mais pale et sans détails une parodie totale de la forme humaine. Sa posture "
"étrange et rendue d'autant plus dérangeante par le fait qu'elle ne possède "
"pas d'yeux, la seule chose présente sur ce qui devrait être sa tête étant une "
"gueule énorme parfaitement circulaire et le fait que cette abomination se "
"déplace de façon raide comme un mannequin échouant totalement à imiter la "
"démarche d'un être humain."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "blood sacrifice"
msgid_plural "blood sacrifices"
msgstr[0] "agneau sacrificiel"
msgstr[1] "agneaux sacrificiels"
msgstr[2] "agneaux sacrificiels"

#: data/json/monsters/nether.json
#. ~ Description of monster "blood sacrifice"
msgid ""
"A defiled human body, once living.  Tortured to death long ago, it remains "
"chained to the altar, the putrescent flays of its peeled skin quivering like "
"so much flotsam upon a murky pond."
msgstr ""
"Un corps humain souillé, autrefois vivant. Torturé à mort il y a longtemps, "
"il reste enchaîné à l'autel, les lambeaux putrescents de sa peau pelée "
"frémissant comme autant d'épaves sur un étang trouble."

#: data/json/monsters/nether.json data/json/monsters/zed_amalgamation.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_floraxeno.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_floraxeno.json
#. ~ Monster name
#. ~ Furniture name
msgid "breather"
msgid_plural "breathers"
msgstr[0] "poumon"
msgstr[1] "poumons"
msgstr[2] "poumons"

#: data/json/monsters/nether.json data/json/monsters/zed_amalgamation.json
#. ~ Description of monster "breather"
msgid ""
"This is some sort of unearthly pink flesh sac; moist and ridged with veins, "
"it is otherwise without discernible exterior features.  Seemingly immobile "
"and defenseless, it sits in place, swelling and collapsing upon itself as it "
"breathes."
msgstr ""
"Il s'agit d'une sorte de sac de chair d'un rose étrange ; humide et strié de "
"veines, il est par ailleurs dépourvu de caractéristiques extérieures "
"discernables. Apparemment immobile et sans défense, il reste sur place, se "
"gonflant et s'effondrant sur lui-même au fur et à mesure qu'il respire."

#: data/json/monsters/nether.json data/json/monsters/zed_amalgamation.json
#. ~ Description of monster "breather"
msgid ""
"A weird mass of immobile, breathing pink goo.  The other breathers seem to "
"originate from this one."
msgstr ""
"Une étrange masse de glu rose immobile et respirable. Les autres respirateurs "
"semblent provenir de celui-ci."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "shrapnel swarm"
msgid_plural "shrapnel swarms"
msgstr[0] "essaim de shrapnel"
msgstr[1] "essaims de shrapnel"
msgstr[2] "essaims de shrapnel"

#: data/json/monsters/nether.json
#. ~ Description of monster "shrapnel swarm"
msgid ""
"Uncountable jagged spikes, cleaving reality as they fly through its invisible "
"seams."
msgstr ""
"D'innombrables pointes dentelées fendent la réalité en volant à travers ses "
"coutures invisibles."

#: data/json/monsters/nether.json
#. ~ Death message of monster "shrapnel swarm"
#, c-format
msgid "The %s grows inert."
msgstr "L'%s devient inerte."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "structural spur"
msgid_plural "structural spurs"
msgstr[0] "éperon structurel"
msgstr[1] "éperons structurels"
msgstr[2] "éperons structurels"

#: data/json/monsters/nether.json
#. ~ Description of monster "structural spur"
msgid ""
"Misshapen spikes of concrete and rebar crumble upwards from the floor, held "
"aloft by strands of visual distortion.  Sound around it is drowned and "
"distorted into an incessant drone."
msgstr ""
"Des pointes difformes de béton et de barres d'armature se détachent du sol, "
"maintenues en l'air par des fils de distorsion visuelle. Le son qui l'entoure "
"est noyé et déformé en un bourdonnement incessant."

#: data/json/monsters/nether.json
#. ~ Death message of monster "structural spur"
#, c-format
msgid "The distortion fades as the %s crumbles."
msgstr ""

#: data/json/monsters/nether.json
#. ~ Monster message of special attack of monster "structural spur"
msgid "Scraps of metal fly off the spur and into the nearby swarms!"
msgstr ""
"Des morceaux de métal s'envolent de l'éperon et se retrouvent dans les "
"essaims voisins !"

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "void weaver"
msgid_plural "void weavers"
msgstr[0] "tisseuse du vide"
msgstr[1] "tisseuses du vide"
msgstr[2] "tisseuses du vide"

#: data/json/monsters/nether.json
#. ~ Description of monster "void weaver"
msgid ""
"Articulated limbs slip into the outlines of shadow, each a conduit for the "
"kaleidoscopic maw from which they emerge."
msgstr ""
"Les membres articulés se glissent dans les contours de l'ombre, chacun étant "
"un conduit pour la gueule kaléidoscopique d'où il émerge."

#: data/json/monsters/nether.json
#. ~ Death message of monster "void weaver"
#, c-format
msgid "The %s dissolves into inert shadows."
msgstr "La %s se dissout en un amas d'ombres inertes."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "hanging maw"
msgid_plural "hanging maws"
msgstr[0] "gueule pendante"
msgstr[1] "gueules pendantes"
msgstr[2] "gueules pendantes"

#: data/json/monsters/nether.json
#. ~ Description of monster "hanging maw"
msgid ""
"An explosion of glistening fangs, itself but a small reflection of the "
"greater horror."
msgstr ""
"Une explosion de crocs luisants, qui n'est elle-même qu'un petit reflet de "
"l'horreur plus grande."

#: data/json/monsters/nether.json
#. ~ Death message of monster "hanging maw"
#. ~ Death message of monster "hanging limb"
#. ~ Death message of monster "weaver juvenile"
#, c-format
msgid "The %s shatters like pane of glass."
msgstr ""

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "hanging limb"
msgid_plural "hanging limbs"
msgstr[0] "membre pendant"
msgstr[1] "membres pendants"
msgstr[2] "membres pendants"

#: data/json/monsters/nether.json
#. ~ Description of monster "hanging limb"
msgid "A limb of shadow, itself but a small reflection of a greater horror."
msgstr ""
"Un membre à peine étendu dans votre réalité, rien qu'une extrémité d'une "
"horreur bien plus vaste."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "weaver juvenile"
msgid_plural "weaver juveniles"
msgstr[0] "tisseuse juvénile"
msgstr[1] "tisseuses juvéniles"
msgstr[2] "tisseuses juvéniles"

#: data/json/monsters/nether.json
#. ~ Description of monster "weaver juvenile"
msgid ""
"The distressed movements of the juvenile reveal conjoined layers of flailing "
"legs and fangs.  It is no spider as you know it."
msgstr ""
"Les mouvements de détresse de cette créature juvénile révèle une multitude "
"agitée de membres et crocs joints ensemble à des longueurs aléatoires. Ceci "
"n'est rien qui soit vaguement semblable à ce que vous pourriez décrire comme "
"une araignée."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "skewered juvenile"
msgid_plural "skewered juveniles"
msgstr[0] "juvénile empalé"
msgstr[1] "juvéniles empalés"
msgstr[2] "juvéniles empalés"

#: data/json/monsters/nether.json
#. ~ Description of monster "skewered juvenile"
msgid "Layers of flailing limbs struggle against an impaled emerald lance."
msgstr "Des couches de membres agités luttent contre une lance d'émeraude empalée."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "wraith"
msgid_plural "wraiths"
msgstr[0] "spectre"
msgstr[1] "spectres"
msgstr[2] "spectres"

#: data/json/monsters/nether.json
#. ~ Description of monster "wraith"
msgid ""
"A gigantic shadow, chaotically changing in shape and volume.  Two piercing "
"orbs of light dominate what can only be described as its head."
msgstr ""
"Une ombre gigantesque, dont la forme et le volume changent de façon "
"chaotique. Deux orbes de lumière perçants dominent ce qui ne peut être décrit "
"que comme sa tête."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "dementia"
msgid_plural "dementias"
msgstr[0] "dément lobotomisé"
msgstr[1] "déments lobotomisés"
msgstr[2] "déments lobotomisés"

#: data/json/monsters/nether.json
#. ~ Description of monster "dementia"
msgid ""
"A crazed individual, the bloody scars on the side of its shaved head suggest "
"some sort of partial lobotomy."
msgstr ""
"Le crâne rasé de cette personne porte les signes révélateurs d'une lobotomie "
"partielle, et la lueur dans ses yeux révèle que les parties retirées étaient "
"assez essentielles pour sa santé mentale."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "dog"
msgid_plural "dogs"
msgstr[0] "chien"
msgstr[1] "chiens"
msgstr[2] "chiens"

#: data/json/monsters/nether.json
#. ~ Description of monster "dog"
msgid ""
"A domesticated mongrel of the canine persuasion.  In the absence of human "
"society, it has turned feral."
msgstr ""
"Un bâtard domestiqué de l'espèce canine. En l'absence de société humaine, il "
"est devenu sauvage."

#: data/json/monsters/nether.json
#. ~ Death message of monster "dog"
#. ~ Death message of monster "tentacle dog"
#, c-format
msgid "The %s emerges!"
msgstr "Le %s émerge!"

#: data/json/monsters/nether.json data/mods/Magiclysm/monsters/nether.json
#: data/mods/No_Hope/monsters.json
#: data/mods/Xedra_Evolved/monsters/monster.json
#. ~ Monster name
msgid "flaming eye"
msgid_plural "flaming eyes"
msgstr[0] "œil ardent"
msgstr[1] "yeux ardents"
msgstr[2] "yeux ardents"

#: data/json/monsters/nether.json
#. ~ Description of monster "flaming eye"
msgid ""
"An enormous disembodied eyeball the size of a person, flying through the air "
"through some unknown agency.  Wreathed in unnatural flickering blue flame, it "
"possesses a blazing yellow iris with a slitted pupil like that of a cat, and "
"trails a set of flailing black tendrils as it slowly drifts about.  You "
"involuntarily get a heavy, sinking feeling deep in your gut as you watch its "
"gaze comb over the world around it."
msgstr ""

#: data/json/monsters/nether.json data/mods/Magiclysm/monsters/nether.json
#: data/mods/Mythos-Creatures/monsters/mythos.json
#. ~ Monster name
msgid "flying polyp"
msgid_plural "flying polyps"
msgstr[0] "polype volant"
msgstr[1] "polypes volants"
msgstr[2] "polypes volants"

#: data/json/monsters/nether.json
#. ~ Description of monster "flying polyp"
msgid ""
"A half-polypous, utterly alien creature.  It's only partly material and has "
"the ability to fly, despite the absence of wings.  It produces strange "
"whistling noises which dominate every other sound."
msgstr ""
"Un énorme globe oculaire désincarné de la taille d'une personne, volant dans "
"les airs par le biais d'une agence inconnue. Enveloppé d'une flamme bleue "
"vacillante, il possède un iris jaune flamboyant avec une pupille fendue comme "
"celle d'un chat, et traîne une série de vrilles noires qui s'agitent tandis "
"qu'il dérive lentement. Vous éprouvez involontairement un sentiment de "
"lourdeur et d'affaissement au fond de vos tripes en regardant son regard se "
"poser sur le monde qui l'entoure."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "star vampire"
msgid_plural "star vampires"
msgstr[0] "vampire stellaire"
msgstr[1] "vampires stellaires"
msgstr[2] "vampires stellaires"

#: data/json/monsters/nether.json
#. ~ Description of monster "star vampire"
msgid ""
"Originally invisible, you can now see the myriad thin tentacles tipped with "
"gnashing maws that make up this creature.  The small central body is "
"dominated by an enormous fanged mouth from which emerges a near-constant "
"high-pitched tittering."
msgstr ""

#: data/json/monsters/nether.json
#. ~ Monster attack message
#, c-format
msgid "%1$s bites your %2$s with its fang-filled maw!"
msgstr "%1$s mords votre %2$s avec sa gueule remplie de crocs!"

#: data/json/monsters/nether.json
