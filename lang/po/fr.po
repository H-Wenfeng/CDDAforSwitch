#. ~ Furniture name
msgid "short mound of dirt with seed"
msgstr "petit monticule de terre semée"

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Description of furniture "short mound of dirt with seed"
msgid ""
"An area of heaped dirt, not easily traversable.  Someone has planted a seed "
"here."
msgstr ""
"Une zone de terre entassée, difficilement praticable. Quelqu'un a planté une "
"graine ici."

#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Furniture name
msgid "short mound of dirt with seedling"
msgstr "petit monticule de terre avec semis"

