#. ~ Player message in false effect in EoC "EOC_VAMPIRE_MIST_FORM_activated_2"
#. in nested EOCs in effect in EoC "EOC_VAMPIRE_MIST_FORM_activated"
msgid "You don't have enough blood to transform into mist."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_VAMPIRE_MIST_FORM_deactivated" in
#. nested EOCs in false effect in EoC "EOC_VAMPIRE_MIST_FORM_activated"
msgid "You reconstitute yourself from the billowing mists."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_VAMPIRE_MIST_FORM_BLOOD_COST_2" in nested EOCs in effect in EoC
#. "EOC_VAMPIRE_MIST_FORM_BLOOD_COST"
msgid "You don't have enough blood to maintain your mist form."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Message in effect in EoC "EOC_VAMPIRE_MIST_FORM_SEEP_THROUGH_DOOR_WINDOW"
msgid "Select door or window."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Message in nested effect in then statement in effect in EoC
#. "EOC_VAMPIRE_MIST_FORM_SEEP_THROUGH_DOOR_WINDOW"
msgid "Select where to appear."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Success message in teleportation in nested effect in then statement in
#. effect in EoC "EOC_VAMPIRE_MIST_FORM_SEEP_THROUGH_DOOR_WINDOW"
msgid "In a second, you were always inside."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in nested effect in else statement in effect in EoC
#. "EOC_VAMPIRE_MIST_FORM_SEEP_THROUGH_DOOR_WINDOW"
msgid "You must be near a door or window to seep through."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "eoc_vampire_blood_to_kcal_convert"
msgid ""
"Some of your stolen blood is consumed by your body, making it a little less "
"gaunt."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_VAMPIRE_SHADOW_FORM_activated_2" in
#. nested EOCs in effect in EoC "EOC_VAMPIRE_SHADOW_FORM_activated"
msgid "Shadows surround you until only your now-glowing eyes remain visible."
msgstr ""
"Des ombres vous entourent jusqu'à ne laisser plus que vos yeux luisants "
"visibles."

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_VAMPIRE_SHADOW_FORM_activated_2" in nested EOCs in effect in EoC
#. "EOC_VAMPIRE_SHADOW_FORM_activated"
msgid "You don't have enough blood to shroud yourself in shadow."
msgstr "Vous n'avez pas assez de sang pour vous envelopper d'ombres."

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_VAMPIRE_SHADOW_FORM_deactivated" in
#. nested EOCs in false effect in EoC "EOC_VAMPIRE_SHADOW_FORM_activated"
msgid "Your eyes stop glowing and the shadows surrounding you dissipate."
msgstr "Vos yeux arrêtent de luire et les ombres vous recouvrant se dissipent."

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_VAMPIRE_SHADOW_FORM_BLOOD_COST_2" in nested EOCs in effect in EoC
#. "EOC_VAMPIRE_SHADOW_FORM_BLOOD_COST"
msgid "You don't have enough blood to maintain the shadows surrounding you."
msgstr "Vous n'avez pas assez de sang pour maintenir les ombres vous enveloppant."

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_last_breath_mist"
msgid ""
"As you are about to die, your body instinctively turns to mist before "
"reappearing nearby with some of its wounds closed."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_BLIND_THE_SUN_CHECK_FOR_STORM" in
#. nested EOCs in effect in EoC "EOC_VAMPIRE_BLIND_THE_SUN"
msgid ""
"You feel that the anomalous energies of the storm would do quick work of any "
"darkness you could summon, so you decide to not attempt to blot out the sun "
"for now."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in false effect in EoC "EOC_BLIND_THE_SUN_CHECK_FOR_STORM"
#. in nested EOCs in effect in EoC "EOC_VAMPIRE_BLIND_THE_SUN"
msgid ""
"Using your mastery over the Shadowed Path, you blot out the sun, covering the "
"region around you in darkness for a short period of time."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in false effect in EoC "EOC_VAMPIRE_BLIND_THE_SUN"
msgid "You don't have enough blood to blot out the sun."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_UNBLOT_THE_SUN"
msgid "The darkness you summoned fades away, clearing the sky."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_EARTH_SLEEP_CHECK_SATISFIED" in
#. nested EOCs in effect in EoC "EOC_EARTH_SLEEP_CHECK_REAL"
msgid "Your sleep has been restful, thanks to the proximity of the earth."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_EARTH_SLEEP_CHECK_PENALTY" in nested
#. EOCs in false effect in EoC "EOC_EARTH_SLEEP_CHECK_REAL"
msgid ""
"You struggle to awaken, feeling tired and weakened.  Having slept away from "
"the earth, your sleep wasn't as restful as it should've been."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_HOLY_BURN_CHECK_2" in nested EOCs in
#. effect in EoC "EOC_HOLY_BURN_CHECK"
msgid ""
"You are too close to a holy place!  You must flee its proximity immediately "
"or you will die!"
msgstr ""
"Vous êtes trop proche d'un lieu consacré!  Éloignez-vous en immédiatement ou "
"mourez!"

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_HOLY_BURN_CHECK_REMOVE" in nested
#. EOCs in false effect in EoC "EOC_HOLY_BURN_CHECK_2" in nested EOCs in
#. effect in EoC "EOC_HOLY_BURN_CHECK"
msgid ""
"You are now far enough from the holy place.  You no longer feel like you're "
"burning up."
msgstr ""
"Vous vous êtes assez éloigné·e du lieu consacré et n'avez plus l'impression "
"d'être en train de prendre feu."

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_VAST_WATER_BURN_CHECK_2" in nested
#. EOCs in effect in EoC "EOC_VAST_WATER_BURN_CHECK"
msgid ""
"You are too close to a vast body of water!  You must flee its proximity "
"immediately or you will die!"
msgstr ""
"Vous êtes trop proche d'une étendue d'eau vaste!  Éloignez-vous en "
"immédiatement ou mourez!"

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_VAST_WATER_CHECK_REMOVE" in nested
#. EOCs in false effect in EoC "EOC_VAST_WATER_BURN_CHECK_2" in nested EOCs in
#. effect in EoC "EOC_VAST_WATER_BURN_CHECK"
msgid ""
"You are now far enough from the vast water.  You no longer feel like you're "
"melting."
msgstr ""
"Vous êtes maintenant assez loin de l'étendue d'eau vaste et n'avez plus "
"l'impression d'être en train de fondre."

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_BLOOD_CRAVING_START"
msgid ""
"You feel a growing craving for blood.  If you do not drink blood soon, the "
"craving will grow unbearable for a short time."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in false effect in EoC "EOC_VAMPIRE_INVISIBLE_IN_DARK_2"
#. in nested EOCs in effect in EoC "EOC_VAMPIRE_INVISIBLE_IN_DARK"
msgid "You cannot use this power under the sun's rays."
msgstr "Vous ne pouvez pas utiliser ce pouvoir sous les rayons du soleil."

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in false effect in EoC "EOC_VAMPIRE_INVISIBLE_IN_DARK"
msgid "You don't have enough blood to shroud yourself in shadows."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_SUN_BURN_CHECK"
msgid "You are under the sun!  You must find shelter from its rays or you will die!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_SUN_BURN_CHECK_REMOVE" in nested
#. EOCs in false effect in EoC "EOC_SUN_BURN_CHECK"
msgid ""
"The sun's rays cannot reach you anymore.  You no longer feel like you're "
"burning alive."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_ANATHEMA_MIND_CHAOS_ROLL_SUCCESS"
msgid "The chaos within your head coalesces and destabilizes your mind."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_ANATHEMA_MIND_CHAOS_ROLL_FAIL"
msgid ""
"The chaos within your head coalesces but it cannot latch on your mind, so it "
"will remain there until it decoheres."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ NPC message in effect in EoC "EOC_MENTOR_VANISH"
#, c-format
msgid "%1$s's vanishes in a fine mist."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
#. ~ Player message in false effect in EoC "EOC_MENTOR_VANISH"
msgid ""
"You're not a mentor, so you're not supposed to see this.  Please open a "
"Github bug report."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "One with the Night"
msgstr "Une avec la Nuit"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "One with the Night"
msgid ""
"You have ascended in power and can rival the mighty night-creatures of old.  "
"The night is your home, now, out of the light of the sun."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Lilit"
msgstr "Lilith"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Lilit"
msgid ""
"You are one of the lilin, a hunter in the night, driven to feed on the "
"spiritual essence (some might say the soul) of your prey.  Probably you were "
"born that way, but maybe it happened to due to a malediction, or some "
"artifact you found in a place best forgotten.  Regardless, it is your gift "
"and your curse now, and you must use your powers to survive.\n"
"\n"
"You may activate this trait to spend some ruach toward increasing your power. "
" You must be outside under the moonlight to have a chance of gaining new "
"lilin powers."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Enervating Touch"
msgid ""
"With but a touch, you can drain the vitality and spiritual essence from your "
"targets."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Breath Stealer"
msgstr "Voleuse de Souffle"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Breath Stealer"
msgid ""
"You no longer need to touch your targets to drain their ruach; you can do it "
"at a short distance through their breath."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ Ruach is the Hebrew word for 'breath,' but it can also mean 'spirit'
#. ~ Name of spell "lilin_drain_ruach_short_ranged_spell"
#. ~ Name of spell "lilin_drain_ruach_long_ranged_spell"
msgid "Ruach Drinker"
msgstr "Buveuse de Ruach"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Ruach Drinker"
msgid ""
"You no longer need to touch your targets to drain their ruach; you can do it "
"at a great distance through their breath."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Psalm 132:4
msgid "Given Sleep to Their Eyes"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Given Sleep to Their Eyes"
msgid ""
"In sleep, a person's defenses are down and it is easier for the things in the "
"night to prey upon them.  You gain additional ruach from sleeping targets."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ This is a reference to Job 22:14
#. ~ Name of spell "lilin_change_weather_fog_spell"
msgid "Thick Clouds A Covering"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Thick Clouds A Covering"
msgid ""
"Call up thick clouds of fog, allowing you to hide from your enemies.  This "
"power <color_green>lasts longer</color> when closer to the new moon."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ Name of spell "lilin_evil_eye_spell"
msgid "The Evil Eye"
msgstr "Le Mauvais Œil"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Evil Eye"
msgid ""
"With a baleful gaze and a heart full of malice, curse a single target with "
"misfortune."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Cry of the Night-Bird"
msgstr "Cri de l'Oiseau Nocturne"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Cry of the Night-Bird"
msgid "Let out a piercing cry, disorienting both enemies and allies nearby."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "On Silent Wings"
msgstr "Portée par des Ailes Silencieuses"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "On Silent Wings"
msgid ""
"You can transform yourself into an owl and take wing on the night air.  You "
"won't be able to drain ruach while you are in this form."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Silent in Darkness"
msgid ""
"When shrouded in shadows, you make as little noise as one.  Your movement is "
"fully silent at night unless you're out of ruach."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Genesis 1:5
msgid "And There Was Evening"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "And There Was Evening"
msgid ""
"You were born to walk the night, and have a much easier time sleeping during "
"the day."
msgstr ""
"Vous êtes né⋅e pour arpenter la nuit, et dormir durant le jour est "
"considérablement plus facile pour vous."

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ This is a reference to Psalms 121:4
#. ~ Name of spell "lilin_avoid_sleep_spell"
msgid "Neither Sleep Nor Slumber"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Neither Sleep Nor Slumber"
msgid ""
"While sleep is restful, the ruach you gain fills you with more energy than "
"even a good night's rest.  You may spend ruach to alleviate your sleepiness."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Proverbs 5:3
msgid "Smoother than Oil"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Smoother than Oil"
msgid ""
"Your presence is intoxicating, and humans have a hard time resisting your "
"charms.  You gain a bonus to your persuasion chance as long as you aren't "
"empty of ruach."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Exodus 20:16
msgid "The False Witness"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The False Witness"
msgid ""
"You have a much easier time spinning lies and making people believe them.  "
"You gain a bonus to your lying chance as long as you aren't empty of ruach."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ This is a reference to Jeremiah 10:14
#. ~ Name of spell "lilin_mesmerize_target_spell"
msgid "Senseless and Without Knowledge"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Senseless and Without Knowledge"
msgid ""
"You can temporarily beguile a single human, fey, or avian target, causing "
"them to stand senseless or wander in a daze.  Any damage will bring the "
"target out of their trance."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Romans 6:23
msgid "The Gift of Eternal Life"
msgstr "Le Don de la Vie Éternelle"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Gift of Eternal Life"
msgid ""
"Your body has now stopped aging, massively extending your longevity.  You can "
"still be killed but as long as your body can heal, all your wounds will "
"eventually fully heal no matter how severe they are."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Enduring Through All Generations"
msgid ""
"With eternal youth comes the strength to endure past anything one could face. "
" Your speed won't be lower than its default as long as you have some ruach in "
"you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ Name of spell "lilin_aoe_line_disease_spell"
msgid "Unleash the Night-Wind"
msgstr "Déchaîner le Vent Nocturne"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Unleash the Night-Wind"
msgid "You may unleash a foul miasma on your enemies, sickening them."
msgstr ""
"Vous êtes capable de relâcher un miasme fétide sur vos ennemis, les rendant "
"malade."

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ Name of spell "lilin_disease_enhancement_damage_spell"
msgid "Devoured by Pestilence"
msgstr "Dévoré⋅e par la Peste"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Devoured by Pestilence"
msgid ""
"You may greatly enhance the power of the miasma from Unleash the Night-Wind, "
"doing serious damage and crippling your target."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ Name of spell "lilin_blinding_target_spell"
msgid "Dwelling in Deep Darkness"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Dwelling in Deep Darkness"
msgid ""
"You may cut a single target off from light, completely blinding them.  You "
"may only do this at night, and only indoors or out in the wilderness."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ Name comes from Genesis 29:17
msgid "Of Beautiful Form"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Of Beautiful Form"
msgid ""
"You can use your powers to spin a web of illusion around yourself, increasing "
"your attractiveness to a supernatural degree.  While the harsh light of the "
"sun destroys the illusion, you need merely to move back into the shadows to "
"restore it."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ Name comes from II Samuel 14:25
msgid "Without Blemish"
msgstr "Sans Tâche"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Without Blemish"
msgid ""
"You can use your powers to spin a web of illusion around yourself, increasing "
"your attractiveness to a supernatural degree.  While the harsh light of the "
"sun destroys the illusion, you need merely to move back into the shadows to "
"restore it.  You have grown so powerful that this illusion requires almost no "
"effort and can be <color_green>maintained for weeks</color> at a time."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Might of the Nephilim"
msgid ""
"Like the monstrous children of angels and humans, your prowess surpasses "
"mortal limits.  Activate this trait to empower yourself."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Proverbs 30:15
msgid "Alukah's Daughter"
msgstr "Fille d'Alukah"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Alukah's Daughter"
msgid ""
"You can drain essence from your targets with your unarmed attacks.  Not well "
"enough to absorb their ruach, should they have any, but enough to cause "
"additional damage at night.  This damage is strongest during the half to full "
"moon and weakest during the new moon.  It functions only slightly during the "
"day."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Reaping the Whirlwind"
msgid ""
"With an expenditure of ruach you can drastically enhance your speed for a "
"short period of time."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "From Shadow to Shadow"
msgstr "D'Ombre à Ombre"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "From Shadow to Shadow"
msgid ""
"You can leap away from attacks like shadows dancing in candlelight.  You gain "
"Uncanny Dodge while under the effects of Reaping the Whirlwind."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Strigine Gaze"
msgstr "Vision de Strige"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Strigine Gaze"
msgid ""
"Your eyes have adapted to the darkness of the night, allowing you to see "
"further through the shadows.  This is most effective out under the moon but "
"still has an effect indoors."
msgstr ""
"Vos yeux ce sont adaptés à la nuit, vous permettant de voir plus loin dans "
"l'ombre.  Ceci est le plus efficace sous la lumière de la lune mais à un "
"effet réduit à l'intérieur."

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Owl's Wisdom"
msgstr "La Sagesse de la Chouette"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Owl's Wisdom"
msgid ""
"The owl is a symbol of wisdom in culture after culture, and you are the heir "
"to that wisdom.  You find it easier to learn things, and even easier the more "
"ruach you're holding on to."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Shattering the Broken Vessels"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Shattering the Broken Vessels"
msgid ""
"Attuned to darkness and disease, you can easily spot the cracks in your "
"enemies' defenses.  You have an easier chance to hit enemy weakpoints, "
"increasing as your ruach rises."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Psalms 91:6
msgid "The Pestilence that Stalks in Darkness"
msgstr "La Peste qui Marche dans les Ténèbres"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Pestilence that Stalks in Darkness"
msgid ""
"You are at home in the darkness and it clings to you to cover your movements. "
" In a half- or smaller moon, and when out of the daylight, it is harder for "
"your enemies to spots you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Psalm 147:17
msgid "Stand Before the Cold"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Stand Before the Cold"
msgid ""
"As a hunter in the night, you are well-conditioned to the cold after the sun "
"goes down.  You are resistant to chill temperatures, and more so the more "
"ruach you have."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Proverbs 25:16
msgid "Eating Drops of Honey"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Eating Drops of Honey"
msgid ""
"When filled with ruach, no other food or drink compares.  The more ruach you "
"have, the less mundane hunger or thirst troubles you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Warm Breath"
msgstr "Souffle Chaud"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Warm Breath"
msgid ""
"Your stolen ruach speeds your healing in proportion to how much of it you "
"have."
msgstr "Votre ruach volé accélère proportionnellement votre guérison."

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "The Night's Caress"
msgstr "La Caresse de La Nuit"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Night's Caress"
msgid ""
"Sometimes, you cannot passively wait for your ruach to heal your wounds, you "
"need it to happen immediately.  You may activate this trait to greatly speed "
"your healing at a continual cost of ruach."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Ruach Spring"
msgstr "Source de Ruach"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Ruach Spring"
msgid "Your powers have expanded and you are now capable of holding more ruach."
msgstr ""
"Vos pouvoirs se sont développés et vous êtes maintenant capable d'entreposer "
"plus de ruach."

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Ruach Well"
msgstr "Puit de Ruach"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Ruach Well"
msgid "Your powers have expanded and you are now capable of holding even more ruach."
msgstr ""
"Vos pouvoirs se sont développés à nouveau et vous êtes maintenant capable "
"d'entreposer encore plus de ruach."

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Ruach Sea"
msgstr "Mer de Ruach"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Ruach Sea"
msgid ""
"Your powers have expanded and you are now capable of holding an enormous "
"amount of ruach."
msgstr ""
"Vos pouvoirs ont continué à s'étendre et vous êtes maintenant capable "
"d'entreposer une quantité énorme de ruach."

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Proverbs 23:5
msgid "Glancing at Riches"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Glancing at Riches"
#, no-c-format
msgid ""
"You've learned how to more efficiently use your ruach, greedily keeping some "
"behind for yourself when you activate your powers.  Powers that cost ruach "
"have their initial and periodic costs reduced by 15%.  This does not reduce "
"the continual ruach cost of staying alive."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Jeremiah 5:27
msgid "Like a Cage Full of Birds"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Like a Cage Full of Birds"
#, no-c-format
msgid ""
"You jealously parcel out your ruach, only spending exactly as much as you "
"need and no more.  Powers that cost ruach have their initial and periodic "
"costs reduced by 15%, with an additional reduction that grows based on your "
"total amount of ruach, to a maximum reduction of 33%.  This does not reduce "
"the continual ruach cost of staying alive."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Psalms 139:12
msgid "The Night Shines Like the Day"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Night Shines Like the Day"
msgid ""
"You have adapted so well to the night that it doesn't hinder your actions at "
"all.  You can read and craft in any light levels."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Psalms 139:12
msgid "The Darkness is not Dark to You"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Darkness is not Dark to You"
msgid ""
"Your eyes have fully adapted to the darkness, allowing you to see as well in "
"the dark as humans see in the light."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Jeremiah 31:35
msgid "The Moon Shall Shine at Night"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Moon Shall Shine at Night"
msgid ""
"You are closely attuned to the moon, and some of your powers grow stronger "
"with it.  Any ability you have that is amplified the fuller the moon is will "
"not be weakened as much by an incomplete but non-new moon."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Like an Unclean Spirit"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Like an Unclean Spirit"
msgid ""
"Your owl form is half spirit and half flesh.  You have a high chance to dodge "
"any attacks against you, and may pass straight through walls as long as it is "
"night."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "The Night-Hunter"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Night-Hunter"
msgid ""
"You are at home in the night, and your prowess is heightened while the moon "
"is up as long as you have any ruach within you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "The Strix's Wrath"
msgstr "L'Ire de la Strige"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Strix's Wrath"
msgid ""
"You can combine your forms, transforming into a large owl-human hybrid with "
"wings, rending talons, and a deadly beak.  You won't be able to drain ruach "
"while you are in this form."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Strix's Leap"
msgstr "Bond de Stryge"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Strix's Leap"
msgid ""
"While you cannot fly, with your bird-like legs and your wings, you can leap "
"quite a distance."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Exodus 16:12
msgid "Eating Meat at Twilight"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Eating Meat at Twilight"
msgid ""
"When filled with ruach, no other food or drink compares.  The more ruach you "
"have, the less mundane hunger or thirst troubles you.  In addition, drinking "
"ruach from your victims assuages your hunger and thirst."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
msgid "Touch of Contagion"
msgstr "Toucher Contagieux"

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Touch of Contagion"
msgid ""
"When you wish it, your very touch bears the contamination of plague.  Your "
"unarmed attacks have a chance to infect your targets, scaling with the amount "
"of ruach you have."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Treasures of Darkness"
msgid ""
"You are a being of darkness, closer to it than almost anything else is.  It "
"quickens your essence, and with it your actions, the longer you stay in it.  "
"Each night, you receive an increase to your speed that is higher for each "
"consecutive day spent without being exposed to the sun, up to ten.  The light "
"of the sun breaks this quickening, forcing you to wait once more for the "
"shadows to empower you in this way."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ Mutation name
#. ~ Name of spell "lilin_instant_heal_spell"
msgid "The Moon to Rule the Night"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "The Moon to Rule the Night"
msgid ""
"At night, under the moonlight, you can knit grievous wounds together in "
"seconds with a great expenditure of ruach."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Mutation name
#. ~ This is a reference to Isaiah 66:24
msgid "Their Worm Shall Not Die"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin.json
#. ~ Description of mutation "Their Worm Shall Not Die"
msgid ""
"When taking fatal damage, instead of dying you assume the form of an owl, "
"allowing you to fly away from danger and recover.  This does not function "
"during the day, if you are out of ruach, or if you are killed by fire."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_eocs.json
#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_LILIN_GAIN_POWERS_AT_NIGHT_ACTIVE"
msgid ""
"Under the light of the moon, you realize a new way to use your stolen ruach "
"to empower yourself."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_eocs.json
#. ~ EOC option name in effect in EoC
#. "EOC_LILIN_GAINS_STRENGTH_TO_STRENGTH_CHOOSE_INITIAL"
msgid "Empower your Strength"
msgstr "Augmentez votre Force"

#: data/mods/Xedra_Evolved/mutations/xe_lilin_eocs.json
#. ~ EOC option name in effect in EoC
#. "EOC_LILIN_GAINS_STRENGTH_TO_STRENGTH_CHOOSE_INITIAL"
msgid "Empower your Dexterity"
msgstr "Augmentez votre Dextérité"

#: data/mods/Xedra_Evolved/mutations/xe_lilin_eocs.json
#. ~ EOC option name in effect in EoC
#. "EOC_LILIN_GAINS_STRENGTH_TO_STRENGTH_CHOOSE_INITIAL"
msgid "Empower your Perception"
msgstr "Augmentez votre Perception"

#: data/mods/Xedra_Evolved/mutations/xe_lilin_eocs.json
#. ~ EOC option description in effect in EoC
#. "EOC_LILIN_GAINS_STRENGTH_TO_STRENGTH_CHOOSE_INITIAL"
msgid "Gain strength bonuses when using From Strength to Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_eocs.json
#. ~ EOC option description in effect in EoC
#. "EOC_LILIN_GAINS_STRENGTH_TO_STRENGTH_CHOOSE_INITIAL"
msgid "Gain dexterity and dodge bonuses when using From Strength to Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_eocs.json
#. ~ EOC option description in effect in EoC
#. "EOC_LILIN_GAINS_STRENGTH_TO_STRENGTH_CHOOSE_INITIAL"
msgid "Gain perception bonuses when using From Strength to Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_eocs.json
#. ~ EOC selection title in effect in EoC
#. "EOC_LILIN_GAINS_STRENGTH_TO_STRENGTH_CHOOSE_INITIAL"
msgid "Pick a choice"
msgstr "Choisissez"

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_TEMPORARY_GLORIOUS_activated_2" in nested EOCs in nested effect
#. in then statement in effect in EoC "EOC_LILIN_TEMPORARY_GLORIOUS_activated"
msgid "You spin a beguiling web of illusion around yourself."
msgstr "Vous tissez une toile d'illusion autour de vous."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_LILIN_TEMPORARY_GLORIOUS_activated_2" in nested EOCs in nested effect
#. in then statement in effect in EoC "EOC_LILIN_TEMPORARY_GLORIOUS_activated"
#. ~ Player message in false effect in EoC
#. "EOC_LILIN_TEMPORARY_GLORIOUS_maintenance_2" in nested EOCs in effect in
#. EoC "EOC_LILIN_TEMPORARY_GLORIOUS_maintenance"
msgid "You don't have enough ruach to enhance your appearance."
msgstr "Vous ne possédez pas assez de ruach pour améliorer votre apparence."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in nested effect in else statement in effect in EoC
#. "EOC_LILIN_TEMPORARY_GLORIOUS_activated"
msgid "You are already so beautiful no illusion could enhance your appearance"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_TEMPORARY_GLORIOUS_deactivated" in nested EOCs in false effect
#. in EoC "EOC_LILIN_TEMPORARY_GLORIOUS_activated"
msgid "You rend the illusions around yourself to tatters."
msgstr "Vous déchirez en lambeaux les illusions vous recouvrant."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_TEMPORARY_GLORIOUS_maintenance_2" in nested EOCs in effect in
#. EoC "EOC_LILIN_TEMPORARY_GLORIOUS_maintenance"
msgid "You feel a chill on your skin as you maintain your web of pleasing illusions."
msgstr ""
"Vous ressentez un frisson parcourir votre peau à cause de votre toile "
"d'illusions agréables."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_LILIN_ATTRIBUTE_BONUSES_activated_2"
#. in nested EOCs in effect in EoC "EOC_LILIN_ATTRIBUTE_BONUSES_activated"
msgid "You draw on your ruach to enhance your physical abilities."
msgstr "Vous puisez du ruach pour augmenter vos capacités physiques."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_LILIN_ATTRIBUTE_BONUSES_activated_2" in nested EOCs in effect in EoC
#. "EOC_LILIN_ATTRIBUTE_BONUSES_activated"
#. ~ Player message in false effect in EoC
#. "EOC_LILIN_ATTRIBUTE_BONUSES_maintenance_2" in nested EOCs in effect in EoC
#. "EOC_LILIN_ATTRIBUTE_BONUSES_maintenance"
msgid "You don't have enough ruach to enhance your physical abilities."
msgstr "Vous ne possédez pas assez de ruach pour améliorer vos capacités physiques."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_LILIN_ATTRIBUTE_BONUSES_deactivated"
#. in nested EOCs in false effect in EoC
#. "EOC_LILIN_ATTRIBUTE_BONUSES_activated"
msgid "Your physical abilities return to normal."
msgstr "Vos capacités physiques retournent à la normale."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_ATTRIBUTE_BONUSES_maintenance_2" in nested EOCs in effect in EoC
#. "EOC_LILIN_ATTRIBUTE_BONUSES_maintenance"
msgid ""
"You feel a chill on your skin as you maintain your enhanced physical "
"abilities."
msgstr ""
"Vous ressentez un frisson parcourir votre peau à cause de votre augmentation "
"de vos capacités physiques."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_LILIN_TURN_INTO_OWL_activated_2" in
#. nested EOCs in effect in EoC "EOC_LILIN_TURN_INTO_OWL_activated"
msgid ""
"Your eyes grow wide as feathers sprout from your arms and you take to the air "
"on silent wings."
msgstr ""
"Vos yeux s'élargissent, des plumes apparaissent sur vos bras et vous vous "
"envolez avec une paire d'ailes silencieuses."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_LILIN_TURN_INTO_OWL_activated_2" in nested EOCs in effect in EoC
#. "EOC_LILIN_TURN_INTO_OWL_activated"
msgid "You don't have enough ruach to transform into an owl."
msgstr "Vous n'avez pas assez de ruach pour vous transformer en une chouette."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_BONUS_HEALING_ACTIVE_activated_2" in nested EOCs in effect in
#. EoC "EOC_LILIN_BONUS_HEALING_ACTIVE_activated"
msgid "You pour ruach into your wounds and your body begins healing."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_LILIN_BONUS_HEALING_ACTIVE_activated_2" in nested EOCs in effect in
#. EoC "EOC_LILIN_BONUS_HEALING_ACTIVE_activated"
msgid "You don't have enough ruach to heal your wounds."
msgstr "Vous ne possédez pas assez de ruach pour guérir vos blessures."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_BONUS_HEALING_ACTIVE_deactivated" in nested EOCs in false effect
#. in EoC "EOC_LILIN_BONUS_HEALING_ACTIVE_activated"
msgid "Your accelerated healing slows to a stop."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_BONUS_HEALING_ACTIVE_maintenance_2" in nested EOCs in effect in
#. EoC "EOC_LILIN_BONUS_HEALING_ACTIVE_maintenance"
msgid "You feel icy pinpricks on your skin as your wounds heal."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_LILIN_BONUS_HEALING_ACTIVE_maintenance_2" in nested EOCs in effect in
#. EoC "EOC_LILIN_BONUS_HEALING_ACTIVE_maintenance"
msgid "With your body restored, you no longer need to dedicate ruach to healing it."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_LILIN_BONUS_HEALING_ACTIVE_maintenance_2" in nested EOCs in effect in
#. EoC "EOC_LILIN_BONUS_HEALING_ACTIVE_maintenance"
msgid "You don't have enough ruach accelerate your healing."
msgstr "Vous ne possédez pas assez de ruach pour accélérer votre guérison."

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_TRANSFORM_INTO_WAR_OWL_FORM_activated_2" in nested EOCs in
#. effect in EoC "EOC_LILIN_TRANSFORM_INTO_WAR_OWL_FORM_activated"
msgid ""
"Wings erupt from your shoulders and talons grow from your fingers as you "
"assume the strix form."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_LILIN_TRANSFORM_INTO_WAR_OWL_FORM_activated_2" in nested EOCs in
#. effect in EoC "EOC_LILIN_TRANSFORM_INTO_WAR_OWL_FORM_activated"
msgid "You don't have enough ruach to transform into a strix."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_LILIN_TRANSFORM_INTO_WAR_OWL_FORM_deactivated" in nested EOCs in false
#. effect in EoC "EOC_LILIN_TRANSFORM_INTO_WAR_OWL_FORM_activated"
msgid "Your wings, feathers, and talons all vanish as you return to your human form."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
#. ~ value of variable 'message_success' in effect in EoC
#. "EOC_LILIN_STRIX_LEAP"
#. ~ Description of spell "lilin_strix_leap_spell ( Strix Leap )"
msgid ""
"You squat down, build up tension in your legs, then with a mighty beat of "
"your wings, you leap."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_lilin_trait_eocs.json
#. ~ Player message in effect in EoC "EOC_LILIN_PREVENT_DEATH_INITIATE"
msgid ""
"As yours wounds overtake you, you cast forth your spirit in the form of an "
"owl."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Gracken"
msgstr "Gracken"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Gracken"
msgid ""
"A traveler from another dimension.  A dimension of shadows with few bright "
"lights.  Once your species matures, they gain the ability to create new "
"alterations to their body from ingredients harvested from their kills, "
"shadowstuff and magickal essence."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Gracken, Mature"
msgstr "Gracken, Mature"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Gracken, Mature"
msgid ""
"You have become a fully mature Gracken and have gained the ability to reform "
"your body in ways previously blocked to you in your immature state."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Eyes"
msgstr "Yeux Ténébreux"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Eyes"
msgid "Bright yellow eyes shine out from the shadowy crevices of your face."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Gracken Build"
msgstr "Carrure de Gracken"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Gracken Build"
msgid ""
"Gracken are about the same size as humans, though they look like shadow "
"demons."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Legs"
msgstr "Jambes Ténébreuses"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Legs"
msgid "Your legs are human sized but appear to be made of swirling shadows."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Short Legs"
msgstr "Jambes Courtes"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Short Legs"
msgid ""
"Your legs have decreased in length providing you with a lower center of "
"gravity and a slight improvement to agility."
msgstr ""
"Vos jambes raccourcies vous offrent un centre de gravité plus bas et "
"bénéficient votre agilité de façon minime."

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Long Legs"
msgstr "Longues Jambes"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Long Legs"
msgid "Your legs have lengthened.  You can cross flat terrain more easily."
msgstr ""
"Vos jambes se sont allongées et vous êtes capable de vous déplacer plus "
"rapidement à travers des cases sans obstructions."

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Feet"
msgstr "Pieds Ténébreux"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Feet"
msgid "Your feet are humanoid but appear to be made of swirling shadows."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Arms"
msgstr "Bras Ténébreux"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Arms"
msgid "Your arms are humanoid but appear to be made of swirling shadows."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Strong Arms"
msgstr "Bras Robustes"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Strong Arms"
msgid "Your arms have begun bulking up and become stronger.  +1 Strength"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Long Arms"
msgstr "Bras Élancés"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Long Arms"
msgid "Your arms have lengthened.  You can push a target away from you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Hands"
msgstr "Mains Ténébreuses"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Hands"
msgid "Your hands are humanoid but appear to be made of swirling shadows."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Sharp Nails"
msgstr "Ongles Ténébreux Acérés"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Sharp Nails"
msgid ""
"Your hands are humanoid but appear to be made of swirling shadows.  At the "
"end of each finger you sport a razor sharp nail.  It increases your damage "
"when unarmed."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Dextrous Hands"
msgstr "Mains Ténébreuses Dextres"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Dextrous Hands"
msgid ""
"Your hands are humanoid but appear to be made of swirling shadows.  You sport "
"an extra digit on every finger that improves your ability to get into tight "
"situations.."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Skin"
msgstr "Peau Ténébreuse"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Skin"
msgid "Your skin is the color of shadows moving in the twilight."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Shade Stomach"
msgstr "Estomac Ténébreux"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Shade Stomach"
msgid ""
"Your dietary needs are so minimized that you could travel months or years "
"without eating.  There are consequences to this.  One is an inability to "
"process normal food.  Another is a pretty constant state of weariness, but "
"this is the best way to handle interdimensional travel until you are able to "
"develop an organ to consume local foods.  The ambient energies here are much "
"weaker than what you normally encounter out in the Nether between universes, "
"you need exposure to nuclear radiation to gain calories on this planet, for "
"now."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Omnivorous Stomach"
msgstr "Estomac d'Omnivore"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Omnivorous Stomach"
msgid ""
"You eat a wide variety of foods native to this world that would be "
"appropriate for the dominant species."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Carnivorous Stomach"
msgstr "Estomac de Carnivore"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Carnivorous Stomach"
msgid ""
"You eat an exclusively meat-based diet as befits an apex predator of this "
"planet."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Herbivore Stomach"
msgstr "Estomac d'Herbivore"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Herbivore Stomach"
msgid ""
"You eat a herbivorous diet.  The benefit of this is you never have to kill "
"for your food.  Unless the plants were trying to kill you first."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Evolution Gland"
msgstr "Glande Évolutive"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Evolution Gland"
msgid ""
"You have a gland that grows a small amount of the material needed to make "
"biological improvements to yourself.  You must gather dreamdross and "
"components from monsters you wish to gain the abilities of and combine them "
"with this shadowstuff into new organs and abilities."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Mutation name
msgid "Radiotrophic"
msgstr "Radiotrophique"

#: data/mods/Xedra_Evolved/mutations/xe_playable_gracken.json
#. ~ Description of mutation "Radiotrophic"
msgid ""
"Your system has adapted to radiation.  While irradiated, you will convert the "
"radiation into calories."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_ARVORE_BRIARS_SELECTOR"
#. ~ EOC option name in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Do nothing"
msgstr "Ne rien faire"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_eocs.json
#. ~ EOC option description in effect in EoC "EOC_ARVORE_BRIARS_SELECTOR"
#. ~ EOC option description in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
#. ~ EOC option description in effect in EoC "EOC_SYLPH_JUMP_HIGH_ON"
msgid "Do nothing."
msgstr "Ne rien faire."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC "EOC_COMMUNE_WITH_NATURE"
msgid "You must be surrounded by nature to commune with nature."
msgstr "Vous devez être entouré(e) par la nature pour entrer en communion avec elle."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC "EOC_ARVORE_JAGGED_CLAWS_ON"
msgid "The jagged wood covering your hands recedes, leaving no trace behind."
msgstr "Le bois dentelé couvrant vos mains disparaît sans laisser de traces."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in effect in EoC "EOC_ARVORE_THORNSKIN_ON"
msgid "Woody thorns push through your skin."
msgstr "Des épines de bois poussent à travers votre peau."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC "EOC_ARVORE_THORNSKIN_ON"
msgid "Your thorns retract, leaving smooth unbroken skin behind."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_ARVORE_SEED_BEARER_activated"
msgid "You bring forth seeds."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in nested effect in then statement in nested effect in
#. else statement in effect in EoC "EOC_ARVORE_SEED_BEARER_activated"
msgid "Your seeds slumber and dream of spring."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in nested effect in else statement in nested effect in
#. else statement in effect in EoC "EOC_ARVORE_SEED_BEARER_activated"
msgid "You need more time before you can summon seeds again."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC "EOC_ARVORE_SEED_BEARER_activated"
msgid "You must be surrounded by the wild to call forth regional seeds."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC "EOC_ARVORE_GOBLIN_FRUIT"
msgid "You must be surrounded by the wild to call forth a goblin fruit."
msgstr "Vous devez être au milieu de la nature sauvage pour invoquer un fruit gobelin."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ EOC option name in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
msgid "Grow Wooden Wall"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ EOC option name in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
msgid "Grow Wooden Floor"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ EOC option name in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
msgid "Grow Wooden Door"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ EOC option name in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
msgid "Grow Leafy Branch"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ EOC option description in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
msgid ""
"Grow a wall of solid wood from the earth, grow or remove bark from a wall, or "
"turn one of your wooden floors into a bark wall."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ EOC option description in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
msgid ""
"Grow a floor of bark from the earth, roof over a bark floor, or turn one of "
"your wooden walls into a bark floor."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ EOC option description in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
msgid "Grow a bramble door from a wooden wall or return the wall to solid wood."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ EOC option description in effect in EoC "EOC_GROWING_WOOD_WALLS_SELECTOR"
msgid "Grow a leafy branch.  It won't provide shelter but it helps it feel like home."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ value of variable 'message_success' in effect in EoC
#. "EOC_ARVORE_VINE_DRAG_activated"
msgid "Vines lash out and drag your target in!"
msgstr "Vous fouettez avec vos lianes, enserrant votre cible et la traînant vers vous!"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ value of variable 'message_fail' in effect in EoC
#. "EOC_ARVORE_VINE_DRAG_activated"
msgid "You are too parched to lash out with any vines."
msgstr "Vous avez trop soif pour fouetter quoi que ce soit avec vos lianes."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_ARVORE_SUMMON_PRESERVATION_CONTAINER_CHECK"
msgid "You must be surrounded by nature to cast To Oppose Decay."
msgstr ""
"Vous devez être entouré·e par la nature pour activer le pouvoir Délayer la "
"Pourriture."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_PERENNIAL_REBIRTH_INITIAL_CHECK_2" in nested EOCs in effect in EoC
#. "EOC_PERENNIAL_REBIRTH_INITIAL_CHECK"
msgid ""
"You need to be in the heart of the forest or at an attuned elemental altar to "
"successfully bind your soul."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_PERENNIAL_REBIRTH_INITIAL_CHECK"
msgid ""
"Your soul is still attaching itself to your new body.  You need to give it "
"time before attempting to bind it to the forest again."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in effect in EoC "EOC_PERENNIAL_REBIRTH_INITIAL"
msgid "You bind your soul to the abundance of nature around you."
msgstr "Vous liez votre âme à l'abondance de vitalité naturelle vous entourant."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in effect in EoC "EOC_PERENNIAL_REBIRTH"
msgid ""
"As your body dies, your fae spirit flies free and, drawn to the pull of the "
"heart of the forest, rebirths itself from the bounty of nature."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC "EOC_ARVORE_OVERGROWTH_2" in nested
#. EOCs in effect in EoC "EOC_ARVORE_OVERGROWTH"
msgid ""
"You must be on the surface and not on a building's upper stories to cast "
"Overgrowth!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC "EOC_ARVORE_OVERGROWTH"
msgid "You must be outside to cast Overgrowth!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ NPC message in effect in EoC "EOC_ARVORE_DAMAGE_ZOMBIES_HEAL_LIVING"
msgid "Nature's power roars forth in an explosion of vital energy!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#: data/mods/Xedra_Evolved/recipes/paraclesians/arvore_recipes.json
#. ~ Verb in activity "ACT_ARVORE_TREESINGING"
#. ~ name of the nested group
msgid "treesinging"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in effect in EoC "EOC_ARVORE_TREE_SINGING_COMPLETE"
msgid ""
"As your song fades, you open your eyes to find a large growth of wood lying "
"on the ground in front of you, separated from the tree without violence."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in effect in EoC "EOC_ARVORE_TREE_SINGING_LEARN_RECIPES"
msgid "The trees whisper their knowledge of a recipe to you"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC "EOC_ARVORE_TREE_FORM_ON"
msgid "You must be outside on diggable ground to become one with the forest."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ NPC message in false effect in EoC "EOC_ARVORE_VERDANT_IMPRISONMENT"
msgid "Your target must be outdoors to transform them into a tree."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_ARVORE_ROOT_TO_ROOT_TRANSLOCATE_CHECK"
#. ~ Player message in false effect in EoC
#. "EOC_ARVORE_ROOT_TO_ROOT_ATTUNEMENT_CHECK"
msgid "You must be outdoors and within the depths of the forest to cast this spell."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of creature revealed by special vision "human_sense"
msgid "The forest nervously whispers to you about the presence of humans."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of creature revealed by special vision
#. "infrared_creature_medium"
msgid "The forest gently whispers to you about the creatures of nature."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of creature revealed by special vision "alien_being_sense"
msgid "The forest whispers warnings of unnatural creatures nearby."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_commune_with_nature ( Commune with Nature )"
msgid ""
"You concentrate on nature around you and commune with it, improving your "
"health and calming the nearby wildlife.  This spell may only be cast outdoors "
"in natural surroundings."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_cultivate_goblin_fruit ( Cultivate Goblin
#. Fruit )"
msgid ""
"You may spin a bit of fae magic into a plant, bringing forth a goblin fruit.  "
"Goblin fruit have a variety of effects, never predictable but always at least "
"somewhat beneficial.  This spell may only be cast outdoors in natural "
"surroundings."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Name of spell "arvore_tree_singing_spell"
msgid "Treesinging"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_tree_singing_spell ( Treesinging )"
msgid ""
"Using your voice and your magic, bring forth living wood from a tree to "
"provide resources without harming the forest."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Message of spell "arvore_tree_singing_spell ( Treesinging )"
msgid "You close your eyes and sing to the trees."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_verdant_infusion ( Verdant Infusion )"
msgid ""
"You draw on your own connection to nature and infuse some of its power into "
"one of your allies, healing them for a small amount and increasing their "
"overall health."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_roots_crack_the_foundation"
#. ~ Mutation name
msgid "Roots Crack the Foundation"
msgstr "Les Racines Percent les Fondations"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_roots_crack_the_foundation ( Roots Crack the
#. Foundation )"
msgid ""
"Roots can grow through even concrete given time.  With this spell, you can "
"compress that time into a single instant to shatter walls or rip doors off "
"their hinges."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_summon_wood_spirit"
#. ~ Mutation name
msgid "Call the Children of the Roots"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_summon_wood_spirit ( Call the Children of
#. the Roots )"
msgid "A lesser wood spirit is summoned to support you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Name of spell "arvore_summon_preservation_container"
msgid "To Withstand Decay"
msgstr "Délayer la Pourriture"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_summon_preservation_container ( To Withstand
#. Decay )"
msgid ""
"While in the wild, weave together some leaves and grasses and magick to form "
"a container that will keep its contents from rotting for a length of time.  "
"The container will only last a few weeks at most."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Name of spell "arvore_summon_floral_boat"
msgid "Viridescent Vessel"
msgstr "Embarcation Verdissante"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_summon_floral_boat ( Viridescent Vessel )"
msgid ""
"Trees require water but will still drown if submerged.  This spell allows the "
"Arvore to create a floral boat with the help of a nearby tree, letting them "
"travel safely across water.\n"
"\n"
"You must be standing <color_yellow>next to a tree</color> and "
"<color_yellow>near the water</color> for the spell to be effective."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_summon_briars"
#. ~ Mutation name
msgid "Briarwall"
msgstr "Mur de Ronces"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_summon_briars ( Briarwall )"
msgid ""
"Call up thick briars and thorns, either in a line to form a wall or an arc to "
"trap an enemy.  They will grow to full size in moments."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_anti_plant_spell"
#. ~ Mutation name
msgid "Tending the Garden"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_anti_plant_spell ( Tending the Garden )"
msgid ""
"Invasive weeds must be rooted out, lest they choke the life from the garden.  "
"This spell inflicts a rapid withering on plants and fungus within its area of "
"effect."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
#. ~ Name of spell "arvore_nurture_the_green"
#. ~ Mutation name
#. ~ Name of spell "changeling_spring_growing_plants_spell"
msgid "Nurturing the Green"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_nurture_the_green ( Nurturing the Green )"
msgid ""
"You can greatly speed plant growth.  Grass can grow from seed in moments, "
"crops can be brought to ripeness, and even young trees will reach their full "
"bloom."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Name of spell "arvore_nurture_the_green_aoe"
msgid "Spreading the Viridian Mantle"
msgstr "Étendre le Manteau Verdoyant"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_nurture_the_green_aoe ( Spreading the
#. Viridian Mantle )"
msgid ""
"Rather than fostering the growth of a single plant, you can cause a wave of "
"growth all around you, affecting an entire field and bringing it towards "
"ripeness."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_growing_wood_walls"
#. ~ Mutation name
msgid "The Forest Offers Shelter"
msgstr "La Forêt Offre un Sanctuaire"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_growing_wood_walls ( The Forest Offers
#. Shelter )"
msgid ""
"In natural surroundings, you can create structures out of living wood--walls, "
"floors, doors, and roofs all together."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_climbing_vine_spell"
#. ~ Mutation name
msgid "Creeper Ascends the Wall"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_climbing_vine_spell ( Creeper Ascends the
#. Wall )"
msgid ""
"Cause a cluster of vines to burst out of diggable ground and rise up into the "
"sky in moments.  It will be easy to climb once its growth is finished."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Message of spell "arvore_climbing_vine_spell ( Creeper Ascends the Wall
#. )"
msgid "The soil churns as thick vines burst forth and shoots toward the sky."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Name of spell "arvore_create_living_tent_spell"
msgid "Den of Brambles"
msgstr "Nid de Ronces"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_create_living_tent_spell ( Den of Brambles
#. )"
msgid ""
"When outside on diggable ground, create a small structure of wood near the "
"Arvore, offering shelter against the elements."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
#. ~ Name of spell "arvore_summon_grass_field_spell"
#. ~ Mutation name
#. ~ Name of spell "changeling_spring_summon_grass_field_spell"
msgid "Commanding the Grasses"
msgstr "Commander les Herbes"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_summon_grass_field_spell ( Commanding the
#. Grasses )"
msgid ""
"Your command over plants allows you to cause grass to grow in profusion from "
"the soil, making the terrain very difficult for enemies to traverse."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_roots_spell ( Hungry Thirsty Roots )"
msgid ""
"Your command over plants allows you to call forth roots from the earth to "
"clutch and grasp at your enemies."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_perennial_rebirth_spell"
#. ~ Mutation name
msgid "Perennial Rebirth"
msgstr "Renaissance Vivace"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_perennial_rebirth_spell ( Perennial Rebirth
#. )"
msgid ""
"Bind your soul to the heart of the forest, rebirthing yourself if you should "
"die.  You may only perform this in thick forests or at an arvore altar, you "
"may be reborn no more than once in a lunar month."
msgstr ""
"Liez votre âme au cœur de la forêt pour en renaître si vous mourez.  Vous ne "
"pouvez faire ceci qu'au milieu d'une forêt épaisse ou à un autel d'arvore, et "
"ceci ne fonctionnera qu'une fois par mois lunaire."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_overgrowth_spell"
#. ~ Mutation name
msgid "Overgrowth"
msgstr "Surcroissance"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_overgrowth_spell ( Overgrowth )"
msgid ""
"While outdoors and not underground, the Arvore can create a profusion of life "
"around themselves, causing grass to grow through pavement, bushes and flowers "
"to sprout, and trees to grow to full height in moments."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_cause_decay"
#. ~ Mutation name
msgid "Fallen Trees Decay to Soil"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_cause_decay ( Fallen Trees Decay to Soil )"
msgid ""
"Even the mightiest tree returns to soil in the end.  The Arvore may channel "
"this natural process into an area around themselves, infecting everyone "
"within with the energies of rot.\n"
"\n"
"<color_yellow>This spell is indiscriminate</color> and <color_red>should not "
"be used near allies</color>."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_traverse_the_wilds ( Traverse the Wilds )"
msgid ""
"Roots grow together and so forests are connected.  The Arvore may use this "
"connection to quickly transport themselves tree to tree, stepping into an "
"adjacent tree and then stepping out of another one within the spell's range."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Name of spell "arvore_forest_translocate"
#. ~ Mutation name
msgid "From Root to Root the Forest Is Joined"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_forest_translocate ( From Root to Root the
#. Forest Is Joined )"
msgid ""
"All forests are connected at their hearts.  You can use this connection to "
"travel from the depths of a forest to the depths of another forest, if you "
"properly attune to your destination."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Name of spell "arvore_forest_translocate_attune"
msgid "Root to Root Attunement"
msgstr "Harmonisation de Racines"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_forest_translocate_attune ( Root to Root
#. Attunement )"
msgid ""
"Attune to a location for later traveling.  You must attune within the depths "
"of a forest."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Name of spell "arvore_turn_into_tree"
msgid "Verdant Imprisonment"
msgstr "Emprisonnement Verdoyant"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_turn_into_tree ( Verdant Imprisonment )"
msgid ""
"The ultimate expression of nature's power, you can turn your target into a "
"tree that might have stood for a century or more.  It works best on an "
"already-weakened target, and does not work at all on non-organic targets."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Name of spell "arvore_damage_zombies_heal_living"
msgid "Embrace of the Verdant Mother"
msgstr "Étreinte de La Nourrice Verdoyante"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutation_spells.json
#. ~ Description of spell "arvore_damage_zombies_heal_living ( Embrace of the
#. Verdant Mother )"
msgid ""
"While outdoors and not underground, the Arvore can unleash the power of "
"nature against their enemies.  The walking dead and most creatures not native "
"to the world suffer the Earthmother's wrath, while animals and humans are "
"healed.  Triffids, being plants, are healed as well.\n"
"\n"
"Note that this power is <color_yellow>indiscriminate</color>: if the Arvore "
"has somehow bound a Nether creature to their service, it will be damaged, and "
"hostile humans will be healed."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Viridian Skin"
msgstr "Peau Viridine"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Viridian Skin"
msgid ""
"Your skin has turned the color of spring growth.  Your skin is now a viridian "
"green.  This has no gameplay effects."
msgstr ""
"La couleur de votre peau s'est altérée vers un vert émeraude de nouvelle "
"pousse.  Ceci n'a aucun effet notable."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Vegetal Cuticle"
msgstr "Cuticule Végétale"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Vegetal Cuticle"
msgid ""
"Your skin has turned into a type of plant matter, which in addition to any "
"armoring slows your loss of fluids."
msgstr ""
"La texture de votre peau a adopté une texture similaire à la surface d'une "
"plante souple.  Ceci vous offre un peu plus de protection même sans aucune "
"armure mais ralentit aussi le rythme auquel vous vous déshydratez."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Bark Skin"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Bark Skin"
msgid ""
"The skin on your body has grown into a barklike state.  This provides "
"significantly more armor but reduces flexibility."
msgstr ""
"La texture de votre peau a adopté une texture similaire à de l'écorce solide. "
" Ceci vous offre une protection considérable même sans aucune armure mais "
"gêne un peu vos mouvements."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Patches of Moss"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Patches of Moss"
msgid ""
"A viridian moss has grown on your skin, forming whorls and eldritch patterns, "
"providing some protection from the cold and the wet.  It also provides a "
"small amount of armor against acid or fire."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Pact of the Green"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Pact of the Green"
msgid ""
"You are in tune with the forest and the triffids will allow you safe passage "
"in their lands, so long as you do not harm them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Greenstride"
msgstr "Pas Boisé"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Greenstride"
msgid ""
"The trees recognize you as one of their own and allow you to pass easily "
"beneath their boughs.  The grass moves under your feet to speed your passage, "
"and shrubs bend out of the way.  When walking on grass, trees, or other "
"natural foliage, your movement speed is increased."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Forestwalker"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Forestwalker"
msgid ""
"The trees recognize you as one of their own and allow you to pass easily "
"beneath their boughs.  The grass moves under your feet to speed your passage, "
"and shrubs bend out of the way.  When walking on grass, trees, or other "
"natural foliage, your movement speed is increased.  In addition, when in a "
"forest, the trees bend out of your way, allowing you to pass"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Nurturing the Green"
msgid ""
"Upon gaining this ability the Arvore may greatly speed plant growth.  With "
"enough practice, you will even be able to bring forth mighty trees from the "
"dry earth."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Seed Bearer"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Seed Bearer"
msgid ""
"Arvore with this ability have a seed pocket on their body that over time "
"fills with a set of from this region of the world.  Each time new seeds "
"appear they will all be of the same type, but the types will vary at random."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "The Forest Offers Shelter"
msgid ""
"Upon gaining this ability the Arvore may create structures of living wood on "
"natural terrain."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Commune with Nature"
msgid ""
"Upon gaining this ability the Arvore gains the ability to draw on the peace "
"and strength of nature while standing in a wild area."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Briarwall"
msgid ""
"Upon gaining this ability the Arvore gains the ability to summon thick "
"tangles of briars to form walls or entrap their enemies."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Traverse the Wilds"
msgid ""
"Upon gaining this ability the Arvore gains the ability to transport "
"themselves from tree to nearby tree while within a forest."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Fallen Trees Decay to Soil"
msgid ""
"Upon gaining this ability the Arvore gains the ability to induce decay and "
"dissolution in the surrounding area."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Call the Children of the Roots"
msgid ""
"Upon gaining this ability the Arvore gains the ability to summon a wood "
"spirit."
msgstr "Ce pouvoir permet à un Arvovre d'invoquer un petit élémental forestier."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Roots Crack the Foundation"
msgid ""
"Upon gaining this ability, the Arvore gains the ability to summon "
"semitangible roots that will shatter walls and furniture."
msgstr ""
"Un Arvore possédant ce pouvoir est capable d'invoquer des racines à moitié "
"tangibles capable de briser murs et mobilier."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "From Root to Root the Forest Is Joined"
msgid ""
"Upon gaining this ability, the Arvore gains the ability to travel great "
"distances, even dozens of miles, in moments, as long as they start and end "
"their journey within the depths of a forest."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Overgrowth"
msgid ""
"Upon gaining this ability, the Arvore gains the ability to cause rapid plant "
"growth in a radius around themselves."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Perennial Rebirth"
msgid ""
"Upon gaining this ability the Arvore gains the ability to bind their soul to "
"the heart of the forest, rebirthing themselves when on the verge of death."
msgstr ""
"Un Arvore possédant ce pouvoir est capable de lier son âme avec le cœur de la "
"forêt et y renaître en cas de mort."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Perennial Rebirth (bound)"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Perennial Rebirth (bound)"
msgid ""
"You have bound your soul to the forest, and death will merely be a momentary "
"inconvenience."
msgstr ""
"Vous avez lié votre âme à la forêt, et la mort ne sera maintenant plus qu'un "
"peu inconfortable pour vous."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Verdant Infusion"
msgid ""
"Upon gaining this ability the Arvore gains the ability to infuse their "
"companions with the vitality of the forest."
msgstr ""
"Un Arvore possédant ce pouvoir est capable d'infuser ses alliés avec la "
"vitalité de la forêt."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Commanding the Grasses"
msgid ""
"Upon gaining this ability the Arvore gains the ability to cause grass to "
"rapidly grow on fertile terrain, slowing their enemies."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Creeper Ascends the Wall"
msgid ""
"Upon gaining this ability the Arvore gains the ability to summon a thick "
"climbing vine from diggable ground."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Tending the Garden"
msgid ""
"Upon gaining this ability the Arvore gains the ability to damage plant and "
"fungal entities, including others of their own kind."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Cultivate Goblin Fruit"
msgid ""
"Upon gaining this ability the Arvore gains the ability to grow a goblin fruit "
"when in natural areas away from civilization."
msgstr ""
"Un Arvore possédant ce pouvoir est capable de faire pousser un fruit gobelin "
"au milieu d'un lieu naturel éloigné des vestiges de la civilization."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#: data/mods/Xedra_Evolved/obsoletion_and_migration/spells.json
#. ~ Mutation name
#. ~ Name of spell "arvore_forest_mapping_spell"
msgid "Commune with the Ancient Oaks"
msgstr "Communier avec les Chênes Millénaires"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Commune with the Ancient Oaks"
msgid ""
"The Arvore are closely tied with the forests and may commune with the trees "
"to learn the layout of the land.  Activate this ability to enter the "
"communion."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Bramble's Bite"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Bramble's Bite"
msgid ""
"Drawing out the power inherent in growing wood makes weapons composed of it "
"more deadly in your hands.  You do increased damage when wielding a weapon "
"primarily made of wood."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Essence of Hemlock"
msgstr "Essence de Ciguë"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Essence of Hemlock"
msgid ""
"With a brief effort of will, the Arvore may infuse their blood with a poison "
"that harms any who bite them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Scent of Night-Blooming Flowers"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Scent of Night-Blooming Flowers"
msgid ""
"The Arvore may release clouds of pollen that ruin the coordination of their "
"enemies when breathed in."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Solar Rejuvenation"
msgstr "Réjuvénation Solaire"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Solar Rejuvenation"
msgid ""
"Like a tree, you are fueled by the sun.  When standing in the sunlight, you "
"will absorb its energy as nutrients and heal slightly faster."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Solar Revitalization"
msgstr "Revitalisation Solaire"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Solar Revitalization"
msgid ""
"Like a tree, you are fueled by the sun.  When standing in the sunlight, you "
"will absorb its energy as nutrients, heal slightly faster, and your mana "
"regenerates much quicker."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "The Eternal Cycle"
msgstr "Le Cycle Éternel"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "The Eternal Cycle"
msgid ""
"Your energy changes with the seasons: in spring and summer, you're more awake "
"and need less sleep, and the reverse is true in autumn and winter."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Solar Repast"
msgstr "Banquet Solaire"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Solar Repast"
msgid ""
"Like a tree, you draw nourishment from the sun and the soil.  When standing "
"in the sunlight and on natural terrain, you absorb its energy as food.  You "
"still need to drink water and you will still get hungry."
msgstr ""
"Comme un arbre, la terre et la lumière du soleil vous alimente.  Lorsque vous "
"vous tenez sous le soleil et un case de terrain naturel, vous absorbez de "
"l'énergie vous nourrissant.  Vous aurez tout de même toujours besoin de boire "
"et vous ne pouvez pas en survivre uniquement."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "The Fallen Branch Suffers Not"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "The Fallen Branch Suffers Not"
msgid "Filled with the energy of life, pain does not affect you as strongly."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Entangling Vines"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Entangling Vines"
msgid ""
"At will, you can extend a cluster of grasping vines to grab one target and "
"drag them in.  They have a range equal to 1/2 your Dexterity."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Jagged Wooden Claws"
msgstr "Griffes en Bois Dentelées"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Jagged Wooden Claws"
msgid ""
"At will, you can transform your hands into jagged wooden claws.  They are "
"potent weapons but make anything other than combat more difficult."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Jagged Wooden Claws Extended"
msgstr "Griffes en Bois Dentelées Sorties"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Jagged Wooden Claws Extended"
msgid ""
"Your hands are transformed into jagged wooden claws.  You can use them to "
"attack, but performing mundane tasks will be harder."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Resist Winter's Chill"
msgstr "Resister le Froid Hivernal"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Resist Winter's Chill"
msgid ""
"Plants lose their leaves in winter, but that does not kill them, they simply "
"sleep until the spring comes.  The cold bothers you less now."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Ignore Winter's Chill"
msgstr "Ignorer le Froid Hivernal"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Ignore Winter's Chill"
msgid ""
"Pine trees keep their leaves even in the coldest winter.  The cold bothers "
"you now not at all."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Sensing the Sun"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Sensing the Sun"
msgid ""
"By the places of the sun and the moon, you can always tell exactly what time "
"it is, as long as you're not underground."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Among the Wilds"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Among the Wilds"
msgid ""
"The wilderness welcomes you as one of its own, and you have an easier time "
"surviving there and making things from its bounty.  +1.5 Survival skill."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Supple As a Reed"
msgstr "Aussi Souple qu'un Roseau"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Supple As a Reed"
msgid ""
"Like green wood, you can bend your limbs easily.  You gain a +4 bonus to "
"Dexterity."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Might of the Seedling"
msgstr "Puissance de la Jeune Pousse"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Might of the Seedling"
msgid ""
"Like the seedling poking through the soil, you have great strength hidden "
"within you.  +1 Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Might of the Sapling"
msgstr "Puissance du Jeune Arbre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Might of the Sapling"
msgid ""
"Like the young tree reaching for the sun, your limbs are filled with power.  "
"+3 Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Might of the Ancient Tree"
msgstr "Puissance de l'Arbre Ancien"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Might of the Ancient Tree"
msgid ""
"Like forest giants that have stood for a hundred years, you are unshakeable.  "
"+5 Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Insight of the Grove"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Insight of the Grove"
msgid ""
"When one tree in a grove is attacked by insects, soon all trees will produce "
"the deterrent.  +3 Perception."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Shadow of the Trees"
msgstr "Ombre des Arbres"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Shadow of the Trees"
msgid ""
"The forest recognizes your kinship and will hide you beneath its boughs.  "
"When in a forest or in thick foliage, enemies will have a harder time "
"spotting you."
msgstr ""
"La forêt admet votre héritage et vous abritera sous ses branches. Il est plus "
"difficile pour vos ennemis de vous repérez lorsque vous êtes dans une forêt "
"ou une zone de végétation épaisse."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Arvore Eyes"
msgstr "Yeux Arvoriens"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Arvore Eyes"
msgid ""
"Upon gaining this ability the Arvore's eyes begin reflecting the seasons: a "
"bright yellow-green in spring; verdant green in summer; red, yellow, or "
"orange in autumn, and dark brown in winter.  Glare no longer impacts them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Arvore Ears"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Arvore Ears"
msgid ""
"The Arvore's ears are longer and pointed, more \"leaf-shaped.\"  While they "
"cannot hear any better, like the trees in the deep forest, they are unphased "
"by loud sounds."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Vegetal Blood"
msgstr "Sang Végétal"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Vegetal Blood"
msgid ""
"The Arvore's blood is now composed of sap and vegetable matter.  This does "
"not benefit or harm them in any ways, but humans will be discomfited by it."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Sap Seals the Wound"
msgstr "La Sève Referme les Plaies"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Sap Seals the Wound"
msgid ""
"The Arvore's blood is a sticky sap that oozes rather than gushes from their "
"wounds.  They will bleed more slowly than normal."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Sap Defends the Trunk"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Sap Defends the Trunk"
msgid ""
"The Arvore's blood is a sticky sap that oozes rather than gushes from their "
"wounds and has potent defensive properties.  They will bleed more slowly than "
"normal and are immune to parasites and infection."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Sap Maintains the Heartwood"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Sap Maintains the Heartwood"
msgid ""
"The Arvore's blood is a sticky sap that oozes rather than gushes from their "
"wounds and aggressively fights back against invading organisms.  They will "
"bleed much more slowly than normal, are immune to parasites and infection, "
"and cannot be transformed by the Mycus."
msgstr ""
"Le sang d'un·e Arvore consiste de sève gluante s'exsudant plutôt que "
"jaillissant de blessures et repoussant avec férocité les intrusions de "
"pathogènes externes.  Votre rythme d'hémorragie est réduit considérablement, "
"vous êtes maintenant immunisé·e contre les infections et parasites "
"ordinaires, et ne pouvez pas être converti·e par le Mycus."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Writhing Vines"
msgstr "Lianes Grouillantes"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Writhing Vines"
msgid ""
"At will, the Arvore can grow long vines from their shoulders and back.  They "
"can be used to climb or to lash at enemies, and can also be detached to serve "
"as a rope if necessary.  Activate to toggle vines on and off."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "The Forests' Warning"
msgstr "L'Alarme de la Forêt"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "The Forests' Warning"
msgid ""
"In the whispers of the leaves and the movement of the grasses, the forest "
"warns you of nearby creatures.  While the forest can distinguish between a "
"bird and a zombie, some fine distinctions are still lost to it."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "The Whispers of the Leaves"
msgstr "Le Murmure des Feuilles"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "The Whispers of the Leaves"
msgid ""
"In the whispers of the leaves and the movement of the grasses, the forest "
"warns you of nearby creatures.  While the forest can distinguish between a "
"bird and a zombie, some fine distinctions are still lost to it.  Also, you "
"can see further when you're standing in a forest."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Verdant Hair"
msgstr "Chevelure Verdoyante"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Verdant Hair"
msgid ""
"Your hair now has flowers and small vines and leaves growing in it.  It's "
"pleasant to look at but has no further game effect."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Floral Scent"
msgstr "Fragrance Florale"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Floral Scent"
msgid ""
"The flowers in your hair produce a pleasant smell, obvious without being "
"overpowering.  You no longer smell anything like a human and other beings "
"will react to you appropriately."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Hidden Thorns"
msgstr "Épines Dissimulées"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Hidden Thorns"
msgid ""
"Every rose has its thorn and so do you.  With a moment's concentration, you "
"can exude thorns through your skin that have a chance of damaging attackers "
"while increasing the damage of your unarmed attacks.  However, you cannot "
"wear rigid armor over your thorns."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Unveiled Thorns Extended"
msgstr "Épines Dévoilées Hérissées"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Unveiled Thorns Extended"
msgid ""
"You are exuding thorns through your skin that have a chance of damaging "
"attackers while increasing the damage of your unarmed attacks.  However, you "
"cannot wear rigid armor over your thorns."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Enchanting Aroma"
msgstr "Arôme Enchanteur"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Enchanting Aroma"
msgid ""
"The flowers in your hair produce an intoxicating smell.  You no longer smell "
"anything like a human and other beings will react to you appropriately.  You "
"can enhance this scent to an overpowering level, beguiling humans and making "
"them more suggestible at the cost of greatly increasing the range at which "
"others can smell you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Leaves Return When Winter Ends"
msgstr "Les Feuilles Reviennent à la Fin de l'Hiver"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Leaves Return When Winter Ends"
msgid ""
"When in wild areas, you can draw on the revitalizing power of the land to "
"heal yourself.  When in natural areas, your limbs will heal much faster."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "One with the Forest"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "One with the Forest"
msgid ""
"You may transform into a tree, extending roots and spreading leaves out to "
"the sun.  You will heal faster, gain more benefit from sleep, and almost all "
"monsters will ignore you, but you will only be dimly aware of the outside "
"world and will be nearly unable to move."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Ancient Tree"
msgstr "Arbre Millénaire"

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Ancient Tree"
msgid ""
"You are a tree.  You will heal much more quickly and resting is more "
"beneficial.  You are unable to see, hear, or move, but have a dim awareness "
"of nearby movement."
msgstr ""
"Vous êtes un arbre. Vous régénérez beaucoup plus rapidement que la normale et "
"vos périodes de repos vous apportent beaucoup plus de bénéfices. Cependant "
"vous êtes incapable de voir, entendre ou bouger, mais les mouvements dans les "
"environs vous restent vaguement perceptibles."

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Solar Empowerment"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Solar Empowerment"
msgid ""
"Like a tree, you are fueled by the sun.  When standing in the sunlight, you "
"will absorb its energy as nutrients, heal slightly faster, your mana "
"regenerates much quicker, and you gain a bonus to your maximum mana."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Solar Ascendancy"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Solar Ascendancy"
msgid ""
"Like a tree, you are fueled by the sun.  When standing in the sunlight, you "
"will absorb its energy as nutrients, heal slightly faster, your mana "
"regenerates much quicker, you gain a bonus to your maximum mana, and you gain "
"a +2 bonus to all stats."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_spell_learning_eocs.json
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_NURTURING_THE_GREEN"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_ARVORE_NURTURING_THE_GREEN_AOE"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_SUMMON_WOOD_WALL"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_COMMUNE_WITH_NATURE"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_SUMMON_BRIARS"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_FOREST_TELEPORT"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_CAUSE_DECAY"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_ARVORE_SUMMON_PRESERVATION_CONTAINER"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_SUMMON_FLORAL_BOAT"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_SUMMON_WOOD_SPIRIT"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_TERRAIN_BASH_SPELL"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_FOREST_TRANSLOCATION"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_TURN_INTO_TREE"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_VERDANT_INFUSION"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_ARVORE_SUMMON_GRASS_FIELD_SPELL"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_ROOTS_SPELL"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_CLIMBING_VINE_SPELL"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_LIVING_TENT_SPELL"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_ANTI_PLANT_SPELL"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_ARVORE_DAMAGE_ZOMBIES_HEAL_LIVING"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_TREE_TRANSFORM"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_TREE_SINGING_SPELL"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_ARVORE_CULTIVATE_GOBLIN_FRUIT"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_ARVORE_WIND_BLOWS_WILLOW_BENDS"
#. ~ Player message in effect in EoC "EOC_LEVELER_ARVORE_MAKE_GOSSAMER"
msgid ""
"Your time spent under the shadows of the trees has increased your facility "
"with your fae magicks."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in effect in EoC "EOC_HOMULLUS_NO_TRACE_ON"
msgid "Your body stops producing scent."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in false effect in EoC "EOC_HOMULLUS_NO_TRACE_ON"
msgid "Your body begins producing scent."
msgstr "Votre corps commence à produire des odeurs."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in effect in EoC "EOC_HOMULLUS_BACKSTAGE_ON"
msgid "You seem to fade into the background."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in false effect in EoC "EOC_HOMULLUS_BACKSTAGE_ON"
msgid "You become more noticeable."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_HOMULLUS_DREAMWALKER_GAIN_DREAMDROSS"
msgid ""
"As you awaken from the remnants of another's dreams, you find scraps of "
"dreamdross next to you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in false effect in EoC "EOC_HOMULLUS_GOBLIN_FRUIT"
msgid "You must be in the remnants of civilization to call forth a goblin fruit."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in effect in EoC "EOC_HOMULLUS_DOLL_FORM_ON"
msgid "Your limbs stiffen and your skin takes on an even more waxen appearance."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in false effect in EoC "EOC_HOMULLUS_DOLL_FORM_ON"
msgid "A small semblance of life returns to you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_HOMULLUS_DOLL_FORM_MOVEMENT_BREAK_CHECKER"
msgid ""
"As you take another step, you notice hostile eyes turn toward you.  They "
"don't see you as just a doll now."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_HOMULLUS_ALL_ROADS_TRANSLOCATE_CHECK"
msgid "You must be standing on a road to cast this spell."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_HOMULLUS_ALL_ROADS_ATTUNEMENT_CHECK"
msgid ""
"You must be within one of the remaining bastions of civilization to cast this "
"spell."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Name of spell "homullus_charm_feral_spell"
#. ~ Mutation name
msgid "One of Us"
msgstr "L'Un(e) d'Entre Nous"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_charm_feral_spell ( One of Us )"
msgid ""
"Insinuate yourself into a feral human's mind, tricking them into thinking you "
"are an ally."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Name of spell "homullus_summon_feral_spell"
msgid "Calling the Lost and the Damned"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_summon_feral_spell ( Calling the Lost and
#. the Damned )"
msgid "Feral humans come to your aid."
msgstr "Des humains féraux viennent à votre aide."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Name of spell "homullus_self_deception_spell"
#. ~ Mutation name
msgid "Everything Will Be Fine"
msgstr "Tout Ira Bien"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_self_deception_spell ( Everything Will Be
#. Fine )"
msgid ""
"Sometimes, it is best to focus on the positive.  This spell increases the "
"Homullus's mood when cast."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Name of spell "homullus_invisible_to_humans_spell"
#. ~ Mutation name
msgid "A Face in the Crowd"
msgstr "Un Visage dans la Foule"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_invisible_to_humans_spell ( A Face in the
#. Crowd )"
msgid ""
"Though the teeming masses of humanity are gone, the Homullus can evoke their "
"anonymizing essence with magick, rendering them invisible to any humans "
"affected by the spell."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_sense_vampires ( Sense the Night Hunters
#. )"
msgid "Weaving this glamour will allow you to sense the presence of nearby vampires."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Message of spell "homullus_sense_vampires ( Sense the Night Hunters )"
msgid ""
"You mutter a charm under your breath and feel for those who subsist on stolen "
"blood."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Name of spell "homullus_reduced_visibility_ally_spell"
#. ~ Mutation name
msgid "The Average Joe"
msgstr "Monsieur/Madame Tout-le-monde"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_reduced_visibility_ally_spell ( The
#. Average Joe )"
msgid ""
"Weave a cloak of glamour around a target, making it more difficult for "
"enemies to spot them.  This is not invisibility, and getting to close to a "
"hostile target will allow them to see through the magick."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Name of spell "homullus_restore_power_spell"
#. ~ Mutation name
msgid "Dynamo"
msgstr "Dynamo"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_restore_power_spell ( Dynamo )"
msgid ""
"Fueled by the power charging your leylines, touch a target to restore some of "
"the power in a vehicle or power grid."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Name of spell "homullus_add_learning_focus_spell"
#. ~ Mutation name
msgid "The Scholar's Regard"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_add_learning_focus_spell ( The Scholar's
#. Regard )"
msgid ""
"Unlike plants or animals, humans study subjects unrelated to survival.  This "
"spell focuses the Homullus's mind, allowing easier learning."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Name of spell "homullus_cultivate_goblin_fruit"
msgid "Discover Goblin Fruit"
msgstr "Obtenir Fruit Gobelin"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_cultivate_goblin_fruit ( Discover Goblin
#. Fruit )"
msgid ""
"With the aid of a bit of fae magick, you may find a goblin fruit abandoned "
"among the ruins.  Goblin fruit have a variety of effects, never predictable "
"but always at least somewhat beneficial.  This spell may only be cast in the "
"remnants of civilization."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Name of spell "homullus_road_translocate_spell"
#. ~ Mutation name
msgid "All Roads Lead to Rome"
msgstr "Toutes les Routes Mènent vers Rome"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_road_translocate_spell ( All Roads Lead to
#. Rome )"
msgid ""
"Humanity crisscrossed the Earth with roads, first small tracks, then earthen "
"projects, and finally mighty asphalt webs upon which billions of people "
"traveled every day.  The Homullus can stand on the remnants of that web and "
"return to any remaining locus of civilization that they have attuned to."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Name of spell "homullus_road_translocate_attune"
msgid "All Roads Lead to Rome Attunement"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutation_spells.json
#. ~ Description of spell "homullus_road_translocate_attune ( All Roads Lead
#. to Rome Attunement )"
msgid ""
"Attune to a location for later traveling.  You must attune at one of the "
"remaining bastions of civilization or concentrations of humanity."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Mannequin Skin"
msgstr "Peau de Mannequin"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Mannequin Skin"
msgid ""
"Your skin has turned pearlescent white, similar to antique dolls.  This has "
"no gameplay effects."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Porcelain Skin"
msgstr "Peau de Porcelaine"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Latex Skin"
msgstr "Peau Latex"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Homullus Eyes"
msgstr "Yeux d'Homullus"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Homullus Eyes"
msgid ""
"Upon gaining this ability the Homullus's eyes begin change to look like "
"doll's eyes, always staring at the world.  Glare no longer impacts them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Trust Me"
msgstr "Faites-moi Confiance"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Trust Me"
msgid ""
" 'Men were deceivers ever,' as the quotation runs.  To be human is to be a "
"liar.  You are much more successful at lying to people now."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "One of Us"
msgid ""
"With this ability, the Homullus can reach out to a feral's fractured mind and "
"twist it, convincing them to function as an ally."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Free Will"
msgstr "Libre Arbitre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Free Will"
msgid "The Dollkin has resistance to attacks on its ability to act on it's choices."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Sense the Toolmakers"
msgstr "Percevoir les Outilleurs"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Sense the Toolmakers"
msgid "Your powers enhance your mundane senses and allow you to detect human beings."
msgstr ""
"Vos pouvoirs améliorent vos sens mondains et vous permettent de détecter les "
"êtres humains dans vos environs."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of creature revealed by special vision "human_sense"
msgid "You sense a human here."
msgstr "Vous percevez un être humain ici."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Sense the Night Hunters"
msgid ""
"This and other abilities native to Dollkin suggest that if vampires did "
"create cities to concentrate their prey, something evolved afterwards to "
"complicate the hunting grounds."
msgstr ""
"Ceci et d'autre pouvoirs propres aux Mannequins suggère que si les vampires "
"sont derrière la création de métropoles pour concentrer leurs proies, quelque "
"chose à évolué ultérieurement pour compliquer leurs non-vies."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "The Lost and the Damned"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "The Lost and the Damned"
msgid ""
"The world crawls with the hungry dead and those who may as well be dead while "
"they still live.  This allows the Homullus to call one of the latter to their "
"side."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Everything Will Be Fine"
msgid ""
"A habit of lying is hard to break, even when, or especially when, talking to "
"oneself.  This trait grants the Homullus a spell that allows them to smooth "
"out any negative moods they experience."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "A Face in the Crowd"
msgid ""
"Upon gaining this ability the Homullus gains the ability to render themselves "
"invisible to humans."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "The Average Joe"
msgid ""
"Upon gaining this ability the Homullus gains the ability to render one of "
"their allies inconspicuous."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Dynamo"
msgid ""
"Upon gaining this ability the Homullus gains the ability to recharge vehicles "
"or power grids."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "The Scholar's Regard"
msgid ""
"Upon gaining this ability the Homullus gains the ability to focus their mind "
"to increase their learning ability."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "All Roads Lead to Rome"
msgid ""
"Upon gaining this ability the Homullus gains the ability to travel along a "
"road to any bastion of civilization they have attuned to."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Cultivate Goblin Fruit"
msgid ""
"Upon gaining this ability the Homullus gains the ability to find a goblin "
"fruit when in the remnants of civilization."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "No Trace Yet I Wish"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "No Trace Yet I Wish"
msgid ""
"The Homullus gains the ability to stop emitting scent at will.  They can use "
"this to control when scent-tracking creatures will be able to find them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "No Trace Yet I Wish (on)"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "No Trace Yet I Wish (on)"
msgid "You don't currently produce scent."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Backstage"
msgstr "Coulisses"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Backstage"
msgid ""
"At will, you can recede from the foreground of people's perceptions.  They "
"will still notice you if you make yourself known.  Conversation with actual "
"humans will be harder while this trait is active."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Backstage (on)"
msgstr "Coulisses (activé)"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Backstage (on)"
msgid "You have faded into the background."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Cybernetic Integration"
msgstr "Intégration Cybernétique"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Cybernetic Integration"
msgid ""
"Your flesh and bones can instinctively shift to allow manually installing "
"cybernetics.  You no longer need external aid to install CBMs."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Cybernetic Adaptation"
msgstr "Adaptation Cybernétique"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Cybernetic Adaptation"
msgid ""
"Your leylines have begun adapting to electronic interference.  Halves the "
"mana penalty caused by stored bionic power."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Complete Cybernetic Adaptation"
msgstr "Adaptation Cybernétique Complète"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Complete Cybernetic Adaptation"
msgid ""
"Your leylines have fully adapted to electronic interference.  You no longer "
"suffer any mana penalty for stored bionic power."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Internalized Charge"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Internalized Charge"
msgid ""
"You are capable of storing power directly in your flesh.  You gain 50 kJ of "
"bionic power storage per Homullus trait you have."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Reinforced Armor"
msgstr "Armure Renforcée"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Reinforced Armor"
#, no-c-format
msgid ""
"Humans are flimsy creatures compared to even natural animals, yet by crafting "
"armor they obtain durability that unthinking creatures will never reach.  You "
"draw on this legacy, increasing the strength of armor you wear by 20%"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Fortified Armor"
msgstr "Armure Fortifiée"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Fortified Armor"
#, no-c-format
msgid ""
"You embody the tales of ancient knights, increasing the strength of armor you "
"wear by 40%."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Equipment Hardening"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Equipment Hardening"
msgid ""
"You conceptually harden your tools and armor, reducing the chance that they "
"are damaged."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Extreme Equipment Hardening"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Extreme Equipment Hardening"
msgid ""
"You conceptually harden your tools and armor, immensely reducing the chance "
"that they are damaged."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Echoes of the Streets"
msgstr "Échos des Rues"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Echoes of the Streets"
msgid ""
"Though much of humanity has died, their echoes remain in the places they once "
"called home.  The Homullus can draw on those echoes to restore their bionic "
"power."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "The Pulse of the Invisible"
msgstr "Le Pouls Invisible"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "The Pulse of the Invisible"
msgid ""
"Though much of humanity has died, their echoes remain in the places they once "
"called home.  The Homullus can draw on those echoes to restore their bionic "
"power and mana."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "City Strider"
msgstr "Arpenteur de Villes"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "City Strider"
msgid ""
"You are at home in the artificial environments constructed by humanity.  You "
"move slightly faster within."
msgstr ""
"Un Homullus possédant ce pouvoir se sent plus confortable dans les "
"environnements artificiels construits par l'humanité et se déplace un peu "
"plus rapidement lorsqu'il les parcourent."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Endurance Hunter"
msgstr "Chasseur à l'Endurance"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Endurance Hunter"
#, no-c-format
msgid ""
"Early humans chased prey for miles before it dropped dead from exhaustion, "
"and the Homullus is heir to that legacy.  You have 33% more stamina."
msgstr ""
"Les premiers humains chassait le gibier kilomètre après kilomètre jusqu'à ce "
"que celui-ci s'écroule de fatigue, et l'Homullus est digne de cet héritage.  "
"Vous possédez 33% plus d'endurance."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Take the Line"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Take the Line"
#, no-c-format
msgid ""
"By standing together, humanity was able to overcome all threats, and it was "
"only when they turned on each other that the Cataclysm grew out of control.  "
"The Homullus regains Stamina 5% faster per ally within 30 meters (10% faster "
"per ally if they have the Homullus trait)."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "The Top of the Food Chain"
msgstr "Au Sommet de la Chaine Alimentaire"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "The Top of the Food Chain"
msgid ""
"Humanity are omnivores in the most literal sense.  You can eat anything not "
"human without any moral qualms.  However, the food that pre-Cataclysm "
"humanity would slowly poison themselves with is anathema to you, and you will "
"eat only good-tasting food unless you are starving."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "At Home in any Clime"
msgstr "A l'Aise dans Tout les Climats"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "At Home in any Clime"
msgid ""
"Before the Cataclysm there were cities all across the world.  From above the "
"Arctic Circle to directly on the equator, humanity built their dwellings.  "
"You are more comfortable with temperature extremes."
msgstr ""
"Avant le Cataclysme les cités se sont répandues partout dans le monde.  Du "
"cercle polaire à l'équateur, les hommes construisirent leurs domiciles.  Un "
"Homullus possédant ce pouvoir est plus confortable avec les températures "
"extrêmes."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "The Tool-Maker"
msgstr "Le Façonneur d'Outils"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "The Tool-Maker"
msgid ""
"Though they had no claws or fangs or armored skin, humanity mastered the "
"world through their tools.  When near civilization, your crafting speed is "
"increased."
msgstr ""
"Bien qu'elle ne possédait pas de griffes ou de crocs ou de peau coriace, "
"l'humanité fût capable de conquérir le monde avec ses outils. Un Homullus "
"possédant ce pouvoir et se trouvant près de ce qui reste de la civilisation "
"humaine reçoit un boost à sa vitesse de fabrication."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "The Innovator"
msgstr "L'Innovateur"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "The Innovator"
msgid ""
"Though they had no claws or fangs or armored skin, humanity mastered the "
"world through their tools.  When near civilization, your crafting speed and "
"ability are increased."
msgstr ""
"Bien qu'elle ne possédait pas de griffes ou de crocs ou de peau coriace, "
"l'humanité fût capable de conquérir le monde avec ses outils. Un Homullus "
"possédant ce pouvoir et se trouvant près de ce qui reste de la civilisation "
"humaine reçoit un boost à sa vitesse et son talent de fabrication."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "The Builder of Cities"
msgstr "Le Constructeur de Cités"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "The Builder of Cities"
msgid ""
"Though they had no claws or fangs or armored skin, humanity mastered the "
"world through their tools.  When near civilization, your crafting speed and "
"ability are greatly increased."
msgstr ""
"Bien qu'elle ne possédait pas de griffes ou de crocs ou de peau coriace, "
"l'humanité fût capable de conquérir le monde avec ses outils.  Un Homullus "
"possédant ce pouvoir et se trouvant près de ce qui reste de la civilisation "
"humaine reçoit un boost considérable à sa vitesse et son talent de "
"fabrication."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Essence of the Makers"
msgstr "L'Essence des Façonneurs"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Essence of the Makers"
msgid ""
"With their tools, humanity built weapons, grew food, made homes, and tamed "
"the wilderness.  The Homullus has internalized that essence into themselves, "
"allowing them to use their bare hands to accomplish many tasks that would "
"otherwise require tools."
msgstr ""
"Avec leurs outils, les hommes ont créé des armes, fait pousser de la "
"nourriture et dompté la nature.  Un Homullus possédant ce pouvoir est capable "
"d'internaliser cette capacité de changer son environnement et accomplir les "
"fonctions de nombreux outils avec ses mains nues."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Net Spider's Touch"
msgstr "Toucher de l'Araignée du Web"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Net Spider's Touch"
msgid ""
"While some other animals use simple tools, complex machinery is humanity's "
"legacy alone.  The Homullus can log into a computer or hack electronics with "
"but a touch."
msgstr ""
"Bien que certains animaux soient capable d'utiliser des outils simples, les "
"machines complexes sont l'héritage de l'humanité uniquement.  Un Homullus "
"possédant ce pouvoir est capable de se connecter à un ordinateur ou le hacker "
"avec rien d'autre qu'un simple contact."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Mimicry of Biology"
msgstr "Mimétisme Biologique"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Mimicry of Biology"
msgid ""
"As a spirit of humanity, you lack the natural biology required for mutagens "
"to function.  However, your powers have grown far enough to allow you to use "
"even the most abstract of human tools, allowing you to consume mutagens to "
"change your body.  Unlike humans, however, there are thresholds you will "
"never be able to reach, and should you choose this route, further development "
"of your native spirit powers will be closed off to you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Homullus Biology"
msgstr "Biologie d'Homullus"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Homullus No Doll Mutations"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Homullus No Doll Mutations"
msgid ""
"You have chosen the path of human mutation and further Homullus mutation is "
"closed off to you.  You should not see this in-game."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Running to Marathon"
msgstr "Courir le Marathon"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Running to Marathon"
#, no-c-format
msgid ""
"Early humans chased prey for miles before it dropped dead from exhaustion, "
"and the Homullus is heir to that legacy.  You have 33% more stamina and you "
"can run for much longer before tiring."
msgstr ""
"Les premiers humains chassait le gibier kilomètre après kilomètre jusqu'à ce "
"que celui-ci s'écroule de fatigue, et l'Homullus est digne de cet héritage.  "
"Vous possédez 33% plus d'endurance et pouvez courir pour bien plus longtemps "
"sans vous lasser."

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Death Is But A Door"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Death Is But A Door"
msgid ""
"One person may die, but their compatriots will carry their torch.  You too "
"will have your legacy maintained if you die, but in a way far less "
"metaphorical.  When you die, you will reincarnate within any nearby human, "
"immediately shifting their form to match your own.  You will not be able to "
"do this more than once per month."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Mien of the Mannequin"
msgstr "Masque du Mannequin"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Mien of the Mannequin"
msgid ""
"You may transform yourself into a doll in truth, ignoring the needs of the "
"flesh and making most monsters less likely to attack you.  However, your "
"stiff limbs will inhibit your movement."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Mannequin Form"
msgstr "Forme de Mannequin"

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Mannequin Form"
msgid ""
"You are a doll in truth.  You do not need to eat or drink, and monsters will "
"mostly ignore you, but you do not heal at all and crafting, as well as "
"movement over any ground not almost-perfectly flat, is very difficult due to "
"your stiff limbs."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Mannequin Form Anger Relations"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Mannequin Form Anger Relations"
msgid ""
"Anger relations are here in a separate mutation so that they're removed on "
"attacking a target or moving too quickly."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Mutation name
msgid "Mannequin Form Anger Relations Attacker"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_mutations.json
#. ~ Description of mutation "Mannequin Form Anger Relations Attacker"
msgid ""
"This blocks you from gaining the anger relations mutation so you can't just "
"turn Mien of the Mannequin on and off between attacks."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/homullus_spell_learning_eocs.json
#. ~ Player message in effect in EoC "EOC_LEVELER_HOMULLUS_CHARM_FERALS"
#. ~ Player message in effect in EoC "EOC_LEVELER_HOMULLUS_SUMMON_FERALS"
#. ~ Player message in effect in EoC "EOC_LEVELER_HOMULLUS_SELF_DECEPTION"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_HOMULLUS_INVISIBLE_TO_HUMANS"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_HOMULLUS_REDUCED_VISIBILITY_ALLY"
#. ~ Player message in effect in EoC "EOC_LEVELER_HOMULLUS_RESTORE_POWER"
#. ~ Player message in effect in EoC "EOC_LEVELER_HOMULLUS_ADD_LEARNING_FOCUS"
#. ~ Player message in effect in EoC "EOC_LEVELER_HOMULLUS_ROAD_TRANSLOCATION"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_HOMULLUS_CULTIVATE_GOBLIN_FRUIT"
#. ~ Player message in effect in EoC "EOC_LEVELER_HOMULLUS_MAKE_GOSSAMER"
msgid ""
"Your time spent surrounded by the remnants of civilization has increased your "
"facility with your fae magicks."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_IERDE_DETECT_NEARBY_MONSTERS_EARTH_ON"
msgid ""
"You must be in contact with the living earth or underground to activate The "
"Soil Knows Those Who Tread Upon It"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC "EOC_IERDE_GOBLIN_FRUIT"
msgid "You must be on living earth or stone to call forth a goblin fruit."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC "EOC_IERDE_IRON_ARMOR_SPELL"
msgid "You must be on living earth or stone to infuse yourself with iron."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_IERDE_ROOTED_IN_PLACE_activated"
msgid "You must be standing on the living earth to root yourself in place."
msgstr "Vous devez être au dessus de la terre-mère pour vous enraciner en place."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ value of variable 'message_success' in effect in EoC
#. "EOC_IERDE_SMASHING_PUNCH_activated"
msgid "You gather yourself for a moment and strike."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ value of variable 'message_success' in effect in EoC
#. "EOC_IERDE_NO_SLEEP_MEDITATE_activate"
msgid "You settle down, feeling the ground beneath you, and begin your vigil"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_IERDE_NO_SLEEP_MEDITATE_activate"
msgid "You must be underground to begin your vigil!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC "EOC_IERDE_NO_SLEEP_MEDITATE"
msgid "You're feeling refreshed and have no need to begin a vigil."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Verb in activity "ACT_IERDE_NO_SLEEP_MEDITATE"
msgid "watching"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC "EOC_IERDE_NO_SLEEP_MEDITATE_TURN"
msgid "You are fully refreshed and end your vigil."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC "EOC_IERDE_EARTHEN_SHIELD_SPELL"
msgid "You must be on living earth or stone to create the earthen shield."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_IERDE_SINK_INTO_EARTH_activate"
msgid "You must be on living earth or stone to sink into it."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in effect in EoC "EOC_IERDE_SLEEP_IN_EARTH_2" in nested
#. EOCs in effect in EoC "EOC_IERDE_SLEEP_IN_EARTH"
msgid "The earth parts beneath you and you sink down into the stone."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Create or Destroy Wall"
msgstr "Créer ou Détruire Mur"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Create Pit"
msgstr "Créer Trou"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Earthen Stairs Up"
msgstr "Escalier de Terre Ascendant"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Earthen Stairs Down"
msgstr "Escalier de Terre Descendant"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Smooth Stone"
msgstr "Lisser Pierre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Churn Earth for Planting"
msgstr "Remuez de la Terre pour Planter"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Turn Earth to Stone"
msgstr "Transformez Terre en Pierre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option name in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Turn Stone to Earth"
msgstr "Transformez Pierre en Terre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Turn a dirt or stone floor into a wall or vice versa."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Create a pit."
msgstr "Créez un trou."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Reshape the dirt or stone into a set of stairs going up."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Reshape the dirt or stone into a set of stairs going down."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Polish and smooth a stone wall into a mirror-like finish."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Create furrows in the earth suitable for planting crops"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Turn dirt and earth into solid rock."
msgstr "Transformez de la terre en roche."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ EOC option description in effect in EoC "EOC_RESHAPE_THE_EARTH_SELECTOR"
msgid "Turn solid rock into loose soil or dirt."
msgstr "Transformez de la roche en terre."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_IERDE_TUNNEL_TRANSLOCATE_CHECK"
msgid "You must be standing deep underground and on the living earth to translocate."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in false effect in EoC "EOC_IERDE_TUNNEL_ATTUNEMENT_CHECK"
msgid "You must be deep underground on and on the living earth  to cast this spell."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_eocs.json
#. ~ Player message in effect in EoC "EOC_IERDE_STONE_FORM_ON"
msgid "Your body stiffens as your flesh turns to stone and your joints to earth."
msgstr ""
"Votre corps devient raide, votre chair se métamorphosant en pierre et vos "
"articulations en terre."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_stomp_ground_smash_spell"
#. ~ Mutation name
msgid "Earthquake Stomp"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_stomp_ground_smash_spell ( Earthquake Stomp
#. )"
msgid ""
"Stomp on the ground and cause a minor local earthquake, damaging buildings "
"and knocking anyone nearby off their feet."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Sound description of spell "ierde_stomp_ground_smash_spell ( Earthquake
#. Stomp )"
#. ~ Sound description of spell "ierde_create_pits_spell ( Earthen Grasp )"
msgid "the ground shakes!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Message of spell "ierde_stomp_ground_smash_spell ( Earthquake Stomp )"
msgid "You stomp the ground and it quakes!"
msgstr "Vous piétinez le sol et celui-ci tremble!"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_iron_armor_spell"
#. ~ Mutation name
msgid "Invulnerable Iron Skin"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_iron_armor_spell ( Invulnerable Iron Skin )"
msgid ""
"While on living earth or stone, the Ierde may infuse their body with fae "
"iron, slowing their movement and attacks but rendering them much safer from "
"harm."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Message of spell "ierde_iron_armor_spell ( Invulnerable Iron Skin )"
msgid "You infuse yourself with the resilience of the earth."
msgstr "Vous vous infusez avec la résistance de la terre."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_knockback_punch_spell"
#. ~ Mutation name
msgid "Mountain-Toppling Punch"
msgstr "Coup de Poing Raseur de Montagnes"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_knockback_punch_spell ( Mountain-Toppling
#. Punch )"
msgid ""
"With the force of a landslide behind it, punch a single target and knock them "
"backwards."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Message of spell "ierde_knockback_punch_spell ( Mountain-Toppling Punch
#. )"
msgid "You wide up and deliver a punch with the strength of a rockslide."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_reveal_earth_map_spell"
#. ~ Mutation name
msgid "Knowing Every Furrow"
msgstr "Connaître Chaque Sillon"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_reveal_earth_map_spell ( Knowing Every Furrow
#. )"
msgid ""
"Commune with the earth, whispering to it to reveal its secrets to you.  This "
"spell will reveal natural features within a large radius around the Ierde.  "
"The spell must be cast while standing on the living earth."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_reshape_the_earth_spell"
#. ~ Mutation name
msgid "Reshape the Living Earth"
msgstr "Remodeler la Terre Vivante"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_reshape_the_earth_spell ( Reshape the Living
#. Earth )"
msgid ""
"You can mold earth like clay, turning it to stone and back, or raising it and "
"lowering it into pits or ramps or walls."
msgstr ""
"Vous pouvez façonner la terre come de l'argile, la transformant en pierre et "
"inversement, la faisant ce lever en mur et rampes, ou vice-versa en tranchées."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Message of spell "ierde_reshape_the_earth_spell ( Reshape the Living
#. Earth )"
msgid "The earth moves at your command"
msgstr "La terre se meut à votre commande"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_slow_enemies_spell"
#. ~ Mutation name
msgid "Rigidity of Stone"
msgstr "Rigidité de la Pierre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_slow_enemies_spell ( Rigidity of Stone )"
msgid "Infuse your enemies with the rigidity of stone, slowing their movements."
msgstr ""
"Infuse vos ennemis avec la rigidité et lourdeur de la pierre, ralentissant "
"leurs mouvements."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_buff_armor_allies_spell ( Skin of the
#. Mountains )"
msgid ""
"Infuse the resilience of the earth into one of your allies.  Their skin will "
"repel some of the physical damage they take, and they will be more resistant "
"to losing blood, but they will be slightly slower due to the magicks."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_earthen_shield_spell ( Impenetrable Earthen
#. Shield )"
msgid ""
"While standing on the living earth or stone, infuse your skin with the "
"hardness of bedrock.  You will take no damage at all while the spell is in "
"effect, though repeated blows can wear through the shield until it breaks."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Name of spell "ierde_entrap_target_in_stone"
msgid "Lithic Gaol"
msgstr "Geôle Lithique"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_entrap_target_in_stone ( Lithic Gaol )"
msgid ""
"Summon up a series of spikes around a single target, imprisoning them in a "
"cage of stone.  The target must be on earth or stone for the spell to take "
"effect."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_summon_earth_spirit"
#. ~ Mutation name
msgid "Calling the Children of the Stones"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_summon_earth_spirit ( Calling the Children of
#. the Stones )"
msgid "A lesser earth elemental is summoned to support you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_create_pits_spell"
#. ~ Mutation name
msgid "Earthen Grasp"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_create_pits_spell ( Earthen Grasp )"
msgid "Open the ground beneath your enemies' feet, dumping them into pits."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Name of spell "ierde_tunnel_translocation_spell"
#. ~ Mutation name
msgid "Traveling the Veins of the Earth"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_tunnel_translocation_spell ( Traveling the
#. Veins of the Earth )"
msgid ""
"The earth is crisscrossed with fissures, with layers of rock and veins of "
"metal, and deeper, with flows of molten rock.  The Ierde can flow along those "
"paths, traveling deep within the earth to any point they have previously been "
"to."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutation_spells.json
#. ~ Description of spell "ierde_cultivate_goblin_fruit ( Cultivate Goblin
#. Fruit )"
msgid ""
"You may spin a bit of fae magic into the earth, bringing forth a goblin "
"fruit.  Goblin fruit have a variety of effects, never predictable but always "
"at least somewhat beneficial.  This spell may only be cast on earth or stone."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Clay of the Earth"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Clay of the Earth"
msgid ""
"Your skin has turned the color of manganese stained soil.  Your skin is now a "
"purplish black.  This has no gameplay effects."
msgstr ""
"La couleur de votre peau s'est altérée vers un violet sombre rappelant de la "
"manganèse.  Ceci n'a aucun effet notable."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Pebbled Skin"
msgstr "Peau Caillouteuse"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Pebbled Skin"
msgid ""
"Your skin has toughened and formed pebble-like growths in some places, acting "
"as natural armor.  Somewhat reduces wet effects."
msgstr ""
"Votre peau s'est endurcie et des amas ressemblant à des gravillons se forme "
"dessus, vous fournissant un degré de protection même sans aucune armure et "
"réduisant les effets  de l'humidité."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Stone Skin"
msgstr "Peau de Pierre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Stone Skin"
msgid ""
"Your skin has developed into strong granite-like covering that retains some "
"flexibility and has grown to cover most of your body, acting as natural "
"armor.  While difficult to penetrate, it also limits your flexibility.  "
"Greatly reduces wet effects."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Ierde Eyes"
msgstr "Yeux d'Ierde"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Ierde Eyes"
msgid ""
"Upon gaining this ability the Ierde's eyes begin reflecting their mood: a "
"pale white streaked with rose when happy; pale green or grey when calm, and "
"pure obsidian black when angry.  Glare no longer impacts them and they are "
"not bothered by light levels when sleeping."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Ierde Ears"
msgstr "Oreilles d'Ierde"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Ierde Ears"
msgid ""
"The Ierde's ears are longer and pointed, like the peak of a high mountain.  "
"They can hear slightly better and are unphased by loud sounds."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Fists of Stone"
msgid ""
"The Ierde's stony skin makes their fists hit like hammers.  Though their "
"attacks are slower, the Ierde does more bashing damage with punches and can "
"use their hands to replace some simple tools."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Stone-Hardened Panoply"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Stone-Hardened Panoply"
msgid ""
"Just as their body is now one with the stone, the Ierde can infuse the "
"strength of the earth into their equipment, rendering it more resilient.  "
"While on natural earth or stone or underground, the Ierde's equipment is "
"twice as difficult to damage."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Unsleeping Earth Vigil"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Unsleeping Earth Vigil"
msgid ""
"Upon gaining this ability the Ierde gains the ability to, while underground, "
"rest and recover energy as though sleeping.  Activate to begin the vigil."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "The Soil Knows Those Who Tread Upon It"
msgstr "Le Sol a Conscience de Ceux le Foulant"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "The Soil Knows Those Who Tread Upon It"
msgid ""
"Upon gaining this ability the Ierde gains the ability to sense the movements "
"of nearby creatures, as long as they maintains contact with natural earth or "
"stone, or are underground."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Sense the Smallest Tremor"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Sense the Smallest Tremor"
msgid ""
"The Ierde's ability to sense small movements is heightened to such a degree "
"that with small movements of their fingers, they can sense the exact shape "
"and position of objects nearby.  They can craft in darkness, as long as \"The "
"Soil Knows Those Who Tread Upon It\" is active."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Avalanche Blow"
msgstr "Frappe Avalanche"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Avalanche Blow"
msgid ""
"With a brief moment to stabilize themselves, the Ierde strikes a wall, door, "
"or other terrain feature with the force of a falling boulder, doing many "
"times their normal damage."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Earthquake Stomp"
msgid ""
"Upon gaining this ability the Ierde gains the ability to stomp on the ground "
"and cause a minor local earthquake."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Mountain-Toppling Punch"
msgid ""
"Upon gaining this ability the Ierde gains the ability to strike an enemy with "
"a blow that does extra damage and knocks them backwards."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Knowing Every Furrow"
msgid ""
"Upon gaining this ability the Ierde gains the ability to learn the terrain "
"layout in a large area around themselves."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Earthen Grasp"
msgid ""
"Upon gaining this ability the Ierde gains the ability to create large pits on "
"diggable ground, dumping their enemies into them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Rigidity of Stone"
msgid ""
"Upon gaining this ability the Ierde may infuse the rigidity of stone into "
"their enemies, slowing their movements."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Reshape the Living Earth"
msgid ""
"Upon gaining this ability the Ierde may reshape the earth, raising or "
"lowering earth or stone or turning the one into the other."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Calling the Children of the Stones"
msgid ""
"Allows the Ierde to summon a minor earth elemental to support them in the "
"world for a short time."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Invulnerable Iron Skin"
msgid ""
"Stone endures but armor is made of metal.  While standing on natural earth or "
"stone, the Ierde can infuse their skin with metal, slowing their movement and "
"encumbering them but rendering them much harder to damage."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Impenetrable Earthen Shield"
msgid ""
"While standing on natural earth or stone, the Ierde can summon up an earthen "
"shield to protect themselves.  They will be invulnerable until the shield "
"breaks."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Skin of the Mountains"
msgid ""
"When gaining this ability, the Ierde gains the ability to infuse the "
"resilience of the earth into one of their allies."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
#. ~ The name is a reference to Chapter 63 of Bleak House by Charles Dickens
msgid "An Iron Taste and an Iron Smell"
msgstr "Un Goût de Fer et un Nez de Fer"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "An Iron Taste and an Iron Smell"
msgid ""
"The Ierde has taken the essence of iron into themselves.  They no longer "
"smell anything like a human, smelling only like a faint whiff of iron if they "
"have any scent at all, and can produce all their iron their body needs "
"themselves."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Tireless Strength of the Earth"
msgstr "La Force Inlassable de la Terre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Tireless Strength of the Earth"
msgid ""
"The Ierde can draw on the boundless strength of the earth, increasing their "
"stamina."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Unceasing Strength of the Earth"
msgstr "La Force Continuelle de la Terre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Unceasing Strength of the Earth"
msgid ""
"The Ierde can draw even deeper on the boundless strength of the earth, "
"greatly increasing their stamina."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Inexhaustible Strength of the Earth"
msgstr "La Force Inépuisable de la Terre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Inexhaustible Strength of the Earth"
msgid ""
"The Ierde can draw from boundless strength of the very depths of the earth, "
"enormously increasing their stamina."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Stone Does Not Grow Weary"
msgstr "La Roche Ne Se Lasse Pas"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Stone Does Not Grow Weary"
#, no-c-format
msgid "When underground or on natural earth, the Ierde recovers Stamina 50% faster."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "The Stone Endures"
msgstr "La Roche Perdure"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "The Stone Endures"
#, no-c-format
msgid ""
"When underground or on natural earth, the Ierde recovers Stamina 50% faster "
"and heals 33% faster."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Stone Does Not Cry Out"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Stone Does Not Cry Out"
msgid "Like the stone, the Ierde suffers little from blows.  All pain is halved."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "In the Earthmother's Embrace"
msgstr "L'Étreinte de la Terre-Mère"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "In the Earthmother's Embrace"
msgid ""
"Upon gaining this ability the Ierde gains the ability to sink into the living "
"earth, where they will heal faster, they will not need to eat or drink, and "
"sleep will be more restful for them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Sleeping in the Earth"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Sleeping in the Earth"
msgid ""
"You are resting in the depths of the earth.  You should never actually see "
"this."
msgstr ""
"Vous êtes en train de vous reposer dans les entrailles de la terre. Vous ne "
"devriez jamais être capable de voir ceci hors du mode de débugage."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Blood of the Earth"
msgstr "Sang de la Terre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Blood of the Earth"
msgid ""
"The Ierde's blood has turned black and grown thick and tar-like.  They will "
"bleed much more slowly."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Black Blood of the Earth"
msgstr "Sang Noir de la Terre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Black Blood of the Earth"
msgid ""
"The Ierde's blood has turned into a black sludge that barely flows.  They no "
"longer bleed at all."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "The Mountain Does Not Move"
msgstr "La Montagne ne Bouge Pas"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "The Mountain Does Not Move"
msgid ""
"Though the earth shivers and shakes, the mountain stands tall.  The Ierde is "
"immune to knockback."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "The Root of the Mountain"
msgid ""
"When standing on the living earth or underground, the Ierde can root "
"themselves in place.  While doing so, they cannot move, but they are immune "
"to being stunned, dazed, or downed, and gain additional armor."
msgstr ""
"Lorsque une Ierde est présente sur une case de terre vivante ou sous terre, "
"il lui est possible de s'enraciner, la fixant en place en échange d'immunités "
"aux attaques d'étourdissement et de plaquage ainsi que de l'armure "
"supplémentaire."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Durability of the Earth"
msgstr "Durabilité du Sol"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Durability of the Earth"
#, no-c-format
msgid "The Ierde has some of the toughness of the earth.  +15% hit points."
msgstr "L'ierde hérite la solidité de la terre.  (PVs +15%)."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Durability of the Stone"
msgstr "Durabilité de la Pierre"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Durability of the Stone"
#, no-c-format
msgid "The Ierde has some of the toughness of the stone.  +30% hit points."
msgstr "L'ierde hérite la solidité de la roche.  (PVs +30%)."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Durability of the Mountain"
msgstr "Durabilité de la Montagne"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Durability of the Mountain"
#, no-c-format
msgid "The Ierde has the toughness of the enduring mountains.  +45% hit points."
msgstr "L'ierde hérite la solidité des montagnes éternelles.  (PVs +45%)."

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Cultivate Goblin Fruit"
msgid ""
"Upon gaining this ability the Ierde gains the ability to grow a goblin fruit "
"from a earth or stone."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Vigor of the Soil"
msgstr "La Vigueur du Sol"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Vigor of the Soil"
msgid "Like the bountiful soil, the Ierde is filled with power.  +3 Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Vigor of the Stone"
msgstr "La Vigueur de la Roche"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Vigor of the Stone"
msgid "Like the stone, the Ierde can withstand any punishment.  +5 Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Vigor of the Mountain"
msgstr "La Vigueur de la Montagne"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Vigor of the Mountain"
msgid "Like the mountain, the Ierde is unmoved by calamity.  +7 Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Vigor of the Bedrock"
msgstr "La Vigueur de la Roche-Mère"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Vigor of the Bedrock"
msgid ""
"Like the bedrock, the Ierde's might can support the entire world.  +9 "
"Strength."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "The Hills Overlook the Valleys"
msgstr "Les Collines Veillent sur les Vallées"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "The Hills Overlook the Valleys"
msgid ""
"Like an observer on a mountaintop, the Ierde sees more than most.  +3 "
"Perception."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "The Mountain Is Unflinching"
msgstr "La Montagne est Imperturbable"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "The Mountain Is Unflinching"
msgid ""
"While on living earth or stone or underground, the Ierde is as impassive as "
"the mountains and feels no pain at all."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "The Stone Does Not Rot"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "The Stone Does Not Rot"
msgid ""
"The stones do not rot as the trees or humans do, and neither is the Ierde "
"affected by the frailties of the flesh.  They are immune to disease and "
"cannot suffer from parasites."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Mind of Iron"
msgstr "Esprit de Fer"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Mind of Iron"
msgid ""
"The Ierde's mind has the resilience of iron, and they cannot be affected by "
"delusions, hallucinations, or other mental problems."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Stone Meditations"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Stone Meditations"
msgid ""
"The Ierde meditates on the nature of stone and removes themselves from the "
"highs and lows of mortal emotions."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Traveling the Veins of the Earth"
msgid ""
"Upon gaining this ability the Ierde gains the ability to travel through stone "
"to another underground location they have previously been to."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Form of the Solid Earth"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Form of the Solid Earth"
msgid ""
"The Ierde may transform into rock and earth.  They become incredibly "
"resilient and nearly immune to some forms of damage, but will be much, much "
"slower."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Earthen Form"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Earthen Form"
msgid ""
"You are a mass of stone and earth.  You are incredibly resilient, but you are "
"extremely slow."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Mutation name
msgid "Body of Adamant"
msgstr "Corps de Diamant"

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#. ~ Description of mutation "Body of Adamant"
msgid ""
"The Ierde is so infused with the power of stone they are approaching "
"invincibility.  There is a small chance that attacks against them simply "
"rebound off their rocky skin, and their limbs are so resilient that they will "
"never break."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_spell_learning_eocs.json
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_STOMP_GROUND_SMASH"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_CREATE_PITS"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_KNOCKBACK_PUNCH"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_IRON_ARMOR"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_REVEAL_EARTH_MAP"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_RESHAPE_THE_EARTH"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_SLOW_ENEMIES"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_IERDE_ENTRAP_TARGET_IN_STONE"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_EARTHEN_SHIELD"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_BUFF_ARMOR_ALLIES"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_SUMMON_EARTH_SPIRIT"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_TUNNEL_TRANSLOCATE"
#. ~ Player message in effect in EoC
#. "EOC_LEVELER_IERDE_CULTIVATE_GOBLIN_FRUIT"
#. ~ Player message in effect in EoC "EOC_LEVELER_IERDE_MAKE_GOSSAMER"
msgid ""
"Your time spent surrounded by the living earth has increased your facility "
"with your fae magicks."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_PARACLESIAN_FAE_SIGHT_PROCESSING"
msgid "You do not have enough mana to fuel your fae sight!"
msgstr "Vous n'avez pas assez de mana pour alimenter votre vision féerique!"

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_eocs.json
#. ~ Player message in effect in EoC
#. "EOC_SUCCESSFUL_ROLL_REMAINDER_GOSSAMER_RECIPE"
msgid "Your dreams have revealed to you a recipe for gossamer raiment."
msgstr "Vos rêves vous on révélé une recette pour un type d'habit en tulle féerique."

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_eocs.json
#. ~ Player message in effect in EoC "EOC_PARACLESIAN_TURN_COTTON_TO_GOSSAMER"
msgid ""
"The moonlight permeates the cotton and it begins to shimmer like an opal in "
"the sunlight."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_eocs.json
#. ~ Player message in false effect in EoC
#. "EOC_PARACLESIAN_TURN_COTTON_TO_GOSSAMER"
msgid "You must be outdoors under the moonlight to turn cotton into gossamer."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_eocs.json
#. ~ Message in nested effect in else statement in effect in EoC
#. "EOC_WANTS_TO_TALK"
msgid "You cannot lead this person to talk to you anymore."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC "EOC_ARVORE_FAE_BAN_CUT_TREE"
msgid ""
"You feel a stabbing pain as the tree falls.  One of your own, murdered by "
"your hand."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC "EOC_ARVORE_FAE_BAN_LIGHT_FIRE"
msgid ""
"Your heart races as you spark the fire.  A fire, outdoors, in the view of the "
"trees and the grasses.  Visions of charred wood, of blackened trunks and "
"broken branches, fill your mind."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_ARVORE_FAE_BAN_SLEPT_IN_CITY"
msgid ""
"You awaken with a groggy head, blinking bleary eyes.  Sleeping near the "
"remnants of civilization away from the bounty of nature, your sleep was not "
"as restful as it should have been."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC
#. "EOC_IERDE_FAE_BAN_DIDNT_SLEEP_UNDERGROUND"
msgid ""
"You awaken in pain, your muscles stiff, your body groaning in protest.  Away "
"from the depths of the living earth, your sleep was not as restful as it "
"should have been."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC
#. "EOC_IERDE_FAE_BAN_USED_TOOLS_ON_THE_EARTH"
msgid ""
"You feel a stabbing pain as your tools dig into the living earth.  Tools made "
"of material torn from the earth by humans.  You should not be using them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC "EOC_HOMULLUS_FAE_BAN_KILL_HUMAN"
#. ~ Player message in effect in EoC "EOC_HOMULLUS_FAE_BAN_KILL_HUMAN_MONSTER"
msgid ""
"You feel a stab of pain as the human collapses in a puddle of their own "
"blood.  A human, slain by your hand, in defiance of your nature."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC
#. "EOC_HOMULLUS_FAE_BAN_DIDNT_SLEEP_NEAR_HUMANS"
msgid ""
"You awaken with a start as a terrible feeling of crushing loneliness grips "
"you.  You were meant to live in close contact with humans, not wake up to an "
"empty home."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC "EOC_SALAMANDER_FAE_BAN_GET_WET"
msgid ""
"Accursed water!  The touch of it burns you like acid, reminding you of your "
"nature.  Your flames must not be dowsed."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC "EOC_SYLPH_FAE_BAN_DIDNT_SLEEP_OUTSIDE"
msgid ""
"You gasp as you awaken, the still air barely moving into your lungs.  You "
"long for the blowing winds."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC
#. "EOC_SYLPH_FAE_BAN_TOO_LONG_UNDERGROUND_APPLY_PENALTY"
msgid ""
"The walls seem like they're closing in on you.  You were born to fly free, to "
"dance on the winds, not to cower underground like a worm.  You have to get "
"out to the open sky."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_fae_bans.json
#. ~ Player message in effect in EoC "EOC_UNDINE_FAE_BAN_SLEEP_ON_LAND"
msgid ""
"You gasp as you awaken, thin air barely filling your lungs as you struggle to "
"breath.  You long for the soothing embrace of the waters."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutations.json
#. ~ Name of spell "cloud_of_steam_sylph"
#. ~ Name of spell "cloud_of_steam_undine"
#. ~ Mutation name
msgid "Cloud of Steam"
msgstr "Nuage de Vapeur"

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Description of spell "cloud_of_steam_sylph ( Cloud of Steam )"
#. ~ Description of spell "cloud_of_steam_undine ( Cloud of Steam )"
msgid "You bring forth a cloud of boiling water."
msgstr "Vous invoquez un nuage d'eau bouillante."

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutations.json
#: data/mods/Xedra_Evolved/obsoletion_and_migration/mutations.json
#: data/mods/Xedra_Evolved/obsoletion_and_migration/spells.json
#. ~ Name of spell "paraclesian_spell_dodge_bonus_arvore"
#. ~ Name of spell "paraclesian_spell_dodge_bonus_sylph"
#. ~ Mutation name
#. ~ Name of spell "paraclesian_spell_dodge_bonus"
msgid "The Wind Blows, the Willow Bends"
msgstr "Le Vent Souffle, la Tige Plie"

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Description of spell "paraclesian_spell_dodge_bonus_arvore ( The Wind
#. Blows, the Willow Bends )"
msgid ""
"Like the flitting wind or the flexible willow, the spell allows you to avoid "
"attacks much more easily.  It has <color_yellow>reduced effects</color> when "
"on artificial terrain."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Description of spell "paraclesian_spell_dodge_bonus_sylph ( The Wind
#. Blows, the Willow Bends )"
msgid ""
"Like the flitting wind or the flexible willow, the spell allows you to avoid "
"attacks much more easily.  It has <color_yellow>reduced effects</color> "
"indoors."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Name of spell "paraclesian_spell_make_gossamer"
#. ~ Name of spell "paraclesian_spell_make_gossamer_real"
msgid "Weave Gossamer"
msgstr "Tisser la Tulle"

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Description of spell "paraclesian_spell_make_gossamer ( Weave Gossamer )"
#. ~ Description of spell "paraclesian_spell_make_gossamer_real ( Weave
#. Gossamer )"
msgid "Under the light of the moon, you can weave cotton into gossamer."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Name of spell "homullus_spell_wish_to_converse"
msgid "Wish to Converse"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Description of spell "homullus_spell_wish_to_converse ( Wish to Converse
#. )"
msgid ""
"When this spell is cast, the target will somehow begin to care about you very "
"much and can't not help but talk to."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Name of effect type id "effect_wants_to_talk"
msgid "Seeming to want to talk to you"
msgstr "Cette personne à l'air de vouloir vous parler"

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutation_spells.json
#. ~ Description of effect type "Seeming to want to talk to you"
msgid "This person wants to talk with you."
msgstr "Cette personne veux vous parler."

#: data/mods/Xedra_Evolved/mutations/paraclesians/paraclesian_mutations.json
