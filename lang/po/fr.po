msgstr[2] "cubes engravés"

#: data/json/items/relics/altered_items.json
#. ~ Description of "engraved cube"
msgid ""
"A small cube of smooth rock.  A uniform grid of nine squares is engraved in "
"each of its faces."
msgstr ""
"Un petit cube de roche lisse, une grille de neuf carrés uniformes engravés "
"sur chaque face."

#: data/json/items/relics/altered_items.json
#. ~ Item name
msgid "Utah teapot"
msgid_plural "Utah teapots"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/relics/altered_items.json
#. ~ Description of "Utah teapot"
msgid ""
"A squat teapot with a minimalist design.  Its surface shines under the glow "
"of unseen light sources."
msgstr ""

#: data/json/items/relics/altered_items.json
#. ~ Item name
msgid "glitching stopwatch"
msgid_plural "glitching stopwatches"
msgstr[0] "chronomètre défectueux"
msgstr[1] "chronomètres défectueux"
msgstr[2] "chronomètres défectueux"

#: data/json/items/relics/altered_items.json
#. ~ Description of "glitching stopwatch"
msgid ""
"A small digital stopwatch, looking slightly old by today's standards.  Its "
"digital display prints ever-changing gibberish."
msgstr ""
"Un petit chronomètre numérique, d'apparence légèrement démodée par rapport "
"aux standards actuels. Son écran numérique affiche un charabia en constante "
"évolution."

#: data/json/items/relics/altered_items.json
#. ~ Item name
msgid "Hawaiian shirt"
msgid_plural "Hawaiian shirts"
msgstr[0] "t-shirt hawaïen"
msgstr[1] "t-shirts hawaïens"
msgstr[2] "t-shirts hawaïens"

#: data/json/items/relics/altered_items.json
#. ~ Description of "Hawaiian shirt"
msgid ""
"A slightly worn button-down shirt with a tropical pattern, straight out of "
"the 80's.  You swear that every time you look away and look back, the pattern "
"changes subtly."
msgstr ""
"Une chemise à boutons, légèrement usée, arborant un motif tropical des années "
"80. Vous avez l'impression qu'à chaque fois que vous détournez le regard, "
"puis que vous la regardez à nouveau, le motif change subtilement."

#: data/json/items/relics/altered_items.json
#. ~ Item name
msgid "defaced badge"
msgid_plural "defaced badges"
msgstr[0] "Badge dégradé"
msgstr[1] "Badges dégradés"
msgstr[2] "Badges dégradés"

#: data/json/items/relics/altered_items.json
#. ~ Description of "defaced badge"
msgid ""
"A strange golden badge in the shape of a shield with scratched out lettering. "
" The faceless figures decorating the badge seem taller and thinner than "
"ordinary humans."
msgstr ""
" \n"
"Un étrange badge doré en forme de bouclier, avec des inscriptions rayées. Les "
"personnages sans visage qui ornent le badge semblent plus grands et plus "
"minces que des humains ordinaires."

#: data/json/items/relics/altered_items.json
#. ~ Item name
msgid "pair of strange sunglasses"
msgid_plural "pairs of strange sunglasses"
msgstr[0] "paire de lunettes de soleil étrange"
msgstr[1] "paires de lunettes de soleil étranges"
msgstr[2] "paires de lunettes de soleil étranges"

#: data/json/items/relics/altered_items.json
#. ~ Description of "pair of strange sunglasses"
msgid ""
"A pair of thin, round sunglasses.  The tinted glass seems to reflect the same "
"shade of baleful orange light no matter what light it reflects."
msgstr ""
"Une paire de lunettes de soleil rondes et fines. Les verres teintés semblent "
"refléter la même teinte de lumière orange sinistre, quelle que soit la "
"lumière qu'ils réfléchissent."

#: data/json/items/relics/altered_items.json
#. ~ Item name
msgid "pair of antique scissors"
msgid_plural "pairs of antique scissors"
msgstr[0] " Paire de ciseaux ancien"
msgstr[1] " Paires de ciseaux anciens"
msgstr[2] " Paires de ciseaux anciens"

#: data/json/items/relics/altered_items.json
#. ~ Description of "pair of antique scissors"
msgid ""
"A pair of ornately decorated steel scissors.  The handle is decorated with "
"vicious-looking birds."
msgstr ""
"Une paire de ciseaux en acier ornés de motifs complexes. Les manches sont "
"décorées d'oiseaux aux allures féroces."

#: data/json/items/relics/altered_items.json
#. ~ Item name
msgid "antique silver locket"
msgid_plural "antique silver lockets"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/relics/altered_items.json
#. ~ Description of "antique silver locket"
msgid ""
"A heart-shaped silver locket with an black-and-white image of a smiling woman "
"in it.  Her eyes seem to follow you whenever you look at it."
msgstr ""

#: data/json/items/relics/altered_items.json
#. ~ Description of "varsity jacket"
msgid ""
"A jacket traditionally worn by school athletes.  The logo of the school has "
"an oddly detailed fractal pattern that draws your eye in whenever you look at "
"it."
msgstr ""

#: data/json/items/relics/altered_items.json
#. ~ Item name
msgid "ambiguous apron"
msgid_plural "ambiguous aprons"
msgstr[0] "tablier ambigu"
msgstr[1] "tabliers ambigus"
msgstr[2] "tabliers ambigus"

#: data/json/items/relics/altered_items.json
#. ~ Description of "ambiguous apron"
msgid ""
"A long apron with a plain pattern on it.  Your eyes can't seem to decide what "
"color it is."
msgstr ""

#: data/json/items/relics/monolith_items.json
#. ~ Item name
msgid "inscribed disc"
msgid_plural "inscribed discs"
msgstr[0] "disque gravé"
msgstr[1] "disques gravés"
msgstr[2] "disques gravés"

#: data/json/items/relics/monolith_items.json
#. ~ Description of "inscribed disc"
msgid ""
"A thin, palm-sized disc of incredibly dense stone, engraved with meaningless "
"swirls.  Its surface seems to repel grime and debris, and it refuses to "
"tarnish or scratch."
msgstr ""

#: data/json/items/relics/monolith_items.json
#. ~ Item name
msgid "warped brick"
msgid_plural "warped bricks"
msgstr[0] "brique déformée"
msgstr[1] "briques déformées"
msgstr[2] "briques déformées"

#: data/json/items/relics/monolith_items.json
#. ~ Description of "warped brick"
msgid ""
"This brick of too-dense stone is warped in a way that just barely makes it "
"worthless as a building material.  Its smooth surface is unmarred by texture, "
"dirt, or color."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "alien resin chunk"
msgid_plural "alien resin chunks"
msgstr[0] "morceau de résine extraterrestre"
msgstr[1] "morceaux de résine extraterrestre"
msgstr[2] "morceaux de résine extraterrestre"

#: data/json/items/resources/alien.json
#. ~ Description of "alien resin chunk"
msgid ""
"A shattered fragment of alien resin.  It looks a bit like a large piece of "
"sea glass, frosted and gritty with the edges rounded off.  It is somewhat "
"warm to the touch."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "alien resin pod"
msgid_plural "alien resin pods"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "alien resin pod"
msgid ""
"A large pod the size of a beer keg, filled with gooey alien resin.  Squeezing "
"it firmly causes resin to squirt from the broken stalk at the end, hardening "
"within a few seconds of being exposed to the air."
msgstr ""
"Une grande capsule de la taille d'un tonneau de bière, remplie de résine "
"extraterrestre gluante. En la pressant fermement, la résine jaillit de la "
"tige cassée à l'extrémité et durcit en quelques secondes après avoir été "
"exposée à l'air."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "alien fern branch"
msgid_plural "alien fern branches"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "alien fern branch"
msgid ""
"A branching trunk of leaves from a massive fern, about two feet long and a "
"couple of feet across in diameter when including the leaves.  Maybe one day "
"you'll think of something to make with a giant fern."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "Exodii chassis"
msgid_plural "Exodii chassis"
msgstr[0] "châssis Exodii"
msgstr[1] "châssis Exodii"
msgstr[2] "châssis Exodii"

#: data/json/items/resources/alien.json
#. ~ Description of "Exodii chassis"
msgid ""
"This roughly hexagonal frame and associated bodywork looks like it was "
"constructed as a single piece.  The fitting holes and attachments are "
"extremely durable, despite showing signs of heavy wear and repair.  The "
"structure is versatile, and could probably be engineered to serve a number of "
"different heavy combat roles."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "Exodii drone chassis"
msgid_plural "Exodii drone chassis"
msgstr[0] "châssis de drone Exodii"
msgstr[1] "châssis de drone Exodii"
msgstr[2] "châssis de drone Exodii"

#: data/json/items/resources/alien.json
#. ~ Description of "Exodii drone chassis"
msgid ""
"This small, roughly hexagonal frame and associated bodywork looks like it was "
"constructed as a single piece.  The fitting holes and attachments are "
"extremely durable, despite showing signs of heavy wear and repair.  The "
"structure is versatile, and could probably be engineered to serve a number of "
"different heavy combat roles."
msgstr ""
"Ce petit cadre grossièrement hexagonal et sa carrosserie semblent avoir été "
"construits d'une seule pièce. Les trous de fixation et les attaches sont "
"extrêmement durables, même s'ils présentent des signes d'usure et de "
"réparation. La structure est polyvalente et pourrait probablement être conçue "
"pour remplir un certain nombre de rôles de combat lourd différents."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "cybernetic neural matrix"
msgid_plural "cybernetic neural matrices"
msgstr[0] "matrice neurale cybernétique"
msgstr[1] "matrices neurales cybernétiques"
msgstr[2] "matrices neurales cybernétiques"

#: data/json/items/resources/alien.json
#. ~ Description of "cybernetic neural matrix"
msgid ""
"A series of tanks and tubes with ports for fluids, electricity, and input and "
"output, this complex arrangement is made to house a brain and spine, and the "
"most difficult to replace organs for keeping them alive."
msgstr ""
"Constitué d'une série de réservoirs et de tubes dotés d'orifices pour les "
"fluides, l'électricité, les entrées et les sorties, cet agencement complexe "
"est conçu pour abriter un cerveau et une colonne vertébrale, ainsi que les "
"organes les plus difficiles à remplacer pour les maintenir en vie."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "unfamiliar electronic thingy"
msgid_plural "unfamiliar electronic thingies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "unfamiliar electronic thingy"
msgid ""
"The wiring and general shape suggest to you that this is a computer, or at "
"least some sort of electronic device, but what it is and what role it serves "
"is lost on you.  It's heavy and sturdy in construction."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "inscribed metal plates"
msgid_plural "inscribed metal plates"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "inscribed metal plates"
msgid ""
"This device looks electronic, but is unfamiliar.  It is a series of tightly "
"fitted coppery-looking rings, set concentrically.  Wires run from each ring "
"to an axis in the middle."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "small unfamiliar electronic thingy"
msgid_plural "small unfamiliar electronic thingies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "small unfamiliar electronic thingy"
msgid ""
"The wiring and general shape suggest to you that this is a tiny computer, or "
"at least some sort of electronic device, but what it is and what role it "
"serves is lost on you.  It's small enough to fit into your palm."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "inscribed metal rings"
msgid_plural "inscribed metal rings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "inscribed metal rings"
msgid ""
"This device looks electronic, but is unfamiliar.  It is a series of tightly "
"fitted coppery-looking nuts, set concentrically.  Wires run from each nut to "
"an axis in the middle."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "cybernetic sensor"
msgid_plural "cybernetic sensors"
msgstr[0] "capteur cybernétique"
msgstr[1] "capteurs cybernétiques"
msgstr[2] "capteurs cybernétiques"

#: data/json/items/resources/alien.json
#. ~ Description of "cybernetic sensor"
msgid ""
"From the large glassy eye - the size of a small dinner plate - in the front, "
"you deduce this is some sort of camera.  None of the inner workings make any "
"sense to you nor resemble any camera you've seen before."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "rotary device"
msgid_plural "rotary devices"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "rotary device"
msgid ""
"You assume from the coils of coppery wire and the protruding piston that this "
"is some sort of motor or generator, but the design doesn't look similar to "
"anything you've seen before, and you can't figure out how to get it to work."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "engraved parabolic dish"
msgid_plural "engraved parabolic dishes"
msgstr[0] "antenne parabolique engravée"
msgstr[1] "antennes paraboliques engravées"
msgstr[2] "antennes paraboliques engravées"

#: data/json/items/resources/alien.json
#. ~ Description of "engraved parabolic dish"
msgid ""
"This hefty parabolic dish is engraved with an unrecognizable pattern of "
"symbols that might, at a guess, be some sort of circuitry pattern - or maybe "
"a religious incantation."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "oblong device"
msgid_plural "oblong devices"
msgstr[0] "appareil oblong"
msgstr[1] "appareils oblongs"
msgstr[2] "appareils oblongs"

#: data/json/items/resources/alien.json
#. ~ Description of "oblong device"
msgid ""
"Perfectly smooth, cool to the touch, and a dull blue-gray color, this looks "
"almost like a perfect riverstone at first glance.  Its artificial nature is "
"betrayed upon closer inspection by a network of intricate patterns visible as "
"a slight difference in the reflection of light off its surface."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "enormous aluminum ingot"
msgid_plural "enormous aluminum ingots"
msgstr[0] "lingot d'aluminium énorme"
msgstr[1] "lingots d'aluminium énormes"
msgstr[2] "lingots d'aluminium énormes"

#: data/json/items/resources/alien.json
#. ~ Description of "enormous aluminum ingot"
msgid "A block of pure aluminum at least as big as a dishwasher."
msgstr "Un lingot d'aluminium de la taille d'une machine à laver."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "enormous plastic block"
msgid_plural "enormous plastic blocks"
msgstr[0] "bloc de plastique énorme"
msgstr[1] "blocs de plastique énormes"
msgstr[2] "blocs de plastique énormes"

#: data/json/items/resources/alien.json
#. ~ Description of "enormous plastic block"
msgid ""
"A single enormous brick of plastic, big enough for you to curl up inside if "
"it were hollow."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "enormous steel ingot"
msgid_plural "enormous steel ingots"
