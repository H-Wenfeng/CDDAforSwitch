#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_outfitter.json
#: data/mods/aftershock_exoplanet/npcs/Augustmoon_Salvors/augustmoon_outfitter.json
#. ~ NPC dialogue line
msgid "&You find the clerk in between stacked second hand outfits of all kinds."
msgstr ""

#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_outfitter.json
#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_tool_trader.json
#. ~ Response to NPC dialogue
msgid "I'm want to buy some gear."
msgstr ""

#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_tool_trader.json
#: data/mods/aftershock_exoplanet/npcs/Augustmoon_Salvors/augustmoon_tool_trader.json
#. ~ Name of an NPC class
