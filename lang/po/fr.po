msgid_plural "wooden prosthetic left arms"
msgstr[0] "prothèse de bras gauche en bois"
msgstr[1] "prothèses de bras gauche en bois"
msgstr[2] "prothèses de bras gauche en bois"

#: data/mods/Limb_WIP/armor/arm_prosthetics.json
