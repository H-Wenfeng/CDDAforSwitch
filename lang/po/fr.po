#: data/mods/Xedra_Evolved/snippets/migo_speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid ""
"\"We negotiated salvage rights to any biological matter remaining in the "
"event of civilizational collapse.\""
msgstr ""
"\"Nous avions négociés nos droits de récupération de toute matière "
"biologiques restantes après un effondrement civilisationnel.\""

#: data/mods/Xedra_Evolved/snippets/migo_speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Come with us if you want to live!\""
msgstr "\"Venez avec nous si vous voulez vivre!\""

#: data/mods/Xedra_Evolved/snippets/migo_speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Cease opposition.  Our rights here are guaranteed by treaty M-A-J-I-K-1-2.\""
msgstr ""
"\"Cessez votre opposition, nos droits ici sont garantis par le traité "
"M-A-J-I-K-1-2.\""

#: data/mods/Xedra_Evolved/snippets/migo_speech.json
#. ~ Speech from speaker mon_mi_go, mon_mi_go_slaver, mon_mi_go_myrmidon
msgid "\"Your government no longer exists, we will adopt you.\""
msgstr "\"Votre gouvernement n'existe plus, nous vous adopterons.\""

