#: data/json/npcs/campus/NPC_campus_guard_generic.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard_generic.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_guard.json
#. ~ NPC dialogue line
msgid "I'm not in charge here, you're looking for someone else…"
msgstr "Je ne suis pas aux commande ici, vous cherchez quelqu'un d'autre…"

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#. ~ NPC dialogue line
msgid "Stay alert, there's trouble in these woods."
msgstr "Restez alerte, il y a des choses qui rôdent en ce moment."

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#. ~ NPC dialogue line
msgid "Just on lookout, move along."
msgstr "Je suis juste de garde, circulez."

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard_generic.json
#. ~ NPC dialogue line
msgid "Don't distract me.  I'm on watch."
msgstr "Ne me distrayez pas. Je suis de garde."

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#. ~ NPC dialogue line
msgid "Hello.  Welcome to the library."
msgstr "Bonjour, bienvenue à la bibliothéque."

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#. ~ NPC dialogue line
msgid "Good evening.  Welcome to the library."
msgstr "Bonsoir. Bienvenue à la bibliothéque."

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#. ~ Response to NPC dialogue
msgid "How did you get stuck with guard duty?"
msgstr "Comment est-ce que vous êtes retrouvé(e) coincé avec un tour de garde?"

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_Soldier_1.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard_generic.json
#: data/json/npcs/robofac/robofac_ancilla_npcs/NPC_ANCILLA_HQ_GUARD.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_guard.json
#: data/mods/No_Hope/NPC/NPC_Old_Guard_Soldier.json
#. ~ Response to NPC dialogue
#. ~ Negative response to NPC dialogue
msgid "Don't mind me…"
msgstr "Ne vous occupez pas de moi…"

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#. ~ NPC dialogue line
msgid ""
"Everybody left has to take a turn.  I guess it's fair but not everyone is "
"really suited for beating up zombies or whatever."
msgstr ""
"Tout ceux qui restent doivent faire une tournée. Je suppose que c'est juste "
"mais tout le monde n'est pas vraiment autant équipé pour frapper des zombies "
"ou autre chose."

#: data/json/npcs/campus/NPC_campus_guard_generic.json
#. ~ NPC dialogue line
msgid ""
"I live for this stuff.  I'm not really big on books, so this is probably what "
"I'm best at here."
msgstr ""
"Je ne me débrouille pas très bien avec les livres, donc je suppose que ceci "
"est le meilleur que je peut apporter à la communauté."

#: data/json/npcs/campus/generic_class_definitions.json
#: data/json/npcs/refugee_center/surface_staff/generic_class_definitions.json
#. ~ Job description of "Guard" NPC class
msgid "I'm on a guard shift."
msgstr "Je suis de garde."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "*whispering.  \"Welcome back to the Library.\""
msgstr "*chuchote. \"Bon retour à la librairie.\""

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "*whispering.  \"Hello again.  Can I help you find something?\""
msgstr ""
"*chuchote. \"Re-bonjour. Est-ce que je peut vous aider à trouver quelque "
"chose ?\""

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "*whispering.  \"Hello.\""
msgstr "*murmure*? \"Bonjour.\""

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "*waves and smiles.  \"Welcome fellow reader.\""
msgstr "*fait un signe de la main et sourit. « Bienvenue, ami lecteur »."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "Hello, who are you?  This is a library, is it?"
msgstr "Bonjour, qui êtes vous? Ceci est une bibliothéque non?"

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "Oh sorry, I'm not interested right now."
msgstr "Oh désolé·e, je ne suis pas intéressé·e pour le moment."

#: data/json/npcs/campus/great_library_librarian_talk.json
#: data/json/npcs/godco/members/cook.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk.json
#: data/json/npcs/robofac/NPC_Cranberry_Foster.json
#. ~ Response to NPC dialogue
msgid "I wanted to talk."
msgstr "Je voulais juste discuter."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "Let me see what you have."
msgstr "Voyons ce que vous avez."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "Just saying hello."
msgstr "Je ne fait que dire bonjour."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "Always glad to help another reader."
msgstr "Toujours contente d'aider un(e) autre enthousiaste de livres."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "Never stop learning."
msgstr "N'arrêtez jamais d'apprendre."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "I just love books."
msgstr "J'adore juste les livres."

#: data/json/npcs/campus/great_library_librarian_talk.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk.json
#. ~ Response to NPC dialogue
msgid "About other things…"
msgstr "À propos d'autres sujets…"

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "When will you have new material?"
msgstr "Quand aurez-vous plus d'arrivages?"

#: data/json/npcs/campus/great_library_librarian_talk.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk.json
#. ~ Response to NPC dialogue
msgid "That's all for now.  <end_talking_bye>"
msgstr "C'est tout pour le moment. <end_talking_bye>"

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid ""
"It can be hard to predict the way things are now, but I am expecting new "
"materials around <interval>."
msgstr ""
"C'est difficile à prédire avec comment les choses sont à l'extérieur, mais "
"j'attends un nouvel arrivage dans plus ou moins <interval>."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "I am expecting some new materials <interval>, hopefully some good escapism."
msgstr ""
"Je suis en attente de nouveaux matériaux <interval>, j'espère un bon moyen de "
"s'évader."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "Thanks, I will make sure to check back."
msgstr "Merci, je ne manquerai pas de revenir."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid ""
"Before you ask, we can't lend out books anymore.  We've had too many stolen "
"and destroyed.  If you want to read something, either do it here or I will "
"need to sell it to you for something useful, like a book.  Oh, my name is "
"Elvira Fish, I run Circulations here.  I hope you learn something."
msgstr ""
"Avant que vous ne posiez la question, nous ne pouvons plus prêter de livres. "
"Il y en a eu trop de volés et de détruits. Si vous voulez lire quelque chose, "
"faites-le ici ou je devrai vous le vendre pour quelque chose d'utile, comme "
"un livre. Je m'appelle Elvira Fish et je m'occupe de la circulation des "
"livres. J'espère que vous apprendrez quelque chose."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "Can you answer some questions for me?"
msgstr "Puis-je vous poser quelques questions?"

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "Let me look at what you have."
msgstr "Regardons ce que vous avez."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "I just want to browse.  <end_talking_bye>"
msgstr "Je veux juste jeter un coup d'œil.  <end_talking_bye>"

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "Of course, how can I help?"
msgstr "Bien sûr, comment puis-je vous aider?"

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "I would be happy to assist."
msgstr "Je serait heureux·se de pouvoir aider."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "Of course, please ask."
msgstr "Bien sûre, demandez juste."

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ NPC dialogue line
msgid "What questions do you have?"
msgstr "Avez-vous des questions?"

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "You can't lend out books?  What kind of library is that?"
msgstr ""
"Vous ne pouvez pas prêter des livres?  Quelle genre de bibliothèque ne prête "
"pas de livres?"

#: data/json/npcs/campus/great_library_librarian_talk.json
#. ~ Response to NPC dialogue
msgid "You want even more books?"
msgstr "Vous voulez encore plus de livres?"

#: data/json/npcs/campus/great_library_librarian_talk.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk.json
#. ~ Response to NPC dialogue
msgid "Who's in charge here?"
msgstr "Qui commande ici?"

#: data/json/npcs/campus/great_library_librarian_talk.json
#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_arsonist.json
#. ~ Response to NPC dialogue
msgid "Is there any way I can join your group?"
msgstr "Comment je peux rejoindre votre groupe?"

