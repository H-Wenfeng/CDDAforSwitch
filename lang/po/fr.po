msgid_plural "Kel-Tec RFB rifles"
msgstr[0] "fusil Kel-Tec RFB"
msgstr[1] "fusils Kel-Tec RFB"
msgstr[2] "fusils Kel-Tec RFB"

#: data/json/items/gun/308.json
