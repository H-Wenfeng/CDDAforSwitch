#. ~ NPC dialogue line
msgid ""
"We have a grand variety of preselected game modes for you to choose from!  "
"Pick one and play now!"
msgstr ""

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Shaun of The Dead</color>: (Defend a bar against classic "
"zombies with your five friends.  Easy and fun.)"
msgstr ""
"<color_yellow>Shaun of The Dead</color>: (Défendez un bar contre des zombies "
"ordinaires avec vos cinq amis. Facile et amusant.)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Dawn of The Dead</color>: (Classic zombies only, slower and "
"more realistic.)"
msgstr ""
"<color_yellow>Dawn of The Dead</color>: (Juste des zombies ordinaires, plus "
"lents et vraisemblables.)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Eight-Legged Freaks</color>: (Hordes of spiders!  Not "
"arachnophobia friendly!)"
msgstr ""
"<color_yellow>Terreur sur huit pattes</color>: (Hordes d'araignées!  Pas "
"conseillé pour les arachnophobes!)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Day of The Triffids</color>: (Protect your mansion against the "
"triffids.)"
msgstr ""
"<color_yellow>Le Jour Des Triffides</color>: (Protégez votre manoir contre "
"les triffides.)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid "<color_yellow>Skynet</color>: (Robots have decided that humans are the enemy!)"
msgstr ""
"<color_yellow>Skynet</color>: (Les robots ont décidé que les humains doivent "
"être élimininés!)"

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>The Call of Cthulhu</color>: (Fend off hordes of eldritch "
"horrors.)"
msgstr ""
"<color_yellow>L'Appel de Cthulhu</color>: (Combattez des hordes d'horreurs "
"incompréhensibles.)"

