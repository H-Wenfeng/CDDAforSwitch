msgid_plural "Remington 1100 competition shotguns"
msgstr[0] "fusil à pompe Remington 1100 competition"
msgstr[1] "fusils à pompe Remington 1100 competition"
msgstr[2] "fusils à pompe Remington 1100 competition"

#: data/json/items/gun/shot.json
