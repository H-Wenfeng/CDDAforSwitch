msgstr "Tactiques Prescientes"

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Description of effect type "Prescient Tactics"
msgid "You're being informed of the best way to fight."
msgstr ""

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Description of effect type "Prescient Tactics"
msgid ""
"You're calling out tactics to your followers.  It's much harder to "
"concentrate on your own defense."
msgstr ""

#: data/mods/MindOverMatter/effects/effects_psionic.json
#. ~ Remove message of effect type "Prescient Tactics"
msgid "As the visions fade, you stop calling out orders."
msgstr ""

#: data/mods/MindOverMatter/effects/effects_psionic.json
#: data/mods/Xedra_Evolved/effects/goblin_fruit_effects.json
#. ~ Name of effect type id "effect_clair_omniscence"
#. ~ Name of effect type id "effect_goblin_fruit_super_clairvoyance"
