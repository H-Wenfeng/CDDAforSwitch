#: src/vehicle_use.cpp:1550
#, c-format
msgid "You need 24 charges of water in the tanks of the %s to fill the dishwasher."
msgstr ""
"Vous avez besoin de 24 doses d'eau dans les réservoirs de %s pour remplir le "
