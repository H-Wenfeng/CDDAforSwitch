msgstr "%1s pourrait aider %2s à achever un lot plus vite…"

#: src/crafting.cpp:1021
#, c-format
msgid "%s watches you craft…"
msgstr "%s vous regarde fabriquer ceci…"

#: src/crafting.cpp:1023
#, c-format
msgid "%1s watches %2s crafts…"
