msgstr "\"JE T'AI DIT DE SORTIR D'ICI!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"WHAT THE FUCK DO YOU WANT FROM ME?!\""
msgstr "\"PUTAIN, QU'EST-CE QUE VOUS VOULEZ DE MOI?!\""

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
