msgstr[1] "brosses à récurer"
msgstr[2] "brosses à récurer"

#: data/json/items/tool/toiletries.json
#. ~ Description of "scrub brush"
msgid "A simple scrub brush for cleaning hard objects."
msgstr "Une simple brosse conçue pour nettoyer des objets durs."

#: data/json/items/tool/toiletries.json
#. ~ Item name
