msgstr ""
"Je cherche du mutagène lagomorphe… Ce monde n'est plus un endroit pour les "
"humains, et je ne compte pas rester l'un d'entre eux."

#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
#: data/mods/aftershock_exoplanet/npcs/Backgrounds/npc_classes_mutant.json
#. ~ Name of an NPC class
msgid "Shell Cultist"
msgstr "Cultiste de la Coquille"

#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
#: data/mods/aftershock_exoplanet/npcs/Backgrounds/npc_classes_mutant.json
#. ~ Job description of "Shell Cultist" NPC class
msgid ""
"A religious cult of post human snail people that live in a volcanic cave "
"under the ice."
msgstr ""
"Un culte religieux d'escargots post-humains qui vivent dans une grotte "
"volcanique sous la glace."

#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
#: data/mods/aftershock_exoplanet/npcs/Backgrounds/npc_classes_mutant.json
#. ~ Name of an NPC class
msgid "Frog Mutant"
msgstr "Mutant Batracien"

#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
#: data/mods/aftershock_exoplanet/npcs/Backgrounds/npc_classes_mutant.json
#. ~ Job description of "Frog Mutant" NPC class
msgid ""
"I'm looking for frog mutagen… this world is no place for humans anymore, and "
