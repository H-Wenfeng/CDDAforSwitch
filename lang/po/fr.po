msgstr[1] "lingots d'étain énormes"
msgstr[2] "lingots d'étain énormes"

#: data/json/items/resources/alien.json
#. ~ Description of "enormous tin ingot"
msgid "An enormous ingot of pure tin."
msgstr "Un lingot énorme d'étain pur."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "enormous copper ingot"
msgid_plural "enormous copper ingots"
msgstr[0] "lingot de cuivre énorme"
msgstr[1] "lingots de cuivre énormes"
msgstr[2] "lingots de cuivre énormes"

#: data/json/items/resources/alien.json
#. ~ Description of "enormous copper ingot"
msgid "A massive solid piece of copper, covered by a blue-green patina."
msgstr "Un lingot énorme de cuivre couvert d'une fine couche de vert-de-gris."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "enormous zinc ingot"
msgid_plural "enormous zinc ingots"
msgstr[0] "lingot de zinc énorme"
msgstr[1] "lingots de zinc énormes"
msgstr[2] "lingots de zinc énormes"

#: data/json/items/resources/alien.json
#. ~ Description of "enormous zinc ingot"
msgid ""
"An absolutely massive block of pure zinc.  Bet you didn't expect that - "
"nobody expects zinc."
msgstr "Un bloc rectangulaire de zinc pur."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "enormous lead ingot"
msgid_plural "enormous lead ingots"
msgstr[0] "lingot de plomb énorme"
msgstr[1] "lingots de plomb énormes"
msgstr[2] "lingots de plomb énormes"

#: data/json/items/resources/alien.json
#. ~ Description of "enormous lead ingot"
msgid "A block of lead so huge you don't even want to think about how heavy it is."
msgstr ""
"Un lingot de plomb tellement gigantesque que vous peinez à imaginer sa masse "
"énorme."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "CBM interface wire kit"
msgid_plural "CBM interface wire kits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "CBM interface wire kit"
msgid ""
"A collection of hand-soldered wires leading to plugs and what looks like an "
"exotic micro controller.  The plugs look like they could be attached to you, "
"assuming you have an SNI (Standard Neurobionic Interface)."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "external climate control kit"
msgid_plural "external climate control kits"
msgstr[0] "kit de climatisation externe"
msgstr[1] "kits de climatisation externe"
msgstr[2] "kits de climatisation externe"

#: data/json/items/resources/alien.json
#. ~ Description of "external climate control kit"
msgid ""
"A collection of mismatched pipes, wires, and a central device that looks like "
"an exotic micro controller.  Almost looks like it could be used for some form "
"of central cooling."
msgstr ""
"Une collection de tuyaux et câbles disparates autour d'un appareil central "
"ayant l'air d'être une sorte de micro-unité de contrôle exotique qui pourrait "
"être un type de système de refroidissement centralisé."

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "woven metallics"
msgid_plural "woven metallics"
msgstr[0] "métal tissé"
msgstr[1] "métal tissé"
msgstr[2] "métal tissé"

#: data/json/items/resources/alien.json
#. ~ Description of "woven metallics"
msgid ""
"Thin metallic strips with an ochre sheen, interlaid together into a flexible "
"mesh.  You can't tell whether it's a circuit, a heat dissipation component, "
"or a mechanical actuator."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "alien metal plating"
msgid_plural "alien metal plating"
msgstr[0] "blindage métallique extraterrestre"
msgstr[1] "blindage métallique extraterrestre"
msgstr[2] "blindage métallique extraterrestre"

#: data/json/items/resources/alien.json
#. ~ Description of "alien metal plating"
msgid ""
"A slightly curved plate of white metal.  It readily collects low amounts of "
"static charge."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "alien metal scrap"
msgid_plural "alien metal scrap"
msgstr[0] "morceau de ferraille extraterrestre"
msgstr[1] "morceaux de ferraille extraterrestre"
msgstr[2] "morceaux de ferraille extraterrestre"

#: data/json/items/resources/alien.json
#. ~ Description of "alien metal scrap"
msgid ""
"A collection of tiny metal strips, spheres, and other geometric primitives "
"taken from a disassembled alien machine."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "monolithic machine"
msgid_plural "monolithic machine"
msgstr[0] "machine monolithique"
msgstr[1] "machine monolithique"
msgstr[2] "machine monolithique"

#: data/json/items/resources/alien.json
#. ~ Description of "monolithic machine"
msgid ""
"A very heavy sphere, presumably made almost entirely of gold.  The complex "
"pattern etched across its surface implies that it might serve some exotic "
"function."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "robotic innards"
msgid_plural "robotic innards"
msgstr[0] "entrailles robotiques"
msgstr[1] "entrailles robotiques"
msgstr[2] "entrailles robotiques"

#: data/json/items/resources/alien.json
#. ~ Description of "robotic innards"
msgid ""
"A robotic assembly of unknown function.  Entirely made from tight-fitting "
"metal plates, it somewhat resembles the interior of a mechanical clock."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "sensor assembly"
msgid_plural "sensor assembly"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "sensor assembly"
msgid ""
"A carved sphere embedded with small black glass screens.  It's probably a "
"sensor of some kind."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "undergrown alien spike"
msgid_plural "undergrown alien spikes"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: data/json/items/resources/alien.json
#. ~ Description of "undergrown alien spike"
msgid ""
"A flexible and sharp elongated rod that gets thinner on one end, weak and "
"clearly underdeveloped.  It has been harvested from a dead alien creature."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "alien armor fragment"
msgid_plural "alien armor fragments"
msgstr[0] "fragment d'armure extraterrestre"
msgstr[1] "fragments d'armure extraterrestre"
msgstr[2] "fragments d'armure extraterrestre"

#: data/json/items/resources/alien.json
#. ~ Description of "alien armor fragment"
msgid ""
"A small chunk of alien armor, made of material that resembles bone.  Once "
"being a part of a bigger structure, now crumbling in your hands."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "alien armor plate"
msgid_plural "alien armor plates"
msgstr[0] "plaque d'armure extraterrestre"
msgstr[1] "plaques d'armure extraterrestres"
msgstr[2] "plaques d'armure extraterrestres"

#: data/json/items/resources/alien.json
#. ~ Description of "alien armor plate"
msgid ""
"A big piece of alien armor plating, made of bone-like material.  The outer "
"part is perforated with countless holes, reminiscent of some sort of twisted "
"coral.  It has barbed hooks growing on the inner side."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "strange statuette"
msgid_plural "strange statuettes"
msgstr[0] "statuette étrange"
msgstr[1] "statuettes étranges"
msgstr[2] "statuettes étranges"

#: data/json/items/resources/alien.json
#. ~ Description of "strange statuette"
msgid ""
"A small statuette of some kind of fantastical creature is carved out of a "
"rough, unnatural material.  It seems remarkably well made."
msgstr ""

#: data/json/items/resources/alien.json
#. ~ Item name
msgid "ephemeral gemstone"
msgid_plural "ephemeral gemstones"
msgstr[0] "joyau éphémère"
