#: data/mods/Magiclysm/Spells/black_dragon.json
#. ~ Description of spell "dragon_shell_black ( Black Dragon Shell )"
msgid ""
"You channel your inner draconic magic to protect yourself from damage and "
"reflect some back as acid damage."
msgstr ""

#: data/mods/Magiclysm/Spells/black_dragon.json
#: data/mods/Magiclysm/effects/mutation_effects.json
#. ~ Name of spell "dragon_terror"
#. ~ Name of effect type id "dragon_terror_debuff"
msgid "Dragon Terror"
msgstr "Rugissement Draconique"

#: data/mods/Magiclysm/Spells/black_dragon.json
#. ~ Description of spell "dragon_terror ( Dragon Terror )"
msgid ""
"With an ear piercing roar, you channel the inner power of dragons and strike "
"fear into those who stand before you, slowing their escape from your terror."
msgstr ""

#: data/mods/Magiclysm/Spells/black_dragon.json
#: data/mods/Magiclysm/effects/mutation_effects.json
#. ~ Name of spell "dragon_boost"
#. ~ Name of effect type id "dragon_boost"
msgid "Dragon Boost"
msgstr "Dragon Boost"

#: data/mods/Magiclysm/Spells/black_dragon.json
#. ~ Description of spell "dragon_boost ( Dragon Boost )"
msgid "You let out a mighty roar as you infuse yourself with the power of Dragons."
msgstr ""

#: data/mods/Magiclysm/Spells/black_dragon.json
#. ~ Name of spell "dragon_spit_acid"
msgid "Dragon Acid Spit"
msgstr "Crachat d'Acide Draconique"

#: data/mods/Magiclysm/Spells/black_dragon.json
#. ~ Description of spell "dragon_spit_acid ( Dragon Acid Spit )"
msgid ""
"You conjure up acidic spittle that you can shoot long distances as you close "
"in on your terrified prey."
msgstr ""
"Vous emmagasinez dans votre gorge un crachat acide que vous pouvez tirer à "
"longue distance lorsque vous rattrapez vos proies terrifiées."

#: data/mods/Magiclysm/Spells/black_dragon.json
#: data/mods/Magiclysm/mutations/mutation_paths/black_dragon.json
#. ~ Name of spell "dragon_breath_acid"
#. ~ Mutation name
msgid "Black Dragon Breath"
msgstr "Souffle de Dragon Noir"

#: data/mods/Magiclysm/Spells/black_dragon.json
#. ~ Description of spell "dragon_breath_acid ( Black Dragon Breath )"
msgid "Spews a line of acid from your mouth."
msgstr "Crache une ligne d'acide de votre position."

#: data/mods/Magiclysm/Spells/classless.json
