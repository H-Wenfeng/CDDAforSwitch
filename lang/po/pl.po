#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "A digital clock.  It's stuck at 2:17 PM."
msgstr "To zegar cyfrowy. Zaciął się na godzinie 14:17."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "That's just a charred human corpse."
msgstr "To tylko zwęglone ludzkie ciało."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "I don't know what that is, but it's not kitten."
msgstr "Nie wiem co to jest ale to nie koteczek."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "An empty shopping bag.  Paper or plastic?"
msgstr "Pusta torba na zakupy. Papier lub plastik?"

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "Could it be… a big ugly bowling trophy?"
msgstr "Czyżby to był… wielki brzydki puchar z zawodów kręglarskich?"

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "A coat hanger hovers in thin air.  Odd."
msgstr "Wieszak na ubrania wisi w powietrzu. Dziwne."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "Not kitten, just a packet of Kool-Aid™."
msgstr "Nie kociak, tylko paczka Kool-Aid™."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "A freshly-baked pumpkin pie."
msgstr "Świeżo upieczony placek dyniowy."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "A lone, forgotten comma, sits here, sobbing."
msgstr "Samotny zapomniany przecinek, siedzi sobie, popłakując."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "ONE HUNDRED THOUSAND CARPET FIBERS!"
msgstr "STO TYSIĘCY WŁÓKIEN DYWANOWYCH!"

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "It's Richard Nixon's nose!"
msgstr "To nos Richarda Nixona."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "It's Lucy Ricardo.  \"Aaaah, Ricky!\", she says."
msgstr "To Lucy Ricardo. „Aaaah, Ricky!”, mówi."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "You stumble upon Bill Gates' stand-up act."
msgstr "Wpadasz na występ stand-up Billa Gatesa."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "Just an autographed copy of the Kama Sutra."
msgstr "To tylko kopia Kama Sutry z autografem."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "It's the Will Rogers Highway.  Who was Will Rogers, anyway?"
msgstr "To autostrada im. Willa Rogersa. Kim w ogóle był Will Rogers?"

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "It's another robot, more advanced in design than you but strangely immobile."
msgstr "To kolejny robot, bardziej zaawansowany niż ty ale dziwnie nieruchomy."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "Leonard Richardson is here, asking people to lick him."
msgstr "Jest tu Leonard Richardson, proszący ludzi by go polizali."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "It's a stupid mask, fashioned after a beagle."
msgstr "To głupia maska na kształt beagle’a."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "Your State Farm Insurance™ representative!"
msgstr "Twój przedstawiciel Stanowych Ubezpieczeń Rolniczych™!"

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "It's the local draft board."
msgstr "To lokalna komisja poborowa."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "Seven 1/4\" screws and a piece of plastic."
msgstr "Siedem wkrętów 1/4 cala i kawałek platiku."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "An 80286 machine."
msgstr "Maszyna 80286."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "One of those stupid \"Homes of the Stars\" maps."
msgstr "Jedna z tych głupich map „Domy Gwiazd”."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "A signpost saying \"TO KITTEN\".  It points in no particular direction."
msgstr "Kierunkowskaz „Do Koteczka”. Nie wskazuje w żadną konkretną stronę."

#: data/json/snippets/robot_finds_kitten.json
#. ~ Snippet in category "non_kitten_items"
#. ~ Original items from 1997 DOS version of robotfindskitten
msgid "A hammock stretched between a tree and a volleyball pole."
