msgstr[2] "małych śluzów"
msgstr[3] "małego śluzu"

#: data/json/monsters/slimes.json
#. ~ Description of monster "small slime"
msgid ""
"A small black blob of viscous goo, oozing across the ground like a glob of "
"living oil."
msgstr ""
"Mały czarny glut z lepiej mazi, sączący się po ziemi jak mięsista kałuża "
"żywego oleju."

