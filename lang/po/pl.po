#: data/mods/aftershock_exoplanet/npcs/threshold_recruit_dialogue.json
#. ~ Response to NPC dialogue
#, no-c-format
msgid "[MASTODON 75%] Come, join the herd before you're left behind."
msgstr "[MASTODONT 75%] Chodź, dołącz do stada, zanim zostaniesz w tyle."

#: data/mods/Aftershock/npcs/threshold_recruit_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/threshold_recruit_dialogue.json
#. ~ Response to NPC dialogue
#, no-c-format
msgid "[MI-GO 50%] Let's see just how much we can improve ourselves."
msgstr "[MI-GO 50%] Zobaczmy, jak bardzo możemy poprawić nas samych."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "Outsider."
msgstr "Przybyszu."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "Hospitality rites are civilization."
msgstr "Obrzędy gościnności to cywilizacja."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "Guest."
msgstr "Gościu."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "How's the madness outside?"
msgstr "Jak wygląda szaleństwo na zewnątrz?"

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "We don't get outsiders around here all that much."
msgstr "Nie dociera tu zbyt wielu przybyszów z zewnątrz."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "How do I join the family?"
msgstr "Jak mogę dołączyć do rodziny?"

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "I'm a member of the Whately Family.  Who are you?"
msgstr "Jestem członkiem rodziny Whately. Kim ty jesteś?"

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "I am lost and really need something to eat."
msgstr "Zgubiłem się i naprawdę potrzebuję czegoś do jedzenia."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "I've done some tasks for your relatives."
msgstr "Wykonałem kilka zadań dla twoich krewnych."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "Welcome to Whately lands.  Behave yourself or we'll harvest you for parts."
msgstr "Witamy na ziemiach Whately. Zachowuj się, albo rozbierzemy cię na części."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "Family bonds above all, huh?"
msgstr "Więzi rodzinne ponad wszystko, co?"

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "We aren't in the habit of breaking bread with outsiders."
msgstr "Nie mamy w zwyczaju łamać się chlebem z przybyszami z zewnątrz."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "How do I join your family?"
msgstr "Jak mogę dołączyć do twojej rodziny?"

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "Then let's see what you've got to trade."
msgstr "Zatem zobaczmy co masz na handel."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid "Only blood allowed, and the family Elders can make you of the blood."
msgstr "Tylko po krwi, a starszyzna rodu może cię w tę krew wcielić."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ Response to NPC dialogue
msgid "Well that sounds creepy."
msgstr "Cóż, to zabrzmiało upiornie."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid ""
"I was born part of the family.  We've never been accepted here but our wealth "
"and talents have kept us alive through the centuries."
msgstr ""
"Urodziłem się jako część rodziny. Nigdy nie byliśmy tu akceptowani, ale nasze "
"bogactwo i talenty utrzymywały nas przy życiu przez wieki."

#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/aftershock_exoplanet/npcs/whately_generic_dialogue.json
#. ~ NPC dialogue line
msgid ""
"Family keeps me busy and our experiments and projects take up the rest of my "
"time."
msgstr ""
"Rodzina trzyma mnie zajętą, a nasze eksperymenty i projekty pochłaniają "
"resztę mojego czasu."

#: data/mods/Aftershock/npcs/Augustmoon_Salvors/augustmoon_doctor.json
#: data/mods/aftershock_exoplanet/npcs/Augustmoon_Salvors/augustmoon_doctor.json
