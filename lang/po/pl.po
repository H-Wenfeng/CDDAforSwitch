msgid "9x21mm Gyurza SP-10 (7N29)"
msgid_plural "9x21mm Gyurza SP-10 (7N29)"
msgstr[0] "9 x 21 mm Giurza SP-10 (7N29)"
msgstr[1] "9 x 21 mm Giurza SP-10 (7N29)"
