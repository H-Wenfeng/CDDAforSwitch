#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
#. ~ EOC selection title in effect in EoC "EOC_CHECK_ATTUNEMENTS"
msgid "You reach out to touch the attunement altar."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
#. ~ Player message in effect in EoC "EOC_CANT_GIVE_ATTUNEMENT_NOT_A_MAGE"
msgid "The altar does not respond to your touch.  Only a mage can unlock its secrets."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
#. ~ Player message in effect in EoC
#. "EOC_CANT_GIVE_ATTUNEMENT_NOT_ENOUGH_SPELLS"
msgid ""
"The altar does not respond to your touch.  You need more breadth in your "
"spell selection before you can attempt attunement."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
#. ~ Player message in effect in EoC
#. "EOC_CANT_GIVE_ATTUNEMENT_NOT_ENOUGH_SPELL_LEVELS"
msgid ""
"The altar does not respond to your touch.  While you know many spells, your "
"knowledge of them is still too shallow."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
#. ~ Player message in effect in EoC
#. "EOC_CANT_GIVE_ATTUNEMENT_NOT_ENOUGH_PROFICIENCIES"
msgid ""
"The altar does not respond to your touch.  While your knowledge of spells is "
"considerable, your understanding of the fundamentals of spellcasting needs "
"work."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
#. ~ Player message in effect in EoC "EOC_ATTUNEMENT_SUCCESS_MESSAGE"
msgid ""
"As you touch the altar, you feel your ley lines twitch before they "
"reconfigure themselves into new patterns.  Power flows through your body in a "
"torrent along the new channels.  You have attained attunement, the rarest of "
"all magical accomplishments."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/attunements.json
#. ~ Player message in effect in EoC "EOC_DUST_REBORN_INITIAL"
msgid "Part of your body and soul were divorced."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/attunements.json
#. ~ Player message in effect in EoC "EOC_DUST_REBORN"
msgid ""
"You feel an insane pain, as your soul is pulled off, out of your body.  "
"Second later, your mind were pulled somewhere else, in the place you visit "
"before."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/forge_of_wonders.json
#. ~ Player message in false effect in EoC "EOC_VALIDATE_FORGE"
msgid "MANUALLY FINDING THE FORGE AS A FALLBACK (PRESS SPACE)."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/forge_of_wonders.json
#. ~ Player message in effect in EoC "EOC_FORGE_TELEPORT"
msgid ""
"As you recite the incantation the runes on the scroll begin to shift.  And in "
"the blink of an eye you are suddenly somewhere else."
msgstr ""

#: data/mods/Magiclysm/effect_on_conditions/forge_of_wonders.json
#. ~ Player message in false effect in EoC "EOC_FORGE_TELEPORT"
#. ~ Player message in false effect in EoC "EOC_FORGE_RETURN_TELEPORT"
