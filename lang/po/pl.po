msgstr[1] "uszkodzone zestawy schronienia"
msgstr[2] "uszkodzonych zestawów schronienia"
msgstr[3] "uszkodzonego zestawu schronienia"

#: data/json/items/tool/shelters.json
#. ~ Description of "damaged shelter kit"
