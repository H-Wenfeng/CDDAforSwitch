msgstr[2] "gier Statki"
msgstr[3] "gry Statki"

#: data/json/items/fluff.json
#. ~ Description of "Warships"
msgid ""
"A game where players try to guess where the opponent placed their ships on "
"the board."
msgstr ""
"Gra, w której gracze próbują odgadnąć, gdzie przeciwnik umieścił swoje statki "
"na planszy."

#: data/json/items/fluff.json
