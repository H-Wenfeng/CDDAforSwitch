#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"No… stop the burning!\""
msgstr "„Nie… powstrzymaj to pieczenie!”."

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"Hrgm… blood… hungry…\""
