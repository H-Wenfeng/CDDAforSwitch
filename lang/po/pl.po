msgstr[0] "nimfa gigantycznego rybika"
msgstr[1] "nimfy gigantycznego rybika"
msgstr[2] "nimf gigantycznego rybika"
msgstr[3] "nimfy gigantycznego rybika"

#: data/json/monsters/insect_spider.json
#. ~ Description of monster "giant silverfish nymph"
msgid "A baby mutant silverfish about the size of a rat."
msgstr "Małe zmutowanego rybika mniej-więcej wielkości szczura."

#: data/json/monsters/insect_spider.json
