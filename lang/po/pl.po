#. ~ Name of spell "borealmage_auroral_guard"
msgid "Auroral Guard"
msgstr "Strażnik zorzy"

#: data/mods/Magiclysm/Spells/attunements/Boreal_Mage.json
#. ~ Description of spell "borealmage_auroral_guard ( Auroral Guard )"
msgid "Create a sturdy shell that wraps around your body, bestowing a sturdy defense."
msgstr ""

#: data/mods/Magiclysm/Spells/attunements/Cleansing_Flame.json
