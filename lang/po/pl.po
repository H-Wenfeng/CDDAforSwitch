msgstr[3] "przerośniętej muchy"

#: data/json/monsters/insect_spider.json
#. ~ Description of monster "oversized fly"
msgid ""
"A mutant housefly the size of a small dog.  Its buzzing is high-pitched and "
"somehow sad."
msgstr "Zmutowana mucha wielkości psa. Wysoki dźwięk jej bzyczenia brzmi jakoś smutno."

#: data/json/monsters/insect_spider.json
#. ~ Monster name
msgid "giant fly"
msgid_plural "giant flies"
msgstr[0] "gigantyczna mucha"
msgstr[1] "gigantyczne muchy"
msgstr[2] "gigantycznych much"
msgstr[3] "gigantycznej muchy"

#: data/json/monsters/insect_spider.json
#. ~ Description of monster "giant fly"
msgid ""
"A tremendous housefly the size of a dog, predictably accompanied by a loud, "
"incessant buzzing sound."
msgstr ""
"Olbrzymia mucha domowa wielkości psa, oczywiście z nieodłącznie towarzyszącym "
"bezustannym głośnym bzyczeniem."

#: data/json/monsters/insect_spider.json
#. ~ Monster name
msgid "giant grub"
msgid_plural "giant grubs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/monsters/insect_spider.json
#. ~ Description of monster "giant grub"
msgid "A grub the size of a small dog."
msgstr ""

#: data/json/monsters/insect_spider.json
