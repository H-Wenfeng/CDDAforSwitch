msgstr "Bardzo wytrzymałe, opancerzone metalowe koło."

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "wheelbarrow wheel"
#. ~ Description of vehicle part "small wheel"
#. ~ Description of vehicle part "unicycle wheel"
#. ~ Description of vehicle part "concrete mixer wheels"
msgid "A small wheel."
msgstr "Małe koło."

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "bicycle wheel"
msgid "A thin bicycle wheel."
msgstr "Wąskie koło od roweru."

#: data/json/vehicleparts/wheel.json
#. ~ Vehicle part name
