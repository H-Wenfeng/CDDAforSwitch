msgstr[2] "powieści pulp"
msgstr[3] "powieści pulp"

#: data/json/items/book/misc_pulp.json
#. ~ Description of "pulp novel"
msgid "A hardboiled detective tale filled with hard hitting action and intrigue."
msgstr ""
"Historia w gorącej wodzie kąpanego detektywa, który intrygę rozbija celnym "
"ciosem swojej pięści. Masa akcji."

#: data/json/items/book/misc_pulp.json
#. ~ ISBN 9781949313062
#. ~ Item name
