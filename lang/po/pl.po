#: data/json/monsters/nether.json
#. ~ Monster name
msgid "wraith"
msgid_plural "wraiths"
msgstr[0] "upiór"
msgstr[1] "upiory"
msgstr[2] "upiorów"
msgstr[3] "upiora"

#: data/json/monsters/nether.json
#. ~ Description of monster "wraith"
msgid ""
"A gigantic shadow, chaotically changing in shape and volume.  Two piercing "
"orbs of light dominate what can only be described as its head."
msgstr ""
"Gigantyczny cień, którego kształt i objętość zmieniają się chaotycznie, z "
"dwoma przeszywającymi kulami światła wieńczącymi coś co może być opisane "
"tylko jako jego głowa."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "dementia"
msgid_plural "dementias"
msgstr[0] "demencja"
msgstr[1] "demencje"
msgstr[2] "demencji"
msgstr[3] "demencji"

#: data/json/monsters/nether.json
#. ~ Description of monster "dementia"
msgid ""
"A crazed individual, the bloody scars on the side of its shaved head suggest "
"some sort of partial lobotomy."
msgstr ""
"Oszalałe indywiduum, którego krwawe pręgi na ogolonej głowie sugerują jakiś "
"rodzaj częściowej lobotomii."

#: data/json/monsters/nether.json
#. ~ Monster name
msgid "dog"
msgid_plural "dogs"
msgstr[0] "pies"
msgstr[1] "psy"
msgstr[2] "psów"
msgstr[3] "psa"

#: data/json/monsters/nether.json
#. ~ Description of monster "dog"
msgid ""
"A domesticated mongrel of the canine persuasion.  In the absence of human "
"society, it has turned feral."
msgstr ""
"Udomowiony kundel z psiego boomu. W nieobecności człowieczego społeczeństwa "
"zdziczał."

#: data/json/monsters/nether.json
#. ~ Death message of monster "dog"
#. ~ Death message of monster "tentacle dog"
#, c-format
msgid "The %s emerges!"
msgstr "%s powstaje!"

#: data/json/monsters/nether.json data/mods/Magiclysm/monsters/nether.json
