#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Easy</color>: No additional enemies spawn per wave, and you get "
"a second chance when you die the first time.  Good for newcomers or those not "
"familiar with isometric horde fighters."
msgstr ""

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Normal</color>: The basic way to play, no additional enemies, "
"with no safety nets.  This is considered the default."
msgstr ""

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Difficult</color>: More enemies spawn per wave, but nothing too "
"extreme.  You'll have to fight harder to live, but more loot comes with it "
"too."
msgstr ""

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Hard</color>: Twice the number of enemies will spawn per wave.  "
"A true challenge to test your metal."
msgstr ""

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>Nightmare</color>: Three times the number of enemies will "
"attack you, making things a long and brutal slog though guts and blood.  Come "
"prepared to possibly fail a few times."
msgstr ""

#: data/mods/Defense_Mode/dialogue/menu_screen.json
#. ~ Response to NPC dialogue
msgid ""
"<color_yellow>DOOM</color>: Fives times the number of enemies will attack "
"you.  Armies will come to your door, and what they will be met with is up to "
"you to decide.  Incredibly difficult."
msgstr ""

