#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"Hunger… must eat…\""
msgstr "„Głód… jeść…”."

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "\"Run… chase… eat…\""
msgstr "„Biec… gonić… jeść…”."

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
msgid "hysterical laughing."
msgstr "histeryczny śmiech."

#: data/json/speech.json
#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_slaver
