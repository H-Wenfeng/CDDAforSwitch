msgstr ""

#: data/json/vehicleparts/wheel.json
#. ~ Vehicle part name
msgid "skateboard trucks"
msgstr ""

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "skateboard trucks"
msgid "A pair of skateboard trucks, for attaching wheels to."
msgstr ""

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "motorbike wheel"
msgid "A small wheel from a motorcycle."
msgstr "Małe koło od motocykla."

#: data/json/vehicleparts/wheel.json
#. ~ Vehicle part name
msgid "tricycle wheels"
msgstr "koła trójkołowca"

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "tricycle wheels"
msgid ""
"A set of three plastic wheels, with a larger one in the front, mounted with "
"bolts."
msgstr ""
"Zestaw trzech plastikowych kółek, z jednym większym z przodu, mocowanych za "
"pomocą śrub."

#: data/json/vehicleparts/wheel.json
#. ~ Vehicle part name
msgid "unicycle wheel"
msgstr "koło unicykla (sterowalne)"

#: data/json/vehicleparts/wheel.json
#. ~ Vehicle part name
msgid "wheelchair wheel"
msgstr "koło wózka inwalidzkiego"

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "wheelchair wheel"
msgid "A pair of wheelchair wheels."
msgstr "Para kół z wózka inwalidzkiego."

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "wide wheel"
msgid "A wide wheel that provides more traction and better off-road performance."
msgstr "Szerokie koło zapewniające więcej przyczepności i lepszą wydajność poza drogą."

#: data/json/vehicleparts/wheel.json
#. ~ Description of vehicle part "wooden cart wheel"
msgid "A wooden wheel."
msgstr "Drewniane koło."

#: data/json/vehicleparts/windshields.json
#. ~ Vehicle part name
msgid "windshield"
msgstr "szyba"

#: data/json/vehicleparts/windshields.json
#. ~ Description of vehicle part "windshield"
msgid "A sheet of glass that lets you see outside the vehicle."
msgstr "Szyba, która pozwala ci widzieć otoczenie pojazdu."

#: data/json/vehicleparts/windshields.json
#. ~ Vehicle part name
msgid "reinforced windshield"
msgstr "wzmocniona szyba"

#: data/json/vehicleparts/windshields.json
#. ~ Description of vehicle part "reinforced windshield"
msgid ""
"A sheet of glass that lets you see outside the vehicle.  Reinforced with wire "
"to make it harder to break than normal glass."
msgstr ""
"Szyba, która pozwala ci widzieć otoczenie pojazdu. Wzmocniona drutem, aby "
"trudniej było ją stłuc niż zwykłe szkło."

