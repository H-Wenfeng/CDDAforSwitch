msgstr "Grafy i metryki"

#: data/json/ui/zenfs/sidebar-thick.json
#. ~ Description of UI widget "zenfs_complete_status_display"
msgid ""
"A large <color_yellow>status graph</color>, complete with "
"<color_yellow>health meters</color> for all major body parts, "
"<color_yellow>body graphs</color> for wetness, encumbrance & temperature, as "
"well as <color_yellow>diet</color>, <color_yellow>movement</color>, "
"<color_yellow>mental state</color> and <color_yellow>base stats</color>."
msgstr ""
"Duży <color_yellow>wykres stanu</color>, wraz z <color_yellow>miernikami "
"zdrowia</color> dla wszystkich głównych części ciała, <color_yellow>wykresami "
"ciała</color> dla mokrości, skrępowania i temperatury, a także "
"<color_yellow>diety</color>, <color_yellow>ruchu</color>, <color_yellow>stanu "
"psychicznego</color> i <color_yellow>podstawowych statystyk</color>."

#: data/json/ui/zenfs/sidebar-thick.json
#. ~ Label of UI widget "zenfs_complete_status_display_alt"
msgid "Meters; slim"
msgstr "Metryki; wąskie"

#: data/json/ui/zenfs/sidebar-thick.json
#. ~ Description of UI widget "zenfs_complete_status_display_alt"
msgid ""
"A slim <color_yellow>status display</color>, complete with "
"<color_yellow>health</color>, <color_yellow>wetness</color>, "
"<color_yellow>temperature</color> and <color_yellow>encumbrance "
"meters</color> for all major body parts, as well as "
"<color_yellow>diet</color>, <color_yellow>movement</color>, "
"<color_yellow>mental state</color> and <color_yellow>base stats</color>."
msgstr ""
"Wąski <color_yellow>wyświetlacz statusu</color>, wraz ze "
"<color_yellow>zdrowiem</color>, <color_yellow>wilgotnością</color>, "
"<color_yellow>temperaturą</color> i <color_yellow>miernikami "
"skrępowania</color> dla wszystkich głównych części ciała, a także "
"<color_yellow>diety</color>, <color_yellow>ruchu</color>, <color_yellow>stanu "
"psychicznego</color> i <color_yellow>podstawowych statystyk</color>."

#: data/json/ui/zenfs/sidebar-thick.json
