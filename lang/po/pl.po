#. ~ Vehicle part name
msgid "kitchen station"
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "workshop station"
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-appliances.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "oven"
msgstr "kuchenka"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "oven"
msgid ""
"A standard electric convection-based oven, commonly used for heating and "
"cooking food.  It's plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "stationary water purifier"
msgstr "stacjonarny oczyszczacz wody"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "stationary water purifier"
msgid ""
"This device effectively sterilizes water.  Activate it to clean all water in "
"a connected tank, at the cost of some electricity."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "arcade machine"
msgstr "automat do gier"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "arcade machine"
msgid ""
"A bulky upright arcade cabinet, brightly painted and slightly worn with age.  "
"Ready to be played."
msgstr ""
"Duży, stojący automat do gier zręcznościowych, pomalowany na jaskrawy kolor i "
"lekko podniszczony upływem czasu. Gotowy do grania."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "arc furnace"
msgid_plural "arc furnaces"
msgstr[0] "piec łukowy"
msgstr[1] "piece łukowe"
msgstr[2] "pieców łukowych"
msgstr[3] "pieca łukowego"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "arc furnace"
msgid ""
"An arc furnace designed to burn a powdery mix of coke and limestone to create "
"calcium carbide.  Plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/metalworking.json
#. ~ Vehicle part name
#. ~ Item name
msgid "electric forge"
msgid_plural "electric forges"
msgstr[0] "elektryczna kuźnia"
msgstr[1] "elektryczne kuźnie"
msgstr[2] "elektrycznych kuźni"
msgstr[3] "elektrycznej kuźni"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "electric forge"
msgid ""
"An electric forge, plugged in and ready to be used for metalworking.  If you "
"attempt to craft an item that needs a forge, you will be given the option of "
"selecting it as a tool."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "ap_kiln"
msgid ""
"An electric kiln for baking brick or clay.  When plugged in and powered you "
"could use this to harden bricks or clay.  If you attempt to craft an item "
"that needs a kiln, you will be given the option of selecting it as a tool."
msgstr ""
"Elektryczny piec do wypalania cegieł i ceramiki. Podłączony i zasilony może "
"być używany do utwardzania gliny lub cegieł. Jeśli zamierzasz wytworzyć "
"przedmiot wymagający pieca, będziesz mieć możliwość wybrania go jako "
"narzędzia."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "drill press"
msgid_plural "drill presses"
msgstr[0] "wiertarka pionowa"
msgstr[1] "wiertarki pionowe"
msgstr[2] "wiertarek pionowych"
msgstr[3] "wiertarki pionowej"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "drill press"
msgid ""
"A powerful drill mounted on a slide that lets it drop precisely down.  Useful "
"in all kinds of projects, from industrial fabrication to home woodworking.  "
"Plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "table saw"
msgid_plural "table saws"
msgstr[0] "piła stołowa"
msgstr[1] "piły stołowe"
msgstr[2] "pił stołowych"
msgstr[3] "piły stołowej"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "table saw"
msgid ""
"A rotating sawblade set into a large, flat table.  Used for making straight, "
"measured cuts, it's a key tool in any carpenter's arsenal.  Plugged in and "
"ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "mitre saw"
msgid_plural "mitre saws"
msgstr[0] "piła ukośna"
msgstr[1] "piły ukośne"
msgstr[2] "pił ukośnych"
msgstr[3] "piły ukośnej"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "mitre saw"
msgid ""
"A circular sawblade on an arm that can slide and rotate in several "
"directions, this is a staple tool for nearly any carpentry.  Plugged in and "
"ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "band saw"
msgid_plural "band saws"
msgstr[0] "piła taśmowa"
msgstr[1] "piły taśmowe"
msgstr[2] "pił taśmowych"
msgstr[3] "piły taśmowej"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "band saw"
msgid ""
"A ribbonlike sawblade runs in a single direction in this tool, allowing "
"precise cuts at almost any angle.  Plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#. ~ Vehicle part name
#. ~ Furniture name
msgid "router table"
msgstr "stół do frezarki górnowrzecionowej"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "router table"
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves.  Plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "planer"
msgid_plural "planers"
msgstr[0] "strugarka"
msgstr[1] "strugarki"
msgstr[2] "strugarek"
msgstr[3] "strugarki"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "planer"
msgid ""
"A hefty tool that will take in a board and cut it smooth and flat to a "
"specific width, particularly great if working with raw lumber stock, but also "
"good just for shaving wood down to size.  Plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "jointer"
msgid_plural "jointers"
msgstr[0] "strug"
msgstr[1] "strugi"
msgstr[2] "strugów"
msgstr[3] "struga"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "jointer"
msgid ""
"A table-shaped tool with a rotating blade that will cut down, smooth out, and "
"square off a board to make it nice and smooth.  Plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Item name
msgid "catalytic cracking reactor"
msgid_plural "catalytic cracking reactors"
msgstr[0] "reaktor do krakingu katalitycznego"
msgstr[1] "reaktory do krakingu katalitycznego"
msgstr[2] "reaktorów do krakingu katalitycznego"
msgstr[3] "reaktora do krakingu katalitycznego"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "catalytic cracking reactor"
msgid ""
"A makeshift extraction system, or as makeshift as you can consider something "
"that was purpose-built in a laboratory by a group of experts."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "hydraulic press"
msgid_plural "hydraulic presses"
msgstr[0] "prasa hydrauliczna"
msgstr[1] "prasy hydrauliczne"
msgstr[2] "pras hydraulicznych"
msgstr[3] "prasy hydraulicznej"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "hydraulic press"
msgid ""
"If you really want to squash something a lot, this is exactly the right "
"industrial tool for you.  Plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
#. ~ Vehicle part name
#. ~ Furniture name
#. ~ Item name
msgid "air compressor"
msgid_plural "air compressors"
msgstr[0] "kompresor"
msgstr[1] "kompresory"
msgstr[2] "kompresorów"
msgstr[3] "kompresora"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "air compressor"
msgid ""
"This durable tank is topped with a motor that will cram as much air into the "
"tank as possible.  Plugged in and ready to go."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "large heater"
msgstr "duży ogrzewacz"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Vehicle part name
msgid "small heater"
msgstr "mały ogrzewacz"

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift water electrolyzer"
msgid_plural "makeshift water electrolyzers"
msgstr[0] "prowizoryczny elektrolizer wody"
msgstr[1] "prowizoryczne elektrolizery wody"
msgstr[2] "prowizorycznych elektrolizerów wody"
msgstr[3] "prowizorycznego elektrolizera wody"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift water electrolyzer"
msgid ""
"A makeshift appliance which decomposes water into oxygen and hydrogen via "
"electrolysis of sodium hydroxide solution, with a power cord to connect it to "
"an electric grid."
msgstr ""
"Prowizoryczne urządzenie, które rozkłada wodę na tlen i wodór w procesie "
"elektrolizy roztworu wodorotlenku sodu, z przewodem zasilającym do "
"podłączenia do sieci elektrycznej."

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift ammonia machine reactor"
msgid_plural "makeshift ammonia machine reactors"
msgstr[0] "prowizoryczny reaktor maszyny do produkcji amoniaku"
msgstr[1] "prowizoryczne reaktory maszyny do produkcji amoniaku"
msgstr[2] "prowizorycznych reaktorów maszyny do produkcji amoniaku"
msgstr[3] "prowizorycznego reaktora maszyny do produkcji amoniaku"

#: data/json/furniture_and_terrain/appliances.json
#. ~ Description of vehicle part "makeshift ammonia machine reactor"
msgid ""
"A huge appliance built from salvaged industrial equipment, which produces "
"ammonia via the Haber-Bosch process from hydrogen and nitrogen.  It has a "
"power cord to connect it to an electric grid."
msgstr ""

#: data/json/furniture_and_terrain/appliances.json
#: data/json/items/tool/science.json
#. ~ Vehicle part name
#. ~ Item name
msgid "makeshift ammonia machine pipework"
