msgstr[2] "łopianów"
msgstr[3] "łopianu"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "burdock"
msgid ""
"A common weed with a purple thistle-like flower.  Its seeds tend to stick to "
"clothing and fur."
msgstr ""
"Pospolity chwast o fioletowych, przypominających oset kwiatach. Jego nasiona "
"mają tendencję do przyklejania się do ubrań i sierści."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "wild carrot"
msgstr "dzika marchewka"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "wild carrot"
msgid "A common white wildflower which could be harvested for its root."
msgstr "Pospolita biała dziko rosnąca roślina, którą można zbierać dla jej korzenia."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "starry false Solomon's seal"
msgstr "majówka gwiazdkowata"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "starry false Solomon's seal"
msgid ""
"The blossoms of this flower look like stars in the night sky.  Its crimson "
"berries are edible."
msgstr ""
"Kwiaty tego kwiatu wyglądają jak gwiazdy na nocnym niebie. Jego karmazynowe "
"jagody są jadalne."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "salsify"
msgstr "kozibrodu"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "salsify"
msgid "Tragopogon porrifolius, a ragged-looking purple flower with a nutritious root."
msgstr ""
"Tragopogon porrifolius - purpurowy kwiat o poszarpanym wyglądzie i pożywny "
"korzeń."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "chamomile"
msgstr "rumianek"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "chamomile"
msgid "A cute white flower with a yellow center, used to brew a soothing tea."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "tulip"
msgstr "tulipan"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "tulip"
msgid ""
"A bright, colorful flower with petals forming a small cup at its top.  It can "
"be poisonous to livestock."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "spurge flower"
msgstr "kwiat wilczomlecza"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "spurge flower"
msgid "A yellow-green flower that grows in densely-packed bushes."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "cattails"
msgstr "pałka wodna"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "cattails"
msgid ""
"This useful plant is available all year round.  Many parts of the plant are "
"edible."
msgstr ""
"Ta pożyteczna roślina jest dostępna przez cały rok. Wiele części rośliny jest "
"jadalnych."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "black eyed Susan"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "black eyed Susan"
msgid ""
"A mildly poisonous yellow flower with a dark ball in the middle.  Sometimes "
"known as an ox-eye daisy."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "lily"
msgstr "lilia"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "lily"
msgid "A pretty flower that comes in a variety of colors."
msgstr "Piękny kwiat, który występuje w różnych kolorach."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "lotus"
msgstr "lotos"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "lotus"
msgid ""
"A lovely flower that grows on the surface of bodies of fresh water.  A "
"traditional symbol of many Eastern cultures."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "sunflower"
msgid_plural "sunflowers"
msgstr[0] "słonecznik"
msgstr[1] "słoneczniki"
msgstr[2] "słoneczników"
msgstr[3] "słonecznika"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "sunflower"
msgid ""
"A tall, wide-headed flower with a large dark center.  Produces many "
"nutritious seeds."
msgstr ""
"Wysoki, rozłożysty kwiat z dużym ciemnym środkiem. Wytwarza wiele pożywnych "
"nasion."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "Jerusalem artichoke plant"
msgstr "słonecznik bulwiasty"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "Jerusalem artichoke plant"
msgid "Looking similar to a sunflower, this tall plant has a nutritious tuber."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "lilypad"
msgstr "lilia wodna"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "lilypad"
msgid ""
"This lilypad doesn't look like it would support the weight of the things "
"you've heard croaking in the swamp."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "bluebell"
msgstr "martensja"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "bluebell"
msgid "A common bluebell flower.  Pretty."
msgstr "Pospolity kwiat martensji. Ładny."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "dahlia"
msgstr "dalia"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "dahlia"
msgid "A puffy flower with many tightly-layered petals."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "chicory"
msgstr "cykoria"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "chicory"
msgid "A blue flower imported from Europe, also known as a cornflower."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "datura"
msgstr "bieluń"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "datura"
msgid "A pretty moonflower."
msgstr "Piękny bieluń."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "pile of leaves"
msgstr "stos liści"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "pile of leaves"
msgid ""
"A sizable pile of leaves.  You could sleep on it if you don't care about "
"comfort or warmth."
msgstr "Spory stos liści. Możesz na nim spać jeśli nie dbasz o komfort lub ciepło."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "mustard"
msgstr "gorczyca"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "mustard"
msgid ""
"A yellow flower known as Brassica Nigra.  Known for its seeds that can be "
"used for making table mustard."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "wild sarsaparilla"
msgstr "aralia bezbronna"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "wild sarsaparilla"
msgid ""
"A small, flowering plant known as 'Aralia nudicaulis'.  It is colored in "
"vibrant shades of orange and red in autumn, making it easy to spot."
msgstr ""
"Mała, kwitnąca roślina znana jako „Aralia nudicaulis”. Jesienią przebarwia "
"się na żywe odcienie pomarańczu i czerwieni, dzięki czemu łatwo ją zauważyć."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "wintergreen"
msgstr "golteria"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "wintergreen"
msgid ""
"A small shrub native to North America.  The leaves, which remain green even "
"in winter, are valued for medicinal purposes.  It produces edible and sweet "
"berries, too!"
msgstr ""
"Niewielka krzewinka pochodząca z Ameryki Północnej. Liście, które pozostają "
"zielone nawet w zimie, są cenione do celów leczniczych. Wytwarza również "
"jadalne i słodkie jagody!"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "Japanese knotweed"
msgstr "rdestowiec ostrokończysty"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "Japanese knotweed"
msgid ""
"An invasive species originating from Japan.  The stem looks like it might "
"contain some water."
msgstr ""
"Gatunek inwazyjny pochodzący z Japonii. Wygląda na to, że łodyga może "
"zawierać trochę wody."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "fireweed"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "fireweed"
msgid ""
"Vibrant purple, it tends to be the first to appear after fires, hence its "
"name."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "common selfheal"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "common selfheal"
msgid ""
"A small purple flower.  It got its name due to its usage in traditional "
"medicine."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "spreading dogbane"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "spreading dogbane"
msgid ""
"It is not only toxic to dogs when eaten by them.  Humans and many other "
"animals are affected, too.  Its fibers sure are worth salvaging though.  "
"Despite its name, it is not actually spreading fast."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "thistle"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "thistle"
msgid "A prickly and invasive small plant."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "purple loosestrife"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "purple loosestrife"
msgid ""
"A pretty violet flower that likes water.  Unfortunately it is invasive and "
"does not benefit the environment."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/raw_grain.json
#. ~ Furniture name
#. ~ Item name
msgid "wild rice"
msgid_plural "wild rice"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "wild rice"
msgid ""
"Also called Indian rice, Northern wild rice, or manoomin in Ojibwe, is a "
"species of rice that has been harvested and used by Native American tribes of "
"the northeast for hundreds of years.  It's similar to other types of wild "
"rice, offering a fiber-rich and healthy basis of a meal."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "short hedge"
msgstr "niski żywopłot"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "short hedge"
msgid "A shrub with small green leaves, trimmed into a squared shape."
msgstr "Krzew o małych, zielonych liściach, przyciętych w kwadratowy kształt."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "tall hedge"
msgstr "wysoki żywopłot"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "tall hedge"
msgid ""
"A tall shrub with small green leaves, trimmed into a squared shape.  You "
"can't see past this thick hedgerow."
msgstr ""
"Wysoki krzew o małych zielonych liściach, przyciętych w kwadratowy kształt. "
"Za tym gęstym żywopłotem nic nie widać."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "abstract topiary"
msgstr "abstrakcyjna żywa rzeźba"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "abstract topiary"
msgid "A tall shrub with small green leaves, trimmed into a fanciful abstract shape."
msgstr ""
"Wysoki krzew o drobnych, zielonych liściach, przyciętych w fantazyjny, "
"abstrakcyjny kształt."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Furniture name
msgid "animal topiary"
msgstr "zwierzęca żywa rzeźba"

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "animal topiary"
msgid "A tall shrub with small green leaves, trimmed into an animal shape."
msgstr "Wysoki krzew o drobnych, zielonych liściach, przycięty na kształt zwierzęcia."

#: data/json/furniture_and_terrain/furniture-flora.json
#. ~ Description of furniture "animal topiary"
msgid "A tall shrub with small green leaves, trimmed into a dragon shape."
msgstr "Wysoki krzew o drobnych, zielonych liściach, przycięty na kształt smoka."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/mods/innawood/furniture_and_terrain/misc.json
#. ~ Furniture name
msgid "dam"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/mods/innawood/furniture_and_terrain/misc.json
#. ~ Description of furniture "dam"
msgid ""
"A house that beavers built.  The entrance is underwater making it harder for "
"predators to access."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/mods/innawood/furniture_and_terrain/misc.json
#. ~ Bashing failed sound
msgid "bonk."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Furniture name
msgid "red algae"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "red algae"
msgid ""
"One of the thousands of species of grassy reddish marine plants that inhabit "
"intertidal zones the world over.  Its rubbery little fronds don't look "
"particularly edible."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Bashing sound
msgid "splat."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Bashing failed sound
msgid "squelch."
msgstr "chlupot."

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Furniture name
msgid "green algae"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "green algae"
msgid "A short patch of grassy green seaweed, wholly unremarkable."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#: data/json/items/comestibles/raw_veggy.json
#. ~ Furniture name
#. ~ Item name
msgid "sugar kelp"
msgid_plural "sugar kelp"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "sugar kelp"
msgid ""
"Also known as kombu, this brown algae grows in a single leaflike blade that "
"can reach more than twice the height of a man.  Young fronds make for "
"excellent soup stock and can even be eaten raw."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#: data/json/items/comestibles/raw_veggy.json
#. ~ Furniture name
#. ~ Item name
msgid "sea lettuce"
msgid_plural "sea lettuce"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "sea lettuce"
msgid ""
"Sometimes known as green laver, this leafy algae from the Ulva genus grows in "
"leafy little patches around shallows and tide pools.  Though small, it makes "
"a tasty snack."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#: data/json/items/comestibles/raw_veggy.json
#. ~ Furniture name
#. ~ Item name
msgid "bladderwrack"
msgid_plural "bladderwrack"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "bladderwrack"
msgid ""
"Named for the air bladders that grow all over its leafy fronds, this leafy "
"seaweed is technically edible and has a long history of use in folk medicine."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Furniture name
msgid "sea anemone"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "sea anemone"
msgid ""
"This sessile polyp waves its stinging tentacles with the motion of the tides, "
"hoping to capture a tiny fish or crab.  It's wholly inedible and poses no "
"danger to anything bigger than a shrimp."
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Furniture name
msgid "sea sponge"
msgstr ""

#: data/json/furniture_and_terrain/furniture-flora_marine.json
#. ~ Description of furniture "sea sponge"
msgid ""
"An immobile, lumpy little creature that looks nothing like a square kitchen "
"sponge.  Anchored to the sea floor, its porous body passively filters "
"plankton from the water that freely passes through it."
msgstr ""

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "Marloss flower"
msgstr "kwiat Marloss"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "Marloss flower"
msgid ""
"This flower looks mostly like the other flowers taken by the mushrooms, but "
"its bulb is a brilliant cyan color.  It emits an aroma that is both "
"overwhelming and strangely alluring."
msgstr ""

#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Bashing sound
#. ~ Bashing failed sound
msgid "poof."
msgstr "puff."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "fungal flower"
msgstr "grzybiczy kwiat"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "fungal flower"
msgid ""
"This flower has been overgrown by gray, sinewy tendrils of fungus, and the "
"color has been leached from its petals and stem.  It gently sways of its own "
"volition, maintaining an unsettling rhythm."
msgstr ""
"Ten kwiat porastają szare, żylaste nitki grzyba, a kolor został wyssany z "
"jego płatków i łodygi. Delikatnie kołysze się z własnej woli, utrzymując "
"niepokojący rytm."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "fungal mass"
msgstr "grzybicza masa"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "fungal mass"
msgid ""
"Thick ropes of Mycal matter have covered the ground here completely.  It's "
"soft to the touch, but not firm enough to hold any weight."
msgstr ""
"Grube sznury Grzybniczej materii całkowicie pokryły tutejsze podłoże. Jest "
"miękka w dotyku, ale nie na tyle twarda, by utrzymać jakikolwiek ciężar."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "fungal clump"
msgstr "grzybicza kępa"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "fungal clump"
msgid ""
"Alien mold and stems mingle tightly here, swaying around and weaving "
"together, creating a sort of fungal bush."
msgstr ""
"Obce pleśnie i łodygi mieszają się tu ciasno, kołysząc się i splatając ze "
"sobą, tworząc coś w rodzaju grzybiczego krzewu."

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Furniture name
msgid "fungal tangle"
msgstr "plątanina grzybów"

#: data/json/furniture_and_terrain/furniture-fungal.json
#. ~ Description of furniture "fungal tangle"
msgid ""
"Thick, ropy tendrils of fungus have risen from the ground and gathered into "
"an impenetrable clump."
msgstr ""
"Grube, sznurowate sploty grzyba wyrosły z ziemi i zbiły się w nieprzeniknioną "
"kępę."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "stone slab"
msgstr "kamienna płyta"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "stone slab"
msgid "A slab of heavy stone, with a reasonably flat surface."
msgstr "Płyta z ciężkiego kamienia, o w miarę płaskiej powierzchni."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "headstone"
msgstr "nagrobek"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "headstone"
msgid ""
"A large slab of stone, engraved with information on the deceased individual "
"buried beneath.  While only a solemn reminder of the uncountable losses of "
"the Cataclysm, a proper final resting place grants an odd sense of peace."
msgstr ""
"Duża kamienna płyta, na której wyryto informacje o zmarłej osobie, pochowanej "
"pod spodem. Choć jest to jedynie uroczyste przypomnienie o niezliczonych "
"stratach poniesionych w wyniku Kataklizmu, to jednak godne miejsce ostatniego "
"spoczynku daje dziwne poczucie spokoju."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "gravestone"
msgstr "płyta nagrobna"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "gravestone"
msgid ""
"An upright slab of stone with information engraved on the face about whoever "
"lies beneath.  While only a solemn reminder of the countless casualties of "
"the Cataclysm, a proper final resting place grants an odd sense of peace."
msgstr ""
"Pionowa kamienna płyta z wyrytą na powierzchni informacją o tym, kto pod nią "
"spoczywa. Choć jest to tylko uroczyste przypomnienie o niezliczonych ofiarach "
"Kataklizmu, to jednak godne miejsce ostatniego spoczynku daje dziwne poczucie "
"spokoju."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "worn gravestone"
msgstr "zniszczona płyta nagrobna"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "worn gravestone"
msgid ""
"An aged and eroded gravestone, damaged to the point of rendering the "
"inscription illegible.  Whoever's buried here was probably lucky enough to "
"pass before all this chaos began."
msgstr ""
"Wiekowa i zniszczona płyta nagrobna, uszkodzona do tego stopnia, że napis "
"stał się nieczytelny. Ktokolwiek jest tu pochowany, miał prawdopodobnie "
"szczęście, że odszedł zanim zaczął się ten cały chaos."

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "obelisk"
msgstr "obelisk"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "obelisk"
msgid ""
"A magnificent carved statue with an engraved plaque fixed to the base.  It "
"serves to honor the passing of somebody significant, something one wishes was "
"still a practical goal."
msgstr ""
"Wspaniały rzeźbiony posąg z wygrawerowaną tabliczką przytwierdzoną do "
"podstawy. Służy do uczczenia odejścia kogoś znaczącego, coś, co chciałoby "
"się, aby nadal było praktycznym celem."

#: data/json/furniture_and_terrain/furniture-graves.json
#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Bashing failed sound
msgid "thunk!"
msgstr "grzmot!"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Furniture name
msgid "battlefield cross"
msgstr "krzyż bitwy"

#: data/json/furniture_and_terrain/furniture-graves.json
#. ~ Description of furniture "battlefield cross"
msgid ""
"A makeshift memorial marker, made of a service rifle - buried in the dirt, or "
"nestled in a pair of boots - with a helmet perched on the stock.  A small way "
"to honor the dead."
msgstr ""
"Prowizoryczny upamiętniający znacznik, wykonany z karabinu - zakopanego w "
"ziemi lub schowanego w butach - z hełmem osadzonym na kolbie. Mały sposób na "
"uczczenie pamięci poległych."

#: data/json/furniture_and_terrain/furniture-graves.json
#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture_treesung.json
#. ~ Bashing failed sound
msgid "whack."
msgstr "łup."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "chemical mixer"
msgstr "mieszalnik chemiczny"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "chemical mixer"
msgid ""
"A large vat with a motorized mixing device for combining large quantities of "
"chemicals."
msgstr ""
"Duża kadź ze zmotoryzowanym urządzeniem mieszającym do łączenia dużych ilości "
"chemikaliów."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "broken generator"
msgstr "uszkodzony generator"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "broken generator"
msgid "This generator is broken and will not help you produce usable electricity."
msgstr ""
"Ten generator jest zepsuty i nie pomoże ci wytworzyć użytecznej energii "
"elektrycznej."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "Compact Advanced Sterling Radioisotope Generator"
msgstr "zaawansowany generator radioizotopowy Stirlinga"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "Compact Advanced Sterling Radioisotope
#. Generator"
msgid ""
"This hefty lump of steel and lead is the housing unit for a Stirling "
"generator powered by plutonium-238, originally designed by NASA and "
"repurposed by the military.  It is plastered with warning signs.  It's really "
"heavy owing to the thick armor plating, but you could take this down and use "
"it for your own purposes if you wanted."
msgstr ""

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "mobile antenna"
msgstr "mobilna antena"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "mobile antenna"
msgid ""
"A stark black directional antenna, seemingly part of a monitoring setup.  An "
"LED mounted on its back lights up with a lazy and irregular rhythm."
msgstr ""

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "light machinery"
msgstr "lekka maszyneria"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "light machinery"
msgid "Assorted light machinery.  You could scavenge it for parts."
msgstr "Lekkie maszyny różnego kalibru. Można by je wykorzystać na części."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "heavy machinery"
msgstr "ciężka maszyneria"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "heavy machinery"
msgid "Assorted heavy machinery.  You could scavenge it for parts."
msgstr "Ciężkie maszyny różnych rozmiarów. Można by je wykorzystać na części."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "old machinery"
msgstr "stara maszyneria"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "old machinery"
msgid "Assorted old, rusty machinery.  You could scavenge it for parts."
msgstr "Stare pordzewiałe maszyny różnego kalibru. Można by je wykorzystać na części."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "electronic machinery"
msgstr "elektroniczna maszyneria"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "electronic machinery"
msgid "Assorted electronic machinery.  You could scavenge it for parts."
msgstr "Elektroniczna maszyneria różnych rozmiarów. Można by je wykorzystać na części."

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
#. ~ Furniture name
msgid "robotic arm"
msgstr "robotyczne ramię"

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
#. ~ Description of furniture "robotic arm"
msgid ""
"An automated robotic arm used in assembly lines, which appears to be more "
"general-purpose than specially designed assemblers.  Despite being "
"functionless now, the parts could be useful."
msgstr ""
"Zrobotyzowane automatyczne ramię używane na liniach montażowych, które wydaje "
"się być bardziej uniwersalne niż specjalnie zaprojektowane urządzenia do "
"montażu. Mimo, że teraz jest bezużyteczne, jego części mogą być przydatne."

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
#. ~ Bashing failed sound
msgid "thunk."
msgstr "grzmot."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "ground cable"
msgstr "przewód uziemiający"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "ground cable"
msgid "A bunch of loose cables snake along the floor."
msgstr "Pęk luźnych kabli wijący się po podłodze."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Bashing sound
msgid "shred!"
msgstr "darcie!"

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/json/furniture_and_terrain/furniture-pallet.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Bashing failed sound
msgid "thud!"
msgstr "huk!"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "electrical conduit"
msgstr "przewód elektryczny"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "electrical conduit"
msgid "A thick bundle of electrical wiring protected by a metal conduit."
msgstr "Gruba wiązka okablowania elektrycznego chroniona przez metalową osłonę."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "capacitor bank"
msgstr "zestaw kondensatorów"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "capacitor bank"
msgid "A bank of heavy metal cylinders connected by large wires."
msgstr "Zestaw ciężkich metalowych cylindrów połączonych dużymi przewodami."

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/Aftershock/vehicles/part_items.json
#: data/mods/Aftershock/vehicles/vehicle_parts.json
#: data/mods/aftershock_exoplanet/vehicles/part_items.json
#: data/mods/aftershock_exoplanet/vehicles/vehicle_parts.json
#. ~ Furniture name
#. ~ Item name
#. ~ Vehicle part name
msgid "control station"
msgid_plural "control stations"
msgstr[0] "stacja kontrolna"
msgstr[1] "stacje kontrolne"
msgstr[2] "stacji kontrolnych"
msgstr[3] "stacji kontrolnej"

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "control station"
msgid "Assorted electronic interfaces and screens.  You could scavenge it for parts."
msgstr "Różne elektroniczne interfejsy i ekrany. Można by je wykorzystać na części."

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Furniture name
msgid "nuclear fuel cell"
msgstr ""

#: data/json/furniture_and_terrain/furniture-industrial.json
#. ~ Description of furniture "nuclear fuel cell"
msgid ""
"This fuel assembly consists of cylindrical rods put into bundles.  A uranium "
"oxide ceramic is formed into pellets and inserted into Zircaloy tubes that "
"are bundled together.  The Zircaloy tubes are pressurized with helium to "
"minimize pellet-cladding interaction which can lead to fuel rod failure over "
"long periods.  This fuel cell is used in nuclear power stations to produce "
"heat to power turbines."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "Autodoc Mk. XI"
msgstr "Autodok XI generacji"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "Autodoc Mk. XI"
msgid ""
"A surgical apparatus used for the installation and removal of bionics.  The "
"term name 'Autodoc' is something of a misnomer, as it can only operate if "
"programmed beforehand, something that a plethora of labels warn against doing "
"without expertise."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "Autodoc operation couch"
msgstr "kozetka operacyjna Autodoka"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "Autodoc operation couch"
msgid ""
"A plush red sofa made less comfortable by the medical machinery directly "
"above it.  It has a single leather strap on the right armrest."
msgstr ""
"Czerwona pluszowa sofa której komfort umniejsza medyczna maszyneria zwisająca "
"ponad nią. Ma pojedynczy skórzany pas na oparciu prawej ręki."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/json/vehicleparts/vehicle_parts.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "autoclave"
msgstr "autoklaw"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "autoclave"
#. ~ Description of furniture "filled autoclave"
msgid ""
"A device that can steam its contents at high enough temperatures to "
"completely sterilize them, killing any possible contaminants."
msgstr ""
"Urządzenie, które może poddać swoją zawartość działaniu pary wodnej w "
"wystarczająco wysokiej temperaturze, aby całkowicie ją wysterylizować, "
"zabijając wszelkie możliwe skażenia."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "filled autoclave"
msgstr "zapełniony autoklaw"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "sample freezer"
msgstr "zamrażarka z próbkami"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "sample freezer"
msgid ""
"A specialized freezer capable of maintaining temperatures of -80 Celsius, "
"best used for the preservation of delicate scientific samples."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "lab workbench"
msgstr "stół warsztatowy laboratorium"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "lab workbench"
msgid ""
"A metal storage cabinet topped with a durable resin countertop resistant to "
"most chemical spills and burns.  It has wired-in electrical and gas fittings."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "fume hood"
msgstr "dygestorium"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "fume hood"
msgid ""
"A metal hood atop a lab workspace, with durable glass shutters.  A fan in the "
"hood draws fumes and smoke from dangerous chemicals up into a ventilation "
"duct."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "shaker incubator"
msgstr "wstrząsarka"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "shaker incubator"
msgid ""
"A tool for keeping chemical broth nicely mixed and at just the right "
"temperature to grow bacteria.  Although more bacteria is probably the last "
"thing you need, considering the circumstances."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "emergency wash station"
msgstr "awaryjna stacja mycia"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "emergency wash station"
msgid ""
"A standing sink with a pair of nozzles, along with a large, brightly-colored "
"handle.  It is specially designed to quickly remove contaminants from the "
"eyes, and is easily usable without being able to see very well.  A sizable "
"notice warns against drinking the water it uses."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "IV pole"
msgstr "stojak na kroplówki"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "IV pole"
msgid ""
"A tall wire frame on a set of small wheels used for holding an IV bag, useful "
"for unattended administration."
msgstr ""
"Wysoka druciana rama na zestawie małych kółek służąca do trzymania worka "
"infuzyjnego, przydatna do podawania leków bez nadzoru."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "high performance liquid chromatographer"
msgstr "wysokosprawna chromatografia cieczowa"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "high performance liquid chromatographer"
#. ~ Description of furniture "high-performance liquid chromatographer"
msgid ""
"This high-tech tool would, with electricity and an experienced user, be a "
"very useful way to separate chemicals in a liquid or aqueous phase, based on "
"their affinity, to the stationary phase in a tube.  At least, that's what the "
"label says."
msgstr ""
"To zaawansowane technologicznie narzędzie, zakładając dostęp do prądu i "
"doświadczonego użytkownika, byłoby bardzo użytecznym sposobem na oddzielenie "
"substancji chemicznych w fazie ciekłej lub wodzie do fazy stałej w probówce, "
"używając podobieństw. Przynajmniej tak mówi etykieta."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "gas chromatographer"
msgstr "chromatograf gazowy"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "gas chromatographer"
msgid ""
"This high-tech tool would, with electricity and an experienced user, be a "
"very useful way to separate chemicals in a gaseous phase, based on their "
"affinity, to a stationary phase in a tube.  At least, that's what the label "
"says."
msgstr ""
"To zaawansowane technologicznie narzędzie, dzięki elektryczności i "
"doświadczonemu użytkownikowi, mogłoby być bardzo użytecznym sposobem na "
"oddzielenie substancji chemicznych w fazie gazowej, w oparciu o ich "
"powinowactwo, do fazy stacjonarnej w probówce. Przynajmniej tak mówi etykieta."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "mass spectrometer"
msgstr "spektrometr masowy"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Description of furniture "mass spectrometer"
msgid ""
"Inside this large white box is a carefully balanced set of electric field "
"generators that can precisely separate ionized particles based on their "
"charge-to-mass ratio, firing them into a detector that measures the exact "
"mass of the particle hitting it.  Invaluable for chemical analysis and other "
"advanced sciences, it's not as useful anymore."
msgstr ""
"Wewnątrz tego dużego białego pudełka znajduje się starannie wyważony zestaw "
"generatorów pola elektrycznego, które mogą precyzyjnie rozdzielać zjonizowane "
"cząstki na podstawie ich stosunku ładunku do masy, wystrzeliwując je do "
"detektora, który mierzy dokładną masę uderzającej w niego cząstki. "
"Nieoceniony w analizie chemicznej i innych zaawansowanych naukach, ale teraz "
"nie jest już tak użyteczny."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "nuclear magnetic resonance spectrometer"
msgstr "spektrometr magnetycznego rezonansu jądrowego"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "nuclear magnetic resonance spectrometer"
msgid ""
"A giant electromagnet with carefully tuned measurement equipment used to "
"observe how magnetic fields affect nuclear spins.  It is a common workhorse "
"for the discovery and study of chemical structures."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "electron microscope"
msgstr "mikroskop elektronowy"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "electron microscope"
msgid ""
"An enormous observational tool for studying the details of samples on an "
"immensely small scale."
msgstr "Ogromne narzędzie do badania szczegółów próbek w niezwykle małej skali."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "CT scanner"
msgstr "tomograf komputerowy"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "CT scanner"
msgid ""
"A massive piece of machinery used to take hundreds of X-ray images from 360 "
"degrees, often used for medical examinations."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "MRI machine"
msgstr "aparat rezonansu magnetycznego"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "MRI machine"
msgid ""
"A massive tool used to take NMR images of a patient placed inside, providing "
"invaluable medical insight."
msgstr ""
"Masywne narzędzie służące do wykonywania obrazów metodą jądrowego rezonansu "
"magnetycznego umieszczonego wewnątrz pacjenta, dostarczające nieocenionych "
"informacji medycznych."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "scanner bed"
msgstr "łoże skanera"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "scanner bed"
msgid ""
"A narrow, flat, and frankly uncomfortable bed for putting someone into an "
"imaging machine for medical observations."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "anesthetic machine"
msgstr "aparat do znieczulania"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "anesthetic machine"
msgid ""
"A large machine with various tanks, tubes, and monitoring devices used to "
"maintain precise levels of anesthesia in a patient to ensure they, at least "
"ideally, remain asleep, unfeeling, but alive."
msgstr ""
"Duża maszyna z różnymi zbiornikami, rurkami i urządzeniami monitorującymi, "
"używana do utrzymania precyzyjnego poziomu znieczulenia u pacjenta, aby "
"zapewnić, przynajmniej w idealnym przypadku, że pozostanie on uśpiony, bez "
"czucia, ale żywy."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "dialysis machine"
msgstr "dializator"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "dialysis machine"
msgid ""
"A large machine for pumping and filtering the blood of somebody without the "
"function of their kidneys."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "medical ventilator"
msgstr "respirator medyczny"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "medical ventilator"
msgid ""
"A sizable box on a set of wheels that will pump air in and out of a patient's "
"lungs when they are incapable of breathing, though often only needed "
"temporarily."
msgstr ""
"Sporej wielkości skrzynia na kółkach, która pompuje powietrze do i z płuc "
"pacjenta, gdy ten nie jest w stanie oddychać, choć często jest potrzebna "
"tylko tymczasowo."

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "privacy curtain"
msgstr "zasłona przebieralni"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "privacy curtain"
msgid "No peeking!"
msgstr "Nie podglądać!"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Bashing sound
msgid "swish!"
msgstr "fiuuu!"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Bashing failed sound
msgid "clattering metal!"
msgstr "klekotanie metalu!"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "open privacy curtain"
msgstr "otwórz zasłonę przebieralni"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "open privacy curtain"
msgid "Stop peeking!"
msgstr "Przestań podglądać!"

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/mods/Aftershock/maps/furniture_lab.json
#: data/mods/aftershock_exoplanet/maps/furniture_lab.json
#. ~ Furniture name
msgid "centrifuge"
msgstr "wirówka"

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "centrifuge"
msgid ""
"A centrifuge, a liquid separating device with an automated analyzer unit.  "
"For some reason, this one has an attached battery pack.  It could be used to "
"analyze a medical fluid sample, such as blood, if a test tube was placed in "
"it."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "X-ray scanner"
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "X-ray scanner"
msgid "A table with a movable head, often used for medical examinations."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "dental X-ray machine"
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "dental X-ray machine"
msgid "A device for creating radiographic images of the teeth."
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Furniture name
msgid "exam chair"
msgstr ""

#: data/json/furniture_and_terrain/furniture-medical.json
#. ~ Description of furniture "exam chair"
msgid "A medical exam chair with an overhead light, bolted to the floor."
msgstr ""

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Furniture name
msgid "pallet of bricks"
msgstr "paleta cegieł"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Description of furniture "pallet of bricks"
msgid ""
"A massive, packed-together block of bricks wrapped with plastic packaging.  "
"It makes for easy storage of building materials for masonry constructions."
msgstr ""

#: data/json/furniture_and_terrain/furniture-pallet.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-embrasures.json
#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Bashing failed sound
#. ~ Bashing sound
msgid "bash!"
msgstr "stuk!"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Furniture name
msgid "pallet of adobe bricks"
msgstr "paleta suszonych cegieł"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Description of furniture "pallet of adobe bricks"
msgid ""
"A massive, packed-together block of adobe bricks wrapped with plastic "
"packaging.  It makes for easy storage of building materials for masonry "
"constructions."
msgstr ""

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Furniture name
msgid "pallet of cement bags"
msgstr "paleta worków z cementem"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Description of furniture "pallet of cement bags"
msgid ""
"A massive, packed-together block of cement bags wrapped with plastic "
"packaging.  It makes for easy storage of building materials for masonry "
"constructions."
msgstr ""

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Furniture name
msgid "stack of wooden planks"
msgstr "stos drewnianych desek"

#: data/json/furniture_and_terrain/furniture-pallet.json
#. ~ Description of furniture "stack of wooden planks"
msgid ""
"Dozens of construction planks tied together for easier transport.  "
"Deconstruct to untie them."
msgstr ""
"Kilkadziesiąt desek konstrukcyjnych związanych razem w celu ułatwienia "
"transportu. Demontuj, aby je rozłączyć."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "bathtub"
msgstr "wanna"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "bathtub"
msgid ""
"An ordinary ceramic tub, with a now-functionless steel faucet and a plug "
"fixed over the drain.  Watertight and relatively clean, it would make for a "
"good water trough."
msgstr ""
"Zwykła ceramiczna wanna, z niedziałającym już stalowym kranem i korkiem nad "
"odpływem. Wodoszczelna i stosunkowo czysta, byłaby dobrym zbiornikiem na wodę."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/mods/Magiclysm/furniture_and_terrain/furniture_druid.json
#. ~ Bashing sound
msgid "porcelain breaking!"
msgstr "tłukącą się porcelanę!"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_habitat_floor.json
#: data/mods/Backrooms/furniture_terrain.json
#: data/mods/Magiclysm/furniture_and_terrain/furniture_druid.json
#: data/mods/Magiclysm/furniture_and_terrain/terrain.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_habitat_floor.json
#. ~ Bashing failed sound
msgid "whunk!"
msgstr "tłuk!"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "shower"
msgstr "prysznic"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "shower"
msgid ""
"A small enclosed ceramic room with a glass door and plumbing fixtures for "
"cleaning oneself.  Before it was a commonplace amenity, but now it's hard to "
"imagine wasting that much water."
msgstr ""
"Niewielkie, zamknięte pomieszczenie ceramiczne ze szklanymi drzwiami i "
"urządzeniami sanitarnymi do sprzątania. Wcześniej było to powszechne "
"udogodnienie, ale teraz trudno sobie wyobrazić marnowanie takiej ilości wody."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "sink"
msgstr "zlew"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "sink"
msgid ""
"A porcelain water basin with a water tap and drain, designed to be fitted "
"into an opening on a countertop."
msgstr ""
"Porcelanowy pojemnik na wodę z kranem i odpływem, przeznaczony do montażu w "
"otworze na blacie."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "sink with gravity-feed tank"
msgstr ""

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "sink with gravity-feed tank"
msgid ""
"A water basin with flowing water, fed by a tank suspended above.  A luxury "
"when the water main is unavailable.  This one has a hand pump to refill from "
"groundwater."
msgstr ""

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "toilet"
msgstr "toaleta"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "toilet"
msgid ""
"An invaluable fixture in any home, it would be a miracle to have one that "
"works.  The standing tank may hold a moderate amount of water, but while "
"better than anything that would be in the bowl, it would not be the cleanest."
msgstr ""
"Nieoceniona armatura w każdym domu; to byłby cud mieć jedną, która działa. "
"Rezerwuar może mieścić umiarkowaną ilość wody, ale chociaż będzie lepsza niż "
"cokolwiek, co znalazłbyś w muszli, to nadal nie będzie najczystsza."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "water heater"
msgstr "bojler"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "water heater"
#. ~ Description of furniture "family–sized water heater"
msgid ""
"An insulated metal tank with a small fire used to maintain near-boiling "
"temperatures.  There's no longer any way to power it, but any water left in "
"the large tank from before the power went out should be pretty clean, and it "
"could be used to store large quantities of other liquids too."
msgstr ""

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Furniture name
msgid "family–sized water heater"
msgstr ""

#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/json/items/tool/cooking.json data/json/vehicleparts/vehicle_parts.json
#. ~ Furniture name
#. ~ Item name
#. ~ Vehicle part name
msgid "water purifier"
msgid_plural "water purifiers"
msgstr[0] "oczyszczacz do wody"
msgstr[1] "oczyszczacze do wody"
msgstr[2] "oczyszczaczy do wody"
msgstr[3] "oczyszczacza do wody"

#: data/json/furniture_and_terrain/furniture-plumbing.json
#. ~ Description of furniture "water purifier"
msgid ""
"This device effectively sterilizes water.  You can plug it into a power grid "
"to use it."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "exercise machine"
msgid_plural "exercise machines"
msgstr[0] "maszyna do ćwiczeń"
msgstr[1] "maszyny do ćwiczeń"
msgstr[2] "maszyn do ćwiczeń"
msgstr[3] "maszyny do ćwiczeń"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "exercise machine"
msgid ""
"A heavy set of weightlifting equipment for strength training, with a pair of "
"heavy weights affixed to opposite ends of a sturdy pipe.  You can adjust the "
"set by hand-picking the weights you wish to use."
msgstr ""
"Ciężki zestaw sprzętu do podnoszenia ciężarów do treningu siłowego, z parą "
"ciężkich ciężarów przymocowanych do przeciwległych końców solidnej rury. "
"Zestaw można regulować, wybierając ręcznie ciężarki, których chcesz używać."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "ball machine"
msgstr "maszyna z piłkami"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "ball machine"
msgid ""
"A simple machine for launching sports balls of various types, with a pair of "
"motorized wheels that, if spun up, would fling the ball at moderate speeds.  "
"Probably not the most effective ranged weapon against the undead."
msgstr ""
"Prosta maszyna do wystrzeliwania piłek sportowych różnego typu, z parą "
"zmotoryzowanych kół, które po rozpędzeniu wyrzucałyby piłkę z umiarkowaną "
"prędkością. Prawdopodobnie nie jest to najskuteczniejsza broń dystansowa "
"przeciwko nieumarłym."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "parkour bars"
msgstr "pręty do parkoura"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "parkour bars"
msgid "A complicated set of monkey bars, to be used by adults to train parkour."
msgstr ""
"Skomplikowany zestaw drążków, które mają służyć dorosłym do trenowania "
"parkoura."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-recreational.json
#. ~ Bashing sound
msgid "crack!"
msgstr "krach!"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "pool table"
msgstr "stół bilardowy"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "pool table"
msgid ""
"A large wooden table with green felt carpeting on top, and a set of "
"symmetrical holes that carry billiard balls to an opening on one side.  While "
"not a good substitute for a normal table, you could take it apart for a "
"substantial amount of wood."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "diving block"
msgstr "podest do nurkowania"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "diving block"
msgid ""
"A chunky plastic stool bolted onto the ground, intended as a safe way of "
"diving forward into a body of water."
msgstr ""
"Masywny plastikowy stołek przykręcony do ziemi, mający służyć jako bezpieczny "
"sposób na skoki w przód do zbiornika wodnego."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "target"
msgstr "tarcza celownicza"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "target"
msgid ""
"A long sheet of metal, cut into a roughly human shape and held upright by a "
"pipe frame.  There are two bullseye targets painted onto it, a large one on "
"the torso, and a smaller one on the head.  It is peppered with small dents "
"and holes, and a large amount of the paint has flaked or chipped off."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "arcade machine"
msgid ""
"A bulky upright arcade cabinet, brightly painted and slightly worn with age.  "
"Useless for its intended purpose without power, it's bound to have valuable "
"parts."
msgstr ""
"Duży, stojący automat do gier zręcznościowych, pomalowany na jaskrawy kolor i "
"lekko podniszczony upływem czasu. Nieprzydatny bez prądu, ale na pewno ma "
"cenne części."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "pinball machine"
msgstr "flipper"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "pinball machine"
msgid ""
"An iconic game, this machine has a brightly decorated background on its "
"intricate obstacle course, which is covered by a long sheet of glass.  While "
"inoperable without power, it's still impressive to look at, though probably "
"more useful if disassembled."
msgstr ""
"Kultowa gra. Ta maszyna ma jaskrawo zdobione tło na swoim skomplikowanym "
"torze przeszkód, który jest pokryty długą taflą szkła. Choć nie działa bez "
"zasilania, nadal robi wrażenie, ale prawdopodobnie najbardziej się przyda, "
"jeśli zostanie zdemontowana."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "ergometer"
msgstr "ergometr"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "ergometer"
msgid ""
"An exercise machine with a set of handles and plates meant to emulate rowing "
"a boat.  Without power it can't be operated, but it might have useful parts "
"to be scavenged."
msgstr ""
"Maszyna do ćwiczeń z zestawem uchwytów i talerzy, mająca naśladować "
"wiosłowanie łodzią. Bez prądu nie da się jej uruchomić, ale może mieć "
"przydatne części, które można z niej wyłuskać."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "mechanical ergometer"
msgid_plural "mechanical ergometers"
msgstr[0] "ergometr mechaniczny"
msgstr[1] "ergometry mechaniczne"
msgstr[2] "ergometrów mechanicznych"
msgstr[3] "ergometru mechanicznego"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "mechanical ergometer"
msgid ""
"An exercise machine with a set of handles and plates meant to emulate rowing "
"a boat.  This an older model with mechanical resistance adjustments, so it "
"works without power."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "treadmill"
msgstr "bieżnia"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "treadmill"
msgid ""
"A motorized conveyor belt with a control panel for running in place.  Without "
"power, it's an immense challenge to move the belt.  Regardless, you're "
"probably getting enough cardio on your own."
msgstr ""
"Zmotoryzowany taśmociąg z panelem sterowania do biegania w miejscu. Bez "
"zasilania, przesuwanie taśmy jest ogromnym wyzwaniem. Niezależnie od tego, "
"prawdopodobnie masz wystarczająco dużo aktywności fizycznej na własną rękę."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "gravity treadmill"
msgid_plural "gravity treadmills"
msgstr[0] "bieżnia grawitacyjna"
msgstr[1] "bieżnie grawitacyjne"
msgstr[2] "bieżni grawitacyjnych"
msgstr[3] "bieżni grawitacyjnej"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "gravity treadmill"
msgid ""
"A gravity-driven conveyor belt with a mechanical control panel for running in "
"place.  The belt is positioned on an adjustable incline, so it slides back "
"under your weight without needing to be powered."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "heavy punching bag"
msgid_plural "heavy punching bags"
msgstr[0] "ciężki worek treningowy"
msgstr[1] "ciężkie worki treningowe"
msgstr[2] "ciężkich worków treningowych"
msgstr[3] "ciężkiego worka treningowego"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "heavy punching bag"
msgid ""
"A hefty, oblong leather bag, suspended from a ceiling mount with a steel "
"chain.  It can be used for exercise and combat training, with the notable "
"advantage that it doesn't fight back."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Bashing failed sound
msgid "whud."
msgstr "łup."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/furniture/decorative.json
#. ~ Furniture name
#. ~ Item name
msgid "piano"
msgid_plural "piano"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/furniture/decorative.json
#. ~ Description of furniture "piano"
#. ~ Description of "piano"
msgid ""
"An elegant piano, capable of producing beautiful music if used by a skilled "
"player.  A set of off-white and black keys are linked to a set of hammers, "
"which strike their corresponding tightly-coiled wire to produce sound."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Bashing sound
msgid "a suffering piano!"
msgstr "konające pianino!"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Bashing failed sound
msgid "kerchang."
msgstr "chrup."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "speaker cabinet"
msgstr "kolumna głośnikowa"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "speaker cabinet"
msgid ""
"An upright wood-panel case of large speakers, built to produce a potentially "
"deafening volume level.  While it would be a terrible idea to use this now, "
"it could hold useful parts."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "dancing pole"
msgstr "drążek do tańca"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "dancing pole"
msgid ""
"A tall steel pipe mounted vertically, securely fastened to the ceiling and "
"floor.  Usually used for various forms of dancing, often in adult-oriented "
"venues."
msgstr ""
"Wysoka stalowa rura zamontowana pionowo, bezpiecznie przymocowana do sufitu i "
"podłogi. Zazwyczaj używana do różnych form tańca, często w miejscach "
"przeznaczonych dla dorosłych."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "roulette table"
msgstr "stół do ruletki"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "roulette table"
msgid ""
"A huge table specially made for a specific form of gambling, with a grid "
"painted onto the felt top, and a concave spinning wheel intended to give a "
"random selection of the inscribed possibilities."
msgstr ""
"Ogromny stół stworzony specjalnie do specyficznej formy hazardu, z siatką "
"namalowaną na filcowym blacie i wklęsłym kołowrotkiem mającym dawać losowy "
"wybór spośród rozpisanych możliwości."

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Furniture name
msgid "pipe organ"
msgstr "organy"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "pipe organ"
msgid ""
"A majestic pipe organ.  Dubbed \"the king of instruments\", it is capable of "
"producing powerful sound harmonies if used by a skilled player.  Rows of "
"off-white and black keys are linked to a set of iron pipes, which resonate at "
"a specific pitch when pressurized air is driven through them."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Bashing sound
msgid "a dramatic pipe organ!"
msgstr "dramatyczne organy piszczałkowe!"

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "training dummy"
msgid_plural "training dummies"
msgstr[0] "manekin treningowy"
msgstr[1] "manekiny treningowe"
msgstr[2] "manekinów treningowych"
msgstr[3] "manekina treningowego"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "training dummy"
msgid ""
"A hand-made humanoid figure, useful for training in close quarters combat.  "
"This one is made from wood and has some duct tape to mark the striking "
"points.  It has been erected in the ground on its post."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "armored training dummy"
msgid_plural "armored training dummies"
msgstr[0] "opancerzony manekin treningowy"
msgstr[1] "opancerzone manekiny treningowe"
msgstr[2] "opancerzonych manekinów treningowych"
msgstr[3] "opancerzonego manekina treningowego"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "armored training dummy"
msgid ""
"A hand-made humanoid figure, useful for training in close quarters combat.  "
"This one is covered in scrap armor and looks on guard.  It has been erected "
"in the ground on its post."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "box archery target"
msgid_plural "box archery targets"
msgstr[0] "cel łuczniczy z pudła"
msgstr[1] "cele łucznicze z pudła"
msgstr[2] "celów łuczniczych z pudła"
msgstr[3] "celu łuczniczego z pudła"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "box archery target"
msgid ""
"A soft target for archery consisting of tightly-packed cloth stuffed into a "
"cardboard box, with a bullseye marked on the front."
msgstr ""
"Miękki cel do strzelania z łuku, składający się z ciasno upakowanego "
"materiału włożonego do kartonu, z zaznaczoną na przedniej stronie tarczą "
"strzelniczą."

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Bashing sound
msgid "whish!"
msgstr "łisz!"

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json
#. ~ Furniture name
#. ~ Item name
msgid "bale archery target"
msgid_plural "bale archery targets"
msgstr[0] "cel łuczniczy z beli"
msgstr[1] "cele łucznicze z beli"
msgstr[2] "celów łuczniczych z beli"
msgstr[3] "celu łuczniczego z beli"

#: data/json/furniture_and_terrain/furniture-recreation.json
#. ~ Description of furniture "bale archery target"
msgid ""
"A soft target for archery consisting of a bale of hay with a bullseye marked "
"on the front."
msgstr ""
"Miękki cel do strzelania z łuku, składający się z beli siana z zaznaczoną z "
"przodu tarczą strzelniczą."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "cell phone signal booster"
msgstr "wzmacniacz sygnału telefonów komórkowych"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "cell phone signal booster"
msgid ""
"A specialized piece of equipment that receives phone signals and amplifies "
"them to reach further destinations with more clarity.  Now that there's no "
"longer signals for them to boost, they're only good for parts."
msgstr ""
"Specjalistyczny element wyposażenia, który odbiera sygnały telefoniczne i "
"wzmacnia je, aby dotrzeć do dalszych miejsc z większą wyrazistością. Teraz, "
"gdy nie ma już sygnałów do ich wzmocnienia, są one dobre tylko na części."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Bashing failed sound
msgid "womp!"
msgstr "łomp!"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "satellite dish"
msgstr "dysk satelitarny"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "satellite dish"
msgid ""
"A small sheet metal disc designed to receive radio waves from orbital "
"satellites.  Satellites that will assuredly continue to orbit, with nothing "
"to broadcast."
msgstr ""
"Mały metalowy dysk zaprojektowany do odbioru fal radiowych z orbitalnych "
"satelitów. Satelitów, które z pewnością będą nadal krążyć po orbicie, nie "
"mając nic do nadawania."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "chimney crown"
msgstr "zwieńczenie komina"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "chimney crown"
msgid ""
"The top of a brick chimney, the opening is stained black with soot.  "
"Definitely too narrow to fit in."
msgstr ""
"Szczyt ceglanego komina, otwór jest poplamiony czarną sadzą. Zdecydowanie za "
"wąski, żeby się zmieścić."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "TV antenna"
msgstr "antena telewizyjna"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "TV antenna"
msgid ""
"A simple metal antenna to increase the reception of non-cable television "
"broadcasts.  Almost wholly obsolete for years, only being good for parts "
"isn't new for this item."
msgstr ""
"Prosta metalowa antena poprawiająca odbiór niekablowych programów "
"telewizyjnych. Od lat praktycznie całkowicie przestarzała, a to, że nadaje "
"się tylko na części nie jest niczym nowym dla tego przedmiotu."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "vent pipe"
msgstr "rura wentylacyjna"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "vent pipe"
msgid ""
"A sort of chimney spout for a building's internal ventilation system, this "
"can be used for circulation, venting fumes, and other such functions."
msgstr ""
"Rodzaj wylotu komina dla wewnętrznego systemu wentylacyjnego budynku, może "
"być używany do cyrkulacji, odprowadzania spalin i innych tego typu funkcji."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "wind vane"
msgstr "wiatrowskaz"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "wind vane"
msgid ""
"A metal fin that swivels around a central pivot, indicating the direction of "
"prevailing wind."
msgstr ""
"Metalowa płetwa, która obraca się wokół centralnego punktu obrotu, wskazując "
"kierunek przeważającego wiatru."

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Furniture name
msgid "roof turbine vent"
msgstr "dachowy wywietrznik turbinowy"

#: data/json/furniture_and_terrain/furniture-roof.json
#. ~ Description of furniture "roof turbine vent"
msgid ""
"A rotary wind turbine that will catch the wind and pull out air from inside.  "
"It is most commonly used for improving air circulation, particularly in "
"poorly-ventilated areas like attics."
msgstr ""
"Obrotowa turbina wiatrowa, która łapie wiatr i wyciąga powietrze z wnętrza. "
"Jest on najczęściej stosowany do poprawy cyrkulacji powietrza, szczególnie w "
"słabo wentylowanych pomieszczeniach, takich jak strychy."

#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Furniture name
msgid "bale of hay"
msgstr "bela siana"

#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Description of furniture "bale of hay"
msgid ""
"A massive packed-together block of hay, it makes for easy storage of straw "
"for livestock.  If your only other option is the floor, it makes a tolerable "
"bed."
msgstr ""
"Masywny, sprasowany blok siana ułatwia przechowywanie słomy dla zwierząt "
"gospodarskich. Jeśli jedyną inną opcją jest podłoga, jest to też znośne łóżko."

#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Furniture name
msgid "pile of woodchips"
msgstr "stos drewnianych wiórów"

#: data/json/furniture_and_terrain/furniture-rural.json
#. ~ Description of furniture "pile of woodchips"
msgid ""
"A large mound of piled wood chips.  Unpleasant to lay on, hard to walk "
"through, and a large fire hazard, it's probably best to shovel it out of the "
"way."
msgstr ""
"Duży kopiec spiętrzonych wiórów drzewnych. Nieprzyjemny do leżenia na nim, "
"trudny do przejścia i stwarzający duże zagrożenie pożarowe, prawdopodobnie "
"najlepiej usunąć go łopatą z drogi."

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "bench"
msgstr "ławka"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "bench"
msgid ""
"A simple bench with wood slats nailed to a frame.  While uncomfortably flat "
"and just as cold as the ground, it could serve as a bed if needed."
msgstr ""
"Prosta ławka z drewnianych listew przybitych do ramy. Choć niewygodnie płaska "
"i równie zimna jak ziemia, w razie potrzeby może służyć za łóżko."

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "armchair"
msgid_plural "armchairs"
msgstr[0] "fotel"
msgstr[1] "fotele"
msgstr[2] "foteli"
msgstr[3] "fotela"

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Description of furniture "armchair"
#. ~ Description of "armchair"
msgid ""
"A simple upholstered chair with armrests.  Soft and fairly warm, it "
"definitely beats the ground for sleeping on, though not by much."
msgstr ""
"Proste, tapicerowane krzesło z podłokietnikami. Miękkie i w miarę ciepłe, "
"zdecydowanie w kwestii spania bije na głowę ziemię, choć znowu nie o aż tak "
"wiele."

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "airplane seat"
msgstr "siedzenie samolotowe"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "airplane seat"
msgid ""
"A cheaply-upholstered folding airplane seat, it has a simple across-the-lap "
"seatbelt.  You likely wouldn't be the first to sleep in this."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "wooden chair"
msgid_plural "wooden chairs"
msgstr[0] "drewniane krzesło"
msgstr[1] "drewniane krzesła"
msgstr[2] "drewnianych krzeseł"
msgstr[3] "drewnianego krzesła"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "wooden chair"
msgid ""
"A simple wooden chair with four legs, a seat, and a back.  It's nice to rest "
"your feet for once, and if coupled with a suitable table, you could eat a "
"meal properly and almost pretend that things were normal again."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "sofa"
msgstr "sofa"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "sofa"
msgid ""
"A wide upholstered bench, large enough for two people to comfortably sit "
"alongside one another, or for one person to lay down on.  It's not quite a "
"bed, but it's a hell of a lot more comfortable than the floor."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "wooden stool"
msgid_plural "wooden stools"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "wooden stool"
msgid ""
"A simple stool with four legs and a seat.  While it's a touch more "
"maneuverable to sit on, the lack of back support means it's significantly "
"less comfortable than a normal chair."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "camp chair"
msgid_plural "camp chairs"
msgstr[0] "krzesło kempingowe"
msgstr[1] "krzesła kempingowe"
msgstr[2] "krzeseł kempingowych"
msgstr[3] "krzesła kempingowego"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "camp chair"
msgid ""
"A somewhat uncomfortable folding chair, with fabric strung across a metal "
"frame.  Not the best, but better than nothing, and very easy to pack up for "
"transport."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "log stool"
msgid_plural "log stools"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "log stool"
msgid ""
"A short section of a tree trunk with one of the flat ends smoothed down.  "
"Makes for a decent place to sit, but not quite a real chair."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "deck chair"
msgid_plural "deck chairs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "deck chair"
msgid ""
"A folding deck chair with fabric sheets mounted to a wooden frame.  While "
"it's built to handle outdoor conditions and is an improvement over the "
"ground, it's not particularly comfortable."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "metal bench"
msgstr "metalowa ławka"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "metal bench"
msgid "A bench made of metal.  Not the most comfortable furniture you've ever sat on."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/vehicleparts/vehicle_parts.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "wooden bench"
msgstr "drewniana ławka"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "wooden bench"
msgid ""
"A simple wooden bench made of two thick, makeshift legs and a flat piece of "
"wood on top.  Certainly nowhere near as good as a bed, but sitting on it "
"makes you feel like you're out camping."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "park bench"
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "park bench"
msgid ""
"A wooden bench with a metal frame and a back support.  Cold and uncomfortable "
"to sleep on, but sitting on it is not terrible."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "bar stool"
msgid_plural "bar stools"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "bar stool"
msgid ""
"A bar stool with a leather seat on a steel support.  Not practical for "
"sleeping at all, but it does feel nicer than sitting on the ground."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "folding chair"
msgid_plural "folding chairs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "folding chair"
msgid ""
"A black foldable plastic chair on a steel frame.  Not particularly "
"comfortable, but at least you have something to sit on."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "plywood chair"
msgid_plural "plywood chairs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "plywood chair"
msgid ""
"A simple chair made of plywood on a steel frame.  Quite uncomfortable, but it "
"works for sleeping if it's the only option available."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "black wooden chair"
msgid_plural "black wooden chairs"
msgstr[0] "czarne drewniane krzesło"
msgstr[1] "czarne drewniane krzesła"
msgstr[2] "czarnych drewnianych krzeseł"
msgstr[3] "czarnego drewnianego krzesła"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "black wooden chair"
msgid ""
"A simple wooden chair with four legs, a seat, and a back.  It's nice to rest "
"your feet for once, and if coupled with a suitable table, you could eat a "
"meal properly and almost pretend that things were normal again.  This "
"particular chair is painted black."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "white wooden chair"
msgid_plural "white wooden chairs"
msgstr[0] "białe drewniane krzesło"
msgstr[1] "białe drewniane krzesła"
msgstr[2] "białych drewnianych krzeseł"
msgstr[3] "białego drewnianego krzesła"

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "white wooden chair"
msgid ""
"A simple wooden chair with four legs, a seat, and a back.  It's nice to rest "
"your feet for once, and if coupled with a suitable table, you could eat a "
"meal properly and almost pretend that things were normal again.  This "
"particular chair is painted white."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Furniture name
msgid "barber chair"
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#. ~ Description of furniture "barber chair"
msgid ""
"a stationary chair made of cloth and steel.  With adjustable height and the "
"ability to swing."
msgstr ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Furniture name
#. ~ Item name
msgid "bean bag"
msgid_plural "bean bags"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/furniture/seating.json
#. ~ Description of furniture "bean bag"
#. ~ Description of "bean bag"
msgid "A large cushion filled with beads often used as a seat."
msgstr ""

#: data/json/furniture_and_terrain/furniture-signs.json
#: data/mods/innawood/furniture_and_terrain/furniture-tools.json
#. ~ Furniture name
msgid "bulletin board"
msgstr "słup ogłoszeniowy"

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "bulletin board"
msgid ""
"A wide wooden frame with a sheet of corkboard inside.  Good for pinning "
"various notices for other survivors to read."
msgstr ""
"Szeroka drewniana rama z arkuszem z tablicy korkowej w środku. Dobra do "
"przypinania różnych ogłoszeń, aby inni ocaleni mogli je przeczytać."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Furniture name
msgid "sign"
msgstr "znak"

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "sign"
msgid ""
"A simple signpost made of wood.  Basically two planks alongside each other "
"nailed to another plank that holds them up."
msgstr ""
"Prosty drogowskaz wykonany z drewna. W zasadzie dwie deski obok siebie "
"przybite do innej deski, która je podtrzymuje."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Furniture name
msgid "warning sign"
msgstr "znak ostrzegawczy"

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "warning sign"
msgid ""
"A triangular signpost painted white with a red border.  Designed to easily "
"catch the eye, signs of this nature seldom display anything but bad news."
msgstr ""
"Trójkątny drogowskaz pomalowany na biało z czerwoną obwódką. Zaprojektowany "
"tak, aby przyciągać wzrok, znaki tego typu rzadko pokazują coś innego niż złe "
"wieści."

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Furniture name
msgid "evac shelter info board"
msgstr ""

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "evac shelter info board"
msgid ""
"A wide wooden frame surrounding a sheet of cork, on to which a number of "
"full-page notices have been neatly tacked.  Most seem to provide emergency "
"information, or instructions now woefully outdated considering the state of "
"things, but a map pointing to the nearest refugee center catches your eye.  "
"You should take a closer look."
msgstr ""

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Player message in effect in EoC "EOC_EVAC_BOARD_FALSE" in furniture "evac
#. shelter info board"'s examine action
msgid ""
"You study the board.  It shows a similar set of directions to the ones you "
"already have.  You cross-reference them and don't learn anything new."
msgstr ""

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Player message in effect in EoC "EOC_EVAC_BOARD" in furniture "evac
#. shelter info board"'s examine action
msgid ""
"You study the board.  One of the pages has a map and address for a nearby "
"refugee center alongside minutia you no longer need trouble yourself with now "
"that society has collapsed, like 'operating hours' and 'acceptable forms of "
"ID'.  You take careful note of the map on the board and mark down the "
"coordinates."
msgstr ""

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Furniture name
msgid "stop sign"
msgstr ""

#: data/json/furniture_and_terrain/furniture-signs.json
#. ~ Description of furniture "stop sign"
msgid "An octagonal red sign on a long metal pole, marked with the word STOP."
msgstr ""

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/vehicleparts/vehicle_parts.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture_treesung.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "bed"
msgstr "łóżko"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "bed"
msgid ""
"A standard mattress on a sturdy wooden frame.  Even without blankets or "
"pillows, and despite being a completely ordinary mattress, it's a sight for "
"sore, tired eyes."
msgstr ""
"Standardowy materac na solidnym drewnianym stelażu. Nawet mimo braku koców, "
"poduszek i prostoty tego materaca, jest to wspaniały widok dla zmęczonych "
"oczu."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/recipes/basecamps/base/fbmc_outpost/recipe_modular_outpost_normal.json
#. ~ Furniture name
#. ~ Blueprint name of recipe crafting "faction_base_outpost_normal_bed_0"
msgid "bunk bed"
msgstr "łóżko piętrowe"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "bunk bed"
msgid ""
"A bunk bed with a sturdy wooden frame built to hold two single-person "
"mattresses above one another.  While these usually mean sleeping closer than "
"you'd like to somebody you wouldn't normally want to share a mattress with, a "
"bed's a bed."
msgstr ""
"Łóżko piętrowe z solidną drewnianą ramą zbudowaną tak, aby pomieścić dwa "
"jednoosobowe materace nad sobą. Chociaż zazwyczaj oznacza to spanie bliżej "
"niż byś chciał z kimś, z kim normalnie nie chciałbyś dzielić materaca, to "
"jednak co łóżko to łóżko."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture_treesung.json
#. ~ Furniture name
msgid "down bed"
msgstr ""

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "down bed"
msgid ""
"A down mattress on a sturdy wooden frame.  Even without blankets or pillows, "
"and despite being a completely ordinary mattress, it's a sight for sore, "
"tired eyes."
msgstr ""

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "down bunkbed"
msgstr ""

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "down bunkbed"
msgid ""
"A bunk bed with a sturdy wooden frame built to hold two single-person "
"mattresses above one another.  While these usually mean sleeping closer than "
"you'd like to somebody you wouldn't normally want to share a mattress with, a "
"bed's a bed.  This one has two down mattresses."
msgstr ""

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "triple berth"
msgstr "potrójna koja"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "triple berth"
msgid ""
"This bunk bed can hold three people at once - a perfect sleeping solution for "
"places where empty space is at a premium."
msgstr ""

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "bed frame"
msgstr "rama łóżka"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "bed frame"
msgid ""
"A sturdy wooden bed frame built to hold most standard mattresses.  Despite "
"being one half of a bed, it's just about impossible to lay on by itself."
msgstr ""
"Wytrzymała drewniana rama łóżka zbudowana tak, aby pomieścić większość "
"standardowych materaców. Pomimo tego, że jest to połowa łóżka, nie da się na "
"niej położyć oddzielnie."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "mattress"
msgid ""
"An ordinary mattress lying on the floor.  While it's not as comfortable as a "
"proper bed with a frame, it's pretty close.  If it's somewhere actually safe "
"to sleep, this is practically a luxury in and of itself."
msgstr ""

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "down mattress"
msgid ""
"A squishy, feather-stuffed mattress lying on the floor.  While it's not as "
"comfortable as a proper bed with a frame, it's pretty close.  If it's "
"somewhere actually safe to sleep, this is practically a luxury in and of "
"itself."
msgstr ""

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/items/generic/bedding.json
#. ~ Furniture name
#. ~ Item name
msgid "hammock"
msgid_plural "hammocks"
msgstr[0] "hamak"
msgstr[1] "hamaki"
msgstr[2] "hakamów"
msgstr[3] "hamaka"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "hammock"
msgid ""
"A large sheet of cloth with ropes on two sides tied to nearby objects.  It's "
"quite comfortable to sleep in, but provides no warmth."
msgstr ""
"Duża płachta materiału ze sznurami po dwóch stronach przywiązanymi do "
"pobliskich przedmiotów. Jest dość wygodna do spania, ale nie zapewnia ciepła."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Bashing failed sound
msgid "slap!"
msgstr "plask!"

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/items/generic/bedding.json
#. ~ Furniture name
#. ~ Item name
msgid "net hammock"
msgid_plural "net hammocks"
msgstr[0] "hamak z siatki"
msgstr[1] "hamaki z siatki"
msgstr[2] "hamaków z siatki"
msgstr[3] "hamaka z siatki"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "net hammock"
msgid ""
"A large net with ropes on two sides tied to nearby objects.  It's quite "
"comfortable to sleep in, but provides no warmth."
msgstr ""
"Duża siatka z linami po dwóch stronach przywiązana do pobliskich przedmiotów. "
"Jest dość wygodna do spania, ale nie zapewnia ciepła."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "makeshift bed"
msgstr "prowizoryczne łóżko"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "makeshift bed"
msgid ""
"An improvised mattress on a flimsy wooden frame.  Almost as good as a normal "
"bed, albeit with a slightly lumpy mattress.  Considering the circumstances, "
"it's not too bad at all."
msgstr ""
"Prowizoryczny materac na chwiejnej drewnianej ramie. Prawie tak dobry jak "
"normalne łóżko, choć materac jest nieco gruzłowaty. Biorąc pod uwagę "
"okoliczności, nie jest źle."

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Furniture name
msgid "straw bed"
msgstr "siennik"

#: data/json/furniture_and_terrain/furniture-sleep.json
#. ~ Description of furniture "straw bed"
msgid ""
"An improvised bedding pile made of hay.  Better than nothing, but not "
"particularly comfortable, and quite itchy."
msgstr ""
"Prowizoryczna posłanie z kupy siana. Lepsze to niż nic, ale nieszczególnie "
"wygodne i dość swędzące."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "bookcase"
msgstr "biblioteczka"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "bookcase"
msgid ""
"A simple wooden shelf for storing dozens of books.  While designed for books, "
"it does a decent job of storing anything else that'll fit."
msgstr ""
"Prosta drewniana półka do przechowywania kilkudziesięciu książek. Choć "
"zaprojektowana z myślą o książkach, świetnie radzi sobie z przechowywaniem "
"wszystkiego innego, co się tylko zmieści."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "entertainment center"
msgstr "centrum rozrywki"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "entertainment center"
msgid ""
"While not quite as cool by itself as the name might imply, this large wooden "
"cabinet can store a variety of things, like a TV and media systems, with "
"shelving space and cupboards for anything that'll fit."
msgstr ""
"Choć sama w sobie nie jest tak fajna, jak mogłaby sugerować jej nazwa, ta "
"duża drewniana szafka może pomieścić wiele rzeczy, takich jak telewizor i "
"systemy multimedialne, z półkami i szafkami na wszystko, co się do nich "
"zmieści."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "coffin"
msgstr "trumna"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "coffin"
msgid ""
"A humble wooden casket for the respectful burial of the dead.  While a "
"standard practice before this all happened, it is now a rare honor for one to "
"be given a proper final resting place.  An honor that countless many will "
"likely never receive."
msgstr ""
"Skromna, drewniana trumna do godnego pochówku zmarłych. Zanim to wszystko się "
"wydarzyło, było to standardową praktyką, ale teraz jest to rzadki zaszczyt "
"dla kogoś, by dostąpić zaszczytu otrzymania godnego miejsca ostatniego "
"spoczynku. Zaszczyt, którego niezliczona liczba osób prawdopodobnie nigdy nie "
"dostąpi."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/furniture_and_terrain/terrain-windows.json
#: data/mods/desert_region/furniture-and-terrain/desert_terrain.json
#. ~ Bashing failed sound
#. ~ Bashing sound
msgid "wham!"
msgstr "bam!"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying action message of furniture "coffin"
msgid "You wedge open the coffin."
msgstr "Wyważasz i uchylasz wieko trumny."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying failure message of furniture "coffin"
msgid "You pry, but the coffin remains closed."
msgstr "Próbujesz podważać, ale nie możesz wyważyć wieka trumny."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open coffin"
msgstr "otwarta trumna"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open coffin"
msgid ""
"A humble wooden casket for the respectful burial of the dead.  While a "
"standard practice before this all happened, it is now a rare honor for one to "
"be given a proper final resting place.  This one is open and unoccupied, and "
"gazing inside fills you with a sense of melancholic weariness."
msgstr ""
"Skromna, drewniana trumna do godnego pochówku zmarłych. Zanim to wszystko się "
"wydarzyło, było to standardową praktyką, ale teraz jest to rzadki zaszczyt "
"dla kogoś, by dostąpić zaszczytu otrzymania godnego miejsca ostatniego "
"spoczynku. Ta jest otwarta i pusta, a zaglądanie do środka napełnia cię "
"poczuciem melancholijnego znużenia."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "crate"
msgstr "skrzynka"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "crate"
msgid ""
"A sealed wooden storage container.  Lacking any labels, it could hold just "
"about anything inside.  If you don't have a proper tool to pry it open, "
"smashing it is an option, albeit one that risks destroying the contents."
msgstr ""
"Szczelnie zamknięty drewniany pojemnik do przechowywania. Nie posiada żadnych "
"etykiet, więc w środku może znajdować się praktycznie wszystko. Jeśli nie "
"masz odpowiedniego narzędzia, aby go otworzyć, możesz go rozbić, aczkolwiek "
"istnieje ryzyko zniszczenia zawartości."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying action message of furniture "crate"
msgid "You pop open the crate."
msgstr "Wyważasz skrzynię i otwierasz ją."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying failure message of furniture "crate"
msgid "You pry, but can't pop open the crate."
msgstr "Próbujesz podważać, ale nie możesz wyważyć skrzyni."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open crate"
msgstr "otwarta skrzynka"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open crate"
msgid ""
"An open wooden storage box, capable of holding any number of things.  The lid "
"has been pried off and is leaned adjacent to it, and with a fresh set of "
"nails, could be sealed back shut."
msgstr ""
"Otwarta drewniana skrzynia, mogąca pomieścić dowolną ilość rzeczy. Wieko "
"zostało zdjęte i jest oparte obok, a z nowym zestawem gwoździ można by je z "
"powrotem zamknąć."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers/containers.json
#. ~ Furniture name
#. ~ Item name
msgid "large cardboard box"
msgid_plural "large cardboard boxes"
msgstr[0] "duże kartonowe pudło"
msgstr[1] "duże kartonowe pudła"
msgstr[2] "dużych kartonowych pudeł"
msgstr[3] "dużego kartonowego pudła"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "large cardboard box"
msgid ""
"A large box made of brown corrugated paper.  Could contain a number of "
"things, and you could even hide inside.  Considering it only has two small "
"flaps for carrying, it's very hard to see out of, and won't do anything to "
"protect you if you're found."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#. ~ Bashing sound
msgid "crumple!"
msgstr "zgniatanie!"

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers/containers.json
#. ~ Furniture name
#. ~ Item name
msgid "reinforced large cardboard box"
msgid_plural "reinforced large cardboard boxes"
msgstr[0] "wzmocnione duże kartonowe pudło"
msgstr[1] "wzmocnione duże kartonowe pudła"
msgstr[2] "wzmocnionych dużych kartonowych pudeł"
msgstr[3] "wzmocnionego dużego kartonowego pudła"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "reinforced large cardboard box"
msgid ""
"A large box made of brown corrugated paper that was doubled up for extra "
"strength.  Could contain a number of things, and you could even hide inside.  "
"Considering it only has two small flaps for carrying, it's very hard to see "
"out of, and won't do anything to protect you if you're found."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "dresser"
msgstr "komoda"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "dresser"
msgid ""
"A simple wooden cabinet with a column of short drawers.  While intended for "
"storing clothes, there's nothing stopping you from storing whatever fits."
msgstr ""
"Prosta drewniana szafka z kolumną krótkich szuflad. Choć przeznaczona jest do "
"przechowywania ubrań, nic nie stoi na przeszkodzie, aby przechowywać w niej "
"wszystko, co się zmieści."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "glass front cabinet"
msgstr "witryna"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "glass front cabinet"
msgid ""
"A tall metal cabinet with a sheet of glass across the front for viewing the "
"contents.  Often used for displaying rare, visually pleasing, or otherwise "
"valuable goods, it's odd that it doesn't have a lock."
msgstr ""
"Wysoka metalowa szafka z taflą szkła na froncie, umożliwiająca oglądanie "
"zawartości. Często używana do eksponowania rzadkich, atrakcyjnych wizualnie "
"lub w inny sposób cennych przedmiotów, dziwne, że nie ma zamka."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open gun safe"
msgstr "otwarty sejf na broń"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open gun safe"
msgid ""
"A large, heavy container with thick metal walls, designed to securely store "
"firearms, weapon mods, and ammunition.  This one is wide open."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_habitat.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Bashing sound
msgid "screeching metal!"
msgstr "zgrzyt metalu!"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "closed gun safe"
msgstr "zamknięty sejf na broń"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "closed gun safe"
msgid ""
"A large, heavy container with thick metal walls and a rotary combination "
"lock, designed to securely store firearms, weapon mods, and ammunition.  This "
"one is closed, but not locked."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "locked gun safe"
msgstr "zabezpieczony sejf na broń"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "locked gun safe"
msgid ""
"A large, heavy container with thick metal walls and a rotary combination "
"lock, designed to securely store firearms, weapon mods, and ammunition.  If "
"you had something to pick its lock with, you could probably open it."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "locked gun safe"
msgid "With a satisfying click, the lock on the gun safe door opens."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "jammed gun safe"
msgstr "zacięty sejf na broń"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "jammed gun safe"
msgid ""
"A large, heavy container with thick metal walls and a rotary combination "
"lock, designed to securely store firearms, weapon mods, and ammunition.  "
"Unfortunately, the lock is completely broken, and short of some pretty "
"serious machinery, you have no possible way of opening it."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "electronic gun safe"
msgstr "elektroniczny sejf na broń"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "electronic gun safe"
msgid ""
"A large, heavy container with thick metal walls and an electronic locking "
"system, designed to securely store firearms, weapon mods, and ammunition.  If "
"you had some way of hacking into it, you could probably crack it open."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "locker"
msgstr "schowek"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "locker"
msgid ""
"A tall sheet metal cabinet, useful for storing just about anything that'll "
"fit."
msgstr ""
"Wysoka szafa blaszana, przydatna do przechowywania wszystkiego, co się w niej "
"zmieści."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "mailbox"
msgstr "skrzynka na listy"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "mailbox"
msgid ""
"A small metal box on top of a wooden post, designed to receive mail "
"deliveries.  Although considering the circumstances, it will likely never see "
"proper use again."
msgstr ""
"Mała metalowa skrzynka na szczycie drewnianego słupa, przeznaczona do "
"odbierania przesyłek pocztowych. Choć biorąc pod uwagę okoliczności, "
"prawdopodobnie nigdy już nie doczeka się właściwego zastosowania."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "clothing rail"
msgstr "szyna odzieżowa"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "clothing rail"
msgid ""
"A metal frame on a set of wheels used for hanging large amounts of clothes.  "
"Usually used in theater or retail environments, it's easy to use and quick to "
"access."
msgstr ""
"Metalowa rama na zestawie kółek używana do wieszania dużych ilości ubrań. "
"Zazwyczaj używana w teatrach lub sklepach detalicznych, jest szybka w użyciu "
"i łatwo dostępna."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "display rack"
msgstr "gablota"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "display rack"
msgid ""
"A sheet metal shelving unit, with the storage surfaces angled in such a way "
"as to show off the items stored."
msgstr ""
"Moduł regałowy z blachy, z powierzchniami składowania pochylonymi w taki "
"sposób, aby wyeksponować przechowywane przedmioty."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "locked display rack"
msgstr "zaryglowany regał ekspozycyjny"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "locked display rack"
msgid ""
"A sheet metal shelving unit, with the storage surfaces angled in such a way "
"as to show off the items stored.  Metal fasteners with a lock hold the items "
"securely to the rack."
msgstr ""
"Regał z blachy stalowej, z powierzchniami składowania ustawionymi pod kątem w "
"taki sposób, aby wyeksponować przechowywane przedmioty. Metalowe łączniki z "
"blokadą utrzymują przedmioty bezpiecznie na regale."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "locked display rack"
msgid "With a satisfying click, the lock opens."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "wooden rack"
msgstr "stojak drewniany"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "wooden rack"
msgid ""
"A wooden shelving unit with angled storage surfaces designed to show off "
"whatever is stored on it."
msgstr ""
"Drewniany moduł regałowy z ukośnymi powierzchniami składowania zaprojektowany "
"by eksponować cokolwiek się na nim składuje."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "coat rack"
msgstr "wieszak na ubrania"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "coat rack"
msgid ""
"A tall wooden pole with a set of hooks used to store outdoor jackets and hats "
"to allow easy access."
msgstr ""
"Wysoki drewniany słupek z zestawem haczyków służący do przechowywania kurtek "
"i kapeluszy, tak aby był do nich łatwy dostęp."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "recycle bin"
msgstr "kosz do segregacji odpadów"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "recycle bin"
msgid ""
"A large plastic bin painted green with a 'recycle' symbol emblazoned on it.  "
"While intended to store discarded things to be processed back into a factory, "
"the drastic change in priorities as of late means that these may hold "
"valuable materials."
msgstr ""
"Duży plastikowy pojemnik pomalowany na zielono z wyhaftowanym symbolem "
"„recyklingu”. Przeznaczony do przechowywania wyrzuconych rzeczy, które mają "
"zostać przetworzone z powrotem w fabryce, ale drastyczna zmiana priorytetów w "
"ostatnim czasie oznacza, że mogą się w nim znajdować cenne materiały."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_habitat.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Furniture name
msgid "safe"
msgstr "sejf"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "safe"
msgid ""
"A small, heavy, and near-unbreachable metal box with a rotary combination "
"lock.  This one isn't actually locked, just closed."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "safe"
msgid ""
"A small, heavy, and near-unbreachable metal box with a rotary combination "
"lock.  With something to listen really closely and a hell of a lot of time, "
"you might be able to crack it."
msgstr ""
"Małe, ciężkie i prawie niemożliwe do włamania się metalowe pudełko z "
"obrotowym zamkiem szyfrowym. Mając coś do uważnego słuchania i cholernie dużo "
"czasu, możliwe, że uda ci się to złamać."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_habitat.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Furniture name
msgid "open safe"
msgstr "otwarty sejf"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open safe"
msgid ""
"A small, heavy, and near-unbreachable metal box with a rotary combination "
"lock, albeit significantly less secure with the door open."
msgstr ""
"Małe, ciężkie i prawie niemożliwe do włamania się metalowe pudełko z "
"obrotowym zamkiem szyfrowym, choć znacznie mniej bezpieczne z otwartymi "
"drzwiami."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers/generic.json
#. ~ Furniture name
#. ~ Item name
msgid "trash can"
msgid_plural "trash cans"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "trash can"
msgid ""
"A plastic bin for storing discarded waste as to be disposed of later.  "
"Although, considering the circumstances, it might be worth seeing what's "
"inside."
msgstr ""
"Plastikowy pojemnik do przechowywania wyrzuconych odpadów, które mają być "
"usunięte później. Chociaż, biorąc pod uwagę okoliczności, może warto "
"zobaczyć, co jest w środku."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "metal trash can"
msgstr "metalowy kosz na śmieci"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "metal trash can"
msgid "A crude metal bin typically used to dispose of waste."
msgstr "Prosty metalowy pojemnik używany zazwyczaj do wyrzucania odpadów."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "wardrobe"
msgstr "szafa"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "wardrobe"
msgid ""
"A very large wooden cabinet for storing clothes, effectively an upright "
"closet.  Could technically be used to store anything else that would fit, "
"though."
msgstr ""
"Bardzo duża drewniana szafa do przechowywania ubrań, w zasadzie szafa "
"stojąca. Może być używana do przechowywania czegokolwiek innego, co się do "
"niej zmieści."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "Torah Ark"
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "Torah Ark"
msgid ""
"An ornately-carved cabinet designed to hold a Torah scroll.  This one is "
"decorated with a tree motif, referencing Proverbs 3:18."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "filing cabinet"
msgstr "szafka na dokumenty"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "filing cabinet"
msgid ""
"A rack of metal drawers designed to hold various files and paperwork.  "
"Paperwork that has more than likely lost all relevance and value by now."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "utility shelf"
msgstr "półka na narzędzia"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "utility shelf"
msgid ""
"A simple heavy-duty plastic and metal shelving unit, intended to store tools "
"and materials for easy access to workers."
msgstr ""
"Prosty, wytrzymały regał z tworzywa sztucznego i metalu, przeznaczony do "
"przechowywania narzędzi i materiałów w celu zapewnienia pracownikom łatwego "
"dostępu."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "warehouse shelf"
msgstr "szafka magazynowa"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "warehouse shelf"
msgid "A huge, sturdy steel shelf for storing pallets of crates in warehouses."
msgstr ""
"Ogromny, solidny regał stalowy do przechowywania skrzyń na paletach w "
"magazynach."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "wooden keg"
msgstr "drewniany keg"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "wooden keg"
msgid ""
"A large standing wooden barrel, completely watertight.  Good for storing "
"liquids of all kinds."
msgstr ""
"Duża stojąca drewniana beczka, całkowicie wodoszczelna. Odpowiednia do "
"przechowywania wszelkiego rodzaju płynów."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "display case"
msgstr "gablotka"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "display case"
msgid ""
"A secure wooden case at about waist-height, with glass paneling on top.  "
"Useful for storing valuable things while still showing them off.  Not "
"actually as secure as it looks, as the display windows are easily broken."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "display case"
msgid "With a satisfying click, the lock and the display case opens."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open display case"
msgstr "otwarta gablota"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open display case"
msgid ""
"A secure wooden case at about waist-height, with glass paneling on top.  "
"Useful for storing valuable things while still showing them off.  Not "
"actually as secure as it looks, as the display windows are easily broken.  "
"This one has had its lock picked and is open."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Aftershock/maps/furniture_and_terrain/furniture_habitat.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
#. ~ Furniture name
msgid "broken display case"
msgstr "rozbita gablotka"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "broken display case"
msgid ""
"A secure wooden case at about waist-height, with glass paneling on top.  "
"Would be useful for storing valuable things while still showing them off, if "
"the glass hadn't been shattered.  Careful not to cut yourself when looting."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "map board"
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "map board"
msgid "A secure metal board with a locked glass panel used to display a map."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "map board"
msgid "With a satisfying click, the locked glass panel opens."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open map board"
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open map board"
msgid ""
"A successfully picked metal board with an open glass panel used to display a "
"map."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "broken map board"
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "broken map board"
msgid "A metal board with a smashed glass panel used to display a map."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "fireman's cabinet"
msgstr "szafka strażacka"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "fireman's cabinet"
msgid ""
"A metallic cabinet painted to stand out, visibly holding tools behind a thin "
"panel of tempered glass."
msgstr ""
"Metalowa szafka lakierowana by się wyróżniać, wyraźnie widać, że przechowuje "
"narzędzia za cienką taflą hartowanego szkła."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Lockpick message of furniture "fireman's cabinet"
msgid "With a satisfying click, the lock on the cabinet opens."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "unlocked fireman's cabinet"
msgstr "odblokowana szafka strażaka"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "unlocked fireman's cabinet"
msgid ""
"A metallic cabinet painted to stand out.  Its glass panel door was left "
"unlocked and slightly ajar."
msgstr ""
"Metalowa szafka pomalowana by się wyróżniać. Jej szklane, panelowe drzwiczki "
"są odryglowane i niedomknięte."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open fireman's cabinet"
msgstr "otwarta szafka strażacka"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open fireman's cabinet"
msgid ""
"A metallic cabinet painted to stand out.  Its protective glass panel lies "
"broken from some past emergency or looting attempt."
msgstr ""
"Metalowa szafka pomalowana, by się wyróżniać. Jej szklany panel ochronny leży "
"rozbity w wyniku jakiegoś dawnego wypadku lub grabieży."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "standing tank"
msgstr "pionowy zbiornik"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "standing tank"
msgid "A huge metal tank that can be used to safely store large amounts of liquid."
msgstr ""
"Ogromny metalowy zbiornik, który może być użyty do bezpiecznego "
"przechowywania dużej ilości płynu."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "bulk storage tank"
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "bulk storage tank"
msgid ""
"A 2 meters high tank that can store up to 1500 liters of liquid.  That's a "
"lot."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "fuel tank"
msgstr "zbiornik paliwa"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "fuel tank"
msgid "A tank filled with gasoline."
msgstr "Zbiornik wypełniony benzyną."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "broken fuel tank"
msgstr "zepsuty zbiornik paliwa"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "broken fuel tank"
msgid "A broken tank which was filled with gasoline."
msgstr "Zepsuty zbiornik, który był wypełniony benzyną."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "fuel tank"
msgid "A tank filled with diesel."
msgstr "Zbiornik wypełniony olejem napędowym."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "broken fuel tank"
msgid "A broken tank which was filled with diesel."
msgstr "Zepsuty zbiornik paliwa, który był wypełniony olejem napędowym."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "dumpster"
msgstr "pojemnik na śmieci"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "dumpster"
msgid ""
"A large metal dumpster that will likely not be getting picked up by the "
"city's waste management any time soon.  Despite the unpleasant nature of "
"climbing inside, it could make for a viable hiding spot."
msgstr ""
"Duży metalowy śmietnik, który prawdopodobnie nie zostanie w najbliższym "
"czasie odebrany przez miejską firmę zajmującą się gospodarką odpadami. "
"Pomimo, że wspinanie się do środka nie należy do najprzyjemniejszych, może to "
"być dobra kryjówka."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "butter churn"
msgstr "ubijak do masła"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "butter churn"
msgid ""
"A metal tube with a built-in mixer for making butter.  Rather than needing "
"electricity, it is pedal-driven, allowing use without power."
msgstr ""
"Metalowa tuba z wbudowanym mikserem do robienia masła. Nie wymaga zasilania "
"elektrycznego, lecz jest napędzana pedałami, co pozwala na używanie jej bez "
"zasilania."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "riveted metal crate"
msgstr "nitowana metalowa skrzynia"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "riveted metal crate"
msgid ""
"This huge box is made of a dull metal, riveted together.  There is no obvious "
"opening mechanism, and the rivets don't match any of your tools.  The only "
"way in would be to smash it."
msgstr ""
"Ta ogromna skrzynia wykonana jest z matowego metalu, połączonego nitami. Nie "
"ma żadnego oczywistego mechanizmu otwierania, a nity nie pasują do żadnego z "
"twoich narzędzi. Jedynym sposobem dostania się do środka jest rozbicie jej."

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "sealed metal crate"
msgstr "zalakowana metalowa skrzynia"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "sealed metal crate"
msgid ""
"A huge, tightly sealed storage crate made from welded and riveted sheet "
"metal.  The sealing mechanism is too tight to open bare-handed and would need "
"some kind of prying instrument to release."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying action message of furniture "sealed metal crate"
msgid "You wrench open the metal crate."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Prying failure message of furniture "sealed metal crate"
msgid "The lid is sealed more tightly than you thought."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "open metal crate"
msgstr "otwarta metalowa skrzynia"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "open metal crate"
msgid ""
"This large metal crate's lid is unsealed, and hinges open easily to reveal a "
"number of storage shelves inside.  Once open, the side panels also swing "
"wider for easy access."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "wooden chest"
msgstr "drewniana skrzynia"

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "wooden chest"
msgid ""
"A sealed wooden storage container.  Lacking any labels, it could hold just "
"about anything inside.  It has a simple metal latch."
msgstr ""
"Szczelnie zamknięty drewniany pojemnik do przechowywania. Brak mu "
"jakichkolwiek etykiet, więc w środku może znajdować się praktycznie wszystko. "
"Posiada prosty metalowy zatrzask."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/furniture/storage.json
#. ~ Furniture name
#. ~ Item name
msgid "steel foot locker"
msgid_plural "steel foot lockers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/furniture/storage.json
#. ~ Description of furniture "steel foot locker"
#. ~ Description of "steel foot locker"
msgid ""
"A steel storage box, capable of holding any number of things.  The lid has a "
"small lock."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/furniture/storage.json
#. ~ Furniture name
#. ~ Item name
msgid "aluminum foot locker"
msgid_plural "aluminum foot lockers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/furniture/storage.json
#. ~ Description of furniture "aluminum foot locker"
#. ~ Description of "aluminum foot locker"
msgid ""
"An aluminum storage box, capable of holding any number of things.  The lid "
"has a small lock."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers/military.json
#. ~ Furniture name
#. ~ Item name
msgid "big collapsible drum"
msgid_plural "big collapsible drums"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "big collapsible drum"
msgid ""
"A black collapsible drum with a valve and D-Rings.  Yellow text on its top "
"clearly says \"FLAMMABLE\"."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "packed pallet"
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "packed pallet"
msgid ""
"A wooden pallet loaded with cargo, wrapped with a watertight cover, and "
"belted to secure the contents."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Bashing sound
msgid "rip!"
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Furniture name
msgid "damaged pallet"
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "damaged pallet"
msgid ""
"A wooden pallet, containing cargo and possessing a torn cover.  You can reach "
"the contents, but it's awfully hard due to the belts still being in place."
msgstr ""

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/tool/workshop.json
#. ~ Furniture name
#. ~ Item name
msgid "Exodii kiln"
msgid_plural "Exodii kilns"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/json/furniture_and_terrain/furniture-storage.json
#. ~ Description of furniture "Exodii kiln"
msgid "An imposing kiln produced by the Exodii, used to produce their ceramic armor"
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "counter"
msgstr "lada"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "counter"
msgid ""
"A plain wooden countertop, either free-standing or affixed to a wall.  Makes "
"a decent surface for storage or crafting."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "cupboard"
msgstr "kredens"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "cupboard"
msgid "Store your cups.  Or other things, if you're feeling wild."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "closed counter gate"
msgstr "zamknięte drzwi za ladę"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "closed counter gate"
msgid ""
"A commercial-quality swinging door made of wood that allows passage behind "
"counters.  It's currently closed."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "open counter gate"
msgstr "otwarte drzwi za ladę"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "open counter gate"
msgid ""
"A commercial-quality swinging door made of wood that allows passage behind "
"counters.  It's open, allowing passage."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "desk"
msgstr "biurko"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "desk"
msgid ""
"A wooden desk with drawers.  You could decorate it with trinkets, eat a meal "
"off it, use it as a workbench, read a book, write in a journal, put a laptop "
"on it, put your feet up, rest your head for a nap if you're sitting down… who "
"knew desks were so useful?"
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/vehicleparts/vehicle_parts.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "workbench"
msgstr "stół warsztatowy"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "workbench"
msgid ""
"A sturdy workbench built out of metal.  It is perfect for crafting large and "
"heavy things."
msgstr ""
"Solidny stół warsztatowy zbudowany z metalu. Jest idealny do tworzenia dużych "
"i ciężkich przedmiotów."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "leather tarp"
msgid_plural "leather tarps"
msgstr[0] "skórzana płachta"
msgstr[1] "skórzane płachty"
msgstr[2] "skórzanych płacht"
msgstr[3] "skórzanej płachty"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "leather tarp"
msgid ""
"A large sheet of leather lying on the ground.  You could use it as a picnic "
"blanket, but it's more valuable as a surface for butchering as it does not "
"soak up blood."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Furniture name
msgid "plastic groundsheet"
msgstr "plastikowa płachta"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "plastic groundsheet"
msgid ""
"A large sheet of thick plastic lying on the ground.  It could be a useful "
"surface for butchering, perhaps."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Bashing sound
msgid "whuff!"
msgstr "łuff!"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Bashing failed sound
msgid "crinkle."
msgstr "fałd."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "fiber mat"
msgid_plural "fiber mats"
msgstr[0] "pleciona mata"
msgstr[1] "plecione maty"
msgstr[2] "plecionych mat"
msgstr[3] "plecionej maty"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "fiber mat"
msgid ""
"A large mat woven from fibrous material.  You could use it as a picnic "
"blanket, but it's more valuable as a surface for butchering.  Too thin to be "
"used as a comfortable sleeping mat."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
#. ~ Furniture name
#. ~ Item name
msgid "folding table"
msgid_plural "folding tables"
msgstr[0] "składany stół"
msgstr[1] "składane stoły"
msgstr[2] "składanych stołów"
msgstr[3] "składanego stołu"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "folding table"
msgid ""
"A small metal folding table, ideal for off-road trips.  Can be used as a "
"workbench in a pinch."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/vehicleparts/vehicle_parts.json
#. ~ Furniture name
#. ~ Vehicle part name
msgid "table"
msgstr "stół"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "table"
msgid ""
"A standard wooden table.  You could sit down at it to eat like a civilized "
"person."
msgstr ""

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/vehicle/tables.json
#. ~ Furniture name
#. ~ Item name
msgid "fancy table"
msgid_plural "fancy tables"
msgstr[0] "wymyślny stolik"
msgstr[1] "wymyślne stoliki"
msgstr[2] "wymyślnych stolików"
msgstr[3] "wymyślnego stoliku"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#. ~ Description of furniture "fancy table"
msgid ""
"A fancy table for a fancy person.  Functions as both a table and status "
"symbol."
msgstr ""

