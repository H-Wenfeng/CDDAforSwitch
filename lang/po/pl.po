msgid "Maintain pixel minimap aspect ratio"
msgstr "Zachowaj proporcje pikselowej minimapy"

#: src/options.cpp:2604
msgid "If true, preserves the square shape of tiles shown on the pixel minimap."
msgstr ""
"Jeśli prawda, zachowuje kwadratowy kształt kwadratów pokazywanych na "
"pikselowej minimapie."

