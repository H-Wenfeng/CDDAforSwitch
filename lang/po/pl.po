msgstr[1] "kamienne golemy"
msgstr[2] "kamiennych golemów"
msgstr[3] "kamiennego golema"

#: data/mods/Magiclysm/monsters/golems.json
#. ~ Description of monster "stone golem"
msgid "A large, humanoid golem made from stone.  Its fists look similar to rockets."
msgstr ""
"Duży, humanoidalny golem wykonany z kamienia. Jego pięści przypominają "
"rakiety."

#: data/mods/Magiclysm/monsters/golems.json
