msgid "The %s looks for something but doesn't seem to find it."
msgstr "%s szuka czegoś, ale nie może tego znaleźć."

#: src/monattack.cpp:2620
msgid ""
"a soft robotic voice say, \"Unhand this patient immediately!  If you keep "
"interfering with the procedure I'll be forced to call law enforcement.\""
msgstr ""
"delikatny robotyczny głos mówi, „Natychmiast uwolnij tego pacjenta! Jeśli "
"nadal będziesz ingerować w zabieg, będę zmuszony wezwać organy ścigania”."

#: src/monattack.cpp:2626
msgid ""
"a soft robotic voice say, \"Greetings kinbot.  Please take good care of this "
"patient.\""
msgstr ""
"delikatny robotyczny głos mówi, „Witaj kinbocie. Dobrze opiekuj się tym "
"pacjentem”."

#: src/monattack.cpp:2664
#, c-format
msgid ""
"The %s dumps the contents of its bag on the ground and drops the bag on top "
