msgid ""
"This is a cartoony pen drawing of a pigtailed woman in a dirndl, smiling a "
"gaptoothed grin while playing an accordion.  Underneath are the words 'LIXA "
"PLAYS THE CLASSICS!!!'"
msgstr ""

#: data/json/snippets/LIXA_snippets.json
#. ~ Name of a snippet in category "LIXA_lab_notes"
