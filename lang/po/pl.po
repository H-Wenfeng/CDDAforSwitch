#. start of mission "Finish your mission"
#. ~ Name of the monster "afs_mon_reaver" placed on map update on start of
#. mission "The bounty is on Salus IV"
msgid "The Guard"
msgstr "Strażnik"

#: data/json/starting_missions.json
#: data/mods/aftershock_exoplanet/missions/bounty_hunter_missions.json
