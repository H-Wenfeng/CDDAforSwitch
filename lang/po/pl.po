msgid "It <color_green>seems perfectly safe</color> to climb down like this."
msgstr "Zejście w ten sposób <color_pink>wygląda na całkowicie bezpieczne</color>."

#: src/game.cpp:14058
msgid "It <color_green>seems safe</color> to climb down like this."
msgstr "Zejście w ten sposób <color_green>wydaje się bezpieczne</color>."

#: src/game.cpp:14060
msgid "It <color_yellow>seems a bit tricky</color> to climb down like this."
msgstr "Zejście w ten sposób <color_yellow>wydaje się nieco trudne</color>."

#: src/game.cpp:14062
msgid "It <color_yellow>seems somewhat risky</color> to climb down like this."
msgstr "Zejście w ten sposób <color_yellow>wydaje się nieco ryzykowne</color>."

#: src/game.cpp:14064
msgid "It <color_red>seems very risky</color> to climb down like this."
msgstr "Zejście w ten sposób <color_red>wydaje się bardzo ryzykowne</color>."

