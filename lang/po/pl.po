msgstr[3] ""

#: data/mods/Aftershock/items/comestibles/alienfood.json
#: data/mods/aftershock_exoplanet/items/comestibles/alienfood.json
#. ~ Description of "raw alien sweetbread"
msgid "You got this chunk of meat from the throat of the animal; it looks different?"
msgstr "Zdobyłeś ten kawałek mięsa z gardła zwierzęcia; wygląda inaczej?"

#: data/mods/Aftershock/items/comestibles/alienfood.json
#: data/mods/aftershock_exoplanet/items/comestibles/alienfood.json
#. ~ Item name
msgid "cooked alien sweetbread"
