#: src/activity_actor.cpp:4427
msgid ""
"Light exercise comparable in intensity to walking, but more focused and "
"methodical."
msgstr ""
"Lekkie ćwiczenia porównywalne pod względem intensywności do chodzenia, ale "
"bardziej skoncentrowane i metodyczne."

