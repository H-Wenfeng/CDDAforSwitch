msgstr[1] "lobotomizery"
msgstr[2] "lobotomizerów"
msgstr[3] "lobotomizera"

#: data/mods/No_Hope/items.json
#. ~ Description of "lobotomizer"
msgid ""
"A hand-forged collapsible tool with two axe heads and a sharp shovel-like tip "
"on one end.  It can be used as a shovel, or you could chop some zombies with "
"it instead."
msgstr ""

#: data/mods/No_Hope/items.json
#. ~ Item name
msgid "vault leaflet"
msgid_plural "vault leaflets"
msgstr[0] "ulotka ze schronu"
msgstr[1] "ulotki ze schronu"
msgstr[2] "ulotek ze schronu"
msgstr[3] "ulotki ze schronu"

#: data/mods/No_Hope/items.json
#. ~ Description of "vault leaflet"
msgid ""
"A folded glossy handout that appears to be an introduction to living in a "
"massive underground complex."
msgstr ""
"Składana błyszcząca ulotka która wygląda na prezentację życia w masywnym "
"podziemnym kompleksie."

#: data/mods/No_Hope/items.json
#. ~ Item name
msgid "frequency list"
msgid_plural "frequency lists"
msgstr[0] "lista obecności"
msgstr[1] "listy obecności"
msgstr[2] "list obecności"
msgstr[3] "listy obecności"

#: data/mods/No_Hope/items.json
