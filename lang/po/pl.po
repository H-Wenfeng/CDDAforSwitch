msgstr "Jestem członkiem Wspólnoty Kościoła Nowej Anglii."

#: data/json/npcs/godco/classes.json
#. ~ Name of an NPC class
msgid "Joinee"
msgstr "Dołączony"

#: data/json/npcs/godco/classes.json
#. ~ Name of an NPC class
