#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
msgid "VR rig - holosuite deployed"
msgid_plural "VR rigs - holosuite deployed"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ "msg" action message of item "VR rig - holosuite deployed"
msgid "You power down the virtual overlay."
msgstr "Wyłączasz wirtualną nakładkę."

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Item name
msgid "folded nanotech forge"
msgid_plural "folded nanotech forges"
msgstr[0] "złożona nanotechniczna kuźnia"
msgstr[1] "złożone nanotechniczne kuźnie"
msgstr[2] "złożonych nanotechnicznych kuźni"
msgstr[3] "złożonej nanotechnicznej kuźni"

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
#. ~ Description of "folded nanotech forge"
msgid ""
"Matrioshka Fabritechnics created this portable nanotech forge for when "
"expeditions are setting up a basecamp far from population centers.  Once "
"deployed it can be used to craft ultratech marvels that otherwise are too "
"minute for human crafting."
msgstr ""
"Matrioszka Fabritechnika stworzyła tę przenośną kuźnię nanotechniczną na "
"potrzeby ekspedycji zakładających obóz z dala od skupisk ludności. Po "
"uruchomieniu może być używana do tworzenia ultra-technicznych cudów, które w "
"innym przypadku są zbyt małe dla człowieka."

#: data/mods/Aftershock/items/tools.json
#: data/mods/aftershock_exoplanet/items/tools.json
