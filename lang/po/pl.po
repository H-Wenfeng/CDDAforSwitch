msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_eocs.json
#. ~ Player message in false effect in EoC "EOC_SYLPH_WIND_TRANSLOCATE_CHECK"
msgid ""
"You must be outdoors and in a strong wind or high above the earth to "
"translocate."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_eocs.json
#. ~ Player message in false effect in EoC "EOC_SYLPH_WIND_ATTUNEMENT_CHECK"
msgid "You must be outdoors and high above the earth to cast this spell."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_eocs.json
#. ~ Player message in false effect in EoC "EOC_SYLPH_GOBLIN_FRUIT"
msgid ""
"You must have a strong enough wind or be above ground level to call forth a "
"goblin fruit."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Name of spell "zap_electrical_emission"
msgid "Zap"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "zap_electrical_emission ( Zap )"
msgid "Electricity emits from your extremities."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Message of spell "zap_electrical_emission ( Zap )"
#. ~ Message of spell "electrical_field ( Electrical Field )"
#. ~ Message of spell "lightning_field ( Lightning Field )"
msgid "tsszappp!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_call_lightning ( Lightning Bolt )"
msgid ""
"The goto ability for many Sylphs, this does just what you expect: you shoot "
"lightning from your fingertips.  However, this lightning is more directed "
"than most lightning, and travels in a line through most non-solid targets."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Name of spell "sylph_crash_of_lightning"
msgid "Crash of lightning"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_crash_of_lightning ( Crash of lightning )"
msgid ""
"The crash of lightning strikes your foes with a blast of electricity and a "
"physical force that knocks them prone."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "clap_of_thunder"
#. ~ Mutation name
msgid "Clap of Thunder"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "clap_of_thunder ( Clap of Thunder )"
msgid "A thunder clap at a distance."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "electrical_field"
#. ~ Mutation name
msgid "Electrical Field"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "electrical_field ( Electrical Field )"
msgid "Summons a field of electricity."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Sound description of spell "electrical_field ( Electrical Field )"
msgid "zzzpptttt!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Name of spell "lightning_field"
msgid "Lightning Field"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "lightning_field ( Lightning Field )"
msgid "Summons a field of lightning."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Sound description of spell "lightning_field ( Lightning Field )"
msgid "cracklezzbit!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "sylph_reveal_overmap_spell"
#. ~ Mutation name
msgid "Like a Bird on the Wing"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_reveal_overmap_spell ( Like a Bird on the
#. Wing )"
msgid ""
"Concentrating for a moment, you can hurl your senses into the air, seeing the "
"landscape spread out before you.  This spell only works outdoors."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "sylph_charge_dash_spell"
#. ~ Mutation name
msgid "Stormwind Stride"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_charge_dash_spell ( Stormwind Stride )"
msgid "Charge forward like a sudden gust of wind."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_increase_ally_speed_spell ( Favonian
#. Murmuration )"
msgid ""
"With a burst of fae magick, you infuse the speed of the west wind into one of "
"your allies, allowing them to move much more quickly for a time."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_bonus_melee_range_spell ( Breeze-Cutting
#. Blows )"
msgid ""
"The Sylph strikes through the air so precisely that the air itself is cut and "
"carries their force outward.  While the spell is in effect, the Sylph can "
"make melee strikes and affect distant targets."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_cultivate_goblin_fruit ( Cultivate Goblin
#. Fruit )"
msgid ""
"You may spin a bit of fae magic into the winds, bringing forth a goblin "
"fruit.  Goblin fruit have a variety of effects, never predictable but always "
"at least somewhat beneficial.  This spell may only be cast outdoors in "
"natural surroundings."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "summon_air_sprite"
#. ~ Mutation name
msgid "Call the Children of the Winds"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "summon_air_sprite ( Call the Children of the Winds
#. )"
msgid "A lesser air elemental is summoned to support you."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "ominous_wind"
#. ~ Mutation name
msgid "Ominous Wind"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "ominous_wind ( Ominous Wind )"
msgid ""
"A whistling wind gusts past your shoulder in the direction you've pointed.  "
"It creates a fearful effect in your foes."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "pushing_wind"
#. ~ Mutation name
msgid "Pushing Wind"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "pushing_wind ( Pushing Wind )"
msgid "Shove something away with a burst of elemental air."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Message of spell "pushing_wind ( Pushing Wind )"
msgid "You hurl your target away."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "sylph_clear_the_air"
#. ~ Mutation name
msgid "Purifying the Air"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_clear_the_air ( Purifying the Air )"
msgid ""
"Reassert the purity of the air around yourself, removing contaminants such as "
"smoke or pollen."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Message of spell "sylph_clear_the_air ( Purifying the Air )"
msgid "The air begins to smell sweet."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_hindering_wind_spell ( Hindering Winds )"
msgid ""
"Surround a target with a blanket of buffeting winds, slowing them and "
"hindering their freedom of movement."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "sylph_massive_lightning_bolt_spell"
#. ~ Mutation name
msgid "Fist of Heaven's Fury"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_massive_lightning_bolt_spell ( Fist of
#. Heaven's Fury )"
msgid ""
"Call down a thundering lightning bolt to blast your enemies with the fury of "
"the heavens."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Message of spell "sylph_massive_lightning_bolt_spell ( Fist of Heaven's
#. Fury )"
msgid "Lightning crashes down from the heavens!"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Name of spell "sylph_wind_translocation_spell"
#. ~ Mutation name
msgid "Going Wither the Wind May Lead"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_wind_translocation_spell ( Going Wither the
#. Wind May Lead )"
msgid ""
"The wind blows where it will, through fences and open windows, across fields "
"and over rivers  The Sylph can blow with it, traveling high above the earth "
"and alighting on a location they have previously been."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Name of spell "sylph_wind_translocation_attune"
msgid "Going Wither the Wind May Lead Attunement"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutation_spells.json
#. ~ Description of spell "sylph_wind_translocation_attune ( Going Wither the
#. Wind May Lead Attunement )"
msgid ""
"Attune to a location for later traveling.  You must attune high above the "
"earth and outdoors."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Sylph Skin"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Sylph Skin"
msgid ""
"Your skin has turned the rolling grey of the clouds.  Your skin is now an "
"ever-shifting color of clouds shifting from stormy to rainy to barely there.  "
"This has no gameplay effects."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Cloud Skin"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Storm Skin"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Breathe Without Air"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Breathe Without Air"
msgid ""
"Upon gaining this ability the Sylph gains the ability to breathe without "
"oxygen.  This will prevent damage from a lack of oxygen."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Sylph Eyes"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Sylph Eyes"
msgid ""
"Upon gaining this ability the Sylph's eyes begin reflecting their mood with "
"lightning and storms when angry and clear skies when happy.  Glare no longer "
"impacts them."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Sylph Ears"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Sylph Ears"
msgid ""
"The Sylph's ears are longer and pointed, like a wisp of cloud trailing across "
"the sky.  They can hear better and no matter how loud the thunder, their ears "
"will not ring from it."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Voice of Thunder"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Voice of Thunder"
msgid ""
"The Sylph can make their voice boom like a peal of thunder, shouting so "
"loudly that they can be heard from hundreds of yards away."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Clap of Thunder"
msgid ""
"Upon gaining this ability the Sylph gains the ability to create a loud clap "
"of thunder noise at a distance."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Ominous Wind"
msgid ""
"Upon gaining this ability the Sylph gains the ability to summon and ominous "
"wind that damages sapient creatures morale."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Stormwind Stride"
msgid ""
"Upon gaining this ability the Sylph gains the ability to rush forward in a "
"burst of wind."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Favonian Murmuration"
msgid ""
"Upon gaining this ability the Sylph gains the ability increase the speed of "
"one of their allies."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Like a Bird on the Wing"
msgid ""
"Upon gaining this ability the Sylph gains the ability to see surrounding "
"terrain as though standing on high."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Breeze-Cutting Blows"
msgid ""
"Upon gaining this ability the Sylph gains the ability to strike so precisely "
"that the air will carry their melee attacks a short distance."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Slow Fall"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Slow Fall"
msgid ""
"Upon gaining this ability the Sylph ceases to fall at speeds that would "
"damage themselves, no matter how high the fall is."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Carried on the Breeze"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Carried on the Breeze"
msgid ""
"Upon gaining this ability the Sylph can direct their falls, moving "
"horizontally in a gust of wind if they step off a ledge and landing safely on "
"the ground."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Updraft Leap"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Updraft Leap"
msgid ""
"Upon gaining this ability the Sylph can leap straight into the air, riding "
"the wind currents for a few seconds before descending to the earth."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Resist Cold"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Resist Cold"
#. ~ Description of mutation "Born of a Gale"
msgid "The Sylph gains a resistance to cold and cold based damage."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Born of a Gale"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Dancing On Winter Winds"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Dancing On Winter Winds"
msgid ""
"The sylph is nearly immune to mundane cold and heavily resistant to "
"cold-based damage."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Wind-Carried Weapons"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Wind-Carried Weapons"
msgid ""
"The winds surge around the Sylph as they attack, guiding their projectiles to "
"the target.  The range of the Sylph's weapons is increased."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Winds Guide Me"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Winds Guide Me"
#, no-c-format
msgid "When outdoors, the Sylph moves 10% faster."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Outrunning the Gale"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Outrunning the Gale"
#, no-c-format
msgid "When outdoors, the Sylph moves 10% faster and has +10% increased speed."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Gusting Evasion"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Gusting Evasion"
msgid ""
"The Sylph slips away from attacks as easily as the wind finds its way through "
"cracks in a wall.  They gain +1 bonus dodge attempt per turn (+2 if they have "
"the Sylph trait)."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Cultivate Goblin Fruit"
msgid ""
"Upon gaining this ability the Sylph gains the ability to grow a goblin fruit "
"when outdoors and the wind is blowing strongly."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Pushing Wind"
msgid "The Sylph learns how to use the wind to push their opponents."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Hindering Winds"
msgid ""
"The Sylph learns how to surround a single target with buffeting winds, "
"slowing their movements and knocking them off-balance."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Purifying the Air"
msgid ""
"The Sylph can remove contaminants from the air such as smoke or pollen and "
"leave only pure air behind."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Electrical Emissions"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Electrical Emissions"
msgid ""
"Sylphs often develop electrical emissions that can culminate in lightning "
"bolts."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Electrical Field"
msgid ""
"Upon gaining this ability the Sylph gains the ability to summon electrical "
"fields."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Fist of Heaven's Fury"
msgid ""
"Upon gaining this ability the Sylph gains the ability to call down the "
"thunderstorm's judgement on a location while outdoors."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Call the Children of the Winds"
msgid "Upon gaining this ability the Sylph gains the ability to summon an air sprite."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Fulgurating Strikes"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Fulgurating Strikes"
msgid ""
"At will, the Sylph may cause their attacks to carry a charge, whose power "
"grows with their mastery of lightning.  Each attack costs mana while this "
"trait is active."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Spring Breeze Stride"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Spring Breeze Stride"
msgid "The Sylph's moves like the wind.  +2 Dexterity."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Storm-Runner's Speed"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Storm-Runner's Speed"
msgid "The Sylph's moves like a sudden burst of wind.  +5 Dexterity."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Ice-Clear Thoughts"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Ice-Clear Thoughts"
msgid "The Sylph's mind has the clarity of pure frozen water.  +2 Intelligence."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Lightning Mind"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Lightning Mind"
msgid "The Sylph's thoughts move as quickly as a bolt of lightning.  +4 Intelligence."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Eagle's Sight"
msgid ""
"Like a bird soaring on the wind, the Sylph's keen eyes take in their "
"surroundings.  +3 Perception."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Zephyr Chant"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Zephyr Chant"
#, no-c-format
msgid ""
"Like the blowing winds, the Sylph's mana races from of their body at their "
"command.  -20% spell casting speed when outdoors."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Whistling Zephyr Chant"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Whistling Zephyr Chant"
#, no-c-format
msgid ""
"The wind finds it way through any crack, and so does the Sylph's mana come to "
"their call regardless of what movements they make.  -20% spell casting speed "
"when outdoors and the Sylph no longer needs to gesture to use their magick."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Surmounting the Clouds"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Surmounting the Clouds"
msgid ""
"Born of the winds, the Sylph can walk on them as easily as the ground.  While "
"this trait is active, the Sylph will not fall and may walk on the air as they "
"like.  It requires 3 mana per turn to fuel their steps."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Going Wither the Wind May Lead"
msgid ""
"Upon gaining this ability the Sylph gains the ability to travel along the "
"blowing winds to another location they have previously been to."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Body of Cloud"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Body of Cloud"
msgid ""
"The Sylph may transform into misty cloud.  They will be insubstantial and "
"unable to interact with the environment, but also able to move incredibly "
"quickly and attacks will simply pass through them.  Each second in the cloud "
"form will cost 10 mana."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Body of Cloud Appearance"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Body of Cloud Appearance"
msgid ""
"This mutation carries the sprite override info for Body of Cloud.  You "
"shouldn't be able to see it in game."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "As Free as the Wind"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "As Free as the Wind"
msgid ""
"Like the wind, the Sylph goes where they will with no one to stop them.  They "
"are immune to anything that would restrict their movement, such as grabs, "
"terrain costs, or slippery terrain."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Mutation name
msgid "Winds Always At My Back"
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_mutations.json
#. ~ Description of mutation "Winds Always At My Back"
msgid ""
"The winds surround the Sylph and carry them along regardless of their "
"physical condition.  They suffer no penalties to dexterity or speed due to "
"pain."
msgstr ""

#: data/mods/Xedra_Evolved/mutations/paraclesians/sylph_spell_learning_eocs.json
#. ~ Player message in effect in EoC "EOC_LEVELER_SYLPH_CLAP_OF_THUNDER"
#. ~ Player message in effect in EoC "EOC_LEVELER_SYLPH_OMINOUS_WIND"
#. ~ Player message in effect in EoC "EOC_LEVELER_SYLPH_PUSHING_WIND"
