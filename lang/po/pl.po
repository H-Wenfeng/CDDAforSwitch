#: data/mods/alt_map_key/overmap_terrain_light_green.json
#. ~ Terrain name
#. ~ Overmap terrain vision level name
#. ~ Overmap terrain name
msgid "open air"
msgstr "otwarte powietrze"

#: data/json/furniture_and_terrain/terrain-floors-indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#. ~ Description of terrain "open air"
msgid "An area of open air."
msgstr ""

#: data/json/furniture_and_terrain/special_use/isherwood_spawnpoints.json
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/furniture_and_terrain/terrain_vitrified.json
#. ~ Description of terrain "dirt"
msgid ""
"It's dirt.  Looks like some fine soil for tillage.  Could also be dug out for "
"construction projects."
msgstr ""
"To ziemia. Wygląda na zdatną do orki. Może też być wykopana w celach "
"budowlanych."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/Xedra_Evolved/furniture_and_terrain/furniture-plants.json
#. ~ Terrain name
#. ~ Furniture name
msgid "forest floor"
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "forest floor"
msgid "Covered in twigs and lots of brown, decaying leaves."
msgstr "Pokryty gałązkami i mnóstwem brązowych, rozkładających się liści."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "mound of sand"
msgid "A mound of sand."
msgstr "To kopiec piasku."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "glassed sand"
msgstr "zeszklony piasek"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "glassed sand"
msgid ""
"A patch of sand with a crust of natural glass atop it from exposure to "
"intense heat."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/furniture_and_terrain/terrain_vitrified.json
#. ~ Bashing sound
msgid "crunch"
msgstr "chrzęst"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "upturned dirt"
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "upturned dirt"
msgid ""
"An area of loose dirt, not easily traversable.  If examined more closely, "
"it's quite favorable for planting seeds and the like."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "mound of upturned dirt"
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "mound of upturned dirt"
msgid "A giant hill of dirt that looks like you could crawl inside for shelter."
msgstr "Wielka góra ziemi, która wygląda jakbyś mógł się pod nią wczołgać dla ochrony."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "odd fault"
msgstr "dziwny uskok"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "odd fault"
msgid ""
"An unnaturally humanoid-shaped hole, it seems oddly familiar.  You feel a "
"strange urge to examine it closer, as if it belongs to you somehow."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Player message in effect in EoC "EOC_TERRAIN_FAULT" in terrain "odd
#. fault"'s examine action
msgid ""
"This wall is perfectly vertical.  Odd, twisted holes are set in it, leading "
"as far back into the solid rock as you can see.  The holes are humanoid in "
"shape, but with long, twisted, distended limbs."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "grave"
msgstr "grób"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "grave"
msgid ""
"A dirt grave, with some grass growing on it.  At least some of the dead do "
"actually rest in peace."
msgstr ""
"Ziemny grób, porośnięty trawą. Przynajmniej niektórzy zmarli faktycznie "
"spoczywają w spokoju."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "grave"
msgid ""
"A fresh grave, covered with stones, either to keep something from digging it "
"up or to keep one inside from digging out of it.  Or both.  Two planks mark "
"this place of someone's eternal rest."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "rock floor"
msgid ""
"A relatively flat area of rock and stone.  Looks stable enough to be mined "
"with the proper mining gear."
msgstr ""
"Relatywnie płaski obszar z kamienia i skał. Wygląda na tyle stabilnie, by móc "
"w nim drążyć z użyciem właściwego sprzętu górniczego."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "rubber mulch"
msgstr "gumowy mulcz"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "rubber mulch"
msgid ""
"A large area mulched with shredded rubber.  It's a softer place to land than "
"regular dirt."
msgstr ""
"Duży obszar mulczowany rozdrobnioną gumą. Jest to bardziej miękkie miejsce do "
"lądowania niż zwykła ziemia."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/json/overmap/vision_levels.json
#: data/mods/innawood/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
#. ~ Overmap terrain vision level name
msgid "pavement"
msgstr "bruk"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "pavement"
msgid ""
"A segment of asphalt, slowly degrading from cracks, frost heaves, and lack of "
"maintenance."
msgstr ""
"Fragment asfaltu, powoli degradującego się od pęknięć i odwarstwień "
"spowodowanych mrozem i brakiem utrzymania."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/innawood/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "yellow pavement"
msgstr "żółty bruk"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/innawood/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "yellow pavement"
msgid ""
"Streaks of carefully aligned yellow paint mark the road to inform drivers not "
"to cross.  No one is enforcing these rules anymore."
msgstr ""
"Pasma dokładnie ułożonych żółtych linii oznaczających drogę, informujących "
"kierowców by ich nie przekraczać. Nikt już obecnie nie egzekwuje tych "
"przepisów."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "pedestrian crossing"
msgstr "przejście dla pieszych"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "pedestrian crossing"
msgid ""
"White polymer lines painted on the pavement which indicate places where "
"pedestrians should cross the road."
msgstr ""
"Białe polimerowe linie namalowane na asfalcie oznaczają miejsce w którym "
"przechodnie powinni przechodzić przez ulicę."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "sidewalk"
msgid ""
"An area of common poured concrete, damaged by frost heaves and large cracks "
"due to lack of maintenance."
msgstr ""
"Nawierzchnia utwardzona betonową wylewką, uszkodzona spękaniami od mrozu i "
"dużymi wyszczerbieniami z braku konserwacji."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "concrete floor"
msgid "A bare and cold concrete floor."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#: data/mods/Aftershock/maps/furniture_and_terrain/terrain_habitat_floor.json
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_habitat_floor.json
#. ~ Description of terrain "reinforced concrete floor"
msgid ""
"An extremely resilient floor made from carefully placed rebar and poured "
"concrete, capable of providing protection from the elements.  As for the "
"matching roof, it still requires supporting walls, otherwise it may very well "
"cave in."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "concrete"
msgstr "beton"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "concrete"
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles."
msgstr ""
"Nowszy fragment betonowej wylewki utwardzającej powierzchnię, z wykończeniem "
"na potrzeby estetyki i odpornością na cykle zamarzania i topnienia."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "concrete"
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles.  Covered with a streak of yellow paint."
msgstr ""
"Nowszy fragment betonowej wylewki utwardzającej powierzchnię, z wykończeniem "
"na potrzeby estetyki i odpornością na cykle zamarzania i topnienia. Pokryty "
"paskiem żółtej farby."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "wooden floor"
msgstr "drewniana podłoga"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "wooden floor"
msgid ""
"A wooden floor created from boards, packed tightly together and nailed down.  "
"Common on patios."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "wooden floor gangway"
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "wooden floor gangway"
msgid ""
"A wooden gangway bridging a short gap.  Sturdy enough to act as a floor, but "
"not sufficient to support additional flooring."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "metal floor"
msgid ""
"High-quality and tough checkered metal flooring to reduce the risk of slips "
"and falls."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "metal floor gangway"
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "metal floor gangway"
msgid ""
"A metal gangway bridging a short gap.  Sturdy enough to act as a floor, but "
"not sufficient to support additional flooring."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "linoleum tile"
msgid ""
"A section of flooring made out of a tough, rubbery material.  Colored a "
"simple white."
msgstr ""
"Fragment podłogi wykonany z twardego, gumowatego materiału, zabarwionego na "
"prosty biały kolor."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "linoleum tile"
msgid "A section of flooring made out of a tough, gray, rubbery material."
msgstr "Fragment podłogi wykonany z twardego, szarego gumowatego materiału."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "dirt floor"
msgid "A floor consisting of finely mixed earth that has been tamped down."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "gelatinous ground"
msgstr "żelatynowe podłoże"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "gelatinous ground"
msgid ""
"An incursion of a large area of otherworldly substrate, it feels like walking "
"on hardened gelatin."
msgstr ""
"Szerokie wtargnięcie obcego podłoża, po którym stąpa się jak po stwardniałej "
"żelatynie."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "orifice"
msgstr "otwór"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "orifice"
msgid ""
"A large round orifice, with trails of fresh and dried-up strange green liquid "
"with a strongly acidic odor covering its inner sides."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "elevator"
msgid "An elevator section of the flight deck."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "deck coating"
msgstr "powłoka pokładu"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "deck coating"
msgid ""
"A thick metal hull coating, covered with a military-grade epoxy mix.  Used "
"for runways, and can't be melted by jet engine nozzles."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "yellow deck coating"
msgstr "żółta powłoka pokładu"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "yellow deck coating"
msgid ""
"A thick metal hull covering, covered with a military-grade epoxy mix and "
"painted yellow."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "red deck coating"
msgstr "czerwona powłoka pokładu"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "red deck coating"
msgid ""
"A thick metal hull covering, covered with a military-grade epoxy mix, and "
"painted red."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "white deck coating"
msgstr "biała powłoka pokładu"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "white deck coating"
msgid ""
"A thick metal hull covering, covered with a military-grade epoxy mix and "
"painted white."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "stone masonry floor"
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "stone masonry floor"
msgid "A floor of carefully cut and laid stones, joined with mortar."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "metal grate"
msgid ""
"A walkway that can be used as a protective covering over drains, or even as a "
"filter."
msgstr ""

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "red floor"
msgstr "czerwona podłoga"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "red floor"
msgid "A red section of flooring."
msgstr "Czerwony fragment podłogi."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "green floor"
msgstr "zielona podłoga"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "green floor"
msgid "A green section of flooring."
msgstr "Zielony fragment podłogi."

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Terrain name
msgid "blue floor"
msgstr "niebieska podłoga"

#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
#. ~ Description of terrain "blue floor"
msgid "A blue section of flooring."
msgstr "Niebieski fragment podłogi."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_flora.json
#. ~ Terrain name
msgid "oak tree"
msgstr "dąb"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "oak tree"
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout the New England region.  If you look closely, you can see some "
"acorns the squirrels haven't gotten yet."
msgstr ""
"Masywne rozłożyste drzewo należące do rodzaju „Quercus” (dąb), typowo rosnące "
"na terenach Nowej Anglii. Jeśli spojrzysz uważnie, zauważysz żołędzie, do "
"których jeszcze nie dobrały się wiewiórki."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout the New England region."
msgstr ""
"Masywne rozłożyste drzewo należące do rodzaju „Quercus” (dąb), typowo rosnące "
"na terenach Nowej Anglii."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "walnut tree"
msgstr "orzech"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "walnut tree"
msgid ""
"A massive tree belonging to the 'Juglans' genus.  If you look closely, you "
"can see some unharvested walnuts."
msgstr ""
"Masywne rozłożyste drzewo należące do gatunku „Juglans”. Gdy przyjrzysz się "
"uważnie zobaczysz nie zebrane orzechy."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A massive tree belonging to the 'Juglans' genus."
msgstr "Masywne rozłożyste drzewo należące do gatunku „Juglans”."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "butternut tree"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "butternut tree"
msgid ""
"A massive tree belonging to the 'Juglans' genus, but with lighter bark and "
"more elongated fruits than the more common black walnut.  If you look "
"closely, you can see some unharvested butternuts."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"A massive tree belonging to the 'Juglans' genus, but with lighter bark and "
"more elongated fruits than the more common black walnut."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "blackjack oak"
msgstr "dąb blackjack"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "blackjack oak"
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  You could peel off the bark "
"sections if you examined the tree more closely."
msgstr ""
"Drzewo liściaste z rodzaju „Quercus”, z korą spękaną w prostokątne czarne "
"płytki, poprzecinane wąskimi pomarańczowymi szczelinami. Po dokładniejszym "
"przyjrzeniu się drzewu można by zedrzeć fragmenty kory."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  All the usable bark has been "
"stripped off."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "alder tree"
msgstr "olsza"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "alder tree"
msgid ""
"A deciduous flowering tree with serrated, scalloped, round-obovate leaves, "
"commonly forming dense groves alongside water."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/TropiCataclysm/furniture_and_terrain/tropical_terrain_flora.json
#. ~ Terrain name
msgid "chestnut tree"
msgstr "kasztan"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "chestnut tree"
msgid ""
"A massive tree belonging to the 'Castanea' genus.  If you look closely, you "
"can see some unharvested chestnuts."
msgstr ""
"Masywne rozłożyste drzewo należące do gatunku „Castanea”. Gdy przyjrzysz się "
"uważnie zobaczysz nie zebrane kasztany."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A massive tree belonging to the 'Castanea' genus."
msgstr "Masywne rozłożyste drzewo należące do gatunku „Castanea”."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "beech tree"
msgstr "buk"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "beech tree"
msgid ""
"A massive tree belonging to the 'Fagus' genus.  If you look closely, you can "
"see some unharvested beech nuts."
msgstr ""
"Masywne rozłożyste drzewo należące do gatunku „Fagus”. Gdy przyjrzysz się "
"uważnie zobaczysz nie zebrane bukwie."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A massive tree belonging to the 'Fagus' genus."
msgstr "Masywne rozłożyste drzewo należące do gatunku „Fagus”."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "hazelnut tree"
msgstr "orzech laskowy"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hazelnut tree"
msgid ""
"A stubby tree belonging to the 'Corylus' genus.  If you look closely, you can "
"see some unharvested hazelnuts."
msgstr ""
"Przysadziste drzewo należące do rodzaju „Corylus”. Gdy przyjrzysz się uważnie "
"zobaczysz nie zebrane orzechy laskowe."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hazelnut tree"
msgid "A stubby tree belonging to the 'Corylus' genus."
msgstr "Przysadziste drzewo należące do rodzaju „Corylus”."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "basswood tree"
msgstr "lipa amerykańska"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "basswood tree"
msgid ""
"The American linden.  It has pretty and sweet-smelling flowers in the summer, "
"and you might be able to eat its young leaves in the spring."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"The American linden.  It has pretty and sweet-smelling flowers in the summer, "
"and its edible young leaves have already been harvested."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "cottonwood tree"
msgstr "topola amerykańska"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "cottonwood tree"
msgid ""
"A large tree belonging to the 'Populus' genus, commonly found throughout the "
"New England region.  You see some cottonwood tree bolls that can be harvested."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "cottonwood tree"
msgid ""
"A large tree belonging to the 'Populus' genus, commonly found throughout the "
"New England region.  All the cottonwood tree bolls have been harvested."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "elm tree"
msgstr "wiąz"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "elm tree"
msgid ""
"A large tree belonging to the 'Ulmus' genus, commonly found throughout the "
"New England region."
msgstr ""
"Duże drzewo drzewo należące do rodzaju „Ulmus”, typowo rosnące na terenach "
"Nowej Anglii."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead tree"
msgstr "martwe drzewo"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead tree"
msgid ""
"An indiscernible tree that has withered away due to weather, fire, or "
"otherworldly causes."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead tree"
msgid ""
"An indiscernible tree that has withered away due to weather, fire, or "
"otherworldly causes.  Someone or something has broken most of its dead "
"branches, leaving little but its gnarled trunk."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "warped dead tree"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "warped dead tree"
msgid ""
"This deciduous tree's branches are warped into a spiral.  This appears to "
"have killed it."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/innawood/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "young tree"
msgstr "młode drzewo"

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/innawood/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "young tree"
msgid ""
"A relatively young sapling of an indeterminate species.  It could take "
"decades before reaching maturity, so there's no use waiting around."
msgstr ""
"Stosunkowo młoda sadzonka drzewa nieidentyfikowalnego gatunku. Wzrost do "
"dorosłości może potrwać dekady, więc nie ma na co czekać."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "mega fern"
msgstr "mega paproć"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "mega fern"
msgid ""
"A gigantic fern like nothing you've seen before.  The leaves are a bright "
"scarlet with a net-like structure of green veins.  The multipronged trunks "
"have the texture of balsa wood."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "apple tree"
msgstr "jabłoń"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apple tree"
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known as "
"apples.  If you examined the branches more closely, you could probably find a "
"few mature ones in autumn."
msgstr ""
"To drzewo należy do rodzaju „Malus” i rodzi owoce zwane powszechnie jabłkami. "
"Po dokładniejszym zbadaniu znalazło by się pewnie kilka dojrzałych w okresie "
"jesieni."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known as "
"apples.  There do not appear to be any ripe apples now."
msgstr ""
"To drzewo należy do rodzaju „Malus” i rodzi owoce zwane powszechnie jabłkami. "
"Nie wygląda na to, by obecnie były na nim jakiekolwiek dojrzałe jabłuszka."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "crabapple tree"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "crabapple tree"
msgid ""
"This tree is a member of the 'Malus' genus, though unlike popular cultivars, "
"its fruits are small and sour.  If you examined the branches more closely, "
"you could probably find a few mature ones in autumn."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"This tree is a member of the 'Malus' genus, though unlike popular cultivars, "
"its fruits are small and sour.  There do not appear to be any ripe crabapples "
"now."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "pear tree"
msgstr "grusza"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pear tree"
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces fruit in "
"the fall.  If you examined the branches more closely, you could probably find "
"a few mature ones."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pear tree"
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces fruit in "
"the fall.  Looks like all the ripe pears have been picked."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "coffee tree"
msgstr "kawowiec"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "coffee tree"
msgid ""
"This is 'Gymnocladus dioicus', or the Kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  If you examined the "
"branches more closely, you could probably find a few mature ones."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"This is 'Gymnocladus dioicus', or the Kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  Looks like all the "
"ripe pods have been picked."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "cherry tree"
msgstr "drzewo wiśni"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "cherry tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  If you examined the foliage more closely, you could "
"probably find some viable clusters."
msgstr ""
"Jeden z licznych gatunków drzew „Prunus” rosnących w Nowej Anglii, rodzących "
"wiśnie w lecie. Bo zbadaniu listowia możesz pewnie znaleźć kilka nadających "
"się do spożycia kiści."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "cherry tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  Looks like all the ripe bunches of cherries have "
"been picked."
msgstr ""
"Jeden z licznych gatunków drzew „Prunus” rosnących w Nowej Anglii, rodzących "
"wiśnie w lecie. Dojrzałe wiśnie zostały już najwyraźniej zebrane."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "juniper tree"
msgstr "jałowiec"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "juniper tree"
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries "
"grow over two to three years.  It flowers in the first year, produces a green "
"berry the second, and in the third produces the more famed blue varieties.  "
"If you examined the foliage more closely, you could probably find some viable "
"clusters."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "juniper tree"
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries "
"grow over two to three years.  It flowers in the first year, produces a green "
"berry the second, and in the third produces the more famed blue varieties.  "
"Looks like all the ripe bunches of berries have been picked."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "peach tree"
msgstr "drzewo brzoskwini"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "peach tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  If you examined the branches more closely, you could "
"probably find some mature peaches."
msgstr ""
"Jeden z licznych gatunków drzew „Prunus” rosnących w Nowej Anglii, rodzących "
"brzoskwinie w lecie. Bo zbadaniu gałęzi możesz pewnie znaleźć kilka "
"dojrzalszych brzoskwinek."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "peach tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  Looks like all the ripe peaches have been picked."
msgstr ""
"Jeden z licznych gatunków drzew „Prunus” rosnących w Nowej Anglii, rodzących "
"brzoskwinie w lecie. Dojrzałe brzoskwinie zostały już niestety zebrane."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "apricot tree"
msgstr "drzewo moreli"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apricot tree"
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  If you examined the spurs more closely, "
"you could probably find some mature apricots."
msgstr ""
"Szczepiony gatunek „Prunus armeniaca” rzadko spotykany w Nowej Anglii. Latem "
"owocuje morelami. Bo zbadaniu gałęzi możesz pewnie znaleźć kilka dojrzalszych "
"morel."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apricot tree"
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  Looks like all the ripe apricots have "
"been picked."
msgstr ""
"Szczepiony gatunek „Prunus armeniaca” rzadko spotykany w Nowej Anglii. Latem "
"owocuje morelami. Dojrzałe morele zostały już niestety zebrane."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "plum tree"
msgstr "śliwa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "plum tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  If you examined the spurs more closely, you "
"could probably find some ripe plums."
msgstr ""
"Jeden z licznych gatunków drzew „Prunus” rosnących w Nowej Anglii, rodzących "
"śliwki w lecie. Bo zbadaniu gałęzi możesz pewnie znaleźć kilka dojrzalszych "
"śliwek."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "plum tree"
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  Looks like all the ripe plums have been picked."
msgstr ""
"Jeden z licznych gatunków drzew „Prunus” rosnących w Nowej Anglii, rodzących "
"śliwki w lecie. Dojrzałe śliwki zostały już niestety zebrane."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "mulberry tree"
msgstr "morwa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "mulberry tree"
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known as "
"mulberries.  In the summer, many berries can be picked."
msgstr ""
"To drzewo należy do rodzaju „Morus” i rodzi owoce zwane powszechnie jagodami "
"morwy. W lecie można nazbierać sporo takich jagód."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "mulberry tree"
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known as "
"mulberries.  There do not appear to be any ripe mulberries now."
msgstr ""
"To drzewo należy do rodzaju „Morus” i rodzi owoce zwane powszechnie jagodami "
"morwy. Nie wygląda na to, by obecnie były na nim jakiekolwiek dojrzałe owoce."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tupelo tree"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tupelo tree"
msgid ""
"Its name, originating from Native American tongues and garbled by the "
"settlers, approximately means \"swamp tree\".  During autumn it bears "
"cherry-like fruits."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tupelo tree"
msgid ""
"Its name, originating from Native American tongues and garbled by the "
"settlers, approximately means \"swamp tree\".  During autumn it bears "
"cherry-like fruits, but someone picked this one clean already."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "nannyberry tree"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "nannyberry tree"
msgid ""
"This small tree, it could almost be a large shrub, bears clusters of dark "
"blue berries in autumn."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "nannyberry tree"
msgid ""
"This small tree, it could almost be a large shrub, bears clusters of dark "
"blue berries in autumn, but someone picked this one clean already."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "elderberry tree"
msgstr "dziki bez"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "elderberry tree"
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly known "
"as elderberries.  In the summer, many berries can be picked."
msgstr ""
"To drzewo należy do rodzaju „Sambucus” i rodzi owoce zwane powszechnie "
"jagodami dzikiego bzu. W lecie można nazbierać sporo takich jagód."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "elderberry tree"
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly known "
"as elderberries.  There do not appear to be any ripe elderberries now."
msgstr ""
"To drzewo należy do rodzaju „Sambucus” i rodzi owoce zwane powszechnie "
"jagodami dzikiego bzu. Nie wygląda na to, by obecnie były na nim jakiekolwiek "
"dojrzałe owoce."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "pine tree"
msgstr "sosna"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pine tree"
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  If "
"you examined the tree more closely, you might find usable sticky whorls, "
"resin clumps, and pinecones."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pine tree"
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"Some of the branches and resin clumps have been stripped away and many of the "
"pinecones aren't developed fully yet, but given a season, it could be "
"harvestable again."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead pine tree"
msgstr "martwa sosna"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead pine tree"
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"This tree's branches are bare, and it appears to be dead."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "warped dead pine tree"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "warped dead pine tree"
msgid ""
"The branches of this pine tree have been twisted into a shape that remind you "
"of Sierpinski triangles.  It did not survive being warped like this."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "birch tree"
msgstr "brzoza"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "birch tree"
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling "
"bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  You could tear "
"off some strips of bark if you examined the tree more closely."
msgstr ""
"Wysokie drzewo liściaste z rodzaju „Betula”, z charakterystyczną łuszczącą "
"się korą. Gatunki takie jak „B. alleghaniensis”, „B. papyrifera” i „B. "
"populifolia” są najczęstsze w rejonie Nowej Anglii. Możesz zedrzeć nieco "
"kory, jeśli obejrzysz drzewo dokładniej."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "birch tree"
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling "
"bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  Looks like there "
"isn't enough rhytidome to peel off yet."
msgstr ""
"Wysokie drzewo liściaste z rodzaju „Betula”, z charakterystyczną łuszczącą "
"się korą. Gatunki takie jak „B. alleghaniensis”, „B. papyrifera” i „B. "
"populifolia” są najczęstsze w rejonie Nowej Anglii. Wygląda na to, że nie ma "
"na tyle kory by ją zedrzeć."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "willow tree"
msgstr "wierzba"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "willow tree"
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long, thin, leafy "
"branches that hang down like curtains.  You could tear off some bark."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "willow tree"
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long, thin, leafy "
"branches that hang down like curtains.  Looks like all usable bark has been "
"torn off, and new rhytidomes have not formed yet."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "maple tree"
msgstr "klon"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "maple tree"
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  It could be tapped in order to extract maple sap."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "maple tree"
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  A spigot is wedged into the trunk, and sweet maple "
"sap can be extracted."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "hickory tree"
msgstr "orzesznik"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hickory tree"
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for hickory nuts "
"if you examined the tree more closely."
msgstr ""
"Wysokie drzewo liściaste z rodzaju „Carya”. Po dokładniejszym zbadaniu drzewa "
"można by szukać orzechów."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hickory tree"
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It looks like the tree has been "
"picked clean of hickory nuts."
msgstr ""
"Wysokie drzewo liściaste z rodzaju „Carya”. Wygląda na to, że drzewo zostało "
"oskubane z orzechów."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "pistachio tree"
msgstr "drzewo pistacjowe"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pistachio tree"
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is "
"not native to this region.  You could look for pistachio nuts if you examined "
"the tree more closely."
msgstr ""
"Drzewo liściaste z rodzaju „Pistacia”. Jest to drzewo uprawne, które nie "
"występuje w tym regionie. Po dokładniejszym zbadaniu drzewa można by poszukać "
"orzechów pistacjowych."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pistachio tree"
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is "
"not native to this region.  Unfortunately, it looks like it has been picked "
"clean of pistachio nuts."
msgstr ""
"Drzewo liściaste z rodzaju „Pistacia”. Jest to drzewo uprawne i nie występuje "
"w tym regionie. Niestety, wygląda na to, że zostało oskubane z orzechów "
"pistacjowych."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "almond tree"
msgstr "drzewo migdałowe"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "almond tree"
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  You could look for fresh almonds if you examined "
"the tree more closely."
msgstr ""
"Drzewo liściaste z rodzaju „Prunus”. Jest to drzewo uprawne, które nie "
"występuje w tym regionie. Po bliższym przyjrzeniu się drzewu można by "
"poszukać świeżych migdałów."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "almond tree"
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  There are no almonds left to pick on the tree."
msgstr ""
"Drzewo liściaste z rodzaju „Prunus”. Jest to drzewo uprawne, które nie "
"występuje w tym regionie. Na tym drzewie nie ma już migdałów do zebrania."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "pecan tree"
msgstr "drzewo leszczyny"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pecan tree"
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for pecan nuts if "
"you examined the tree more closely."
msgstr ""
"Wysokie drzewo liściaste z rodzaju „Carya”. Po dokładniejszym zbadaniu drzewa "
"można by szukać orzechów pekan."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "pecan tree"
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It doesn't look like there are "
"any pecan nuts left on the tree."
msgstr ""
"Wysokie drzewo liściaste z rodzaju „Carya”. Nie wygląda na to, żeby na "
"drzewie pozostały jakieś orzechy."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead hickory tree"
msgstr "martwy orzesznik"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead hickory tree"
msgid ""
"The dead remnants of a tall deciduous tree of the 'Carya' genus.  Nothing "
"useful can be foraged from this poor, dead tree."
msgstr ""
"Martwe szczątki wysokiego drzewa liściastego z rodzaju „Carya”. Z tego "
"biednego, martwego drzewa nie da się zebrać nic pożytecznego."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "sassafras tree"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "sassafras tree"
msgid ""
"This tree is a member of the 'Sassafras' genus, known for its aromatic "
"qualities.  In the winter and spring, the sap rich roots can be harvested to "
"make a sweet beverage."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "sassafras tree"
msgid ""
"This tree is a member of the 'Sassafras' genus, known for its aromatic "
"qualities.  This tree's roots have been harvested, any more and the tree will "
"die."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/items/comestibles/other.json
#. ~ Terrain name
#. ~ Item name
msgid "underbrush"
msgid_plural "underbrushes"
msgstr[0] "poszycie"
msgstr[1] "poszycia"
msgstr[2] "poszyć"
msgstr[3] "poszycia"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "underbrush"
msgid ""
"Small plants and shrubs that decorate the forest.  An observant forager could "
"obtain edible plants, acorns, eggs, and mushrooms from it."
msgstr ""
"Małe rośliny i krzewy które dekorują las. Uważny zbieracz może pozyskać z "
"nich jadalne rośliny, żołędzie, jaja i grzyby."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "underbrush"
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it."
msgstr ""
"Małe rośliny i krzewy, które zdobią las. Zostały one przeczesane i nie ma w "
"nich nic przydatnego do znalezienia."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "underbrush"
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it.  Frost "
"covers it."
msgstr ""
"Małe rośliny i krzewy, które zdobią las. Zostały one przeczesane i nie ma w "
"nich nic przydatnego do znalezienia. Pokrywa je szron."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/mods/alt_map_key/overmap_terrain_pink.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "bee hive"
msgstr "ul"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "bee hive"
msgid ""
"A hive of bees located in a cavity inside a tree, swarming in and out at a "
"feverish pace.  There's probably honey inside."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/overmap/overmap_terrain/overmap_terrain_agricultural.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "apiary"
msgstr "pasieka"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apiary"
msgid ""
"A man-made wooden box designed to hold honeybees and facilitate the care for "
"a hive.  The modular construction allows for inspecting the bees and "
"harvesting their bounty without destroying the hive completely.  This year's "
"harvest should be ready by now."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "apiary"
msgid ""
"A man-made wooden box designed to host honeybees and facilitate the care for "
"a hive.  The modular construction allows for inspecting the bees and "
"harvesting their bounty without destroying the hive completely.  It will be "
"some time before this one is ready to harvest."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "shrub"
msgstr "krzaki"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "shrub"
msgid "A small shrub."
msgstr "Mały krzew."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "peanut bush"
msgstr "krzak orzeszków ziemnych"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "peanut bush"
msgid "A small bush of crunchy peanuts."
msgstr "Mały krzak z kłączami pełnymi chrupiących orzeszków ziemnych."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small peanut bush that's fruitless."
msgstr "Mały krzak orzeszków ziemnych, który nie ma owoców."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "autumn olive"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "autumn olive"
msgid ""
"An invasive species from Japan which is also called silverberry.  Widely "
"planted in the 1940s to combat erosion, it spread far and wide, often even "
"displacing native plants.  As it name says, it bears fruits in autumn, which "
"are quite unlike olives."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"An invasive species from Japan which is also called silverberry.  Widely "
"planted in the 1940s to combat erosion, it spread far and wide, often even "
"displacing native plants.  As it name says, it bears fruits in autumn, which "
"are quite unlike olives, but this particular plant has been harvested already."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "hobblebush"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hobblebush"
msgid ""
"Called hobblebush because it may hinder and trip, hobbles, unwary hikers with "
"its branches bending over and taking root.  It also bears surprisingly sweet "
"berries in autumn."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid ""
"Called hobblebush because it may hinder and trip, hobbles, unwary hikers with "
"its branches bending over and taking root.  It also bears surprisingly sweet "
"berries in autumn, if it hadn't been picked clean already."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "blueberry bush"
msgstr "krzak borówek"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "blueberry bush"
msgid "A small bush of sweet blueberries."
msgstr "Mały krzak słodkich jagód."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small blueberry bush that's fruitless."
msgstr "Mały krzak borówek, bez owoców."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "strawberry bush"
msgstr "krzew truskawek"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "strawberry bush"
msgid "A small bush of juicy strawberries."
msgstr "Mały krzak soczystych truskawek."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small strawberry bush that's fruitless."
msgstr "Mały krzak truskawek, bez owoców."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "blackberry bush"
msgstr "krzak jeżyn"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "blackberry bush"
msgid "A small bush of delicious blackberries.  Watch out for its thorns!"
msgstr "Mały krzak smacznych jeżyn. Uwaga na kolce!"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small blackberry bush that's fruitless.  Watch out for its thorns!"
msgstr "Mały krzak jeżyn, bez owoców. Uwaga na kolce!"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "huckleberry bush"
msgstr "borówka amerykańska"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "huckleberry bush"
msgid "A small bush of huckleberries, often mistaken for blueberries."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small huckleberry bush that's fruitless."
msgstr "Mały krzak borówki amerykańskiej, bez owoców."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "raspberry bush"
msgstr "krzak malin"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "raspberry bush"
msgid "A small bush of delicious raspberries.  Watch out for its thorns!"
msgstr "Mały krzak smacznych malin. Uwaga na kolce!"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A small raspberry bush that's fruitless.  Watch out for its thorns!"
msgstr "Mały krzak malin, bez owoców. Uwaga na kolce!"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "grape bush"
msgstr "krzew winogron"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "grape bush"
msgid "A bush of a different species invaded by grape vines."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A bush of a different species invaded by grape vines, but they're fruitless."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "spicebush"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "spicebush"
msgid "A bush that features small, red berries."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A bush that usually features small, red berries but it was picked clean."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "black chokeberry bush"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "black chokeberry bush"
msgid ""
"Drooping black berries adorn the shrub during autumn.  These have a "
"distinctive star-shaped fold and look quite juicy."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "Drooping black berries adorned this shrub, but the shrub was picked clean."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "rose bush"
msgstr "róża"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "rose bush"
msgid ""
"A fat bush of beautiful red roses, if only you could get a date!  Watch out "
"for its thorns!"
msgstr ""
"Okrągły krzew ślicznych czerwonych róż; świetnych na randkę gdybyś ją miał "
"mieć. Uwaga na kolce!"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A fat rose bush that currently has no blooms.  Watch out for its thorns!"
msgstr "Okrągły krzew róż, obecnie bez kwiatów. Uwaga na kolce!"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "hydrangea bush"
msgstr "hortensja"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "hydrangea bush"
msgid "A dense bush of fragrant blue hydrangeas."
msgstr "Gęsty krzew pachnących niebieskich hortensji."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A fat hydrangea bush that currently has no blooms."
msgstr "Okrągły krzew hortensji, obecnie bez kwiatów."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "lilac bush"
msgstr "bez"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "lilac bush"
msgid "A wide bush of bright pinkish-purple lilacs."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain ""
msgid "A wide lilac bush that currently has no blooms."
msgstr "Rozłożysty krzew bzu, który obecnie nie kwitnie."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tree trunk"
msgstr "pień drzewa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tree trunk"
msgid ""
"A section of trunk from a tree that has been cut down.  Can be sawn into logs "
"with the right tool."
msgstr ""
"Część pnia drzewa, które zostało ścięte. Przy pomocy odpowiedniego narzędzia "
"może być pocięty na kłody."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tree stump"
msgstr "pień drzewa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tree stump"
msgid "A tree stump, a remnant of a tree that has been cut down."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "woodchips"
msgstr "trociny"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "woodchips"
msgid ""
"Small splinters of wood laid out in a layer to prevent unwanted plants from "
"growing."
msgstr ""
"Warstwa małych ścinków drewna wysypanych by zapobiec wzrostowi niechcianych "
"roślin."

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/json/items/comestibles/other.json
#. ~ Terrain name
#. ~ Item name
msgid "grass"
msgid_plural "grass"
msgstr[0] "trawa"
msgstr[1] "trawy"
msgstr[2] "traw"
msgstr[3] "traw"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "grass"
msgid ""
"An area of hardy Kentucky bluegrass about ankle high.  Cutting the grass "
"short enough would destroy the root system, causing this area to turn into a "
"patch of dirt."
msgstr ""
"Obszar twardej wiechliny łąkowej z Kentucky sięgającej do kostek. Zcięcie tej "
"trawy blisko ziemi zniszczy system korzeniowy zostawiając połać gołej ziemi."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "white grass"
msgstr "biała trawa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "white grass"
msgid ""
"An area of Kentucky bluegrass covered in white latex-based paint, with neat "
"lines designed for recreational sports."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "long grass"
msgstr "długa trawa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "long grass"
msgid "An area of long, shaggy grass about shin high."
msgstr "Obszar długiej, krzaczastej trawy sięgającej po goleń."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tall grass"
msgstr "wysoka trawa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tall grass"
msgid "An area of tall grass about head high."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead grass"
msgstr "martwa trawa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead grass"
msgid "An area of long, shaggy grass that hasn't been cut recently."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "grazed grass"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "grazed grass"
msgid ""
"An area of extremely short green stubble protruding from the dirt.  Something "
"has been clearly grazing here."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "golf green"
msgstr "darń golfowa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "golf green"
msgid "An area of grass mowed very short and neat."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_alien.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_alien_meadow.json
#. ~ Terrain name
msgid "alien grass"
msgstr "obca trawa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "alien grass"
msgid ""
"An area of something that almost looks like grass.  The blades are serrated "
"and move on their own."
msgstr ""
"Obszar czegoś co wygląda prawie jak trawa. Źdźbła są ząbkowane i poruszają "
"się samodzielnie."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "golf hole"
msgstr "otwór golfowy"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "golf hole"
msgid "A small plastic cup embedded in an area of very short, neat grass."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "young bamboo shoots"
msgstr "młode pędy bambusa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "young bamboo shoots"
msgid ""
"An area of young bamboo shoots about ankle high.  Many shoots are just barely "
"pushing above the ground."
msgstr ""
"Obszar z młodymi pędami bambusa o wysokości około kostki. Wiele pędów ledwo "
"wystaje ponad ziemię."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "young bamboo shoots"
msgid ""
"An area of young bamboo shoots about ankle high.  The smallest shoots have "
"already been harvested."
msgstr ""
"Obszar z młodymi pędami bambusa o wysokości około kostki. Najmniejsze pędy "
"zostały już zebrane."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "long bamboo shoots"
msgstr "długie pędy bambusa"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "long bamboo shoots"
msgid "An area of long bamboo shoots about shin high."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "tall bamboo"
msgstr "wysoki bambus"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "tall bamboo"
msgid "A tall bamboo thicket about head high."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "dead bamboo"
msgstr "martwy bambus"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "dead bamboo"
msgid "An area of long, brown, dead bamboo shoots covered in white fungus."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "fern"
msgstr "paproć"

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "fern"
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern from "
"the stem."
msgstr "Krótka roślina z tysiącami liści, które wyrastają w fraktalny wzór z łodygi."

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "fern"
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern.  All "
"of the curled shoots have been harvested."
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Terrain name
msgid "mushroom colony"
msgstr ""

#: data/json/furniture_and_terrain/terrain-flora.json
#. ~ Description of terrain "mushroom colony"
msgid ""
"A large pile of organic matter which has molded over with fungus.  The caps "
"of many mundane mushrooms spring from the top, you can even recognize some.  "
"The fungi growing here don't seem edible, though."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "Marloss bush"
msgstr "krzak Marloss"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "Marloss bush"
msgid ""
"This alien plant superficially resembles a blueberry bush, and hangs with "
"large, juicy pink pomes that emit a heady, fruity aroma."
msgstr ""
"Ta obca roślina powierzchownie przypomina krzew borówki amerykańskiej i "
"obwieszona jest dużymi, soczystymi, różowymi owocami, które wydzielają mocny, "
"owocowy aromat."

#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/json/furniture_and_terrain/terrain-triffid.json
#: data/mods/Magiclysm/furniture_and_terrain/terrain_druid.json
#: data/mods/MindOverMatter/furniture_and_terrain/terrain_alien.json
#: data/mods/TropiCataclysm/furniture_and_terrain/terrain_fungal_termite.json
#. ~ Bashing failed sound
msgid "poof!"
msgstr "poof!"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal bed"
msgstr "grzybicze podloże"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal bed"
msgid "Fungus grows thick here, obscuring the ground beneath it."
msgstr "Grzybnia porasta tu gęsto, przesłaniając ziemię pod sobą."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal floor"
msgstr "grzybicza podłoga"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal floor"
msgid ""
"Grayish mold coats both the floor and the roof here, silent and still.  Stray "
"spores waft through the air."
msgstr ""
"Szarawa pleśń pokrywa zarówno podłogę, jak i dach, rosnąc tutaj cicho i "
"spokojnie. W powietrzu unoszą się strzępki zarodników."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal floor"
msgid "Grayish mold coats the floor here, silent and still."
msgstr "Szarawa pleśń pokrywa podłogę, rosnąc tutaj cicho i spokojnie."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal floor"
msgid "Grayish mold coats the ground here, silent and still."
msgstr "Szarawa pleśń pokrywa ziemię, rosnąc tutaj cicho i spokojnie."

#: data/json/furniture_and_terrain/terrain-fungal.json
#: data/json/monsters/fungus.json
#. ~ Terrain name
#. ~ Monster name
msgid "fungal wall"
msgid_plural "fungal walls"
msgstr[0] "grzybicza ściana"
msgstr[1] "grzybicze ściany"
msgstr[2] "grzybiczych ścian"
msgstr[3] "grzybiczej ściany"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal wall"
msgid ""
"Several thick, large tendrils of fungus perforate the wall here, piercing "
"straight through it from the outside.  Despite the apparent damage, the wall "
"is still structurally sound."
msgstr ""
"Kilka grubych, dużych wici grzyba przedziurawiło ścianę w tym miejscu, "
"przebijając się przez nią od zewnątrz. Pomimo widocznych uszkodzeń, ściana "
"jest nadal strukturalnie stabilna."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal wall"
msgid ""
"The fungus here has grown thickly and tightly enough to form a solid wall.  "
"It feels very stiff to the touch, and seems to be very strong."
msgstr ""
"Tutejszy grzyb rozrósł się na tyle gęsto i ciasno, że tworzy solidną ścianę. "
"W dotyku jest bardzo sztywny i wydaje się być bardzo mocny."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal mound"
msgstr "grzybicza sterta"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal mound"
msgid "A mound of fungal matter, intertwined in itself."
msgstr "Kopiec materii grzybiczej, spleciony sam w sobie."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal shrub"
msgstr "grzybiczy krzew"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal shrub"
msgid ""
"This shrub has been completely absorbed by the mushrooms.  Its branches droop "
"and have lost much of their structure, and its leaves have vanished, replaced "
"by fleshy gray sacks that visibly expand and contract."
msgstr ""
"Ten krzew został całkowicie wchłonięty przez grzyby. Jego gałęzie opadły i "
"straciły wiele ze swojej struktury, a liście zniknęły, zastąpione przez "
"mięsiste szare worki, które zauważalnie rozszerzają się i kurczą."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "fungal tree"
msgstr "grzybicze drzewo"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "fungal tree"
msgid ""
"Once tall and majestic, this tree is now a slave to the fungus like the "
"landscape around it.  Its bark is penetrated by and covered with fungal "
"tendrils, and the canopy has rotted away, leaving only the branches, "
"stretching forlornly to the sky as if to escape the infection overrunning it."
msgstr ""
"Kiedyś wysokie i majestatyczne, to drzewo jest teraz niewolnikiem grzyba, "
"podobnie jak otaczający go krajobraz. Jego kora jest penetrowana i pokryta "
"wąsami grzybowymi, a baldachim zgnił, pozostawiając tylko gałęzie, "
"rozciągając się ku niebu, jakby chcąc uciec od zarażającej go infekcji."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "young fungal tree"
msgstr "młode grzybicze drzewo"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "young fungal tree"
msgid "A small sapling poking through the ground, infested by fungal mold."
msgstr "Małe drzewko wystające z ziemi, zaatakowane grzybiczą pleśnią."

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Terrain name
msgid "Marloss tree"
msgstr "drzewo Marloss"

#: data/json/furniture_and_terrain/terrain-fungal.json
#. ~ Description of terrain "Marloss tree"
msgid ""
"This tree stands as a stark outlier to the landscape around it.  Despite its "
"infestation, its leaves wave proudly in the wind, colored pinkish-white.  Its "
"branches are heavy with pink fruit that looks both mutated and delicious."
msgstr ""
"To drzewo wyróżnia się na tle otaczającego go krajobrazu. Pomimo porażenia, "
"jego liście dumnie falują na wietrze, zabarwione na różowo-biało. Jego "
"gałęzie są ciężkie od różowych owoców, które wyglądają zarówno na zmutowane, "
"jak i smakowite."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "shallow water"
msgstr "płytka woda"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "shallow water"
msgid ""
"The water isn't too deep here.  With a watertight container, you could gather "
"fresh water from here.  Not safe to drink as is."
msgstr ""
"Woda nie jest tu zbyt głęboka. Mając wodoszczelny pojemnik, można by zebrać "
"stąd świeżą wodę. Nie jest bezpieczna do picia bez przygotowania."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "deep water"
msgstr "głęboka woda"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "deep water"
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a "
"watertight container, you could gather fresh water from here.  Not safe to "
"drink as is."
msgstr ""
"Masz problem z zobaczeniem dna w tej głębokiej wodzie. Mając wodoszczelny "
"pojemnik, można by zebrać stąd świeżą wodę. Nie jest bezpieczna do picia bez "
"przygotowania."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "murky shallow water"
msgstr "mętna płytka woda"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "murky shallow water"
msgid ""
"The water isn't too deep here but is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"Woda nie jest tu zbyt głęboka, ale zamulona substancjami organicznymi. Przy "
"użyciu wodoszczelnego pojemnika można stąd czerpać mętną wodę. Nie jest "
"bezpieczna do picia w takiej postaci."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "murky shallow water"
msgid ""
"The water isn't too deep here but it is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"Woda nie jest tu zbyt głęboka, ale zamulona substancjami organicznymi. Przy "
"użyciu wodoszczelnego pojemnika można stąd czerpać mętną wodę. Nie jest "
"bezpieczna do picia w takiej postaci."

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/mods/Magiclysm/furniture_and_terrain/terrain_druid.json
#. ~ Terrain name
msgid "flowing shallow water"
msgstr "płynąca płytka woda"

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/mods/Magiclysm/furniture_and_terrain/terrain_druid.json
#. ~ Description of terrain "flowing shallow water"
msgid ""
"The streaming water isn't too deep here.  With a watertight container, you "
"could gather fresh water from here.  Not safe to drink as is, although "
"probably safer than stagnant water."
msgstr ""
"Płynąca woda nie jest tu zbyt głęboka. Mając wodoszczelny pojemnik, możesz "
"zebrać stąd świeżą wodę. Nie jest bezpieczna do picia od ręki, ale "
"prawdopodobnie jest bezpieczniejsza niż woda stojąca."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "flowing deep water"
msgstr "płynąca głęboka woda"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "flowing deep water"
msgid ""
"The streaming water looks deep here.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is, although probably "
"safer than stagnant water."
msgstr ""
"Płynąca woda wygląda tu na głęboką. Mając wodoszczelny pojemnik, można by "
"zebrać stąd świeżą wodę. Nie jest bezpieczna do picia od ręki, ale "
"prawdopodobnie jest bezpieczniejsza niż woda stojąca."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "shallow water"
msgid ""
"The water isn't too deep here.  With a watertight container, you could gather "
"salt water from here."
msgstr ""
"Woda nie jest tu zbyt głęboka. Mając wodoszczelny pojemnik, można by zebrać "
"stąd słoną wodę."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "deep water"
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a "
"watertight container, you could gather salt water from here."
msgstr ""
"Masz problem z zobaczeniem dna w tej głębokiej wodzie. Mając wodoszczelny "
"pojemnik, można by zebrać stąd słoną wodę."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "surf"
msgstr ""

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "surf"
msgid "A broad area of fine sand, washed by waves coming in from the sea."
msgstr ""

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "pool water"
msgstr "woda w basenie"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "pool water"
msgid ""
"A deep pool full of water.  Never swim without a lifeguard present.  Even "
"though monsters probably ate them."
msgstr ""
"Głęboki basen pełen wody. Nigdy nie pływaj bez obecności ratownika. Nawet "
"jeśli prawdopodobnie zjadły ich potwory."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "shallow pool water"
msgstr "płytki zbiornik wodny"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "shallow pool water"
msgid "A shallow pool of water."
msgstr "Płytki zbiornik wodny."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "sewage"
msgstr "ściek"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "sewage"
msgid ""
"Gross.  Sewage water flows through here.  As if it needed saying, this isn't "
"safe to drink."
msgstr ""
"Ohyda. Płyną tędy ścieki. Nie jest bezpieczna do picia, na wypadek gdyby "
"trzeba było to podkreślić."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "lava"
msgid ""
"An extremely hot, glowing liquid, composed of molten rock and/or metal.  In "
"some places, lava-grilled steak is a delicacy."
msgstr ""
"Niezwykle gorąca, żarząca się ciecz, składająca się ze stopionej skały i/lub "
"metalu. W niektórych miejscach grillowany na lawie stek jest przysmakiem."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "submersed water"
msgstr "głębia wody"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "submersed water"
msgid ""
"You are submerged below the surface of the water, your feet can't touch the "
"ground.  With a watertight container, you could gather fresh water from here. "
" Not safe to drink as is."
msgstr ""
"Jesteś zanurzony pod powierzchnią wody, twoje stopy nie mogą dotknąć ziemi. "
"Mając wodoszczelny pojemnik, można by zebrać stąd świeżą wodę. W obecnej "
"postaci nie jest bezpieczna do picia."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "submersed salt water"
msgstr ""

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "submersed salt water"
msgid ""
"You are submerged below the surface of the water, your feet can't touch the "
"ground.  With a watertight container, you could gather salt water from here."
msgstr ""

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/mods/desert_region/overmap/desert_overmap_terrain.json
#. ~ Terrain name
#. ~ Overmap terrain name
msgid "lake bed"
msgstr "dno jeziora"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "lake bed"
msgid ""
"You are standing at the bottom of a body of fresh water.  With a watertight "
"container, you could gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Stoisz na dnie zbiornika słodkiej wody. Mając wodoszczelny pojemnik, można by "
"zebrać stąd słodką wodę. Nie jest bezpieczna do picia w takiej postaci."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "ocean bed"
msgstr "dno oceanu"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "ocean bed"
msgid ""
"You are standing at the bottom of a body of salt water.  With a watertight "
"container, you could gather salt water from here.  Not safe to drink as is."
msgstr ""
"Stoisz na dnie zbiornika słonej wody. Mając wodoszczelny pojemnik, można by "
"zebrać stąd słoną wodę. Nie jest bezpieczna do picia w takiej postaci."

#: data/json/furniture_and_terrain/terrain-liquids.json
#: data/json/furniture_and_terrain/terrain-walls.json
#. ~ Terrain name
msgid "bulkhead"
msgstr "gródź"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "bulkhead"
msgid ""
"The top of a submerged structure.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Szczyt zanurzonej konstrukcji. Mając wodoszczelny pojemnik, można stąd "
"czerpać słodką wodę. Nie jest bezpieczna do picia w takiej postaci."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "bulkhead"
msgid "The bottom of a submerged structure."
msgstr "Spód zanurzonej struktury."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "submerged concrete"
msgstr "podwodna płyta betonowa"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "submerged concrete"
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of concrete. "
" With a watertight container, you could gather fresh water from here.  Not "
"safe to drink as is."
msgstr ""
"Stoisz na dnie zbiornika słodkiej wody, na betonowej płycie. Mając "
"wodoszczelny pojemnik, można by zbierać stąd słodką wodę. Nie jest bezpieczna "
"do picia w takiej postaci."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "submerged concrete"
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of "
"yellow-painted concrete.  With a watertight container, you could gather fresh "
"water from here.  Not safe to drink as is."
msgstr ""
"Stoisz na dnie zbiornika słodkiej wody, na płycie pomalowanego na żółto "
"betonu. Mając wodoszczelny pojemnik, można by zbierać stąd słodką wodę. Nie "
"jest bezpieczna do picia w takiej postaci."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "hot spring water"
msgstr "gorąca woda źródlana"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "hot spring water"
msgid ""
"Scalding hot water, not particularly safe for swimming.  With a watertight "
"container, you could gather fresh water from here.  Not safe to drink as is."
msgstr ""
"Parząca, gorąca woda, niezbyt bezpieczna do kąpieli. Mając wodoszczelny "
"pojemnik, można stąd czerpać słodką wodę. Nie jest bezpieczna do picia w "
"takiej postaci."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "recess"
msgstr "zagłębienie"

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "recess"
msgid "A shallow pit in the ground."
msgstr "Płytkie zagłębienie w ziemi."

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Terrain name
msgid "flood water"
msgstr ""

#: data/json/furniture_and_terrain/terrain-liquids.json
#. ~ Description of terrain "flood water"
msgid ""
"The water isn't too deep here, it seems to have either pooled here or risen "
"from a pipe leaking nearby.  With a watertight container, you could gather "
"fresh water from here.  Not safe to drink as is."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "metal compactor"
msgstr "zgniatarka metali"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "metal compactor"
msgid ""
"A hydraulic machine for squeezing scrap into more compact chunks.  Useless "
"now that there's no power."
msgstr ""
"Hydrauliczna maszyna do ściskania złomu na bardziej kompaktowe kawałki. "
"Bezużyteczna teraz, gdy nie ma prądu."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "gasoline pump"
msgstr "dystrybutor benzyny"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "gasoline pump"
msgid ""
"Precious GASOLINE.  The former world bowed to their petroleum god as it led "
"them to their ruin.  There's plenty left over to fuel your inner road "
"warrior.  If this gas dispenser doesn't give up the goods for free, you may "
"have to pay at a nearby terminal."
msgstr ""
"Drogocenna BENZYNA. Dawny świat kłaniał się swojemu naftowemu bogu, który "
"doprowadził go do ruiny. Zostało jeszcze sporo, by zasilić twojego "
"wewnętrznego wojownika szos. Jeśli ten dystrybutor nie wyda ci towaru za "
"darmo, być może będziesz musiał zapłacić na pobliskim terminalu."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "smashed gas pump"
msgstr "rozbity dystrybutor benzyny"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "smashed gas pump"
msgid ""
"The horror!  This gasoline pump has been destroyed, denying you access to the "
"liquid gold."
msgstr ""
"Horror! Ta pompa benzynowa została zniszczona, uniemożliwiając Ci dostęp do "
"płynnego złota."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "diesel pump"
msgstr "pompa diesla"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "diesel pump"
msgid ""
"A diesel fuel pump.  This roadside attraction provides all the thick, gloopy "
"liquid POWER you need to move your sensibly oversized APOCALYPTIC SUPERTRUCK "
"from point A to points beyond.  If it doesn't dispense fuel immediately, try "
"banging on it or grunt your way over the nearby payment terminal."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "smashed diesel pump"
msgstr "rozbity dystrybutor diesla"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "smashed diesel pump"
msgid ""
"You're not getting any diesel out of this pump any time soon.  Some barbarian "
"decided to take their frustration out on it."
msgstr ""
"W najbliższym czasie nie dostaniesz z tej pompy żadnego oleju napędowego. "
"Jakiś barbarzyńca postanowił wyładować na niej swoją frustrację."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "JP8 pump"
msgstr "pompa JP-8"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "JP8 pump"
msgid ""
"A pump that dispenses JP8.  If this gas dispenser doesn't give up the goods "
"for free, you may have to pay at a nearby terminal."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "smashed JP8 pump"
msgstr "rozbity dystrybutor JP-8"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "smashed JP8 pump"
msgid ""
"You're not getting any JP8 out of this pump any time soon.  Some barbarian "
"decided to take their frustration out on it."
msgstr ""
"W najbliższym czasie nie dostaniesz z tej pompy żadnego JP-8. Jakiś "
"barbarzyńca postanowił wyładować na niej swoją frustrację."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "avgas pump"
msgstr "dystrybutor paliwa lotniczego"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "avgas pump"
msgid ""
"A pump that dispenses avgas.  If this gas dispenser doesn't give up the goods "
"for free, you may have to pay at a nearby terminal."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "smashed avgas pump"
msgstr "rozbity dystrybutor paliwa lotniczego"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "smashed avgas pump"
msgid ""
"You're not getting any avgas out of this pump any time soon.  Some barbarian "
"decided to take their frustration out on it."
msgstr ""
"W najbliższym czasie nie dostaniesz z tej pompy żadnego paliwa lotniczego. "
"Jakiś barbarzyńca postanowił wyładować na niej swoją frustrację."

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "ticket vendor"
msgstr "biletomat"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "ticket vendor"
msgid ""
"A machine with a little screen and slots, intended to take your money and "
"provide you with a ticket."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "ticket machine"
msgstr "bileter"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "ticket machine"
msgid ""
"A machine that will provide you access to whatever lies beyond it - for the "
"price of a ticket, of course."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "ventilation shutters"
msgstr "rolety wentylacyjne"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "ventilation shutters"
msgid ""
"A large wall-mounted panel, covered with fragile metal sheets that regulate "
"airflow."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "missile"
msgstr "rakieta"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "missile"
msgid ""
"A section of an ICBM, an Intercontinental Ballistic Missile.  This isn't the "
"kind of rocket that goes to the moon."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Terrain name
msgid "blown-out missile"
msgstr "wypalona rakieta"

#: data/json/furniture_and_terrain/terrain-manufactured.json
#. ~ Description of terrain "blown-out missile"
msgid ""
"A section of an ICBM, an Intercontinental Ballistic Missile.  This isn't the "
"kind of rocket that's going anywhere."
msgstr ""

#: data/json/furniture_and_terrain/terrain-manufactured.json
#: data/json/overmap/overmap_terrain/overmap_terrain.json
#: data/json/overmap/overmap_terrain/overmap_terrain_commercial.json
