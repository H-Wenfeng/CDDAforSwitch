"10/16/15<color_dark_gray>, <color_cyan>15/24/22<color_dark_gray> lub "
"<color_cyan>20/32/29<color_dark_gray>\n"
"\n"
"Czcionka: <color_cyan>DejaVuSansMono.ttf</color>"

