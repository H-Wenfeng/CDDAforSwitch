msgstr "Upadek <color_pink>może cię okaleczyć lub zabić</color>."

#: src/game.cpp:14079
msgid "Falling <color_pink>would break bones.</color>."
msgstr "Upadek <color_pink>połamałby kości.</color>."

#: src/game.cpp:14081
msgid "Falling <color_red>would hurt badly</color>."
msgstr "Upadek <color_red>byłby bardzo bolesny</color>."

#: src/game.cpp:14083
msgid "Falling <color_red>would hurt</color>."
msgstr "Upadek <color_red>byłby bolesny</color>."

#: src/game.cpp:14085
msgid "Falling <color_green>wouldn't hurt much</color>."
msgstr "Upadek <color_green>nie byłby zbyt bolesny</color>."

#: src/game.cpp:14096
#, c-format
msgid ""
"Even if you climb down safely, you will fall <color_yellow>at least %d "
"story</color>."
msgid_plural ""
"Even if you climb down safely, you will fall <color_red>at least %d "
"stories</color>."
msgstr[0] ""
"Nawet jeśli bezpiecznie zejdziesz na dół, spadniesz <color_yellow>co najmniej "
"%d piętro</color>."
msgstr[1] ""
"Nawet jeśli bezpiecznie zejdziesz na dół, spadniesz <color_yellow>co najmniej "
"%d piętra</color>."
msgstr[2] ""
"Nawet jeśli bezpiecznie zejdziesz na dół, spadniesz <color_yellow>co najmniej "
"%d piętrer</color>."
msgstr[3] ""
"Nawet jeśli bezpiecznie zejdziesz na dół, spadniesz <color_yellow>co najmniej "
"%d piętra</color>."

#: src/game.cpp:14111
msgid "You <color_red>probably won't be able to climb back up</color>."
msgstr "<color_red>Prawdopodobnie nie będziesz w stanie wspiąć się z powrotem</color>."

#: src/game.cpp:14113
msgid "You <color_green>should be easily able to climb back up</color>."
msgstr "<color_green>Powinno udać ci się z łatwością wspiąć z powrotem</color>."

#: src/game.cpp:14116
