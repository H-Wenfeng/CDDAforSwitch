msgstr[3] ""

#: data/mods/Aftershock/items/comestibles/cheap_food.json
#: data/mods/aftershock_exoplanet/items/comestibles/cheap_food.json
#. ~ Description of "Spite Soda"
msgid ""
"Spite Soda, the only soda native to the Salus system.  'Stay Frosty, Drink "
"Spite'.  Visitors to the Salus system who have drank Spite Soda have "
"described it as the taste of transhumanist dialectical materialism."
msgstr ""
"Spite Soda, jedyny napój gazowany pochodzący z systemu Salus. „Trzymaj fason, "
"pij Spite Sodę”. Odwiedzający system Salus, którzy pili Spite Soda opisali go "
"jako smak transhumanistycznego materializmu dialektycznego."

#: data/mods/Aftershock/items/comestibles/cheap_food.json
#: data/mods/aftershock_exoplanet/items/comestibles/cheap_food.json
#. ~ "activation_message" action message of item "Spite Soda"
msgid "You take a swig, it tastes like it was distilled in a hyperspace engine."
msgstr "Bierzesz łyk, smakuje jakby był destylowany w silniku nadprzestrzennym."

#: data/mods/Aftershock/items/comestibles/cheap_food.json
#: data/mods/aftershock_exoplanet/items/comestibles/cheap_food.json
#. ~ Item name
msgid "H₂O™"
msgid_plural "H₂O™"
msgstr[0] "H₂O™"
msgstr[1] "H₂O™"
msgstr[2] "H₂O™"
msgstr[3] "H₂O™"

#: data/mods/Aftershock/items/comestibles/cheap_food.json
#: data/mods/aftershock_exoplanet/items/comestibles/cheap_food.json
#. ~ Description of "H₂O™"
msgid ""
"When Thistle Industries successfully trademarked the chemical formula of "
"water, you thought the world had gone irreparably insane, but things have "
"only gotten worse since."
msgstr ""
"Gdy Thistle Industries udało się uzyskać znak towarowy dla chemicznej formuły "
"wody, pomyślałeś że świat nieodwracalnie oszalał, ale od tego czasu sprawy "
"się pogorszyły."

#: data/mods/Aftershock/items/comestibles/cheap_food.json
#: data/mods/aftershock_exoplanet/items/comestibles/cheap_food.json
#. ~ Item name
msgid "food cubes"
msgid_plural "food cubes"
