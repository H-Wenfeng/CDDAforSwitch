msgid "Normal (300 XP)"
msgstr "Normalnie (300 doś.)"

#: data/mods/BombasticPerks/corefiles/config_menu.json
#. ~ Response to NPC dialogue
msgid "Large (1000 XP)"
msgstr "Dużo (1000 doś.)"

#: data/mods/BombasticPerks/corefiles/config_menu.json
#. ~ Response to NPC dialogue
msgid "Very Large (10000 XP)"
msgstr "Bardzo dużo (10000 doś.)"

#: data/mods/BombasticPerks/corefiles/config_menu.json
#. ~ NPC dialogue line
