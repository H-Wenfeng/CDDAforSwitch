msgstr[0] "przerośnięty rybik"
msgstr[1] "przerośnięte rybiki"
msgstr[2] "przerośniętych rybików"
msgstr[3] "przerośniętego rybika"

#: data/json/monsters/insect_spider.json
#. ~ Description of monster "oversized silverfish"
msgid "An oversized mutated silverfish the size of a small dog."
msgstr "Przerośnięty zmutowany rybik wielkości małego psa."

#: data/json/monsters/insect_spider.json
