#: data/mods/Aftershock/mutations/integrated.json
#: data/mods/aftershock_exoplanet/mutations/integrated.json
#. ~ Description of "wooly fur"
msgid ""
"A course thick matt of fur, somewhere between a ballistic vest and attic "
"insulation."
msgstr ""

#: data/mods/Aftershock/mutations/integrated.json
#: data/mods/aftershock_exoplanet/mutations/integrated.json
#. ~ Description of "sparse scales"
msgid "Your dermis has toughened and thickened to provide additional protection."
msgstr ""

#: data/mods/Aftershock/mutations/mutation_eocs.json
#: data/mods/aftershock_exoplanet/mutations/mutation_eocs.json
#. ~ Player message in effect in EoC "EOC_RAD_ADAP_activated"
msgid ""
"You think about activating your immune system and your body warms with "
"exertion."
msgstr ""

#: data/mods/Aftershock/mutations/mutation_eocs.json
#: data/mods/aftershock_exoplanet/mutations/mutation_eocs.json
#. ~ Player message in false effect in EoC "EOC_RAD_ADAP_activated"
#. ~ Player message in false effect in EoC "EOC_RAD_FLUSH_activated"
msgid "You are too exhausted to focus your immune system."
msgstr ""

#: data/mods/Aftershock/mutations/mutation_eocs.json
#: data/mods/aftershock_exoplanet/mutations/mutation_eocs.json
#. ~ Player message in effect in EoC "EOC_RAD_FLUSH_activated"
msgid ""
"You think quite pointedly about activating your immune system and your body "
"hums with exertion."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Earthling"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Earthling"
msgid ""
"Your mannerisms and accent are a dead giveaway that you were raised on Earth. "
" Whatever your thoughts about the homeworld might be, the simple fact that "
"you can call it home is likely to affect relationships with people liable to "
"care about such things."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Local System Security"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Local System Security"
msgid ""
"You are a duly sworn law enforcement officer, with jurisdiction that "
"technically extends to the Salus System.  Whether you can find anyone who "
"that matters to is questionable."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Pinkerton"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Pinkerton"
msgid ""
"You are an UICA affiliated private-security professional, with jurisdiction "
"that technically extends to the Salus System.  Whether you can find anyone "
"who that matters to is questionable."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "MD"
msgid ""
"You're a doctor who went out to space and has somehow ended up out on the "
"frontier in the Salus System.  At least out here you get a lot more hands on "
"life or death work compared to the core UICA worlds."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Rediscovered Tribal"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Rediscovered Tribal"
msgid ""
"Some worlds maintained human life but lost technologically advanced "
"civilization.  As these worlds get rediscovered some organizations leave the "
"worlds to develop, while others see a source of cheap labor.  Whether you "
"snuck onto a ship or were Shanghaied onto one you've somehow ended up on the "
"hell that is Salus IV.  At least you have some experience surviving outside "
"of what these spacers call 'civilization'."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "UICA Inspector"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "UICA Inspector"
msgid ""
"You are a UICA Inspector from a civilized part of space.  You have the "
"authority to investigate under a variety of different legal frameworks, UICA, "
"planetary, corporate, system, pre-Discontinuity legal systems for worlds that "
"have only recently been re-discovered.  All of this means that you are nearly "
"a law unto yourself, though you wonder how much that matters in a place like "
"Salus IV outside of maybe Port Augustmoon."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "UICA Astrographic and Gatepoint Agent"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "UICA Astrographic and Gatepoint Agent"
msgid ""
"As a member of the Astrographic and Gatepoint Division you are responsible "
"for spreading the boundaries of the Frontiers and protecting interstellar "
"travel.  This gives you wide ranging latitude when it comes to addressing "
"threats to interstellar travel.  Does this technically make you a member of "
"UICA's very own secret police?  Yes, yes it does."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation class name
#. ~ Mutation name
msgid "YUGGOTH"
msgstr "YUGGOTH"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ "mutagen_message" of mutation class "YUGGOTH"
msgid ""
"Strange memories of another world overwhelm you…  they fade, but not before "
"you change your genetic structure to suit them."
msgstr ""
"Dziwne wspomnienia z innego świata przytłaczają cię… znikają, ale nie "
"wcześniej niż zmienisz swoją strukturę genetyczną, aby je dostosować."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation class name
msgid "Mastodon"
msgstr "Mastodont"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ "mutagen_message" of mutation class "Mastodon"
msgid "You feel a desire to trumpet and toot."
msgstr "Czujesz chęć dąć w trąbę."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Killophant"
msgstr "Killofant"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Killophant"
msgid ""
"Your species was created as the ultimate shock troop.  Inherit the earth, "
"pedigree your ancestors, crush the foe."
msgstr ""
"Twój gatunek został stworzony jako ostateczny oddział uderzeniowy. Odziedzicz "
"ziemię, kontynuuj dzieło swoich przodków, zmiażdż wroga."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Mi-go acclimatization"
msgstr "Aklimatyzacja mi-go"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Mi-go acclimatization"
msgid ""
"Fleshy fronds grown from your scalp function like organic heat sinks.  They "
"allow you to live comfortably within the mi-go atmosphere."
msgstr ""
"Mięsiste liście wyrastające z twojej skóry głowy działają jak organiczne "
"radiatory. Pozwalają wygodnie żyć w atmosferze mi-go."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Radioactive Environment Adaptation"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Radioactive Environment Adaptation"
msgid ""
"You think you know how to instruct your body to process radioactive particles "
"out of itself faster than normal."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Radiation Flush "
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Radiation Flush "
msgid ""
"You can instruct your immune system to flush out radioactive particles at an "
"enviable speed."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Facial Tentacles"
msgstr "Macki na twarzy"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Mouth Tendrils"
msgstr "Wicie w ustach"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "fungivoral immune system"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "fungivoral immune system"
msgid ""
"The immune system of these beings transcends anything seen in humanity and "
"appear to be able to target even directed infections such as fungal "
"infestations."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Warm Natured"
msgstr "Ciepłolubność"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Warm Natured"
msgid "Your body becomes much more efficient at distributing heat from itself."
msgstr "Twoje ciało staje się znacznie wydajniejsze w rozprowadzaniu ciepła z siebie."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Thick Hide"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Thick Hide"
msgid ""
"Your skin has thickened and toughened further, acting as natural armor.  "
"Somewhat reduces wet effects."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Rhomboidal Denticles"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Rhomboidal Denticles"
msgid ""
"Your skin has thick diamond shaped enamel scutes that both armor your body "
"and allow you to move more smoothly in water.  While difficult to penetrate, "
"it also limits your flexibility.  Greatly reduces wet effects."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Neural Improvement"
msgstr "Naturalne usprawnienia"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Neural Improvement"
msgid "You see the world a little differently today.  Intelligence + 1"
msgstr "Dziś widzisz świat trochę inaczej. Inteligencja +1"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Expanded Consciousness"
msgstr "Rozszerzona świadomość"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Expanded Consciousness"
msgid "You are beginning to see a way off this planet.  Intelligence + 2"
msgstr "Zaczynasz widzieć wyjście z tej planety. Inteligencja +2"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Uplifted Consciousness"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Uplifted Consciousness"
msgid ""
"As humans uplifted our pets in the final years this process is lifting you to "
"a new level of intelligence.  Intelligence + 4"
msgstr ""
"Ponieważ ludzie unieśli nasze zwierzęta w ostatnich latach, ten proces wznosi "
"was na nowy poziom inteligencji. Inteligencja +4"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Alien Intelligence"
msgstr "Kosmiczna inteligencja"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Alien Intelligence"
msgid ""
"You can see the connections from A to B to C to D.  You look at fellow "
"survivors like you are imagining taking them apart.  Intelligence + 5"
msgstr ""
"Możesz zobaczyć połączenia od A do B do C do D. Patrzysz na innych ocalałych "
"tak jak wyobrażasz sobie rozkładanie ich na części. Inteligencja +5"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Enhanced Reactions"
msgstr "Rozszerzone reakcje"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Enhanced Reactions"
msgid "Today is the day to start juggling.  Dexterity + 1"
msgstr "Dziś jest dzień, w którym trzeba zacząć żonglować. Zręczność +1"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Quickening"
msgstr "Przyspieszenie"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Quickening"
msgid "You are starting to move like they do.  Dexterity + 2"
msgstr "Zaczynasz się poruszać tak jak oni. Zręczność +2"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Otherworldly Grace"
msgstr "Gracja z innego świata"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Otherworldly Grace"
msgid "You no longer move like a human, others find it disconcerting.  Dexterity + 4"
msgstr ""
"Nie poruszasz się już jak człowiek, inni uważają to za niepokojące. Zręczność "
"+4"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "New Muscles"
msgstr "Nowe mięśnie"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "New Muscles"
msgid ""
"You see some new muscles that you aren't sure you've seen on humans before.  "
"Strength + 1"
msgstr "Widzisz nowe mięśnie, których wcześniej nie widziałeś u ludzi. Siła +1"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Muscle Fiber"
msgstr "Włókno mięśniowe"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Muscle Fiber"
msgid "Fibrous tissue seems to be spreading through your body.  Strength + 2"
msgstr "Wydaje się, że tkanka włóknista rozprzestrzenia się po twoim ciele. Siła +2"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Mi-go Ears"
msgstr "Uszy mi-go"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Mi-go Ears"
msgid ""
"Your ears have split into a series of tuberous projections.  They waggle "
"towards far away sounds."
msgstr ""
"Twoje uszy podzieliły się na serię bulwiastych projekcji. Kiwają się w stronę "
"odległych dźwięków."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Detachment"
msgstr "Oderwanie"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Detachment"
msgid ""
"When were you ever like these creatures, helpless before the changes ravaging "
"this world."
msgstr "Kiedy byłeś jak te stworzenia, bezradny wobec zmian niszczących ten świat."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Eldritch"
msgstr "Złowrogość"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Eldritch"
msgid ""
"You have a sinister aspect to your demeanor, no longer part of this world.  "
"You feel no sorrow at the deaths of humans and your brain now processes "
"combat skills more efficiently as you mentally dissect your opponents."
msgstr ""
"Masz złowieszczy aspekt twojego zachowania, który nie jest już częścią tego "
"świata. Nie odczuwasz smutku z powodu śmierci ludzi, a twój mózg efektywniej "
"przetwarza teraz umiejętności bojowe, gdy mentalnie robisz sekcję swoich "
"przeciwników."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "YUGGOTH"
msgid "The death throes of this world are the birthing pangs of yours."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Fetid scent"
msgstr "Cuchnący zapach"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Fetid scent"
msgid ""
"Your sweat now smells otherworldly, and not in a good way.  The mi-go still "
"hate you but at least they aren't offended by your smell."
msgstr ""
"Twój pot teraz pachnie jak nie z tego świata i to nie w dobrym tego słowa "
"znaczeniu. Mi-go nadal cię nienawidzą, ale przynajmniej nie są zdegustowani "
"twoim zapachem."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Eerie"
msgstr "Straszliwość"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Eerie"
msgid ""
"You are off-putting to others.  Your mannerisms have changed as if human "
"interaction is becoming foreign."
msgstr ""
"Zrażasz innych. Twoje maniery zmieniły się, jakby interakcje międzyludzkie "
"stały się obce."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Mi-go Wings"
msgstr "Skrzydła mi-go"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Mi-go Wings"
msgid ""
"You have a pair of large, veiny wings.  They don't appear to be made for this "
"atmosphere but they grant a powerful buffeting attack."
msgstr ""
"Masz parę dużych, żylastych skrzydeł. Nie wydają się być stworzone dla tej "
"atmosfery, ale zapewniają potężny sponiewierający atak."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Message when player with mutation "Mi-go Wings" attacks
#, c-format
msgid "You buffet %s with your wings"
msgstr "Poniewierasz %s swoimi skrzydłami"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Message when NPC with mutation "Mi-go Wings" attacks
#, c-format
msgid "%1$s buffets %2$s with their wings"
msgstr "%1$s sponiewiera %2$s swoimi skrzydłami"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Mi-go breathe"
msgstr "Oddech mi-go"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Mi-go breathe"
msgid "You can now breathe the gasses the mi-go thrive in."
msgstr "Możesz teraz wdychać gazy, z których korzystają mi-go."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Uplifted"
msgstr "Wzniesienie"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Uplifted"
msgid ""
"You come from uplifted animal stock.  This decreases morale penalties for "
"being wet."
msgstr "Pochodzisz z wzniesionego bydła. Redukuje to kary za przemoczenie."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/BombasticPerks/perks.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Hauler"
msgstr "Dźwigacz"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Hauler"
#, no-c-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 60%."
msgstr ""
"Jesteś w stanie unieść znacznie więcej niż ktoś o podobnej sile. Twój "
"maksymalny udźwig jest większy o 60%."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Patched Fur"
msgstr "Połatane futro"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Patched Fur"
msgid ""
"Your skin has patches of light fur.  This has no impact on your life except "
"marking you as not fully human."
msgstr ""
"Twoja skóra ma łatki lekkiego futra. Nie ma to wpływu na twoje życie, z "
"wyjątkiem oznaczenia cię jako nie w pełni człowieka."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Wooly Fur"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Crushing Feet"
msgstr "Miażdżące stopy"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Crushing Feet"
msgid ""
"Your feet have grown massive and ready to support huge weight.  This allows "
"kicking attacks to do much more damage, provides natural armor, and removes "
"the need to wear shoes; however, you cannot wear normal size shoes.  Reduces "
"wet effects."
msgstr ""
"Twoje stopy urosły do masywnych rozmiarów, gotowe utrzymać ogromny ciężar. "
"Pozwala to by kopnięcia zadawały znacznie więcej obrażeń, zapewniają "
"naturalną zbroję i usuwają potrzebę noszenia butów; jednakże nie możesz już "
"nosić obuwia w normalnych rozmiarach. Redukuje efekty przemoczenia."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Message when player with mutation "Crushing Feet" attacks
#, c-format
msgid "You kick %s with your massive feet"
msgstr "Kopiesz %s swoimi masywnymi stopami"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Message when NPC with mutation "Crushing Feet" attacks
#, c-format
msgid "%1$s kicks %2$s with their massive feet"
msgstr "%1$s kopie %2$s swoimi masywnymi stopami"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Face Bumps"
msgstr "Guzy na twarzy"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Face Bumps"
msgid "You have a pair of bumps on your face above your mouth and beside your nose."
msgstr "Masz parę guzków na twarzy nad ustami i obok nosa."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Tusks"
msgstr "Kły"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Tusks"
msgid ""
"You have a pair of small tusks on your face.  They allow you to make a weak "
"piercing goring attack."
msgstr ""
"Masz parę małych kłów na twarzy. Pozwalają na wykonanie słabego, "
"przeszywającego ataku."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Message when player with mutation "Tusks" attacks
#, c-format
msgid "You gore %s with your tusks!"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Message when NPC with mutation "Tusks" attacks
#, c-format
msgid "%1$s gores %2$s with their tusks!"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Pointed Tusks"
msgstr "Spiczaste kły"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Pointed Tusks"
msgid ""
"You have a pair of long, pointed tusks, like someone weaponized an elephant.  "
"They allow you to make a strong piercing headbutt attack, but prevent wearing "
"mouthgear that is not made of fabric."
msgstr ""
"Masz parę długich, spiczastych kłów, jakby ktoś uzbroił słonia. Pozwalają ci "
"na mocny, przebijający atak z główki, ale uniemożliwiają noszenie na ustach "
"sprzętów, które nie są wykonane z materiału."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Message when player with mutation "Pointed Tusks" attacks
#, c-format
msgid "You stab %s with your pointed tusks!"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Message when NPC with mutation "Pointed Tusks" attacks
#, c-format
msgid "%1$s stabs %2$s with their pointed tusks!"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Elephant Trunk"
msgstr "Trąba słonia"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Elephant Trunk"
msgid ""
"Your face resembles that of an elephant, with a significant trunk.  It looks "
"fierce but prevents wearing mouthgear.  Prehensile and able to perform some "
"fine detail work."
msgstr ""
"Twoja twarz przypomina twarz słonia ze znaczną trąbą. Wygląda groźnie, ale "
"uniemożliwia noszenie sprzętu na ustach. Chwytne i zdolne do wykonywania "
"drobnych szczegółowych prac."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Three Fingered"
msgstr "Trójpalczastość"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Three Fingered"
msgid ""
"Your hands have fused into three-fingered paws.  Fine manipulation is a "
"challenge: permanent hand encumbrance of 10, difficulty with delicate "
"craftwork, and your gloves don't fit.  But they handle water better."
msgstr ""
"Twoje ręce przekształciły się w trzy-palczaste łapy. Drobiazgowa manipulacja "
"to wyzwanie: stałe skrępowanie rąk 10, trudności z delikatnymi robótkami i "
"twoje rękawice nie pasują. Za to lepiej radzą sobie z wodą."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Trumpeting Voice"
msgstr "Trąbiący głos"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Trumpeting Voice"
msgid ""
"You have a trumpeting, elephantine voice.  Threatening NPCs will be easier, "
"but lying will be very hard."
msgstr ""
"Masz trąbiący, słoniowaty głos. Zastraszanie NPC będzie łatwiejsze, ale "
"kłamstwo będzie bardzo trudne."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Brutal Strength"
msgstr "Brutalna siła"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Brutal Strength"
msgid "Genetic tampering made your body incredibly strong.  Strength + 7."
msgstr "Manipulacje genetyczne zrobiły twoje ciało niesamowicie silne. Siła +7."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Cryoadaptation"
msgstr "Krioadaptacja"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Cryoadaptation"
msgid ""
"An experimental cryosleep procedure has permanently altered your body, "
"allowing you to better tolerate cold temperatures."
msgstr ""
"Eksperymentalna procedura snu kriogenicznego trwale zmieniła twoje ciało, "
"pozwalając ci lepiej tolerować niskie temperatury."

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Empathic Leadership"
msgstr "Empatyczne przywództwo"

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Empathic Leadership"
msgid ""
"You have a natural talent for leadership and can easily see yourself in "
"others.  Quite literally.  In fact, you can swap control to any other "
"character that follows you."
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Mutation name
msgid "Skullgun Stupidity"
msgstr ""

#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Skullgun Stupidity"
msgid ""
"You took the bionic skullgun out of your noggin, but that didn't replace the "
"brain cells you lost when you installed it."
msgstr ""

#: data/mods/Aftershock/npcs/TALK_COMMON_OVERRIDES.json
#: data/mods/aftershock_exoplanet/npcs/TALK_COMMON_OVERRIDES.json
#. ~ Response to NPC dialogue
msgid "Switch to controlling this follower"
msgstr ""

#: data/mods/Aftershock/npcs/TALK_COMMON_OVERRIDES.json
