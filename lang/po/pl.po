msgid "frigate fly"
msgid_plural "frigate flies"
msgstr[0] "mucha-fregata"
msgstr[1] "muchy-fregaty"
msgstr[2] "much-fregat"
msgstr[3] "muchy-fregaty"

#: data/json/monsters/insect_spider.json
#. ~ Description of monster "frigate fly"
msgid ""
"A mutant housefly the size of a cow, creating a loud buzzing sound as it "
"inexplicably stays airborne."
msgstr ""
"Zmutowana mucha domowa wielkości krowy, wydająca głośny, brzęczący dźwięk, "
"gdy w niewytłumaczalny sposób utrzymuje się w powietrzu."

#: data/json/monsters/insect_spider.json
#. ~ Monster name
msgid "oversized mosquito"
msgid_plural "oversized mosquitos"
msgstr[0] "przerośnięty komar"
msgstr[1] "przerośnięte komary"
msgstr[2] "przerośniętych komarów"
msgstr[3] "przerośniętego komara"

#: data/json/monsters/insect_spider.json
#. ~ Description of monster "oversized mosquito"
msgid "A mutant mosquito the size of a small dog, buzzing and fluttering erratically."
msgstr "Zmutowany komar rozmiaru małego psa, który bzyczy i polatuje chaotycznie."

#: data/json/monsters/insect_spider.json
#. ~ Monster name
msgid "giant mosquito"
msgid_plural "giant mosquitos"
msgstr[0] "gigantyczny komar"
msgstr[1] "gigantyczne komary"
msgstr[2] "gigantycznych komarów"
