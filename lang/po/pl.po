msgstr "%s wyrzuca zawartość swojej torby na podłogę i rzuca torbę na sam wierzch."

#: src/monattack.cpp:2710 src/monattack.cpp:2730
#, c-format
msgid "The %s flashes a LED and departs.  Human officer on scene."
msgstr "%s błyska diodą i oddala się. Ludzki oficer na miejscu."

