msgstr[1] "gigantyczne rybiki"
msgstr[2] "gigantycznych rybików"
msgstr[3] "gigantycznego rybika"

#: data/json/monsters/insect_spider.json
#. ~ Description of monster "giant silverfish"
msgid ""
"A mutant silverfish roughly the size of a person.  Doesn't seem at all "
"interested in you."
msgstr ""
"Zmutowany rybik mniej więcej wielkości człowieka. Nie wydaje się być tobą "
"zainteresowany."

#: data/json/monsters/insect_spider.json
