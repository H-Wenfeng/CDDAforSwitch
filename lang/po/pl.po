#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "No Extras"
msgstr "Bez dodatków"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "No Extras"
msgid "You don't have any tails, whiskers, horns, or miscellaneous extra bits."
msgstr "Nie masz żadnych ogonów, wąsów, rogów lub innych dodatkowych elementów."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Arms"
msgstr "Ludzkie ręce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Arms"
msgid "You have human arms."
msgstr "Masz ludzkie ręce."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Blood"
msgid "You have human blood."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Ears"
msgstr "Ludzkie uszy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Ears"
msgid "You have human ears and hearing."
msgstr "Masz ludzkie uszy i słuch."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Eyes"
msgstr "Ludzkie oczy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Eyes"
msgid "You have human eyes."
msgstr "Masz ludzkie oczy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Hands"
msgstr "Ludzkie dłonie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Hands"
msgid "You have human hands."
msgstr "Masz ludzkie dłonie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Healing"
msgstr "Ludzkie leczenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Healing"
msgid "You heal as fast as most humans do in this new world."
msgstr "Leczysz się tak szybko, jak większość ludzi w tym nowym świecie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Legs"
msgstr "Ludzkie nogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Legs"
msgid "You have human legs."
msgstr "Masz ludzkie nogi."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Metabolism"
msgstr "Ludzki metabolizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Metabolism"
msgid "Your digestive system and cardio health are standard for a human."
msgstr "Twój układ trawienny i zdrowie układu krążenia są normalne dla człowieka."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Mouth"
msgstr "Ludzkie usta"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Mouth"
msgid "You have a human mouth with human teeth."
msgstr "Masz ludzkie usta i ludzkie zęby."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Voice"
msgstr "Ludzki głos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Voice"
msgid "Your voice doesn't sound especially abnormal."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Skin"
msgstr "Ludzka skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Skin"
msgid "You have human skin and no distinct smell."
msgstr "Masz ludzką skórę i brak charakterystycznego zapachu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Rest"
msgstr "Ludzki odpoczynek"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Rest"
msgid "You sleep a normal amount for a human."
msgstr "Śpisz normalnie, tak jak człowiek."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Capabilities"
msgstr "Ludzkie możliwości"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Capabilities"
msgid "Your capabilities are pretty normal."
msgstr "Twoje możliwości są całkiem normalne."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Mind"
msgstr "Ludzki umysł"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Mind"
msgid "Your mind and brain chemistry are not mutated."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Immunity"
msgstr "Ludzka odporność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Immunity"
msgid "Your immune system is more or less normal for a human."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Human Acclimatization"
msgstr "Ludzka aklimatyzacja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Human Acclimatization"
msgid "Your temperature tolerance is more or less normal for a human."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fleet-Footed"
msgstr "Zwinne stopy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fleet-Footed"
#, no-c-format
msgid ""
"You can move more quickly than most, resulting in a 15% speed bonus on sure "
"footing."
msgstr ""
"Poruszasz się szybciej niż inni, więc masz 15% bonusu do szybkości na pewnym "
"podłożu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Reflex Photophore"
msgstr "Refleksyjne fotofory"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Reflex Photophore"
msgid ""
"A photophore has grown from your head.  You can't consciously control it, and "
"it might start to shine in response to your emotions or your physiological "
"state."
msgstr ""
"Fotofory wyrosły z twojej głowy. Nie możesz tego świadomie kontrolować i może "
"zacząć świecić w odpowiedzi na twoje emocje lub stan fizjologiczny."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Weak Photophore"
msgstr "Słabe fotofory"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Weak Photophore"
msgid ""
"A photophore has grown from your head; you can make it glow softly.  This "
"will make you very visible in the dark, ideal for attracting a partner during "
"mating season."
msgstr ""
"Fotofory wyrosły z twojej głowy; możesz sprawić, że będą delikatnie świecić. "
"Dzięki temu będziesz bardzo widoczny w ciemności, idealny do zwabienia "
"partnera w okresie godowym."

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Weak Photophore" to
#. "BIOLUM1_active"
#. ~ Message when transforming from mutation  "Photophore" to "BIOLUM2_active"
msgid "Your photophore starts glowing."
msgstr "Twoje fotofory zaczynają świecić."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Weak Photophore (on)"
msgstr "Słabe fotofory (wł.)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Weak Photophore (on)"
msgid "Your photophore is glowing softly."
msgstr "Twoje fotofory świecą delikatnie."

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Weak Photophore (on)" to
#. "BIOLUM1"
#. ~ Message when transforming from mutation  "Photophore (on)" to "BIOLUM2"
msgid "Your photophore stops glowing."
msgstr "Twoje fotofory zaczynają świecić."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Photophore"
msgstr "Fotofory"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Photophore"
msgid "You can make your photophore glow brightly."
msgstr "Możesz sprawić, że fotofory będą świecić jasno."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Photophore (on)"
msgstr "Fotofory (wł.)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Photophore (on)"
msgid "You photophore is glowing brightly."
msgstr "Twoje fotofory świecą jasno."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bioluminescent Flare"
msgid ""
"You can spit a wad of bioluminescent goo several meters away.  There it will "
"light up its surroundings until it dissipates."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Normal Human"
msgstr "Normalny człowiek"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Normal Human"
msgid "You're a normal human; there's nothing wrong with you.  No need to worry."
msgstr ""
"Jesteś normalnym człowiekiem, wszystko z tobą w porządku. Nie ma powodów do "
"obaw."

#: data/json/mutations/mutations.json
#. ~ Trigger message of mutation "Normal Human"
msgid "Everything is terrible and this makes you so ANGRY!"
msgstr "Wszystko jest okropne i to sprawia, że czujesz taką ZŁOŚĆ!"

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Normal Human" to "HYDE"
msgid "The anger overtakes you!"
msgstr "Pochłania cię złość!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Violent Monster"
msgstr "Brutalny potwór"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Violent Monster"
msgid "Anger clouds your mind; you can't think straight, but you feel strong."
msgstr "Gniew zaciemnia twój umysł; nie możesz myśleć trzeźwo, ale czujesz się silny."

#: data/json/mutations/mutations.json
#. ~ Trigger message of mutation "Violent Monster"
msgid "As the morning comes, you return back to normal."
msgstr "Gdy nadchodzi poranek, wracasz do normalności."

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Violent Monster" to "JEKYLL"
msgid "The anger subsides."
msgstr "Złość ustępuje."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Seasonal Affective Disorder"
msgstr "Sezonowe zaburzenie afektywne"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Seasonal Affective Disorder"
msgid ""
"You tend to have bouts of depression during the fall and especially winter.  "
"Taking antidepressants can help."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Good Hearing"
msgstr "Dobry słuch"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Good Hearing"
msgid ""
"Your hearing is better than average, and you can hear distant sounds more "
"easily."
msgstr "Masz ponadprzeciętny słuch i łatwiej ci usłyszeć dalekie odgłosy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bat Ears"
msgstr "Uszy nietoperza"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bat Ears"
msgid ""
"Your broad, pointed ears are like radar dishes.  You can hear even the "
"slightest sounds at great distance, and are less likely to be deafened by "
"loud noises."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Echolocation"
msgstr "Echolokacja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Echolocation"
msgid ""
"You've learned how to hunt without sight.  Activate this mutation to make a "
"quiet chirp that can reveal obstacles and enemies by its echo."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Leaf Nose"
msgstr "Liściasty nos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Leaf Nose"
msgid ""
"Your nose is upturned, ridged and flared out into a leaf shape that humans "
"will likely find unsightly.  On the plus side, thermoreceptors in your "
"nostrils allow you to smell heat as long as you can breathe."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fey Hearing"
msgstr "Elfi słuch"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fey Hearing"
msgid ""
"You're not sure the shape of your ears is helping you any; regardless, you "
"have become very sensitive to sounds."
msgstr ""
"Nie masz pewności, czy kształt twoich uszu ci w jakikolwiek sposób pomaga; "
"niezależnie od tego, stałeś się bardzo wrażliwy na dźwięki."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Inattentive"
msgid ""
"You never paid attention to your surroundings and specifically to people "
"around you.  You can't judge the intent of critters you see."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Outdoorsman"
msgstr "Człowiek lasu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Outdoorsman"
msgid ""
"You are accustomed to being exposed to the elements.  This decreases morale "
"penalties for being wet."
msgstr ""
"Jesteś przyzwyczajony do bycia wystawionym na żywioły. Obniża kary za bycie "
"mokrym."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Indefatigable"
msgstr "Niestrudzenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Indefatigable"
msgid ""
"Whether due to exercise and good diet, or due to a natural propensity to "
"physical endurance, you tire due to physical exertion much less readily than "
"others.  Your cardio fitness and maximum stamina are higher than usual."
msgstr ""
"Czy to dzięki ćwiczeniom i diecie, czy też naturalnym predyspozycjom, męczysz "
"się wysiłkiem fizycznym znacznie mniej od innych. Twoja kondycja i maksymalna "
"stamina są wyższe niż zwykle."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hyperactive"
msgstr "Nadpobudliwość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hyperactive"
msgid ""
"Your body's efficiency is like that of a tiny furnace, greatly increasing "
"your cardio and stamina."
msgstr ""
"Wydajność twojego ciała jest jak małego pieca, znacznie zwiększając twoją "
"kondycję i maksymalną staminę."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Quick"
msgstr "Szybkość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Quick"
#, no-c-format
msgid "You're just generally quick!  You get a 10% bonus to action points."
msgstr "Szybkość to twoja cecha! Masz 10% bonusu do punktów akcji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tunnel Fighter"
msgstr "Tunelowy wojownik"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tunnel Fighter"
msgid ""
"You know how to fight in cramped tunnels at risk of collapse.  You gain "
"bonuses when fighting underground."
msgstr ""
"Wiesz jak walczyć w ciasnych tunelach zagrożonych zawaleniem. Otrzymujesz "
"bonusy podczas walki pod ziemią."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Night Raider"
msgstr "Nocny łupieżca"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Night Raider"
msgid ""
"Your body is one with the night.  You make less noise when the moon is up in "
"the sky, even when you cannot see it."
msgstr ""
"Twoje ciało jest jednością z nocą. Robisz mniej hałasu, gdy księżyc jest na "
"niebie, nawet jeśli go nie widzisz."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Portal Dependent"
msgstr "Zależność od portali"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Portal Dependent"
msgid ""
"You feel alien in your own body, as if part of you remained behind with the "
"storm.  You will suffer severely when not exposed to portal storms unless you "
"find a way to anchor yourself to the world again."
msgstr ""
"Czujesz się obco we własnym ciele, tak jakby część ciebie pozostała z tyłu "
"wraz z burzą. Jeśli nie narazisz się na burze portalowe, będziesz bardzo "
"cierpieć, chyba że znajdziesz sposób na ponowne zakotwiczenie się w świecie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Stabilized in Reality"
msgstr "Stabilizacja w realności"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Stabilized in Reality"
msgid ""
"You have regained some substance and have stabilized somewhat, if not "
"entirely.  Portal storm withdrawal will not affect you as strongly as before."
msgstr ""
"Udało ci się odzyskać trochę substancji i nieco się ustabilizować, jeśli nie "
"całkowicie. Wycofanie się z burzy portalowej nie będzie miało na ciebie tak "
"silnego wpływu jak wcześniej."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Optimist"
msgid ""
"Nothing gets you down!  You savor the joys of life, ignore its hardships, and "
"are generally happier than most people."
msgstr ""
"Nic cię nie przygnębia! Delektujesz się radościami życia, ignorujesz "
"trudności i ogólnie odczuwasz więcej szczęścia niż większość ludzi."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fast Healer"
msgstr "Szybkie leczenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fast Healer"
msgid "Your wounds and broken limbs heal quicker than usual."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Light Eater"
msgstr "Mniejszy apetyt"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Light Eater"
msgid "Your metabolism is a little slower, and you require less food than most."
msgstr "Masz wolniejszy metabolizm i nie potrzebujesz tyle jedzenia co inni."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Accomplished Sleeper"
msgstr "Dobry śpioch"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Accomplished Sleeper"
msgid ""
"You have always been able to fall asleep easily, even when sleeping in less "
"than ideal circumstances."
msgstr "Zawsze łatwo zasypiasz, nawet w mniej niż idealnych warunkach."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Practiced Sleeper"
msgstr "Wyszkolony śpioch"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Practiced Sleeper"
msgid ""
"Your body's demanding energy needs mean you can fall asleep just about "
"anywhere."
msgstr ""
"Wymagające potrzeby energetyczne twojego ciała oznaczają, że możesz zasnąć "
"niemal wszędzie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Earth Sleeper"
msgstr "Ziemny śpioch"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Earth Sleeper"
msgid "You always sleep better surrounded by earth."
msgstr "Zawsze śpisz lepiej otoczony ziemią."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Aquatic Sleeper"
msgstr "Wodny śpioch"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Aquatic Sleeper"
msgid "You always sleep better underwater."
msgstr "Zawsze śpisz lepiej pod wodą."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pain Resistant"
msgstr "Odporność na ból"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pain Resistant"
msgid "You have a high tolerance for pain."
msgstr "Masz wysoką tolerancję na ból."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Night Vision"
msgstr "Widzenie w ciemności"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Night Vision"
msgid ""
"You possess natural night vision, and can see further in the dark than most.  "
"Activate to toggle NV-visible areas on or off."
msgstr ""
"Posiadasz naturalną zdolność widzenia w ciemnościach i widzisz w nich dalej "
"niż inni. Aktywuj, by widzieć lub ukryć widziane w noktowizji obszary."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Poison Resistant"
msgstr "Odporność na trucizny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Poison Resistant"
msgid ""
"Your system is rather tolerant of poisons and toxins, and most will affect "
"you less."
msgstr ""
"Twoje ciało jest bardziej odporne na trucizny i toksyny, więc większość "
"będzie miała na ciebie słabsze działanie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fast Reader"
msgstr "Szybkie czytanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fast Reader"
msgid "You're a quick reader, and can get through books a lot faster than most."
msgstr "Szybko czytasz i pochłaniasz książki szybciej niż inni."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tough Feet"
msgstr "Twarde stopy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tough Feet"
msgid ""
"The bottoms of your feet are tough, and you are accustomed to going barefoot. "
" You receive no movement penalty for not wearing shoes."
msgstr ""
"Podeszwy twoich stóp są twarde i przyzwyczajone do chodzenia boso. Nie masz "
"kar do poruszania się bez butów."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bovine Bulk"
msgstr "Bycza masa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bovine Bulk"
msgid ""
"Your flesh has become dense with fat and muscle.  This makes you harder to "
"take down, but also a poor swimmer."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bull Roids"
msgstr "Byczy doping"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bull Roids"
msgid ""
"Your bulk has rendered you a veritable living wall.  Be careful around water "
"though; while you're as sturdy as a rock, you'll sink like one too."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tough"
msgstr "Siła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tough"
#, no-c-format
msgid "It takes a lot to bring you down!  You get a 20% bonus to all hit points."
msgstr "Wiele trzeba, żeby cię powalić. Masz 20% bonusu do HP."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Durable"
msgstr "Wytrzymałość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Durable"
#, no-c-format
msgid "You can shrug off almost anything!  You get a 30% bonus to all hit points."
msgstr "Możesz przetrwać niemal wszystko! Masz 30% bonusu do HP."

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/effects/effects.json
#: data/mods/Xedra_Evolved/spells/eater_spells.json
#. ~ Mutation name
#. ~ Name of spell "spell_unbreakable"
msgid "Unbreakable"
msgstr "Niezłomność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Unbreakable"
#, no-c-format
msgid "Nothing can break you!  You get a 40% bonus to all hit points."
msgstr "Nic cię nie złamie! Masz 40% bonusu do HP."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Thick-Skinned"
msgstr "Twarda skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Thick-Skinned"
msgid ""
"Your skin is tough.  Cutting and bashing damage is slightly reduced for you.  "
"There's a small chance you don't cut yourself on sharp terrain."
msgstr ""
"Twoja skóra jest twarda. Obrażenia sieczne i obuchowe są u ciebie lekko "
"zredukowane. Jest mała szansa, że nie skaleczysz się na ostrym terenie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Packmule"
msgstr "Dobre pakowanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Packmule"
#, no-c-format
msgid ""
"You pack things very efficiently!  You can retrieve things from containers "
"10% faster."
msgstr ""
"Pakujesz rzeczy bardzo wydajnie! Możesz pobierać rzeczy z pojemników 10% "
"szybciej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Strong Back"
msgstr "Silne plecy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Strong Back"
#, no-c-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 35%."
msgstr ""
"Masz zdolność niesienia dużo więcej niż ktoś o podobnej sile. Twój maksymalny "
"udźwig jest większy o 35%."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fast Learner"
msgstr "Szybkie uczenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fast Learner"
msgid ""
"You have a flexible mind, allowing you to learn skills much faster than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Masz elastyczny umysł, co pozwala ci się uczyć umiejętności szybciej niż "
"inni. Dotyczy to jednak wiedzy pochodzącej z praktyki, a nie z lektury "
"książek."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rigid Table Manners"
msgstr "Surowe zasady przy stole"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rigid Table Manners"
msgid ""
"You've been taught proper table manners from your early childhood on; now, "
"you can't even think about eating without being seated at a table and taking "
"your time.  Eating without a table and chair frustrates you, but eating like "
"a civilized person gives you a bigger morale bonus."
msgstr ""
"Od dziecka wpojono ci zasady zachowania przy stole. Teraz nawet nie potrafisz "
"myśleć o jedzeniu bez siedzenia spokojnie przy stole. Jedzenie bez stołu i "
"krzesła powoduje frustrację, ale posiłek spożyty jak cywilizowana osoba daje "
"ci większy bonus do morale."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Strong Stomach"
msgstr "Odporny żołądek"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Strong Stomach"
msgid ""
"You are less likely to throw up from food poisoning, alcohol, etc.  If you "
"throw up despite this, you won't suffer any residual nausea."
msgstr ""
"Masz mniejsze szanse na zwymiotowanie z powodu zatrucia pokarmowego, "
"alkoholu, itp. Jeśli jednak zwymiotujesz, to nie będziesz cierpieć na "
"nudności."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Stomach Cleanse"
msgstr "Oczyszczanie żołądka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Stomach Cleanse"
msgid ""
"You have gained the ability to invert your stomach outside your body to "
"quickly eliminate toxins, and are more likely to throw up from food "
"poisoning, alcohol, etc.  If you throw up because of this, you won't suffer "
"any residual nausea."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Good Memory"
msgstr "Dobra pamięć"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Good Memory"
msgid ""
"You have an exceptional memory, and find it easy to remember things.  "
"However, you don't benefit as much as other people from dropping a subject "
"for a while and will thus end up learning slower."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Deft"
msgstr "Zwinność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Deft"
msgid ""
"While you're not any better at melee combat, you are better at recovering "
"from a miss, and will be able to attempt another strike faster."
msgstr ""
"Mimo, że nie masz lepszych umiejętności w walce w zwarciu, to jednak lepiej "
"odzyskujesz równowagę gdy spudłujesz i szybciej wymierzysz kolejny cios."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Spiritual"
msgstr "Uduchowienie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Spiritual"
msgid ""
"You've always felt that there is more to the world than we can see.  Whether "
"driven by religious beliefs or philosophical interest, you find great "
"inspiration in studying holy texts and experiencing mystical things."
msgstr ""
"Zawsze wydawało ci się, że jest w tym świecie coś czego oko nie widzi. Czy to "
"napędzany religijnym zapałem, czy filozofią życiową, czerpiesz wielką "
"inspirację ze studiowania świętych tekstów i doświadczania mistycznych rzeczy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Substance Tolerance"
msgstr "Tolerancja substancji"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Substance Tolerance"
msgid "You can handle intoxicants well.  Their effects clear up more quickly for you."
msgstr ""
"Dobrze radzisz sobie z substancjami odurzającymi. Ich efekty szybciej się "
"rozpływają w twoim przypadku."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Gourmand"
msgstr "Smakostwo"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Gourmand"
msgid ""
"You eat faster, and can eat and drink more, than anyone else!  You also enjoy "
"food more; delicious food is better for your morale, and you don't mind "
"unsavory meals as much.  Activate to skip prompt for overeating."
msgstr ""
"Jesz szybciej i możesz zjeść i wypić więcej niż inni. Ponadto czerpiesz "
"więcej radości z jedzenia. Pyszne żarcie jest lepsze dla twojego morale i nie "
"odstręczają cię nieapetyczne potrawy. Aktywuj, by pomijać alert przejedzenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tiny Stomach"
msgstr "Malutki żołądek"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tiny Stomach"
msgid ""
"Either as the result of a lifesaving surgery, or as a congenital defect, your "
"stomach is much smaller than usual.  You'll have to eat your food in small "
"servings during the day, rather than one or two large daily meals."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bookworm"
msgstr "Mól książkowy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bookworm"
msgid ""
"There's nothing quite like the smell of a good book!  Books are more fun (or "
"less boring) for you!"
msgstr ""
"Nie ma nic lepszego niż zapach dobrej książki! Książki dostarczają ci więcej "
"zabawy (lub są mniej nudne)!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Addiction Resistant"
msgstr "Odporność na uzależnienie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Addiction Resistant"
msgid ""
"Whether due to a lifetime of exposure or through simple willpower, it's "
"harder for you to become addicted to substances, and easier to rid yourself "
"of these addictions."
msgstr ""
"Czy to przez dawny żywot ćpuna, czy przez zwykłą siłę woli, trudniej ci się "
"uzależnić i łatwiej wydobyć z nałogu."

#: data/json/mutations/mutations.json
#: data/mods/BombasticPerks/perkdata/empath.json
#. ~ Mutation name
#. ~ Name of effect type id "effect_animal"
msgid "Animal Empathy"
msgstr "Zwierzęca empatia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Animal Empathy"
msgid ""
"Peaceful animals will not run away from you, and even aggressive animals are "
"less likely to attack.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"Pokojowo nastawione zwierzęta nie będą przed tobą uciekać, a drapieżniki będą "
"rzadziej atakować. Dotyczy to wyłącznie naturalnej fauny, np. leśnej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Animal Kinship"
msgstr "Więź ze zwierzętami"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Animal Kinship"
msgid ""
"Something about your presence is calming to animals, and they will treat you "
"with innate trust.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"Coś w twojej osobie powoduje łagodność zwierząt i traktują cię z wrodzonym "
"zaufaniem. Dotyczy to wyłącznie naturalnej fauny, np. leśnej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Terrifying"
msgstr "Przeraża"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Terrifying"
msgid ""
"There's something about you that creatures find frightening, and they are "
"more likely to try to flee."
msgstr ""
"Jest w tobie coś co stworzenia napawa lękiem i będą częściej przed tobą "
"uciekać."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Disease Resistant"
msgstr "Odporność na choroby"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Disease Resistant"
msgid "It's very unlikely that you will catch ambient diseases like the cold or flu."
msgstr ""
"Jest mało prawdopodobne, że złapiesz choroby z otoczenia, typu przeziębienie "
"lub grypa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "High Adrenaline"
msgstr "Wysoki poziom adrenaliny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "High Adrenaline"
msgid ""
"If you are in a very dangerous situation, you may experience a temporary rush "
"which increases your speed and strength significantly."
msgstr ""
"W niebezpiecznej sytuacji możesz doświadczyć chwilowego dopływu adrenaliny, "
"co spowoduje gwałtowny przyrost szybkości i znacząco zwiększa siłę."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Combat Adaptation"
msgstr "Adaptacja bojowa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Combat Adaptation"
msgid ""
"When you are in great danger you may flip a chemical switch in your brain and "
"for a cost in hunger, fatigue, and thirst your nervous system will process "
"things around you slightly faster.  Giving you better reaction times that you "
"can pay for later if you survive."
msgstr ""
"Kiedy jesteś w wielkim niebezpieczeństwie, możesz włączyć chemiczny "
"przełącznik w swoim mózgu, a kosztem głodu, zmęczenia i pragnienia twój układ "
"nerwowy będzie przetwarzał rzeczy wokół ciebie nieco szybciej. Daje ci lepsze "
"czasy reakcji, za które możesz zapłacić później, jeśli przeżyjesz."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Less Sleep"
msgstr "Mniej snu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Less Sleep"
msgid "You need less sleep than the average person."
msgstr "Nie potrzebujesz tyle snu, co przeciętna osoba."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Masochist"
msgstr "Masochizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Masochist"
msgid ""
"Although you still suffer the negative effects of pain, it also brings a "
"unique pleasure to you."
msgstr ""
"Mimo że nadal odczuwasz negatywne efekty bólu, to przynosi on też niezwykłą "
"przyjemność."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Stimulant Psychosis"
msgstr "Psychoza stymulantów"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Stimulant Psychosis"
msgid ""
"You have a unique history with stimulants (like coffee or amphetamines).  You "
"can tolerate a lot more of them without overdosing, but if you indulge too "
"much, you start seeing things…"
msgstr ""
"Masz barwną historię ze stymulantami (jak kawa lub amfetamina). Tolerujesz je "
"bardziej bez przedawkowania, ale jeśli pozwolisz sobie na więcej, zaczynasz "
"widzieć rzeczy…"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Light Step"
msgstr "Lekki chód"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Light Step"
msgid "You make less noise while walking.  You're also less likely to set off traps."
msgstr ""
"Robisz mniej hałasu podczas chodzenia. Jest również mniej prawdopodobne, że "
"uruchomisz pułapki."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Robust Genetics"
msgstr "Solidna genetyka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Robust Genetics"
msgid ""
"Your genome has rapidly adapted to the Cataclysm and can handle the strain of "
"mutation better.  Taking different kinds of mutagen won't result in more "
"defective mutations than normal."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Resistant Genetics"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Resistant Genetics"
msgid ""
"Your body eats up lesser mutagens faster than normal.  Exotic and esoteric "
"mutagens will still affect you normally."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Restricted Genetics"
msgstr "Genetyka z ograniczeniami"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Restricted Genetics"
msgid ""
"Your genome has become an impregnable fortress to lesser genetic deviations.  "
"You are no longer able to mutate traits that are outside of the Alpha "
"category or regress to unremarkable humanity.  Any other mutations that you "
"previously developed are safe for now."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Scout"
msgstr "Skautowanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Scout"
msgid ""
"You're an excellent navigator and your ability to recognize distant landmarks "
"is unmatched.  Your sight radius on the overmap extends beyond the normal "
"range."
msgstr ""
"Jesteś doskonałym nawigatorem a twoja zdolność do rozpoznawania odległych "
"punktów odniesienia jest niezrównana. Twój zasięg wzroku na mapie świata "
"wykracza poza normalne granice."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Topographagnosia"
msgstr "Topografoagnozia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Topographagnosia"
msgid ""
"Focal brain damage has rendered you incapable of recognizing landmarks and "
"orienting yourself in your surroundings, severely crippling your sight radius "
"on the overmap."
msgstr ""
"Ogniskowe uszkodzenie mózgu pozbawiło cię zdolności rozpoznawania punktów "
"orientacyjnych i odnajdywania się w otoczeniu, poważnie ograniczając zasięg "
"widzenia mapy głównej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cannibal"
msgstr "Kanibalizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cannibal"
msgid ""
"For your whole life you've been forbidden from indulging in your peculiar "
"tastes.  Now the world's ended, and you'll be damned if anyone is going to "
"tell you that you can't eat people."
msgstr ""
"Przez całe życie nie wolno było ci dogadzać swoim specyficznym gustom. Teraz, "
"gdy świat się skończył, do diabła, żeby ktoś ci mówił, że nie możesz jeść "
"ludzi."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Strict Humanitarian"
msgstr "Ścisły humanitaryzm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Strict Humanitarian"
msgid ""
"You're convinced that these things that look vaguely human from elsewhere are "
"definitely not people.  Therefore it's okay to eat them, right?"
msgstr ""
"Masz przekonanie, że te rzeczy, które wyglądają ledwo jak jak człowiek, "
"zdecydowanie nie są ludźmi. Dlatego można je jeść, prawda?"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Uncaring"
msgstr "Beztroska"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Uncaring"
msgid "You don't feel any strong feelings for your fellow man."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Martial Arts Training"
msgstr "Szkolenie ze sztuk walki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Martial Arts Training"
msgid ""
"You have received some martial arts training at a local dojo.  You start with "
"your choice of Karate, Judo, Aikido, Tai Chi, Taekwondo, or Pankration."
msgstr ""
"Otrzymałeś szkolenie w sztukach walki w lokalnym dojo. Zaczynasz, według "
"wyboru z karate, judo, aikido, tai chi, taekwondo lub pankration."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Self-Defense Classes"
msgstr "Lekcje samoobrony"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Self-Defense Classes"
msgid ""
"You have taken some self-defense classes at a nearby gym.  You start with "
"your choice of Boxing, Kickboxing, Capoeira, Krav Maga, Muay Thai, Ninjutsu, "
"Wing Chun, or Zui Quan."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Shaolin Adept"
msgstr "Adept szaolin"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Shaolin Adept"
msgid ""
"You have studied the arts of the Shaolin monks.  You start with one of the "
"five animal fighting styles: Tiger, Crane, Leopard, Snake, or Dragon."
msgstr ""
"Studiowałeś sztukę mnichów Szaolin. Zaczynasz z jedną ze zwierzęcych sztuk "
"walki: Tygrys, Żuraw, Lampart, Wąż lub Smok."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Melee Weapon Training"
msgstr "Trening bronią do walki w zwarciu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Melee Weapon Training"
msgid ""
"You have practiced fighting with weapons.  You start with your choice of "
"Barbaran Montante, Bōjutsu, Eskrima, Fencing, Fior Di Battaglia, Medieval "
"Swordsmanship, Niten Ichi-Ryu, Pencak Silat, or Sōjutsu."
msgstr ""
"Praktykowałeś walkę bronią białą. Zaczynasz według wyboru z barbaran "
"montante, bōjutsu, eskrima, szermierka, fior di battaglia, średniowieczne "
"władanie mieczem, niten ichi-ryu, pencak silat lub sōjutsu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Competitive Fencer"
msgstr "Zawodowy szermierz"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Competitive Fencer"
msgid ""
"You were an avid fencer, starting with foil and moving onto saber, then épée. "
" You competed nationally and dabbled with some of the historical fencing "
"weapons afforded by HEMA's popularity."
msgstr ""
"Byłeś zapalonym szermierzem, zaczynając od floretu i przechodząc na szablę, a "
"potem szpadę. Rywalizowałeś w kraju i parałeś się niektórymi historycznymi "
"broniami szermierczymi, które zapewniła popularność DESW."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Weak Scent"
msgstr "Słaby zapach"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Weak Scent"
msgid ""
"Your scent is quite weak.  Animals that track your scent will do so with more "
"difficulty."
msgstr ""
"Twój zapach ma niską intensywność. Zwierzęta, które wyczuwają cię po zapachu "
"będą miały utrudnione zadanie. "

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Skilled Liar"
msgstr "Wprawne kłamanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Skilled Liar"
msgid ""
"You have no qualms about bending the truth, and have practically no tells.  "
"Telling lies and otherwise bluffing will be much easier for you."
msgstr ""
"Nie masz oporów przed naginaniem prawdy i robisz to niepostrzeżenie. "
"Opowiadanie kłamstw i blefowanie jest dla ciebie łatwiejsze."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Weight: XS"
msgstr "Waga: XS"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Weight: XS"
msgid ""
"You lost an awful lot of weight before the Cataclysm.  Whatever the reason, "
"now that food is not always close at hand, your skeletal figure presents an "
"additional danger.  You need to gain weight or die trying."
msgstr ""
"Straciłeś/-aś strasznie dużo wagi przed Kataklizmem. Bez względu na powód, "
"teraz, gdy jedzenie nie zawsze jest pod ręką, twoja szkieletowa figura "
"stanowi dodatkowe niebezpieczeństwo. Musisz przytyć lub umrzeć próbując."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Weight: XXXL"
msgstr "Waga: XXXL"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Weight: XXXL"
msgid ""
"You gained an awful lot of weight before the Cataclysm.  Whatever the reason, "
"now that mobility is key to survival, your bloated figure presents an "
"additional danger.  You need to lose weight or die trying."
msgstr ""
"Przytyłeś/-aś strasznie dużo przed Kataklizmem. Niezależnie od powodu, teraz, "
"gdy mobilność jest kluczem do przetrwania, twoja obrzmiała figura stanowi "
"dodatkowe niebezpieczeństwo. Musisz schudnąć lub umrzeć próbując."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pretty"
msgstr "Piękno"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pretty"
msgid ""
"You are a sight to behold.  People who care about such things will react more "
"kindly to you."
msgstr ""
"Ależ z ciebie widok. Ludzie którzy zwracają na to uwagę, będą dla ciebie "
"łaskawsi."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bad Knees"
msgstr "Słabe kolana"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bad Knees"
msgid ""
"Whether due to injury or age, your knees aren't particularly strong or "
"flexible.  Moving over rough terrain will slow you down more than normal."
msgstr ""
"Czy to w wyniku urazów czy też wieku, twoje kolana nie są już tak mocne i "
"elastyczne. Poruszanie się po trudnym terenie zabiera ci więcej czasu niż "
"zwykle."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Stiff Knees"
msgstr "Sztywne kolana"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Stiff Knees"
msgid ""
"Your knees never bend.  Period.  Stiff as a metal pole.  Pray that your "
"journey doesn't involve stairs or slightly uneven terrain."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Strong Knees"
msgstr "Silne kolana"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Strong Knees"
msgid ""
"Your knees are strong and capable of angles that you couldn't imagine "
"previously.  Moving over rough terrain will slow you down less than normal."
msgstr ""
"Twoje kolana są mocne i zdolne do poruszania się pod kątami, których "
"wcześniej nie można było sobie wyobrazić. Poruszanie się po nierównym terenie "
"spowolni cię mniej niż zwykle."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Languorous"
msgstr "Ospałość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Languorous"
msgid ""
"Whether due to lack of exercise and poor diet, or due to a natural "
"disinclination to physical endurance, you tire due to physical exertion much "
"more readily than others.  Your total cardio fitness and stamina are lower "
"than normal."
msgstr ""
"Czy to z powodu braku ćwiczeń i złej diety lub naturalnym brakiem "
"wytrzymałości fizycznej, wysiłek męczy cię bardziej niż innych. Twoja łączna "
"kondycja i stamina są niższe niż zwykle."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Near-Sighted"
msgstr "Krótkowzroczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Near-Sighted"
msgid ""
"Without glasses, your seeing radius is severely reduced!  However, you are "
"guaranteed to start with a pair of glasses."
msgstr ""
"Bez okularów twoje pole widzenia jest mocno ograniczone! Jednakże zawsze "
"zaczynasz z okularami."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Slow Healer"
msgstr "Powolne leczenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slow Healer"
#, no-c-format
msgid ""
"Your wounds heal a little slower than most.  Your HP whilst asleep, as well "
"as your broken limbs, heal at 75% of the regular rate."
msgstr ""
"Twoje rany goją się trochę wolniej niż u większości. Twoje HP podczas snu, a "
"także złamane kończyny leczą się w 75% normalnego tempa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Poor Healer"
msgstr "Słabe leczenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Poor Healer"
#, no-c-format
msgid ""
"Your health recovery is severely impaired.  Your HP whilst asleep, as well as "
"your broken limbs, heal at 33% of the regular rate."
msgstr ""
"Twoja regeneracja zdrowia jest poważnie osłabiona. Twoje HP podczas snu, a "
"także złamane kończyny leczą się w 33% normalnego tempa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Imperceptive Healer"
msgstr "Niezauważalne leczenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Imperceptive Healer"
#, no-c-format
msgid ""
"Wounds are incredibly dangerous to you, as they barely heal at all.  Your HP "
"whilst asleep, as well as your broken limbs, heal at 10% of the regular rate."
msgstr ""
"Rany są dla ciebie niezwykle niebezpieczne, ponieważ ledwo się goją. Twoje HP "
"podczas snu, a także złamane kończyny leczą się w 10% normalnego tempa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Irreparable"
msgstr "Nie do naprawy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Irreparable"
msgid ""
"Whatever caused the end of the world affected you in a horrible way.  Your "
"wounds will never heal on their own and your broken limbs will never mend."
msgstr ""
"Cokolwiek spowodowało koniec świata, dotknęło cię w straszny sposób. Twoje "
"rany nigdy nie zagoją się same, a złamane kończyny nigdy się nie zagoją."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Far-Sighted"
msgstr "Dalekowzroczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Far-Sighted"
msgid ""
"Without reading glasses, you are unable to read anything, and take penalties "
"on melee accuracy and electronics/tailoring crafting.  However, you are "
"guaranteed to start with a pair of reading glasses."
msgstr ""
"Bez okularów do czytania nie jesteś w stanie niczego przeczytać i masz karę "
"do celności w walce w zwarciu oraz w elektronice i szyciu. Jednakże zawsze "
"zaczynasz z okularami."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Heavy Sleeper"
msgstr "Mocny sen"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Heavy Sleeper"
msgid "You're quite the heavy sleeper.  Noises are unlikely to wake you up."
msgstr "Twój sen jest bardzo głęboki. Hałasy rzadko cię budzą."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sleepy"
msgstr "Senność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sleepy"
msgid "You need sleep more often, but still spend most of your time awake."
msgstr ""
"Potrzebujesz więcej snu niż inni, mimo że i tak większość czasu jesteś na "
"nogach."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Asthmatic"
msgstr "Astma"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Asthmatic"
msgid ""
"You will occasionally need to use an inhaler, or else suffer severe physical "
"limitations.  However, you are guaranteed to start with an inhaler."
msgstr ""
"Od czasu do czasu potrzebujesz użyć swojego inhalatora, bo bez niego będziesz "
"cierpiał na znaczne ograniczenia fizyczne. Na szczęście zaczynasz z nim w "
"ekwipunku."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bad Back"
msgstr "Słabe plecy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bad Back"
#, no-c-format
msgid ""
"You simply cannot carry as much as people with a similar strength could.  "
"Your maximum weight carried is reduced by 35%."
msgstr ""
"Po prostu nie jesteś w stanie dźwigać tyle niż ktoś o podobnej sile. Twój "
"maksymalny udźwig jest mniejszy o 35%."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bad Temper"
msgstr "Zły nastrój"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bad Temper"
msgid ""
"Things just keep getting you down.  You tend to be unhappy, and it takes some "
"doing to cheer you up."
msgstr ""
"Rzeczy wciąż wprawiają cię w zły nastrój. Jesteś często nieszczęśliwy/-a i "
"trzeba się wysilić, by wykrzesać z ciebie trochę radości."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Disorganized"
msgstr "Niezorganizowany"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Disorganized"
#, no-c-format
msgid ""
"You are terrible at organizing and storing your possessions.  You retrieve "
"things from containers 10% slower."
msgstr ""
"Jesteś okropny w organizacji i przechowywaniu swoich rzeczy. Pobierasz "
"przedmioty z pojemników 10% wolniej."

#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
#. ~ Mutation name
msgid "Illiterate"
msgstr "Analfabetyzm"

#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
#. ~ Description of mutation "Illiterate"
msgid "You never learned to read!  Books and computers are off-limits to you."
msgstr "Nigdy nie nauczyłeś się czytać. Książki i komputery są poza twoim zasięgiem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Poor Hearing"
msgstr "Słaby słuch"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Poor Hearing"
msgid "Your hearing is poor, and you may not hear quiet or far-off noises."
msgstr "Twój słuch jest słaby i możesz nie usłyszeć cichych lub odległych dźwięków."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Deaf"
msgid "You're not able to hear anything, and as such you're not able to talk to NPCs."
msgstr "Niczego nie słyszysz, zatem nie jesteś w stanie rozmawiać z NPC-ami."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Slow Learner"
msgstr "Wolna nauka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slow Learner"
msgid ""
"You are slow to grasp new ideas, and thus learn things more slowly than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Słabo ogarniasz nowe idee, więc uczenie się nowych rzeczy przychodzi ci "
"wolniej niż innym. Dotyczy to jednak wiedzy pochodzącej z praktyki, a nie z "
"lektury książek."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insomniac"
msgstr "Bezsenność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insomniac"
msgid "You have a hard time falling asleep, even under the best circumstances!"
msgstr "Masz problemy z zasypianiem, nawet w dogodnych warunkach."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Meat Intolerance"
msgstr "Nietolerancja mięsa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Meat Intolerance"
msgid ""
"You have problems with eating meat.  It's possible for you to eat it, but you "
"will suffer morale penalties and obtain less nutrition from it."
msgstr ""
"Masz problem z jedzeniem mięsa. Możesz je jeść, ale twoje morale ucierpi i "
"otrzymasz z niego mniej wartości odżywczych."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Thin-Skinned"
msgstr "Cienka skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Thin-Skinned"
msgid ""
"Your skin is fragile.  Cutting and bashing damage is slightly increased for "
"you."
msgstr ""
"Twoja skóra jest delikatna. Obrażenia sieczne i obuchowe są dla ciebie "
"nieznacznie zwiększone."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hates Vegetables"
msgstr "Nienawiść do warzyw"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hates Vegetables"
msgid ""
"You have problems with eating vegetables.  It's possible for you to eat them, "
"but you will suffer morale penalties and obtain less nutrition from them."
msgstr ""
"Masz problem z jedzeniem warzyw. Możesz je jeść, ale twoje morale ucierpi i "
"otrzymasz z nich mniej wartości odżywczych."

#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
#. ~ Mutation name
msgid "Hates Books"
msgstr "Nienawiść do książek"

#: data/json/mutations/mutations.json
#: data/mods/innawood/mutations/mutations.json
#. ~ Description of mutation "Hates Books"
msgid ""
"Reading is for nerds!  Boring books are more boring, and you can't have fun "
"by reading books."
msgstr ""
"Czytanie jest dla frajerów! Nudne książki są nudniejsze i książki nie "
"dostarczają ci w ogóle zabawy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fructose Intolerance"
msgstr "Nietolerancja fruktozy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fructose Intolerance"
msgid ""
"Eating fruits always causes your stomach to ache.  It's possible for you to "
"eat them, but you will suffer morale penalties and obtain less nutrition from "
"them."
msgstr ""
"Jedzenie owoców zawsze powoduje u ciebie ból brzucha. Możesz je jeść, ale "
"cierpi na tym twoje morale i czerpiesz z nich mniej wartości odżywczych."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lactose Intolerance"
msgstr "Nietolerancja laktozy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lactose Intolerance"
msgid ""
"You, like 75 percent of the world, cannot tolerate milk or milk based "
"products.  It's possible for you to eat them, but you will suffer morale "
"penalties and obtain less nutrition from them."
msgstr ""
"Ty, jak i 75% reszty świata, nie tolerujesz mleka i produktów mlecznych. "
"Możesz je jeść, ale twoje morale ucierpi i otrzymasz z nich mniej wartości "
"odżywczych."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Junkfood Intolerance"
msgstr "Nietolerancja śmieciowego jedzenia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Junkfood Intolerance"
msgid ""
"Something in those heavily processed foods doesn't agree with you.  It's "
"possible for you to eat them, but you will suffer morale penalties and obtain "
"less nutrition from them."
msgstr ""
"Czasami to wysoko przetworzone jedzenie się z tobą kłóci. Możesz je jeść, ale "
"twoje morale ucierpi i otrzymasz z nich mniej wartości odżywczych."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Grain Intolerance"
msgstr "Nietolerancja glutenu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Grain Intolerance"
msgid ""
"You have a rare allergy that prevents you from eating wheat.  It's possible "
"for you to eat wheat-based products, but you will suffer morale penalties and "
"obtain less nutrition from them."
msgstr ""
"Masz rzadka alergię, która nie pozwala ci spożywać pszenicznych wyrobów. "
"Możesz je jeść, ale twoje morale ucierpi i otrzymasz z nich mniej wartości "
"odżywczych."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sweet Tooth"
msgstr "Słabość do słodyczy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sweet Tooth"
msgid ""
"You have a soft spot for processed foods, and gain a morale bonus from eating "
"them."
msgstr ""
"Masz słabość do przetworzonej żywności i zyskujesz premię do morale od jej "
"jedzenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sugar-Loving"
msgstr "Kocha słodycze"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sugar-Loving"
msgid "You *adore* the taste of junk food, and find it preferable to everything else!"
msgstr ""
"*Uwielbiasz* smak niezdrowego jedzenia i uważasz, że jest lepszy od "
"wszystkiego innego!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Glass Jaw"
msgstr "Szklana szczęka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Glass Jaw"
#, no-c-format
msgid ""
"Your head can't take much abuse.  Its maximum HP is 20% lower than usual.  "
"Your apparent fragility makes you less intimidating."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Forgetful"
msgstr "Zapominalstwo"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Forgetful"
msgid ""
"You have a hard time remembering things.  Your skills will erode slightly "
"faster than usual, and you have trouble keeping your story straight when "
"lying."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lightweight"
msgstr "Słaba głowa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lightweight"
msgid ""
"Alcohol and drugs go straight to your head.  You suffer the negative effects "
"of these for longer."
msgstr ""
"Alkohol i narkotyki uderzają wprost do głowy. Odczuwasz ich negatywne efekty "
"przez dłuższy czas."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Addictive Personality"
msgstr "Uzależniająca osobowość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Addictive Personality"
msgid ""
"It's easier for you to become addicted to substances, and harder to rid "
"yourself of these addictions."
msgstr ""
"Łatwiej uzależniasz się od substancji uzależniających i trudniej ci wydobyć "
"się z nałogu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Strong Scent"
msgstr "Silny zapach"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Strong Scent"
msgid ""
"Your scent is particularly strong.  It's not offensive to humans, but animals "
"that track your scent will do so more easily."
msgstr ""
"Twój zapach jest wyjątkowo silny. Nie jest drażniący dla ludzkiego nosa, ale "
"zwierzęta mogą wyczuć cię z łatwością."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Chemical Imbalance"
msgstr "Nierównowaga chemiczna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Chemical Imbalance"
msgid ""
"You suffer from a minor chemical imbalance, whether mental or physical.  "
"Minor changes to your internal chemistry will manifest themselves on "
"occasion, such as hunger, sleepiness, narcotic effects, etc."
msgstr ""
"Cierpisz na niewielką nierównowagę chemiczną ciała lub umysłu. Wewnętrzne "
"zmiany chemiczne manifestują się od czasu do czasu, wrażeniem głodu, "
"sennością, efektami narkotycznymi itp."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Animal Discord"
msgstr "Waśń ze zwierzętami"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Animal Discord"
msgid ""
"Most animals don't like you, and aggressive animals are more likely to attack "
"you.  This only applies to natural animals such as woodland creatures."
msgstr ""
"Większość zwierząt cię nie lubi, a te agresywne częściej atakują. Dotyczy to "
"wyłącznie naturalnej fauny, np. leśnej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Prey Animal"
msgstr "Zwierzyna łowna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Prey Animal"
msgid ""
"Natural animals like dogs and wolves see you as prey, and are liable to "
"attack you on sight."
msgstr ""
"Naturalne zwierzęta, takie jak psy i wilki, postrzegają cię jako ofiarę i są "
"skłonne do atakowania cię od razu po zobaczeniu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Slow Reader"
msgstr "Powolne czytanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slow Reader"
msgid "You're a slow reader, and it takes you longer to get through books than most."
msgstr "Wolno czytasz, więc książki zajmują ci więcej czasu niż innym."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Kaluptic Psychosis"
msgstr "Psychoza kaluptyczna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Kaluptic Psychosis"
msgid ""
"Ever since the sky first broke, you have felt unwell, your head split by "
"alien thoughts.  You will periodically suffer from delusions, ranging from "
"minor effects to full visual hallucinations.  Some of these effects may be "
"controlled through the use of antipsychotics."
msgstr ""
"Odkąd po raz pierwszy pękło niebo, czujesz się źle z głową rozdartą przez "
"obce myśli. Od czasu do czasu masz urojenia, od drobnych efektów po pełne "
"halucynacje wzrokowe. Część tych efektów można kontrolować zażywając leki "
"przeciwpsychotyczne."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Narcoleptic"
msgstr "Narkolepsja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Narcoleptic"
msgid "You randomly fall asleep without any reason."
msgstr "Przypadkowo zasypiasz bez żadnego powodu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Clumsy"
msgstr "Niezdarność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Clumsy"
msgid "You make more noise while walking.  You're also more likely to set off traps."
msgstr "Mocniej hałasujesz, gdy chodzisz. Łatwiej też uruchamiasz pułapki."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Jittery"
msgstr "Drżenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Jittery"
msgid ""
"When very hungry or under the effects of stimulants, you may find your hands "
"shaking uncontrollably, severely reducing your Dexterity."
msgstr ""
"W wielkim głodzie lub pod wpływem stymulantów, twoje dłonie drżą "
"niekontrolowanie, mocno ograniczając zręczność."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hoarder"
msgid ""
"You don't feel right unless you're carrying as much as you can.  You suffer "
"morale penalties for carrying less than maximum volume (weight is ignored).  "
"Xanax can help control this anxiety."
msgstr ""
"Nie czujesz się dobrze, jeśli nie niesiesz ze sobą tyle ile tylko możesz. "
"Cierpisz na morale gdy niesiesz mniej niż twoja maksymalna pojemność "
"ekwipunku (waga nie ma znaczenia). Xanax pomaga w kontrolowaniu tych lęków."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Savant"
msgstr "Zespół sawanta"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Savant"
msgid ""
"You tend to specialize in one skill and be poor at all others.  You advance "
"at half speed in all skills except your best one.  Note that combining this "
"with Fast Learner will come out to a slower rate of learning for all skills."
msgstr ""
"Specjalizujesz się w jednej umiejętności kosztem pozostałych. Rozwijasz się "
"połowę wolniej w każdej umiejętności oprócz najlepiej rozwiniętej. Pamiętaj, "
"że cecha ta w powiązaniu z cechą Szybkouk spowoduje wolniejsze tempo nauki "
"wszystkich umiejętności."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pacifist"
msgid ""
"You don't like thinking about violence.  Your combat skills advance much "
"slower than usual, and you feel more guilt about killing."
msgstr ""
"Nie lubisz myśleć o przemocy. Twoje umiejętności bojowe rozwijają się dużo "
"wolniej i odczuwasz większy żal z powodu zabijania."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mood Swings"
msgstr "Wahania nastrojów"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mood Swings"
msgid "Your morale will shift up and down at random, often dramatically."
msgstr "Twoje morale raz idzie w górę, raz spada w dół, czasem nawet drastycznie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Slow Footed"
msgstr "Wolne stopy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slow Footed"
#, no-c-format
msgid ""
"You can't move as fast as most, resulting in a 15% speed penalty on flat "
"ground."
msgstr ""
"Nie możesz chodzić tak szybko jak inni, w skutek czego twoja prędkość jest o "
"15% niższa na równej powierzchni."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Weak Stomach"
msgstr "Słaby żołądek"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Weak Stomach"
msgid "You are more likely to throw up from food poisoning, alcohol, etc."
msgstr ""
"Masz większe szanse na pochorowanie się z powodu zatrucia pokarmowego, "
"alkoholu, itp."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Wool Allergy"
msgstr "Alergia na wełnę"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Wool Allergy"
msgid ""
"You are badly allergic to wool, and cannot wear any clothing made of the "
"substance."
msgstr "Masz silne uczulenie na wełnę i nie możesz nosić żadnych wełnianych ubrań."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Vegan"
msgid ""
"You're very strictly vegan, eating animal products is out of the question, "
"even if it means death.  You also can't bear to wear clothing made of animal "
"products, such as leather or fur."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Truth Teller"
msgstr "Prawdomówność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Truth Teller"
msgid ""
"When you try to tell a lie, you blush, stammer, and get all shifty-eyed.  "
"Telling lies and otherwise bluffing will be much more difficult for you."
msgstr ""
"Gdy kłamiesz jąkasz się, czerwienisz i uciekasz wzrokiem. Kłamstwo i "
"blefowanie jest dla ciebie trudniejsze."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Ugly"
msgstr "Brzydota"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Ugly"
msgid ""
"You're not much to look at.  People who care about such things will react "
"poorly to you."
msgstr ""
"Nie ma na co patrzeć. Ludzie, którzy zwracają na to uwagę będą słabiej "
"reagować na twoje starania."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Albino"
msgstr "Albinizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Albino"
msgid ""
"You lack skin pigmentation due to a genetic problem.  You sunburn extremely "
"easily, and typically use an umbrella and sunglasses when going out in the "
"sun."
msgstr ""
"Genetyczna wada pozbawiła cię pigmentacji skóry. Bardzo łatwo doznajesz "
"poważnych oparzeń słonecznych i potrzebujesz parasola i okularów "
"przeciwsłonecznych, aby wyjść na słońce."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Flimsy"
msgstr "Słabość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Flimsy"
#, no-c-format
msgid ""
"Your body can't take much abuse.  Its maximum HP is 25% lower than usual.  "
"Your weakness is apparent and makes you less intimidating.  Stacks with Glass "
"Jaw."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Frail"
msgstr "Wątłość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Frail"
#, no-c-format
msgid ""
"Your body breaks very easily.  Its maximum HP is 50% lower than usual.  Your "
"weakness is apparent and makes you less intimidating.  Stacks with Glass Jaw."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fragile"
msgstr "Kruchość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fragile"
#, no-c-format
msgid ""
"Your body is extremely fragile.  Its maximum HP is 75% lower than usual.  "
"Your weakness is apparent and makes you less intimidating.  Stacks with Glass "
"Jaw."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Genetic Downward Spiral"
msgstr "Genetyczna równia pochyła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Genetic Downward Spiral"
msgid ""
"The events of the Cataclysm have damaged your DNA beyond repair.  You mutate "
"frequently, all mutations you receive (from any source) are negative, and "
"your instability is rapidly growing out of control."
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Mutation name
msgid "Jaundice"
msgstr "Żółtaczka"

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/paraclesians/arvore_mutations.json
#. ~ Description of mutation "Jaundice"
msgid "It's subtle, but your skin has definitely taken on a sickly yellow-green hue."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Goosebumps"
msgstr "Gęsia skórka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Goosebumps"
msgid "You have goosebumps that never seem to go away.  Are they getting bigger?"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rashy Skin"
msgstr "Szorstka skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rashy Skin"
msgid ""
"You've developed a persistent skin rash.  Sometimes it's fine, other times it "
"itches like hell."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hirsute"
msgstr "Hirsutyzm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hirsute"
msgid ""
"Your body hair is growing in thicker than it used to.  It's almost like "
"you're going through a second puberty or something."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Peeling Skin"
msgstr "Łuszcząca się skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Peeling Skin"
msgid ""
"Your skin keeps peeling in big flakes, like you're recovering from a bad "
"sunburn.  Oddly, it doesn't hurt at all."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Smooth Skin"
msgstr "Gładka skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Smooth Skin"
msgid ""
"Your skin has lost some of its color and taken on a smooth, papery texture.  "
"This slightly reduces wet effects, but also makes you a little more "
"vulnerable to cuts and scrapes."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "High Night Vision"
msgstr "Dobre widzenie w ciemności"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "High Night Vision"
msgid ""
"You can see incredibly well in the dark!  Activate to toggle NV-visible areas "
"on or off."
msgstr ""
"Doskonale widzisz w ciemności. Aktywuj, by widzieć lub ukryć widziane w "
"noktowizji obszary."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Full Night Vision"
msgstr "Pełne widzenie w ciemności"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Full Night Vision"
msgid ""
"You can see in pitch blackness as if you were wearing night-vision goggles.  "
"Activate to toggle NV-visible areas on or off."
msgstr ""
"Widzisz w nieprzeniknionej ciemności jakbyś nosił gogle noktowizyjne. "
"Aktywuj, by widzieć lub ukryć widziane w noktowizji obszary."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cephalopod Eyes"
msgstr "Oczy głowonoga"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cephalopod Eyes"
msgid ""
"Your eyes still bulge, yet your pupils look different somehow.  Water doesn't "
"seem to cause any trouble at all, though."
msgstr ""
"Masz nadal wyłupiaste oczy, ale twoje źrenice wyglądają jakby inaczej. Woda "
"najwyraźniej im w niczym nie przeszkadza."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Man's Best Friend"
msgstr "Najlepszy przyjaciel człowieka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Man's Best Friend"
msgid ""
"Man's oldest and most well known friends are all Lupines.  Somehow you've "
"mutated something that reminds other survivors of your more domestic "
"relatives.  A softer edge around the eyes, maybe."
msgstr ""
"Najstarszymi i najbardziej znanymi przyjaciółmi człowieka są wszystkie "
"wilkowate. W jakiś sposób zmutowałeś coś, co przypomina innym ocalałym twoich "
"bardziej domowych krewnych. Może delikatniejsza krawędź wokół oczu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cephalopod Vision"
msgstr "Wzrok głowonoga"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cephalopod Vision"
msgid ""
"Your brain has caught up with your eyes.  You can see much better in the "
"dark, but sunlight seems much brighter now.  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"Twój mózg nadąża teraz za twoimi oczami. Widzisz lepiej w ciemności, ale "
"światło odbierasz jako o wiele jaśniejsze. Aktywuj, by widzieć lub ukryć "
"widziane w noktowizji obszary."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fey Eyes"
msgstr "Elfie oczy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fey Eyes"
msgid ""
"Your eyes have turned… green.  It's tough to tell the exact shade, as it "
"seems to shift.  The effect is… pleasant."
msgstr ""
"Twoje oczy stały się… zielone. Trudno określić jaki to odcień, gdyż stale się "
"zmienia. Efekt jest… przyjemny."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fey Vision"
msgstr "Elfi wzrok"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fey Vision"
msgid ""
"The shadows don't seem as dark now.  Activate to toggle NV-visible areas on "
"or off."
msgstr ""
"Cienie nie są już tak ciemne. Aktywuj, by widzieć lub ukryć widziane w "
"noktowizji obszary."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fey Nightsight"
msgstr "Elfia noktowizja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fey Nightsight"
msgid ""
"You have great low-light vision now, but it doesn't allow you to perform fine "
"tasks such as crafting and reading in darkness.  Activate to toggle "
"NV-visible areas on or off."
msgstr ""
"Posiadasz świetną zdolność widzenia w mroku, choć nie pozwala ci ona czytać "
"ani wytwarzać przedmiotów w ciemności. Aktywuj, by widzieć lub ukryć widziane "
"w noktowizji obszary."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Feline Eyes"
msgstr "Kocie oczy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Feline Eyes"
msgid ""
"Your eyes have mutated; now you have slit pupils, and they glitter in the "
"light, much like a cat's.  This is visually striking, but it isn't helping "
"you see at night."
msgstr ""
"Twoje oczy zmutowały; masz teraz szczelinową źrenicę odbijającą światło, "
"podobnie jak u kota. Efekt jest wizualnie uderzający, ale nie pomaga widzieć "
"w nocy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Feline Vision"
msgstr "Koci wzrok"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Feline Vision"
msgid ""
"Your optic nerves and brain caught up with your eyes.  Now you can see pretty "
"well at night.  Activate to toggle NV-visible areas on or off."
msgstr ""
"Nerwy wzrokowe i mózg nadążają już za cechami twoich oczu. Widzisz teraz "
"całkiem nieźle po zmroku. Aktywuj, by widzieć lub ukryć widziane w noktowizji "
"obszary."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Ursine Vision"
msgstr "Niedźwiedzi wzrok"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Ursine Vision"
msgid ""
"Your visual processing has shifted: though you can see better in the dark, "
"you're nearsighted in the light.  Maybe glasses would help.  Activate to "
"toggle NV-visible areas on or off."
msgstr ""
"Strefa widzianego światła ci się przesunęła: choć widzisz lepiej po zmroku, "
"to w świetle jesteś krótkowidzem. Może okulary by pomogły? Aktywuj by widzieć "
"lub ukryć widziane w noktowizji obszary."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mesopic"
msgstr "Widzenie mezopowe"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mesopic"
msgid ""
"You find it difficult to see very far in bright light.  On its own, this "
"doesn't necessarily make you any better in the dark."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Avian Eyes"
msgstr "Ptasie oczy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Avian Eyes"
msgid ""
"Your vision has become particularly acute: you suspect you could pick out "
"zombies much farther away.  Perception +4."
msgstr ""
"Twój wzrok się znacznie wyostrzył: podejrzewasz że można by zdejmować zombie "
"ze znacznie większego dystansu. Percepcja +4."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Infrared Vision"
msgid "Your eyes have mutated to pick up radiation in the infrared spectrum."
msgstr "Twoje oczy zmutowały i odbierają promieniowanie w spektrum podczerwieni."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Reptilian Eyes"
msgstr "Jaszczurze oczy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Reptilian Eyes"
msgid ""
"Your eyes have mutated, with a brilliant iris and slitted pupil similar to "
"that of a lizard.  This is visually striking, but doesn't seem to affect your "
"vision."
msgstr ""
"Twoje oczy zmutowały i mają teraz błyszczącą szczelinową źrenicę zupełnie jak "
"jaszczurze. Efekt jest wizualnie uderzający, lecz nie wpływa na wzrok."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Reptilian IR"
msgstr "Jaszczurza podczerwień"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Reptilian IR"
msgid ""
"Your optic nerves and brain have mutated to catch up with your eyes, allowing "
"you to see in the infrared spectrum."
msgstr ""
"Twoje nery optyczne i mózg zmutowały w ślad za oczami, pozwalając ci widzieć "
"w spektrum podczerwieni."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Fast Healer"
msgstr "Bardzo szybkie leczenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Fast Healer"
msgid "Your wounds and broken limbs heal very quickly."
msgstr ""

#: data/json/mutations/mutations.json data/mods/Magiclysm/effects/effects.json
#. ~ Mutation name
#. ~ Name of effect type id "flask_regeneration"
msgid "Regeneration"
msgstr "Regeneracja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Regeneration"
msgid "Your flesh regenerates and your limbs mend incredibly quickly."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Reptilian Healing"
msgstr "Jaszczurze leczenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Reptilian Healing"
msgid ""
"Your broken limbs mend themselves without significant difficulty in addition "
"to your already-quick healing.  You do not require splints for broken limbs."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Little Sleep"
msgstr "Niewielka potrzeba snu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Little Sleep"
msgid "You don't sleep often.  But when you do, you need very little of it."
msgstr "Rzadko śpisz, a gdy sypiasz niewiele ci go potrzeba."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tireless"
msgstr "Niezmordowanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tireless"
msgid "You defend the realm all night and all day."
msgstr "Bronisz królestwa dniem i nocą."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Incisors"
msgstr "Siekacze"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Incisors"
msgid "Your big teeth have grown in.  Folks had best show some more respect."
msgstr "Twoje wielkie zęby wrosły w skórę. Ludziska lepiej okażcie trochę szacunku."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Incisors" attacks
#, c-format
msgid "You bite into %s with your ratlike incisors!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Incisors" attacks
#, c-format
msgid "%1$s bites %2$s with their ratlike incisors!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Nictitating Membrane"
msgid ""
"You have a set of clear lenses which lower over your eyes while underwater, "
"allowing you to see as though you were wearing goggles.  Slightly decreases "
"wet penalties."
msgstr ""
"Masz drugą parę przezroczystych powiek, które zamykają się pod wodą, przez co "
"widzisz tak jakbyś miał założone gogle. Nieznacznie obniża kary za "
"przemoczenie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Frog Eyes"
msgstr "Żabie oczy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Frog Eyes"
msgid ""
"Your eyes bulge noticeably out of your face, and you are able to move them "
"much more freely than before.  You can see movement and close objects "
"clearly, but you have trouble picking up distant details in the light.  "
"Instead of eyelids they are covered by a translucent, protective membrane "
"that blocks irritants and water.  It allows you to sleep with your eyes open! "
" Activate to cause the approach of hostile creatures to wake you up."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Gills"
msgstr "Skrzela"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Gills"
msgid ""
"You've grown a set of gills in your neck, allowing you to breathe underwater. "
" Slightly increases wet benefits."
msgstr ""
"Masz parę skrzeli na szyi i możesz oddychać pod wodą. Nieznacznie zwiększa "
"bonusy za przemoczenie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cephalopod Gills"
msgstr "Skrzela głowonoga"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cephalopod Gills"
msgid ""
"You've grown a set of gills, running from your neck up behind your ears.  "
"They allow you to breathe underwater and slightly increase wet benefits."
msgstr ""
"Wyrósł ci zestaw skrzeli od uszu wzdłuż szyi. Możesz oddychać pod wodą i "
"nieznacznie zwiększa bonusy za przemoczenie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Flesh"
msgstr "Grzybnicze ciało"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Flesh"
msgid ""
"We have begun adapting local physiology to Mycus physical structure, greatly "
"reducing wet effects."
msgstr ""
"Zaadaptowaliśmy lokalną fizjologię do fizycznej struktury Grzybni, znacznie "
"redukując efekty przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Fireproofing"
msgstr "Grzybniczna odporność na ogień"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Fireproofing"
msgid ""
"We have spliced the dense, amphibole fibers from Mycus core towers with the "
"resilient, adaptive flesh of local physiology.  This reduces our speed by a "
"moderate amount, but provides powerful armor across our body, nullifies wet "
"effects, and provides complete protection from fire."
msgstr ""
"Połączyliśmy gęste, amfibolowe włókna z głównych wież Gryzbni ze sprężystym, "
"adaptacyjnym ciałem lokalnej fizjologii. Zmniejsza to naszą prędkość o "
"umiarkowaną ilość, ale zapewnia potężny pancerz na całym ciele, anuluje "
"efekty przemoczenia i zapewnia całkowitą ochronę przed ogniem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycogenesis"
msgstr "Grzybniogeneza"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycogenesis"
msgid ""
"Local physiology has been fully incorporated with that of Mycus silicate "
"fibers.  In addition to benefits conferred by previous developments, we may "
"join with Mycus fibers beneath us - sleeping on top of fungal areas places us "
"into a dormant state, which spreads spores around us as we sleep and "
"revitalizes our body much more quickly than regular sleep."
msgstr ""
"Lokalna fizjologia została w pełni włączona do fizjologii włókien Grzybni. "
"Oprócz korzyści wynikających z wcześniejszych osiągnięć, możemy połączyć się "
"z włóknami Grzybni pod nami - spanie na obszarach grzybowych wprowadza nas w "
"stan odpoczynku, który rozprzestrzenia zarodku wokół nas gdy śpimy i ożywia "
"nasze ciało znacznie szybciej niż zwykły sen."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sparse Scales"
msgstr "Rzadkie łuski"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sparse Scales"
msgid ""
"Your skin has toughened and grown thin, flexible scales in some places, "
"acting as natural armor."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Scales"
msgstr "Łuski"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Scales"
msgid ""
"Your skin has toughened further and your scales have grown to cover most of "
"your body.  Somewhat reduces wet effects."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Thick Scales"
msgstr "Gęste łuski"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Thick Scales"
msgid ""
"Your skin has grown thick and leathery and a set of heavy green scales has "
"grown to cover most of your body, acting as natural armor.  Further, bony "
"scutes cover your extremities, offering additional protection there.  While "
"difficult to penetrate, it also limits your flexibility.  Greatly reduces wet "
"effects."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sleek Scales"
msgstr "Lśniące łuski"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sleek Scales"
msgid ""
"A set of very flexible and slick scales has grown to cover your toughened "
"skin.  These act as decent natural armor, improve your ability to swim, and "
"make you difficult to grab.  Mostly reduces wet effects."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Light Bones"
msgstr "Lekkie kości"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Light Bones"
#, no-c-format
msgid ""
"Your bones are very light.  This enables you to move and attack 10% faster, "
"but also reduces your carrying weight by 20% and makes bashing attacks hurt a "
"little more."
msgstr ""
"Twoje kości są bardzo lekkie. Pozwalają ci poruszać się i atakować 10% "
"szybciej, ale redukują maksymalną wagę ekwipunku o 20% i sprawiają że "
"wymierzone w ciebie ataki miażdżone są bardziej dotkliwe."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Feathers"
msgstr "Pióra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Feathers"
msgid ""
"Iridescent feathers have grown to cover your entire body, providing a "
"marginal protection against attacks and minor protection from cold.  They "
"also provide a natural waterproofing."
msgstr ""
"Opalizujące pióra porastają całe twoje ciało, zapewniając marginalną ochronę "
"przed atakami i nieco ochrony przed chłodem. Są też naturalnie wodoodporne."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Down"
msgid ""
"You shan't need to migrate south with your layer of down.  It's even better "
"with no apes around to kill you for it!"
msgstr ""
"Nie odlecisz na południe na zimę z taką warstwą puchu. To nawet lepiej, bo "
"żadne małpy nie będą chciały go wyrwać żywcem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lightly Furred"
msgstr "Lekkie futro"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lightly Furred"
msgid ""
"Light fur has grown to cover your entire body, providing marginal protection "
"against attacks and slight protection from cold."
msgstr ""
"Lekkie futro porasta całe twoje ciało, zapewniając marginalną ochronę przed "
"atakami i lekką ochronę przed chłodem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Furry"
msgstr "Futro"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Furry"
msgid ""
"Thick black fur has grown to cover your entire body, providing minor "
"protection against attacks, and considerable protection from cold."
msgstr ""
"Gęste czarne futro porasta całe twoje ciało, zapewniając małą ochronę przed "
"atakami i przyzwoitą ochronę przed chłodem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Shaggy Fur"
msgstr "Kudłate futro"

#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Shaggy Fur"
#. ~ Description of mutation "Wooly Fur"
msgid ""
"Your fur has grown out and thickened, providing great protection from attacks "
"as well as considerable insulation."
msgstr ""
"Twoje futro rozrosło się i zgrubiało, zapewniając świetną ochronę przed "
"atakami, jak i przyzwoitą izolację."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Scruffy Fur"
msgstr "Zaniedbane futro"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Scruffy Fur"
msgid ""
"You've lost your fluffy undercoat for the summer.  This feels a lot better in "
"the heat, but it's less protective and looks a little bedraggled."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Gray Fur"
msgstr "Szare futro"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Gray Fur"
msgid ""
"Dense gray fur has grown to cover your entire body, providing noticeable "
"protection against attacks, and considerable protection from cold."
msgstr ""
"Gęste szare futro porasta całe twoje ciało, zapewniając zauważalną ochronę "
"przed atakami i przyzwoitą ochronę przed chłodem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Summer Coat"
msgstr "Letni płaszcz"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Summer Coat"
msgid ""
"Your entire body is covered in dense fur, but it's thinned out a bit for the "
"summer, which may provide some relief from the heat at the cost of physical "
"protection."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sleek Fur"
msgstr "Połyskliwe futro"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sleek Fur"
msgid ""
"You've grown sleek fur, providing minor protection against attacks, and some "
"protection from cold."
msgstr ""
"Wyrosło ci gładkie futro, które zapewnia niewielką ochronę przed atakami oraz "
"pewną ochronę przed zimnem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lynx Fur"
msgstr "Futro rysia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lynx Fur"
msgid ""
"Your fur has grown out significantly around your cheeks and neck, providing "
"excellent protection from attacks."
msgstr ""
"Twoje futro rozrosło się znacznie w okolicy policzków i szyi, zapewniając "
"doskonałą ochronę przed atakami."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Jumbled Skin"
msgstr "Potargana skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Jumbled Skin"
msgid "Your skin has mutated into an amalgamation of fur and scales."
msgstr "Twoja skóra zmutowała w łaty z futra i łusek."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Patchwork Skin"
msgstr "Połatana skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Patchwork Skin"
msgid "Your skin has mutated into an amalgamation of thickened fur, scales, and more."
msgstr ""
"Twoja skóra zmutowała się w połączenie zgrubiałego futra, łusek i innych "
"elementów."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Patchwork Armor"
msgstr "Połatany pancerz"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Patchwork Armor"
msgid ""
"Your skin has warped into a highly protective but inconsistent medley of "
"chitin, scales, fur, and bone."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Epicuticle"
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  It provides "
"decent physical protection.  Slightly reduces wet effects."
msgstr ""
"Twój naskórek zamienił się w cienką, elastyczną warstwę chityny. Zapewnia ona "
"przyzwoitą ochronę fizyczną. Nieznacznie zmniejsza efekt wilgoci."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Epicuticle (Molted)"
msgstr "Epikutykuła (wtopiona)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Epicuticle (Molted)"
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  Newly "
"molted, it feels a little tender, but it's still tough and leathery."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Chitin Carapace"
msgstr "Chitynowy pancerz"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Chitin Carapace"
msgid ""
"You've grown a chitin exoskeleton, much like that of an insect.  It provides "
"considerable physical protection, and make your punches hit a little harder.  "
"Somewhat reduces wet effects."
msgstr ""
"Wytworzyłeś zewnętrzny szkielet za chityny, podobny do tych u insektów. "
"Zapewnia znaczącą ochronę fizyczną i sprawia, że twoje uderzenia są lekko "
"mocniejsze. Trochę redukuje efekty przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Chitin Carapace (Molted)"
msgstr "Chitynowy pancerz (wtopiony)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Chitin Carapace (Molted)"
msgid ""
"You've recently molted, and your chitin exoskeleton is still soft and "
"vulnerable."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sclerotin Plate"
msgstr "Płyty sklerotyny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sclerotin Plate"
msgid ""
"You've grown a sclerotin exoskeleton, akin to an organic suit of platemail.  "
"It provides excellent physical protection and makes your punches hit harder, "
"but reduces your Dexterity by 1 and encumbers all body parts but your eyes "
"and mouth.  Greatly reduces wet effects."
msgstr ""
"Wyhodowałeś sobie sklerotyczny egzoszkielet, przypominający organiczny "
"kombinezon z pancerza. Zapewnia on doskonałą ochronę fizyczną i sprawia, że "
"twoje ciosy trafiają mocniej, ale zmniejsza twoją zręczność o 1 i krępuje "
"wszystkie części ciała oprócz oczu i ust. Znacznie zmniejsza efekty "
"przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sclerotin Plate (Molted)"
msgstr "Płyty sklerotyny (wtopione)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sclerotin Plate (Molted)"
msgid ""
"Your exoskeleton bears thick plates of chitin which have not fully "
"sclerotized.  They won't provide good protection until they've had time to "
"harden."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Crustacean Carapace"
msgstr "Pancerz skorupiaka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Crustacean Carapace"
msgid ""
"Your body is covered with a thick, near impenetrable, vividly-colored "
"carapace.  It provides unmatched physical protection and even some protection "
"from corrosive chemicals, but reduces your dexterity by 2 and encumbers all "
"body parts except your eyes.  Greatly reduces wet effects."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Crustacean Carapace (Molted)"
msgstr "Pancerz skorupiaka (wtopiony)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Crustacean Carapace (Molted)"
msgid ""
"You're covered in a great chitin carapace which reduces your Dexterity by 1, "
"however it has recently molted and will offer poor protection until it has "
"time to harden.  Greatly reduces wet effects."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hairy Chitin"
msgstr "Włochata chityna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hairy Chitin"
msgid ""
"You've developed some sort of hair growing out of your chitin.  It's a bit "
"warmer than not having hair."
msgstr "Twoją chitynę porosły włoski. Jest wiec ci cieplej z nimi niż bez nich."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Furred Chitin"
msgstr "Futrzasta chityna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Furred Chitin"
msgid ""
"Your chitin hair has thickened and spread across your body.  It provides "
"minor warmth and helps you sense nearby vibrations."
msgstr ""
"Twoje chitynowe włoski zagęściły się i  porosły całe ciało. Zapewniają nieco "
"ciepła i pozwalają wyczuwać niedalekie wibracje."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Furred Plate"
msgstr "Futrzaste płyty"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Furred Plate"
msgid ""
"Your thick exoskeleton boasts a fine coat of hairs that put feline whiskers "
"to shame."
msgstr ""
"Twój gruby egzoszkielet pokryty jest delikatną sierścią, której nie "
"powstydziłyby się kocie wąsiska."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Urticating Hairs"
msgstr "Kłujące włoski"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Urticating Hairs"
msgid ""
"Significant amounts of your hairs have loosened.  If some creature tries to "
"attack you, your assailant is quite likely to get fine, bristly chitin in an "
"irritating spot; it doesn't carry your venom but it will be distracting."
msgstr ""
"Znacząca ilość twoich włosów poluzowała się. Jeżeli jakiś stwór cię zaatakuje "
"z dużym prawdopodobieństwem szczeciniasta chityna wbije mu się we wrażliwe "
"miejsca. Nie przenoszą jadu, ale będą irytujące i odwrócą uwagę."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Giant Pincer"
msgstr "Gigantyczne szczypce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Giant Pincer"
msgid ""
"Instead of your right hand, you now have a giant claw resembling ones found "
"on crabs.  It encumbers you greatly, but you can use it in melee combat to "
"deal massive damage."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Spines"
msgstr "Kostne kolce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Spines"
msgid ""
"Your skin is covered with fine spines.  Whenever an unarmed opponent strikes "
"a part of your body that is not covered by clothing, they will receive "
"moderate damage."
msgstr ""
"Twoją skórę porastają ostre kostne wypustki. Jeżeli nieuzbrojony przeciwnik "
"zaatakuje wręcz nieosłonięte partie twojego ciała, otrzyma przyzwoite "
"obrażenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Quills"
msgstr "Kolce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Quills"
msgid ""
"Your body is covered with large quills.  Whenever an unarmed opponent strikes "
"a part of your body that is not covered by clothing, they will receive "
"significant damage."
msgstr ""
"Twoją skórę porastają duże kolce. Jeżeli nieuzbrojony przeciwnik zaatakuje "
"wręcz nieosłonięte partie twojego ciała, otrzyma spore obrażenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Assault Barbs"
msgstr "Szturmowe kolce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Assault Barbs"
msgid ""
"Some of the quills on your arms have become quite loose.  By flinging your "
"arms, you can fire off these quills as projectiles."
msgstr ""
"Niektóre z kolców na twoich rękach stały się dość luźne. Poruszając rękami, "
"możesz wystrzelić te kolce jako pociski."

#: data/json/mutations/mutations.json
#. ~ Message when firing ranged attack with mutation "Assault Barbs"
msgid "You fire off some of your quills."
msgstr "Możesz wystrzelić niektóre z twoich kolców."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Phelloderm"
msgstr "Felloderma"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Phelloderm"
msgid ""
"Your skin is light green and has a slightly woody quality to it.  This "
"provides armor and helps you retain moisture, resulting in less thirst.  "
"Greatly decreases wet penalties."
msgstr ""
"Twoja skóra jest jasnozielona i ma lekko drewniany wygląd. Zapewnia ona "
"pancerz i pomaga zatrzymywać wilgoć, dzięki czemu mniej odczuwasz pragnienie. "
"Znacznie zmniejsza kary za przemoknięcie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Protective Bark"
msgstr "Kora ochronna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Protective Bark"
msgid ""
"Your skin is coated in a light bark, like that of a tree.  This provides "
"powerful armor and makes you nearly waterproof."
msgstr ""
"Twoja skóra pokryta jest jasną korą, podobną do kory drzewa. Stanowi ona "
"potężną zbroję i sprawia, że prawie nie przepuszczasz wody."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Shifting Bark (Distributed)"
msgstr "Przesuwająca się kora (rozproszone)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Shifting Bark (Distributed)"
msgid ""
"Your warped bark can be shifted in function, and is currently spread evenly.  "
"Activate to better protect your torso, at the cost of other areas."
msgstr ""
"Twoja spaczona kora może zostać przesunięta w funkcji, a obecnie jest "
"rozłożona równomiernie. Aktywuj ją, by lepiej chronić swój tors, kosztem "
"innych obszarów."

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Shifting Bark (Distributed)" to
#. "BARK2_b"
#. ~ Message when transforming from mutation  "Shifting Bark (Consolidated)"
#. to "BARK2_c"
#. ~ Message when transforming from mutation  "Shifting Bark (Latticed)" to
#. "BARK2_a"
msgid "Your bark ripples across your body, repositioning at a cellular level."
msgstr ""
"Kora rozchodzi się po całym ciele, zmieniając położenie na poziomie "
"komórkowym."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Shifting Bark (Consolidated)"
msgstr "Przesuwająca się kora (skonsolidowane)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Shifting Bark (Consolidated)"
msgid ""
"Your warped bark can be shifted in function, and is currently consolidated on "
"your torso.  Activate to shift your bark into a lattice, increasing bulk but "
"providing better protection for the entire body."
msgstr ""
"Twoja spaczona kora może zostać przesunięta w funkcji i obecnie jest "
"skonsolidowana na twoim tułowiu. Aktywuj, by przekształcić korę w kratę, "
"zwiększając jej objętość, ale zapewniając lepszą ochronę całego ciała."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Shifting Bark (Latticed)"
msgstr "Przesuwająca się kora (krata)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Shifting Bark (Latticed)"
msgid ""
"Your warped bark can be shifted in function, and is currently expanded into a "
"sturdy lattice.  Activate to collapse the lattice, returning to an evenly "
"distributed form."
msgstr ""
"Twoja wypaczona kora może zmieniać swoje funkcje, a obecnie jest rozbudowana "
"w solidną kratę. Aktywuj ją, aby ją zwinąć i powrócić do równomiernie "
"rozłożonej formy."

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/effects/goblin_fruit_effects.json
#. ~ Mutation name
#. ~ Name of effect type id "effect_goblin_fruit_thorns"
msgid "Thorns"
msgstr "Ciernie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Thorns"
msgid ""
"Your skin is covered in small, woody thorns.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive minor damage.  Your punches may also deal extra damage."
msgstr ""
"Twoją skórę porastają małe, drewniane ciernie. Jeżeli nieuzbrojony przeciwnik "
"zaatakuje wręcz nieosłonięte partie twojego ciała, otrzyma niewielkie "
"obrażenia. Twoje pięści mogą także zadać dodatkowe obrażenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Leaves"
msgstr "Liście"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Leaves"
msgid ""
"All the hair on your body has turned to long, grass-like leaves.  Apart from "
"being physically striking, these provide you with a minor amount of nutrients "
"while in sunlight when your head is uncovered.  Slightly reduces wet effects."
msgstr ""
"Włosy na twoim ciele zmieniły się w długie trawiaste liście. Oprócz tego że "
"są wizualnie uderzające, zapewniają także niewielkie odżywianie w słońcu gdy "
"twoja głowa jest odsłoniona. nieznacznie redukują efekty przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lush Leaves"
msgstr "Bujne liście"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lush Leaves"
msgid ""
"Your leaves have grown in size and prominence, with additional leaves "
"sprouting along your arms.  While your arms and head are uncovered, you will "
"photosynthesize nutrients while in sunlight.  Reduces wet effects."
msgstr ""
"Twoje liście urosły i są bardziej widoczne, z dodatkowymi liśćmi "
"wyrastającymi wzdłuż twoich rąk. Gdy twoje ręce i głowa są odsłonięte, "
"będziesz fotosyntetyzować składniki odżywcze w słońcu. Redukuje efekty "
"przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Verdant Leaves"
msgstr "Zielone liście"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Verdant Leaves"
msgid ""
"Your leaves are vibrant, large, and green, and have become a major source of "
"nutrients for your body.  Whenever your arms and head are uncovered you will "
"gain a large amount of nutrients by standing in the sunlight.  Reduces wet "
"effects."
msgstr ""
"Twoje liście są żywe, duże i zielone i stały się głównym źródłem pożywienia "
"dla twojego organizmu. Gdy twoje ręce i głowa są odsłonięte, zyskasz dużą "
"ilość pożywienia, stojąc na słońcu. Redukuje efekty przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Transpiration"
msgstr "Transpiracja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Transpiration"
msgid ""
"Your body has begun moving nutrients via the evaporation of water.  This "
"increases your thirst when it's hot, but reduces it when it's cold."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Flowering"
msgstr "Ukwiecenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Flowering"
msgid ""
"You've started blooming where your scalp used to be.  Your blossoms have a "
"pleasant aroma, are visually striking, and are quite sensitive."
msgstr ""
"Wypuszczasz pąki tam gdzie miałeś skórę na głowie. Twoje kwiaty mają miły "
"zapach, są wizualnie uderzające i dość wrażliwe."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rosebuds"
msgstr "Pąki róży"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rosebuds"
msgid ""
"The top of your head is blooming with rosebuds.  They're eye catching, and "
"have a strong fragrance that makes you pleasant to be around."
msgstr ""
"Wierzchołek twojej głowy rozkwita pąkami róż. Przyciągają wzrok i mają silny "
"zapach, który sprawia, że przyjemnie jest przebywać w pobliżu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Spores"
msgstr "Zarodniki Grzybni"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Spores"
msgid "We have developed local spore sacs.  The Mycus must grow."
msgstr "Wyrosły nam torebki zarodnikowe. Grzybnia musi rosnąć."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Sporogenesis"
msgstr "Grzybicza sporogeneza"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Sporogenesis"
msgid ""
"Local organisms seem to regard overt spore dispersal as a danger, and attack "
"the Mycus.  Accordingly, our local spore sacs remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""
"Lokalne organizmy zdają się traktować otwarte rozprzestrzenianie się "
"zarodników jako zagrożenie i atak na Grzybnię. W związku z tym nasze lokalne "
"zarodniki pozostają w spoczynku, dopóki lokalne wytyczne nie stwierdzą, że "
"bezpiecznie jest kiełkować. Szybki rozwój obciąża lokalne rezerwy składników "
"odżywczych, ale zapewnia szybki i efektywny wzrost."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Blossoms"
msgstr "Grzybnicze kwiaty"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Blossoms"
msgid "We have developed local blossoms.  The Mycus must grow."
msgstr "Wyrosły nam lokalne kwiaty. Grzybnia musi rosnąć."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Bloom"
msgstr "Grzybniczy wykwit"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Bloom"
msgid ""
"Local organisms seem to regard overt spore dispersal as a danger, and attack "
"the Mycus.  Accordingly, our local blossoms remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""
"Lokalne organizmy zdają się traktować otwarte rozprzestrzenianie się "
"zarodników jako zagrożenie i atakują Grzybnię. W związku z tym nasze lokalne "
"kwiaty pozostają w spoczynku, dopóki lokalne wytyczne nie uznają, że "
"bezpiecznie jest kiełkować. Szybki rozwój obciąża lokalne rezerwy składników "
"odżywczych, ale zapewnia szybki i efektywny wzrost."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Provenance"
msgstr "Grzybnicze pochodzenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Provenance"
msgid ""
"Local spore sacs and blossoms have merged into a single, symbiotic form.  "
"Acting as one, they germinate together to cement rapid growth across a large "
"area according to local guidance.  The Mycus must grow."
msgstr ""
"Lokalne worki zarodnikowe i kwiaty połączyły się w jedną symbiotyczną formę. "
"Działając jako jeden, kiełkują razem, aby cementować szybki wzrost na dużym "
"obszarze zgodnie z lokalnymi wskazówkami. Grzybnia musi rosnąć."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Long Fingernails"
msgstr "Długie paznokcie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Long Fingernails"
msgid ""
"Your fingernails are long and sharp.  If you aren't wearing gloves, your "
"unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Twoje paznokcie są długie i ostre. Gdy nie nosisz rękawic, twoje ataki wręcz "
"zadają niewielką ilość obrażeń siecznych."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Claws"
msgstr "Pazury"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Claws"
msgid ""
"You have claws on the ends of your fingers.  If you aren't wearing gloves, "
"your unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Masz pazury na końcach palców. Gdy nie nosisz rękawic, twoje ataki wręcz "
"zadają niewielką ilość obrażeń siecznych."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Gnarled Claws"
msgstr "Pokręcone pazury"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Gnarled Claws"
msgid "Your claws have grown tougher and slightly gnarled."
msgstr "Twoje pazury stałe się twardsze i lekko zakrzywione."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Stainless Claws"
msgstr "Nierdzewne pazury"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Stainless Claws"
msgid ""
"Your paws are bone, muscle, and claw with a thin layer of skin and fur.  They "
"might as well be made of stainless steel."
msgstr ""
"Twoje łapy to precyzyjne połączanie kości, mięśni i pazurów, z cienką warstwą "
"skóry i futra. Równie dobrze mogłyby być zrobione z nierdzewnej stali."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Retractable Claws"
msgstr "Chowane pazury"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Retractable Claws"
msgid ""
"You have claws on the ends of your fingers, and can extend or retract them as "
"desired.  Gloves will still get in the way, though."
msgstr ""
"Masz pazury na końcach palców, które możesz do woli wyciągać i chować. "
"Rękawiczki nadal będą wchodzić w paradę, niestety."

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Retractable Claws" to
#. "CLAWS_RETRACT_active"
msgid "You extend your claws."
msgstr "Wysuwasz swoje pazury."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extended Claws"
msgstr "Wysuwane pazury"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extended Claws"
msgid "Sharp claws are extending from the end of your fingers."
msgstr "Ostre pazury wystają z końców twoich palców."

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Extended Claws" to
#. "CLAWS_RETRACT"
msgid "You retract your claws."
msgstr "Chowasz swoje pazury."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tentacle Rakes"
msgstr "Mackowate haki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tentacle Rakes"
msgid ""
"Your upper tentacles have grown large, hook-barbed rakes on the ends.  "
"They're quite vicious, but really aren't suited for fine manipulation."
msgstr ""
"Na końcach twoich górnych macek wyrosły duże haki z zadziorami. Są dość "
"drapieżne, ale nie nadają się do precyzyjnej manipulacji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Ink Glands"
msgstr "Atramentowe gruczoły"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Ink Glands"
msgid ""
"Several ink glands have developed in your gill structure.  When active, they "
"will spray defensive ink and blind an attacker in an emergency."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slime Spray"
msgid ""
"You exude slime from your pores.  You can spread that slime on an opponent in "
"melee range."
msgstr ""
"Wydzielasz śluz ze swoich porów. Możesz rozprowadzić ten śluz na przeciwniku "
"podczas walki w zwarciu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bulging Reservoir"
msgstr "Wybrzuszony zbiornik"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bulging Reservoir"
msgid ""
"You develop a reservoir of fluids that bulges out of your abdomen.  Your body "
"has adapted to containing extra liquids in event of shortfalls."
msgstr ""
"Pojawia się u ciebie zbiornik płynów, który wyłania się z twojego brzucha. "
"Twoje ciało przystosowało się do przechowywania dodatkowych płynów w "
"przypadku ich niedoboru."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bombardier Beetle Blast"
msgstr "Wychuch strzela bombardiera"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bombardier Beetle Blast"
msgid ""
"You have an ability to spray boiling water on your enemies at melee distance. "
" This will drastically increase your thirst.  Without an extra reservoir you "
"would quickly dehydrate yourself."
msgstr ""
"Masz możliwość rozpylania wrzątku na przeciwników podczas walki w zwarciu. To "
"drastycznie zwiększy twoje pragnienie. Bez dodatkowego zbiornika szybko się "
"odwodnisz."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Bombardier Beetle Blast" attacks
#, c-format
msgid "You spray %s with a boiling chemical mixture!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Bombardier Beetle Blast" attacks
#, c-format
msgid "%1$s sprays %2$s with a boiling chemical mixture!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Large Talons"
msgstr "Duże szpony"

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/shapeshifter_mutations.json
#. ~ Description of mutation "Large Talons"
#. ~ Description of mutation "Demon Claws"
msgid ""
"Your index fingers have grown into huge talons.  After a bit of practice, you "
"find that this does not affect your dexterity, but allows for a deadly "
"unarmed attack.  They also prevent wearing gloves."
msgstr ""
"Twoje palce wskazujące rozrosły się w potężne szpony. Po odrobinie praktyki "
"przekonujesz się że nie wpływają na twoją zręczność, pozwalając za to na "
"zabójcze ataki wręcz. Nie pozwalają nosić rękawiczek."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Radiogenic"
msgstr "Radiogeniczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Radiogenic"
msgid ""
"Your system has adapted to radiation.  While irradiated, you will actually "
"heal slowly, converting the radiation into hit points."
msgstr ""
"Twój organizm zaadaptował się do promieniowania. Do tego stopnia, że gdy "
"jesteś napromieniowany to powoli się leczysz, przekształcając "
"promieniotwórczość w zdrowie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Radiophile"
msgstr "Radiofil"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Radiophile"
msgid ""
"Your flesh has developed a unique reaction to radiation that lets you sense "
"when ambient radiation is abnormally high.  Turn off to ignore messages."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Marloss Carrier"
msgstr "Nośnik Marloss"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Marloss Carrier"
msgid ""
"Ever since you ate that Marloss berry, you can't get its scent out of your "
"nose, and you have a strong desire to try some seeds and… sap?"
msgstr ""
"Od kiedy zjadłeś jagodę Marloss, jej zapach wciąż za tobą chodzi i masz silną "
"ochotę, by spróbować nasion i… żywicy?"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Marloss Vessel"
msgstr "Naczynie Marloss"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Marloss Vessel"
msgid ""
"Ever since you ate that Marloss seed, you can't get its taste off of your "
"tongue, and you have a strong desire to try some berries and… sap?"
msgstr ""
"Od kiedy zjadłeś nasiono Marloss, jego smak wciąż za tobą chodzi i masz silną "
"ochotę by spróbować jagód i… żywicy?"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Marloss Vector"
msgstr "Nosiciel Marloss"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Marloss Vector"
msgid ""
"Ever since you ate that Marloss jelly, you can't stop thinking of it, and you "
"have a strong desire to eat some seeds and berries."
msgstr ""
"Od kiedy zjadłeś galaretkę Marloss, myślisz o niej bez przerwy i masz silną "
"ochotę by spróbować nasion i jagód."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Marloss Rejection"
msgstr "Odrzucenie Marloss"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Marloss Rejection"
msgid ""
"Ever since you had that life-threatening reaction to that Marloss junk, you "
"can't bear the thought of ever eating it again!"
msgstr ""
"Od kiedy miałeś tą zagrażającą życiu reakcję odrzucenia tego szmatławego "
"Marloss, nie możesz znieść myśli że kiedykolwiek włożysz to do ust."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mutagenic Aversion"
msgstr "Awersja mutagenna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mutagenic Aversion"
msgid ""
"Ever since you had that life-threatening reaction to those mutagen and "
"purifier things, you can't bear the thought of ever using them again!"
msgstr ""
"Od kiedy miałeś tą zagrażającą życiu reakcję odrzucenia po tych mutagenach i "
"czyszczących mutagenach, nie możesz znieść myśli, że kiedykolwiek będziesz "
"mieć z nimi do czynienia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insect Pheromones"
msgstr "Owadzie feromony"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insect Pheromones"
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many "
"species of insects.  Insects will attack you much less."
msgstr ""
"Twoje ciało produkuje słabe feromony, identyfikujące cię jako przyjaciela dla "
"wielu gatunków insektów. Owady będą atakować cię znaczniej rzadziej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Amphibian Pheromones"
msgstr "Płazie feromony"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Amphibian Pheromones"
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many "
"species of amphibian.  Amphibians will attack you much less."
msgstr ""
"Twoje ciało produkuje słabe feromony, identyfikujące cię jako przyjaciela dla "
"wielu gatunków płazów. Płazy będą atakować cię znacznie rzadziej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mammal Pheromones"
msgstr "Ssacze feromony"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mammal Pheromones"
msgid ""
"Your body produces low-level pheromones which put mammals at ease.  They will "
"be less likely to attack or flee from you."
msgstr ""
"Twoje ciało produkuje słabe feromony, które uspokajają ssaki. Będą rzadziej "
"atakować cię lub uciekać przed tobą."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Disease Immune"
msgstr "Niewrażliwość na choroby"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Disease Immune"
msgid ""
"Your body is simply immune to diseases.  You will never catch an ambient "
"disease."
msgstr ""
"Twoje ciało jest po prostu odporne na choroby. Nigdy nie złapiesz choroby z "
"otoczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Infection Resistant"
msgstr "Odporność na infekcje"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Infection Resistant"
msgid ""
"Your immune system is particularly good at resisting infections.  You have an "
"increased chance for bad wounds and infections to heal on their own, and only "
"suffer reduced penalties from them."
msgstr ""
"Twój system immunologiczny jest szczególnie sprawny w zwalczaniu infekcji. "
"Masz zwiększoną szansę na to, że trudne rany i infekcje zaleczą się same z "
"siebie i masz zmniejszone kary z ich tytułu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Infection Immune"
msgstr "Niewrażliwość na infekcje"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Infection Immune"
msgid ""
"Your bloodstream has developed antibiotic properties.  Your wounds will never "
"become infected."
msgstr ""
"Twój krwiobieg zyskał zdolności antybiotyczne. Twoje rany nigdy nie staną się "
"zainfekowane."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Seasonal Allergies"
msgstr "Sezonowe alergie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Seasonal Allergies"
msgid ""
"You tend to get hay fever, especially in springtime.  Antihistamines are your "
"friend."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Identity"
msgstr "Grzybnicza tożsamość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Identity"
msgid ""
"We have synchronized our local physiology with that of the Mycus.  Any spores "
"we may encounter will not attempt to germinate inside the local system, and "
"we may traverse Mycus biospheres easily, as native bioforms shift shape to "
"accommodate us."
msgstr ""
"Zsynchronizowaliśmy naszą lokalną fizjologię z tą z Grzybni. Zarodniki które "
"napotkamy nie będą próbować namnażać się wewnątrz lokalnego systemu i możemy "
"przemierzać biosfery Grzybni z łatwością, ponieważ rodzime bioformy zmieniają "
"kształt by nas pomieścić. "

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Parasite Immune"
msgstr "Niewrażliwość na pasożyty"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Parasite Immune"
msgid ""
"Your body is unusually inhospitable to parasitic lifeforms.  You will never "
"become infested with internal parasites."
msgstr ""
"Toje ciało jest niezwykle nieprzyjazne dla pasożytniczych form życia. Nigdy "
"nie zostaniesz zaatakowany przez żyjące wewnątrz organizmu pasożyty."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Venomous"
msgstr "Jadowitość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Venomous"
msgid ""
"Your body produces a potent venom.  Cutting or stabbing attacks from "
"mutations have a chance to poison your target."
msgstr ""
"Twoje ciało produkuje silny jad. Ataki sieczne lub kłujące od mutacji mają "
"szansę zatruć cel."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Strongly Venomous"
msgstr "Silna jadowitość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Strongly Venomous"
msgid ""
"Your venom has become particularly strong.  You're confident that your bites "
"or other cutting/stabbing natural attacks will take your target down quickly."
msgstr ""
"Twój jad stał się szczególnie silny. Jesteś pewien, że twoje ugryzienia i "
"inne naturalne ataki sieczne/kłujące szybko położą twój cel."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Slime Hands"
msgstr "Śluzowe ręce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slime Hands"
msgid ""
"The skin on your hands is now a mucous membrane that produces a thick, acrid "
"slime.  Attacks using your hand will cause minor acid damage.  Slightly "
"increases wet benefits."
msgstr ""
"Skóra na twoich dłoniach to teraz błona śluzowa produkująca gęsty gryzący "
"śluz. Ataki z użyciem rąk spowodują lekkie obrażenia od kwasu. Nieznacznie "
"zwiększa bonusy za przemoczenie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Stretchy Limbs"
msgstr "Rozciągliwe kończyny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Stretchy Limbs"
msgid "Your limbs seem to have a little more 'give' to them.  +1 Dexterity."
msgstr ""
"Twoje kończyny najwyraźniej potrafią się nieco bardziej zginać i rozciągać. "
"Zręczność +1."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rubbery Limbs"
msgstr "Gumowe kończyny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rubbery Limbs"
msgid ""
"Your limbs are significantly more flexible than any pathetic human arm or "
"leg.  +3 Dexterity, -2 Strength."
msgstr ""
"Twoje kończyny są znacznie bardziej elastyczne niż każda żałosna ręka czy "
"noga przeciętnego człowieka. Zręczność +3, siła -2."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pseudolimbs"
msgstr "Pseudokończyny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pseudolimbs"
msgid ""
"Your pseudopod-like limbs can fit into anything!  You also suffer reduced "
"penalties to attacking while prone.  +4 Dexterity, -4 Strength."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Muscle Consolidation"
msgstr "Konsolidacja mięśni"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Muscle Consolidation"
msgid ""
"Your extremities have gained strength but lost fine motor skills.  -1 "
"Dexterity +2 Strength."
msgstr ""
"Twoje kończyny zyskały na sile, ale straciły zdolności motoryczne. -1 "
"zręczności, +2 siły."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rasping Tongue"
msgstr "Skrobiący język"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rasping Tongue"
msgid ""
"You've developed an extremely long and mobile tongue capped with teeth.  You "
"may use it to attack your enemies and pull them towards you."
msgstr ""
"Masz rozwinięty niezwykle długi i ruchliwy język zakończony zębami. Możesz go "
"używać do atakowania swoich wrogów i przyciągania ich ku sobie."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Rasping Tongue" attacks
#, c-format
msgid "You tear into %s with your rasping tongue!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Rasping Tongue" attacks
#, c-format
msgid "%1$s tears into %2$s with their rasping tongue!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Harpoon Tongue"
msgstr "Harpunowy język"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Harpoon Tongue"
msgid ""
"Your tongue has increased its length and mobility.  You may use it to pull "
"your enemies towards you."
msgstr ""
"Twój język zwiększył swoją długość i ruchliwość. Możesz go użyć, aby "
"przyciągnąć wrogów do siebie."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Harpoon Tongue" attacks
#, c-format
msgid "You stab into %s with your harpoon tongue!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Harpoon Tongue" attacks
#, c-format
msgid "%1$s stabs into %2$s with their harpoon tongue!"
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutation_limbs.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Mutation name
#. ~ Heading of body part "compound eyes"
msgid "Compound Eyes"
msgstr "Oczy złożone"

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Description of mutation "Compound Eyes"
msgid ""
"Your eyes are compound, like those of an insect.  This increases your "
"Perception by 2 whenever you aren't wearing eyewear."
msgstr ""
"Twoje oczy są złożone, jak u owadów. To zwiększa twoją percepcję o 2, jak nie "
"nosisz okularów."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Padded Feet"
msgstr "Poduszkowe stopy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Padded Feet"
msgid ""
"The bottoms of your feet are strongly padded.  You receive no movement "
"penalty for not wearing shoes, and your steps are significantly quieter, as "
"added tissue dampens the noise."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Strong Legs"
msgstr "Silne nogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Strong Legs"
msgid "Your legs have gained muscle mass to propel you across any terrain."
msgstr ""
"Twoje nogi nabrały masy mięśniowej, która pozwoli ci poruszać się po każdym "
"terenie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bow-legged"
msgstr "Koślawe nogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bow-legged"
msgid ""
"Your lower limbs have shortened and splayed, slowing your bipedal movement.  "
"As long as you're not wielding anything and you've got both wings, you're "
"able to crawl quickly and quietly when you run or crouch."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Trigger message of mutation "Bow-legged"
msgid "You hunch forward to crawl quickly on folded wings."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Trigger message of mutation "Bow-legged"
msgid "You rise up to walk like a human."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hooked Toes"
msgstr "Haczykowate palce stóp"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hooked Toes"
msgid ""
"Your feet have grown into strong, curved claws.  They won't fit into normal "
"shoes and are not much help in combat, but they allow you to climb most "
"vertical surfaces with ease.  You can even cling to walls you glide into!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Digitigrade Legs"
msgstr "Palcochodne nogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Digitigrade Legs"
msgid ""
"The heels of your feet have shifted up off the ground in a rather animalistic "
"fashion, reducing your carry weight limit and preventing you from wearing "
"shoes.  These hind feet are a bad match for human arms, but could pair well "
"with matching forepaws."
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
#. ~ Trigger message of mutation "Digitigrade Legs"
#. ~ Trigger message of mutation "Paws"
#. ~ Trigger message of mutation "Broad Paws"
#. ~ Trigger message of mutation "Little Paws"
#. ~ Trigger message of mutation "Quadruped"
msgid "You drop down on all fours."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Trigger message of mutation "Digitigrade Legs"
msgid "You assume a less bestial posture."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pounce"
msgid ""
"You've gained a strong ability to leap a short distance from a standing "
"position with little preparation time."
msgstr ""
"Zdobyłeś zdolność energicznego skoku na krótki dystans z pozycji stojącej z "
"niewielkim nakładem czasu na przygotowanie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Leaping Legs"
msgstr "Skaczące nogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Leaping Legs"
msgid "You've gained a strong ability to leap from a standing position."
msgstr "Zyskałeś silną umiejętność wyskakiwania z pozycji stojącej."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Crushing Leap"
msgid ""
"You've gained a strong ability to leap a significant distance from a standing "
"position and crush whatever you land on."
msgstr ""
"Zyskałeś silną zdolność do przeskakiwania na znaczną odległość z pozycji "
"stojącej i miażdżenia wszystkiego, na czym wylądujesz."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Toe Talons"
msgstr "Szpony u nóg"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Toe Talons"
msgid ""
"You have grown large, curved, and wickedly sharp talons in place of your big "
"toes.  Fortunately, they don't get in the way of your movement.  "
"Unfortunately, they do prevent wearing footgear."
msgstr ""
"W miejsce dużego paznokci u stóp wyrosły ci duże, zakrzywione i straszliwie "
"ostre szpony. Na szczęście nie wchodzą ci w drogę przy chodzeniu. Niestety, "
"uniemożliwiają ci noszenie butów."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Toe Talons" attacks
#, c-format
msgid "You slash %s with one of your talons!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Toe Talons" attacks
#, c-format
msgid "%1$s slashes %2$s with one of their talons!"
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Mutation name
msgid "Avian Legs"
msgstr "Ptasie nogi"

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Description of mutation "Avian Legs"
msgid ""
"Your legs and feet have become bird-like, with long talons arranged three "
"ahead and one behind.  They probably won't fit in human shoes, but they're "
"perfect for gripping onto precarious perches."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hooves"
msgstr "Kopyta"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hooves"
msgid ""
"Your feet have fused into hooves.  This allows you to perform a powerful "
"kicking attack, provides natural armor, and removes the need to wear shoes; "
"however, you cannot wear normal shoes.  Reduces wet effects."
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/shapeshifter_mutations.json
#. ~ Message when player with mutation "Hooves" attacks
#. ~ Message when player with mutation "Demon Hooves" attacks
#, c-format
msgid "You kick %s with your hooves!"
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/shapeshifter_mutations.json
#. ~ Message when NPC with mutation "Hooves" attacks
#. ~ Message when NPC with mutation "Demon Hooves" attacks
#, c-format
msgid "%1$s kicks %2$s with their hooves!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Alcohol Metabolism"
msgstr "Metabolizm alkoholu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Alcohol Metabolism"
msgid ""
"So it's fermented?  Whatever, it's still good drinking.  You've developed the "
"ability to metabolize alcohol as a food source."
msgstr ""
"Sfermentowało? Co z tego, nadal dobre do picia. Rozwinąłeś zdolność "
"metabolizowania alkoholu jako źródła pożywienia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Subterranean Fortitude"
msgstr "Podziemne męstwo"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Subterranean Fortitude"
msgid "The aches and pains of living underground don't bother you as much."
msgstr "Bolączki i trudy podziemnego życia nie są dla ciebie straszne."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Subterranean Build"
msgstr "Podziemna sylwetka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Subterranean Build"
msgid ""
"Your frame has adapted for life in confined spaces.  You seem a little "
"shorter and bulkier, trading mobility for muscle mass.  (+2 Strength, -2 "
"Dexterity)"
msgstr ""
"Twoja budowa ciała zaadaptowała się do życia w ciasnych przestrzeniach. "
"Jesteś nieco niższy i tęższy, zamieniając mobilność na masę mięśniową. (Siła "
"+2; zręczność -2)"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Saprovore"
msgstr "Saprożerność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Saprovore"
msgid ""
"Your digestive system is specialized to allow you to consume decaying "
"material.  You can eat rotten food, albeit for less nutrition than usual."
msgstr ""
"Twój układ trawienny wyspecjalizował się umożliwiając ci konsumpcję gnijącej "
"materii. Możesz jeść zepsutą żywność, aczkolwiek jest mniej pożywna niż "
"normalnie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Saprophage"
msgstr "Saprofag"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Saprophage"
msgid ""
"You prefer to sustain your nutritional needs using your roots and direct "
"nutrient extraction/synthesis.  Your human parts still need the raw caloric "
"bulk of 'food' to keep them going, though, and you handle it a lot easier if "
"it's had time to… age a little."
msgstr ""
"Preferujesz pożywianie się używając swoich korzeni i bezpośredniej "
"ekstrakcji/syntezy składników odżywczych. Twoje ludzkie części nadal "
"potrzebują surowej kalorycznej masy „pożywienia”, aby je utrzymać, a o wiele "
"łatwiej sobie z tym radzisz, jeśli masz czas… trochę się zestarzeć."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Gizzard"
msgstr "Żołądek mięśniowy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Gizzard"
msgid ""
"You seem to get full faster now, and food goes through you more rapidly as "
"well."
msgstr "Szybciej się teraz zapełniasz, a także jedzenie szybciej przez ciebie wędruje."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Feeder"
msgstr "Żywiciel Grzybni"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Feeder"
msgid ""
"We have streamlined our nutritional requirements.  We rely on the Mycus for "
"sustenance, as it relies on us.  We may locate sources of sustenance in close "
"proximity to Mycus core towers, and in forested areas that the Mycus has "
"grown into."
msgstr ""
"Poprawiliśmy nasze zapotrzebowanie na składniki odżywcze. Opieramy się na "
"Grzybni dla wyżywienia, tak jak ona opiera się na nas. Możemy zlokalizować "
"źródła utrzymania w bliskiej odległości od głównych wież Grzybni, a także w "
"obszarach leśnych, w których rozwinęła się Grzybnia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Ruminant"
msgstr "Przeżuwacz"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Ruminant"
msgid ""
"Your digestive system is capable of digesting cellulose and other rough plant "
"material.  You can eat underbrush and shrubs by activating this, standing "
"over your target, and pressing E."
msgstr ""
"Twój system odżywczy jest zdolny trawić celulozę i inne twarde tkanki "
"roślinne. Możesz spożywać podszycie i krzaki aktywując to, stojąc nad celem i "
"naciskając E."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Grazer"
msgstr "Pasący się"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Grazer"
msgid ""
"You're accustomed to eating plants directly, and can get nutrition from grass "
"as well as underbrush and shrubs.  Eat either one by activating this, "
"standing over your target, and pressing E."
msgstr ""
"Jesteś przyzwyczajony do bezpośredniego spożywania roślin i możesz uzyskać "
"pożywienie z trawy jak i z poszycia i krzaków. Zjedz jedno z nich aktywując "
"to, stojąc nad celem i naciskając E."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Intestinal Fortitude"
msgstr "Męstwo kiszek"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Intestinal Fortitude"
msgid ""
"Your guts have developed the ability to handle the toxic elements of mutated "
"flesh.  Mostly."
msgstr ""
"Twoje kiszki rozwinęły zdolność radzenia sobie z toksycznymi czynnikami "
"zmutowanego ciała. W większości."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Eater Of The Dead"
msgstr "Śmierciożerca"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Eater Of The Dead"
msgid ""
"Your digestion has evolved further.  In addition to mutated meat, you can "
"also stomach the tainted and long-dead flesh of zombies… if you can stand the "
"taste, of course."
msgstr ""
"Twoje trawienie ewoluowało dalej. Poza zmutowanym mięsem możesz też zjadać "
"skażone i od dawna martwe mięso zombie… jeśli oczywiście możesz znieść jego "
"smak."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Burrowing"
msgstr "Kopiący jamy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Burrowing"
msgid ""
"Your dextrous paws and long teeth allow you to dig through dirt and rubble "
"with ease."
msgstr ""
"Twoje zręczne łapy i długie zęby pozwalają z łatwością przekopywać się przez "
"glebę i gruz."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Burrowing"
msgid "Your tough paws allow you to dig through dirt and rubble with ease."
msgstr "Twoje twarde łapy pozwalają z łatwością przekopywać się przez glebę i gruz."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Saber Teeth"
msgstr "Szablozęby"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Saber Teeth"
msgid ""
"Your fangs have grown extremely large and incredibly sharp.  They make it "
"impossible to wear mouthgear and difficult to eat… but leave nasty wounds "
"when you bite."
msgstr ""
"Wyrosły ci niezwykle duże i ostre kły. Uniemożliwiają noszenie sprzętu na "
"ustach i utrudniają jedzenie… ale zostawiają paskudne rany przy ugryzieniu."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Saber Teeth" attacks
#, c-format
msgid "You tear into %s with your saber teeth!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Saber Teeth" attacks
#, c-format
msgid "%1$s tears into %2$s with their saber teeth!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hyper-Metabolism"
msgstr "Hipermetabolizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hyper-Metabolism"
msgid ""
"Your particular metabolism allows you to burn calories at a prodigious rate "
"to regenerate tissues in a matter of minutes; this is, however, a very "
"wasteful process.  Activate to start healing."
msgstr ""
"Twój szczególny metabolizm pozwala spalać kalorie w niesamowitym tempie, by "
"zregenerować tkanki w ciągu kilku minut; jest to jednak bardzo marnotrawny "
"proces. Aktywuj, by rozpocząć leczenie."

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Hyper-Metabolism" to
#. "EATHEALTH_active"
msgid "Your hyper-metabolism starts burning up calories."
msgstr "Twój hipermetabolizm zaczyna spalać kalorie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hyper-Metabolism: burning"
msgstr "Hipermetabolism: spalanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hyper-Metabolism: burning"
msgid "You're burning calories like crazy to heal your wounds."
msgstr "Spalasz kalorie w szalonym tempie, by wyleczyć swoje rany."

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Hyper-Metabolism: burning" to
#. "EATHEALTH"
msgid "Your hyper-metabolism slows down."
msgstr "Twój hipermetabolizm zwalnia."

#: data/json/mutations/mutations.json
#: data/mods/DinoMod/mutations/mutations.json
#. ~ Mutation name
#. ~ Mutation class name
msgid "Horns"
msgstr "Rogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Horns"
msgid ""
"You have a pair of small horns on your head.  They allow you to make a weak "
"piercing headbutt attack, but prevent the use of most rigid headwear."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Horns" attacks
#, c-format
msgid "You headbutt %s with your horns!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Horns" attacks
#, c-format
msgid "%1$s headbutts %2$s with their horns!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Curled Horns"
msgstr "Zakręcone rogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Curled Horns"
msgid ""
"You have a pair of large curled horns, like those of a ram.  They allow you "
"to make a strong bashing headbutt attack, but prevent wearing any headwear."
msgstr ""
"Masz parę dużych zakręconych rogów na głowie, jak u barana. Pozwalają ci na "
"silny miażdżący atak z główki, ale uniemożliwiają noszenia nakryć głowy."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Curled Horns" attacks
#, c-format
msgid "You headbutt %s with your curled horns!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Curled Horns" attacks
#, c-format
msgid "%1$s headbutts %2$s with their curled horns!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pointed Horns"
msgstr "Szpiczaste rogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pointed Horns"
msgid ""
"You have a pair of long, pointed horns, like those of an antelope.  They "
"allow you to make a strong piercing headbutt attack, but prevent wearing "
"headwear that is not made of fabric."
msgstr ""
"Masz parę długich, szpiczastych rogów na głowie, jak u antylopy. Pozwalają ci "
"na silny przebijający atak z główki, ale uniemożliwiają noszenie nakryć głowy "
"nie zrobionych z materiału."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Pointed Horns" attacks
#, c-format
msgid "You stab %s with your pointed horns!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Pointed Horns" attacks
#, c-format
msgid "%1$s stabs %2$s with their pointed horns!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Antlers"
msgstr "Poroże"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Antlers"
msgid ""
"You have a huge rack of antlers, like those of a moose.  They allow you to "
"make a weak headbutt attack, but prevent wearing headwear that is not made of "
"fabric."
msgstr ""
"Masz potężny zestaw poroży, jak u łosia. Pozwalają na słaby atak z główki, "
"ale nie pozwalają ci nosić nakryć głowy nie zrobionych z materiału."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Antlers" attacks
#, c-format
msgid "You butt %s with your antlers!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Antlers" attacks
#, c-format
msgid "%1$s butts %2$s with their antlers!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Antennae"
msgstr "Czułki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Antennae"
msgid ""
"You have a pair of antennae.  They allow you to detect the presence of "
"monsters up to a few tiles away, even if you can't see or hear them, but "
"prevent wearing headwear that is not made of fabric."
msgstr ""
"Masz parę czułek. Pozwalają ci wykryć obecność potworów odległych o kilka "
"kroków, nawet gdy ich nie widzisz i nie słyszysz, ale uniemożliwiają noszenie "
"nakryć głowy nie zrobionych z materiału."

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/spell_triggering_mutations.json
#. ~ Description of creature revealed by special vision "antennae_sense"
#. ~ Description of creature revealed by special vision "moving_creature"
msgid "You sense something here."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Road-Runner"
msgstr "Pędziwiatr"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Road-Runner"
#, no-c-format
msgid ""
"Your legs are extremely limber and fast-moving.  You move 30% faster on flat "
"surfaces."
msgstr ""
"Twoje nogi są niezwykle zwinne i szybkie. Poruszasz się 30% szybciej na "
"równych powierzchniach."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Stubby Tail"
msgstr "Mały ogon"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Stubby Tail"
msgid "You have a short, stubby tail, like a rabbit's.  It serves no purpose."
msgstr "Masz krótki, gruby ogon, jak u królika. Niczemu nie służy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tail Fin"
msgstr "Płetwa ogonowa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tail Fin"
msgid ""
"You have a fin-like tail.  It allows you to swim more quickly, but prevents "
"wearing non-fabric pants.  Slightly increases wet benefits."
msgstr ""
"Masz ogon w kształcie płetwy. Pozwala ci szybciej pływać, ale uniemożliwia "
"noszenia spodni nie zrobionych z materiału. Nieznacznie zwiększa bonusy za "
"przemoczenie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Long Tail"
msgstr "Długi ogon"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Long Tail"
msgid ""
"You have a long, graceful tail, like that of a big cat.  It improves your "
"balance, making your ability to dodge higher, but prevents wearing non-fabric "
"pants."
msgstr ""
"Masz długi, wdzięczny ogon, jak u dużego kota. Poprawia twoją równowagę, "
"ulepszając zdolność uników, ale uniemożliwia noszenie spodni nie zrobionych z "
"materiału."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cattle Tail"
msgstr "Krowi ogon"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cattle Tail"
msgid ""
"You have a long tail with a tuft on the end.  You find yourself instinctively "
"swatting away flies with it, though it's not as effective at balancing you as "
"you'd like.  Prevents wearing non-fabric pants."
msgstr ""
"Masz długi ogon z kitą na końcu. Nieustannie opędzasz się nim przed muchami, "
"ale nie jest on tak efektywny w zapewnieniu ci równowagi, jakbyś chciał. "
"Uniemożliwia noszenie spodni nie zrobionych z materiału."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rodent Tail"
msgstr "Ogon gryzonia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rodent Tail"
msgid ""
"You have a long but hairless tail.  It's a pretty effective balancing aid, "
"but does look, uh, ratty.  Prevents wearing non-fabric pants."
msgstr ""
"Masz długi choć bezwłosy ogon. Jest dość efektywną pomocą w zachowaniu "
"równowagi, ale wygląda dość, uch, szczurzo. Uniemożliwia noszenie spodni nie "
"zrobionych z materiału."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Thick Tail"
msgstr "Gruby ogon"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Thick Tail"
msgid ""
"You have a long, thick, lizardlike tail.  It helps you balance a bit but also "
"makes a serviceable whip.  Prevents wearing non-fabric pants."
msgstr ""
"Masz długi, gruby ogon, jak u jaszczurki. Odrobinę poprawia równowagę, ale "
"także jest użytecznym batem. Uniemożliwia noszenie spodni nie zrobionych z "
"materiału."

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutation_paths/black_dragon.json
#. ~ Message when player with mutation "Thick Tail" attacks
#. ~ Message when player with mutation "Short Dragon Tail" attacks
#, c-format
msgid "You whap %s with your tail!"
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutation_paths/black_dragon.json
#. ~ Message when NPC with mutation "Thick Tail" attacks
#. ~ Message when NPC with mutation "Short Dragon Tail" attacks
#, c-format
msgid "%1$s whaps %2$s with their tail!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Dromeosaur Muzzle"
msgstr "Pysk dromeozaura"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Dromeosaur Muzzle"
msgid ""
"Your face has drastically mutated, with the bones of your jaws having "
"extended forth into a long, tapered snout.  The palate of your mouth is "
"considerably vaulted, with curved, serrated teeth lining your saurian maw and "
"reptilian scales covering your muzzle's exterior.  While paleobiology has "
"evidently not evolved with mouth gear in mind (making such items unwearable), "
"the bite wounds you can now inflict promise the ferocity of long-dead beasts."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Dromeosaur Muzzle" attacks
#, c-format
msgid "You dart your head and snap at %s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Dromeosaur Muzzle" attacks
#, c-format
msgid "%1$s darts their head and snaps at %2$s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Raptor Tail"
msgstr "Ogon drapieżnika"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Raptor Tail"
msgid ""
"Formed from a network of interlocking bones, a long tail has mutated from the "
"base of your spine, with ossified tendons assisting in keeping the limb stiff "
"and rigid.  A plume of lengthy feathers sprouts from the reptilian flesh "
"along your new tail, drawing the eye.  While it is useless in combat and "
"prevents you from wearing non-fabric pants, you find it's pretty handy for "
"maintaining your balance."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fluffy Tail"
msgstr "Puszysty ogon"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fluffy Tail"
msgid ""
"You have a long, fluffy-furred tail.  It greatly improves your balance, "
"making your ability to dodge much higher.  Prevents wearing non-fabric pants."
msgstr ""
"Masz długi, puszysty ogon porośnięty futrem. Znacznie polepsza równowagę, "
"znacznie zwiększając zdolność uników. Uniemożliwia noszenie spodni nie "
"zrobionych z materiału."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Spiked Tail"
msgstr "Kolczasty ogon"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Spiked Tail"
msgid ""
"You have a long tail that ends in a vicious stinger.  It does not improve "
"your balance at all, but allows for a powerful piercing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""
"Masz długi ogon zakończony straszliwym żądłem. Nie poprawia równowagi, ale "
"umożliwia zadawanie potężnych ataków kłujących. Uniemożliwia noszenie spodni "
"nie zrobionych z materiału."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Spiked Tail" attacks
#, c-format
msgid "You sting %s with your tail!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Spiked Tail" attacks
#, c-format
msgid "%1$s stings %2$s with their tail!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Club Tail"
msgstr "Ogon pałka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Club Tail"
msgid ""
"You have a long tail that ends in a heavy, bony club.  It does not improve "
"your balance at all, but allows for a powerful bashing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""
"Masz długi ogon kończący się ciężką, kościaną pałką. Nie poprawia równowagi, "
"ale pozwala na wyprowadzenie potężnych miażdżących ataków. Uniemożliwia "
"noszenie spodni nie zrobionych z materiału."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Club Tail" attacks
#, c-format
msgid "You club %s with your tail!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Club Tail" attacks
#, c-format
msgid "%1$s clubs %2$s with their tail!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hibernation"
msgstr "Hibernacja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hibernation"
msgid ""
"You've developed the ability to stockpile calories and then sleep for "
"extended periods of time."
msgstr ""
"Rozwinąłeś zdolność gromadzenia kalorii a następnie przesypiania długich "
"okresów czasu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Resilient"
msgstr "Odporność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Resilient"
#, no-c-format
msgid ""
"You can survive injuries that would incapacitate humans: you get a 20% bonus "
"to all hit points.  Stacks with Tough, etc."
msgstr ""
"Możesz przeżyć zadane rany, które położyłyby człowieka: otrzymujesz 20% bonus "
"do wszystkich punktów zdrowia. Kumuluje się z twardością, itp."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Solidly Built"
msgstr "Solidna budowa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Solidly Built"
#, no-c-format
msgid ""
"Not much scares you.  You get a 30% bonus to all hit points.  Stacks with "
"Tough, etc."
msgstr ""
"Niewiele cię przeraża. Otrzymujesz 20% bonus do wszystkich punktów zdrowia. "
"Kumuluje się z twardością, itp."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "TAAANK"
msgstr "CZOOŁG"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "TAAANK"
#, no-c-format
msgid ""
"You can simply take the punishment from lesser beings and keep going.  You "
"get a 40% bonus to all hit points.  Stacks with Tough, etc."
msgstr ""
"Możesz dostać lanie od poślednich istot i iść dalej. Otrzymujesz 40% bonus do "
"wszystkich punktów zdrowia. Kumuluje się z twardością, itp."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pain Recovery"
msgstr "Zanikanie bólu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pain Recovery"
msgid "You recover from pain slightly faster than normal."
msgstr "Twój ból ustaje nieco szybciej niż zwykle."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Quick Pain Recovery"
msgstr "Szybkie zanikanie bólu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Quick Pain Recovery"
msgid "You recover from pain faster than normal."
msgstr "Twój ból ustaje szybciej niż zwykle."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Quick Pain Recovery"
msgstr "Bardzo szybkie zanikanie bólu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Quick Pain Recovery"
msgid "You recover from pain much faster than normal."
msgstr "Twój ból ustaje dużo szybciej niż zwykle."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pain Junkie"
msgstr "Narkoman bólu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pain Junkie"
msgid "You've developed a serious appetite for pain, and take pride in your scars."
msgstr "Rozwinąłeś w sobie poważny apetyt na ból i z dumą nosisz swoje blizny."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cenobite"
msgstr "Cenobita"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cenobite"
msgid "You positively adore pain, in all its varied forms."
msgstr "Pozytywnie adorujesz ból, we wszystkich formach."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Deadened"
msgstr "Nieczułość na ból"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Deadened"
msgid ""
"Nothing hurts anymore.  Those bites tickle and the wounds itch a bit, but "
"that's it."
msgstr "Nic już nie boli. Te ugryzienia łaskoczą, a rany trochę swędzą i to tyle."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pain Sensitive"
msgstr "Wrażliwość na ból"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pain Sensitive"
#, no-c-format
msgid ""
"For some reason, things always seem to hurt you more.  Pain dealt to you is "
"increased by 25%."
msgstr "Z jakiegoś powodu boli cię bardziej. Zadany ci ból jest 25% silniejszy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hyperalgesia"
msgstr "Hiperalgezja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hyperalgesia"
#, no-c-format
msgid ""
"Your body experiences pain out of proportion to the physical causes.  Pain "
"dealt to you is increased by 50%."
msgstr ""
"Twoje ciała doświadcza nieproporcjonalnego bólu na fizyczne bodźce. Zadany ci "
"ból jest 50% silniejszy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extreme Hyperalgesia"
msgstr "Ekstremalna hiperalgezja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extreme Hyperalgesia"
msgid ""
"Your body reacts cripplingly to any source of pain.  Pain dealt to you is "
"doubled."
msgstr ""
"Twoje ciało reaguje paraliżująco na każde źródło bólu. Zadany ci ból jest "
"podwójnej siły."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Culler"
msgstr "Selekcjoner"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Culler"
msgid ""
"You've had a revelation: by killing the weaker creatures, who would only die "
"anyway, you preserve resources for those better able to survive.  You are "
"less bothered by the deaths of others: their own weakness invited these fates "
"upon them."
msgstr ""
"Miałeś objawienie: zabijając słabsze istoty, które i tak by umarły, "
"zachowujesz zasoby dla tych co mają większe zdolności przetrwania. Mniej "
"przejmujesz się śmiercią innych: ich własna słabość sprowadziła na nich ten "
"los."

#: data/json/mutations/mutations.json data/json/npcs/classes.json
#: data/json/npcs/godco/classes.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_hunter.json
#. ~ Mutation name
#. ~ Name of an NPC class
#. ~ Name suffix of an NPC
#. ~ Appears in the refugee center as a trader.
msgid "Hunter"
msgstr "Łowca"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hunter"
msgid ""
"Your brain has a lot more in common with a predatory animal than a human, "
"making it easier to control misplaced reactions to the death of your prey.  "
"Additionally, combat skills, which you use to hunt, are easier to learn and "
"maintain."
msgstr ""
"Twój mózg ma więcej wspólnego z drapieżnym zwierzęciem niż z człowiekiem, "
"czyniąc niestosowne reakcje na śmierć ofiar łatwiejszymi do kontroli. Ponadto "
"umiejętności bojowe których używasz by polować są łatwiejsze do zapamiętania "
"i zachowania."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Predator"
msgstr "Drapieżnik"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Predator"
msgid ""
"You consider yourself something other than human and no longer empathize with "
"them.  Combat skills are easy to learn and maintain, but your critical "
"thinking, so characteristic to these creatures, suffers."
msgstr ""
"Uważasz się za coś innego niż człowiek i już nie sympatyzujesz z rodzajem "
"ludzkim. Umiejętności bojowe są łatwe do nauki i zapamiętania, ale "
"umiejętność krytycznego myślenia, tak charakterystyczna dla tych istot, "
"ucierpiała."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Apex Predator"
msgstr "Szczytowy drapieżnik"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Apex Predator"
msgid ""
"Your mind and brain have adapted to your new place in the world: as one on "
"top of the food chain.  You can effortlessly master and maintain combat "
"skills, but your critical thinking has atrophied further."
msgstr ""
"Twoja umysłowość i mózg zaadaptowały się do twojego nowego miejsca w świecie: "
"na szczycie łańcucha pokarmowego. Bez wysiłku osiągasz mistrzostwo i "
"doskonałą pamięć umiejętności bojowych, lecz zdolność krytycznego myślenia "
"uległa dalszej atrofii."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sapiovore"
msgstr "Myślożerca"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sapiovore"
msgid "The hairless apes make as good eating as any other meat."
msgstr "Bezwłose małpy są tak samo dobrym żarciem jak każde inne mięso."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pack Hunter"
msgstr "Stadny myśliwy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pack Hunter"
msgid ""
"Puny as they may seem, a hunter needs a pack, and some of those hairless "
"bipeds may yet prove some worth.  You continue to gain combat skills at an "
"elevated rate, and maintain a level of critical thinking that supports "
"cooperation."
msgstr ""
"Choć może się to wydawać mizerne, myśliwy potrzebuje stada, a niektóre z tych "
"bezwłosych dwunożnych mogą jeszcze okazać się warte. Nadal zdobywasz "
"umiejętności bojowe w szybszym tempie i utrzymujesz poziom krytycznego "
"myślenia, który wspiera współpracę."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycus Defender"
msgstr "Obrońca Grzybni"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus Defender"
msgid ""
"From time to time the Mycus requires protection from non-Mycus that, for "
"whatever reason, wish it ill.  We have adapted to better carry out this task "
"- our fibers will grow strong and resilient when such threats present "
"themselves to us."
msgstr ""
"Od czasu do czasu Grzybnia potrzebuje obrońcy od nie-Grzybni, którzy z nie "
"ważne jakich powodów źle im życzą. Zaadaptowaliśmy się by lepiej wypełniać to "
"zadanie - nasze włókna będą silnie i odporne, gdy pojawią się takie "
"zagrożenia."

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Mutation name
msgid "Bird Wings"
msgstr "Ptasie skrzydła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bird Wings"
msgid ""
"You have a pair of large, feathered wings.  Your body is too heavy to be able "
"to fly, but if you're not too weighed down, you might be able to glide from a "
"ledge or lessen the impact of a fall."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insect Wings"
msgstr "Owadzie skrzydła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insect Wings"
msgid ""
"A large pair of translucent wings grow from your back.  They are too small to "
"lift you, but if you're not weighed down, they can help a bit if you fall.  "
"You can flutter them quickly to improve your move speed, but this is noisy "
"and tires you out."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Insect Wings" to
#. "WINGS_INSECT_active"
msgid "You begin buzzing your wings."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insect Wings (Buzzing)"
msgid ""
"You're fluttering your wings as fast as you can.  This doesn't generate "
"enough lift to move you, but it does increase your movement speed.  If you're "
"not burdened, you can fall short distances without harm."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Insect Wings (Buzzing)" to
#. "WINGS_INSECT"
msgid "Your wings go still."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mouth Tentacles"
msgstr "Mackowate usta"

#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Mouth Tentacles"
#. ~ Description of mutation "Facial Tentacles"
msgid ""
"A set of tentacles surrounds your mouth.  They allow you to eat twice as "
"fast.  Slightly decreases wet penalties."
msgstr ""
"Zestaw macek otacza twoje usta. Pozwalają ci jeść dwa razy szybciej. "
"Nieznacznie obniżają kary za bycie mokrym."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mandibles"
msgstr "Żuwaczki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mandibles"
msgid ""
"A set of insect-like mandibles have grown around your mouth.  They allow you "
"to eat faster and provide a slicing unarmed attack.  Slightly reduces wet "
"effects."
msgstr ""
"Wokół ust wyrosły ci owadopodobne żuchwy. Umożliwiają one szybsze jedzenie i "
"zapewniają atak wręcz w postaci cięć. Nieznacznie zmniejsza efekty "
"przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Mandibles" attacks
#. ~ Message when player with mutation "Folding Fangs" attacks
#, c-format
msgid "You bite %s with your fangs!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Mandibles" attacks
#. ~ Message when NPC with mutation "Folding Fangs" attacks
#, c-format
msgid "%1$s bites %2$s with their fangs!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Folding Fangs"
msgstr "Składane kły"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Folding Fangs"
msgid ""
"You have developed deadly extensible fangs, allowing you to bite quickly or "
"ensure your venom goes home, as desired."
msgstr ""
"Udało ci się rozwinąć śmiercionośne, wysuwane kły, dzięki którym możesz "
"szybko ukąsić lub sprawić, by jad trafił do domu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Crab Legs"
msgstr "Krabie nogi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Crab Legs"
msgid ""
"You have four prong-tipped legs, splayed out and articulated like a crab's.  "
"They're a little quieter than human feet."
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Mutation name
msgid "Gastropod Foot"
msgstr "Stopa brzuchonoga"

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Description of mutation "Gastropod Foot"
msgid ""
"Your legs have consolidated into a single muscular 'foot' that goes up into "
"your belly.  You move about a fourth of your previous speed and can no longer "
"wear pants or shoes, on the other hand you make significantly less noise.  In "
"addition to being harder to knock down, you can move through sludge-covered "
"surfaces easily."
msgstr ""
"Twoje nogi skonsolidowały się w pojedynczą muskularną „stopę”, która wchodzi "
"w brzuch. Poruszasz się około jednej czwartej swojej poprzedniej prędkości i "
"nie możesz już nosić spodni ani butów, z drugiej strony robisz znacznie mniej "
"hałasu. Oprócz tego, że trudniej cię przewrócić, możesz z łatwością poruszać "
"się po powierzchniach pokrytych szlamem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Gastropod Balance"
msgstr "Balans brzuchonoga"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Gastropod Balance"
msgid ""
"By pushing your whole 'foot' against the ground you are able to move across "
"rough terrain without losing your 'footing'.  You're also able to cling to "
"the ground underwater, allowing you to move along the bottom more easily."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mucus Secretion"
msgstr "Wydzielanie śluzu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mucus Secretion"
msgid ""
"You once had a significant other call you slimy, now you exemplify that.  It "
"covers everything you come into contact with but now you can move through "
"slime you didn't create with ease."
msgstr ""
"Twój partner kiedyś nazwał cię oślizgłym, teraz jesteś tego przykładem. "
"Dotyczy to wszystkiego, z czym się stykasz, ale teraz możesz się poruszać po "
"śluzie, którego nie stworzyłeś z łatwością."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Acidic Secretion"
msgstr "Wydzielanie kwasu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Acidic Secretion"
msgid ""
"Your mucus has developed an acidic component that seems to soften your prey "
"up."
msgstr ""
"W twoim śluzie pojawił się kwaśny składnik, który wydaje się zmiękczać twoją "
"ofiarę."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Acidic Secretion" attacks
#, c-format
msgid "You smear slime on %s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Acidic Secretion" attacks
#, c-format
msgid "%1$s smears slime on %2$s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Snail Trail"
msgstr "Ślad śluzu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Snail Trail"
msgid ""
"You've developed some ability to control your slime emissions.  As a result "
"of this you can leave trails of slime anywhere you walk."
msgstr ""
"Masz rozwiniętą pewną zdolność do kontrolowania emisji śluzu. Dzięki temu "
"możesz zostawiać ślady śluzu gdziekolwiek się udasz."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Canine Ears"
msgstr "Psie uszy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Canine Ears"
msgid ""
"Your ears have extended into long, pointed ones, like those of a canine.  "
"They enhance your hearing, allowing you to hear at greater distances."
msgstr ""
"Twoje uszy zmieniły się w długie i szpiczaste, jak u psa. Ulepszają słuch, "
"pozwalając słyszeć dźwięki z dalszych odległości."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lupine Ears"
msgstr "Wilcze uszy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lupine Ears"
msgid ""
"Your hearing has evolved further and is now on par with that of wolves.  You "
"can hear things significantly farther away."
msgstr ""
"Twój słuch ulepszył się jeszcze bardziej, dorównując wilczemu. Słyszysz ze "
"znacznie dalszych odległości."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Feline Ears"
msgstr "Kocie uszy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Feline Ears"
msgid ""
"Your ears have extended into long, pointed, velvety ones, like those of a "
"feline.  You find it easier to tune in on sounds from afar."
msgstr ""
"Twoje uszy zmieniły się w długie, szpiczaste i jedwabiste jak u kota. Łatwiej "
"ci wyławiać dźwięki z daleka."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Ursine Ears"
msgstr "Niedźwiedzie uszy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Ursine Ears"
msgid ""
"Your ears have grown longer and rounder, much like those of a bear.  You can "
"hear things a little farther away."
msgstr ""
"Twoje uszy urosły i zaokrągliły się, jak u niedźwiedzia. Słyszysz dźwięki z "
"nieco dalszych odległości."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pointed Ears"
msgstr "Szpiczaste uszy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pointed Ears"
msgid ""
"Your upper earlobes have grown noticeably higher.  Fortunately, they don't "
"get in the way of your headgear, much.  Unfortunately, they also don't seem "
"to help your hearing any."
msgstr ""
"Twoje górne płatki uszne wyrosły znacznie wyżej. Szczęśliwie nie wchodzą w "
"drogę nakryciom głowy. Niestety nie wygląda też na to, żeby usprawniały twój "
"słuch."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rodent Ears"
msgstr "Uszy gryzonia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rodent Ears"
msgid ""
"Your ears are huge, round, and gray!  They're rather fascinating, and help "
"you hear from a much greater distance."
msgstr ""
"Twoje uszy są duże, okrągłe i szare! Są dość fascynujące i pomagają ci "
"słyszeć z o wiele większej odległości"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Web Walker"
msgstr "Kroczący w sieciach"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Web Walker"
msgid ""
"Your body excretes very fine amounts of a chemical which prevents you from "
"sticking to webs.  Walking through webs does not affect you at all."
msgstr ""
"Twoje ciało wydziela niewielkie ilości związku chemicznego zapobiegającego "
"przyklejaniu się do pajęczyn. Chodzenie wśród pajęczyn w ogóle na ciebie nie "
"wpływa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Web Spinner"
msgstr "Przędzarz sieci"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Web Spinner"
msgid ""
"Your body produces and anchors webbing.  Too bad you can't seem to control "
"the process.  There is a chance that you will leave webs in your wake."
msgstr ""
"Twoje ciało produkuje i daje oparcie sieci pajęczej. Szkoda że nie "
"kontrolujesz tego procesu. Jest szansa na to, że pozostawisz za sobą "
"pajęczynę."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Web Weaver"
msgstr "Sieciarz"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Web Weaver"
msgid ""
"You've developed the necessary anatomy and techniques to control your "
"web-generation.  Activate this to start or stop weaving webs."
msgstr ""
"Rozwinąłeś niezbędną anatomię i techniki kontroli wytwarzania swojej sieci "
"pajęczej. Aktywuj, by rozpocząć lub zatrzymać splatanie sieci."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Web Diver"
msgstr "Nurek sieci"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Web Diver"
msgid ""
"Your webbing is strong enough to support your weight.  Activate to rappel "
"down any drop you encounter, at the cost of nutrition."
msgstr ""
"Twoje pajęczyny są wystarczająco mocne, by utrzymać twoją wagę. Aktywuj, by "
"zjechać z każdej napotkanej wysokości, kosztem pożywienia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rope Webs"
msgstr "Liny z sieci"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rope Webs"
msgid "With spinnerets like THESE, who needs rope?!  Activate to produce rope."
msgstr ""
"Z TAKIMI kądziołkami przędnymi kto potrzebował by liny?! Aktywuj, by "
"wyprodukować linę."

#: data/json/mutations/mutations.json
#. ~ Message when spawning item "rope_30" with mutation "Rope Webs"
msgid "You spin a rope from your silk."
msgstr "Pleciesz linę ze swojego jedwabiu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Whiskers"
msgstr "Wibrysy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Whiskers"
msgid ""
"You have a handsome set of whiskers around your mouth.  These make you more "
"aware of vibrations in the air, and improve your ability to dodge very "
"slightly."
msgstr ""
"Masz atrakcyjny zestaw wibrysów wokół ust. Sprawiają, że jesteś bardziej "
"świadomy wibracji powietrza i nieznacznie ulepszają zdolność uników."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Wiry Whiskers"
msgstr "Szorstkie wibrysy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Wiry Whiskers"
msgid ""
"You have a set of prominent rodent-like whiskers around your mouth.  These "
"make you more aware of vibrations in the air, and improve your ability to "
"dodge slightly."
msgstr ""
"Masz wydatny zestaw szczurzych wibrysów wokół ust. Sprawiają, że jesteś "
"bardziej świadomy wibracji powietrza i nieznacznie ulepszają zdolność uników."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fat Deposits"
msgstr "Depozyty tłuszczu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fat Deposits"
msgid ""
"You've put on some additional weight around your body.  It slows you down a "
"little, but helps your swimming and warmth."
msgstr ""
"Odłożyłeś nieco dodatkowej masy wokół ciała. Nieco cię spowalnia, ale pomaga "
"w pływaniu i utrzymaniu ciepła."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Inconveniently Large"
msgstr "Niedogodnie duży"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Inconveniently Large"
msgid ""
"You have grown noticeably taller and broader.  Much of it is useful muscle "
"mass (Strength +2), but you find it throws off your balance and you get in "
"your own way (+10 torso and arm encumbrance)."
msgstr ""
"Wyrosłeś i jesteś zauważalnie wyższy i szerszy. Większość z tego to użyteczna "
"masa mięśniowa (siła +2), ale zauważasz, że jesteś mniej stabilny i sam sobie "
"wchodzisz w drogę (+10 do skrępowania tułowia i rąk)."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Large"
msgid "You carry your rugged body with the dignity you deserve.  Strength +2."
msgstr "Nosisz swoje silne ciało z szacunkiem na jaki zasługuje. Siła +2."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Freakishly Huge"
msgstr "Dziwacznie olbrzymi"

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutation_paths/black_dragon.json
#. ~ Description of mutation "Freakishly Huge"
#. ~ Description of mutation "Freakish Draconic Maturity"
msgid ""
"You have grown even more massive, to the point where you cannot usefully fit "
"into human-sized clothing or vehicles.  Much of it is powerful muscle mass "
"(Strength +4), but it's a real pain to haul around."
msgstr ""
"Wyrosłeś nawet bardziej masywny niż przedtem, do poziomu w którym nie "
"mieścisz się w ludzkiego rozmiaru ubrania i pojazdy. Większość tego to silna "
"masa mięśniowa (Siła +4), ale sprawia dużo problemów, by ją dźwigać dookoła."

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutation_paths/black_dragon.json
#: data/mods/Magiclysm/mutations/shapeshifter_mutations.json
#. ~ Description of mutation "Huge"
#. ~ Description of mutation "Draconic Maturity"
msgid ""
"Your cardiovascular system has caught up with your muscular physique, so who "
"needs pathetic human cars?  Strength +4."
msgstr ""
"Twój układ sercowo-naczyniowy doścignął twoją muskularną fizjonomię, więc po "
"co komu te żałosne ludzkie samochody? Siła +4."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Strong"
msgstr "Siła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Strong"
msgid "Your muscles are a little stronger.  +1 Strength."
msgstr "Twoje mięśnie są nieco silniejsze. +1 siły."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Strong"
msgstr "Duża siła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Strong"
msgid "Your muscles are stronger.  +2 Strength."
msgstr "Twoje mięśnie są silniejsze. +2 siły."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extremely Strong"
msgstr "Niezwykła siła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extremely Strong"
msgid "Your muscles are much stronger.  +4 Strength."
msgstr "Twoje mięśnie są znacznie silniejsze. +4 siły."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insanely Strong"
msgstr "Obłędna siła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insanely Strong"
msgid "Your muscles are noticeably bulging.  +7 Strength."
msgstr "Twoje mięśnie są jak bochny chleba. +7 siły."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Prime Strength"
msgstr "Szczytowa siła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Prime Strength"
msgid "Your muscles are perfectly developed."
msgstr "Twoje mięśnie są doskonale ukształtowane."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Dextrous"
msgstr "Zręczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Dextrous"
msgid "You are a little nimbler.  +1 Dexterity."
msgstr "Jesteś nieco zwinniejszy. +1 zręczności."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Dextrous"
msgstr "Duża zręczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Dextrous"
msgid "You are nimbler.  +2 Dexterity."
msgstr "Jesteś zwinniejszy. +2 zręczności."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extremely Dextrous"
msgstr "Wyjątkowa zręczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extremely Dextrous"
msgid "You are nimble and quick.  +4 Dexterity."
msgstr "Jesteś zwinny i szybki. +4 zręczności."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insanely Dextrous"
msgstr "Obłędna zręczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insanely Dextrous"
msgid "You are much nimbler than before.  +7 Dexterity."
msgstr "Jesteś zwinny jak nikt dotąd. +7 zręczności."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Prime Dexterity"
msgstr "Szczytowa zręczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Prime Dexterity"
msgid "You're perfectly coordinated."
msgstr "Masz doskonałą koordynację."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Smart"
msgstr "Bystrość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Smart"
msgid "You are a little smarter.  +1 Intelligence."
msgstr "Jesteś nieco mądrzejszy. +1 inteligencji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Smart"
msgstr "Duża bystrość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Smart"
msgid "You are smarter.  +2 Intelligence."
msgstr "Jesteś mądrzejszy. +2 inteligencji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extremely Smart"
msgstr "Niezwykła bystrość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extremely Smart"
msgid "You are much smarter, and your skull bulges slightly.  +4 Intelligence."
msgstr ""
"Jesteś znacznie mądrzejszy, a twoja czaszka jest nieco bardziej wypukła. +4 "
"inteligencji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insanely Smart"
msgstr "Obłędna bystrość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insanely Smart"
msgid "Your skull bulges noticeably due to your impressive brain.  +7 Intelligence."
msgstr ""
"Twoja czaszka wybrzusza się zauważalnie pod wpływam twojego imponującego "
"mózgu. +7 inteligencji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Prime Intelligence"
msgstr "Szczytowa inteligencja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Prime Intelligence"
msgid "You understand almost everything about which you think, with minimal effort."
msgstr "Rozumiesz wszystko o czym pomyślisz, przy minimalnej dozie wysiłku."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Distributed Neurology"
msgstr "Rozproszona neurologia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Distributed Neurology"
msgid ""
"Your brain has evolved beyond human imagination.  You'll show them the REAL "
"meaning of 'gray goo'!"
msgstr ""
"Twój mózg ewoluował poza granice ludzkiej wyobraźni. Pokażesz im PRAWDZIWE "
"znaczenie „szarej materii”!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Perceptive"
msgstr "Spostrzegawczość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Perceptive"
msgid "Your senses are a little keener.  +1 Perception."
msgstr "Twoje zmysły są nieco wyostrzone. +1 percepcji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Perceptive"
msgstr "Duża spostrzegawczość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Perceptive"
msgid "Your senses are keener.  +2 Perception."
msgstr "Twoje zmysły są wyostrzone. +2 percepcji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extremely Perceptive"
msgstr "Wyjątkowa spostrzegawczość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extremely Perceptive"
msgid "Your senses are much keener.  +4 Perception."
msgstr "Twoje zmysły są bardzo wyostrzone. +4 percepcji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insanely Perceptive"
msgstr "Obłędna spostrzegawczość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insanely Perceptive"
msgid "You can sense things you never imagined.  +7 Perception."
msgstr "Wyczuwasz rzeczy o których nigdy nawet sobie nie wyobrażałeś. +7 percepcji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Prime Perception"
msgstr "Szczytowa spostrzegawczość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Prime Perception"
msgid "Your senses are keenly honed."
msgstr "Twoje zmysły osiągnęły doskonałą ostrość."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sensory Disintegration"
msgstr "Dezintegracja zmysłów"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sensory Disintegration"
msgid ""
"Your sense organs are all over the place: eyes extending and retracting, "
"'ears' of various shapes migrating about, and taste & smell are "
"uncontrollable.  The world is a horrible mixup.  Ugh!"
msgstr ""
"Twoje organy zmysłów rozlazły się tu i ówdzie; oczy wyciągają się i chowają, "
"„uszy” różnych kształtów migrują swobodnie, a zmysły smaku i zapachu są poza "
"twoja kontrolą. Świat jest straszliwą sieczką. Uch!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Distributed Senses"
msgstr "Rozproszone zmysły"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Distributed Senses"
msgid ""
"You can now extend and reabsorb sensory organs at will, and can therefore "
"ignore most shocks that would overwhelm lesser beings."
msgstr ""
"Możesz teraz formować i wchłaniać narządy zmysłów na żądanie, i w ten sposób "
"ignorować większość szoków, które poraziłyby pośledniejsze istoty."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Slimewave"
msgstr "Fale śluzu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slimewave"
msgid ""
"You can communicate with your extant mass without physical contact, absorbing "
"knowledge from nearby friendly slime."
msgstr ""
"Możesz komunikować się ze swoją masą bez kontaktu fizycznego, wchłaniając "
"wiedzę od pobliskich przyjaznych śluzów."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Short"
msgstr "Bardzo niski wzrost"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Short"
msgid ""
"You are significantly shorter than the general population.  You can't carry "
"quite as much as a person of average height and you need special "
"accommodations to drive a car, but otherwise being little isn't too much of a "
"bother."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Tall"
msgstr "Bardzo wysoki wzrost"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Tall"
msgid ""
"You are significantly taller than the general population.  This leaves you "
"with high blood pressure, a big appetite, and some minor health concerns, but "
"you can carry a bit more than normal."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Little"
msgstr "Mały"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Little"
msgid ""
"You've noticeably shrunk in size.  You're able to move with increased "
"litheness, but your smaller stature prevents you from carrying as much."
msgstr ""
"Masz znacząco mniejszy rozmiar. Jesteś w stanie poruszać się ze zwiększoną "
"giętkością, ale twoja mniejsza postawa uniemożliwia ci dźwiganie tyle."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tiny"
msgid ""
"You're only half as tall as you used to be!  The weight of things you once "
"found easy to carry is now unbearable, clothes are now twice as encumbering "
"for you unless you refit them (since you're half their size), and your hit "
"points are heavily reduced.  However, your movement is silent, and your dodge "
"skill is a little higher."
msgstr ""
"Masz tylko połowę wysokości niż wcześniej! Ciężar rzeczy, które kiedyś można "
"było łatwo nosić, jest teraz nie do zniesienia, ubrania są teraz dwa razy "
"bardziej krępujące, chyba że zmienisz im rozmiar (ich rozmiar jest dwa razy "
"większy od ciebie), a twoje punkty żywotności są znacznie zmniejszone. Jednak "
"twój ruch jest cichy, a twoja umiejętność uników jest nieco wyższa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Unassuming"
msgstr "Skromny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Unassuming"
msgid ""
"You've mastered your tiny form!  Item encumbrance and carry weight penalties "
"are reduced, and you've learned to use your increased nimbleness to offset "
"your reduced capacity to absorb damage."
msgstr ""
"Udało ci się opanować swoją maleńką formę! Zmniejszają się obciążenia i kary "
"związane z obciążeniem przedmiotów, a także uczysz się wykorzystywać swoją "
"zwiększoną zwrotność, aby zrównoważyć zmniejszoną zdolność do absorbowania "
"obrażeń."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Crafty"
msgstr "Podstępny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Crafty"
msgid ""
"By making the most of your small stature, you can avoid the notice of all but "
"the most perceptive creatures, and your speed is greatly increased."
msgstr ""
"Wykorzystując w pełni swój mały wzrost, możesz uniknąć zwracania uwagi "
"wszystkich, poza najbardziej spostrzegawczych stworzeń, a twoja szybkość jest "
"znacznie większa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Metallassomaiphile"
msgstr "Mutafil"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Metallassomaiphile"
msgid ""
"Just thinking of mutagen (such a lovely word!  'Mutagen'.  Perfect!) makes "
"you thirsty.  And you so love your new parts.  You simply must have more "
"mutagen!"
msgstr ""
"Sama myśl o mutagenie (co za cudowne słowo! „Mutagen”. Poezja!) sprawia, że "
"się ślinisz. I kochasz swoje nowe części. Po prostu musisz mieć więcej "
"mutagenu!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Head Bumps"
msgstr "Guzy na głowie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Head Bumps"
msgid "You have a pair of bumps on your skull."
msgstr "Masz dwa guzy na swojej czaszce."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Slit Nostrils"
msgstr "Szparkowate nozdrza"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slit Nostrils"
msgid ""
"You have a flattened nose and thin slits for nostrils, giving you a "
"lizard-like appearance.  This makes breathing slightly difficult and "
"increases mouth encumbrance by 10."
msgstr ""
"Masz spłaszczony nos z parą szparek jako nozdrza, co daje ci jaszczurczy "
"wygląd. Utrudnia to trochę oddychanie i zwiększa skrępowanie ust o 10."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Forked Tongue"
msgstr "Rozwidlony język"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Forked Tongue"
msgid "Your tongue is forked, like that of a reptile.  This has no effect."
msgstr "Twój język jest rozwidlony, jak u gada. Nie ma to żadnego efektu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lolling Tongue"
msgstr "Wytaczający się język"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lolling Tongue"
msgid ""
"Your tongue has lengthened and often extends far beyond your mouth.  This has "
"no effect."
msgstr ""
"Twój język wydłużył się i często wystaje daleko poza usta. Nie ma to "
"znaczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Whipping Tongue"
msgstr "Biczujący język"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Whipping Tongue"
msgid ""
"You've developed an extremely long and mobile tongue.  You may use it to "
"attack your enemies and pull them towards you."
msgstr ""
"Masz rozwinięty niezwykle długi i ruchliwy język. Możesz go używać do "
"atakowania swoich wrogów i przyciągania ich ku sobie."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Whipping Tongue" attacks
#, c-format
msgid "You swipe %s with your tongue!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Whipping Tongue" attacks
#, c-format
msgid "%1$s swipes %2$s with their tongue!"
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Mutation name
msgid "Bulging Eyes"
msgstr "Wyłupiaste oczy"

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Description of mutation "Bulging Eyes"
msgid ""
"Your eyes bulge out several inches from your skull.  This does not affect "
"your vision in any way."
msgstr ""
"Twoje oczy wystają kilka cali poza czaszkę. Nie wpływa to na twój wzrok w "
"żaden sposób."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Intermediate Eyestalks"
msgstr "Pośrednie łodygi oczne"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Intermediate Eyestalks"
msgid ""
"Your eyes barely protrude from your head on tentacles, preventing the use of "
"any rigid eyewear.  On the plus side, you can have additional awareness, but "
"sometimes your vision goes wonky as your brain tries to process the new "
"angles.  Perception +1"
msgstr ""
"Twoje oczy ledwo wystają z głowy na mackach, co uniemożliwia używanie "
"jakichkolwiek sztywnych okularów. Plusem jest to, że możesz mieć dodatkową "
"świadomość otoczenia, ale czasami twoje widzenie jest dziwne, gdy twój mózg "
"próbuje przetworzyć nowe kąty. Percepcja +1"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Eyestalks"
msgstr "Łodygi oczne"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Eyestalks"
msgid ""
"Your eyes protrude from your head on flexible tentacles, preventing the use "
"of any eyewear.  On the plus side, you can see in two directions at once, and "
"they automatically retract to reduce damage.  Perception +2"
msgstr ""
"Twoje oczy wystają z głowy na elastycznych mackach, uniemożliwiając "
"korzystanie z jakichkolwiek okularów. Na plus należy zaliczyć to, że możesz "
"widzieć w dwóch kierunkach jednocześnie i automatycznie się chowają, aby "
"zmniejszyć obrażenia. Percepcja +2"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rigid Eyestalks"
msgstr "Sztywne gałki oczne"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rigid Eyestalks"
msgid ""
"You have compound eyes on rigid stalks that can fold back against your head "
"to protect them from danger.  This gives you better all-around vision and "
"allows you to see underwater, but interferes with eyewear.  Perception +1"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mouth Flaps"
msgstr "Klapy ustne"

#: data/json/mutations/mutations.json
#: data/mods/Aftershock/mutations/mutations.json
#: data/mods/aftershock_exoplanet/mutations/mutations.json
#. ~ Description of mutation "Mouth Flaps"
#. ~ Description of mutation "Mouth Tendrils"
msgid ""
"Skin tabs and odd flaps of skin surround your mouth.  They don't affect your "
"eating, but are unpleasant to look at."
msgstr ""
"Zakładki skórne i dziwne klapy ze skóry otaczają twoje usta. Nie wpływają na "
"zdolność spożywania pokarmów, ale nieprzyjemnie się na nie patrzy."

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Mutation name
msgid "Wing Stubs"
msgstr "Wypustki skrzydłowe"

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Description of mutation "Wing Stubs"
msgid ""
"You have a pair of stubby little wings projecting from your shoulderblades.  "
"They can be wiggled at will, but are useless."
msgstr ""
"Masz parę grubych małych skrzydeł wystających z łopatek. Można nimi potrząsać "
"ale są bezużyteczne."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bat Wings"
msgstr "Skrzydła nietoperza"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bat Wings"
msgid ""
"Most of your fingers have grown to tremendous length, becoming a broad pair "
"of leathery wings.  This allows you to arrest a fall or glide from a ledge if "
"you aren't too weighed down, but naturally impedes your fine motor skills.  "
"They even keep you warm when you sleep."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Butterfly Wings"
msgstr "Motyle skrzydła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Butterfly Wings"
msgid ""
"You have a very large pair of brightly-colored, very beautiful wings.  They "
"can't lift you, and they make balancing tricky, but they certainly catch air "
"and attention!"
msgstr ""
"Masz bardzo duże skrzydła w jasnych kolorach. Nie mogą cię unieść i "
"utrudniają utrzymanie równowagi, ale chwytasz wiatr i uwagę!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pale Skin"
msgstr "Blada skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pale Skin"
msgid "Your skin is rather pale."
msgstr "Twoja skóra jest raczej blada."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Spots"
msgstr "Kropki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Spots"
msgid "Your skin is covered in a pattern of red spots."
msgstr "Twoja skóra jest pokryta we wzory z czerwonych kropek."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Smelly"
msgstr "Cuchnięcie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Smelly"
msgid ""
"You smell awful.  Monsters that track scent will find you very easily, and "
"humans will react poorly."
msgstr ""
"Okropnie cuchniesz. Potwory które podążają za zapachem bardzo łatwo cię "
"znajdują, a ludzie źle na ciebie reagują."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Deformed"
msgstr "Deformacja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Deformed"
msgid "You're slightly deformed.  Some people will react badly to your appearance."
msgstr "Masz nieznaczne deformacje ciała. Niektórzy będą źle reagować na twój wygląd."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Badly Deformed"
msgstr "Mocna deformacja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Badly Deformed"
msgid ""
"You're hideously deformed.  Some people will have a strong negative reaction "
"to your appearance."
msgstr ""
"Jesteś okropnie zdeformowany. Niektórzy ludzie będą bardzo negatywnie "
"reagować na twoje pojawienie się."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Grotesque"
msgstr "Groteskowość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Grotesque"
msgid ""
"Your visage is disgusting and liable to induce vomiting.  People will not "
"want to interact with you unless they have a very good reason to."
msgstr ""
"Twoje oblicze jest obrzydliwe i może wywoływać wymioty. Ludzie nie będą "
"chcieli mieć z tobą kontaktu, chyba że z bardzo ważnej przyczyny."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Beautiful"
msgstr "Piękno"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Beautiful"
msgid ""
"You're a real head-turner.  Some people will react well to your appearance, "
"and most people have an easier time trusting you."
msgstr ""
"Obracają za tobą głowami z wrażenia. Niektórzy ludzie będą dobrze reagować na "
"twoją obecność, a większości łatwiej będzie ci zaufać."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Beautiful"
msgstr "Mocne piękno"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Beautiful"
msgid ""
"You are a vision of beauty.  Some people will react very well to your looks, "
"and most people will trust you immediately."
msgstr ""
"Jesteś obrazem piękna. Niektórzy ludzie będą bardzo dobrze reagować na twoją "
"obecność, a większość zaufa ci od ręki."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Glorious"
msgstr "Wspaniałość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Glorious"
msgid ""
"You are incredibly beautiful.  People cannot help themselves due to your "
"charms, and will do whatever they can to please you."
msgstr ""
"Jesteś niewiarygodnie piękny. Ludzie tracą głowę z powodu twojego uroku "
"osobistego i robią co mogą, by cię zadowolić."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Snout"
msgstr "Ryj"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Snout"
msgid ""
"Your face and jaw have begun… changing.  Masks and such fit OK, but you're "
"noticeably mutated."
msgstr ""
"Twoja twarz i szczęka zaczęły się… zmieniać. Maski itp. pasują, ale jesteś "
"zauważalnie zmutowany."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bovine Snout"
msgstr "Byczy pysk"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bovine Snout"
msgid ""
"Your face resembles that of a bull, with a significant snout.  It looks "
"fearsome but makes it difficult to find gear that covers your face."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lupine Muzzle"
msgstr "Wilczy pysk"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lupine Muzzle"
msgid ""
"Your jaw and nose have extended into a wolfish muzzle.  It lends itself to "
"biting in combat and looks impressive, but prevents wearing mouthgear."
msgstr ""
"Twoja szczęka i nos wydłużyły się w wilczy pysk. Przydaje się do gryzienia w "
"walce i wygląda imponująco, ale uniemożliwia noszenie sprzętu na ustach."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Lupine Muzzle" attacks
#, c-format
msgid "You nip at %s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Lupine Muzzle" attacks
#, c-format
msgid "%1$s nips and harries %2$s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Ursine Muzzle"
msgstr "Niedźwiedzi pysk"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Ursine Muzzle"
msgid ""
"Your jaw and nose have extended into a bearish muzzle.  You could bite with "
"it, and it looks impressive, but it prevents wearing mouthgear."
msgstr ""
"Twoja szczęka i nos wydłużyły się w niedźwiedzi pysk. Przydaje się do "
"gryzienia nim i wygląda imponująco, ale uniemożliwia noszenie sprzętu na "
"ustach."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Ursine Muzzle" attacks
#, c-format
msgid "You bite %s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Ursine Muzzle" attacks
#, c-format
msgid "%1$s bites %2$s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rodent Muzzle"
msgstr "Gryzoni pysk"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rodent Muzzle"
msgid "Your face and jaw have extended, giving you an alert and attentive appearance."
msgstr "Twoja twarz i szczęka wydłużyły się, dając ci czujny i uważny wygląd."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Reptilian Muzzle"
msgstr "Gadzi pysk"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Reptilian Muzzle"
msgid ""
"Your face and jaws are a shorter version of those found on alligators.  They "
"look NASTY--as do the bite wounds they can inflict--but prevent wearing "
"mouthgear."
msgstr ""
"Twoja twarz i szczęki są teraz mniejszą wersją tych u aligatorów. Wyglądają "
"PASKUDNIE i tak też wyglądają rany od ugryzień nim zadane. Uniemożliwia "
"noszenie sprzętu na ustach"

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutation_paths/black_dragon.json
#. ~ Message when player with mutation "Reptilian Muzzle" attacks
#. ~ Message when player with mutation "Scaled Mouth" attacks
#. ~ Message when player with mutation "Black Dragon Maw" attacks
#, c-format
msgid "You bite a chunk out of %s!"
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Magiclysm/mutations/mutation_paths/black_dragon.json
#. ~ Message when NPC with mutation "Reptilian Muzzle" attacks
#. ~ Message when NPC with mutation "Scaled Mouth" attacks
#. ~ Message when NPC with mutation "Black Dragon Maw" attacks
#, c-format
msgid "%1$s bites a chunk out of %2$s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Wide Mouth"
msgstr "Szerokie usta"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Wide Mouth"
msgid ""
"You have an unsettlingly wide mouth, like a frog.  This looks hideous, but "
"allows you to swallow your food whole."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Proboscis"
msgstr "Ssawka"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Proboscis"
msgid ""
"You've gotten rid of that terribly imprecise mouth and now imbibe your food "
"like a proper person.  Chewing was tiresome anyway."
msgstr ""
"Pozbyłeś się tych okropnie nieprecyzyjnych ust i teraz wysysasz jedzenie jak "
"normalna osoba. Żucie i tak było bardzo męczące."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hollow Bones"
msgstr "Puste kości"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hollow Bones"
#, no-c-format
msgid ""
"You have Avian Bone Syndrome--your bones are nearly hollow.  Your body is "
"very light as a result, enabling you to move and attack 20% faster, but also "
"frail; you can carry 40% less, and bashing attacks injure you more."
msgstr ""
"Masz Syndrom Ptasich Kości - są one niemal puste. Twoje ciało jest dzięki "
"temu bardzo lekkie, pozwalając ci poruszać się i atakować 20% szybciej, ale "
"także wrażliwe; możesz nosić 40% mniej, a ataki miażdżone zadają ci więcej "
"ran."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Dense Bones"
msgstr "Gęste kości"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Dense Bones"
#, no-c-format
msgid ""
"Your bones are particularly dense and durable.  Your tougher frame grants 5% "
"more HP and 15% more carry capacity plus bashing attacks injure you less, but "
"your higher weight makes attacking and moving 5% slower.  Also, dodging and "
"swimming are harder."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Nausea"
msgstr "Mdłości"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Nausea"
msgid ""
"You feel nauseated almost constantly, and are more liable to throw up from "
"food poisoning, alcohol, etc.  You can, if desired, think yourself into "
"vomiting, too."
msgstr ""
"Czujesz mdłości niemal stale i z więcej wymiotujesz z powodu zatruć "
"pokarmowych, alkoholu, itd. Możesz też, jeśli chcesz, samą myślą wywołać u "
"siebie wymioty."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Vomitous"
msgstr "Wymioty"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Vomitous"
msgid ""
"You have a major digestive disorder.  Though it causes you to vomit "
"frequently, you have found that you can trigger your vomit reflex on demand, "
"too."
msgstr ""
"Masz poważne problemy trawienne. Powoduje to częste wymioty, ale też "
"zauważasz, że możesz na życzenie wywołać odruch wymiotny."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Persistence Hunter"
msgstr "Wytrwałość łowcy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Persistence Hunter"
msgid ""
"You can pursue prey for miles and miles at a variety of paces until they stop "
"from exhaustion."
msgstr ""
"Możesz ścigać ofiarę kilometrami w różnym tempie, aż zatrzyma się z "
"wyczerpania."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extreme Persistence Hunter"
msgstr "Ekstremalna wytrwałość łowcy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extreme Persistence Hunter"
msgid ""
"You can pursue prey for days until they literally die from exhaustion.  It's "
"too bad zombies don't fatigue either."
msgstr ""
"Możesz ścigać ofiarę przez wiele dni, aż dosłownie umrze z wyczerpania. "
"Szkoda, że zombie też się nie męczą."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fast Metabolism"
msgstr "Szybki metabolizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fast Metabolism"
msgid "You require more food than most people, but recover stamina slightly faster."
msgstr ""
"Potrzebujesz więcej żywności niż większość ludzi, ale odzyskujesz staminę "
"nieco szybciej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rapid Metabolism"
msgstr "Gwałtowny metabolizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rapid Metabolism"
msgid ""
"You require more resources than most, but heal more rapidly as well.  "
"Provides weak regeneration even when not asleep."
msgstr ""
"Potrzebujesz więcej zasobów niż większość, ale leczysz się także szybciej. "
"Zapewnia słabą regenerację nawet kiedy nie śpisz."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Fast Metabolism"
msgstr "Bardzo szybki metabolizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Fast Metabolism"
msgid ""
"You need about twice as much food as the average human to maintain your "
"expanded cardiovascular and respiratory systems.  On the plus side, it "
"doesn't take you much time to recover from any strenuous activity."
msgstr ""
"Potrzebujesz około dwa razy więcej pożywienia niż przeciętny człowiek, by "
"podtrzymać swój rozwinięty układ naczyniowo-sercowy i oddechowy. Na plus "
"liczy się to, że nie potrzebujesz wiele czasu, by odzyskać siły po "
"wyczerpujących czynnościach."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extreme Metabolism"
msgstr "Ekstremalny metabolizm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extreme Metabolism"
msgid ""
"You consume three times as much food as the average human to maintain your "
"truly superhuman endurance."
msgstr ""
"Spożywasz trzykrotność tego co zjada przeciętny człowiek, by utrzymać swoją "
"nadludzką wytrzymałość."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "High Thirst"
msgstr "Podwyższone pragnienie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "High Thirst"
msgid "Your body dries out easily; you need to drink more water."
msgstr "Twoje ciało łatwo się odwadnia; musisz pić więcej wody."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Thirsty"
msgstr "Wysokie pragnienie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Thirsty"
msgid ""
"Ugh, out of water already?  You need about twice the fluids of an average "
"human."
msgstr ""
"Ugh, znów się woda skończyła? Potrzebujesz w przybliżeniu dwa razy więcej "
"płynów niż przeciętny człowiek."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extremely Thirsty"
msgstr "Ekstremalne pragnienie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extremely Thirsty"
msgid ""
"You dry out seriously quickly, requiring three times as much liquid to stay "
"hydrated."
msgstr ""
"Odwadniasz się w bardzo szybkim tempie i potrzebujesz potrójnej dawki płynów, "
"by się nawodnić."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Metabolic Rehydration"
msgstr "Metaboliczne nawodnienie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Metabolic Rehydration"
msgid ""
"Your body gets everything it needs from the food that you eat!  You no longer "
"need hydration from fluids."
msgstr ""
"Twoje ciało otrzymuje wszystko, czego potrzebuje z jedzenia które jesz! Nie "
"musisz już pić płynów."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Heavy Sleeper"
msgstr "Bardzo mocny sen"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Heavy Sleeper"
msgid "You could probably sleep through a firefight."
msgstr "Prawdopodobnie przespałbyś akcję gaśniczą."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Sleepy"
msgstr "Duża senność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Sleepy"
msgid ""
"You find yourself needing to sleep quite often.  You'll spend about half of "
"your time in or around a bed."
msgstr "Często odczuwasz potrzebę snu. Spędzasz połowę czasu w lub w pobliżu łóżka."

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/spells/eater_spells.json
#. ~ Mutation name
#. ~ Name of spell "spell_weak"
msgid "Weakening"
msgstr "Osłabienie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Weakening"
msgid "You feel as though you are slowly weakening and your body heals slower."
msgstr "Czujesz, że powoli słabniesz i twoje ciało leczy się wolniej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Deterioration"
msgstr "Podupadły"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Deterioration"
msgid "Your body is very slowly wasting away."
msgstr "Twoje ciało bardzo powoli wyniszcza się."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Disintegration"
msgstr "Dezintegracja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Disintegration"
msgid "Your body is slowly wasting away!"
msgstr "Twoje ciało powoli wyniszcza się!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Solar Sensitivity"
msgstr "Wrażliwość na słońce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Solar Sensitivity"
msgid ""
"Your skin simply cannot handle ultraviolet radiation, such as sunlight.  It "
"will seriously burn you."
msgstr ""
"Twoja skóra po prostu nie radzi sobie z promieniowaniem UV, jak np. światło "
"słoneczne. Poważnie cię poparzy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sores"
msgstr "Wrzody"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sores"
msgid ""
"Your extremities are covered in painful sores.  The pain is worse when they "
"are covered in clothing."
msgstr ""
"Twoje kończyny pokrywają bolesne wrzody. Ból jest intensywniejszy gdy są "
"zasłonięte ubraniem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Light Sensitive"
msgstr "Wrażliwość na światło"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Light Sensitive"
msgid ""
"Sunlight makes you uncomfortable.  If you are outdoors and the weather is "
"Sunny, you suffer -1 to all stats."
msgstr ""
"Światło słoneczne powoduje u ciebie dyskomfort. Gdy jesteś na zewnątrz w "
"słoneczną pogodę, cierpisz karę -1 do wszystkich statystyk."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Light Sensitive"
msgstr "Duża wrażliwość na światło"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Light Sensitive"
msgid ""
"Sunlight makes you very uncomfortable.  If you are outdoors during the day, "
"you suffer -1 to all stats; -2 if the weather is Sunny."
msgstr ""
"Światło słoneczne powoduje u ciebie wielki dyskomfort. Gdy jesteś na zewnątrz "
"w dzień, cierpisz karę -1 do wszystkich statystyk, a w słoneczną pogodę -2."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Troglobite"
msgid ""
"Sunlight makes you extremely uncomfortable, resulting in large penalties to "
"all stats."
msgstr ""
"Światło słoneczne powoduje u ciebie olbrzymi dyskomfort, skutkując dużymi "
"karami do wszystkich statystyk."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Webbed Hands"
msgstr "Błona pławna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Webbed Hands"
msgid ""
"Your hands are heavily webbed, reducing your Dexterity by 1 and causing "
"problems with gloves.  However, you can swim much faster.  Slightly decreases "
"wet penalties."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Webbed Feet"
msgstr "Pajęcze stopy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Webbed Feet"
msgid ""
"Your feet are heavily webbed, allowing you to swim faster if you aren't "
"wearing footwear."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Paws"
msgstr "Łapy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Paws"
msgid ""
"Your hands have fused into quasi-paws.  Fine manipulation is a challenge: "
"permanent hand encumbrance of 10, difficulty with delicate craftwork, and "
"your gloves don't fit.  But they handle water better and bear weight well, "
"allowing you to move on all fours when crouching and unarmed."
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
#. ~ Trigger message of mutation "Paws"
#. ~ Trigger message of mutation "Broad Paws"
#. ~ Trigger message of mutation "Little Paws"
#. ~ Trigger message of mutation "Quadruped"
msgid "You come out of your quadrupedal posture."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Broad Paws"
msgstr "Szerokie łapy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Broad Paws"
msgid ""
"Your paws are much larger now.  Manual dexterity is difficult: permanent hand "
"encumbrance of 20, serious problems crafting, and no gloves.  In return, "
"though, you can swim better and move on all fours when crouching and unarmed."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Beak"
msgstr "Dziób"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Beak"
msgid ""
"You have a beak for a mouth.  You can occasionally use it to peck at your "
"enemies, but it is impossible for you to wear mouth gear.  Slightly reduces "
"wet effects."
msgstr ""
"Masz dziób zamiast ust. Możesz okazjonalnie dziobać wrogów, ale nie możesz na "
"nim nic nosić. Nieznacznie redukuje efekty przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Beak" attacks
#, c-format
msgid "You peck %s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Beak" attacks
#, c-format
msgid "%1$s pecks %2$s!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Woodpecker Beak"
msgstr "Dziób dzięcioła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Woodpecker Beak"
msgid ""
"Pecking at prey is part of your daily routine now.  Slightly reduces wet "
"effects."
msgstr ""
"Dziobanie ofiar to teraz twoje codzienne zajęcie. Nieznacznie redukuje efekty "
"przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Woodpecker Beak" attacks
#, c-format
msgid "You jackhammer into %s with your beak!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Woodpecker Beak" attacks
#, c-format
msgid "%1$s jackhammer into %2$s with their beak!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hummingbird Beak"
msgstr "Dziób kolibra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hummingbird Beak"
msgid ""
"Though your beak's not suitable for pecking, those flowers out there are a "
"good source of energy.  Examine them to feed."
msgstr ""
"Choć twój dziób nie nadaje się do dziobania, to kwiaty polne są za to dobrym "
"źródłem energii. Zbadaj je, by się pożywić."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Genetically Unstable"
msgstr "Niestabilność genetyczna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Genetically Unstable"
msgid ""
"Your DNA has been damaged in a way that causes you to continually develop "
"more mutations."
msgstr ""
"Twoje DNA zostało uszkodzone w sposób powodujący stałe powstawanie nowych "
"mutacji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Catastrophic Mutation"
msgstr "Katastrofalna mutacja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Catastrophic Mutation"
msgid ""
"Exposure to portal storms and related phenomena causes you to mutate in a "
"mostly predictable fashion."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Genetic Chaos"
msgstr "Chaos genetyczny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Genetic Chaos"
msgid ""
"Your body alters itself rapidly, and without your intervention or conscious "
"control."
msgstr ""
"Twoje ciało zmienia się gwałtownie i bez twojej interwencji lub świadomej "
"kontroli."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Minor Radioactivity"
msgstr "Lekka radioaktywność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Minor Radioactivity"
msgid ""
"Your body has become radioactive!  You continuously emit low levels of "
"radiation, which slowly contaminates the world around you."
msgstr ""
"Twoje ciało stało się radioaktywne! Stale emitujesz niewielkie wartości "
"promieniowania, które wolno skażają świat wokół ciebie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Radioactivity"
msgstr "Radioaktywność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Radioactivity"
msgid ""
"Your body has become radioactive!  You continuously emit moderate levels of "
"radiation, which contaminates the world around you."
msgstr ""
"Twoje ciało stało się radioaktywne! Stale emitujesz umiarkowane wartości "
"promieniowania, które skażają świat wokół ciebie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Severe Radioactivity"
msgstr "Poważna radioaktywność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Severe Radioactivity"
msgid ""
"Your body has become radioactive!  You continuously emit heavy levels of "
"radiation, making your surroundings unlivable."
msgstr ""
"Twoje ciało stało się radioaktywne! Stale emitujesz twarde promieniowanie, "
"które czyni twoje otoczenie niezdatnym do życia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Slimy"
msgstr "Śluzowatość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Slimy"
msgid ""
"Your body is coated with a fine slime which makes uncovered skin harder to "
"grab and protects from long-term effects of acid, though not short-term ones. "
" Greatly increases wet benefits."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Viscous"
msgstr "Lepkość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Viscous"
msgid ""
"Your body's slime output has become sticky and gel-like, making uncovered "
"skin harder to grab and offering some protection from acid.  Greatly "
"increases wet benefits."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Amorphous Body"
msgstr "Amorficzne ciało"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Amorphous Body"
msgid ""
"Your flesh is a pleasing gel-like consistency.  Your bodily functions seem to "
"be moving around, and your leg-equivalents flow comfortably - if a little "
"slower than your old meat-legs."
msgstr ""
"Twoje ciało ma przyjemną żelową konsystencję. Funkcje twojego ciała "
"przemieszczają się swobodnie, a ekwiwalenty nóg przyjemnie pływają - chociaż "
"trochę wolniej niż twoje stare, mięsiste nogi."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Omnicellular"
msgstr "Jednokomórkowość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Omnicellular"
msgid ""
"Your body is more or less one consistent whole: a single, giant, omni-cell "
"that alters itself as needed."
msgstr ""
"Twoje ciało jest mniej więcej homogeniczną całością: pojedynczą, gigantyczną "
"omni-komórką, która przekształca samą siebie wedle potrzeb."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Herbivore"
msgstr "Roślinożerność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Herbivore"
msgid ""
"Your body's ability to digest meat is severely hampered.  Eating meat has a "
"good chance of making you vomit it back up; even if you manage to keep it "
"down, its nutritional value is greatly reduced."
msgstr ""
"Twoja zdolność trawienia mięsa jest znacznie obniżona. Pożywianie się mięsem "
"może łatwo spowodować, że je zwrócisz; nawet, gdy je utrzymasz w żołądku, "
"jego wartość odżywcza będzie znacznie mniejsza."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Carnivore"
msgstr "Mięsożerność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Carnivore"
msgid ""
"Your body's ability to digest fruits, vegetables, grains and nuts is severely "
"hampered.  You cannot eat anything besides meat.  While your vitamin C needs "
"are lowered, it's still needed and can be found often in organ meat."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hemovore"
msgstr "Krwiopijczość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hemovore"
msgid ""
"You can still eat other food, but you crave the taste of blood over "
"everything else.  Without a steady supply or some kind of iron supplement, "
"you're prone to developing anemia."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bloodfeeder"
msgstr "Żerowanie na krwi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bloodfeeder"
msgid ""
"Your craving for blood borders on obsession.  You need the stuff too much to "
"care about whether it came from a human, and your body can filter out most of "
"the toxins in mutant blood."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Ponderous"
msgstr "Niezgrabność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Ponderous"
#, no-c-format
msgid "Your muscles are generally slow to move.  You move 10% slower."
msgstr "Twoje mięśnie generalnie ruszają się wolniej. Poruszasz się 10% wolniej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Ponderous"
msgstr "Duża niezgrabność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Ponderous"
#, no-c-format
msgid "Your muscles are quite slow to move.  You move 20% slower."
msgstr "Twoje mięśnie ruszają się wolniej. Poruszasz się 20% wolniej."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extremely Ponderous"
msgstr "Wyjątkowa niezgrabność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extremely Ponderous"
#, no-c-format
msgid "Your muscles are very slow to move.  You move 30% slower."
msgstr "Twoje mięśnie ruszają się znacznie wolniej. Poruszasz się 30% wolniej."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sunlight Dependent"
#, no-c-format
msgid ""
"You feel very sluggish when not in direct sunlight.  You suffer a 5% drop in "
"speed when in shade, and a 10% drop in speed when in the dark."
msgstr ""
"Czujesz ociężałość, gdy nie jesteś w pełnym słońcu. Cierpisz na 5% utratę "
"szybkości w cieniu i 10% utratę szybkości w ciemności."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Vines"
msgstr "Pnącza"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Vines"
msgid ""
"You have developed several vines sprouting from your shoulder area.  They're "
"bulky, and get in the way."
msgstr ""
"Wyrosło ci kilka pnączy wyrastających z okolicy ramion. Są nieporęczne i "
"przeszkadzają."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Vine Limbs"
msgstr "Pnącza kończyny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Vine Limbs"
msgid ""
"You've developed the ability to control your vines; they make good lashes.  "
"You can even rappel down sheer drops using them, but disconnecting HURTS."
msgstr ""
"Zyskałeś zdolność kontrolowania swoich pnączy; są z nich dobre baty. Możesz "
"też opuszczać się na nich z wysokości, ale odłączenie ich BOLI."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Vine Limbs" attacks
#. ~ Message when player with mutation "Vine Sprouter" attacks
#, c-format
msgid "You lash %s with one of your vines!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Vine Limbs" attacks
#. ~ Message when NPC with mutation "Vine Sprouter" attacks
#, c-format
msgid "%1$s lashes %2$s with one of their vines!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Vine Sprouter"
msgstr "Rozsadnik pnączy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Vine Sprouter"
msgid ""
"You have full control of your vines, and can grow new ones and detach old "
"ones more or less at will."
msgstr ""
"Masz pełną kontrolę nad twoimi pnączami i możesz powodować wzrost nowych oraz "
"odłączać stare niemal na żądanie."

#: data/json/mutations/mutations.json
#. ~ Message when spawning item "vine_30" with mutation "Vine Sprouter"
msgid "You detach a vine from your body."
msgstr "Odłączasz pnącze ze swojego ciała."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hair Roots"
msgstr "Korzenie we włosach"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hair Roots"
msgid ""
"Roots have started growing from your leaf-like hair.  They don't seem to do "
"much."
msgstr ""
"Korzenie zaczęły wyrastać z twoich liścio-podobnych włosów. Nie wydają się "
"robić wiele."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Toe Roots"
msgstr "Ukorzenione palce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Toe Roots"
msgid ""
"Your toes have grown wriggly, and you can't imagine why you wear that stuff "
"on your feet.  Take it off.  It's in the way."
msgstr ""
"Twoje palce u nóg są teraz wijące i nie potrafisz wyobrazić sobie powodu dla "
"którego nosisz te rzeczy na stopach. Ściągnij je, zawadzają."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Roots"
#. ~ The idea is that you, for lack of a better term, plant yourself.
#. Crafting and digging don't count because they presume a certain amount of
#. movement during the task.  The handheld game does count.
msgid ""
"It's about time you started developing a root system.  When reading, fishing, "
"waiting, or otherwise being stationary for a while on diggable terrain, "
"you'll extract nutrients and water from the soil."
msgstr ""
"Czas najwyższy na porządny system korzeniowy. Gdy czytasz, łowisz ryby, "
"czekasz, czy po prostu nie ruszasz się będąc na terenie w którym można kopać "
"będziesz pobierać z gleby wodę i składniki odżywcze."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rooter"
msgstr "Zakorzenianie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rooter"
msgid ""
"You find it difficult not to sink roots when able.  You extract nutrients and "
"water whenever on diggable terrain, but move more slowly."
msgstr ""
"Trudno ci odmówić sobie zakorzenienia w każdej dogodnej okazji. Pobierasz "
"wodę i składniki odżywcze z każdej gleby w której da się kopać, ale wolniej "
"się poruszasz."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Chloromorphosis"
msgstr "Chloromorfoza"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Chloromorphosis"
msgid ""
"Every inch of your skin is packed with chlorophyll and you have strong roots. "
" Sleeping on diggable soil will satisfy any hunger or thirst you might have."
msgstr ""
"Każdy cal twojego ciała jest napakowany chlorofilem i masz silne korzenie. "
"Sen na dającej się kopać ziemi zaspokoi każdy głód i pragnienie, którego "
"doświadczasz."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mycorrhizal Communion"
msgstr "Wspólnota mikoryzowa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycorrhizal Communion"
msgid ""
"You have gained the ability to commune with trees and comprehend their "
"ancient wisdom.  Activate next to a tree to gradually gain overmap vision "
"through connected forests."
msgstr ""
"Uzyskałeś umiejętność obcowania z drzewami i zrozumienia ich starożytnej "
"mądrości. Aktywuj obok drzewa, aby stopniowo uzyskiwać wizję nad mapą przez "
"połączone lasy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Heat Dependent"
msgstr "Zależność od ciepła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Heat Dependent"
#, no-c-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C).  This sluggishness "
"helps you conserve energy, however."
msgstr ""
"Twoje reakcje mięśniowe są zależne od otaczającej temperatury. Tracisz 1% "
"szybkości na każde 5 stopni Fahrenheita (2,8 stopnia Celsjusza) poniżej 65 F "
"(18,3 C). Ta ospałość pozwala ci jednak w zachowaniu energii."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Very Heat Dependent"
msgstr "Silna zależność od ciepła"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Very Heat Dependent"
#, no-c-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C), but your slow "
"metabolism requires much less energy."
msgstr ""
"Twoje reakcje mięśniowe są bardzo zależne od otaczającej temperatury. Tracisz "
"1% szybkości na każde 3 stopnie Fahrenheita (1,7 stopni Celsjusza) poniżej 65 "
"F (18,3 C), lecz twój wolny metabolizm wymaga mniejszych ilości energii."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cold Blooded"
msgstr "Zimnokrwistość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cold Blooded"
#, no-c-format
msgid ""
"You are cold-blooded and rely on heat to keep moving.  Your lose 1% of your "
"speed for every 2 (1.1) degrees below 65 F (18.3 C), resulting in less "
"calorie usage."
msgstr ""
"Jesteś zimnokrwisty i bazujesz na cieple, by móc się poruszać. Tracisz 1% "
"szybkości na każde 2 stopnie Fahrenheita  (1,1 stopnia Celsjusza) poniżej 65 "
"F (18,3 C), co powoduje mniejsze zużycie kalorii."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Ectothermic"
msgstr "Zmiennocieplność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Ectothermic"
#, no-c-format
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers or raises "
"1% for every 2 (1.1) degrees below or above 65 F (18.3 C).  You eat much less "
"than you otherwise would."
msgstr ""
"Twoje ciało jest na stałe zimnokrwiste. Twoja szybkość maleje, bądź rośnie na "
"każde 2 stopnie Fahrenheita (1,1 stopnia Celsjusza) poniżej. lub powyżej 65 F "
"(18,3 C). Jesz znacznie mniej niż w innym przypadku."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Growling Voice"
msgstr "Dudniący głos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Growling Voice"
msgid ""
"You have a growling, rough voice.  Persuading NPCs will be more difficult, "
"but threatening them will be easier."
msgstr ""
"Masz głęboki, dudniący, twardy głos. Perswadowanie NPC będzie trudniejsze, za "
"to zastraszanie ich będzie łatwiejsze."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Croaking Voice"
msgstr "Przeraźliwy głos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Croaking Voice"
msgid ""
"You have a low, croaking voice, like an aged grandparent.  Persuading NPCs "
"will be easier, but threatening them will be more difficult."
msgstr ""
"Masz niski, skrzeczący głos, jak stary dziadek. Przekonywanie NPC będzie "
"łatwiejsze, ale grożenie im będzie trudniejsze."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Snarling Voice"
msgstr "Warczący głos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Snarling Voice"
msgid ""
"You have a threatening snarl in your voice.  Persuading NPCs will be near "
"impossible, but threatening them will be much easier."
msgstr ""
"W twoim głosie słychać groźny warkot. Perswadowanie NPC będzie prawie "
"niemożliwe, ale zastraszanie stanie się dużo łatwiejsze."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hissing Voice"
msgstr "Syczący głos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hissing Voice"
msgid ""
"You hiss when speaking.  Persuading NPCs will be more difficult, but "
"threatening them will be easier."
msgstr ""
"Syczysz gdy mówisz. Perswadowanie NPC będzie trudniejsze, za to zastraszanie "
"ich będzie łatwiejsze."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Screeching Voice"
msgstr "Piskliwy głos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Screeching Voice"
msgid ""
"Your voice sounds like a bird trying to imitate a human.  Persuading NPCs "
"will be more difficult, but threatening them will be easier."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Shouter"
msgstr "Krzykanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Shouter"
msgid "You occasionally shout uncontrollably."
msgstr "Czasami krzyczysz niekontrolowanie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Screamer"
msgstr "Wrzaskanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Screamer"
msgid "You sometimes scream uncontrollably."
msgstr "Czasami wrzeszczysz niekontrolowanie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Howler"
msgstr "Wycie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Howler"
msgid "You frequently let out a piercing howl."
msgstr "Często wydajesz przenikliwe wycie."

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Mutation name
msgid "Feathered Arms"
msgstr "Opierzone ręce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Feathered Arms"
msgid ""
"Your arms have sprouted feathers, and you find you can no longer fully extend "
"your elbows.  This gets in the way a bit, but the feathers offer minor "
"protection from damage and the elements."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insect Limbs"
msgstr "Owadzie kończyny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insect Limbs"
msgid ""
"You've *finally* sprouted a pair of arms from your midsection.  They flail "
"more or less uncontrollably, making you feel rather larval."
msgstr ""
"*Wreszcie* wyrosła ci para rąk w środkowej sekcji. Machają niezbornie, przez "
"co czujesz się jak larwa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Insect Arms"
msgstr "Owadzie ręce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insect Arms"
msgid ""
"It's good having all your arms.  Though they're too thin to block or punch, "
"you can fold them inside human-shaped gear if need be."
msgstr ""
"Dobrze mieć wszystkie ręce. Choć są zbyt cienkie, by blokować lub uderzać, "
"możesz je złożyć wewnątrz sprzętu dla ludzi, jak zajdzie potrzeba."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Arachnid Limbs"
msgstr "Pajęcze kończyny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Arachnid Limbs"
msgid ""
"There's the last two limbs you were expecting.  Unfortunately, you still "
"can't coordinate them, so you're getting in your own way.  A lot."
msgstr ""
"Oto i ostatnia para kończyn których się spodziewasz. Niestety nadal ich nie "
"potrafisz ich koordynować, więc sam w sobie wchodzisz w drogę. Często."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Arachnid Arms"
msgstr "Pajęcze ręce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Arachnid Arms"
msgid ""
"You have four handsome limbs, and then those mutant 'hand' and 'foot' things. "
" They probably aren't worth concealing."
msgstr ""
"Masz cztery przystojne kończyny i te zmutowane rzeczy zwane „ręce” i „stopy”. "
"Raczej nie warte są ukrywania."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tentacle Arms"
msgstr "Mackowate ręce"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tentacle Arms"
msgid ""
"Your arms have transformed into tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear gloves. "
" Reduces penalties for attacking while prone and somewhat decreases wet "
"penalties."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Tentacle Arms" attacks
#. ~ Message when player with mutation "4 Tentacles" attacks
#. ~ Message when player with mutation "8 Tentacles" attacks
#, c-format
msgid "You slap %s with one of your tentacles!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Tentacle Arms" attacks
#. ~ Message when NPC with mutation "4 Tentacles" attacks
#. ~ Message when NPC with mutation "8 Tentacles" attacks
#, c-format
msgid "%1$s slaps %2$s with one of their tentacles!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Tentacle Arms" attacks
#. ~ Message when player with mutation "4 Tentacles" attacks
#. ~ Message when player with mutation "8 Tentacles" attacks
#, c-format
msgid "You rake %s with one of your tentacles!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Tentacle Arms" attacks
#. ~ Message when NPC with mutation "4 Tentacles" attacks
#. ~ Message when NPC with mutation "8 Tentacles" attacks
#, c-format
msgid "%1$s rakes %2$s with one of their tentacles!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "4 Tentacles"
msgstr "4 macki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "4 Tentacles"
msgid ""
"Your arms have transformed into four tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear gloves. "
" You can make up to 3 extra attacks with them, and you suffer reduced "
"penalties to attacking while prone.  Somewhat decreases wet penalties."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "8 Tentacles"
msgstr "8 macek"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "8 Tentacles"
msgid ""
"Your arms have transformed into eight tentacles, resulting in a +1 bonus to "
"Dexterity, permanent hand encumbrance of 30, and an inability to wear gloves. "
" You can make up to 7 extra attacks with them, and suffer reduced penalties "
"to attacking while prone.  Somewhat decreases wet penalties."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Shell"
msgstr "Skorupa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Shell"
msgid ""
"You have grown a thick shell over your torso, providing excellent armor, but "
"you cannot wear anything on your torso.  Somewhat reduces wet effects."
msgstr ""
"Wyrosła ci twarda skorupa wokół tułowia, zapewniając doskonałą zbroję, lecz "
"nie możesz niczego nosić na tułowiu. Trochę redukuje efekty przemoczenia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Roomy Shell"
msgstr "Przestronna skorupa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Roomy Shell"
msgid ""
"Your protective shell has grown large enough to accommodate--if need be--your "
"whole body.  Activate to pull your head and limbs into your shell, trading "
"mobility and vision for warmth and shelter."
msgstr ""
"Twoja ochronna skorupa rozrosła się na tyle, by pomieścić - gdy trzeba - całe "
"twoje ciało. Aktywuj, by wciągnąć głowę i kończyny w skorupę, zyskując ciepłe "
"schronienie w zamian za mobilność i zdolność obserwacji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Nacreous Shell"
msgstr "Perłowa skorupa"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Nacreous Shell"
msgid ""
"Your protective shell has developed increased strength and hardness and a "
"mother of pearl sheen."
msgstr ""
"Twoja ochronna powłoka rozwinęła zwiększoną wytrzymałość i twardość oraz "
"perłowy połysk."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Leg Tentacles"
msgstr "Nogi macki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Leg Tentacles"
#, no-c-format
msgid ""
"Your legs have transformed into six tentacles.  This decreases your speed on "
"land by 20%, makes your movement silent, increases your swimming speed and "
"reduces wet penalties, but you can't use footwear any more."
msgstr ""
"Twoje nogi zmieniły się w sześć macek. To zmniejsza twoją prędkość na lądzie "
"o 20%, czyni twoje ruchy cichymi, zwiększa prędkość pływania i redukuje kary "
"za przemoczenie, ale nie możesz już używać obuwia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Tentacle Bracing"
msgstr "Wsparte macki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Tentacle Bracing"
msgid ""
"Your lower tentacles have developed suckers, perfect for walking along lake "
"beds and ocean floors.  They make land movement marginally more tiring, do a "
"good job of keeping you set in place."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Scuttle"
msgstr "Zatapianie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Scuttle"
msgid ""
"Your hook-shaped feet curl inward to grip the ground, allowing you to easily "
"walk along the bottom when you're underwater.  They're also a bit quicker at "
"climbing over obstacles, even on dry land."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lizard"
msgid ""
"You sometimes look back on your days before your tail came in.  But you're "
"better now."
msgstr "Czasami wspominasz dawne dni zanim wyrósł ci ogon. Ale teraz jest lepiej."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Gastropod"
msgid "You feel bad for all the creatures that don't carry their home on their backs."
msgstr "Szkoda ci wszystkich stworzeń, które nie noszą swojego domu na plecach."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bird"
msgid ""
"You're sure you'll fly someday.  In the meantime, there are still nests to "
"build."
msgstr ""
"Jesteś pewien, że kiedyś wzbijesz się w przestworza. W międzyczasie są nadal "
"gniazda do wybudowania."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Aquatic"
msgstr "Wodne stworzenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Aquatic"
msgid ""
"Ninety percent of the planet, and it's yours to explore.  And colonize.  And "
"enjoy.  What was that about a surface?"
msgstr ""
"Dziewięćdziesiąt procent planety jest twoje do eksploracji. I kolonizacji. I "
"zabawy. Po co komu ta cała powierzchnia?"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Beast"
msgid ""
"It's about time you grew out.  Now that you've matured, it is time to make "
"something of yourself."
msgstr ""
"Czas najwyższy na wyrośnięcie. Teraz gdy zmutowałeś, czas uczynić z siebie "
"kogoś."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Feline"
msgid ""
"Stalking prey, eating well, and lying in the sun.  Mmm, all you could ever "
"desire."
msgstr ""
"Tropienie zwierza, jedzenie do syta i wylegiwanie się w słońcu. mmm, wszystko "
"co tylko można by sobie wymarzyć."

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
#. ~ Mutation name
#. ~ EOC option name in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
msgid "Wolf"
msgstr "Wilk"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Wolf"
msgid "You're the perfect candidate to lead a pack."
msgstr "Jesteś doskonałym kandydatem by prowadzić stado."

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
#. ~ Mutation name
#. ~ EOC option name in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
msgid "Bear"
msgstr "Niedźwiedź"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bear"
msgid "So the humans died; what's the worry?  Now they won't ruin the woods."
msgstr "Więc ludzie wymarli, czym tu się martwić? Teraz nie będą niszczyć lasów."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bovine"
msgstr "Bydlę"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bovine"
msgid ""
"Civilization collapsed?  Great!  You and your kin will never have to worry "
"about a slaughterhouse again."
msgstr ""
"Cywilizacja upadła? Doskonale! Ty i twoi krewni już nie muszą się martwić, że "
"zaprowadzą was do rzeźni."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Insect"
msgid ""
"It would be good to be a queen, having workers constantly servicing your "
"every need… but how would you keep them in line?"
msgstr ""
"Było by dobrze być królową, mając robotnice stale zaspokajające każdą twoją "
"potrzebę… ale jak byś je utrzymał w ryzach?"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Plant"
msgid ""
"Well, you still have those other walking flowers--and the mushrooms, too--to "
"deal with.  But you'll manage."
msgstr ""
"Cóż, nadal masz te inne chodzące kwiaty - i grzyby też - z którymi musisz "
"sobie poradzić. Ale dasz radę."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Aqueous"
msgstr "Wodnistość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Aqueous"
msgid ""
"What was that old advertisement?  'Paint the planet'?  That might be a good "
"long-term goal, but for now…"
msgstr ""
"Jak to szło w tej starej reklamie, „pomaluj planetę”? To może być niezły plan "
"długoterminowy, ale na razie…"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Subterranean"
msgstr "Podziemność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Subterranean"
msgid ""
"Not much point to rebuilding up in that horribly bright, roofless wasteland.  "
"Now that you've become accustomed to your new digs, there's the beginning of "
"a great empire right here, underground."
msgstr ""
"Nie widzisz sensu odbudowy w tym okropnie jasnym pustkowiu bez sufitu. Teraz, "
"gdy przyzwyczaiłeś się do twoich nowych wykopków, będzie to podłoże do "
"wielkiego imperium tu, w podziemiach."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cephalopod"
msgid ""
"Strange aeons, true, but Death seems to be slacking, and you are doing just "
"fine."
msgstr ""
"Dziwne eony, prawda, ale Śmierć się chyba opierdala, a ty nada trzymasz się "
"świetnie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Arachnid"
msgstr "Arachnid"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Arachnid"
msgid "Well, maybe you'll just have to make your own worldwide web."
msgstr "Cóż, może czas upleść sieć wielką jak kiedyś sieć internetowa."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Survivor"
msgid "Hey.  Civilization fell.  You're still around.  'Rat' just isn't respectful."
msgstr ""
"Hej. Cywilizacja upadła. Ty nadal żyjesz. „Szczur” po prostu nie ma "
"poszanowania."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Prototype"
msgstr "Prototyp"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Prototype"
msgid "After all those experiments, what's a few more, hmm?"
msgstr "Po tych wszystkich eksperymentach, czym jest jeszcze kilka?"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Prime"
msgstr "Pierwszy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Prime"
msgid "You're the perfect candidate to tidy this mess."
msgstr "Jesteś doskonałym kandydatem do uporządkowania tego bałaganu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fey"
msgstr "Elf"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fey"
msgid "You are the tree under which humankind will shelter during these dark times."
msgstr ""
"Ty jesteś drzewem, pod którym ludzkość znajdzie schronienie w tych mrocznych "
"czasach."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Chaos"
msgstr "Chaos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Chaos"
msgid ""
"You can't tell what you are anymore.  Everything and yet nothing, like you "
"weren't meant to exist.  But you do, and you're a force, no matter what "
"happens.  Unlocks gaining post-threshold traits from most other mutation "
"categories."
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/DinoMod/mutations/mutations.json
#. ~ Description of mutation "Raptor"
msgid ""
"The chance to undo not one but TWO extinction events.  You're confident "
"you'll do fine."
msgstr ""
"To szansa na cofnięcie nie jednego a DWÓCH wyginięć. Jesteś pewien że sobie "
"poradzisz."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Batrachian"
msgid "A perfect ambush predator, if only there were less competition."
msgstr "Idealny drapieżnik z zasadzki, gdyby tylko było mniej konkurencji."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Diminutive"
msgstr "Lilipuci"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Diminutive"
msgid ""
"So much food, everywhere!  And nobody's even guarding it anymore!  These are "
"good times."
msgstr "Tyle jedzenia, wszędzie! I nikt już go nie strzeże! To dobre czasy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Marloss Gateway"
msgstr "Brama Marloss"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Marloss Gateway"
msgid ""
"You get the feeling that you're on the cusp of becoming something greater "
"than yourself."
msgstr ""
"Masz przeczucie, że stoisz na progu stania się czymś większym od siebie "
"samego."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mycus"
msgid "We are the Mycus."
msgstr "Jesteśmy Grzybnią."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Crustacean"
msgid "Who needs skin when you can have a hard carapace?"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Chiropteran"
msgid "You long for a colony, the cover of darkness, and a meal on the wing."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Acidproof"
msgstr "Kwasoodporność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Acidproof"
msgid "Your mutated flesh is immune to the damaging effects of acid."
msgstr "Twoje zmutowane ciało jest odporne na szkodliwe efekty kwasu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Acid Blood"
msgstr "Kwasowa krew"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Acid Blood"
msgid ""
"Your body has developed a wonderful defense mechanism.  Instead of normal "
"blood, you bleed a strong molecular acid which will damage any creature "
"foolish enough to harm you."
msgstr ""
"Twoje ciało rozwinęło cudowny mechanizm obronny. Zamiast normalnej krwi, "
"krwawisz silnym molekularnym kwasem, który rani każde stworzenie na tyle "
"głupie, by cię skrzywdzić."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Pyromaniac"
msgstr "Piromania"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pyromaniac"
msgid ""
"You have an unhealthy obsession with fire, and you get anxious if you don't "
"light them every now and then or stand near them often.  However, you gain a "
"mood bonus from doing so."
msgstr ""
"Masz niezdrową obsesję na punkcie ognia i denerwujesz się, jeśli nie zapalasz "
"ich od czasu do czasu lub często się do nich nie zbliżasz. Zyskujesz jednak "
"premię do nastroju jeśli będziesz to robić."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Amphibious"
msgstr "Ziemnowodny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Amphibious"
msgid ""
"You're as comfortable in water as on land, and your body has adapted around "
"that fact.  Your base swimming speed is greatly increased, and weight will "
"hinder you much less while swimming."
msgstr ""
"Czujesz się komfortowo zarówno na lądzie jak i w wodzie, a twoje ciało jest "
"zaadaptowane do obydwu środowisk. Twoja bazowa zdolność pływania znacząco "
"wzrosła, a waga będzie znacznie mniejszą przeszkodą podczas pływania."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lidless Eyes"
msgstr "Oczy bez powiek"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lidless Eyes"
msgid ""
"Like a true fish, your eyes lack eyelids, and are instead covered by a "
"translucent, protective membrane that blocks irritants and water, and "
"provides minor armor.  It also allows you to sleep with your eyes open!  "
"Activate to cause the approach of hostile creatures to wake you up."
msgstr ""
"Jak u prawdziwej ryby, twoich oczu nie kryją powieki, których rolę pełni "
"przezroczysta ochronna membrana blokująca wodę i substancje drażniące oraz "
"zapewniająca ochronę. Pozwala ci też spać z otwartymi oczami! Aktywuj, by "
"spowodować, że obudzisz się na widok zbliżających się stworzeń."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Aqueous Repose"
msgstr "Wodne wytchnienie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Aqueous Repose"
msgid ""
"Falling asleep underwater is easy for you, and you spend less time asleep "
"when you rest there.  You can also eat underwater, though you can't drink."
msgstr ""
"Zasypianie pod wodą to dla ciebie łatwizna, a i odpoczynek trwa krócej w "
"wodzie. Możesz też jeść pod wodą, choć nie możesz pić."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Toxic Flesh"
msgstr "Trujące ciało"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Toxic Flesh"
msgid ""
"Your flesh is highly poisonous, and creatures that bite you will receive a "
"nasty surprise."
msgstr ""
"Twoje ciało jest wysoce trujące i stworzenia które cię ugryzą będą miały "
"niemiłą niespodziankę."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Freshwater Osmosis"
msgstr "Słodkowodna osmoza"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Freshwater Osmosis"
msgid ""
"Your gills and skin are highly permeable to moisture, and you can hydrate "
"your body through osmosis.  While submerged in fresh water, any thirst you "
"might have will be slaked."
msgstr ""
"Twoje skrzela i skóra są wysoce przenikliwe dla wilgoci, i możesz nawadniać "
"ciało w drodze osmozy. Będąc zanurzonym w słodkiej wodzie, doskwierające ci "
"pragnienie zostanie zaspokojone."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Electroreceptors"
msgstr "Elektroreceptory"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Electroreceptors"
msgid ""
"A network of jelly-filled electroreceptors, like that of a shark, have grown "
"throughout your face and nose.  They are very sensitive to magnetic fields, "
"allowing you to see robots and creatures charged with electricity through "
"walls, but being shocked will seriously mess you up."
msgstr ""
"Sieć wypełniona żelem elektroreceptorów, takich jak u rekinów, wyrosło ci "
"wzdłuż twarzy i nosa. Są bardzo wrażliwe na pola magnetyczne, pozwalając ci "
"widzieć roboty i naelektryzowane stworzenia przez ściany, ale porażenie "
"prądem poważnie cię przetrzepie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Shark Teeth"
msgstr "Zęby rekina"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Shark Teeth"
msgid ""
"Your teeth have grown incredibly sharp, and have calcified even further.  In "
"addition to letting you eat much faster, you can use them as a lethal natural "
"weapon, as long as your anatomy favors it.  They also grow very fast, and you "
"harmlessly shed them more or less at random."
msgstr ""
"Twoje zęby stały się niezwykle ostre i zwapniały jeszcze bardziej. Nie tylko "
"umożliwiają ci znacznie szybsze jedzenie, ale możesz ich też użyć jako "
"zabójczą broń naturalną, o ile tylko pozwala ci na to anatomia. W dodatku "
"rosną bardzo szybko i zrzucasz je mniej lub bardziej przypadkowo bez szkody "
"własnej."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Shark Teeth" attacks
#, c-format
msgid "You tear into %s with your teeth!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Shark Teeth" attacks
#, c-format
msgid "%1$s tears into %2$s with their teeth!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Police Officer"
msgstr "Policjant"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Police Officer"
#. ~ Description of mutation "SWAT Officer"
msgid ""
"You are a duly sworn law enforcement officer, with jurisdiction throughout "
"the New England region thanks to interstate agreements.  Whether that means "
"anything now is another question."
msgstr ""
"Jesteś należycie zaprzysiężonym oficerem ochrony prawa, z jurysdykcją "
"rozciągającą się na całą Nową Anglię dzięki porozumieniom międzystanowym. "
"Jakiekolwiek ma to teraz znaczenie obecnie to odrębna sprawa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "SWAT Officer"
msgstr "Funkcjonariusz SWAT"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Churl"
msgstr "Chłop"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Churl"
msgid ""
"Thou art a lewede man, a lowly cowherd, though where thi catel been thou hast "
"not ynn certain."
msgstr ""
"Jesteś chłopem z gminu, pastuchem krów, choć dzi się podziało twe stado ni "
"mosz pojęcia."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Police Detective"
msgstr "Detektyw policyjny"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Police Detective"
msgid ""
"You are a duly sworn law enforcement investigator, with jurisdiction "
"throughout the New England region thanks to interstate agreements.  Whether "
"your shield means anything now is another question."
msgstr ""
"Jesteś należycie zaprzysiężonym detektywem, z jurysdykcją rozciągającą się na "
"całą Nową Anglię dzięki porozumieniom międzystanowym. Czy twoja odznaka ma "
"jakiekolwiek znaczenie to już odrębna sprawa."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "US Marshal"
msgstr "Szeryf federalny USA"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "US Marshal"
msgid ""
"You are a duly sworn Federal marshal, with nationwide jurisdiction and the "
"authority of the United States of America."
msgstr ""
"Jesteś należycie zaprzysiężonym szeryfem federalnym Stanów Zjednoczonych, "
"funkcjonariuszem policji międzystanowej, z obejmującą cały kraj jurysdykcją i "
"władzą, sprawowaną w imieniu Stanów Zjednoczonych Ameryki."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hub 01 Ancillary"
msgstr "Poboczni Hub 01"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hub 01 Ancillary"
msgid ""
"You are known to be a capable and resourceful mercenary at the employ of Hub "
"01."
msgstr "Wiadomo, że jesteś zdolnym i zaradnym najemnikiem zatrudnionym przez Hub 01."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "True Foodperson"
msgstr "Prawdziwy Foodperson"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "True Foodperson"
msgid ""
"You are the true Foodperson, some might think Foodperson is just a mascot, "
"but you know better.  You are Foodperson, the mask has become your face; you "
"are real, and the only thing standing between this world and oblivion is you."
msgstr ""
"Jesteś prawdziwym Foodpersonem, niektórzy mogą pomyśleć, że Foodperson to "
"tylko maskotka, ale ty wiesz lepiej. Maska stała się twoją twarzą, jesteś "
"prawdziwy, a jedyną rzeczą stojącą między tym światem, a zapomnieniem jesteś "
"ty."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "MD"
msgid ""
"You trained as a medical professional in a clinic or hospital.  You can put "
"\"Dr.\" in front of your name and everything."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Skater"
msgstr "Skejter"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Skater"
msgid ""
"You are skilled in maneuvering on skates.  You suffer lower penalties to "
"dodging and are less likely to fall down if hit in melee combat while you're "
"wearing rollerskates or rollerblades."
msgstr ""
"Posiadasz biegłość w manewrowaniu na wrotkach lub łyżworolkach. Otrzymujesz "
"mniejsze kary za uniki i jest mniej prawdopodobne, że upadniesz, jeśli coś "
"cię uderzy w walce w zwarciu, gdy masz na sobie wrotki lub łyżworolki."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Martial Artist"
msgstr "Artysta sztuk walki"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Martial Artist"
msgid ""
"You were shaping up to be a pretty decent student of the martial arts before "
"the Cataclysm struck.  Time to see just how good you really are."
msgstr ""
"Ćwiczyłeś formę by być całkiem niezłym uczniem sztuk walki przed Kataklizmem. "
"Czas sprawdzić jak dobry byłeś."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Black Belt"
msgstr "Czarny pas"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Black Belt"
msgid ""
"You were competitive at national levels, and had considered teaching your "
"art.  Defending against the entire town may still be a challenge, though."
msgstr ""
"Byłeś zawodnikiem na poziomie krajowym i rozważałeś nauczanie twojej sztuki. "
"Lecz obrona przed całym miastem może być nadal wyzwaniem."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Pugilist"
msgid ""
"You are experienced in the Sweet Science of boxing.  You could've had a shot "
"at a local boxing tournament, if the Cataclysm hadn't screwed that up."
msgstr ""
"Masz doświadczenie w słodkiej nauce boksu. Dałbyś czadu w lokalnym turnieju, "
"gdyby nie to, że Kataklizm wszystko pomieszał."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Kickboxer"
msgstr "Kickbokser"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Kickboxer"
msgid ""
"You have some training in the art of kickboxing.  It's just boxing with "
"kicks, right?"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Dungeon Master"
msgstr "Mistrz lochów"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Dungeon Master"
msgid ""
"Weeks spent picking through manuals and researching topics you aren't versed "
"in has taught you to find what you need to know more quickly.  You read "
"slightly faster, and suffer no reading time penalty for books too complex for "
"you to easily understand."
msgstr ""
"Tygodnie spędzone na przeglądaniu podręczników i badaniu tematów na których "
"się nie znasz nauczyły cię szybszego znajdywania tego, czego potrzebujesz. "
"Czytasz nieco szybciej i nie ponosisz kary za czytanie książek zbyt "
"skompilowanych dla ciebie, by je zrozumieć."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Tail"
msgstr "Debug ogon"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Tail"
msgid "Gain a tail bodypart."
msgstr "Zdobądź ogon jako część ciała."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug No Torso"
msgstr "Debug brak tułowia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug No Torso"
msgid "They said college costs an arm and a leg, they sure weren't kidding!"
msgstr "Nie żartowali, mówiąc, że studia kosztują rękę i nogę!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Big Head"
msgstr "Debug duża głowa"

#: data/json/mutations/mutations.json
#: data/mods/Limb_WIP/mutations/mutations.json
#. ~ Description of mutation "Debug Big Head"
#. ~ Description of mutation "Debug Torso Replacement"
msgid "They said college what make me smart, this is a lot to lug around!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Half Weight"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Half Weight"
msgid "Better than GLP1 drugs!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Genetic Instability"
msgstr "Debug niestabilność genetyczna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Genetic Instability"
msgid ""
"You just can't wait to turn into a bug!  Triggers a mutation using the normal "
"mutation rules (requiring primer but no catalyst) every five seconds."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Night and Map Vision"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Night and Map Vision"
msgid ""
"Grants flawless night vision and the ability to see all of the overmaps "
"without having to reveal them manually.  As such, you can clearly see that "
"this is for dev purposes only."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Clairvoyance"
msgstr "Debug jasnowidzenie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Clairvoyance"
msgid ""
"Being able to see through walls and the floor is clearly for dev purposes "
"only."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Clairvoyance Super"
msgstr "Debug jasnowidzenie super"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Clairvoyance Super"
msgid ""
"Much bigger range than the other Debug Clairvoyance trait.  Unsure which one "
"to use?  Use them both!  You can see all the bugs with this one."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Invisibility"
msgstr "Debug niewidzialność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Invisibility"
msgid "If you see this, you'd best be debugging something."
msgstr "Jeśli to widzisz, to lepiej żebyś coś debugował."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Life Support"
msgstr "Debug podtrzymanie życia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Life Support"
msgid ""
"Holds hunger, thirst, and sleepiness stable.  You can debug all year long "
"with this one!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Cardio"
msgstr "Debug kondycja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Cardio"
msgid "You can run, but you'll never run out of breath."
msgstr "Możesz biegać, ale nigdy nie zabraknie ci tchu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug 9000 HP"
msgstr "Debug 9000 HP"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug 9000 HP"
msgid "If you need to survive the deadliest bug attacks."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Regeneration"
msgstr "Debug regeneracja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Regeneration"
msgid "Heal yourself from this stupid bug attacks."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Deodorizer"
msgstr "Debug dezodorant"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Deodorizer"
msgid "Smell that bug?  Smell's certainly not coming from you!"
msgstr "Czujesz tego buga? Bo zapach nie pochodzi od ciebie!"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Silent Walk"
msgstr "Debig cichy krok"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Silent Walk"
msgid "Be vewwy vewwy quiet.  We're hunting bugs."
msgstr "Bądź bałdzo bałdzo cicho. Polujemy na bugi."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Mana"
msgstr "Debug mana"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Mana"
msgid "To cast bug killing spells.  Also increase the cast speed of spells."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Mana Furnace"
msgstr "Debug piec many"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Mana Furnace"
msgid "Using mana to incinerate all bugs, activate to start burning."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Debug Mana Furnace" to
#. "DEBUG_MANA_FURNACE_active"
msgid "You start using mana to burning bugs."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Mana Furnace (ON)"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Mana Furnace (ON)"
msgid ""
"You're burning mana like crazy to burn of all bugs, also making you glow "
"softly."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Debug Mana Furnace (ON)" to
#. "DEBUG_MANA_FURNACE"
msgid "You stop incinerate bugs with mana."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug HVAC"
msgstr "Debug HVAC"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug HVAC"
msgid "Temperature and weather won't bug you."
msgstr "Temperatura i pogoda nie oblezie cię jak bugi."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Invincibility"
msgstr "Debug nietykalność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Invincibility"
msgid "Bug-repellent forcefield."
msgstr "Odstraszające bugi pole mocy."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Light"
msgstr "Debug światło"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Light"
msgid "You start to emit a light, so you can debug in the darkest nights."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Hammerspace"
msgstr "Debug młotkowanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Hammerspace"
msgid ""
"Crafting and construction requirements bugger off with this one.  Apply with "
"care."
msgstr ""
"Wymogi do wytwarzania i konstruowania odbugowały się tym razem. Używaj z "
"wyczuciem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Crafting Virtuoso"
msgstr "Debug wytworzony wirtuoz"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Crafting Virtuoso"
msgid "Crafting failures won't bug you any more."
msgstr "Porażki w wytwarzaniu już nie będą problemem."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Crafting Speed"
msgstr "Debug szybkość wytwarzania"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Crafting Speed"
msgid "Craft the bug out 50 times faster."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Mind Control"
msgstr "Debug kontrola umysłu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Mind Control"
msgid "Mind the bugs, would you kindly?"
msgstr "Myśl o bugach, jeśli łaska?"

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Bionic Installation"
msgstr "Debug instalacja bioniczna"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Bionic Installation"
msgid "Lets you instantly install torsion ratchets for your eight legs."
msgstr "Pozwala ci natychmiast zainstalować przekładnie zębate dla ośmiu nóg."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Speed"
msgstr "Debug szybkość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Speed"
msgid "With this, you'll be fixing those bugs faster than ever!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Stamina"
msgstr "Debug stamina"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Stamina"
msgid "Your energy to squash bugs is endless!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Debug Prevent Death"
msgstr "Debug zapobiegaj śmierci"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Debug Prevent Death"
msgid "You are prevented from death."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Squeamish"
msgstr "Wybredność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Squeamish"
msgid ""
"You can't even think about putting filthy clothes on yourself, especially "
"from zombies' corpses."
msgstr ""
"Nawet nie możesz myśleć o noszeniu brudnych ubrań, w szczególności z ciał "
"zombie."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mute"
msgid "Trait that makes it impossible to say anything."
msgstr "Cecha, która uniemożliwia mówienie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mute (Bird)"
msgstr "Niemowa (ptak)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mute (Bird)"
msgid ""
"Your mouth and larynx have changed dramatically, rendering you incapable of "
"human speech.  With enough practice you could relearn imitating their weird "
"ape chirps, but it will take time.  <color_red>Look for a new practice recipe "
"to lose this setback.</color>"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Speech Mimicry (Bird)"
msgstr "Mimika mowy (ptak)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Speech Mimicry (Bird)"
msgid ""
"Your throat cramps, your beak twitches, but you can speak human again if you "
"want."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mute (Cephalopod)"
msgstr "Niemowa (głowonóg)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mute (Cephalopod)"
msgid ""
"Your beak and new lungs have diverged too much from your human form to be "
"capable of human speech.  <color_red>Look for a new practice recipe to lose "
"this setback.</color>"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Speech Mimicry (Cephalopod)"
msgstr "Mimika mowy (głowonóg)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Speech Mimicry (Cephalopod)"
msgid ""
"Contorting your voice to match your surroundings is just as necessary as "
"changing your color, even if learning it was a pain."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mute (Snail)"
msgstr "Niemowa (ślimak)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mute (Snail)"
msgid ""
"Just losing your teeth would have been an adjustment, but with your new "
"tongue human speech is straight-up impossible.  <color_red>Look for a new "
"practice recipe to lose this setback.</color>"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Speech Mimicry (Snail)"
msgstr "Mimika mowy (ślimak)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Speech Mimicry (Snail)"
msgid ""
"Fine control of your radula was hard to learn, but now that you mapped out "
"which calcified not-tooth on there makes what pitch you can open your mouth "
"and…speak.  Yes, let's call it speaking."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mute (Insect)"
msgstr "Niemowa (insekt)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mute (Insect)"
msgid ""
"Your mandibles already made speech hard, but now that you don't even have a "
"tongue…<color_red>Look for a new practice recipe to lose this setback.</color>"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Speech Mimicry (Insect)"
msgstr "Mimika mowy (insekt)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Speech Mimicry (Insect)"
msgid ""
"Using all this new anatomy cramps you up, and there's spittle flying "
"everywhere, but you can manage short sentences of whistling almost-words."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Mute (Slime)"
msgstr "Niemowa (śluz)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Mute (Slime)"
msgid ""
"Your mouth is gone.  Oh, wait, there's one, isn't there?  If only it stopped "
"moving around you might start to relearn something like human speech.  "
"<color_red>Look for a new practice recipe to lose this setback.</color>"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Speech Mimicry (Slime)"
msgstr "Mimika mowy (śluz)"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Speech Mimicry (Slime)"
msgid ""
"Each word its own custom bubble under your membrane, waiting for its turn to "
"pop.  It sounds like something small and furry drowning in sourdough, but if "
"you manage to convince somebody to listen to you they will probably "
"understand."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Nomad"
msgstr "Nomadyzm"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Nomad"
msgid ""
"You're too adventurous for your own good.  The more time you spend somewhere, "
"the unhappier it makes you to be there."
msgstr ""
"Masz zbyt wielką żądzę przygód dla własnego dobra. Im więcej czasu gdzieś "
"przebywasz, tym bardziej czujesz nieszczęście."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Antsy"
msgstr "Ruchliwość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Antsy"
msgid ""
"You can't bear to stay still for long.  Your morale will suffer unless you "
"constantly explore new territory."
msgstr ""
"Nie możesz znieść długiego pozostawania w bezruchu. Twoje morale ucierpi, "
"chyba że będziesz stale eksplorować nowe tereny."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Restless"
msgstr "Niespokojność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Restless"
msgid ""
"Spending any amount of time in familiar places makes you miserable.  Must.  "
"Keep.  Moving."
msgstr ""
"Spędzanie dowolnej ilości czasu w znajomych miejscach sprawia, że jesteś "
"nieszczęśliwy. Musisz. Być. W ruchu."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Wayfarer"
msgstr "Wędrowanie"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Wayfarer"
msgid ""
"Whether from personal choice or childhood trauma, traveling with vehicles is "
"off-limits to you, even if your life depended on it."
msgstr ""
"Czy to z osobistego wyboru, czy urazu z dzieciństwa, podróżowanie pojazdami "
"jest dla ciebie niedostępne, nawet jeśli od tego zależało będzie twoje życie."

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Brawler"
msgid ""
"Whether from personal choice or childhood trauma, using ranged weapons is "
"off-limits to you, even if your life depended on it."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Gun-Shy"
msgstr "Niechęć od broni panlej"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Gun-Shy"
msgid ""
"Using a firearm is off limits, due to personal philosophy or a traumatic "
"event.  You can still use bows and slings."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fast Reflexes"
msgstr "Szybka reakcja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fast Reflexes"
msgid "You have fast reflexes, allowing you to dodge attacks more easily."
msgstr "Masz szybki refleks, dzięki czemu łatwiej unikasz ataków."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Lagomorph"
msgstr "Zajęczak"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Lagomorph"
msgid "You really want to eat some carrots.  Welcome to the Lagomorpha family."
msgstr "Naprawdę chcesz zjeść trochę marchewek. Witamy w rodzinie zajęczaków."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rabbit Ears"
msgstr "Uszy królika"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rabbit Ears"
msgid ""
"Your ears have grown into tall and flexible rabbit ears.  They're are slender "
"and enhance your hearing beyond the normal range."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rabbit Tail"
msgstr "Ogon królika"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rabbit Tail"
msgid ""
"Your stubby tail has become fuzzy and more round, but doesn't seem to serve "
"any purpose."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rabbit Fur"
msgstr "Futro królika"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rabbit Fur"
msgid ""
"Your fur keeps you covered in winter, maintaining heat and allowing you to "
"better tolerate cold temperatures."
msgstr ""
"Twoje futro okrywa cię w zimie, utrzymując ciepło i pozwalając ci lepiej "
"znosić niskie temperatury."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rabbit Feet"
msgstr "Stopy królika"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rabbit Feet"
msgid ""
"Your feet have grown into strong and large rabbit feet.  This makes your "
"kicks pack a little more oomph.  Emphasis on little.  It also offers some "
"warmth, and the lucky part is but superstition.  The downside is you are "
"unable to wear shoes."
msgstr ""
"Twoje stopy urosły do silnych i dużych królicze łapki. To sprawia, że twoje "
"kopnięcia mają trochę więcej siły. Z naciskiem na trochę. Oferuje również "
"trochę ciepła, a szczęśliwa część jest tylko przesądem. Minusem jest to, że "
"nie jesteś w stanie nosić butów."

#: data/json/mutations/mutations.json
#. ~ Message when player with mutation "Rabbit Feet" attacks
#, c-format
msgid "You kick %s with your large feet!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when NPC with mutation "Rabbit Feet" attacks
#, c-format
msgid "%1$s kicks %2$s with their large feet!"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Rabbit Nose"
msgstr "Nos królika"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Rabbit Nose"
msgid ""
"Your nose has morphed into a cute bunny nose, along with the snout.  It's "
"extremely twitchy too."
msgstr ""
"Twój nos zmienił się w uroczy króliczy nosek, razem z ryjkiem. Jest też "
"bardzo drgający."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Little Paws"
msgstr "Małe łapy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Little Paws"
msgid ""
"Your hands have elongated and look a bit more like paws.  It makes fine "
"manipulation a little more difficult, but you can still probably manage.  "
"Plus, they allow you to move on all fours when crouching and unarmed."
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/MindOverMatter/effects/effects_nether_attunement.json
#. ~ Mutation name
#. ~ Name of effect type id "effect_teleport_mishap_tindrift_warning"
msgid "Hunted"
msgstr "Polowany"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hunted"
msgid ""
"Something has been hunting you relentlessly.  You can outrun it, but it "
"always seems to find you eventually."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Numb"
msgid "Your ability to feel or express emotion has been greatly hampered."
msgstr "Twoja zdolność odczuwania lub wyrażania emocji została znacznie utrudniona."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Booming Voice"
msgstr "Hałaśliwy głos"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Booming Voice"
msgid ""
"You know how to project your voice.  You are able to shout much louder than "
"the average person."
msgstr ""
"Wiesz, jak kierunkować swój głos. Jesteś w stanie krzyczeć znacznie głośniej "
"niż przeciętny człowiek."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Feline Flexibility"
msgstr "Kocia elastyczność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Feline Flexibility"
msgid ""
"Your muscles, joints, and the movement center of your brain have changed "
"internally somewhat, allowing you to traverse obstacles with ease."
msgstr ""
"Twoje mięśnie, stawy i centrum ruchu w mózgu zmieniły się nieco wewnętrznie, "
"pozwalając ci z łatwością pokonywać przeszkody."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Hates Water"
msgstr "Nienawiść do wody"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Hates Water"
msgid ""
"You really hate getting your fur all wet.  This increases morale penalties "
"for being wet, and you will get them even when wearing appropriate clothing."
msgstr ""
"Naprawdę nienawidzisz mieć mokre futro. Zwiększa to kary morale za bycie "
"mokrym, a otrzymasz je nawet jeśli masz na sobie odpowiednie ubranie."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Resilient Physiology"
msgstr "Odporna fizjologia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Resilient Physiology"
#, no-c-format
msgid ""
"Your body is well-adapted to resist trauma.  20% bonus to all hit points.  "
"Stacks with Tough, etc."
msgstr ""
"Twoje ciało jest dobrze przystosowane do opierania się urazom. 20% premii do "
"wszystkich HP. Łączy się z solidnością itd."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Solid Physiology"
msgstr "Twarda fizjologia"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Solid Physiology"
#, no-c-format
msgid ""
"Your body is extremely well-adapted to resist trauma.  30% bonus to all hit "
"points.  Stacks with Tough, etc."
msgstr ""
"Twoje ciało jest ekstremalnie dobrze przystosowane do opierania się urazom. "
"30% premii do wszystkich HP. Łączy się z solidnością itd."

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Nyctophobia"
msgstr "Strach przed ciemnością"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Nyctophobia"
msgid ""
"You are terribly afraid of the dark.  You refuse to enter very dark areas.  "
"If you somehow still happen to stay in dark areas, you suffer from various "
"detrimental mental and physical effects."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cold Intolerance"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cold Intolerance"
msgid ""
"You fare worse than most in colder climates and are more bothered by lower "
"temperatures.  Note that while it will take less cold and exposure for you to "
"suffer the effects of frostbite, you aren't any worse at dealing with the "
"symptoms."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "High Cold Intolerance"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "High Cold Intolerance"
msgid ""
"You are now even more bothered by the cold and it is easier for you to freeze "
"or to even get chilly.  When you do though, it'll hit just as hard as it did "
"before."
msgstr ""

#: data/json/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
#. ~ Mutation name
msgid "Cold Tolerance"
msgstr "Tolerancja na zimno"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cold Tolerance"
msgid ""
"You fare better than most in colder climates and are less bothered by lower "
"temperatures.  Note that while it will take more cold and exposure for you to "
"suffer the effects of frostbite, you aren't any better at dealing with the "
"symptoms."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "High Cold Tolerance"
msgstr "Wysoka tolerancja na zimno"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "High Cold Tolerance"
msgid ""
"You are now even less bothered by the cold and it is harder for you to freeze "
"or to even get chilly.  When you do though, it'll hit just as hard as it did "
"before."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Heat Intolerance"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Heat Intolerance"
msgid ""
"You fare worse than most in warmer climates and are more bothered by hotter "
"temperatures.  Note that while it will take less heat and exposure for you to "
"suffer the effects of sunstroke, you aren't any worse at dealing with the "
"symptoms."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "High Heat Intolerance"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Description of mutation "High Heat Intolerance"
msgid ""
"You are now even more bothered by the heat and it is easier for you to "
"overheat or even sweat.  When you do though, it'll hit just as hard as it did "
"before."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Heat Tolerance"
msgstr "Tolerancja na ciepło"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Heat Tolerance"
msgid ""
"You fare better than most in warmer climates and are less bothered by hotter "
"temperatures.  Note that while it will take more heat and exposure for you to "
"suffer the effects of sunstroke, you aren't any better at dealing with the "
"symptoms."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "High Heat Tolerance"
msgstr "Wysoka tolerancja na ciepło"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "High Heat Tolerance"
msgid ""
"You are now even less bothered by the heat and it is harder for you to "
"overheat or even sweat.  When you do though, it'll hit just as hard as it did "
"before."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Colorful Skin"
msgstr "Kolorowa skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Colorful Skin"
msgid ""
"Your skin is covered in shifting patterns of dots, lines, and swirls.  This "
"is outside of your control and does not help your stealth.  In fact, it makes "
"you more noticeable."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Camouflage Skin"
msgstr "Maskująca skóra"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Camouflage Skin"
msgid ""
"Your can change your skin patterns to match your environment, somewhat "
"increasing your stealthiness."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Cephalopod Mind"
msgstr "Umysł głowonoga"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Cephalopod Mind"
msgid ""
"Your mind has been altered in such a way that you now find it very difficult "
"to understand humans.  Your capability to persuade and lie to them suffers "
"slightly, even if it is mitigated by your intelligence.  In addition, while "
"you find it much easier to learn by doing now, the plasticity of your psyche "
"means you forget skills much faster."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Temperature Tolerance"
msgstr "Tolerancja temperatury"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Temperature Tolerance"
msgid ""
"You are now not at all bothered by the heat and it is harder for you to "
"overheat or freeze at all.  When you do though, it'll hit just as hard as it "
"did before."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Highly Vain"
msgstr "Duża próżność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Highly Vain"
msgid ""
"You know you're beautiful, and the world deserves to know it too.  You prefer "
"to show off your stunningly good looks to the world and will be unhappy if "
"you cover up your face."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Picky Eater"
msgstr "Wybredność w jedzeniu"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Picky Eater"
msgid ""
"You're a very picky eater.  You refuse to eat any food that tastes bad unless "
"you're starving."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Extrovert"
msgstr "Ekstrawersja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Extrovert"
msgid ""
"You don't mind being alone, but you get a slight mood boost from being around "
"friends."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Sociable"
msgstr "Towarzyskość"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Sociable"
msgid ""
"You are a social creature.  Spending time with friends will improve your "
"mood, but if you're alone too long, you'll start to feel unhappy."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Alpha Member of the Group"
msgstr "Alpha członek grupy"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Alpha Member of the Group"
msgid ""
"You are the natural leader of any group.  It's just part of who you are, "
"groups naturally form around you and you need these groups to energize you.  "
"Sometimes however, you give in to your worst impulses and this trait will "
"flip."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Alpha Member of the Group" to
#. "DARK_TRIAD"
msgid "You give in to your worst instincts."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Dark Triad"
msgstr "Mroczna triada"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Dark Triad"
msgid ""
"You are a god among mortals and they are all so very disappointing.  Why "
"should you even bother to hide your disappointment in their failures?"
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Message when transforming from mutation  "Dark Triad" to "AMOG"
msgid "Maybe you can make better decisions this time."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Introvert"
msgstr "Introwersja"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Introvert"
msgid ""
"You can tolerate others, but you prefer to be alone.  Spending time by "
"yourself will boost your mood slightly."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Loner"
msgstr "Samotnictwo"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Loner"
msgid ""
"You'd really rather be by yourself.  Being alone will improve your mood, but "
"spending too much time around other people can grate on your nerves."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Superiority Complex"
msgstr "Kompleks wyższości"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Superiority Complex"
msgid ""
"You can't stand to prostrate yourself before your lessers and hate it when "
"they don't immediately do what you say.  Persuasion is much more difficult, "
"but you're better at lying and intimidating."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Comfortably Fluid"
msgstr "Komfortowa płynność"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Comfortably Fluid"
msgid ""
"You can hear your heartbeat in your ears, feel the blood sloshing around in "
"your veins.  The uneven hitches in your breath, the aches in your joints, the "
"rumbling of your stomach.  It's nasty and messy and ugly.  And you are "
"extremely grateful for that."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Oversensitive System"
msgstr "Nadwrażliwy system"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Oversensitive System"
msgid ""
"While it doesn't cause you any problems in daily life, your immune system and "
"body chemistry are overly sensitive to foreign implants.  You cannot have any "
"CBMs installed."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Bloodletter"
msgstr "Spuszczanie krwi"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Bloodletter"
msgid ""
"Your saliva contains powerful anticoagulants.  If you have a bite attack, it "
"will prolong the bleeding of most animals, including humans and the undead.  "
"It may be less effective against insects and stranger creatures."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Fangs"
msgstr "Kły"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Fangs"
msgid ""
"Your teeth have grown into long, sharp fangs.  If your mouth is uncovered, "
"you'll sometimes bite your enemies."
msgstr ""

#: data/json/mutations/mutations.json
#. ~ Mutation name
msgid "Vampire Fangs"
msgstr "Wampirze kły"

#: data/json/mutations/mutations.json
#. ~ Description of mutation "Vampire Fangs"
msgid ""
"Your teeth are so sharp, you can use them to shave the fur from your victims "
"before you feed.  What's more, anticoagulants in your saliva will keep their "
"blood flowing long after it should have clotted."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Survivor at any cost"
msgstr "Przetrwać za wszelką cenę"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Survivor at any cost"
msgid ""
"<npc_name> is certainly a survivor.  You can only wonder how many they've "
"abandoned to save themself."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Timid"
msgstr "Nieśmiałość"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Timid"
msgid "<npc_name> tries to avoid conflict, even when they have good reason not to."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Hardass"
msgstr "Twardziel"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Hardass"
msgid "<npc_name> loves to fight a good fight, but only for themself."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Freedom fighter"
msgstr "Walka o wolność"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Freedom fighter"
msgid ""
"<npc_name> believes in fighting… mostly for others, even at risk to their own "
"wellbeing."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Volatile"
msgstr "Zmienność"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Volatile"
msgid "<npc_name> is just looking for an excuse."
msgstr ""

#: data/json/mutations/npc_personality.json
#: data/mods/Xedra_Evolved/eocs/eoc_riddles.json
#. ~ Mutation name
#. ~ EOC option name in effect in EoC "EOC_XE_RIDDLE_09"
msgid "Coward"
msgstr "Tchórzostwo"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Coward"
msgid ""
"<npc_name> flinches at the thought of fighting, whether it be other people or "
"the undead."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Craven"
msgstr "Ostrożność"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Craven"
msgid ""
"<npc_name> is afraid of the dark, spiders, and unexplained sounds.  So are "
"you, but only because you've lived through the apocalypse.  <npc_name> has "
"always been like this."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Brave"
msgstr "Odwaga"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Brave"
msgid ""
"<npc_name> knows the name of fear, but only as a long-defeated foe.  Little "
"can shake them."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Hero"
msgid ""
"<npc_name> is an ideal ally to those they call friend, always willing to help "
"others."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Miser"
msgstr "Żałosność"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Miser"
msgid "<npc_name> loves their trinkets, and hates giving them away."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Scrooge"
msgstr "Zbieractwo"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Scrooge"
msgid "<npc_name> collects trash like a RPG protagonist collects potions."
msgstr "<npcname> zbiera śmieci, jak bohater RPG zbiera mikstury."

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Kind"
msgstr "Uprzejmość"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Kind"
msgid "<npc_name> just wants to help."
msgstr ""

#: data/json/mutations/npc_personality.json
#. ~ Mutation name
msgid "Self-centered"
msgstr "Skupienie na sobie"

#: data/json/mutations/npc_personality.json
#. ~ Description of mutation "Self-centered"
msgid "<npc_name> steers every interaction into discussing how it will help them."
msgstr ""

