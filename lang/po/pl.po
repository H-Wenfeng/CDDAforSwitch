msgstr[1] "krzykacze"
msgstr[2] "krzykaczy"
msgstr[3] "krzykacza"

#: data/mods/Magiclysm/monsters/monsters.json
#. ~ Description of monster "shrieker"
msgid ""
"A shrieker is a human-sized mushroom that emits a piercing screech to drive "
"off creatures that disturb it."
msgstr ""
"Krzykacz jest grzybem wielkości człowieka, który wydaje przeszywający pisk, "
"aby odstraszyć stworzenia, które mu przeszkadzają."

