msgid ""
"a soft robotic voice say, \"Come on.  I don't bite, I promise it won't hurt "
"one bit.\""
msgstr ""
"delikatny robotyczny głos mówi, „No dalej. Nie gryzę, obiecuję, że nie będzie "
"bolało ani trochę”."

#: src/monattack.cpp:2492 data/json/speech.json
#. ~ Speech from speaker mon_nursebot_defective, mon_mi_go, mon_mi_go_slaver
msgid "a soft robotic voice say, \"Here we go.  Just hold still.\""
msgstr "delikatny robotyczny głos mówi, „Zaczynamy. Po prostu się nie ruszaj”."

