msgstr[1] "młynki EMP"
msgstr[2] "młynków EMP"
msgstr[3] "młynka EMP"

#: data/json/monsters/drones.json
#. ~ Description of monster "EMP hack"
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have an "
"EMP grenade inside."
msgstr ""
"Automatyczny latający czterośmigłowy dron bojowy kamikaze z zamontowanym "
"wewnątrz, jak się zdaje, granatem EMP."

