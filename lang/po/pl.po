#: data/mods/alt_map_key/overmap_terrain_pink.json
#. ~ Monster name
#. ~ Overmap terrain name
msgid "triffid heart"
msgid_plural "triffid hearts"
msgstr[0] "serce tryfidów"
msgstr[1] "serca tryfidów"
msgstr[2] "serc tryfidów"
msgstr[3] "serca tryfidów"

#: data/json/monsters/triffid.json
#. ~ Description of monster "triffid heart"
msgid ""
"A knot of tubular roots, flowing with sap and beating like a heart.  Strands "
"of vascular tissue reach out to the surrounding root walls."
msgstr ""
"Węzeł z cylindrycznych korzeni, spływający sokiem roślinnym i bijący jak "
"serce. Włókna tkanki mięśniowej rozciągają się do otaczających ścian z "
"korzeni."

#: data/json/monsters/turrets.json
#. ~ Monster name
msgid "improvised MP5 turret"
msgid_plural "improvised MP5 turrets"
msgstr[0] "improwizowana wieżyczka MP5"
msgstr[1] "improwizowane wieżyczki MP5"
msgstr[2] "improwizowanych wieżyczek MP5"
msgstr[3] "improwizowanej wieżyczki MP5"

#: data/json/monsters/turrets.json
#. ~ Description of monster "improvised MP5 turret"
msgid ""
"A 9mm MP5 attached to a motorized chassis with basic autonomous software "
"control.  There is no mechanism to reload the weapon when its magazine is "
"empty, and the fire control system is only designed for semi-automatic fire."
msgstr ""
"9 mm pistolet maszynowy MP5 przymocowany do zmotoryzowanej obudowy z "
"podstawowym autonomicznym oprogramowaniem sterującym. Nie posiada mechanizmu "
"przeładowania magazynka po wyczerpaniu nabojów, a system kontroli prowadzenia "
"ognia jest przewidziany tylko do strzałów pojedynczych."

#: data/json/monsters/turrets.json
#. ~ Monster name
msgid "milspec searchlight"
msgid_plural "milspec searchlights"
msgstr[0] "reflektor milspec"
msgstr[1] "reflektory milspec"
msgstr[2] "reflektorów milspec"
msgstr[3] "reflektora milspec"

#: data/json/monsters/turrets.json
#. ~ Description of monster "milspec searchlight"
msgid ""
"A pylon boasting three high-powered searchlights with automated search AI, "
"continually seeking targets."
msgstr ""
"Pylon wyposażony w trzy lampy szperacze wysokiej mocy ze sztuczną "
"inteligencją do automatyzacji poszukiwań, stale wyszukującej cel."

