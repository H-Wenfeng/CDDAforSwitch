msgstr "<npcname> traci trochę krwi."

#: src/player_hardcoded_effects.cpp:396
msgid ""
"You could reduce the bleeding by emptying your hands and pausing to apply "
"pressure."
msgstr ""

#: src/player_hardcoded_effects.cpp:399
msgid "You could reduce the bleeding by pausing to apply pressure."
msgstr ""

#: src/player_hardcoded_effects.cpp:419
msgid "You feel a little strange."
msgstr "Osobliwie się czujesz."

#: src/player_hardcoded_effects.cpp:423
msgid "The world takes on a dreamlike quality."
msgstr "Świat nabiera sennych kształtów."

#: src/player_hardcoded_effects.cpp:425
msgid "You have a sudden nostalgic feeling."
msgstr "Dosięga cię uczucie nagłej nostalgii."

#: src/player_hardcoded_effects.cpp:427
msgid "Everything around you is starting to breathe."
msgstr "Wszystko wokół zaczyna oddychać."

#: src/player_hardcoded_effects.cpp:429
msgid "Something feels very, very wrong."
msgstr "Coś jest bardzo, bardzo nie tak."

#: src/player_hardcoded_effects.cpp:433
msgid "You feel sick to your stomach."
msgstr "Czujesz że żołądek ci się wywraca."

#: src/player_hardcoded_effects.cpp:441
msgid "\"I think it's starting to kick in.\""
msgstr "„Chyba zaczyna działać”."

#: src/player_hardcoded_effects.cpp:442
msgid "\"Oh God, what's happening?\""
msgstr "„Mój Boże, co się dzieje?”."

#: src/player_hardcoded_effects.cpp:443
msgid "\"Of course… it's all fractals!\""
msgstr "„Oczywiście… to wszystko fraktale!”."

#: src/player_hardcoded_effects.cpp:444
msgid "\"Huh?  What was that?\""
msgstr "„Hę? Co to było?”."

#: src/player_hardcoded_effects.cpp:460
msgid "Fractal patterns dance across your vision."
msgstr "Fraktalne wzory tańczą ci przed oczami."

#: src/player_hardcoded_effects.cpp:467
msgid "Dancing fractals distract you."
msgstr "Tańczące fraktale rozpraszają cię."

#: src/player_hardcoded_effects.cpp:474
msgid "Everything looks SO boring now."
msgstr "Wszystko to teraz wygląda TAK nudnie."

#: src/player_hardcoded_effects.cpp:476
msgid "Things are returning to normal."
msgstr "Rzeczy wracają do normalności."

#: src/player_hardcoded_effects.cpp:520
msgid "Your thoughts are unclear."
msgstr "Twoje myśli są zamglone."

#: src/player_hardcoded_effects.cpp:522
msgid "Your face is stiff from the cold."
msgstr "Twoja twarz sztywnieje z zimna."

#: src/player_hardcoded_effects.cpp:524
msgid "You quiver from the cold."
msgstr "Drżysz z zimna."

#: src/player_hardcoded_effects.cpp:524
msgid "Your torso is freezing cold.  You should put on a few more layers."
msgstr "Twoja klatka piersiowa przemarza. Musisz się ubrać na cebulkę."

#: src/player_hardcoded_effects.cpp:525
msgid "Your shivering makes you unsteady."
msgstr "Twoje dreszcze czynią cię niestabilnym."

#: src/player_hardcoded_effects.cpp:526 src/player_hardcoded_effects.cpp:527
msgid "Your left arm is shivering."
msgstr "Twoja lewa ręka ma dreszcze."

#: src/player_hardcoded_effects.cpp:526 src/player_hardcoded_effects.cpp:527
msgid "Your left arm trembles from the cold."
msgstr "Twoja lewa ręka drży z zimna."

#: src/player_hardcoded_effects.cpp:528 src/player_hardcoded_effects.cpp:529
msgid "Your right arm is shivering."
msgstr "Twoja prawa ręka ma dreszcze."

#: src/player_hardcoded_effects.cpp:528 src/player_hardcoded_effects.cpp:529
msgid "Your right arm trembles from the cold."
msgstr "Twoja prawa ręka drży z zimna."

#: src/player_hardcoded_effects.cpp:530 src/player_hardcoded_effects.cpp:531
msgid "Your left hand feels like ice."
msgstr "Twoja lewa dłoń jest zimna jak lód."

#: src/player_hardcoded_effects.cpp:530 src/player_hardcoded_effects.cpp:531
msgid "Your left hand quivers in the cold."
msgstr "Twoja lewa dłoń drży z zimna."

#: src/player_hardcoded_effects.cpp:532 src/player_hardcoded_effects.cpp:533
msgid "Your right hand feels like ice."
msgstr "Twoja lewa dłoń jest zimna jak lód."

#: src/player_hardcoded_effects.cpp:532 src/player_hardcoded_effects.cpp:533
msgid "Your right hand quivers in the cold."
msgstr "Twoja prawa dłoń drży z zimna."

#: src/player_hardcoded_effects.cpp:534 src/player_hardcoded_effects.cpp:535
msgid "Your left leg trembles against the relentless cold."
msgstr "Twoja lewa noga trzęsie się w przenikliwym zimnie."

#: src/player_hardcoded_effects.cpp:534 src/player_hardcoded_effects.cpp:535
#: src/player_hardcoded_effects.cpp:536 src/player_hardcoded_effects.cpp:537
msgid "Your legs uncontrollably shake from the cold."
msgstr "Twoje nogi drżą z zimna, że aż kolana dzwonią."

#: src/player_hardcoded_effects.cpp:536 src/player_hardcoded_effects.cpp:537
msgid "Your right leg trembles against the relentless cold."
msgstr "Twoja prawa noga trzęsie się w przenikliwym zimnie."

#: src/player_hardcoded_effects.cpp:538 src/player_hardcoded_effects.cpp:539
msgid "Your left foot feels frigid."
msgstr "Twoja lewa stopa jest lodowata."

#: src/player_hardcoded_effects.cpp:538
msgid "Your left foot is as nimble as a block of ice."
msgstr "Twoja lewa stopa jest sztywna z zimna jak blok lodu."

#: src/player_hardcoded_effects.cpp:539
msgid "Your freezing left foot messes up your balance."
msgstr "Twoja zamarzająca lewa stopa rujnuje twoją równowagę."

#: src/player_hardcoded_effects.cpp:540 src/player_hardcoded_effects.cpp:541
msgid "Your right foot feels frigid."
msgstr "Twoja prawa stopa jest lodowata."

#: src/player_hardcoded_effects.cpp:540
msgid "Your right foot is as nimble as a block of ice."
msgstr "Twoja prawa stopa jest sztywna z zimna jak blok lodu."

#: src/player_hardcoded_effects.cpp:541
msgid "Your freezing right foot messes up your balance."
msgstr "Twoja zamarzająca prawa stopa rujnuje twoją równowagę."

#: src/player_hardcoded_effects.cpp:554
msgid "Your head is pounding from the heat."
msgstr "W głowie ci pulsuje od gorąca."

#: src/player_hardcoded_effects.cpp:556
msgid "You are sweating profusely."
msgstr "Pocisz się obficie."

#: src/player_hardcoded_effects.cpp:558 src/player_hardcoded_effects.cpp:559
msgid "Your left hand's too sweaty to grip well."
msgstr "Twoja lewa dłoń jest zbyt spocona żeby dobrze chwytać."

#: src/player_hardcoded_effects.cpp:560 src/player_hardcoded_effects.cpp:561
msgid "Your right hand's too sweaty to grip well."
msgstr "Twoja prawa dłoń jest zbyt spocona żeby dobrze chwytać."

#: src/player_hardcoded_effects.cpp:562
msgid "Your left leg is cramping up."
msgstr "Twoją lewą nogę łapią skurcze."

#: src/player_hardcoded_effects.cpp:564
msgid "Your right leg is cramping up."
msgstr "Twoją prawą nogę łapią skurcze."

#: src/player_hardcoded_effects.cpp:566
msgid "Your left foot is swelling in the heat."
msgstr "Twoja lewa stopa spuchła z gorąca."

#: src/player_hardcoded_effects.cpp:568
msgid "Your right foot is swelling in the heat."
msgstr "Twoja prawa stopa spuchła z gorąca."

#: src/player_hardcoded_effects.cpp:587
msgid "The heat is making you see things."
msgstr "Przez ten żar zaczynasz widzieć rzeczy."

#: src/player_hardcoded_effects.cpp:596 src/player_hardcoded_effects.cpp:597
msgid "You have trouble grasping with your numb fingers."
msgstr "Masz problem z chwytaniem czegokolwiek zesztywaniłymi palcami."

#: src/player_hardcoded_effects.cpp:598 src/player_hardcoded_effects.cpp:599
#: src/player_hardcoded_effects.cpp:600 src/player_hardcoded_effects.cpp:601
msgid "Your foot has gone numb."
msgstr "Twoja stopa zesztywniała."

#: src/player_hardcoded_effects.cpp:602 src/player_hardcoded_effects.cpp:603
msgid "Your face feels numb."
msgstr "Twoja twarz zesztywniała."

#: src/player_hardcoded_effects.cpp:631
msgid "Glowing lights surround you, and you teleport."
msgstr "Otaczają cię światła i teleportujesz się."

#: src/player_hardcoded_effects.cpp:651
msgid "You pass out."
msgstr "Tracisz przytomność."

#: src/player_hardcoded_effects.cpp:685 src/player_hardcoded_effects.cpp:1341
msgid "A monster appears nearby!"
msgstr "Potwór pojawia się w pobliżu!"

#: src/player_hardcoded_effects.cpp:686 src/player_hardcoded_effects.cpp:1342
msgid "A portal opens nearby, and a monster crawls through!"
msgstr "W pobliżu otwiera się portal i wypełza z niego potwór!"

#: src/player_hardcoded_effects.cpp:695
msgid "You shudder suddenly."
msgstr "Przechodzi cię dreszcz."

#: src/player_hardcoded_effects.cpp:709
msgid "Your vision is filled with bright lights…"
msgstr "Twój wzrok wypełniają jasne światła…"

#: src/player_hardcoded_effects.cpp:725
msgid "You're suddenly covered in ectoplasm."
msgstr "Nagle okrywasz się ektoplazmą."

#: src/player_hardcoded_effects.cpp:736
msgid "We have many colonists awaiting passage."
msgstr "Mamy wielu osadników oczekujących na przejście."

#: src/player_hardcoded_effects.cpp:765
msgid ""
"You're experiencing loss of basic motor skills and blurred vision.  Your mind "
"recoils in horror, unable to communicate with your spinal column."
msgstr ""
"Doświadczasz utraty podstawowych zdolności motorycznych i zamglenia wzroku. "
"Twój umysł miota się w panice, nie mogąc się komunikować z rdzeniem kręgowym."

#: src/player_hardcoded_effects.cpp:766
msgid "You stagger and fall!"
msgstr "Zataczasz się i upadasz!"

#: src/player_hardcoded_effects.cpp:781
msgid "There's some kind of big machine in the sky."
msgstr "Na niebie jest jakaś wielka maszyna."

#: src/player_hardcoded_effects.cpp:784
msgid "It's some kind of electric snake, coming right at you!"
msgstr "To jakiś elektryczny wąż, pędzi wprost na ciebie!"

#: src/player_hardcoded_effects.cpp:791
msgid "Order us some golf shoes, otherwise we'll never get out of this place alive."
msgstr "Zamów nam jakieś buty golfowe, bo inaczej nie wyjdziemy stąd żywi."

#: src/player_hardcoded_effects.cpp:795
msgid "The possibility of physical and mental collapse is now very real."
msgstr "Prawdopodobieństwo załamania fizycznego i nerwowego jest teraz bardzo realne."

#: src/player_hardcoded_effects.cpp:797
msgid "No one should be asked to handle this trip."
msgstr "Nikt nie powinien być proszony by mieć taki odjazd."

#: src/player_hardcoded_effects.cpp:807
msgid ""
"Your heart spasms painfully and stops, dragging you back to reality as you "
"die."
msgstr ""
"Serce ci skacze boleśnie i przestaje bić, ściągając cię ku rzeczywistości gdy "
"umierasz."

#: src/player_hardcoded_effects.cpp:810
msgid ""
"You dissolve into beautiful paroxysms of energy.  Life fades from your "
"nebulae and you are no more."
msgstr ""
"Rozpływasz się w pięknym paroksyzmie energii. Życie opuszcza twoją mgławicę i "
"już cię nie ma."

#: src/player_hardcoded_effects.cpp:832
msgid "You bleed to death!"
msgstr "Wykrwawiasz się na śmierć!"

#: src/player_hardcoded_effects.cpp:833
msgid "<npcname> bleeds to death!"
msgstr "<npcname> wykrwawia się na śmierć!"

#: src/player_hardcoded_effects.cpp:838
msgid "Your heart can't keep up the pace and fails!"
msgstr "Twoje serce nie nadąża i przestaje działać!"

#: src/player_hardcoded_effects.cpp:865
msgid "Your skin looks pale and you feel anxious and thirsty.  Blood loss?"
msgstr "Twoja skóra wygląda blado i czujesz niepokój i pragnienie. Tracisz krew?"

#: src/player_hardcoded_effects.cpp:867
msgid ""
"Your pale skin is sweating, your heart is beating fast, and you feel "
"restless.  Maybe you lost too much blood?"
msgstr ""
"Twoja blada skóra poci się, twoje serce bije szybko i czujesz się nie "
"spokojny. Może straciłeś za dużo krwi?"

#: src/player_hardcoded_effects.cpp:869
msgid ""
"You're unsettlingly white, but your fingertips are bluish.  You are agitated "
"and your heart is racing.  Your blood loss must be serious."
msgstr ""
"Jesteś niepokojąco blady, ale koniuszki twoich palców są niebieskawe. Jesteś "
"zdenerwowany, a twoje serce bije szybciej. Twoja utrata krwi musi być poważna."

#: src/player_hardcoded_effects.cpp:871
msgid ""
"You are pale as a ghost, dripping wet from the sweat, and sluggish - despite "
"your heart racing like a train.  You are on the brink of collapse from the "
"effects of blood loss."
msgstr ""
"Jesteś blady jak duch, ociekający potem i powolny - mimo że twoje serce bije "
"jak oszalałe. Jesteś na skraju zapaści na skutek utraty krwi."

#: src/player_hardcoded_effects.cpp:879
msgid "You feel dizzy and lightheaded."
msgstr "Czujesz zawroty głowy i oszołomienie."

#: src/player_hardcoded_effects.cpp:883
msgid "You feel tired and you breathe heavily."
msgstr "Czujesz zmęczenie i oddychasz ciężko."

#: src/player_hardcoded_effects.cpp:887
msgid "You are anxious and cannot collect your thoughts."
msgstr "Czujesz niepokój i nie możesz zebrać myśli."

#: src/player_hardcoded_effects.cpp:891
msgid "You are sweating profusely, but you feel cold."
msgstr "Mocno się pocisz, ale jest ci zimno."

#: src/player_hardcoded_effects.cpp:900
msgid "You huff and puff.  Your breath is rapid and shallow."
msgstr "Wzdychasz i sapiesz. Twój oddech jest szybki i płytki."

#: src/player_hardcoded_effects.cpp:905
msgid "You drop to the ground, fighting to keep yourself conscious."
msgstr "Padasz na ziemię, walcząc o to, by zachować przytomność."

#: src/player_hardcoded_effects.cpp:909
msgid "Your mind slips away."
msgstr "Twój umysł odpływa."

#: src/player_hardcoded_effects.cpp:940
msgid "You cannot breathe and your body gives out!"
msgstr "Nie możesz oddychać i twoje ciało się poddaje!"

#: src/player_hardcoded_effects.cpp:941
msgid "<npcname> gasps for air and dies!"
msgstr "<npcname> próbuje złapać oddech i umiera!"

#: src/player_hardcoded_effects.cpp:949
msgid "Your hands feel unusually cold."
msgstr "Twoje dłonie są niezwykle zimne."

#: src/player_hardcoded_effects.cpp:954
msgid "Your feet feel unusually cold."
msgstr "Twoje stopy są niezwykle zimne."

#: src/player_hardcoded_effects.cpp:959
msgid "Your skin looks very pale."
msgstr "Twoja skóra wygląda bardzo blado."

#: src/player_hardcoded_effects.cpp:962
msgid "You feel weak.  Where has your strength gone?"
msgstr "Czujesz się słabo. Gdzie podziała się twoja siła?"

#: src/player_hardcoded_effects.cpp:965
msgid "You feel feeble.  A gust of wind could make you stumble."
msgstr "Czujesz słabość. Podmuch wiatru mógłby cię przewrócić."

#: src/player_hardcoded_effects.cpp:968
msgid "There is an overwhelming aura of tiredness inside of you."
msgstr "Panuje w tobie przytłaczająca aura zmęczenia."

#: src/player_hardcoded_effects.cpp:981
msgid "Rest is what you want.  Rest is what you need."
msgstr "Chcesz odpocząć. Musisz odpocząć."

#: src/player_hardcoded_effects.cpp:984
msgid "You feel dizzy and can't coordinate the movement of your feet."
msgstr "Czujesz zawroty głowy i nie możesz zgrać ruchów stóp."

#: src/player_hardcoded_effects.cpp:988
msgid "Your muscles are quivering."
msgstr "Twoje mięśnie drżą."

#: src/player_hardcoded_effects.cpp:992
msgid "You crave for ice.  The dirt under your feet looks tasty too."
msgstr "Marzysz o lodzie. Ziemia pod twoimi stopami też wygląda apetycznie."

#: src/player_hardcoded_effects.cpp:995
msgid "Your whole mouth is sore, and your tongue is swollen."
msgstr "Całe twoje usta są obolałe, a twój język spuchnięty."

#: src/player_hardcoded_effects.cpp:998
msgid "You feel lightheaded.  A migraine follows."
msgstr "Masz zawroty głowy. Po tym następuje migrena."

#: src/player_hardcoded_effects.cpp:1011
msgid "Your legs are restless.  The urge to move them is so strong."
msgstr "Twoje nogi są niespokojne. Chęć poruszania nimi jest tak mocna."

#: src/player_hardcoded_effects.cpp:1014
msgid "You feel like you could sleep on a rock."
msgstr "Czujesz się, jakbyś mógł spać na skale."

#: src/player_hardcoded_effects.cpp:1018
msgid "You gasp for air!"
msgstr "Z trudem łapiesz powietrze!"

#: src/player_hardcoded_effects.cpp:1023
msgid "Can't breathe.  Must rest."
msgstr "Nie możesz oddychać. Musisz odpocząć."

#: src/player_hardcoded_effects.cpp:1028
msgid "You can't take it any more.  Rest first; everything else later."
msgstr "Już nie możesz. Najpierw odpocznij, wszystko inne później."

#: src/player_hardcoded_effects.cpp:1033
msgid "You must sit down for a moment.  Just a moment."
msgstr "Musisz usiąść na chwilę. Tylko na chwilę."

#: src/player_hardcoded_effects.cpp:1074
msgid "You feel well rested."
msgstr "Jesteś dobrze wypoczęty."

#: src/player_hardcoded_effects.cpp:1077
msgid ""
"You feel physically rested, but you haven't been able to catch up on your "
"missed sleep yet."
msgstr "Czujesz się fizycznie wypoczęty, ale jeszcze nie nadrobiłeś straconego snu."

#: src/player_hardcoded_effects.cpp:1174 src/player_hardcoded_effects.cpp:1183
#: src/player_hardcoded_effects.cpp:1190
msgid "It's too bright to sleep."
msgstr "Jest zbyt jasno na sen."

#: src/player_hardcoded_effects.cpp:1198
#, c-format
msgid "You see %s approaching!"
msgstr "Widzisz że %s się zbliża!"

#: src/player_hardcoded_effects.cpp:1216
msgid "You toss and turn trying to keep warm."
msgstr "Przewracasz się z prawa na lewo, starając się utrzymać ciepło."

#: src/player_hardcoded_effects.cpp:1220
msgid "It's too cold to sleep."
msgstr "Jest za zimno na sen."

#: src/player_hardcoded_effects.cpp:1228
msgid "You toss and turn in the heat."
msgstr "Przewracasz się z prawa na lewo z gorąca."

#: src/player_hardcoded_effects.cpp:1232
msgid "It's too hot to sleep."
msgstr "Jest za gorąco na sen."

#: src/player_hardcoded_effects.cpp:1301
#. ~ %s is bodypart in accusative.
#, c-format
msgid "You start scratching your %s!"
msgstr "Zaczynasz drapać się w %s!"

#: src/player_hardcoded_effects.cpp:1305
#. ~ 1$s is NPC name, 2$s is bodypart in accusative.
#, c-format
msgid "%1$s starts scratching their %2$s!"
msgstr "%1$s zaczyna drapać się w %2$s!"

#: src/player_hardcoded_effects.cpp:1317
msgid "Why waste your time on that insignificant speck?"
msgstr "Po co marnować czas na ta nieistotną plamkę?"

#: src/player_hardcoded_effects.cpp:1349
msgid "The bees have started escaping your teeth."
msgstr "Pszczoły wylatują ci spomiędzy zębów."

#: src/player_hardcoded_effects.cpp:1351
msgid "You feel paranoid.  They're watching you."
msgstr "Czujesz paranoję. Obserwują cię."

#: src/player_hardcoded_effects.cpp:1356
msgid ""
"You feel like you need less teeth.  You pull one out, and it is rotten to the "
"core."
msgstr ""
"Czujesz że potrzeba ci mniej zębów. Wyciągasz jeden i jest przegniły do "
"korzenia."

#: src/player_hardcoded_effects.cpp:1359
msgid "You notice a large abscess.  You pick at it."
msgstr "Zauważasz duży czyrak. Skubiesz go."

#: src/player_hardcoded_effects.cpp:1365
msgid "You feel so sick, like you've been poisoned, but you need more.  So much more."
msgstr ""
"Czujesz się bardzo chory, jakbyś był otruty, ale potrzebujesz więcej. Dużo "
"więcej."

#: src/player_hardcoded_effects.cpp:1371
msgid "You are beset with a vision of a prowling beast."
msgstr "Otacza cię wizja grasującej bestii."

#: src/player_hardcoded_effects.cpp:1375
msgid "Your surroundings are permeated with a foul scent."
msgstr "Twoje otoczenie jest przesiąknięte brzydkim zapachem."

#: src/player_hardcoded_effects.cpp:1382
msgid "Your asthma attack stops."
msgstr "Twój atak astmy ustaje."

#: src/player_hardcoded_effects.cpp:1385
msgid ""
"Your asthma overcomes you.\n"
"You asphyxiate."
msgstr ""
"Astma pokonuje cię.\n"
"Dusisz się."

#: src/player_hardcoded_effects.cpp:1390
msgid "You wheeze and gasp for air."
msgstr "Świszczysz i starasz się łapać oddech."

#: src/player_hardcoded_effects.cpp:1395
msgid "Your head aches faintly."
msgstr "Twoja głowa boli przez chwilę."

#: src/player_hardcoded_effects.cpp:1401
msgid "Your vision is getting fuzzy."
msgstr "Twój wzrok się rozmywa."

#: src/player_hardcoded_effects.cpp:1409
msgid "Your vision goes black!"
msgstr "Twój wzrok zakrywa czerń!"

#: src/player_hardcoded_effects.cpp:1415
msgid "Your bowels ache."
msgstr "Twoje kiszki bolą."

#: src/player_hardcoded_effects.cpp:1419
msgid "Your veins itch."
msgstr "Twoje żyły swędzą."

#: src/player_hardcoded_effects.cpp:1423
msgid "Your muscles feel like they're knotted and tired."
msgstr "Twoje mięśnie sprawiają wrażenie jakby były związane w postronki i zmęczone."

#: src/player_hardcoded_effects.cpp:1427
msgid "Your muscles are tight and sore."
msgstr "Twoje mięśnie są sztywne i obolałe."

#: src/player_hardcoded_effects.cpp:1431
msgid "Your muscles are locking up and you can't fight effectively."
msgstr "Twoje mięśnie sztywnieją i nie możesz walczyć efektywnie."

#: src/player_hardcoded_effects.cpp:1433
msgid "Your muscles spasm."
msgstr "Twoje mięśnie drżą spazmatycznie."

#: src/player_hardcoded_effects.cpp:1494 src/player_hardcoded_effects.cpp:1546
#. ~ %s is bodypart name.
#, c-format
msgid "Your %s wound begins to feel better!"
msgstr "Twoja rana %s ma się lepiej!"

#: src/player_hardcoded_effects.cpp:1557
msgid "You succumb to the infection."
msgstr "Poddajesz się infekcji."

#: src/player_hardcoded_effects.cpp:1582
msgid "You try to sleep, but can't…"
msgstr "Próbujesz zasnąć, lecz nie potrafisz…"

#: src/player_hardcoded_effects.cpp:1596
msgid "Your internal chronometer went off and you haven't slept a wink."
msgstr ""
"Twój wewnętrzny chronometr się wzbudził i nie udało ci się przespać ani "
"chwili."

#: src/player_hardcoded_effects.cpp:1609
msgid "Your internal chronometer finally wakes you up."
msgstr "Twój wewnętrzny chronometr w końcu cię budzi."

#: src/player_hardcoded_effects.cpp:1611
msgid "Your internal chronometer wakes you up."
msgstr "Twój wewnętrzny chronometr cię budzi."

#: src/player_hardcoded_effects.cpp:1639
msgid "Your alarm is going off."
msgstr "Twój alarm się włączył."

#: src/player_hardcoded_effects.cpp:1641
msgid "Your alarm went off."
msgstr "Twój alarm się wyłączył."

#: src/player_hardcoded_effects.cpp:1671
msgid "You lose control of your body as it begins to convulse!"
msgstr "Tracisz kontrolę nad swoim ciałem, gdy zaczyna drgać!"

#: src/player_hardcoded_effects.cpp:1679
msgid "You lose consciousness!"
msgstr "Tracisz przytomność!"

#: src/player_hardcoded_effects.cpp:1689
